    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bik che king’och arorutiet, kaboto ng’alek tugul che bo arorutiet",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chu anyun che king’och: Neemia Tirsata, weritab Hakalia, ak Sedekia; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.1",
            "verseOrgIds": [
              "NEH.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seraia, Asaria, Jeremia; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.2",
            "verseOrgIds": [
              "NEH.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pasur, Amaria, Malkija; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.3",
            "verseOrgIds": [
              "NEH.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatus, Sebania, Maluk; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.4",
            "verseOrgIds": [
              "NEH.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harim, Meremot, Obadia; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.5",
            "verseOrgIds": [
              "NEH.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daniel, Gineton, Baruk; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.6",
            "verseOrgIds": [
              "NEH.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mesulam, Abija, Mijamin; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.7",
            "verseOrgIds": [
              "NEH.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maasia, Bilgai, Semaia: ki tisiik chuto. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.8",
            "verseOrgIds": [
              "NEH.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lawik ko ki: Jesua, weritab Asania, Binui ne bo werikab Henadad, Kadmiel; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.9",
            "verseOrgIds": [
              "NEH.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak tupchosiekwak, Sebania, Hodia, Kelita, Pelaia, Hanan; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.10",
            "verseOrgIds": [
              "NEH.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mika, Rehob, Hasabia; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.11",
            "verseOrgIds": [
              "NEH.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sakur, Serebia, Sebania; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.12",
            "verseOrgIds": [
              "NEH.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hodia, Bani, Beninu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.13",
            "verseOrgIds": [
              "NEH.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Che eechen che bo bik ko ki: Paros, Pahat-moab, Elam, Satu, Bani; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.14",
            "verseOrgIds": [
              "NEH.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buni, Asgad, Bebai; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.15",
            "verseOrgIds": [
              "NEH.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adonija, Bigbai, Adin; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.16",
            "verseOrgIds": [
              "NEH.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ater, Hesekia, Asur; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.17",
            "verseOrgIds": [
              "NEH.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hodia, Asum, Besai; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.18",
            "verseOrgIds": [
              "NEH.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arib, Anatot, Nobai; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.19",
            "verseOrgIds": [
              "NEH.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NEH 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magpias, Mesulam, Hesir; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.20",
            "verseOrgIds": [
              "NEH.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mesesabel, Sadok, Jadua; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.21",
            "verseOrgIds": [
              "NEH.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelatia, Anan, Anaia; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.22",
            "verseOrgIds": [
              "NEH.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hosea, Hanania, Hasub; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.23",
            "verseOrgIds": [
              "NEH.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haloes, Pila, Sobek; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.24",
            "verseOrgIds": [
              "NEH.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reum, Hasabna, Maaseia; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.25",
            "verseOrgIds": [
              "NEH.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak Ahia, Hanan, Anan; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.26",
            "verseOrgIds": [
              "NEH.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maluk, Harim, Baana.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.27",
            "verseOrgIds": [
              "NEH.10.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.27",
            "verseOrgIds": [
              "NEH.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak bik tugul, tisiik, Lawik, ribikab kurgotik, tienik, Netinik, ak tugul che kiga kotabanegei bikab emotinwek, kotabanjigei Ng’atutikab Kamuktaindet, koboto osotikwak, werikwak ak tibikwak, chi tugul ne kitinyei naet ak kaguiyet; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.28",
            "verseOrgIds": [
              "NEH.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "kinamegei ak tupchosiekwak, bikwak che toogunotin, ak kiiyosio eng’ chubisiet ak koyosiet, kole kobendate Ng’atutikab Kamuktaindet, che kigigon eng’ Musa otwogindetab Kamuktaindet, ak korib ak koyai kayomisutik tugul che bo Jehovah Kiptaiyandennyo, koboto kiruogutikyik ak kotigonutikyik; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.29",
            "verseOrgIds": [
              "NEH.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak kole, magigochini tibikyok bikab emet, anan kotun werikyok tibikwak: ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.30",
            "verseOrgIds": [
              "NEH.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak ngot koib bikab emet, tuguk che kialdoi anan ko amitwogik eng’ betutab sabato kole koalda, ko magiale eng’ betutab sabato, anan ko eng’ betut ne itabanat: kemete kenyitab tisab, ak kemete yaaksetab besendo age tugul.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.31",
            "verseOrgIds": [
              "NEH.10.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.31",
            "verseOrgIds": [
              "NEH.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigiyachige anyun ng’atutik, kele kigoite eng’ kenyit age tugul kebeberta agenge eng’ somok ne bo sekel kobunji otisietab gotab Kamuktaindennyo; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.32",
            "verseOrgIds": [
              "NEH.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ak che bo makatinikab kabartaet, ak che bo kagochinet ne bo kotugul ne bo busiek, ak kagochinet ne bo kotugul ne kibeelei, ak che bo sabatosiek, ak che bo ye kaleel arawet, ak che bo igorwek che kiging’at, ak che bo tuguk che itabanotin, ak che bo kagochinoikab tengekto, si keyachine Israel kagaigaet, ak che bo boisiet tugul ne bo gotab Kamuktaindennyo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.33",
            "verseOrgIds": [
              "NEH.10.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.33",
            "verseOrgIds": [
              "NEH.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NEH 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak kigiser barbarek, koboto tisiik ak Lawik, ak bik, agobo kagochinetab kwenik, si kobiit keib kobwa gotab Kamuktaindennyo, ko u gorikab kwanisiekyok, eng’ betusiek che kiging’at, eng’ kenyit age tugul, si kebeel eng’ kaptisisietab Jehovah Kamuktaindennyo, ko u ye sirat eng’ Ng’atutik; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.34",
            "verseOrgIds": [
              "NEH.10.34"
            ]
          }
        },
        {
          "name": "verse",
