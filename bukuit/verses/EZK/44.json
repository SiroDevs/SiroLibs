            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.27",
            "verseOrgIds": [
              "EZK.44.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 44:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak konyor borotet; a borotenywa: ak mogochini ichek kit ne namei kobunji eng’ Israel; a nenywa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.28",
            "verseOrgIds": [
              "EZK.44.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 44:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amei kagochinetab busiek, ak kagochinetab tengekto, ak kagochinetab chalwokto; ak nenywa kit age tugul ne kitabani eng’ Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.29",
            "verseOrgIds": [
              "EZK.44.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 44:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ak bunjin tisiik tongoanik tugul che bo tai che bo kiy age tugul, ak kagochinet age tugul ne kinamjin barak ne bo kiy age tugul, che bo kagochinoikwok tugul che kinamjin barak: ogochini kogeny tisiindet makatinikwok che tuonen che bo tai, si kogochi berurto kotebe gong’ung’. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.30",
            "verseOrgIds": [
              "EZK.44.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 44:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maamei tisiik kiy age tugul ne kamee inegei, anan ne kobarei tiong’ik, ngo tarit anan ngo tiony.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.31",
            "verseOrgIds": [
              "EZK.44.31"
            ]
          }
        }
