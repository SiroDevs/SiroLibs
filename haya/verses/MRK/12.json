        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 12:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu kayabaire ashuntamire bwatana buhanika ya Rwensinga, abona omu buhanika obwo okwo embaga elikutamu empiha. Abatungi bangi bakaba nibatekamu amahera gangi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.41",
            "verseOrgIds": [
              "MRK.12.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MRK 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agya aija entumbwa omunaku, atekamu esarafu ibili z'omulinga, nilyo ihera limoi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.42",
            "verseOrgIds": [
              "MRK.12.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MRK 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayeta abegesibwabe abagambira ati, “Mbagambiire amazima, entumbwa omunaku yatamu amahera gangi kushaaga bona abalikuteeka amahera omuli buhanika. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.43",
            "verseOrgIds": [
              "MRK.12.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MRK 12:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bona baihya aha bingi byabo ebyo bainabyo; kyonkai entumbwa n'obunaku bwayo yatekamu byona ebyo yaba enabyo, nilyo lyaba lili itungalye lyonkai.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.44",
            "verseOrgIds": [
              "MRK.12.44"
            ]
          }
        }
