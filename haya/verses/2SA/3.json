            "style": "v",
            "sid": "2SA 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.30",
            "verseOrgIds": [
              "2SA.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi agambira Yoabu n'abantu bona abo yabaire ainabo ati, “Temura emyendo yanyu mwekome engunia, muchulire Abuneri.” Omukama Daudi agenda ahondeire orwino. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.31",
            "verseOrgIds": [
              "2SA.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abuneri bamuziika Heburoni. Omukama Daudi achulira muno Abuneri aha nyanga, abantu bona bachura. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.32",
            "verseOrgIds": [
              "2SA.3.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 3:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamuchulira namutongya ati,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.33",
            "verseOrgIds": [
              "2SA.3.33"
            ]
          }
        }
