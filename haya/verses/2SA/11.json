{
  "id": "2SA.11",
  "number": "11",
  "bookId": "2SA",
  "reference": "2 Samweli 11",
  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "2SA 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu mbandizo y'omwaka, omu makiro ag'abakama batabaliramu, Daudi atuma Yoabu n'abaramatabe n'eihe lyona lya Isiraeli, basilikya Abaamoni, kandi babunda Raba. Kyonkai Daudi aikara Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.1",
            "verseOrgIds": [
              "2SA.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.1",
            "verseOrgIds": [
              "2SA.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiro kimoi eizoba lyaija kutobera Daudi aimuka aha kitandakye, agendagenda aha rushwi rw'enju y'Omukama. Kayabaire ayemeleireho abona omukazi nayoga. Omukazi ogwo hakaba ali murungi muno. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.2",
            "verseOrgIds": [
              "2SA.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi yatuma kumubaliliza. Omuntu omoi agamba ati, “Ogu ni Batisheba muhara wa Eliamu, ni muka Uria, Omuhiti.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.3",
            "verseOrgIds": [
              "2SA.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikwo Daudi kutuma entumwa zikamuleta omwe, yabyama nawe, aha rw'okuba hakaba yazirukire. Ahanyuma agaruka omuka. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.4",
            "verseOrgIds": [
              "2SA.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atwara enda; mara aragiraho Daudi ati, “Nyina enda.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.5",
            "verseOrgIds": [
              "2SA.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.5",
            "verseOrgIds": [
              "2SA.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Daudi atuma ahali Yoabu ati, “Ontwekere Uria, Omuhiti.” Yoabu amumutwekerakwo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.6",
            "verseOrgIds": [
              "2SA.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo Uria yamugobire, Daudi yamubaza amakuru ga Yoabu n'abaisherukare n'ag'endashana. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.7",
            "verseOrgIds": [
              "2SA.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahanyuma amugira ati, “Ogende omwawe, onabe amaguru.” Uria aruga nyaruju omw'Omukama, Omukama amuhondeza eby'okumugabira. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.8",
            "verseOrgIds": [
              "2SA.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai Uria akarara n'abairu ba Mukamawe aha kishasi kya nyaruju y'Omukama, owe tiyagiireyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.9",
            "verseOrgIds": [
              "2SA.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo bagambire Daudi bati, “Uria owe tagiireyo,” Daudi yagambira Uria ati, “Manya iwe orugire omu tabaro, mbwenu kubaki otagiire wawe?” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.10",
            "verseOrgIds": [
              "2SA.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uria amuhorora ati, “Esanduku na Isiraeli na Yuda bali omu nsisira, mara Mukama wange Yoabu n'abairu ba Mukama wange basisiire omw'ishwa. Aho inye ngende omwange kulya nkanywa nkabyama na mukazi wange? Mwoyo gwawe, ekyo tindikwija kukikora.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.11",
            "verseOrgIds": [
              "2SA.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikwo Daudi kumugambira ati, “Na kir'eki ikara hanu, nyenkya ndakutaishura.” Kityo kir'ekyo n'ekyahondeireho Uria aikara Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.12",
            "verseOrgIds": [
              "2SA.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi amuraliza, alya nawe, amunyoisa amutamiiza. Bwaigoro ashohora abyama aha kitandakye hamoi n'abairu ba Mukamawe; kyonkai owe tiyagiireyo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.13",
            "verseOrgIds": [
              "2SA.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.13",
            "verseOrgIds": [
              "2SA.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabwakeire Daudi ahandikira Yoabu ebarua mara agitweka Uria wenene. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.14",
            "verseOrgIds": [
              "2SA.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu barua ahandika ati, “Ote Uria omu maisho bwatana mbali endashana eina amani, ahanyuma mugaruke enyuma mumusigeho bamutere afe.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.15",
            "verseOrgIds": [
              "2SA.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo Yoabu yabaire nabunda ekigo, ata Uria aha mwanya mbali yabaire namanya okwo haliho abashaija emanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.16",
            "verseOrgIds": [
              "2SA.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyakigo bashohora kurwana na Yoabu; abairu ba Daudi abandi bafa. Uria Omuhiti nawe abugenderanamu afa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.17",
            "verseOrgIds": [
              "2SA.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoabu atuma entumwa kugambira Daudi amakuru gona g'endashana. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.18",
            "verseOrgIds": [
              "2SA.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entumwa yagiragilira ati, “Orwo oramara kugambira Omukama amakuru gona g'endashana, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.19",
            "verseOrgIds": [
              "2SA.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "akanigara, akakubaza ati, ‘Kubaki murashaine mukagoba ekigo haihi? Mubaire mutalikumanya okwo bakwemire aha rukuta eiguru bakarasha emyambi? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.20",
            "verseOrgIds": [
              "2SA.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimeleki eya Yerubesheti akaitw'ohai? Ti mukazi ayayemire aha rukuta eiguru akamutenekera enseiso?’ Iwe aho omugambire oti, ‘Omwiru wawe Uria Omuhiti nawe afire.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.21",
            "verseOrgIds": [
              "2SA.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.21",
            "verseOrgIds": [
              "2SA.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entumwa egenda; kayagobire yagambira Daudi byona ebyo yabaire amutumire kugamba. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.22",
            "verseOrgIds": [
              "2SA.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emugambira eti, “Ababisha batushagisize amani bashohora batutelera omu rweya; kyonkai tubafunyire twabagobya omu kishasi ky'ekihigi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.23",
            "verseOrgIds": [
              "2SA.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikwo abarasi b'emyambi kurasha ababisha bawe bemire aha rukuta eiguru. Abairu b'Omukama abandi bafire n'omwiru wawe Uria Omuhiti yabugenderanamu.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.24",
            "verseOrgIds": [
              "2SA.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi agambira entumwa ati, “Ogye ogambire Yoabu oti, ‘Ekyo kitakwita kubi, okuba embanda eita ogu, eshuba eita oli. Oteho amani kurashanisa ekigo, okikambure.’ Mara omugumisilize.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.25",
            "verseOrgIds": [
              "2SA.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.25",
            "verseOrgIds": [
              "2SA.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo muka Uria yahuliire okwo iba afire, amuchulira. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.26",
            "verseOrgIds": [
              "2SA.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi okuteka orufu kakwahoire, Daudi yamutuma yamutahya omwe, yaba mukaziwe, ahanyuma yamuzalira omwana w'omwojo. Kyonkai ekyo Daudi yakozire kikatama Omukama.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.27",
            "verseOrgIds": [
              "2SA.11.27"
            ]
          }
        }
      ]
    }
  ],
