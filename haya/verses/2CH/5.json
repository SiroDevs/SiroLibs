          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.10",
            "verseOrgIds": [
              "2CH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo abakuhani barugire Ahatakatifu (bona bakaba beshemeize, ti kugir'oti balinya ababaire baina ezamu; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.11",
            "verseOrgIds": [
              "2CH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'Abalevita bona, abahoyi, Asafu, Hemani na Yeduthuni, batabani babo n'abanyaruganda babo, bajwete kitani nungi, nibatera enkunturo, n'enganga, n'eningili, bakaba bemeleire oburugaizoba bwa ealutare n'abakuhani 120 abatezi b'amakondere; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.12",
            "verseOrgIds": [
              "2CH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "abatezi b'amakondere n'abahoyi baragirwaga kutasingangana orwo balikusingiza Omukama n'okumusiima); empoya zikahoywa, amakondere gakataga, enkunturo zikaterwa hamoi n'ebikwato ebindi by'omuziki, nibasingiza Omukama bakwese,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        }
      ]
    }
