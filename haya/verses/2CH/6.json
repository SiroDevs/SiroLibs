          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waitu Mukama Ruhanga, enkorwa majuta yawe otaginagirana! Ijuka ekisha kyawe ekyo wagiliraga Daudi omwiru wawe.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.42",
            "verseOrgIds": [
