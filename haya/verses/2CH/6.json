            "number": "41",
            "style": "v",
            "sid": "2CH 6:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waitu Mukama Ruhanga, imuka osingiire omu kikaare kyawe, iwe n'Esanduku emanyisa amani gawe. Singa, waitu Mukama Ruhanga, orokore abakuhani bawe; otunge abantu bawe emilembe bashemelerwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.41",
            "verseOrgIds": [
              "2CH.6.41"
            ]
          }
        },
        {
          "name": "verse",
