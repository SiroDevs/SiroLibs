          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "aho olisinga omw'iguru okwo omu businge bwawe ohulire enshara zabo n'okutaka kwabo, obememu, ogarure eihanga lyawe abalishangwa bakufakaliire.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.39",
            "verseOrgIds": [
              "2CH.6.39"
            ]
          }
        }
