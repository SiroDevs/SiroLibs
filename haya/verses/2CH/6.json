          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "kabaliba bali omu buzahe baketekeleza, bakechuza, orwo balikutakaho nibagamba bati, ‘Tukozire kubi, twafakara,’ ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.37",
            "verseOrgIds": [
              "2CH.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
