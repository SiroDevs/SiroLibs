              "type": "text"
            }
          ]
        },
        {
          "text": "“Kandi kabarakufakaliraga, orwo hatabaho atafakara, okabanigalira, okabaanaga omu mikono y'ababisha, bakabatwara endore harai anga haihi, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.36",
            "verseOrgIds": [
              "2CH.6.36"
            ]
          }
        },
