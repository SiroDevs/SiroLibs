          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "“K'oligira okwo wahangira eihanga lyawe kurwana n'ababisha babo, kabarakushabaga balebire ekigo eki ekyo waronkire, na Rwensinga egi eyo nkwombekeire, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.34",
            "verseOrgIds": [
              "2CH.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2CH 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "singa omw'iguru mbali osingiire ohulire enshara zabo n'okutaka kwabo, mara obememu basinge ababisha babo.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.35",
            "verseOrgIds": [
              "2CH.6.35"
            ]
          }
        }
