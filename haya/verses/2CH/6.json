          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mbwenu waitu Ruhanga wange, otulebe ichwe mara ohulire enshara ezashomerwa hanu aha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.40",
            "verseOrgIds": [
              "2CH.6.40"
            ]
          }
        },
