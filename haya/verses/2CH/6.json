          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "omu buzahe okwo kabalyechuza n'amagezi gabo gona n'omutima gwabo gwona, bakashoma enshara balebire ensi yabo eyo watungire baishebo, n'ekigo ekyo waronkire, na Rwensinga eyo nkwombekeire, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.38",
            "verseOrgIds": [
              "2CH.6.38"
            ]
          }
        },
        {
