{
  "id": "2CH.31",
  "number": "31",
  "bookId": "2CH",
  "reference": "2 Amakuru 31",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "2CH 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyo byona kabyahoire, Abaisiraeli bona ababaire bali Yerusalemu bataha omu bigo bya Yuda bakambura enyomyo, ebishushani bya Ashera ababisindura, obuju babukambura, na ealutare kutyo omuli Yuda, Benjamini, Efraimu na Manase, bazikambakambura zona. Nirwo Abaisiraeli bashubire omu bigo byabo, buli muntu omwa wenene.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.1",
            "verseOrgIds": [
              "2CH.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.1",
            "verseOrgIds": [
              "2CH.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia abeganisa abakuhani n'Abalevita omu bichweka, buli kichweka nk'okwo omuruka gwakyo ogw'eikora gwabaire guli. Abakuhani n'Abalevita kuta nibatamba ebihongo by'okwokibwa, n'ebihongo by'emilembe, kuheleza, kusiima n'okusingiza Omukama aha bihigi by'orusisira rw'Omukama. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.2",
            "verseOrgIds": [
              "2CH.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi omukama omw'itungalye akagiramu ebihongo by'okwokibwa ebya bwankya na bwaigoro n'ebihongo by'okwokibwa aha biro bya Sabato, buli kwema kw'okwezi n'aha biro bikuru ebitairweho, nk'okwo kyakahandikirwe omu Mateka g'Omukama. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.3",
            "verseOrgIds": [
              "2CH.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu abaturaga Yerusalemu abaragira kuha abakuhani n'Abalevita omugabo gwabo babone kukoza omwanya gwabo gwona kuhikya ebilikuragirwa Amateka g'Omukama. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.4",
            "verseOrgIds": [
              "2CH.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiragiro ekyo kakyamazire kugoba hona, Abaisiraeli baganuza emyaka nyingi, edivai, amajuta, obwoki na buli kimoi ekyayeraga omu ndimiro, baihyamu bingi ahali byona ebyo bayelize. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.5",
            "verseOrgIds": [
              "2CH.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaisiraeli na Yuda abaturaga omu bigo bya Yuda nabo baihyamu ente n'entaama, baleta n'egabo zingi baziletera Omukama Ruhanga wabo, bazituuma entuumo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.6",
            "verseOrgIds": [
              "2CH.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu mwezi gwa kashatu babanza kubituma entumo; omu mwezi gwa mushanju nirwo bamazire. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.7",
            "verseOrgIds": [
              "2CH.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia n'abatwazi kabaizire bakabona entumo ezo, basingiza Omukama n'eihangalye lya Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.8",
            "verseOrgIds": [
              "2CH.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia abaza abakuhani n'Abalevita entuumo ezo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.9",
            "verseOrgIds": [
              "2CH.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azaria Omukuhani Nyamukuru ayabaire natabuka omu ihiga lya Zadoki, amuhorora ati, “Kwema balesire ebintu ebi Rwensinga y'Omukama tuliire twaiguta, mara byashaga bitali bike. Omukama atungire eihangalye omugisha, twashobora kuhanika bingi biti.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.10",
            "verseOrgIds": [
              "2CH.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.10",
            "verseOrgIds": [
              "2CH.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Hezekia abaragira kutegura ebiyumba omuli Rwensinga y'Omukama; babitegura. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.11",
            "verseOrgIds": [
              "2CH.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakoza obwesigwa omu biyumba ebyo baba nimwo bateka endoboro n'ebihongo. Omugeleezi mukuru w'ebiyumba ebyo hakaba ali Kenania Omulevita, nahonderwa Shimei omurumuna. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.12",
            "verseOrgIds": [
              "2CH.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama Hezekia na Azaria omulebelezi mukuru wa Rwensinga bataho Yehieli, Azazia, Nahati, Asaheli, Yerimoti, Yozabadi, Elieli, Isimakia, Mahati na Benaya kuhwera Kenania na Shimei omurumuna kumanya ebintu ebyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.13",
            "verseOrgIds": [
              "2CH.31.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omulevita Kore eya Imuna, omukumilizi w'ekihigi ky'oburugaizoba, yamanyaga ebihongo eby'abantu bahongeraga Ruhanga omu bweyendezi bwabo, kandi ebihongo ebyo n'ebili bitakatifu muno niwe yabigabaga. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.14",
            "verseOrgIds": [
              "2CH.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu bigo by'abakuhani hakaba ainamu abahwezibe abesigwa, abhalimu Edeni, Minyamini, Yeshua, Shemaya, Amaria na Shekania. Nibo bashonderaga barumuna babo, omuto n'omukuru bwiganwa, nk'okwo ebichweka byabo byabaire bili. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.15",
            "verseOrgIds": [
              "2CH.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ababaire batabulimu ni balinya abahandikwaga kuhonderana n'emizarwa yabo, abashaija b'emyaka eshatu n'okutemba, bona abagyaga Rwensinga nk'okwo ezamu ya buli kiro yaragiraga, kukora omulimo gwabo nk'okwo ezamu zabo zahonderanaga. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.16",
            "verseOrgIds": [
              "2CH.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakuhani bahandikwaga kuhonderana n'amahiga gabo. Abalevita bahandikwaga kwema aha baina emyaka 20 n'okutemba, kuhonderana n'ebichweka byabo n'emiruka yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.17",
            "verseOrgIds": [
              "2CH.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakuhani bahandikwaga n'enkelemeke zabo, bakazi babo, batabani babo, bahara babo, oruganda rwona kurumarayo, aha rw'okuba bayelindaga muno, baikaraga bali batakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.18",
            "verseOrgIds": [
              "2CH.31.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha bw'abakuhani baijukuru ba Aroni abaturaga omu byaro ebyataine ebigo byabo, buli kigo hakaba halimu abakuhani n'Abalevita ababaire baronzirwe bakahandikwa kuta nibagabirwa ebyakulya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.19",
            "verseOrgIds": [
              "2CH.31.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.19",
            "verseOrgIds": [
              "2CH.31.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia akabitwaza atyo omuli Yuda yona, yaba mwesigwa yashemeleza Omukama Ruhangawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.20",
            "verseOrgIds": [
              "2CH.31.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli mulimo ogwo yakozire Rwensinga, nakwata Amateka n'emihango, naitanira Ruhanga, akabikora n'omutimagwe gwona, mara yagoshoka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.21",
            "verseOrgIds": [
              "2CH.31.21"
            ]
          }
        }
      ]
    }
  ],
