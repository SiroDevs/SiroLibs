{
  "id": "DEU.5",
  "number": "5",
  "bookId": "DEU",
  "reference": "Obwijukiro 5",
  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
