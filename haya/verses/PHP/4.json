  "reference": "Abafilipi 4",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "PHP 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PHP 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha rw'ekyo barumuna bange, abagonzibwa bange, nimbagilira orushusho, byera byange mara rukinga rwange, mugume muti mujwangaine n'Omukama.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.1",
            "verseOrgIds": [
              "PHP.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PHP 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.1",
            "verseOrgIds": [
              "PHP.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PHP 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Evodia na Sintike nimbatagiliza bashobokerwangane aha rw'Omukama. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.2",
            "verseOrgIds": [
              "PHP.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PHP 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naiwe mutahi wange omwesigwa, ninkushaba ojune abakazi aba, aha rw'enshonga tukachwazikanira evangeli nibashobokerwangana, tuli hamoi na Kelemensi n'abakozi batahi bange abandi abo amabara gabo gahandikire omu kitabo ky'oburora.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.3",
            "verseOrgIds": [
              "PHP.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PHP 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.3",
            "verseOrgIds": [
              "PHP.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PHP 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushemelerwe obutosha mujwangaine na Mukama. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.4",
            "verseOrgIds": [
              "PHP.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PHP 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwegumisiliza bwanyu bumanyike omu bantu bona, Omukama yaija kwija. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.5",
            "verseOrgIds": [
              "PHP.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PHP 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekintu kyona kyona kitabalya mwoyo. Ekiliho omuli buli kantu mumanyise Ruhanga ebyetago byanyu nimushoma enshara, nimutaka mara nimusiima. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.6",
            "verseOrgIds": [
              "PHP.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PHP 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emilembe ya Ruhanga eshaaga okushobokerwa kwona, elinde emitima yanyu n'ebitekelezo byanyu mwemire na Yesu Kirisito.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.7",
            "verseOrgIds": [
              "PHP.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PHP 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.7",
            "verseOrgIds": [
              "PHP.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PHP 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eky'enzindo barumuna bange, kyona kyona ekiraba kili ky'amazima, kili ky'ekitinwa, kili omw'iteka, kitaina kamogo, kili kirungi, nikigonzibwa, ka haraba haliho ekirungi kyona kyona, ka haraba haliho ekisaine kusiimwa, ebi mube nibyo mutekeleza. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.8",
            "verseOrgIds": [
              "PHP.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PHP 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyo mwanyegeireho, ebyo mwahairwe, ebyo mwampuliireho, n'ebyo mwamboineho mube nibyo mukora; mara aho Ruhanga w'emilembe arasingira omuli inywe.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.9",
            "verseOrgIds": [
              "PHP.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PHP 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.9",
            "verseOrgIds": [
              "PHP.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PHP 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu kujwangana kwange n'Omukama ninshemelerwa muno kubona okwo mwalemwa mukashuba mukanfaho, kyonkai mubaire mutaina bushango. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.10",
            "verseOrgIds": [
              "PHP.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PHP 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyo tindikukigambisibwa buburabulirwa; nobona nkega okusanirwa omu mibere yona yona eyo nakashangwa ndimu. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.11",
            "verseOrgIds": [
              "PHP.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PHP 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okugaywa ninkumanya, n'okugira bingi muno ninkumanya. Omuli buli kantu n'omu ngeli zona nkega akalyo k'okwiguta n'okurumwa enjara, kugira ebintu bingi n'okusigara bushai. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.12",
            "verseOrgIds": [
              "PHP.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PHP 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninshobora kukora buli kantu Kirisito anyemiremu, mara niwe antunga amani.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.13",
            "verseOrgIds": [
              "PHP.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PHP 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.13",
            "verseOrgIds": [
              "PHP.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHP 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai mukakora kunshasira omu naku zange. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.14",
            "verseOrgIds": [
              "PHP.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PHP 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mara inywe Bafilipi nywenene nimumanya okwo orwo nabandize kubarangira evangeli, orwo narugire Masedonia, taliho nteeko yanfireho. Ndikagira kyonabona anga kuburabulirwa, shana inywe nywenkai n'inywe mwanjunire. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.15",
            "verseOrgIds": [
              "PHP.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PHP 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nangu n'orwo ndi Tesalonika mukeyongera kuntwekera obujuni. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.16",
            "verseOrgIds": [
              "PHP.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PHP 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tikugir'oti nimpiga kamumpa bintu; shana ninyitanira okubona nimugoshoka. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.17",
            "verseOrgIds": [
              "PHP.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PHP 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emperwa ngiboine yona, tindikwetaga bishaagireho. Ebigemuro ebyo mutwekire Epafurodito nibimmara. Muntwekeire ekihongo ky'omugaju, ekitambo ekyo Ruhanga alikwenda mara ekilikumushemelera. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.18",
            "verseOrgIds": [
              "PHP.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PHP 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Ruhanga wange arabatunga buli kimoi ekyo mulikwetaga kuhondera obungi bw'eitungalye ely'ekitinwa mwemire na Yesu Kirisito. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.19",
            "verseOrgIds": [
              "PHP.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PHP 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga waitu mara Isheichwe ahabwe ekitinwa eirai n'eirai. Amina.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.20",
            "verseOrgIds": [
              "PHP.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PHP 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.20",
            "verseOrgIds": [
              "PHP.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PHP 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure buli mukirisito omuli Yesu Kirisito. N'abegesibwa abo tuli hamoi nibabakeisa. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.21",
            "verseOrgIds": [
              "PHP.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PHP 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakirisito bona nibabakeisa, okukiraho ab'omutungo gwa Kaisari. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.22",
            "verseOrgIds": [
              "PHP.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PHP 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama waitu Yesu Kirisito aikare abagilire ekisha inywena.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.23",
            "verseOrgIds": [
              "PHP.4.23"
            ]
          }
        }
      ]
    }
  ],
