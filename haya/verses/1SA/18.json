{
  "id": "1SA.18",
  "number": "18",
  "bookId": "1SA",
  "reference": "1 Samweli 18",
  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "1SA 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo Daudi yamazire kufumora na Shauli, Yonatani agonza Daudi eza fanfe, amugonza nk'okwo yayegonzaga. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.1",
            "verseOrgIds": [
              "1SA.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi kir'ekyo Shauli amwekwata okutamutaishura kushuba wabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.2",
            "verseOrgIds": [
              "1SA.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Yonatani anywana na Daudi, enshonga akaba namugonza nk'okwo yayegonzaga. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.3",
            "verseOrgIds": [
              "1SA.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajura ebebo eyo yabaire ajwete, agiha Daudi, n'ebikwatobye by'endashana, nangu n'embandaye, n'obutabwe n'omukandaragwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.4",
            "verseOrgIds": [
              "1SA.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi yagoshokaga hona hona mbali Shauli yamutumaga. Kityo Shauli amuhindura mukuru w'abaisherukalebe. Ekyo kikashemelera abantu bona, kwakwo n'abaramata ba Shauli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.5",
            "verseOrgIds": [
              "1SA.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.5",
            "verseOrgIds": [
              "1SA.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kababaire nibatabaruka Daudi yarugire kwita Omufilisiti, abakazi baturuka omu bigo byona bya Isiraeli nibahoya, nibaguruka kuchwekera Omukama Shauli, baina ebikwato by'amayaga, baina n'engarabi, nibazina n'ebyera. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.6",
            "verseOrgIds": [
              "1SA.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo balikushanduka bazina nibahororangana bati,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.7",
            "verseOrgIds": [
              "1SA.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.9",
            "verseOrgIds": [
              "1SA.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeire Ruhanga atweka omuzimu gubanda Shauli n'amani, agamba asiga akaragi omu njuye, aho Daudi atera enanga nk'okwo yagiraga buli kiro. Shauli akaba akwete eichumu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.10",
            "verseOrgIds": [
              "1SA.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alijugunyira Daudi nashubira kumubambijanyia aha rukuta. Kyonkai Daudi amuhigiza emirundi ebili.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.11",
            "verseOrgIds": [
              "1SA.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.11",
            "verseOrgIds": [
              "1SA.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shauli yatinaga Daudi aha rw'enshonga Omukama akaba ainawe, kandi wenene akaba yamurugireho. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.12",
            "verseOrgIds": [
              "1SA.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikwo kumweihyaho akamuhindura mukuru w'orukumi; yaba natabara natabaruka ayebembeire embaga. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.13",
            "verseOrgIds": [
              "1SA.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyo yakoraga byona byagoshokaga, kuba Omukama akaba amwemiremu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.14",
            "verseOrgIds": [
              "1SA.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo Shauli yaboine okwo yabaire nagoshoka muno yamutina. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.15",
            "verseOrgIds": [
              "1SA.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai Abaisiraeli bona na Yuda bamugonza; aha rw'okuba yatabaraga abebembeire, atabaruka abakulembeire.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.16",
            "verseOrgIds": [
              "1SA.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.16",
            "verseOrgIds": [
              "1SA.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Shauli agambira Daudi ati, “Merabu muhara wange omukuru ali aha; ninyija kumukusiigira. Ekikuru ombere manzi orwane endashana z'Omukama.” Okumugambira atyo akaba natekeleza ati, “Atangwaho, agwe aha Bafilisiti.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.17",
            "verseOrgIds": [
              "1SA.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi agambira Shauli ati, “Inye nab'ohai n'abanyaruganda bange, eka ya tata omuli Isiraeli baba bahai, inye kuba mukoi w'Omukama?” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.18",
            "verseOrgIds": [
              "1SA.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai omu bukiro obwo Merabu yabaire naija kushwerwa Daudi, bamuhangiira Adirieli Omumeholati.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.19",
            "verseOrgIds": [
              "1SA.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.19",
            "verseOrgIds": [
              "1SA.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Mikali muhara wa Shauli ondijo yagonzaga Daudi; bagambira Shauli, ekigambo ekyo kimushemelera. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.20",
            "verseOrgIds": [
              "1SA.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shauli atekeleza ati, “Kamumuhe aije amubere mutego, Abafilisiti baije bamwite.” Aha rw'ekyo agambira Daudi omurundi gwa kabili ati, “Mbwenu noija kuba mukoi wange.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.21",
            "verseOrgIds": [
              "1SA.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aragira abaramatabe ati, “Mugambire Daudi omu kyama muti, ‘Omukama nakushemelerwa, n'abaramatabe bona nibakugonza; ahonu obe mukoi w'Omukama.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.22",
            "verseOrgIds": [
              "1SA.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaramata ba Shauli bagambira Daudi ebigambo ebyo. Daudi agamba ati, “Inywe nimubona kintu kijege inye kuba mukoi w'Omukama?” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.23",
            "verseOrgIds": [
              "1SA.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaramata bagambira Shauli okwo Daudi yahorora. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.24",
            "verseOrgIds": [
              "1SA.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Shauli abaragira kugambira Daudi bati, “Omukama talikwegomba makura, shana enshembe 100 z'Abafilisiti, abone kwehora ababisha b'Omukama.” Shauli akaba agendeleire kumwisa Abafilisiti. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.25",
            "verseOrgIds": [
              "1SA.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo abaramatabe babaruliire Daudi ebigambo ebyo, Daudi ashemelerwa kuba mukoi w'omukama. Ebiro kabyabaire bitakahingiwreho, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.26",
            "verseOrgIds": [
              "1SA.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi atabara n'abashaijabe aita Abafilisiti 200; aleta enshembe zabo, aziha omukama orubara rwijwire, abone kuba mukoiwe. Nikwo Shauli kumusiigira omuhara, Mikali. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.27",
            "verseOrgIds": [
              "1SA.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai orwo Shauli ogwo yaboine okwo Omukama yabaire amwemiremu, n'okwo omuhara Mikali yabaire namugonza, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.28",
            "verseOrgIds": [
              "1SA.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shauli yatina Daudi okushagaho. Aho anoba Daudi obutaleka.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.29",
            "verseOrgIds": [
              "1SA.18.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.29",
            "verseOrgIds": [
              "1SA.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahanyuma abatwazi b'Abafilisiti batabara omu ndashana, mara orwo bakatabaraga Daudi yabonaga egoshoko kushaga abaramata ba Shauli bona; kityo eibaralye liranganwa muno.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.30",
            "verseOrgIds": [
              "1SA.18.30"
            ]
          }
        }
      ]
    }
  ],
