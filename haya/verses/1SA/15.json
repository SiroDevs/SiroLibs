              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahanyuma Samweli agya Rama, kandi Shauli agya omwe Gibea eya Shauli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.34",
            "verseOrgIds": [
