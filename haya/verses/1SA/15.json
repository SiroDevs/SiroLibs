              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samweli aragira ati, “Ndetera Agagi omukama w'Abaamaleki hanu aha.” Agagi amugoba nashemelerwa, agamba ati, “Obushasi bw'orufu bwahwaho.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.32",
            "verseOrgIds": [
              "1SA.15.32"
            ]
          }
        },
