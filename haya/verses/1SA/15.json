          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samweli agamba ati, “Okwo embandwa yawe echwire abakazi amabere, nikwo erachwa nyoko amabere omu bakazi.” Aho Samweli achwagachwagura Agagi omu maisho g'Omukama omuli Giligali.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.33",
            "verseOrgIds": [
              "1SA.15.33"
            ]
          }
        }
