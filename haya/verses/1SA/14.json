{
  "id": "1SA.14",
  "number": "14",
  "bookId": "1SA",
  "reference": "1 Samweli 14",
  "verseCount": 52,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "1SA 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiro kimoi Yonatani mutabani wa Shauli, agambira omusigazi ayamutwaliraga ebikwatobye ati, “Ija tushabuke tugye buseli aha boma y'Abafilisiti.” Kyonkai ishe tiyamugambiire. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.1",
            "verseOrgIds": [
              "1SA.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shauli akaba natura omu mparo za Gibea aha mukomamanga gwa Migironi. Akaba ainayo abashaija nka 600, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.2",
            "verseOrgIds": [
              "1SA.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ainayo na Ahiya mutabani wa Ahitubi, Ahitubi murumuna Ikabodi, Ikabodi eya Finehasi, Finehasi eya Eli, omukuhani w'Omukama omuli Shilo. Ahiya yajwaraga efodi. Emigendere ya Yonatani abantu tibagimanyire. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.3",
            "verseOrgIds": [
              "1SA.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu kyasha ekyo Yonatani yabaire nahiga kurabamu kugya aha boma y'Abafilisiti hakaba halimu ekibare rubaju orumoi n'ekindi rubaju orundi. Ekimoi kikaba nikyetwa Bozezi, ekindi nikyetwa Senehi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.4",
            "verseOrgIds": [
              "1SA.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekibare ekimoi kyemeleire bikara bya Mikimashi, n'ekindi kasi ya Geba.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.5",
            "verseOrgIds": [
              "1SA.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.5",
            "verseOrgIds": [
              "1SA.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonatani agambira omusigazi ayamutwaliraga ebikwatobye ati, “Ija tushabuke tugye aha boma y'abatatahiriirwe aba, rundi Omukama yakugira ekyo yatukolera; kuba twaba bangi anga bake thaliho yakutanga Mukama kutukoza kurokora bantube.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.6",
            "verseOrgIds": [
              "1SA.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omutwazi w'ebikwatobye amugambira ati, “Okore kyona kyona okw'orayenda, leba tuli hamoi. Okwo olikwenda nikwo ndikwenda.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.7",
            "verseOrgIds": [
              "1SA.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonatani ashuba agamba ati, “Tushabuke tugobe abashaija balinya batubone. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.8",
            "verseOrgIds": [
              "1SA.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabaratugambira bati, ‘Mulinde twije okwo,’ aho turayemelera mbali tuli, mbali bali titugyeyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.9",
            "verseOrgIds": [
              "1SA.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai kabaragamba bati, ‘Mwije mbali tuli,’ aho turagenda kuba Omukama araba abatunagire omu mikono. Aka niko karatubera kabonero.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.10",
            "verseOrgIds": [
              "1SA.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kityo bombili beyoleka Abafilisiti abali omu boma, n'Abafilisiti bati, “Leba Abaheburania nibajumbuka omu bitairongo mbali babaire beshelekire.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.11",
            "verseOrgIds": [
              "1SA.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abashaija b'omu boma bayeta Yonatani n'omutwazi w'ebikwatobye babagambira bati, “Mwije kunu tugire ekyo twaboleka.” Yonatani agambira omutwazi w'ebikwatobye ati, “Mpondera enshonga Omukama yabanaga omu mikono ya Isiraeli.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.12",
            "verseOrgIds": [
              "1SA.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Yonatani akuuba nagenza emikono n'amaguru, n'omutwazi w'ebikwatobye amuhondera. Yonatani atera Abafilisiti, n'omutwazi w'ebikwatobye aruga enyuma abaita. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.13",
            "verseOrgIds": [
              "1SA.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliita elya mbere Yonatani n'omutwazi w'ebikwatobye bakaita abantu nka 20 omu nusu eka. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.14",
            "verseOrgIds": [
              "1SA.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habaho obutini bungi omu rusisira n'aheru, n'omu bantu bona; ab'omu boma nangu n'abanyagi bachundwa; ensi etengeta, obutini buba bungi muno.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.15",
            "verseOrgIds": [
              "1SA.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.15",
            "verseOrgIds": [
              "1SA.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalinzi ba Shauli omuli Gibea eya Benjamini baleba; babona embaga netatamira oku n'oku. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.16",
            "verseOrgIds": [
              "1SA.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Shauli agambira abantu abo yabaire ainabo ati, “Bara mubone n'ohai ayaturugamu.” Kayabazire abona okwo Yonatani n'omutwazi w'ebikwatobye bathalimu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.17",
            "verseOrgIds": [
              "1SA.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agambira Ahiya ati, “Leta aha Esanduku ya Ruhanga.” Nobona omu makiro ago Abaisiraeli bagendaga n'Esanduku ya Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.18",
            "verseOrgIds": [
              "1SA.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shauli orwo yabaire nafumolera omukuhani enkuranga esheba omu rusisira rw'Abafilisiti; nikwo Shauli kugambira omukuhani ati, “Lekelera aho.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.19",
            "verseOrgIds": [
              "1SA.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shauli n'abantu bona abo yabaire ainabo betekateka bagya omu ndashana. Habaho akatabure kangi muno, buli muntu embandaye eita mutahiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.20",
            "verseOrgIds": [
              "1SA.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaheburania ababaire baikaire n'Abafilisiti obubere, bakagenda nabo omu rusisira, kwakwo beyunga n'Abaisiraeli, abo Shauli na Yonatani babaire bainabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.21",
            "verseOrgIds": [
              "1SA.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'Abaisiraeli bona ababaire beshelekire omu mabanga ga Efuraimu bahulira okwo Abafilisiti basingwa, na bonene bababinga babafunza omu ndashana. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.22",
            "verseOrgIds": [
              "1SA.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kir'ekyo Omukama aba nikwo arokora atyo Isiraeli. Endashana eyeyongera buseli bwa Betiaveni.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.23",
            "verseOrgIds": [
              "1SA.14.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.23",
            "verseOrgIds": [
              "1SA.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kir'ekyo Abaisiraeli bakashasha aha rw'okuba Shauli akahahira ati, “Aralya ekyakulya litakatobeire, ntakehoroize babisha bange, aramwe.” Orw'ekyo thaliho muntu yarolize kyakulya. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.24",
            "verseOrgIds": [
              "1SA.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bona bataha ekibira, bashangamu obwoki ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.25",
            "verseOrgIds": [
              "1SA.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibutonona, kyonkai thaliho muntu yataire mukono aha munwa, enshonga bakatina ekinahiro. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.26",
            "verseOrgIds": [
              "1SA.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekinahiro ekyo Shauli yataireho abantu Yonatani akaba atakimanyire. Aimukya enkoni eyo yabaire akwete, ata enshonga yayo omu kigabo ky'obwoki, ashuba ateka omukono aha munwa, aho amaishoge gengelera. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.27",
            "verseOrgIds": [
              "1SA.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu omoi omu mbaga agamba ati, “Isho anahize muno embaga nagamba ati, ‘Nakaraamwe aralya ekyakulya kir'eki.’ ” Abantu bakaba balemirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.28",
            "verseOrgIds": [
              "1SA.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Yonatani agamba ati, “Tata yashasa ensi; leba okwo ndikwengelera amaisho orwo narozaho obwoki. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.29",
            "verseOrgIds": [
              "1SA.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tikyakubaire kirungi abantu ebyo banyaga ababisha kabakubiliire okwo balikwenda! Manya nikyo n'Abafilisiti tutabaitira muno.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.30",
            "verseOrgIds": [
              "1SA.14.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.30",
            "verseOrgIds": [
              "1SA.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kir'ekyo baita Abafilisiti kwema Mikimashi kugoba Aihaloni. Abantu balemwa muno. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.31",
            "verseOrgIds": [
              "1SA.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1SA 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bahyokera eminyago, bakwata entaama, n'ente n'enyana, bazitera ahansi, baziliirana n'obwamba. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.32",
            "verseOrgIds": [
              "1SA.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1SA 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho bagambira Shauli bati, “Leba, abantu bafakalira Omukama orwo balirana n'obwamba!” Agamba ati, “Ekyo mwakikoza obugobya. Hilingisa eibare lihango lije aha.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.33",
            "verseOrgIds": [
              "1SA.14.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1SA 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashuba ati, “Murabarabe omu bantu mubagambire muti, ‘Buli omoi alete enteye anga entaamaye, muzibagire hanu aha mulye. Mutalirana bwamba kufakalira Mukama.’ ” Kityo omu kiro ekyo buli muntu aleta ente bazibagira aho. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.34",
            "verseOrgIds": [
              "1SA.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1SA 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shauli ayombekera Omukama ealutare; niyo yabaire ealutare ya mbere eyo yamwombekeire.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.35",
            "verseOrgIds": [
              "1SA.14.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1SA 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.35",
            "verseOrgIds": [
              "1SA.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1SA 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shauli agamba ati, “Tuhondere Abafilisiti omu kiro omu tubanyage obwire bukye. Twite bona tubamareho.” Bamugambira bati, “Okore okwo orayenda.” Kyonkai omukuhani agira ati, “Tubanze tubaze Ruhanga.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.36",
            "verseOrgIds": [
              "1SA.14.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1SA 14:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shauli araguza ahali Ruhanga ati, “Mpondere Abafilisiti? Isi orabanaga omu mikono ya Isiraeli?” Kyonkai kir'ekyo Omukama tiyamuhoroire. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.37",
            "verseOrgIds": [
              "1SA.14.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1SA 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shauli agamba ati, “Abebembezi b'embaga inywena mwije, mulebe okwo kir'eki entambara egi yaija. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.38",
            "verseOrgIds": [
              "1SA.14.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1SA 14:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obuso bw'Omukama asingire arokora Isiraeli! N'orwo ayakora entambara egi yakuba Yonatani mutabani wange mazima nafa.” Kyonkai thaliho muntu n'omoi ayamuhoroire. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.39",
            "verseOrgIds": [
              "1SA.14.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1SA 14:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho agambira Abaisiraeli bona ati, “Mugye rubaju rumoi, inye na Yonatani mutabani wange tugye rubaju orundi.” Abantu bagambira Shauli bati, “Okore okwo orayenda.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.40",
            "verseOrgIds": [
              "1SA.14.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1SA 14:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shauli agamba ati, “Waitu Mukama Ruhanga wa Isiraeli, kubaki kir'eki otahorora mwiru wawe? Entambara egi k'eraba yakorwa inye anga Yonatani mutabani wange, waitu Mukama Ruhanga wa Isiraeli, urimu etugambire. K'eraba yakorwa abantu bawe ba Isiraeli, tumimu etugambire.” Yonatani na Shauli urimu ebakwata, embaga eruhonokaho. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.41",
            "verseOrgIds": [
              "1SA.14.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1SA 14:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Shauli agamba ati, “Teka enshoga tumanye nka n'inye anga mutabani wange Yonatani.” Urimu ekwata Yonatani.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.42",
            "verseOrgIds": [
              "1SA.14.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1SA 14:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.42",
            "verseOrgIds": [
              "1SA.14.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1SA 14:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikwo Shauli kugambira Yonatani ati, “Ngambira eky'okozire.” Yonatani amugambira ati, “Ndolizeho obwoki buke n'enkoni eyo mbaire nkwete; ndi aha, nfe.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.43",
            "verseOrgIds": [
              "1SA.14.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1SA 14:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shauli agamba ati, “Ruhanga anyite, Yonatani k'otafiire.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.44",
            "verseOrgIds": [
              "1SA.14.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1SA 14:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bagambira Shauli bati, “Yonatani asingiire Isiraeli endashana yakufa atai? Nikikabure! Obuso bw'Omukama asingire, thaliho rushoke na rumoi rwa Yonatani ruraragara hansi. Kir'eki ekyo yakora yaba ayemire na Ruhanga.” Nikwo embaga yachungwire etyo Yonatani, tiyafire. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.45",
            "verseOrgIds": [
              "1SA.14.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1SA 14:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shauli alekelera aho okubinga Abafilisiti, ashuba omuka, n'Abafilisiti bagaruka owabo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.46",
            "verseOrgIds": [
              "1SA.14.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1SA 14:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.46",
            "verseOrgIds": [
              "1SA.14.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1SA 14:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shauli kayabaire yatwete engoma ya Isiraeli, arashana n'ababishabe bona aba buli rubaju. Arashanisa Moabu, Abaamoni, Edomu, abakama ba Zoba n'Abafilisiti. Hona mbali yagyaga yabasingaga muno. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.47",
            "verseOrgIds": [
              "1SA.14.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1SA 14:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amanzara aita Abaamaleki, arokora Isiraeli omu mikono y'ababanyagaga.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.48",
            "verseOrgIds": [
              "1SA.14.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1SA 14:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.48",
            "verseOrgIds": [
              "1SA.14.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1SA 14:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abatabani ni Yonatani, Ishivi na Malikishua. Abahara babili: Omuzigaijo eibaralye ni Merabu, omuto ni Mikali. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.49",
            "verseOrgIds": [
              "1SA.14.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1SA 14:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukaziwe ni Ahinoamu muhara wa Ahimaasi. Omukuru w'eihelye ni Abuneri mutabani wa Neri, kandi Neri ni ishento Shauli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.50",
            "verseOrgIds": [
              "1SA.14.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1SA 14:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kishi niwe ishe Shauli, na Neri ishe Abuneri akaba ali mutabani wa Abieli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.51",
            "verseOrgIds": [
              "1SA.14.51"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1SA 14:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.51",
            "verseOrgIds": [
              "1SA.14.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1SA 14:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oburorabwe bwona Shauli akarashana muno n'Abafilisiti. Kayabonaga omuntu wena wena aina amani anga ali manzi yamutahyaga omw'ihelye.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.52",
            "verseOrgIds": [
              "1SA.14.52"
            ]
          }
        }
      ]
    }
  ],
