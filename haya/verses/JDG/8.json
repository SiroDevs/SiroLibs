        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.32",
            "verseOrgIds": [
              "JDG.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo Gideoni yafire ati, Abaisiraeli bashuba bafukamira Ababaali. Baaliberiti bamuhindura ruhanga wabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.33",
            "verseOrgIds": [
              "JDG.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tibaijukire Mukama Ruhanga wabo ayabarokoire omu mikono y'ababisha babo aba buli rubaju. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.34",
            "verseOrgIds": [
              "JDG.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'eka ya Yerubaali (niwe Gideoni) tibagigiliire kisha aha rw'ebirungi byona ebyo yabakoleire.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.35",
            "verseOrgIds": [
              "JDG.8.35"
            ]
          }
        }
