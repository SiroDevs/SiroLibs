        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.12",
            "verseOrgIds": [
              "JDG.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abudoni eya Hileli Omupirathoni amuhondera aramura Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.13",
            "verseOrgIds": [
              "JDG.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaba aina abatabani 40 n'abaijukuru 30. Bonene abo bakuubaga endogobe 70. Akaramura Isiraeli emyaka munana. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.14",
            "verseOrgIds": [
              "JDG.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahanyuma afa, aziikwa Piratoni omu nsi ya Efuraimu omu mabanga g'Abaamaleki.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.15",
            "verseOrgIds": [
              "JDG.12.15"
            ]
          }
        }
      ]
