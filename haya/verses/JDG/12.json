          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eloni Omuzebuluni amuhondera aramura Isiraeli emyaka 10. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.11",
            "verseOrgIds": [
              "JDG.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahanyuma afa, aziikwa Aihaloni omu nsi ya Zabuloni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.12",
            "verseOrgIds": [
              "JDG.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
