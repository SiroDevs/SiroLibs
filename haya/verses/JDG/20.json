        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.20.28",
            "verseOrgIds": [
              "JDG.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
