          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama nagamba ati,",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.40",
            "verseOrgIds": [
              "JER.48.40"
            ]
          }
