        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.39",
            "verseOrgIds": [
              "JER.48.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
