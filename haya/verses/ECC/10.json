          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "abafera bahabwa emyanya nyingi ey'ekitinwa ey'okushuntamaho, kandi abatungi bashuntama omu myanya ey'ahansi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.6",
            "verseOrgIds": [
