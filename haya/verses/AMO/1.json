            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.10",
            "verseOrgIds": [
              "AMO.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama nagamba ati, “Aha rw'abantu ba Edomu kwikara nibafakara, tindiburwa kubabonabonyia. Enshonga baikara nibarashanisa barumuna babo Abaisiraeli, taliho rwo babagilira buganyizi. Ebiro byona batura babatamirwe, bakabagilira enzigu. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.11",
            "verseOrgIds": [
              "AMO.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kityo ekigo kya Temani ndikichumika omuliro, gulyokya n'eboma za Bozira gulizisosotora.”",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.12",
            "verseOrgIds": [
              "AMO.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
