              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagira emize yona, entambara, omururu n'orwango. Baijurwa ekiisho, baita abantu, okurwana, ebishuba, orwangorogo, okugeya, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.29",
            "verseOrgIds": [
