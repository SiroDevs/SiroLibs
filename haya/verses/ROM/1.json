              "type": "text"
            }
          ]
        },
        {
          "text": "okuchwelerera, okunoba Ruhanga, eikuru, eisinini, okwetutumura, kugishagisha emize mibi n'okutahulira bazaire. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.30",
            "verseOrgIds": [
