              "type": "text"
            }
          ]
        },
        {
          "text": "Baba bafano, tibagira bwesigwa aha byo baragaine, baba bihwamwoyo, tibagira na mama. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.31",
