  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "ROM 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha rw'ekyo, orwo okwesiga kutuhindwire bagorogoki, twina emilembe ahali Ruhanga eyo twaleteirwe Omukama waitu Yesu Kirisito. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.1",
            "verseOrgIds": [
              "ROM.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuli wenene tugiliirwe ekisha ekyo twemeleiremu, kandi nitushanduuka kubona twina eshubi y'okubona ekitinwa kya Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.2",
            "verseOrgIds": [
              "ROM.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi t'ekyo kyonkai: N'orwo tuli omu bushasi nitushanduuka, orwo tulikumanya okwo obushasi burugwamu okwegumisiliza, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.3",
            "verseOrgIds": [
              "ROM.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi okwegumisiliza kurugwamu obumanzi, n'obumanzi burugwamu eshubi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.4",
            "verseOrgIds": [
              "ROM.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshubi etugumisa, ahakuba Mwoyo Mutakatifu owo twahairwe akatushesha engonzi za Ruhanga omu mitima.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.5",
            "verseOrgIds": [
              "ROM.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.5",
            "verseOrgIds": [
              "ROM.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo twabaire tukyali bajege, omu kaanya konene konene Kirisito yafera abatatina Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.6",
            "verseOrgIds": [
              "ROM.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikiguma omuntu kufera omugorogoki, n'orwo orundi omuntu yakumaza kufera omuntu omurungi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.7",
            "verseOrgIds": [
              "ROM.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai Ruhanga nayoleka engonzize ahali ichwe kubona Kirisito natufera orwo twabaire tukyali bafakare. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.8",
            "verseOrgIds": [
              "ROM.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha rw'ekyo orwo turokoirwe obwambabwe, turayeyongera kurokoka aha kiniga kya Ruhanga aha bwa wenene. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.9",
            "verseOrgIds": [
              "ROM.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enshonga k'okufa kw'Omwanawe kuraba kwatugarwire ahali wenene okwo tukyali babisha, mbwenu okushaagaho orwo twina emilembe ahali Ruhanga, oburora bwa Kirisito buraturokora. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.10",
            "verseOrgIds": [
              "ROM.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai t'ekyo kyonkai, nitushuba nitushanduuka aha rw'ebyo Ruhanga yakozire aha rwa Yesu Kirisito, wenene ogu ayatugarwire ahali Ruhanga.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.11",
            "verseOrgIds": [
              "ROM.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.11",
            "verseOrgIds": [
              "ROM.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kityo nk'okwo obufu bwaizire omu nsi aha rw'okufakara kw'omuntu omoi, n'orufu rukaletwa entambara, nikwo n'orufu rwakaranzire rukaba rw'abantu bona enshonga abantu bona bakafakara. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.12",
            "verseOrgIds": [
              "ROM.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu mazima obufu bukabaho omu nsi Amateka gatakatairweho, kyonkai mbali Amateka gatali obufu tibumanyikaho. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.13",
            "verseOrgIds": [
              "ROM.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwema ahali Adamu kuturuka ahali Musa rufu aketwaliliza abantu, nangu yayetwaliliza na balinya abo amafu gabo gabaire gatalikushusha ntambara ya Adamu. Adamu akaba nashura ogwo ayabaire ali w'okwija.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.14",
            "verseOrgIds": [
              "ROM.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.14",
            "verseOrgIds": [
              "ROM.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai amatungwa tigalikushusha ntambara. K'abangi baraba bafire nibazira entambara y'omuntu omoi, Adamu, nikwo n'ekisha kya Ruhanga hamoi n'amatungwage omu kisha ky'omuntu omoi Yesu Kirisito bili bingi okushaagaho aha rw'abantu bangi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.15",
            "verseOrgIds": [
              "ROM.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi amatungwa ago tigalikwigana na kyazarukire omu bufu bw'omuntu ogwo omoi. Kuba eiramu elyalesirwe entambara emoi likaleta omuramo, kyonkai ekisha ekigizirwe aha rw'embabazi kwiza entambara zingi nikihindura abantu kuboneka bali bagorogoki. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.16",
            "verseOrgIds": [
              "ROM.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka rufu araba yagizire amani aha rw'okufakara kw'omuntu omoi ogwo Adamu, nikwo na balinya abalikugilirwa ekisha kingi n'okubona egabo y'obugorogoki egizirwe aha rw'embabazi barabona oburora oburamukire aha rw'omuntu omoi Yesu Kirisito.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.17",
            "verseOrgIds": [
              "ROM.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.17",
            "verseOrgIds": [
              "ROM.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho nk'okwo entambara y'omuntu omoi yalesire omuraamo aha bantu bona, nikwo n'ekikorwa ky'obugorogoki kilikuletera abantu bona omugaruliro n'oburora. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.18",
            "verseOrgIds": [
              "ROM.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk'okwo okutahulira kw'omuntu omoi kwahindwire bangi kuba bafakare nikwo bangi barakorwa omuhuliro gw'omuntu omoi bakaba bagorogoki? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.19",
            "verseOrgIds": [
              "ROM.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amateka gakaija kukanyisa entambara; kyonkai mbali obufu bwayeyongeire, ekisha kikeyongera okushaagaho, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.20",
            "verseOrgIds": [
              "ROM.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kityo nk'okwo bufu bwayetwete aha rw'enshonga ya rufu, kwakwo n'ekisha nikwo kyaliire obukama aha rw'obugorogoki obulikututwara omu burora obutalihwaho omuli Yesu Kirisito Omukama waitu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.21",
            "verseOrgIds": [
              "ROM.5.21"
            ]
          }
        }
      ]
    }
