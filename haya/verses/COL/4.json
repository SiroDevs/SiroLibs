          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.17",
            "verseOrgIds": [
              "COL.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "COL 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inye Paulo, ebishuro ebi n'inye ndikubyehandikira Muraijuka okwo ndi jela. Omugisha gw'Omukama gube na inywe.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.18",
            "verseOrgIds": [
              "COL.4.18"
            ]
          }
        }
      ]
    }
  ],
