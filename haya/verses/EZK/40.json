        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "EZK 40:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikwo kushuba akandeta omu kishasi kya Rwensinga akapima efuremu yakyo: Mita 2 1/2 buli rubaju. Obukika bw'ekihigi zili mita 7. Kandi enkuta z'omu rubaju ez'ekihigi zikaba zina emita 1 1/2 buli rubaju. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.48",
            "verseOrgIds": [
              "EZK.40.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "EZK 40:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekishasi kikaba kina oburai bw'emita 10, n'obukika bw'emita 6. Mara kikaba kiina amatembero 10. Ahali buli rubaju rw'efuremu hakaba haliyo enyomyo inai.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.49",
            "verseOrgIds": [
              "EZK.40.49"
            ]
          }
        }
      ]
