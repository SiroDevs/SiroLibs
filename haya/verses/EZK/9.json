          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahanyuma, omushaija ayabaire ajwete kitani, akwatire eihembe ly'abahandiki aha rubaju linamu obwino, agaruka kumugambira, ati, “Waitu okwo wampangira nikwo nakora.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.11",
            "verseOrgIds": [
              "EZK.9.11"
            ]
          }
        }
