            "sid": "EZR 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.22",
            "verseOrgIds": [
              "EZR.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho orwo ekopi y'ebarua y'Omukama Aritashasita yashomeirwe omu maisho ga Rehumu na Shimushai omuhandiki na batahi babo, banguha bagendera Abayahudi omuli Yerusalemu, babalekeza rwamani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.23",
            "verseOrgIds": [
              "EZR.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZR 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elyombeka lya Rwensinga ya Ruhanga omuli Yerusalemu lilekera, lyemelera kuhika omu mwaka gwa kabili gw'obutwazi bwa Dario omukama wa Perisia.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.24",
            "verseOrgIds": [
              "EZR.4.24"
            ]
          }
        }
      ]
    }
  ],
