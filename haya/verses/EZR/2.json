            "style": "v",
            "sid": "EZR 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baija na Zerubabeli, Yeshua, Nehemia, Seraya, Beelaya, Moridekai, Bilishani, Misipari, Bigwai, Rehumu na Baana.",
