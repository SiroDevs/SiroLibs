        {
          "text": "Aba nibo bazahe abarugire omu mukoa gwa Babiloni omu buzahe, abo Nebukadineza omukama wa Babiloni yabaire yabaire atweteyo. Bakagaruka Yerusalemu na Yuda buli muntu omu kigokye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.1",
            "verseOrgIds": [
              "EZR.2.1"
            ]
          }
        },
        {
          "name": "verse",
