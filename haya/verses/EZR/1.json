            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.10",
            "verseOrgIds": [
              "EZR.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebikwato byona eby'ezahabu n'eby'efeza bikaba bili 5,469.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.11",
            "verseOrgIds": [
              "EZR.1.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:11",
              "type": "text"
            },
            {
              "text": "5,469",
              "type": "text"
            },
            {
              "text": "Ebihandiko ebindi biti, 5,400.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebi byona nibyo Sheshubaza yaizire nabyo orwo abazahe barugire Babiloni kugaruka Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.11",
            "verseOrgIds": [
              "EZR.1.11"
            ]
          }
        }
      ]
    }
