{
  "id": "ISA.28",
  "number": "28",
  "bookId": "ISA",
  "reference": "Isaya 28",
  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "ISA 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagwerwa abatwazi entamiizi za Efuraimu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.1",
            "verseOrgIds": [
              "ISA.28.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "28:1",
              "type": "text"
            },
            {
              "text": "Efuraimu",
              "type": "text"
            },
            {
              "text": "Niyo ngoma ya Isiraeli eya bikara.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", n'ekitinwa kyabo kyahwaho okw'obona orwakyo. Abatwazi b'eikuru besiigire amarasi omu mitwe, kyonkai leba, babaire mirambwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.1",
            "verseOrgIds": [
              "ISA.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama aina omuntu ow'amani emanzi; aina amani nk'embuyaga y'orubare esilikya buli kantu, nashusha amayengo; naija kubakuntura ahansi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.2",
            "verseOrgIds": [
              "ISA.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abatwazi abo ab'eikuru, entamiizi za Efuraimu nibaija kujungilirwa omw'itaka, nibazira eikuru lyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.3",
            "verseOrgIds": [
              "ISA.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekitinwa ky'abatwazi abo ab'eikuru, kirahwaho nk'etini ezihisa mbere, nizo zihisa ziti aho n'aho bakazinoga bakazilya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.4",
            "verseOrgIds": [
              "ISA.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.4",
            "verseOrgIds": [
              "ISA.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiro kilija orwo Omukama w'amahe alirokora abantube alibashusira orukinga rw'ekitinwa orw'amaua. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.5",
            "verseOrgIds": [
              "ISA.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atuliba nibakora omulimo gw'oburamuzi alibaha okumanya amazima, n'atuliba nitulinda ebihigi by'ekigo bitaterwa mubisha alibaha okugira obumanzi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.6",
            "verseOrgIds": [
              "ISA.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.6",
            "verseOrgIds": [
              "ISA.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nangu n'abarangi n'abakuhani nibatamiira, nibatarambukana. Batamiire edivai n'amarwa, byabamara amagezi, nibataratara. Abarangi batamiire muno, tibaina na gashobokerwa byo Ruhanga alikuboleka. Abakuhani nabo batamiire muno, tibaina garamura mishango eyo tulikubaletera. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.7",
            "verseOrgIds": [
              "ISA.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emeza zona ezo bashuntamireho zijwire entanaki, taliho mtuli zitatokoire n'akake.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.8",
            "verseOrgIds": [
              "ISA.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.8",
            "verseOrgIds": [
              "ISA.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibanjuma bati, “Omuntu ogwo ebyo alikwegesa nabishobokerwa? N'ohai alikwetaga kumuhulira ebyo alikugamba? Ebyo bisaine enchuke! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.9",
            "verseOrgIds": [
              "ISA.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenene nagonza kutwegesa buli kantu, nka yatwisa orube!”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.10",
            "verseOrgIds": [
              "ISA.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.10",
            "verseOrgIds": [
              "ISA.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamurayanga kumpuliliza, Ruhanga arakoza abanyamahanga bakoze endimi ezo mutalikumanya, babe nibo babegesa mukahulira. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.11",
            "verseOrgIds": [
              "ISA.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabatunga emilembe mwaikarage, kyonkai mwayanga kumuhuliliza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.12",
            "verseOrgIds": [
              "ISA.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyo nshonga Ruhanga naija kubegesa buli kantu, mulemwe mubikwate. Mushube mutambuke nimusitara, mugwe omu mitego, muhutare, bashube babatware endore.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.13",
            "verseOrgIds": [
              "ISA.28.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.13",
            "verseOrgIds": [
              "ISA.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu inywe batwazi b'eikuru atulikutwara eihanga eli omuli Yerusalemu, huliliza ebyo Omukama alikugamba. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.14",
            "verseOrgIds": [
              "ISA.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimugamba okwo mutalikutina rufu, kamwakufa mufa. Nimwebeiya okwo mutabe kantu orwo ekibundo kiratera. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.15",
            "verseOrgIds": [
              "ISA.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu Ruhanga nagamba ati, “Omuli Sioni ninyombekamu omusingi gw'amani ogugumire. Nagutamu eibare ly'epembe ely'enyondobare elihandikirweho ebigambo biti, ‘Ayesiga tagira rwekanasho.’ ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.16",
            "verseOrgIds": [
              "ISA.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazima nigwo muguha gwange gw'okugupimisa, kandi obwesigwa niyo kabiro yange.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.17",
            "verseOrgIds": [
              "ISA.28.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enjura y'orubare erahyeya ebishuba byona ebyo mwemeleireho, kandi omutunga gw'amaizi tigubagize bwikarage. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.17",
            "verseOrgIds": [
              "ISA.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu orufu orwo mutakitina murabanza kurutina, kuhulira okwo mwaija kufa mugwe omu rujugumbo. K'ekibundo kiratera muratina kubi, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.18",
            "verseOrgIds": [
              "ISA.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kiraikara nikibatera, buli kiro, kibaimukiremu. Kiro na mushana tikilibaburaho. Buli kigambo ekyo Ruhanga arata kubaragiraho kirata kubatinisa! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.19",
            "verseOrgIds": [
              "ISA.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murashusha owo bachwireho omugani, ayabyamire aha kitanda kigufi akarara ayefunyire, akeshweka orubamtuli rw'akalingiti. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.20",
            "verseOrgIds": [
              "ISA.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endashana y'Omukama neija kushusha eyo yarashaniire aha Ibanga lya Perazimu, n'omu Ruhanga rwa Gibeoni, ayenzire kukora ekyo araliire, atangaze ensi. Omulimogwe ogw'ekyebisho naija kugugobesheleza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.21",
            "verseOrgIds": [
              "ISA.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndeke kubatatira mukasheka! Mbatatire musheke, kyonkai murafa. Omukama Ruhanga w'amahe inye muhuliire, naralira kusilikya ensi yona.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.22",
            "verseOrgIds": [
              "ISA.28.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.22",
            "verseOrgIds": [
              "ISA.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muhulilize ebyo ndikugamba; mubihulilize. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.23",
            "verseOrgIds": [
              "ISA.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taliho mulimi aikara nalima ndimiroze kugir'oti orwo yalima naija kubiba. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.24",
            "verseOrgIds": [
              "ISA.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "K'amara kwanjara abibamu enkore n'enkuku, abibamu n'engano omu njuru, n'eshayiri agibiba hayo agoba omu mbibi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.25",
            "verseOrgIds": [
              "ISA.28.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emikolere y'omulimogwe nagimanya kuba akagyegesibwa Ruhanga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.26",
            "verseOrgIds": [
              "ISA.28.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
