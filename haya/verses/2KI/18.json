              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.35",
            "verseOrgIds": [
              "2KI.18.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 18:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai abantu bakaba bachechekire, tibamuhoroire kigambo, kuba Omukama Hezekia akaba abaragiire kutamuhorora. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.36",
            "verseOrgIds": [
              "2KI.18.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 18:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Eliakimu eya Hilikia omusigire w'eka y'omukama, na Shebuna omuhandiki, na Yoa eya Asafu ay'ahandikaga amakuru g'amakiro, bagya owa Hezekia bajwete emyendo etagwire, bamubarulira ebyo Rabushake yagamba.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.37",
