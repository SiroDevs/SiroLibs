          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emyaka eyo Yehu yamazire aha ngoma natwara Isiraeli ayemire Samaria eli 28.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.36",
            "verseOrgIds": [
              "2KI.10.36"
            ]
