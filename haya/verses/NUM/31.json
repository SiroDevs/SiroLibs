          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa akwata omushoro ogwo, nikyo kihongo ky'Omukama, aguha Eleazari omukuhani, nk'okwo Omukama yamuhangiire.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.41",
            "verseOrgIds": [
              "NUM.31.41"
            ]
          }
        }
