            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi abaisiki bona ababaire batakabyamaga na bashaija bakaba bali 32,000. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.35",
            "verseOrgIds": [
