          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "endogobe zikaba zili enkumi 30,500; bazihyaho omushoro gw'Omukama, endogobe 61. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.39",
