              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endore zikaba zili 16,000; bazihyaho omushoro gw'Omukama endore 32. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.40",
            "verseOrgIds": [
              "NUM.31.40"
            ]
