              "type": "text"
            }
          ]
        },
        {
          "text": "Eminyago eyasigaire ahali byona ebyo abaisherukale banyagire: Entaama 675,000; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.32",
