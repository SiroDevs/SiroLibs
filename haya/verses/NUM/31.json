          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "ente 36,000; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.44",
            "verseOrgIds": [
              "NUM.31.44"
            ]
          }
        },
        {
