          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enusu eyo bahaire abaisherukale ababaire batabaire, zikaba zili ntaama 337,500, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.36",
