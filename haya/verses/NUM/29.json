              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muteho ekihongo ky'ensano n'eky'okunywa ebigenda aha numi, aha mpaya y'entaama n'aha bwana bw'entaama nk'okwo orubara rwabyo ruli n'okwo emigenzo yabyo elikuragira. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.37",
            "verseOrgIds": [
              "NUM.29.37"
            ]
          }
