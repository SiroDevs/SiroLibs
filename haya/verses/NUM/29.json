          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubiteho ebihongo byabyo eby'ensano n'eby'okunywa ebikagenda aha numi, aha mpaya z'entaama n'aha myana y'entaama nk'okwo orubara rwabyo ruli n'okwo emigenzo yabyo elikuragira. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.24",
