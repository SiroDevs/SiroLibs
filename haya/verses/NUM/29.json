              "NUM.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aha kiro kya kabili mutambe enumi z'ebigeto 12; empaya z'entaama ibili; obupaya 14 obw'emyana y'entaama obw'omwaka gumoi: Byona ebi bibe bitaina kamogo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.17",
            "verseOrgIds": [
              "NUM.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwongereho ekihongo ky'ensano n'ebihongo by'okunywa ebikagenda aha numi, aha mpaya z'entaama n'aha bwana bw'entaama nk'okwo orubara rwabyo ruli, n'okwo emigenzo yabyo elikuragira. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.18",
            "verseOrgIds": [
              "NUM.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutabuzaho mpaya ya mbuzi ey'ekitambo ky'enyatano y'amafu. Ahonu ekitambo kya buli kiro eky'okwokibwa n'ekihongo kyakyo ky'ensano, n'ebihongo byabyo eby'okunywa” ebyo bitabulimu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.19",
            "verseOrgIds": [
              "NUM.29.19"
            ]
          }
        }
      ]
    },
    {
