              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.10",
            "verseOrgIds": [
              "NUM.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama agambira Musa ati, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.11",
            "verseOrgIds": [
              "NUM.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omu Baisiraeli narondamu Abalevita aha mwanya gw'emizigaijo yona omuli Isiraeli. Abalevita barabaga bange, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.12",
            "verseOrgIds": [
              "NUM.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahakuba emizigaijo yona eba yange. Kiro ekyo naisire emizigaijo yona omuli Misiri, nkaronka emizigaijo yona omuli Isiraeli yaba yange, omuntu n'ekitunganwa. Abo baliba bange. Omukama n'inye.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.13",
            "verseOrgIds": [
              "NUM.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.13",
            "verseOrgIds": [
              "NUM.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama agambira Musa omw'Irungu lya Sinai ati, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.14",
            "verseOrgIds": [
              "NUM.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bara ab'oruganda rwa Levi kuhonderana n'amahiga gabo n'ebika byabo. Aketwa mushaija wena omubare, kubandiza aha w'omwezi gumoi kutemba.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.15",
            "verseOrgIds": [
              "NUM.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kityo Musa ababara nk'okwo Omukama yagambiire, nk'okwo yahangiirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.16",
            "verseOrgIds": [
              "NUM.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga nigo mabara ga batabani ba Levi: Gerishoni, Kohati na Merari. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.17",
            "verseOrgIds": [
              "NUM.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baijukuru ba Gerishoni kuhonderana n'amahiga gabo, amabara gabo nig'aga: Libuni na Shimei. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.18",
            "verseOrgIds": [
              "NUM.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baijukuru ba Kohati kuhonderana n'amahiga gabo ni Amuramu, Izihari, Heburoni na Uzieli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.19",
            "verseOrgIds": [
              "NUM.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baijukuru ba Merari kuhonderana n'amahiga gabo ni Mahali na Mushi. Aga nigo mahiga g'Abalevita, nibyo bika byabo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.20",
            "verseOrgIds": [
              "NUM.3.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.20",
            "verseOrgIds": [
              "NUM.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gerishoni niwe alikutabukwaho enganda ibili: Abalibani n'Abashimei. Ezi nganda ezatabukaga omu Bagerishoni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.21",
            "verseOrgIds": [
              "NUM.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orubara rwabo bona abaketwa bashaija, kwema aha w'omwezi gumoi kutemba, nibagoba 7,500. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.22",
            "verseOrgIds": [
              "NUM.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaka g'Abagerishoni gasisiraga enyuma y'Eihema obugwaizoba. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.23",
            "verseOrgIds": [
              "NUM.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukuru w'eihiga elyo ly'Abagerishoni yabaga Elisafu eya Laeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.24",
            "verseOrgIds": [
              "NUM.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwoga gw'Abagerishoni omw'Ihema ly'Omuterano, gwabaga kumanya ekiikaro, Eihema lyonene n'eby'okulishwekesa, n'orutimbe rw'omulyango gwalyo, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.25",
            "verseOrgIds": [
              "NUM.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "entimbe za nyakabuga, ekisika ky'omulyango gwa nyakabuga eyazingoraga ekiikaro na alutare hamoi n'emiguha yayo: Eikora lyona elyabaire likwete ahali ebi byona.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.26",
            "verseOrgIds": [
              "NUM.3.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.26",
            "verseOrgIds": [
              "NUM.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kohati niwe alikutabukwaho Abamuramu, Abaizirahi, Abaheburoni n'Abauzieli. Ezi nganda ezatabukaga omu Bakohati. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.27",
            "verseOrgIds": [
              "NUM.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orubara rwabo bona abaketwa bashaija, kwema aha w'omwezi gumoi kutemba, bakaba nibagoba 8,600. Omwoga gwabo bakoraga emilimo y'ahatakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.28",
            "verseOrgIds": [
              "NUM.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaka g'Abakohati gasisiraga rubaju orwa kasi orw'ekiikaro. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.29",
            "verseOrgIds": [
              "NUM.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukuru w'oruganda rw'Abakohati yabaga Elisafani eya Uzieli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.30",
            "verseOrgIds": [
              "NUM.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwoga gwabo balebeleraga Esanduku ly'Endagano, emeza, ekinara ky'etara, alutare zona, ebikwato by'ahatakatifu ebyo abakuhani bakoza hamoi n'ekisika: Eikora lyona elyabaire likwete ahali ebi byona. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.31",
            "verseOrgIds": [
              "NUM.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eleazari eya Aroni omukuhani niwe yakuliraga abebembezi b'Abalevita, n'okulebelera abakozi b'ahatakatifu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.32",
            "verseOrgIds": [
              "NUM.3.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.32",
            "verseOrgIds": [
              "NUM.3.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 3:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Merari natabukwaho Abamahali n'Abamushi: Ezi nganda ezatabukire ahali Merari. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.33",
            "verseOrgIds": [
              "NUM.3.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 3:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orubara rwabo bona abaketwa bashaija, kubandiza aha w'omwezi gumoi kutemba, bakaba bali 6,200. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.34",
            "verseOrgIds": [
              "NUM.3.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 3:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukuru w'oruganda rw'Abamerari yabaga Zurieli eya Abihaili. Rubaju orwa bikara orw'ekiikaro nirwo rwabaga busisiro bwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.35",
            "verseOrgIds": [
              "NUM.3.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 3:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamerari abo bakaba bakwasiibwe efuremu z'ekiikaro, emihingo, enyomyo n'amaguru gazo, na buli kamoi akakwete aho: Eikora lyona elyabaire niligendanwa n'ebi byona. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.36",
            "verseOrgIds": [
              "NUM.3.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 3:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakwo enyomyo eza nyakabuga obuzingora n'amaguru gazo, n'enkondo n'emiguha. Byona ebi byalebelerwaga Abamerari.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.37",
            "verseOrgIds": [
              "NUM.3.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 3:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.37",
            "verseOrgIds": [
              "NUM.3.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 3:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa na Aroni n'abatabani nibo basisiraga omu maisho g'ekiikaro, omu maisho g'Eihema ly'Omuterano, bolekeire oburugaizoba. Emichonchozo eyakorwaga ahatakatifu aha rw'Abaisiraeli, yamanywaga bonene abo. Omuntu ondijo wena wena kayakugobire ahatakatifu bamwitaga. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.38",
            "verseOrgIds": [
              "NUM.3.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 3:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalevita bona abo Musa na Aroni babazire bahangiirwe Omukama, nk'okwo amahiga gabo gabaire gali, abaketwa bashaija bona kwema aha mwezi gumoi kutemba, bakaba nibagoba 22,000.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.39",
            "verseOrgIds": [
              "NUM.3.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 3:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.39",
            "verseOrgIds": [
              "NUM.3.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 3:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama akagambira Musa ati, “Abaisiraeli bona abashaija emizigaijo, kubandiza aha mwezi gumoi kugendelera, obabare nobahandika amabara. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.40",
            "verseOrgIds": [
              "NUM.3.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 3:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onyahulire Abalevita bona, inye Omukama, bakwate omwanya gw'Abaisiraeli bona emizigaijo. Onyahulire n'ebitunganwa by'Abalevita abo bilye omwanya gw'ebitunganwa emizigaijo byona by'Abaisiraeli.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.41",
            "verseOrgIds": [
              "NUM.3.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 3:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kityo Musa abara Abaisiraeli bona emizigaijo, nk'okwo Omukama yamuhangiire. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.42",
            "verseOrgIds": [
              "NUM.3.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NUM 3:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaketwa bashaija bona emizigaijo okwo babazirwe nibahandikwa amabara, kuruga aha b'omwezi gumoi kutemba, bakagoba orubara rw'abantu 22,273.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.43",
            "verseOrgIds": [
              "NUM.3.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NUM 3:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.43",
            "verseOrgIds": [
              "NUM.3.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "NUM 3:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Omukama agambira Musa ati, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.44",
            "verseOrgIds": [
              "NUM.3.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NUM 3:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abalevita obateke aha mwanya gw'Abaisiraeli bona emizigaijo. N'ebitunganwa by'Abalevita bilye omwanya gw'Ebitunganwa by'Abaisiraeli emizigaijo. Abalevita barabaga bange: Omukama n'inye. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.45",
            "verseOrgIds": [
              "NUM.3.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NUM 3:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo Abaisiraeli emizigaijo balikukiraho Abalevita abantu 273, abalikushagaho abo obachungure. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.46",
            "verseOrgIds": [
              "NUM.3.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NUM 3:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli muchungurwa omushashulire ebichweka bitanu by'eshekeli kuhonderana n'eiguzi ly'eshekeli y'ahatakatifu ey'egera 20. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.47",
            "verseOrgIds": [
              "NUM.3.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "NUM 3:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Empiya ezo ez'orachunguza Abaisiraeli emizigaijo abalikushaga ozikwate ozihe Aroni n'abatabani.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.48",
            "verseOrgIds": [
              "NUM.3.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "NUM 3:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balinya abashagire aha kuchungurwa Abalevita bakechunguza empiya, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.49",
            "verseOrgIds": [
              "NUM.3.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "NUM 3:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "bazikwata baziha Musa, nizo shekeli 1,365 eziganiraine n'eshekeli y'ahatakatifu omw'iguzi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.50",
            "verseOrgIds": [
              "NUM.3.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "NUM 3:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Empiya ezo ezo bayechungwize, Musa akaziha Aroni n'abatabani, nk'okwo Omukama yamuhangiire.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.51",
            "verseOrgIds": [
              "NUM.3.51"
            ]
          }
        }
      ]
    }
