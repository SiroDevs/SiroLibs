          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba nibo bana ba Aroni na Musa omu makiro ago Omukama yafumoire na Musa aha Ibanga lya Sinai. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.1",
            "verseOrgIds": [
              "NUM.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga mabara ga batabani ba Aroni: Nadabu omuzigaijo, Abihu, Eleazari na Itamari; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.2",
            "verseOrgIds": [
              "NUM.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibo bakuhani abakozirwe amajuta, abo Aroni wenene yatendekire kukora omwoga gw'obukuhani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.3",
            "verseOrgIds": [
              "NUM.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai Nadabu na Abihu bakafa, bagwa omu mabona g'Omukama omw'Irungu lya Sinai orwo babaire nibamutambira ekihongo ky'okwokibwa ekihagaire. Mara bakaba bataina bana. Kityo Aroni ishebo akyarora, abakozire omwoga gw'obukuhani ni Eleazari na Itamari.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.4",
            "verseOrgIds": [
              "NUM.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.4",
            "verseOrgIds": [
              "NUM.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama agambira Musa ati, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.5",
            "verseOrgIds": [
              "NUM.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Leta ab'oruganda rwa Levi, obate omu maisho ga Aroni omukuhani, babe nibamukolera. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.6",
            "verseOrgIds": [
              "NUM.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamukolere emilimo eyo yakukozire, kandi bakore n'ey'enteko yona omu maisho g'Eihema ly'Omuterano. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.7",
            "verseOrgIds": [
              "NUM.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamanye ebintu byona ebikwete aha Ihema ly'Omuterano, kandi orwo balikukora emilimo aha Ihema elyo, bakolere n'Abaisiraeli bona. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.8",
            "verseOrgIds": [
              "NUM.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakuhani obakwase Aroni n'abaijukuru. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.9",
            "verseOrgIds": [
              "NUM.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni n'abaijukuru obakwase emyoga y'obukuhani bagikore. Kyonkai k'omuntu ondijo wena wena alibetahyamu, ogwo aitwe.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.10",
            "verseOrgIds": [
              "NUM.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 3:10"
          },
          "items": [
            {
