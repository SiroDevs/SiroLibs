          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egi niyo migendere y'Abaisiraeli orwo barugire Misiri kuhonderana n'enganda zabo omu mahe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.1",
            "verseOrgIds": [
              "NUM.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa akahandika emiimukize yabo, kuruga aha na hali nk'okwo Omukama yabaire amuhangiire. Mbwenu egi niyo migendere yabo okwo bagenzire: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.2",
            "verseOrgIds": [
              "NUM.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakaruga Ramesesi kili kiro kya ikumi na bitanu ky'omwezi gwa mbere. Baraire baliire Pasika, nirwo Abaisiraeli basigireho Abamisiri nibeshanda, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.3",
            "verseOrgIds": [
              "NUM.33.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "aho Abamisiri nibaziika emizigaijo yabo eyo Omukama yaisire, akolekya okwo aina obushobora kukira baruhanga babo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.4",
            "verseOrgIds": [
              "NUM.33.4"
            ]
          }
        }
      ]
    },
    {
