          "text": "Aha kiro kya mbere ky'omwezi gwa katanu, Aroni omukuhani atemba Eibanga lya Hori okwo Omukama yamuhangiire, aba niyo agwa, omu mwaka gwa 40 kwema Abaisiraeli barugire Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.38",
            "verseOrgIds": [
              "NUM.33.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 33:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaba aina emyaka 123, nirwo yafire akagwa aha Ibanga lya Hori. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.39",
            "verseOrgIds": [
              "NUM.33.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 33:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omunyakanaani omukama wa Aradi ayaturaga Negebu omuli Kanaani, agya ahulira okwo Abaisiraeli balikwija.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.40",
            "verseOrgIds": [
              "NUM.33.40"
            ]
          }
        }
      ]
    },
