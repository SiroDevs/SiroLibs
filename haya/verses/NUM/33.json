          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 33:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baruga Salumona basisira Punoni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.42",
            "verseOrgIds": [
              "NUM.33.42"
            ]
          }
        },
        {
