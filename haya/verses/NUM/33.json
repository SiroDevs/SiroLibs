          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baruga aha Ibanga lya Hori basisira Salumona. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.41",
            "verseOrgIds": [
              "NUM.33.41"
            ]
          }
        },
        {
          "name": "verse",
