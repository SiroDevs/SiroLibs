              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tera akwata Aburamu omutabani, n'omwijukuru Loti mutabani wa Harani, n'omuka Sarai omukamwana Aburamu, baruga Uri ey'Abakalidayo kugya Kanaani. Kyonkai kabagobire Harani baba nimwo batura. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.31",
            "verseOrgIds": [
              "GEN.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
