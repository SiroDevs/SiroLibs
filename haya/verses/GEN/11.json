            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kayamazire kuzara Tera, arora emyaka endijo kikumi mwo ikumi na mwendai. Mara omwo azara abojo abandi n'abaisiki.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.25",
