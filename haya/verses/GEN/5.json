          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumara kuzara Enoshi akarora emyaka endijo runana na mushanju. Akazara abojo abandi n'abaisiki. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.7",
            "verseOrgIds": [
