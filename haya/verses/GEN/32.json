{
  "id": "GEN.32",
  "number": "32",
  "bookId": "GEN",
  "reference": "Embandizo 32",
  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "32",
        "style": "c",
        "sid": "GEN 32"
      },
      "items": [
        {
          "text": "32",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo orwo alikugendelera n'orugendorwe agya abuganganwa abamalaika ba Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.1",
            "verseOrgIds": [
              "GEN.32.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo yababoine agamba ati, “Eli ihe lya Ruhanga.” Aha rw'ekyo omwanya ogwo agweta Mahanaimu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.2",
            "verseOrgIds": [
              "GEN.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.2",
            "verseOrgIds": [
              "GEN.32.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo asindika entumwa zimwebembera kugya ahali Esau omurumuna omu nsi ya Seiri niyo Edomu, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.3",
            "verseOrgIds": [
              "GEN.32.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabaragira ati, “Esau mukama wange mumugambire muti, ‘Omwiru wawe Yakobo nagamba ati: Nkafurukira owa Labani naikarayo kuhika mwaha; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.4",
            "verseOrgIds": [
              "GEN.32.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyina ente, endogobe, amahyo g'entaama, abairu n'abazana. Mbwenu nakutumaho mukama wange, onsingire.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.5",
            "verseOrgIds": [
              "GEN.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.5",
            "verseOrgIds": [
              "GEN.32.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entumwa zigaruka ahali Yakobo nizigamba ziti, “Owa murumuna wawe Esau tugobireyo, aliho naija n'abashaija bikumi binai kukuchwekera.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.6",
            "verseOrgIds": [
              "GEN.32.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Yakobo atina muno, ashoberwa. Abeganisa abantu abo yabaire ainabo, amahyo g'entaama n'ag'ente omu bibina bichweka; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.7",
            "verseOrgIds": [
              "GEN.32.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "akaba atekeleize ati, “Ka Esau aragoba ekichweka kimoi akakisilikya, ekirasigaraho ekyo kirahunga.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.8",
            "verseOrgIds": [
              "GEN.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.8",
            "verseOrgIds": [
              "GEN.32.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashuba agamba ati, “Waitu Ruhanga wa tata Aburahamu, Ruhanga wa tata Isaka, waitu Mukama ayangambiire ati, ‘Oshube owanyu omu banyaruganda bawe ndikukolerage,’ ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.9",
            "verseOrgIds": [
              "GEN.32.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "tinsaniire kisha kyawe na bwesigwa bwona butyo ebyo ongilire inye omwiru wawe. Nkashabuka Yorudani n'enkoni yange yonkai, kyonkai mbwenu nyina ebichweka bibili ebi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.10",
            "verseOrgIds": [
              "GEN.32.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninshaba bandokore omu mikono ya murumuna wange Esau, enshonga nimutina atakwija akatwita ichwena, baana na banyinabo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.11",
            "verseOrgIds": [
              "GEN.32.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai iwe ogambire oti, ‘Ndikukolerage mara nkuhe abaijukuru bangi nk'omushenye gw'enyanja ogutakubarwa aha rw'obungi bwagwo.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.12",
            "verseOrgIds": [
              "GEN.32.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.12",
            "verseOrgIds": [
              "GEN.32.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kir'ekyo arara aho, Omu byo yabaire ainabyo aihiramu Esau omurumuna eby'okumugemulira: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.13",
            "verseOrgIds": [
              "GEN.32.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emburabuzi bikumi bibili n'empaya makumi gabili; emiagazi y'entaama bikumi bibili n'empaya makumi gabili, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.14",
            "verseOrgIds": [
              "GEN.32.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "engamia zilikwonkya makumi gashatu n'enyana zazo, ente enshumba makumi ganai n'enumi ikumi, endogobe matako makumi gabili n'enumi ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.15",
            "verseOrgIds": [
              "GEN.32.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezo azikwasa abairube buli buhyo habwo, ashuba abagambira ati, “Munyebembere, mara omugati y'amahyo gombili, musigemu omwanya.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.16",
            "verseOrgIds": [
              "GEN.32.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 32:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aragira ayebembeire ati, “Ka Esau murumuna wange arakutanganwa akakubaza ati, ‘Oli w'ohai? Nogya nkahai? Isi ebitunganwa ebi eby'oyebembeize by'ohai?’ ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.17",
            "verseOrgIds": [
              "GEN.32.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 32:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho ogambe oti, ‘By'omwiru wawe Yakobo, yabigemulira mukama wange Esau, na wenene atuli enyuma.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.18",
            "verseOrgIds": [
              "GEN.32.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 32:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aragira atyo n'owa kabili, n'owa kashatu, na bona ababaire bahondeire amahyo ago, ati, “Orwo muratanganwa Esau mumugambire ebigambo byonene byonene ebyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.19",
            "verseOrgIds": [
              "GEN.32.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 32:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mara mumugambire muti, ‘Omwiru wawe Yakobo atuli enyuma.’ ” Okugira atyo akaba natekeleza ati, “Nakumugwisiliza n'ebigemuro ebyebembeire, aho rundi mugoba angarulira.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.20",
            "verseOrgIds": [
              "GEN.32.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebigemuro bimwebembera, kir'ekyo wenene arara omu rusisira.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.21",
            "verseOrgIds": [
              "GEN.32.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.21",
            "verseOrgIds": [
              "GEN.32.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 32:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu kiro kyonene ekyo, aimuka akwata bakazibe bombili n'abazanabe bombili n'abaanabe eikumi n'omoi, ashabuka ekyambu kya Yaboki. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.22",
            "verseOrgIds": [
              "GEN.32.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 32:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abashabura omwiga, kwakwo na buli kimoi ekyo yabaire ainakyo, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.23",
            "verseOrgIds": [
              "GEN.32.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 32:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "kyonkai wenene asigara wenkai enyuma. Aho aijwa omushaija afukana nawe kuhika obwire kukya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.24",
            "verseOrgIds": [
              "GEN.32.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omushaija ogwo kayaboine okwo atasinga Yakobo, amukwata omw'ihuru ly'ekibero. Orwo Yakobo alikufukana nawe, Yakobo wenene amyoka ekibero. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.25",
            "verseOrgIds": [
              "GEN.32.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 32:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omushaija amugambira ati, “Ondeke ngende aha rw'okuba obwire bwakya.” Kyonkai Yakobo amugambira ati, “Tindikukuleka k'ogenda otampaire mugisha.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.26",
            "verseOrgIds": [
              "GEN.32.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashuba amubaza ati, “Eibara lyawe oli ohai?” Ndi ogu ati, “Ndi Yakobo.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.27",
            "verseOrgIds": [
              "GEN.32.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho omushaija ogwo ati, “Eibara lyawe tokyetwa Yakobo rundi; orayetwaga Isiraeli, wafukana na Ruhanga n'abantu wabasinga.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.28",
            "verseOrgIds": [
              "GEN.32.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo amugambira ati, “Ninkushaba ongambire eibara lyawe.” Kyonkai wenene amubaza ati, “Kubaki nombaza eibara lyange?” Honene aho ashuba amuheraho omugisha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.29",
            "verseOrgIds": [
              "GEN.32.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikwo Yakobo kuheta Penieli nagamba ati, “Aha rw'okuba mboine Ruhanga bubona kyonkai narora.”",
          "type": "text",
