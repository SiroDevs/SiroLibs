          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashuba atwara enda azara omwana w'obwojo, nagamba ati, “Mbwenu eli ibanye arabera kimoi wange enshonga namuzalira abojo bashatu.” Nikwo kumweta eibara Levi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.34",
            "verseOrgIds": [
              "GEN.29.34"
            ]
          }
        },
        {
