          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lea atwara enda azara omwana w'obwojo, amuruka eibara Rubeni, nagamba ati, “Aha rw'okuba Omukama yabona obushasi bwange, rwona mbwenu ibanye arangonza.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.32",
            "verseOrgIds": [
              "GEN.29.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
