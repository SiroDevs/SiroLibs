          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashuba atwara enda azara omwana w'obwojo, nagamba ati, “Aha rw'okuba Omukama ahulire okwo ndikunobwa, yantunga omwana w'obwojo ogu.” Amuruka eibara Simeoni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.33",
            "verseOrgIds": [
              "GEN.29.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
