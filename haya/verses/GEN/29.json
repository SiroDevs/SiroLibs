              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama kayaboine okwo Lea yanobwa, amuha oruzaro, kandi Raheli oruzaro rubura. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.31",
            "verseOrgIds": [
              "GEN.29.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
