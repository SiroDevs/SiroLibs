          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu ashwera omukazi ondijo eibaralye Ketura. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.1",
            "verseOrgIds": [
              "GEN.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amuzaraho Zimurani, Yokishani, Medani, Midiani, Ishibaki na Shua. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.2",
            "verseOrgIds": [
              "GEN.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yokishani azara Sheba na Dedani. Baijukuru ba Dedani nibo Abashuri, Abaletushi n'Abaleumi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.3",
            "verseOrgIds": [
              "GEN.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Midiani ni Efa, Eferi, Hanoki, Abidana Elidaa. Aba bona baijukuru ba Ketura.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.4",
            "verseOrgIds": [
              "GEN.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.4",
            "verseOrgIds": [
              "GEN.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu akaha Isaka ebye byona. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.5",
            "verseOrgIds": [
              "GEN.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai abaana b'ensholekeze, Aburahamu akabaha obuntu buke buke, yashuba yababinga akyarora. Yabataishurana n'omutabani Isaka, bagenda bolekeire oburugaizoba omu nsi ya Kedemu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.6",
            "verseOrgIds": [
              "GEN.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.6",
            "verseOrgIds": [
              "GEN.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu akarora emyaka kikumi mwo nshanju n'etanu, ebyo nibyo birobye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.7",
            "verseOrgIds": [
              "GEN.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afa, agwa omu bugurusi obugundu, omugurusi w'emyaka nyingi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.8",
            "verseOrgIds": [
              "GEN.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abatabani Isaka na Ishimaeli bamuziika omu mpako ya Makapela omu nsi ya Efuroni mutabani wa Zohari Omuhiti, omu bwolekera bwa Mamure. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.9",
            "verseOrgIds": [
              "GEN.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyo nsi eyo Aburahamu yaguzire aha Bahiti, aba nimwo aziikwa na mukaziwe Sara. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.10",
            "verseOrgIds": [
              "GEN.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kayabaire yafire, Ruhanga atunga omutabani Isaka omugisha. Isaka atura Berilahairoi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.11",
            "verseOrgIds": [
              "GEN.25.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.11",
            "verseOrgIds": [
              "GEN.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba nibo baana ba Ishimaeli eya Aburahamu owo yazaire ahali Hagari Omumisirikazi, Hagari omuzana wa Sara. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.12",
            "verseOrgIds": [
              "GEN.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amabara gabo nk'okwo balikukuratana nig'aga: Nebayoti omuzigaijogwe, Kedari, Andeeli, Mibusamu; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.13",
            "verseOrgIds": [
              "GEN.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mishima, Deuma, Masa; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.14",
            "verseOrgIds": [
              "GEN.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadadi, Tema, Yeturi, Nafishi na Kedema. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.15",
            "verseOrgIds": [
              "GEN.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibo batabani ba Ishimaeli n'amabara gabo, baish'enkuru enganda ikumi na ibili. Ebyaro byabo n'ensisira zabo byayetwaga amabara gabo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.16",
            "verseOrgIds": [
              "GEN.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oburora bwa Ishimaeli myaka kikumi mwo makumi gashatu na mushanju. Aho afa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.17",
            "verseOrgIds": [
              "GEN.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baijukurube baturaga omugati ya Havila na Shuri; ensi egyo elebangaine na Misiri omu bwolekera bwa Asiria. Kandi wenene yaturaga ayeshumbire abarumuna bona.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.18",
            "verseOrgIds": [
              "GEN.25.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.18",
            "verseOrgIds": [
              "GEN.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba nibo baijukuru ba Isaka mutabani wa Aburahamu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.19",
            "verseOrgIds": [
              "GEN.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka kugya kushwera Rebeka muhara wa Betueli Omuaramea wa Padaniaramu, Rebeka munyanya Labani, akaba aina emyaka makumi ganai. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.20",
            "verseOrgIds": [
              "GEN.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukazi kayabuzirwe oruzaro yamushabira aha Mukama. Omukama yahulira ensharaye, mukaziwe Rebeka atwara enda. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.21",
            "verseOrgIds": [
              "GEN.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashangwa aina enda z'abarongo, bamurwanira omu nda. Aho ayebaza ati, “Kabili biti, nindora kugira ntai?” Kityo agya kubaza aha Mukama. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.22",
            "verseOrgIds": [
              "GEN.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama amugambira ati,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.23",
            "verseOrgIds": [
              "GEN.25.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.23",
            "verseOrgIds": [
              "GEN.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo akanya k'okuzara kahikire, nirwo yamanyire okwo yabaire aina enda z'abarongo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.24",
            "verseOrgIds": [
              "GEN.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owa mbere aturuka natukura, omubili gwona nigushusha ekijwaro ky'omushenshe; bamuruka eibara Esau. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.25",
            "verseOrgIds": [
              "GEN.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahanyuma omurumuna aturuka akwete Esau ekisinziro. Nikwo kurukwa eibara Yakobo. Isaka akaba aina emyaka nkaga orwo mukaziwe yabazara.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.26",
            "verseOrgIds": [
              "GEN.25.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.26",
            "verseOrgIds": [
              "GEN.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana kabakuzire Esau yaba muhigi omubuya, muntu w'eirungu; kandi Yakobo yabaga muchulezi, yaikaraga omu mahema. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.27",
            "verseOrgIds": [
              "GEN.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka yagonzaga muno Esau, okuba yashemelerwaga enyamaze z'omuhigo, kandi Rebeka yagonzaga muno Yakobo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.28",
            "verseOrgIds": [
              "GEN.25.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.28",
            "verseOrgIds": [
              "GEN.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiro kimoi orwo Yakobo yabaire nachumba oruhilili rw'amashaza, Esau aruga omw'irungu enjara emuli kubi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.29",
            "verseOrgIds": [
              "GEN.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 25:30"
          },
          "items": [
            {
              "text": "30",
