              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau amuhorora ati, “Leba, inye ndi haihi kufa, obuzigaijo nibwija kungashaki?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.32",
