              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo amugambira ati, “Obanze onnahilire.” Aho Esau amunahilira, ashuba amuguza obuzigaijobwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.33",
