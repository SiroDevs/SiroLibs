              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo amushubamu ati, “Obanze onguze obuzigaijo bwawe.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.31",
            "verseOrgIds": [
