        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Orwo omuntu wena wena araletaga ekihongo ky'emyaka kukihongera Omukama, ekihongokye kibe ky'ensano enungi. Akifukeho amajuta, akitekeho n'obunuma, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.1",
            "verseOrgIds": [
              "LEV.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "amare akiletere batabani ba Aroni abakuhani. Akihyeho ekikamato ky'ensano enungi n'amajuta n'obunuma bwakyo bwona. Ekyo nikyo omukuhani arayokeza ahali alutare kumanyisa okwo kyona bakihongera Omukama. Ekihongo kyokesibwe omuliro. Akatachu kakyo kanshemelera inye Omukama. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.2",
            "verseOrgIds": [
              "LEV.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ekihongo ky'emyaka ekirasigara kibe kya Aroni n'abatabani; ekyo kichweka kitakatifu muno ky'ebihongo by'Omukama ekyokesiibwe omuliro.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.3",
            "verseOrgIds": [
              "LEV.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.3",
            "verseOrgIds": [
              "LEV.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Orwo oraletaga ekihongo ky'emyaka kyokibwe omu kyoto kichumbirwe nk'omukate anga ekeki. Ebe migate etatumbisiibwe ey'ensano enungi etabirainwe n'amajuta anga otukate otutatumbisiibwe, shana gasiigirwe amajuta kushai. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.4",
            "verseOrgIds": [
              "LEV.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi k'ekihongo kyawe kirabaga kili kihongo ky'emyaka kikarangirwe aha kikarango kibega ky'ensano enungi etatumbisiibwe etabirainwe n'amajuta. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.5",
            "verseOrgIds": [
              "LEV.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okibegabegure okihyemu ebichweka, okishesheho amajuta, kuba kihongo ky'emyaka. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.6",
            "verseOrgIds": [
              "LEV.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi k'ekihongo kyawe kirabaga kili ky'emyaka kichumbirwe omu nyungu kibe ky'ensano enungi etabirainwe n'amajuta. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.7",
            "verseOrgIds": [
              "LEV.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oleterega Omukama ekihongo ky'emyaka ekikozibwe ebintu ebyo. Okiletere omukuhani, niwe arakitwaraga alutare. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.8",
            "verseOrgIds": [
              "LEV.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukuhani aihyega aha kihongo ky'emyaka omugabo gw'okwijukiraho ekihongo, agw'okwokeze ahali alutare. Ekihongo kyokesibwe omuliro, akatachu kakyo kanshemelera inye Omukama. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.9",
            "verseOrgIds": [
              "LEV.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekihongo ky'emyaka ekilikusigaraho kibe kya Aroni n'abatabani. Ekyo kichweka kitakatifu muno ky'ekihongo ky'Omukama ekyokesiibwe omuliro.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.10",
            "verseOrgIds": [
              "LEV.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.10",
            "verseOrgIds": [
              "LEV.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Taliho kihongo kya myaka ekyo muliletera Omukama kitairwemu itumbyo. Otalihongera Mukama kihongo kya kwokibwa eky'eitumbyo anga kinamu bwoki. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.11",
            "verseOrgIds": [
              "LEV.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakuletera Omukama ebiraba bya mbere na mbere kili kihongo, kyonkai bitalihongwa ahali alutare kurugwamu katachu ak'okumushemelera. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.12",
            "verseOrgIds": [
              "LEV.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebihongo byawe byona eby'emyaka obitekemuga omwonyu. Otalibuza mwonyu mu kihongo kyawe kya myaka. Ebihongo byawe byona obihongerane n'omwonyu; kuba omwonyu ogwo kabonero k'endagano yawe na Ruhanga.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.13",
            "verseOrgIds": [
              "LEV.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.13",
            "verseOrgIds": [
              "LEV.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“K'orahongeraga Omukama ekihongo ky'emyaka eky'ebiraba bya mbere na mbere, ebikumba by'engano onyukilire ebitakomire, mara ebibabwirwe aha muliro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.14",
            "verseOrgIds": [
              "LEV.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekihongo ekyo okiteho amajuta, okigelekeho obunuma, orwo kili kihongo ky'emyaka. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.15",
            "verseOrgIds": [
              "LEV.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukuhani ayokye ekichweka ky'engano enyukilirwe, hamoi n'amajuta gakyo n'obunuma bwakyo bwona guli mugabo gw'okukijukiraho. Ekihongo ekyo ky'Omukama ekyokesiibwe omuliro.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.16",
            "verseOrgIds": [
              "LEV.2.16"
            ]
          }
        }
      ]
    }
  ],
