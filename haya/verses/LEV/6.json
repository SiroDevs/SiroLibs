          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.23",
            "verseOrgIds": [
              "LEV.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama agambira Musa ati, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.24",
            "verseOrgIds": [
              "LEV.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ogambire Aroni n'abatabani oti, Eli nilyo iteka ly'ekihongo ky'enyatano y'obufu. Omu mwanya mbali ekihongo ky'okwokibwa kitirwa ekihongo ky'enyatano kibe niho kitirwa omu maisho g'Omukama; kyonene kitakatifu muno. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.25",
            "verseOrgIds": [
              "LEV.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukuhani arakihongaga aha rw'obufu arakilyaga; kilirwega omu mwanya gutakatifu omuli nyakabuga k'Eihema ly'Omuterano. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.26",
            "verseOrgIds": [
              "LEV.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyona kyona ekirakakoraga aha nyama yakyo kirabaga kitakatifu. Kandi kahararugwaho obwamba bwakyo bukashaimukira ekijwaro, ekijwaro ekyo akyogeze omu mwanya gutakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.27",
            "verseOrgIds": [
              "LEV.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyungu eyo kyachumbirwamu eyatwe. Kyonkai kakirachumbirwaga omu nyungu y'omulinga egyo ekuutwe eshube eyogorozibwe omu maizi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.28",
            "verseOrgIds": [
              "LEV.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli mushaija omu bakuhani yakukilyaho. Kyonene kitakatifu muno. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.29",
            "verseOrgIds": [
              "LEV.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
