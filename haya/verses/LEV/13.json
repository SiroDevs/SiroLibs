            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.52",
            "verseOrgIds": [
              "LEV.13.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LEV 13:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "“K'omukuhani aralebaga endwara, akashanga endwara etayagaire omu kijwaro kifumirwe anga kishukirwe anga kibe kyona kyona eky'oruhu, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.53",
            "verseOrgIds": [
              "LEV.13.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LEV 13:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "aho aragiire bogye ekintu ekinamu endwara, mara akiteke omu rubili ebiro ebindi mushanju. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.54",
            "verseOrgIds": [
              "LEV.13.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LEV 13:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "K'ekintu ekinamu endwara kiraba kyayogiibwe, omukuhani akilebe. K'ekichweka ekinamu endwara kirashangwa kitahindukire rangi, n'orwo endwara eraba etayagaire, kihagare; akyokye omu muliro, n'orwo ekizigira kiraba kili omunda anga aheru.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.55",
            "verseOrgIds": [
              "LEV.13.55"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LEV 13:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.55",
            "verseOrgIds": [
              "LEV.13.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LEV 13:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kyonkai k'omukuhani araleba endwara, akabona nenywelererwa orwo yamara kwogibwa, aho omu ruhu anga omu kijwaro kifumirwe anga kishukirwe ataguremu ekichweka ekina endwara. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.56",
            "verseOrgIds": [
              "LEV.13.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "LEV 13:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho k'erashuba ekaboneka omu kijwaro, kifumirwe anga kishukirwe, anga omu kijwaro kyona kyona eky'oruhu endwara eraba neyagara. Ekijwaro ekyo ekinamu endwara akyokye omu muliro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.57",
            "verseOrgIds": [
              "LEV.13.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "LEV 13:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai ekijwaro, kifumirwe anga kishukirwe, anga ekijwaro kyona kyona ky'oruhu ekyarugwamu endwara wamazire kukyogya, aho kyogibwe omurundi gwa kabili, kyere.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.58",
            "verseOrgIds": [
              "LEV.13.58"
            ]
          }
        }
      ]
    },
    {
