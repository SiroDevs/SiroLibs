          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikwo Musa yagambiire atyo Abaisiraeli ebiro bikuru by'Omukama ebitairweho.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.44",
