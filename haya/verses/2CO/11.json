              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakuraba kuli kwebuga, kanyebuge ebikozirwe obujege bwange. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.30",
            "verseOrgIds": [
