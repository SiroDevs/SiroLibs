          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuli Damasiko gavana ayabaire atairweho Omukama Aretasi, akalinda ekigo ekyo agondize kunkwata. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.32",
            "verseOrgIds": [
              "2CO.11.32"
