              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai bakanteka omu kitukuru bansongolera omw'idirisha ly'orukuta namuruga ntyo omu mikono.",
          "type": "text",
          "attrs": {
