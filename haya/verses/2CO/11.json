          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga olinya Ishe Omukama Yesu namanya okwo ntalikubeiya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.31",
            "verseOrgIds": [
              "2CO.11.31"
            ]
          }
