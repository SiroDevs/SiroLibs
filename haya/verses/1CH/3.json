        "sid": "1CH 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba nibo batabani ba Daudi abo yazaliire Heburoni. Omuzigaijo ni Amunoni, namuzigaija ahali Ahinoamu, Omuyezireeli. Omushubiro ni Danieli, namuzara ahali Abigaili, Omukarimeeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.1",
            "verseOrgIds": [
              "1CH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owa kashatu ni Abusalomu, namuzara ahali Maaka muhara wa Talumai, omukama wa Geshuri. Owa kanai ni Adoniya, namuzara ahali Hagiti. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.2",
            "verseOrgIds": [
              "1CH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owa katanu ni Shefasia, akamuzara ahali Abitali. Owa mukaga ni Itireamu namuzara ahali Egila. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.3",
            "verseOrgIds": [
              "1CH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukaga akabazalira Heburoni, mbali yatwaliire engoma emyaka mushanju n'emyezi mukaga. Omuli Yerusalemu akatwaliramu emyaka 33. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.4",
            "verseOrgIds": [
              "1CH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo yazaliire Yerusalemu ni Shimea, Shobabu, Natani na Solomoni. Aba okwo bali banai nabazara ahali Batishua muhara wa Amieli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.5",
            "verseOrgIds": [
              "1CH.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akazara n'abandi mwendai, abalimu Ibuhari, Elishua, Elifeleti; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.6",
            "verseOrgIds": [
              "1CH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noga, Nefegi, Yafia, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.7",
            "verseOrgIds": [
              "1CH.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elishama, Eliada na Elifeleti. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.8",
            "verseOrgIds": [
              "1CH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba bona ni batabani ba Daudi; ab'alikuzara aha nsholeke batabulimu. Akaba aina n'omuhara Tamari.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.9",
            "verseOrgIds": [
              "1CH.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.9",
            "verseOrgIds": [
              "1CH.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baijukuru ba Solomoni ni Rehoboamu, ishe Abia, Abia ishe Asa, Asa ishe Yehoshafati; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.10",
            "verseOrgIds": [
              "1CH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoshafati ishe Yoramu, Yoramu ishe Ahazia, Ahazia ishe Yoashi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.11",
            "verseOrgIds": [
              "1CH.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoashi ishe Amazia, Amazia ishe Azaria, Azaria ishe Yotamu; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.12",
            "verseOrgIds": [
              "1CH.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yotamu ishe Ahazi, Ahazi ishe Hezekia, Hezekia ishe Manase; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.13",
            "verseOrgIds": [
              "1CH.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manase ishe Amoni, Amoni ishe Yosia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.14",
            "verseOrgIds": [
              "1CH.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Yosia ni Yohanani omuzigaijo, omushubiro ni Yehoyakimu, owa kashatu ni Zedekia n'owa kanai ni Shalumu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.15",
            "verseOrgIds": [
              "1CH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Yehoyakimu ni Yekonia na Zedekia abatabani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.16",
            "verseOrgIds": [
              "1CH.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Yekonia endore ni Shealisieli, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.17",
            "verseOrgIds": [
              "1CH.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Marikiramu, Pedaya, Shenazari, Yekamia, Hoshama na Nedabia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.18",
            "verseOrgIds": [
              "1CH.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Pedaya ni Zerubabeli na Shimei. Kandi batabani ba Zerubabeli ni Meshulamu na Hanania, omuhara ni Shelomiti akaba ali munyanyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.19",
            "verseOrgIds": [
              "1CH.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandi batanu ni Hashuba, Oheli, Berekia, Hasadia na Yushabihesedi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.20",
            "verseOrgIds": [
              "1CH.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Hanania ni Pelatia na Yeshaya, Yeshaya ishe Refaya, Refaya ishe Arinani, Arinani ishe Obadia, Obadia ishe Shekania. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.21",
            "verseOrgIds": [
              "1CH.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutabani wa Shekania ni Shemaya. Batabani ba Shemaya ni Hatushi, Igali, Baria, Nearia na Shafati; nibagoba mukaga. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.22",
            "verseOrgIds": [
              "1CH.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Nearia ni Elioenai, Hizikia na Azirikamu; nibagoba bashatu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.23",
            "verseOrgIds": [
              "1CH.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Elioenai ni Hodavia, Eliashibu, Pelaya, Akubu, Yohanani, Delaya na Anani; nibagoba mushanju.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.24",
            "verseOrgIds": [
              "1CH.3.24"
            ]
          }
        }
      ]
    }
  ],
