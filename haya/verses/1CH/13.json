          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi ayehanuza aha bakuru b'abaisherukare enkumi n'abaisherukare ebikumi, n'ahali buli mwebembezi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.1",
            "verseOrgIds": [
              "1CH.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashuba agambira enteko yona ya Isiraeli ati, “Kamuraba nimukisiima, kandi k'Omukama Ruhanga waitu araba nikwo alikwenda, tutume hona ahali barumuna baitu abasigaire omu nsi yona ya Isiraeli, tutume n'aha bakuhani n'Abalevita, bahurure batugobe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.2",
            "verseOrgIds": [
              "1CH.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho tugarure Esanduku ya Ruhanga waitu twikare nayo, kuba tukagihwamu omu biro bya Sauli.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.3",
            "verseOrgIds": [
              "1CH.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enteko yona ekunda kugirakwo, kuba ekigambo ekyo kikabashemelera bona.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.4",
            "verseOrgIds": [
              "1CH.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.4",
            "verseOrgIds": [
              "1CH.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Daudi ahuruza Isiraeli yona kwema Shihori eya Misiri kugoba aha butahiro bwa Hamati, kwihya Esanduku ya Ruhanga Kiriatiyearimu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.5",
            "verseOrgIds": [
              "1CH.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi na Isiraeli yona bagya Baala, niyo Kiriatiyearimu eya Yuda kwihayo Esanduku ya Ruhanga, elikwetelerwa ahali Ruhanga asingiire aha bakerubi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.6",
            "verseOrgIds": [
              "1CH.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagitwara omu gali mpya. Kwema omwa Abinadabu, egali egyo ebugwa Uza na Ahio. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.7",
            "verseOrgIds": [
              "1CH.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi na Isiraeli yona bashanduka n'amani gabo gona omu maisho ga Ruhanga, nibahoya, nibatera enanga, n'obudiika, n'enkunturo, n'amakondere.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.8",
            "verseOrgIds": [
              "1CH.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.8",
            "verseOrgIds": [
              "1CH.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo bagobire aha kyano kya Kidoni, ente zisitara, aho Uza aimukya omukono akwata aha Sanduku. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.9",
            "verseOrgIds": [
              "1CH.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama anigalira Uza amwita, aha rw'okwimukya omukono akakwata aha sanduku. Uza agwa aho omu maisho ga Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.10",
            "verseOrgIds": [
              "1CH.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi ashasha kubona okw'Omukama yanigalira Uza; kugoba kir'eki omwanya ogwo bagweta Peresiuza. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.11",
            "verseOrgIds": [
              "1CH.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kir'ekyo Daudi atina Ruhanga, agamba ati, “Nakuleta ntai Esanduku ya Ruhanga omwangu?” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.12",
            "verseOrgIds": [
              "1CH.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kityo tiyagitahize mu kigokye, shana yagitwara ahandi omwa Obediedomu ow'ekigo kya Gati. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.13",
            "verseOrgIds": [
              "1CH.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esanduku ya Ruhanga ekamara emyezi eshatu omwa Obediedomu. Omukama atunga omugisha omutungo gwa Obediedomu n'ebyo yabaire ainabyo byona.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.14",
            "verseOrgIds": [
              "1CH.13.14"
            ]
          }
        }
      ]
    }
  ],
