    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batahya Esanduku ya Ruhanga omw'ihema elyo Daudi yabaire aliteleire. Batambira Ruhanga ebihongo by'okwokibwa n'eby'emilembe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.1",
            "verseOrgIds": [
              "1CH.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi kayabaire yamazire kutamba ebihongo by'okwokibwa n'eby'emilembe, aha enteko omugisha omw'ibara ly'Omukama, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.2",
            "verseOrgIds": [
              "1CH.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi agabira Isiraeli yona abashaija n'abakazi buli muntu omukate, ekipimo ky'enyama n'ekeki y'ezabibu zomire.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.3",
            "verseOrgIds": [
              "1CH.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.3",
            "verseOrgIds": [
              "1CH.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi agira Abalevita abo yaronda kuba bakozi omu maisho g'Esanduku y'Omukama kuta nibatakira Omukama Ruhanga wa Isiraeli, kumusima n'okumuhaisiliza. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.4",
            "verseOrgIds": [
              "1CH.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asafu niwe yabaire ali mukuru, nahonderwa Zekaria, Yeyeli, Shemiramoti, Yehieli, Matitia, Eliabu, Benaya, Obediedomu na Yeleli ababaire baina omuruka gw'okutera enanga n'eningili. Asafu akaba ahairwe ogw'okuchekenkura enkunturo, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.5",
            "verseOrgIds": [
              "1CH.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi abakuhani abalimu Benaya na Yahazieli bakaba baina ogw'okwikara nibatera amakondere omu maisho g'Esanduku y'Omukama.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.6",
            "verseOrgIds": [
              "1CH.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.6",
            "verseOrgIds": [
              "1CH.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho kir'ekyo Daudi abanza aragira Asafu n'Abalevita n'abarumuna kuhoyera Omukama oruhoya rw'esimi bati, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.7",
            "verseOrgIds": [
              "1CH.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Musime Omukama, mutakire eibaralye,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.8",
            "verseOrgIds": [
              "1CH.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 16:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.36",
            "verseOrgIds": [
              "1CH.16.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 16:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kityo Daudi asigaho Asafu n'abarumuna aha Shanduku y'Endagano y'Omukama kukora emilimo obutosha aha Shanduku egyo nk'okwo kyayetagwaga buli kiro. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.37",
            "verseOrgIds": [
              "1CH.16.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 16:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakwo asigaho na Obediedomu n'abarumuna 68, kandi Obediedomu eya Yeduthuni na Hosa bakaba bali bakumilizi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.38",
            "verseOrgIds": [
              "1CH.16.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 16:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asiga Zadoki omukuhani n'abarumuna abakuhani aha Kiikaro ky'Omukama aha Rushozi rwa Gibeoni, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.39",
            "verseOrgIds": [
              "1CH.16.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 16:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "kutambira Omukama ebihongo by'okwokibwa obutosha ahali ealutare y'ekihongo ky'okwokibwa bwankya na bwaigoro, kuhonderana na byona ebyakahandikirwe omu Mateka g'Omukama ago y'ahangiire Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.40",
            "verseOrgIds": [
              "1CH.16.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 16:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakaba bainaho na Hemani na Yeduthuni, n'abandi abaronzirwe n'okutondwa butondwa amabara, kuta nibasiima Omukama kuba ekishakye kiba ky'eirai lyona. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.41",
            "verseOrgIds": [
              "1CH.16.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 16:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hemani na Yeduthuni bakaba baina amakondere n'enkunturo, n'ebikwato by'empoya ezitakatifu. Batabani ba Yeduthuni baba bakumilizi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.42",
            "verseOrgIds": [
              "1CH.16.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 16:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.42",
            "verseOrgIds": [
              "1CH.16.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 16:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho buli muntu ashuba amaruge, na Daudi agaruka omuka kushuliza aba wenene.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.43",
            "verseOrgIds": [
              "1CH.16.43"
            ]
          }
        }
      ]
    }
  ],
