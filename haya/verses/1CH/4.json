          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meshobabu, Yamuleki, Yosha eya Amazia; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.34",
            "verseOrgIds": [
              "1CH.4.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoeli, Yehu eya Yoshibia, Yoshibia eya Seraya, Seraya eya Asieli; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.35",
            "verseOrgIds": [
              "1CH.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elioenai, Yaakoba, Yeshohaya, Asaya, Adieli, Yesimieli, Benaya; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.36",
            "verseOrgIds": [
              "1CH.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ziza eya Shifi. Shifi eya Aloni, Aloni eya Yedaya, Yedaya eya Shimuri, Shimuri eya Shemaya; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.37",
            "verseOrgIds": [
              "1CH.4.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "aba abagambwa amabara bakaba bali bagurusi omu bika byabo, mara omu bika byabo ebyo bakahiirwa muno oruzaro. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.38",
            "verseOrgIds": [
              "1CH.4.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagenda bagoba aha butahiro bwa Gedori, n'oburugaizoba bw'oruhanga orwo, nibahiga amalisizo g'entaama zabo, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.39",
            "verseOrgIds": [
              "1CH.4.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "bashangayo agarungi agemirege, ensi eli mpango muno, eina obuchulezi n'emilembe, kuba abaturagamu bakaba nibatabuka ahali Hamu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.40",
            "verseOrgIds": [
              "1CH.4.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba abahandikwa amabara bakaija omu makiro ga Hezekia, omukama wa Yuda; basilikya amahema gabo, n'Abameuni abashangirwemu, babamaraho kuturuka na kir'eki, batura omu nsi yabo kuba hakazokwamu obulisizo bw'amahyo gabo g'entaama. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.41",
            "verseOrgIds": [
              "1CH.4.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandi omuli bonene Abasimeoni bikumi bitanu, bagya aha Ibanga lya Seiri bebembeirwe Pelatia, Nearia, Refaya na Uzieli batabani ba Ishi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.42",
            "verseOrgIds": [
              "1CH.4.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo basilikya ensigalira z'Abaamaleki abaruhonokireho, bamara batura omwo na kir'eki.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.43",
            "verseOrgIds": [
              "1CH.4.43"
            ]
          }
        }
      ]
    }
