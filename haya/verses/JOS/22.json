          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Finehasi n'abakuru baruga omu Barubeni n'Abagadi omuli Gileadi, bagaruka Kanaani omu Baisiraeli, babatwalira empororo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.32",
            "verseOrgIds": [
              "JOS.22.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebaruro egyo eshemelera Abaisiraeli, nabo bahaisiliza Ruhanga, baba batakigamba bya kubatera, kusilikya nsi y'Abarubeni n'Abagadi eyo baturagamu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.33",
            "verseOrgIds": [
              "JOS.22.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOS 22:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Altare egyo Abarubeni n'Abagadi bagyeta Kabonero, nibagamba bati, “Kabonero omugati yaitu okwo Omukama n'iwe Ruhanga.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.34",
            "verseOrgIds": [
              "JOS.22.34"
            ]
          }
        }
