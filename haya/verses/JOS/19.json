          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.50",
            "verseOrgIds": [
              "JOS.19.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JOS 19:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eleazari omukuhani, Yoshua eya Nuni, n'abakuru b'amahiga g'enganda za Isiraeli bakagaba ensi egyo nibarasha enshoga kubaza Omukama omuli Shilo, aha kishasi ky'Eihema ly'Omuterano. Nikwo bamazire batyo okwata ensi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.51",
            "verseOrgIds": [
              "JOS.19.51"
            ]
          }
        }
      ]
