              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwija kutaha omu bwikaro bw'abantu yatamu emizilingiti y'emizeituni ey'epembe inai, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.33",
            "verseOrgIds": [
              "1KI.6.33"
            ]
          }
