          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eibili ez'emizeituni yazitonaho abakerubi n'emikindo n'enyakyo, yazisiiga ezahabu. Yasiiga ezahabu aha bakerubi n'aha mikindo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.32",
