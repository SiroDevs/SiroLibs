          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orukuta rw'okuzingora nyakabuga ey'omunda yarwombekesa enjuru ishatu z'amabare agabaizire, n'orujuru rumoi rw'enyomyo z'emielezi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.36",
            "verseOrgIds": [
              "1KI.6.36"
