          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'enyigi ibili z'emiberoshi ezina ebipande bibili bya buli rwigi bikaba nibizingwa n'ebipande ebibili eby'orwigi orundi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.34",
