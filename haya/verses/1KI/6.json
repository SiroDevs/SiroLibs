              "type": "text"
            }
          ]
        },
        {
          "text": "Ekitebe kya Rwensinga y'Omukama kikombekwa omu mwezi gwa Zivu omu mwaka gwa kanai. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.37",
            "verseOrgIds": [
