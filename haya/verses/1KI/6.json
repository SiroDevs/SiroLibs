              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yataho enyigi z'emizeituni omu butahiro bw'Ahatakatifu nyakabara. Enyigi ezo zikaba zina epembe itanu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.31",
            "verseOrgIds": [
              "1KI.6.31"
            ]
          }
        },
