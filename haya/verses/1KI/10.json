        },
        {
          "text": "Omu makiroge efeza omuli Yerusalemu ekaba eli nyingi nk'amabare, n'emielezi ekakanya nk'emiti y'emisikamoli eya Shefela. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.27",
            "verseOrgIds": [
