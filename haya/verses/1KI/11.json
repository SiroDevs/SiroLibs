  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "1KI 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama Solomoni akagonza abanyamahangakazi, yashwera bangi. Omuli abo muhara wa Farao atabulimu, akashwera Abamoabukazi, Abaedomukazi, Abasidonikazi n'Abahitikazi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.1",
            "verseOrgIds": [
              "1KI.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabashwera n'orwo Omukama yabaire atangire Abaisiraeli ati, “Mutalisiigirana na banyamahanga, kuba omu mazima bakwija babarongotora emitima mukolera baruhanga babo.” Solomoni akagonza abakazi abo n'omutima gwona. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.2",
            "verseOrgIds": [
              "1KI.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akashwera abambeija 700 yataho n'ensholeke 300. Bakazibe bamurongotora omutima. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.3",
            "verseOrgIds": [
              "1KI.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni kayagurusire, bakazibe abo bamurongotora omutima, yafukamira baruhanga abandi, yaba atakili mwesigwa bwoli aha Mukama Ruhangawe nk'okwo Daudi ishe yabaire ali. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.4",
            "verseOrgIds": [
              "1KI.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akafukamira Ashitoreti Ruhanga omukazi w'Abasidoni, na Milikomu ruhanga w'Abaamoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.5",
            "verseOrgIds": [
              "1KI.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikwo yagokeire atyo Omukama; mara yaba atakiba mwesigwawe bwoli nk'okwo Daudi ishe yabaire ali. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.6",
            "verseOrgIds": [
              "1KI.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Solomoni ayombekera Kemoshi, ruhanga w'Abamoabu na Moleki ruhanga w'Abaamoni orwanga aha kabanga k'oburugaizoba bwa Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.7",
            "verseOrgIds": [
              "1KI.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba nikwo akolera atyo n'abakazi bona abanyamahangakazi, abayotezaga obunuma, bakatambira na baruhanga babo ebitambo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.8",
            "verseOrgIds": [
              "1KI.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.8",
            "verseOrgIds": [
              "1KI.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama Ruhanga wa Isiraeli anigalira Solomoni aha rw'okumushenga. Ashenga ayamuhabukiire kabili ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.9",
            "verseOrgIds": [
              "1KI.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "namutanga kufukamira baruhanga abandi. Kyonkai byonene eby'Omukama yamuragiire tiyabikwete. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.10",
            "verseOrgIds": [
              "1KI.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikwo Omukama kumugambira ati, “Orwo ohindwire omutima, okanga kuhikya endagano yange n'ebiragiro byange ebyo nakuhagiire, mazima ndakwaka obukama mbuhe omwiru wawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.11",
            "verseOrgIds": [
              "1KI.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai aha rwa Daudi sho timbukwake okyarora, ndibwaka mutabani wawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.12",
            "verseOrgIds": [
              "1KI.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi tindikwaka bukama bwona, ndisigira mutabani wawe oruganda rumoi aha rwa Daudi omwiru wange n'aha rwa Yerusalemu eyo naronkire.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.13",
            "verseOrgIds": [
              "1KI.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.13",
            "verseOrgIds": [
              "1KI.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama achokeza Solomoni omubisha, n'iwe Hadadi omurangira wa Edomu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.14",
            "verseOrgIds": [
              "1KI.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo Daudi yabaire ali Edomu, Yoabu omukuru w'eihe akagyayo kuziika abaisirwe, yashuba yasiga yaita buli mushaija omuli Edomu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.15",
            "verseOrgIds": [
              "1KI.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugya kubaita atyo, Yoabu n'Abaisiraeli bakaikarayo emyezi mukaga. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.16",
            "verseOrgIds": [
              "1KI.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shana Hadadi akaba asingiirwe Misiri hamoi n'Abaedomu abandi ababaire bali baramata ba ishe. Hadadi wenene akaba akyali mwana muto. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.17",
            "verseOrgIds": [
              "1KI.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baimukya baruga Midiani bagya Parani; baihya abantu abandi Parani betaba nabo bagya Misiri owa Farao Omukama w'ensi egyo. Farao amutunga enju, amuteraho ebyakulya n'ensi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.18",
            "verseOrgIds": [
              "1KI.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadadi aganja muno Farao, Farao amusiigira omuramu, murumuna Tapenesi mukaziwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.19",
            "verseOrgIds": [
              "1KI.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murumuna Tapenesi amuzalira omwana w'omwojo Genubati. Omwana ogwo Tapenesi amuletera Farao, atura na batabani ba Farao. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.20",
            "verseOrgIds": [
              "1KI.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai Hadadi kayayemire Misiri akahulira okwo Daudi yatahize n'okwo Yoabu omukuru w'eihe yafire, agambira Farao ati, “Ontaishure nshube owaitu.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.21",
            "verseOrgIds": [
              "1KI.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai Farao amugambira ati, “Obuzirweki ahali inye kwenda kushuba owanyu?” Amugambira ati, “Iwe ontaishure ngende.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.22",
            "verseOrgIds": [
              "1KI.11.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.22",
            "verseOrgIds": [
              "1KI.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga ashuba achokeza Solomoni omubisha ondijo, Rezoni eya Eliada, ayabaire airukire Mukamawe Hadadezeri Omukama wa Soba. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.23",
            "verseOrgIds": [
              "1KI.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahikanisa abashuga aba mukuru wabo. Ebi bikabaho orwo Daudi yabaire yasingiire Hadadezeri, yaisire n'Abasiria ababaire nibamuhwera. Bagenda Damasiko, batura okwo, bamuteka n'aha ngoma. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.24",
            "verseOrgIds": [
              "1KI.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rezoni yagingizaga Isiraeli ebiro byona bya Solomoni. Yahena nka Hadadi, yanoba Isiraeli, kandi yaba Mukama wa Siria.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.25",
            "verseOrgIds": [
              "1KI.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.25",
            "verseOrgIds": [
              "1KI.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroboamu owa Nebati, Omuefuraimu wa Zeredi, omuramata wa Solomoni, mutabani wa Zeruya entumbwakazi, na wenene ashenga Omukama Solomoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.26",
            "verseOrgIds": [
              "1KI.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enshonga eyamushengesize niy'egi: Solomoni akombeka Milo yaigaliza ekihuru ky'Ekigo kya Daudi ishe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.27",
            "verseOrgIds": [
              "1KI.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroboamu akaba ali manzi muno. Solomoni kayaboine okwo aina ekihika, yamutekaho kukoza emilimo y'ensika omu nsi y'ab'oruganda rwa Yozefu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.28",
            "verseOrgIds": [
              "1KI.11.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.28",
            "verseOrgIds": [
              "1KI.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiro kimoi orwo Yeroboamu yarugire Yerusalemu. Omurangi Ahiya Omushiloni amushanga omu kihanda. Ahiya akaba ajwete omwendo guhya. Bombili bakaba bali bonkai omu itarabuga. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.29",
            "verseOrgIds": [
              "1KI.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho Ahiya akwata omwendo ogwo oguhya ogwo yabaire ajwete, agutaguramu ebichweka 12. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.30",
            "verseOrgIds": [
              "1KI.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agambira Yeroboamu ati, “Twara ebichweka ikumi, enshonga Omukama Ruhanga wa Isiraeli nagamba ati, ‘Leba ndi haihi kwaka Solomoni obukama, nshube iwe nkuhe enganda ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.31",
            "verseOrgIds": [
              "1KI.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenene arasigara n'oruganda rumoi aha rw'omwiru wange Daudi, n'aha rwa Yerusalemu ekigo ekyo naronkire omu nganda zona za Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.32",
            "verseOrgIds": [
              "1KI.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okumugira ntyo anshengire yafukamira Ashitoreti, ruhanga omukazi ow'Abasidoni, na Kemoshi ruhanga w'Abamoabu, na Milikomu ruhanga w'Abaamoni. Tabaire mwesigwa ahali inye, takozire bilikunshemelera anga kukwata biragiro byange n'emigenzo yange, nka Daudi ishe okwo yagizire. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.33",
            "verseOrgIds": [
              "1KI.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai timwake ngoma yona, ndamulekera obukama orwo akyarora aha rwa Daudi omwiru wange owo naronkire, akakwata emihango yange n'ebiragiro byange. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.34",
            "verseOrgIds": [
              "1KI.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Engoma ndagyaka omutabani ngihe iwe enganda 10. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.35",
            "verseOrgIds": [
              "1KI.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omutabani ndamuha oruganda rumoi, mwijukuru wa Daudi omwiru wange abone kwikara ali Mukama ebiro byona omuli Yerusalemu, ekigo ekyo naronzire kufukamirwamu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.36",
            "verseOrgIds": [
              "1KI.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakuronka obe Mukama w'ensi yona ey'olikwenda, obe Mukama wa Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.37",
            "verseOrgIds": [
              "1KI.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "K'orahikya byona ebyo ndikukuragira, okaba mwesigwa ahali inye, okakora ebilikunshemelera, nokwata ebiragiro byange n'emihango yange nk'okwo omwiru wange Daudi yagizire; ndiba naiwe. Ndiramisa obukama bwawe nk'okwo naramisize obwa Daudi, mara ndikuha Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.38",
            "verseOrgIds": [
              "1KI.11.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha rw'obufu bwa Solomoni baijukuru ba Daudi ndibabonesa enaku kyonkai ti biro byona.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.39",
            "verseOrgIds": [
              "1KI.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwema aho Solomoni ahiga kwita Yeroboamu, kyonkai Yeroboamu airukira owa Shishaki, aikara okwo kuhika orwo Solomoni yatahize.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.40",
            "verseOrgIds": [
              "1KI.11.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.40",
            "verseOrgIds": [
              "1KI.11.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 11:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebindi ebyo Solomoni yakozire, n'obumanyibwe, bihandikirwe omu Kitabo ky'Amakuru ga Solomoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.41",
            "verseOrgIds": [
              "1KI.11.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 11:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emyaka eyo yatwete Isiraeli ayemire Yerusalemu negoba 40. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.42",
            "verseOrgIds": [
              "1KI.11.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 11:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahanyuma atahya, bamubyalira omu Kigo kya Daudi ishe. Omutabani Rehoboamu amusikira.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.43",
            "verseOrgIds": [
              "1KI.11.43"
            ]
          }
        }
      ]
    }
