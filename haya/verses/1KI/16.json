          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi agokera Omukama kushaga abamwebembeire bona. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.30",
            "verseOrgIds": [
              "1KI.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikamurahukira kurondora Yeroboamu eya Nebati, yashwera Yezebeli muhara wa Etibaali Omukama w'Abasidoni, yafukamira na Baali. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.31",
            "verseOrgIds": [
              "1KI.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuli rwensinga ya Baali eyo yayombekire Samaria ayombekeramu Baali ealutare, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.32",
            "verseOrgIds": [
              "1KI.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
