              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabu eya Omri akabanza kutwara Isiraeli guli mwaka gwa 30 Asa Omukama wa Yuda ali aha ngoma. Akatwara Isiraeli ayemire Samaria emyaka 22. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.29",
            "verseOrgIds": [
              "1KI.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
