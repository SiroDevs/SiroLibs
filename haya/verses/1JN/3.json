{
  "id": "1JN.3",
  "number": "3",
  "bookId": "1JN",
  "reference": "1 Yohana 3",
  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "1JN 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1JN 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulebe engonzi ezo Isheichwe yatugiliire, ichwe kwetwa baana ba Ruhanga, mara nikwo tuli. Ekyo ensi etatumanyira niky'eki: Wenene tiyamumanyire. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.1",
            "verseOrgIds": [
              "1JN.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1JN 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwenu bagonzibwa bange, ichwe twabaire baana ba Ruhanga. Emishusire yaitu okwo tuliba tuli telikuboneka mwaha, kyonkai nitumanya okwo orwo aliija tulimushusha. Tulimubona nk'okwo aliba ali. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.2",
            "verseOrgIds": [
              "1JN.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1JN 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi buli omoi aina eshuubi egi ataho amaani kuba mutakatifu nk'okwo Kirisito wenene aba mutakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.3",
            "verseOrgIds": [
              "1JN.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1JN 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli muntu akora obufu akwatwa omushango gw'obushengi; manyasi obufu buba bushengi. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.4",
            "verseOrgIds": [
              "1JN.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1JN 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimumanya okwo yaizire kutugarulira amafu gaitu, mara wenene tiyakozire bufu. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.5",
            "verseOrgIds": [
              "1JN.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1JN 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taliho ajwangana na Kirisito akashuba akafakara. Kandi ayafakara ogwo takaabonaga Kirisito, n'okumumanya chei. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.6",
            "verseOrgIds": [
              "1JN.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1JN 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twana twange, omuntu atakubabeiya. Ayakakora eby'obugorogoki aba mugorogoki, okwo Kirisito wenene aba mugorogoki. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.7",
            "verseOrgIds": [
              "1JN.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1JN 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akora entambara aba wa Sitani, enshonga Sitani akafakara kwema karai. Ekyalesire Omwana wa Ruhanga akaija kuchwa amafu ga Sitani. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.8",
            "verseOrgIds": [
              "1JN.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1JN 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayakazairwe Ruhanga tafakara, manyasi Ruhanga wenene wenene nyakabara aba asingiire omuli ogwo, mara tiyakufakara orwo ali Mwana wa Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.9",
            "verseOrgIds": [
              "1JN.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1JN 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha niho abali baana ba Ruhanga n'abali baana ba Sitani bakubonekera. Atakora kurungi taba wa Ruhanga, nangu n'atagonza murumuna abulimu.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.10",
            "verseOrgIds": [
              "1JN.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1JN 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.10",
            "verseOrgIds": [
              "1JN.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1JN 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga nigo makuru ago mwahuliire kwema aha mbandizo, okwo tulikuragirwa kugonzangana, ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.11",
            "verseOrgIds": [
              "1JN.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1JN 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "tutashusha Kaini ayabaire ali wa Sitani akaita omurumuna. Isi akamwitiraki? Akamwita kuba wenene akaba ali muntu mubi, kandi omurumuna akaba ali mugorogoki. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.12",
            "verseOrgIds": [
              "1JN.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1JN 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barumuna bange mutatangara kubona nsi nebanoba. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.13",
            "verseOrgIds": [
              "1JN.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1JN 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitumanya okwo twahimbukire, orwo tulikugonza barumuna baitu. Omuntu atagonza ogwo aba afire. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.14",
            "verseOrgIds": [
              "1JN.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1JN 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayakanoba omurumuna aba mwisi, mara nimumanya okwo omwisi tagira burora obutalihwaho. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.15",
            "verseOrgIds": [
              "1JN.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1JN 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okutufera kwa Kirisito niho tumanyira engonzi kiki. Naichwe nituragirwa kufera barumuna baitu. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.16",
            "verseOrgIds": [
              "1JN.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1JN 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai k'omuntu araba ali mutungi, kandi omurumuna ali munaku akashuba akanga kumushumbusha, ogwo engonzi za Ruhanga ainazo ngeliki? ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.17",
            "verseOrgIds": [
              "1JN.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1JN 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twana twange, tuleke kugonzangana omu bigambo anga aha rulimi kushai. Tugonzangane omu bikorwa n'omu mazima.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.18",
            "verseOrgIds": [
              "1JN.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1JN 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.18",
            "verseOrgIds": [
              "1JN.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1JN 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha niho turamanyira okwo tuli b'amazima, tukagira n'obwesige ahali wenene. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.19",
            "verseOrgIds": [
              "1JN.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1JN 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "K'emitima yaitu elikutukeena, nitumanya okwo Ruhanga ali muhango kushaaga emitima yaitu yonene mara namanya buli kantu. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.20",
            "verseOrgIds": [
              "1JN.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1JN 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagonzibwa bange k'emitima etatukeenire, nitugira obwesige ahali Ruhanga, ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.21",
            "verseOrgIds": [
              "1JN.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1JN 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ebyo tulikumushaba byona byona nabitutunga, aha rw'okukwata emihangoye n'okukora ebilikumushemelera. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.22",
            "verseOrgIds": [
              "1JN.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1JN 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuhangogwe nigw'ogu: Twesige Omwanawe Yesu Kirisito mara tugonzangane, nk'okwo yatuhangre. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.23",
            "verseOrgIds": [
              "1JN.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1JN 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bona abekomya emihango ya wenene baikara bajwangaine nawe, nawe aikara ajwangaine nabo. Mwoyo owo yatutungire niwe tumanyiraho okwo Ruhanga asingiire omuli ichwe.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.24",
            "verseOrgIds": [
              "1JN.3.24"
            ]
          }
        }
      ]
    }
  ],
