        "sid": "LUK 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukunirwa muno Teofilo, abantu bangi bataireho amani kuhandika amakuru g'ebyabaireho omuli ichwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.1",
            "verseOrgIds": [
              "LUK.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukashuba twabibarulirwa balinya ababiboine bubona kwema aha mbandizo bakashuba bakaranga amakuru garungi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.2",
            "verseOrgIds": [
              "LUK.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanye kwakwo kamazire kwekomya kurungi ebigambo ebi kuruga enyuma, nshemeleirwe nabona mbikuhandikire bunyanungi, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.3",
            "verseOrgIds": [
              "LUK.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "obone kumanya amazima agaijwire ahali buli kamoi kona ak'oraba oragambiirwe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.4",
            "verseOrgIds": [
              "LUK.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.4",
            "verseOrgIds": [
              "LUK.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu makiro g'Omukama Herode owa Buyahudi, hakaba haliho omukuhani nayetwa Zekaria, ow'eihiga lya Abiya omukuhani. Akaba aina omukazi namwihya omw'ihiga lya Aroni omukuhani, eibaralye Elizabeti. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.5",
            "verseOrgIds": [
              "LUK.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bombili bakaba bali bagorogoki ahali Ruhanga, nibekomya emihango yona n'emigenzo y'Omukama bataina kamogo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.6",
            "verseOrgIds": [
              "LUK.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai bakaba bataina mwana, mara bakaba bakuzire muno.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.7",
            "verseOrgIds": [
              "LUK.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.7",
            "verseOrgIds": [
              "LUK.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zekaria kayabaire ali Rwensinga aha mwoga gw'obukuhani eli zamu y'eihigalye ely'abakuhani, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.8",
            "verseOrgIds": [
              "LUK.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuhondera entwaza z'obukuhani, ekuura emugwera kutaaha Rwensinga y'Omukama kwotera obunuma. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.9",
            "verseOrgIds": [
              "LUK.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu saa egyo y'okwotera obunuma, embaga yona ekaba eli aheru neshoma enshara. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.10",
            "verseOrgIds": [
              "LUK.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omumalaika w'Omukama amuhabukira, ayemeleire orubaju rwa bulyo rwa alutare y'okwotezaho obunuma. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.11",
            "verseOrgIds": [
              "LUK.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zekaria kayamuboine yayechura, yatina. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.12",
            "verseOrgIds": [
              "LUK.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai omumalaika amugambira ati, “Zekaria otatiina, aha rw'okuba enshara yawe ehuliirwe, n'omukazi wawe Elizabeti arakuzalira omwana w'omwojo, eibara oramweta Yohana.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.13",
            "verseOrgIds": [
              "LUK.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.17",
            "verseOrgIds": [
              "LUK.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zekaria abaza omumalaika ati, “Ekyo ndakimanyirahai? Inye nabaire mugurusi, na mukazi wange yakaikwire.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.18",
            "verseOrgIds": [
              "LUK.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omumalaika amuhorora ati, “Inye ndi Gaburieli, nyikara nyemeleire omu mabona ga Ruhanga. Natumwa kukugambira, kukuletera amakuru garungi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.19",
            "verseOrgIds": [
              "LUK.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leba noija kwesiza, tolikwija kugamba kulemwa kugoba mbali ebigambo ebi biliberaho. Aha rw'enshonga ebyo nakugambira tiwabiikiliza, Kyonkai akanya kabyo kakaligoba bilibaho.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.20",
            "verseOrgIds": [
              "LUK.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.20",
            "verseOrgIds": [
              "LUK.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bakaba balindiliire Zekaria, batangara kubona okwo yakelererwa Rwensinga. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.21",
            "verseOrgIds": [
              "LUK.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kayaturukire tiyashoboire kubafumolera. Aho bamanyirayo okwo yabonekerwa omuli Rwensinga. Akabalengera kushai yaikara atitaire. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.22",
            "verseOrgIds": [
              "LUK.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "K'ezamuye yahoire yashuba owe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.23",
            "verseOrgIds": [
              "LUK.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.23",
            "verseOrgIds": [
              "LUK.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebiro by'ezamu kabyahoire Elizabeti atwara enda, amara emyezi etanu yona ayeshelekire, nagira ati, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.24",
            "verseOrgIds": [
              "LUK.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omukama ansingiire yanyijuka, yanyihyaho enshoni omu bantu.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.25",
            "verseOrgIds": [
              "LUK.1.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.25",
            "verseOrgIds": [
              "LUK.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guli mwezi gwa mukaga Elizabeti atwete enda, Ruhanga atuma Omumalaika Gaburieli omu kigo kya Galilaya, nikyetwa Nazareti, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.26",
            "verseOrgIds": [
              "LUK.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "aha mubikira ayabaire nashelerwa omushaija eibaralye Yozefu, ow'oruganda rwa Daudi. Eibara ly'omubikira ogwo akaba ali Maria. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.27",
            "verseOrgIds": [
              "LUK.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omumalaika amugoba amugambira ati,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.28",
            "verseOrgIds": [
              "LUK.1.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 1:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.37",
            "verseOrgIds": [
              "LUK.1.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maria agamba ati, “Leba inye ndi muzana w'Omukama, mbe nk'okwo wagamba.” Aho omumalaika amurugaho agenda.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.38",
            "verseOrgIds": [
              "LUK.1.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.38",
            "verseOrgIds": [
              "LUK.1.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 1:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu biro ebyo Maria aimukya, agenda bwangu omw'ibanga, omu nsi ya Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.39",
            "verseOrgIds": [
              "LUK.1.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orwo yatahire omwa Zekaria, akeisa Elizabeti. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.40",
            "verseOrgIds": [
              "LUK.1.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elizabeti kayahuliire ekishuuro kya Maria, enda omu rubunda eguragurukibwa amashemelerwa, na Elizabeti wenene aijurwa Mwoyo Mutakatifu, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.41",
            "verseOrgIds": [
              "LUK.1.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "atangara, agamba n'eiraka lihango ati, “Omu bakazi bona oli kilimugisha, n'omwana w'olikwija kuzara ni kilimugisha! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.42",
            "verseOrgIds": [
              "LUK.1.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 1:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kyonene eki kyandugirahai inye nyina mukama wange kunzindukira? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.43",
            "verseOrgIds": [
              "LUK.1.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuba orwo nahulira nti ekishuuro kyawe, enda yanguraguruka omw'ibunda n'amashemelerwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.44",
            "verseOrgIds": [
              "LUK.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mara oli muberwa orwo oikilize okwo eby'Omukama akugambiire bilikwija kugobeelera.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.45",
            "verseOrgIds": [
              "LUK.1.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 1:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maria nawe agamba ati,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.46",
            "verseOrgIds": [
              "LUK.1.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LUK 1:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.55",
            "verseOrgIds": [
              "LUK.1.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LUK 1:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maria akamara na Elizabeti emyezi nk'eshatu yagaruka omuka.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.56",
            "verseOrgIds": [
              "LUK.1.56"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LUK 1:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.56",
            "verseOrgIds": [
              "LUK.1.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "LUK 1:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elizabeti agoba aha kaanya k'okuzara, azara omwana w'omwojo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.57",
            "verseOrgIds": [
              "LUK.1.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "LUK 1:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batanibe n'abanyabuzare bahulira okwo Omukama amugilire obuganyizi bungi, bamukwasa ebyera ebyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.58",
            "verseOrgIds": [
              "LUK.1.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "LUK 1:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha kiro kya munaana baija kutahiri omwana, bagonza kumweta Zekaria eibara lya ishe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.59",
            "verseOrgIds": [
              "LUK.1.59"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "60",
            "style": "v",
            "sid": "LUK 1:60"
          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe nyina agamba ati, “Tibilikwija kugenda bityo. Ayetwe Yohana.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.60",
            "verseOrgIds": [
              "LUK.1.60"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "61",
            "style": "v",
            "sid": "LUK 1:61"
          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamugambira bati, “Omu banyabuzare bawe talimu muntu alikwetwa ibara eli.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.61",
            "verseOrgIds": [
              "LUK.1.61"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "LUK 1:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balengera ishe, nibamubaza okwo alikwenda omwana kwetwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.62",
            "verseOrgIds": [
              "LUK.1.62"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "63",
            "style": "v",
            "sid": "LUK 1:63"
          },
          "items": [
            {
              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abenza ekibaho ky'okuhandikaho, ahandikaho ati, “Eibaralye ni Yohana.” Batangara bona. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.63",
            "verseOrgIds": [
              "LUK.1.63"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "64",
            "style": "v",
            "sid": "LUK 1:64"
          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niho honkai akanwa kakinguka, orulimi rukomorogoka, agamba asingiza Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.64",
            "verseOrgIds": [
              "LUK.1.64"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "65",
            "style": "v",
            "sid": "LUK 1:65"
          },
          "items": [
            {
              "text": "65",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batani babo bona bakwatwa obutini. Ebigambo ebi bigambwa byona omu mabanga ga Buyahudi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.65",
            "verseOrgIds": [
              "LUK.1.65"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "66",
            "style": "v",
            "sid": "LUK 1:66"
          },
          "items": [
            {
              "text": "66",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bona ababihuliire babibiika aha mutima nibebaza bati, “Omwana ogu aliba atai?” Kuba amani ga Ruhanga gakaba gamulimu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.66",
            "verseOrgIds": [
              "LUK.1.66"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "66",
            "style": "v",
            "sid": "LUK 1:66"
          },
          "items": [
            {
              "text": "66",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.66",
            "verseOrgIds": [
              "LUK.1.66"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "67",
            "style": "v",
            "sid": "LUK 1:67"
          },
          "items": [
            {
              "text": "67",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zekaria ishe Yohana Omubatiza, aijurwa Mwoyo Mutakatifu, abaasha ati, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.67",
            "verseOrgIds": [
              "LUK.1.67"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "68",
            "style": "v",
            "sid": "LUK 1:68"
          },
          "items": [
            {
              "text": "68",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Asingizibwe Omukama Ruhanga wa Isiraeli,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.68",
            "verseOrgIds": [
              "LUK.1.68"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "79",
            "style": "v",
            "sid": "LUK 1:79"
          },
          "items": [
            {
              "text": "79",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.79",
            "verseOrgIds": [
              "LUK.1.79"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "80",
            "style": "v",
            "sid": "LUK 1:80"
          },
          "items": [
            {
              "text": "80",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwana Yohana akura mara aba manzi omu mwoyo. Yaturaga omw'irungu kuhika kiro ekyo yayeyarwire omuli Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.80",
            "verseOrgIds": [
              "LUK.1.80"
            ]
          }
        }
      ]
    }
