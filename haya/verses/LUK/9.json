              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu ondijo ati, “Waitu Mukama, inye ndakuhondera; kyonkai mbanze ngende ngye ndazege abange omwaitu.” ",
          "type": "text",
          "attrs": {
