          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.3",
            "verseOrgIds": [
              "HEB.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana aina ekitiinwa kushaaga abamalaika, nk'okwo eibara lyoyaboine liina ekitiinwa kushaaga ely'abamalaika bonene. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.4",
            "verseOrgIds": [
              "HEB.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha rw'okuba Ruhanga takagambiraga mumalaika n'omoi ati,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.5",
            "verseOrgIds": [
              "HEB.1.5"
            ]
          }
        }
      ]
    },
