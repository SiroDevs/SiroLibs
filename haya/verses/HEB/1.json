          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamalaika aba bona baba myoyo kushai, mara bakozi ba Ruhanga, kandi Ruhanga wenene abatuma kujuna abali b'okurokoka.",
          "type": "text",
          "attrs": {
