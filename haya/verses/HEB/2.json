              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nituragirwa kwekomya ebyo tuhuliire, tutaija tukabinagisibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.1",
            "verseOrgIds": [
              "HEB.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "K'ebyo abamalaika bagambire biraba bikaba bili by'amazima, kandi buli omoi ayakozire entambara anga atagizire muhuliro akabona ekibonabonyio ekimusaine, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.2",
            "verseOrgIds": [
              "HEB.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ichwe ekibonabonyio twije tukihungeho tutai katuurabura kwetaho omuhanda gukuru nk'ogu ogw'okuturokora? Eki ayakigambire mbere ni Mukama wenene, kandi abamuhuliire batugambira okwo gali mazima. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.3",
            "verseOrgIds": [
              "HEB.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Ruhanga nawe yaba mujulizi wabo, yakora ebitangazo n'eby'amani ebitali bimoi, yayongeraho n'amatungwa ga Mwoyo Mutakatifu ago atunga abantu nk'okwo ayenzire.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.4",
            "verseOrgIds": [
              "HEB.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
