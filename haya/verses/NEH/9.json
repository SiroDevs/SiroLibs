          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha rw'enshonga y'ebi byona nitukora endagano ehamire mara nitugihandika, n'abatwazi baitu, Abalevita baitu n'abakuhani baitu bagiteho omuhuri.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.38",
