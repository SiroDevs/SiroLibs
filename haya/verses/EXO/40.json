              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa tiyashoboire kutaha mw'Ihema lya Muterano aha rw'okuba ekichwi kikaliikara eiguru n'ekitinwa ky'Omukama kyaijura ekiikaro. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.35",
            "verseOrgIds": [
              "EXO.40.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 40:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu ngendo zabo zona orwo ekichwi kyarugaga aha kiikaro Abaisiraeli bagendelera omu maisho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.36",
            "verseOrgIds": [
              "EXO.40.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 40:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyonkai k'ekichwi kitarugagaho, aho tibagendeleraga mu maisho kuhika kiro ekyo kyarugagaho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.37",
            "verseOrgIds": [
              "EXO.40.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
