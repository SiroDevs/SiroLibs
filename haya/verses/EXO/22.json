          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Muli bantu bange endonkwa; aha rw'ekyo mutalilya nyama ey'ebikaaka bililiire omw'ishwa, mugishabulire embwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.31",
            "verseOrgIds": [
              "EXO.22.31"
            ]
          }
