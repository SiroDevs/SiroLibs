          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaisiraeli bagoba Elimu mbali habaire hali enchuro ikumi na ibili n'emitende nshanju, basisira aha nchuro ezo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.27",
