          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anga kakiliba nikimanyika okwo ente emanyiire kuchumita kwema karai mara mukama wayo atagikomire, ente aragiliha ente, ekitunganwa ekyafa kibekye.",
          "type": "text",
