            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Orwo ente elichumita omuntu yaba mushaija anga mukazi akafa, ente egyo bagiteze amabare, kandi enyama yayo etalilibwa, kyonkai mukama wayo talikwatwa mushango. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.28",
            "verseOrgIds": [
              "EXO.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi k'ente eliba emanyiire kuchumita kwema karai, na mukama wayo bamugambire kyonkai tiyagikoma, ekaija ekaita omuntu yaba mushaija anga mukazi, bagiteze amabare na mukama wayo kwakwo bamwite. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.29",
            "verseOrgIds": [
              "EXO.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabalimuchwa eky'okwechunguza aho agire kyona kyona ekyo balimuchwa kwechungura. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.30",
            "verseOrgIds": [
              "EXO.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "K'elichumita omwana w'omuntu yaba mwojo anga mwisiki, bamukore kuhonderana n'eiteka lyonene lyonene eli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.31",
            "verseOrgIds": [
              "EXO.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "K'ente elichumita omwiru anga omuzana, mukama wayo ahe mukama wabo eshekeli makumi gashatu z'efeza, kandi ente bagiteze amabare.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.32",
            "verseOrgIds": [
              "EXO.21.32"
            ]
          }
        }
      ]
    },
