              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.29",
            "verseOrgIds": [
              "EXO.39.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 39:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakora orupapya rw'orukinga rutakatifu rw'ezahabu enchenkure, baruhandikaho ekihandiko nk'ekibaizirwe aha muhuri, nikigamba kiti, “Omutakatifu w'Omukama.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.30",
            "verseOrgIds": [
              "EXO.39.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 39:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barukomaho omuyondo gwa kibururu; kurukoma aha kilemba eiguru, nk'okwo Omukama yabaire ahangire Musa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.31",
            "verseOrgIds": [
              "EXO.39.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 39:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.31",
            "verseOrgIds": [
              "EXO.39.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 39:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oku nikwo omulimo gwona gw'ekiikaro ky'Eihema ly'Omuterano gwahoire. Abaisiraeli bakabikora byona nk'okwo Omukama yabaire ahangiire Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.32",
            "verseOrgIds": [
              "EXO.39.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 39:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baletera Musa ekiikaro, eihema n'ebikwato byalyo byona, amarobo galyo, emizilingiti yalyo, embazi zalyo, enyomyo zalyo n'amachuba galyo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.33",
            "verseOrgIds": [
              "EXO.39.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 39:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekishwekeso ky'empu z'empaya z'entaama ezisisimwire, n'empu z'embuzi, n'orutimbe rw'ekisiika; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.34",
            "verseOrgIds": [
              "EXO.39.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 39:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "esanduku y'obujulizi n'emigamba yalyo n'entebe y'obuganyizi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.35",
            "verseOrgIds": [
              "EXO.39.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 39:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "emeza n'ebikwato byayo byona n'omukate gw'obusinge; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.36",
            "verseOrgIds": [
              "EXO.39.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 39:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekinara ky'etara ky'ezahabu enchenkure kandi n'etara zakyo, n'ebikwato byakyo byona kandi n'amajuta g'okuhemba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.37",
            "verseOrgIds": [
              "EXO.39.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 39:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alutare y'ezahabu n'amajuta g'okusiga n'obunuma bulikutamirana, n'ekisika ky'omulyango gw'eihema; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.38",
            "verseOrgIds": [
              "EXO.39.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 39:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "ealutare y'omulinga n'orutimbe rw'omulinga, emigamba yayo n'ebikwato byayo byona, orunabiro n'eichuba lyarwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.39",
            "verseOrgIds": [
              "EXO.39.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EXO 39:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entimbe za nyakabuga, enyomyo zayo, n'amachuba gazo, n'ekisika ky'omulyango gwa nyakabuga, emiguha yayo, engango zayo, n'ebikwato byona eby'emiruka y'omw'Ihema ly'Omuterano. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.40",
            "verseOrgIds": [
              "EXO.39.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EXO 39:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebijwaro bitakatifu ebikozirwege aha rw'emyoga y'omw'Ihema litakatifu ebya Aroni omukuhani n'abatabani eby'okukoza emiruka y'obukuhani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.41",
            "verseOrgIds": [
              "EXO.39.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EXO 39:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kityo Abaisiraeli bakora omulimo gwona nk'okw'Omukama yabaire ahangiire Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.42",
            "verseOrgIds": [
              "EXO.39.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EXO 39:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa aleba omulimo gwona, abona okwo bagukozire. Nk'okwo Omukama yabaire amuhangiire nikwo bagukozire. Musa abaha omugisha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.43",
            "verseOrgIds": [
              "EXO.39.43"
            ]
          }
        }
      ]
    }
