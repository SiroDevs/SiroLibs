{
  "id": "PSA.147",
  "number": "147",
  "bookId": "PSA",
  "reference": "Psaumes 147",
  "copyright": "Texte libre de droits",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "147",
        "style": "c",
        "sid": "PSA 147"
      },
      "items": [
        {
          "text": "147",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 147:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Louez Jah !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.1",
            "verseOrgIds": [
              "PSA.147.1"
            ]
          }
        },
        {
          "text": "car c'est une chose bonne. Chantez les louanges de notre",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.1",
            "verseOrgIds": [
              "PSA.147.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.147.1",
                "verseOrgIds": [
                  "PSA.147.1"
                ]
              }
            }
          ]
        },
        {
          "text": "! car c'est une chose agréable. La louange est bienséante.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.1",
            "verseOrgIds": [
              "PSA.147.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 147:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "L'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.2",
            "verseOrgIds": [
              "PSA.147.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.147.2",
                "verseOrgIds": [
                  "PSA.147.2"
                ]
              }
            }
          ]
        },
        {
          "text": "bâtit Jérusalem ; il rassemble les exilés d'Israël.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.2",
            "verseOrgIds": [
              "PSA.147.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 147:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "C'est lui qui guérit ceux qui ont le cœur brisé, et qui bande leurs plaies ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.3",
            "verseOrgIds": [
              "PSA.147.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 147:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qui compte le nombre des étoiles : à elles toutes il donne des noms.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.4",
            "verseOrgIds": [
              "PSA.147.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 147:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Notre Seigneur est grand et d'une grande puissance ; son intelligence est sans bornes.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.5",
            "verseOrgIds": [
              "PSA.147.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 147:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "L'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.6",
            "verseOrgIds": [
              "PSA.147.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.147.6",
                "verseOrgIds": [
                  "PSA.147.6"
                ]
              }
            }
          ]
        },
        {
          "text": "affermit les débonnaires ; il renverse les méchants jusqu'en terre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.6",
            "verseOrgIds": [
              "PSA.147.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 147:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chantez",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.7",
            "verseOrgIds": [
              "PSA.147.7"
            ]
          }
        },
        {
          "text": "à l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.7",
            "verseOrgIds": [
              "PSA.147.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.147.7",
                "verseOrgIds": [
                  "PSA.147.7"
                ]
              }
            }
          ]
        },
        {
          "text": "avec actions de grâces, psalmodiez sur la harpe à notre",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.7",
            "verseOrgIds": [
              "PSA.147.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.147.7",
                "verseOrgIds": [
                  "PSA.147.7"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.7",
            "verseOrgIds": [
              "PSA.147.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 147:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qui couvre de nuages les cieux, qui prépare la pluie pour la terre, qui fait germer l'herbe sur les montagnes ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.8",
            "verseOrgIds": [
              "PSA.147.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 147:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qui donne la nourriture au bétail, [et] aux petits du corbeau qui crient.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.9",
            "verseOrgIds": [
              "PSA.147.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 147:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Il ne trouve pas son plaisir en la force du cheval, il ne se complaît pas aux jambes de l'homme.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.10",
            "verseOrgIds": [
              "PSA.147.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 147:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Le plaisir de l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.11",
            "verseOrgIds": [
              "PSA.147.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.147.11",
                "verseOrgIds": [
                  "PSA.147.11"
                ]
              }
            }
          ]
        },
        {
          "text": "est en ceux qui le craignent, en ceux qui s'attendent à sa bonté.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.11",
            "verseOrgIds": [
              "PSA.147.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 147:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jérusalem, célèbre l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.12",
            "verseOrgIds": [
              "PSA.147.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.147.12",
                "verseOrgIds": [
                  "PSA.147.12"
                ]
              }
            }
          ]
        },
        {
          "text": "! Sion, loue ton",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.12",
            "verseOrgIds": [
              "PSA.147.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.147.12",
                "verseOrgIds": [
                  "PSA.147.12"
                ]
              }
            }
          ]
        },
        {
          "text": "!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.12",
            "verseOrgIds": [
              "PSA.147.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 147:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car il rend fortes les barres de tes portes ; il bénit tes fils au milieu de toi ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.13",
            "verseOrgIds": [
              "PSA.147.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 147:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Il met la paix dans tes confins ; il te rassasie de la moelle du froment ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.14",
            "verseOrgIds": [
              "PSA.147.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 147:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Il envoie ses oracles sur la terre : sa parole court avec vitesse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.15",
            "verseOrgIds": [
              "PSA.147.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 147:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "C'est lui qui donne la neige comme de la laine, qui répand la gelée blanche comme de la cendre ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.16",
            "verseOrgIds": [
              "PSA.147.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 147:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Il jette sa glace comme par morceaux : qui peut subsister devant son froid ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.17",
            "verseOrgIds": [
              "PSA.147.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 147:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Il envoie sa parole et les fait fondre ; il fait souffler son vent : les eaux coulent.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.18",
            "verseOrgIds": [
              "PSA.147.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 147:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Il annonce ses paroles à Jacob, ses statuts et ses ordonnances",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.19",
            "verseOrgIds": [
              "PSA.147.19"
            ]
          }
        },
        {
          "text": "à Israël.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.19",
            "verseOrgIds": [
              "PSA.147.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 147:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Il n'a fait ainsi à aucune nation ; et ses ordonnances",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.20",
            "verseOrgIds": [
              "PSA.147.20"
            ]
          }
        },
        {
          "text": ", elles ne les ont pas connues. Louez Jah !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.20",
            "verseOrgIds": [
              "PSA.147.20"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.148",
    "number": "148",
    "bookId": "PSA"
  },
  "previous": {
    "id": "PSA.146",
    "number": "146",
    "bookId": "PSA"
  }
}