        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 84:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "*Au chef de musique. Sur Guitthith",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.1",
            "verseOrgIds": [
              "PSA.84.1"
            ]
          }
        },
        {
          "text": ". Des fils de Coré. Psaume.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.1",
            "verseOrgIds": [
              "PSA.84.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 84:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Combien sont aimables tes demeures, ô",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.2",
            "verseOrgIds": [
              "PSA.84.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.2",
                "verseOrgIds": [
                  "PSA.84.2"
                ]
              }
            }
          ]
        },
        {
          "text": "des armées !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.2",
            "verseOrgIds": [
              "PSA.84.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 84:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mon âme désire, et même elle languit après les parvis de l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.3",
            "verseOrgIds": [
              "PSA.84.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.3",
                "verseOrgIds": [
                  "PSA.84.3"
                ]
              }
            }
          ]
        },
        {
          "text": "; mon cœur et ma chair crient après le",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.3",
            "verseOrgIds": [
              "PSA.84.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "✶Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.3",
                "verseOrgIds": [
                  "PSA.84.3"
                ]
              }
            }
          ]
        },
        {
          "text": "vivant.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.3",
            "verseOrgIds": [
              "PSA.84.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 84:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Le passereau même a trouvé une maison, et l'hirondelle un nid pour elle, où elle a mis ses petits :… tes autels, ô",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.4",
            "verseOrgIds": [
              "PSA.84.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.4",
                "verseOrgIds": [
                  "PSA.84.4"
                ]
              }
            }
          ]
        },
        {
          "text": "des armées ! mon roi et mon",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.4",
            "verseOrgIds": [
              "PSA.84.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.4",
                "verseOrgIds": [
                  "PSA.84.4"
                ]
              }
            }
          ]
        },
        {
          "text": "!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.4",
            "verseOrgIds": [
              "PSA.84.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 84:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bienheureux ceux qui habitent dans ta maison ; ils te loueront sans cesse ! Sélah.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.5",
            "verseOrgIds": [
              "PSA.84.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 84:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bienheureux l'homme dont la force est en toi, [et ceux] dans le cœur desquels sont les chemins frayés !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.6",
            "verseOrgIds": [
              "PSA.84.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 84:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Passant par la vallée de Baca",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.7",
            "verseOrgIds": [
              "PSA.84.7"
            ]
          }
        },
        {
          "text": ", ils en font une fontaine ; la pluie",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.7",
            "verseOrgIds": [
              "PSA.84.7"
            ]
          }
        },
        {
          "text": "aussi la couvre de bénédictions.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.7",
            "verseOrgIds": [
              "PSA.84.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 84:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ils marchent de force en force, ils paraissent devant",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.8",
            "verseOrgIds": [
              "PSA.84.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.8",
                "verseOrgIds": [
                  "PSA.84.8"
                ]
              }
            }
          ]
        },
        {
          "text": "en Sion.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.8",
            "verseOrgIds": [
              "PSA.84.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 84:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.9",
                "verseOrgIds": [
                  "PSA.84.9"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.9",
            "verseOrgIds": [
              "PSA.84.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.9",
                "verseOrgIds": [
                  "PSA.84.9"
                ]
              }
            }
          ]
        },
        {
          "text": "des armées ! écoute ma prière ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.9",
            "verseOrgIds": [
              "PSA.84.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.9",
                "verseOrgIds": [
                  "PSA.84.9"
                ]
              }
            }
          ]
        },
        {
          "text": "de Jacob ! prête l'oreille. Sélah.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.9",
            "verseOrgIds": [
              "PSA.84.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 84:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toi, notre bouclier ! – vois, ô",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.10",
            "verseOrgIds": [
              "PSA.84.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.10",
                "verseOrgIds": [
                  "PSA.84.10"
                ]
              }
            }
          ]
        },
        {
          "text": "! et regarde la face de ton oint.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.10",
            "verseOrgIds": [
              "PSA.84.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 84:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car un jour dans tes parvis vaut mieux que mille. J'aimerais mieux me tenir sur le seuil dans la maison de mon",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.11",
            "verseOrgIds": [
              "PSA.84.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.11",
                "verseOrgIds": [
                  "PSA.84.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", que de demeurer dans les tentes de la méchanceté.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.11",
            "verseOrgIds": [
              "PSA.84.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 84:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.12",
            "verseOrgIds": [
              "PSA.84.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.12",
                "verseOrgIds": [
                  "PSA.84.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.12",
            "verseOrgIds": [
              "PSA.84.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.12",
                "verseOrgIds": [
                  "PSA.84.12"
                ]
              }
            }
          ]
        },
        {
          "text": "est un soleil et un bouclier ; l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.12",
            "verseOrgIds": [
              "PSA.84.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.12",
                "verseOrgIds": [
                  "PSA.84.12"
                ]
              }
            }
          ]
        },
        {
          "text": "donnera la grâce et la gloire ; il ne refusera aucun bien à ceux qui marchent dans l'intégrité.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.12",
            "verseOrgIds": [
              "PSA.84.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 84:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.13",
                "verseOrgIds": [
                  "PSA.84.13"
                ]
              }
            }
          ]
        },
        {
          "text": "des armées ! bienheureux l'homme qui se confie en toi !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.13",
            "verseOrgIds": [
              "PSA.84.13"
            ]
          }
        }
      ]
    }
