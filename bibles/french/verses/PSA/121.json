        {
          "text": "L'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.8",
            "verseOrgIds": [
              "PSA.121.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.121.8",
                "verseOrgIds": [
                  "PSA.121.8"
                ]
              }
            }
          ]
        },
        {
          "text": "gardera ta sortie et ton entrée, dès maintenant et à toujours.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.8",
            "verseOrgIds": [
              "PSA.121.8"
            ]
          }
        }
