      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 121:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cantique des degrés. J'élève mes yeux vers les montagnes d'où vient mon secours",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.1",
            "verseOrgIds": [
              "PSA.121.1"
            ]
          }
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.1",
            "verseOrgIds": [
              "PSA.121.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 121:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mon secours [vient] d'auprès de l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.2",
            "verseOrgIds": [
              "PSA.121.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.121.2",
                "verseOrgIds": [
                  "PSA.121.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", qui a fait les cieux et la terre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.2",
            "verseOrgIds": [
              "PSA.121.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 121:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Il ne permettra point que ton pied soit ébranlé ; celui qui te garde ne sommeillera pas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.3",
            "verseOrgIds": [
              "PSA.121.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 121:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Voici, celui qui garde Israël ne sommeillera pas, et ne dormira pas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.4",
            "verseOrgIds": [
              "PSA.121.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 121:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "L'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.5",
            "verseOrgIds": [
              "PSA.121.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.121.5",
                "verseOrgIds": [
                  "PSA.121.5"
                ]
              }
            }
          ]
        },
        {
          "text": "est celui qui te garde ; l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.5",
            "verseOrgIds": [
              "PSA.121.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.121.5",
                "verseOrgIds": [
                  "PSA.121.5"
                ]
              }
            }
          ]
        },
        {
          "text": "est ton ombre, à ta main droite.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.5",
            "verseOrgIds": [
              "PSA.121.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 121:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Le soleil ne te frappera pas de jour, ni la lune de nuit.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.6",
            "verseOrgIds": [
              "PSA.121.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 121:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "L'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.7",
            "verseOrgIds": [
              "PSA.121.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.121.7",
                "verseOrgIds": [
                  "PSA.121.7"
                ]
              }
            }
          ]
        },
        {
          "text": "te gardera de tout mal ; il gardera ton âme.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.7",
            "verseOrgIds": [
              "PSA.121.7"
            ]
          }
        }
      ]
    },
