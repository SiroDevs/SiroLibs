              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Louez Jah.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.1",
            "verseOrgIds": [
              "PSA.150.1"
            ]
          }
        },
        {
          "text": "Louez",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.1",
            "verseOrgIds": [
              "PSA.150.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "✶Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.150.1",
                "verseOrgIds": [
                  "PSA.150.1"
                ]
              }
            }
          ]
        },
        {
          "text": "dans son saint lieu ! Louez-le dans le firmament",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.1",
            "verseOrgIds": [
              "PSA.150.1"
            ]
          }
        },
        {
          "text": "de sa force !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.1",
            "verseOrgIds": [
              "PSA.150.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 150:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Louez-le pour",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.2",
            "verseOrgIds": [
              "PSA.150.2"
            ]
          }
        },
        {
          "text": "ses actes puissants ! Louez-le pour l'étendue de sa grandeur !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.2",
            "verseOrgIds": [
              "PSA.150.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 150:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Louez-le avec le son retentissant de la trompette ! Louez-le avec le luth et la harpe !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.3",
            "verseOrgIds": [
              "PSA.150.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 150:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Louez-le avec le tambourin et la danse ! Louez-le avec des instruments à cordes et le chalumeau !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.4",
            "verseOrgIds": [
              "PSA.150.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 150:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Louez-le avec les cymbales sonores ! Louez-le avec les cymbales retentissantes !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.5",
            "verseOrgIds": [
              "PSA.150.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 150:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que tout ce qui respire loue Jah ! Louez Jah !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.6",
            "verseOrgIds": [
              "PSA.150.6"
            ]
