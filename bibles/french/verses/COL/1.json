{
  "id": "COL.1",
  "number": "1",
  "bookId": "COL",
  "reference": "Colossiens 1",
  "copyright": "Texte libre de droits",
  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "COL 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "COL 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paul, apôtre du christ Jésus par la volonté de",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.1",
            "verseOrgIds": [
              "COL.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "COL.1.1",
                "verseOrgIds": [
                  "COL.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", et Timothée, le frère,",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.1",
            "verseOrgIds": [
              "COL.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "COL 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "aux saints et fidèles frères en Christ qui sont à Colasses : Grâce et paix à vous, de la part de",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.2",
            "verseOrgIds": [
              "COL.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "COL.1.2",
                "verseOrgIds": [
                  "COL.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "notre Père [et du seigneur Jésus Christ] !",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.2",
            "verseOrgIds": [
              "COL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "COL 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nous rendons grâces au",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.3",
            "verseOrgIds": [
              "COL.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "COL.1.3",
                "verseOrgIds": [
                  "COL.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "et Père de notre seigneur Jésus Christ, priant toujours pour vous",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.3",
            "verseOrgIds": [
              "COL.1.3"
            ]
          }
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.3",
            "verseOrgIds": [
              "COL.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "COL 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ayant entendu parler de votre foi dans le christ Jésus et de l'amour que vous avez pour tous les saints,",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.4",
            "verseOrgIds": [
              "COL.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "COL 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "à cause de l'espérance qui vous est réservée dans les cieux et dont vous avez déjà entendu parler dans la parole de la vérité de l'évangile,",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.5",
            "verseOrgIds": [
              "COL.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "COL 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "qui est parvenu jusqu'à vous, comme aussi [il l'est] dans tout le monde, et qui porte du fruit et croît, comme aussi parmi vous, depuis le jour où vous avez entendu et connu la grâce de",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.6",
            "verseOrgIds": [
              "COL.1.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "COL.1.6",
                "verseOrgIds": [
                  "COL.1.6"
                ]
              }
            }
          ]
        },
        {
          "text": "en vérité,",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.6",
            "verseOrgIds": [
              "COL.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "COL 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "comme vous l'avez entendue d'Épaphras, notre bien-aimé compagnon de service",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.7",
            "verseOrgIds": [
              "COL.1.7"
            ]
          }
        },
        {
          "text": ", qui est un fidèle serviteur du Christ pour vous,",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.7",
            "verseOrgIds": [
              "COL.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "qui nous a aussi fait connaître votre amour dans l'Esprit.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.8",
            "verseOrgIds": [
              "COL.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "COL 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "C'est pourquoi nous aussi, depuis le jour où nous en avons entendu parler, nous ne cessons pas de prier et de demander pour vous que vous soyez remplis de la connaissance de sa volonté, en toute sagesse et intelligence spirituelle,",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.9",
            "verseOrgIds": [
              "COL.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "COL 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "pour marcher d'une manière digne du Seigneur pour lui plaire à tous égards, portant du fruit en toute bonne œuvre, et croissant par la connaissance de",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.10",
            "verseOrgIds": [
              "COL.1.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "COL.1.10",
                "verseOrgIds": [
                  "COL.1.10"
                ]
              }
            }
          ]
        },
        {
          "text": ":",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.10",
            "verseOrgIds": [
              "COL.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "COL 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "étant fortifiés en toute force, selon la puissance de sa gloire, pour toute patience et constance",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.11",
            "verseOrgIds": [
              "COL.1.11"
            ]
          }
        },
        {
          "text": ", avec joie,",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.11",
            "verseOrgIds": [
              "COL.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "COL 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "rendant grâces au Père qui nous a rendus capables",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.12",
            "verseOrgIds": [
              "COL.1.12"
            ]
          }
        },
        {
          "text": "de participer au lot des saints dans la lumière ;",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.12",
            "verseOrgIds": [
              "COL.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "COL 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "qui nous a délivrés du pouvoir des ténèbres, et nous a transportés dans le royaume du Fils de son amour,",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.13",
            "verseOrgIds": [
              "COL.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "COL 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "en qui nous avons la rédemption, la rémission des péchés ;",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.14",
            "verseOrgIds": [
              "COL.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "COL 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "qui est [l']image du",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.15",
            "verseOrgIds": [
              "COL.1.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "COL.1.15",
                "verseOrgIds": [
                  "COL.1.15"
                ]
              }
            }
          ]
        },
        {
          "text": "invisible, [le] premier-né de toute [la] création ;",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.15",
            "verseOrgIds": [
              "COL.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "COL 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "car par lui ont été créées toutes choses, les choses qui sont dans les cieux et les choses qui sont sur la terre, les visibles et les invisibles, soit trônes, ou seigneuries, ou principautés, ou autorités : toutes choses ont été créées par lui et pour lui ;",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.16",
            "verseOrgIds": [
              "COL.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "COL 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "et lui est avant toutes choses, et toutes choses subsistent par lui ;",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.17",
            "verseOrgIds": [
              "COL.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "COL 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "et il est le chef",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.18",
            "verseOrgIds": [
              "COL.1.18"
            ]
          }
        },
        {
          "text": "du corps, de l'assemblée, lui qui est [le] commencement, [le] premier-né d'entre les morts, afin qu'en toutes choses il tienne, lui, la première place ;",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.18",
            "verseOrgIds": [
              "COL.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "COL 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "car, en lui, toute la plénitude s'est plu à habiter,",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.19",
            "verseOrgIds": [
              "COL.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "COL 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "et, par lui, à réconcilier toutes choses avec elle-même",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.20",
            "verseOrgIds": [
              "COL.1.20"
            ]
          }
        },
        {
          "text": ", ayant fait la paix par le sang de sa croix, par lui, soit les choses qui sont sur la terre, soit les choses qui sont dans les cieux.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.20",
            "verseOrgIds": [
              "COL.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "COL 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et vous qui étiez autrefois étrangers et ennemis quant à votre entendement, dans les mauvaises œuvres,",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.21",
            "verseOrgIds": [
              "COL.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "COL 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "il vous a toutefois maintenant réconciliés dans",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.22",
            "verseOrgIds": [
              "COL.1.22"
            ]
          }
        },
        {
          "text": "le corps de sa chair, par la mort, pour vous présenter saints et irréprochables et irrépréhensibles devant lui,",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.22",
            "verseOrgIds": [
              "COL.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "COL 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "si du moins vous demeurez dans la foi, fondés et fermes, et ne vous laissant pas détourner de l'espérance de l'évangile que vous avez entendu, lequel a été prêché dans toute la création qui est sous le ciel, [et] duquel moi, Paul, je suis devenu serviteur.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.23",
            "verseOrgIds": [
              "COL.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "COL 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maintenant, je me réjouis dans les souffrances pour vous, et j'accomplis dans ma chair ce qui reste [encore à souffrir] des afflictions du Christ pour son corps qui est l'assemblée,",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.24",
            "verseOrgIds": [
              "COL.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "COL 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "de laquelle moi je suis devenu serviteur selon l'administration de",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.25",
            "verseOrgIds": [
              "COL.1.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "COL.1.25",
                "verseOrgIds": [
                  "COL.1.25"
                ]
              }
            }
          ]
        },
        {
          "text": "qui m'a été donnée envers vous, pour compléter la parole de",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.25",
            "verseOrgIds": [
              "COL.1.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "COL.1.25",
                "verseOrgIds": [
                  "COL.1.25"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.25",
            "verseOrgIds": [
              "COL.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "COL 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "[savoir] le mystère qui avait été caché dès les",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.26",
            "verseOrgIds": [
              "COL.1.26"
            ]
          }
        },
        {
