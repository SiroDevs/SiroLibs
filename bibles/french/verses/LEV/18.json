              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "afin que le pays ne vous vomisse pas, quand vous l'aurez rendu impur, comme il a vomi la nation qui y a été avant vous.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.28",
