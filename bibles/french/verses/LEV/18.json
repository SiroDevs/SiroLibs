          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car quiconque fera l'une de toutes ces abominations,… les âmes qui les pratiqueront, seront retranchées du milieu de leur peuple.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.29",
            "verseOrgIds": [
