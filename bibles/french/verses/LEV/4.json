                "verseOrgIds": [
                  "LEV.4.22"
                ]
              }
            }
          ]
        },
        {
          "text": ", son",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.22",
            "verseOrgIds": [
              "LEV.4.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "LEV.4.22",
                "verseOrgIds": [
                  "LEV.4.22"
                ]
              }
            }
          ]
        },
        {
          "text": ", ce qui ne doit pas se faire, et s'est rendu coupable,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.22",
            "verseOrgIds": [
              "LEV.4.22"
            ]
          }
        },
        {
