          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "si on lui a fait connaître son péché qu'il a commis, alors il amènera pour son offrande",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.23",
            "verseOrgIds": [
              "LEV.4.23"
            ]
          }
        },
        {
          "text": "un bouc, un mâle sans défaut ;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.23",
            "verseOrgIds": [
              "LEV.4.23"
            ]
          }
        },
        {
