                "verseId": "ISA.51.22",
                "verseOrgIds": [
                  "ISA.51.22"
                ]
              }
            }
          ]
        },
        {
          "text": ", et ton",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.22",
            "verseOrgIds": [
              "ISA.51.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "ISA.51.22",
                "verseOrgIds": [
                  "ISA.51.22"
                ]
              }
            }
          ]
        },
        {
          "text": "qui plaide la cause de son peuple : Voici, je prends de ta main la coupe d'étourdissement, le calice de la coupe de ma fureur ; tu n'en boiras plus désormais ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.22",
            "verseOrgIds": [
              "ISA.51.22"
            ]
          }
        },
