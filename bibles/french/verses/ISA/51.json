          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ainsi dit ton Seigneur, l'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.22",
            "verseOrgIds": [
              "ISA.51.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
