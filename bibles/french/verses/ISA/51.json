              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "et je la mets dans la main de ceux qui t'affligent, qui ont dit à ton âme : Courbe-toi, afin que nous passions ; et tu as mis ton corps",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.23",
            "verseOrgIds": [
              "ISA.51.23"
            ]
          }
        },
