          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "C'est pourquoi, écoute ceci, toi qui es affligée et ivre, mais non de vin :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.21",
            "verseOrgIds": [
              "ISA.51.21"
            ]
          }
        },
