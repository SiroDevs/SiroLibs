          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "[moi] qui dis à l'abîme : Sois sec, et je dessécherai tes fleuves ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.27",
            "verseOrgIds": [
              "ISA.44.27"
            ]
          }
