          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ainsi dit l'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.24",
            "verseOrgIds": [
              "ISA.44.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "ISA.44.24",
                "verseOrgIds": [
                  "ISA.44.24"
                ]
              }
            }
          ]
        },
        {
          "text": ", ton rédempteur, et celui qui t'a formé dès la matrice : C'est moi, l'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.24",
            "verseOrgIds": [
              "ISA.44.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "ISA.44.24",
                "verseOrgIds": [
                  "ISA.44.24"
                ]
              }
            }
          ]
        },
        {
          "text": ", qui ai fait toutes choses, qui seul ai déployé les cieux, et qui, par moi-même",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.24",
            "verseOrgIds": [
              "ISA.44.24"
            ]
          }
        },
        {
          "text": ", ai étendu la terre ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.24",
            "verseOrgIds": [
              "ISA.44.24"
            ]
          }
        },
