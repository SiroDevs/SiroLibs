                  "ISA.44.23"
                ]
              }
            }
          ]
        },
        {
          "text": "a racheté Jacob, et s'est glorifié en Israël.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.23",
            "verseOrgIds": [
              "ISA.44.23"
            ]
