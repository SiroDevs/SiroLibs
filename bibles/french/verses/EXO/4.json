                  "EXO.4.30"
                ]
              }
            }
          ]
        },
        {
          "text": "avait dites à Moïse, et fit les signes devant les yeux du peuple.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.30",
            "verseOrgIds": [
              "EXO.4.30"
            ]
