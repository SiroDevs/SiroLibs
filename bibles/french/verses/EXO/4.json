            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et il arriva, en chemin, dans le caravansérail, que l'",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.24",
            "verseOrgIds": [
              "EXO.4.24"
            ]
          }
        },
