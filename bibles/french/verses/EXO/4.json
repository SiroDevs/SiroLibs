          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et Moïse prit sa femme et ses fils, et les fit monter sur un âne, et retourna au pays d'Égypte. Et Moïse prit la verge de",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.20",
            "verseOrgIds": [
              "EXO.4.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.20",
                "verseOrgIds": [
                  "EXO.4.20"
                ]
              }
            }
          ]
        },
        {
          "text": "dans sa main.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.20",
            "verseOrgIds": [
              "EXO.4.20"
            ]
          }
        }
      ]
    },
    {
