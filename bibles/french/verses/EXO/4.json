          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et Moïse et Aaron allèrent, et assemblèrent tous les anciens des fils d'Israël ;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.29",
            "verseOrgIds": [
