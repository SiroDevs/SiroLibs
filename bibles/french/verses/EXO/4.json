          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et Moïse raconta à Aaron toutes les paroles de l'",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.28",
            "verseOrgIds": [
              "EXO.4.28"
            ]
          }
        },
