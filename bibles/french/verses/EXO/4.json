              "type": "text",
              "attrs": {
                "verseId": "EXO.4.28",
                "verseOrgIds": [
                  "EXO.4.28"
                ]
              }
            }
          ]
        },
        {
          "text": "qui l'avait envoyé, et tous les signes qu'il lui avait commandés.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.28",
            "verseOrgIds": [
              "EXO.4.28"
            ]
          }
