                "verseOrgIds": [
                  "EXO.6.29"
                ]
              }
            }
          ]
        },
        {
          "text": "; dis au Pharaon, roi d'Égypte, tout ce que je te dis.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.29",
            "verseOrgIds": [
              "EXO.6.29"
            ]
