          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "C'est là cet Aaron et ce Moïse auxquels l'",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.26",
            "verseOrgIds": [
              "EXO.6.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "EXO.6.26",
                "verseOrgIds": [
                  "EXO.6.26"
                ]
              }
            }
          ]
        },
        {
          "text": "dit : Faites sortir les fils d'Israël du pays d'Égypte, selon leurs armées.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.26",
            "verseOrgIds": [
              "EXO.6.26"
            ]
          }
        },
