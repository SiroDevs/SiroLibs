              "attrs": {
                "verseId": "EXO.6.28",
                "verseOrgIds": [
                  "EXO.6.28"
                ]
              }
            }
          ]
        },
        {
          "text": "parla à Moïse dans le pays d'Égypte,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.28",
            "verseOrgIds": [
              "EXO.6.28"
            ]
          }
        },
        {
