              "type": "text"
            }
          ]
        },
        {
          "text": "Et Moïse dit devant l'",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.30",
            "verseOrgIds": [
              "EXO.6.30"
            ]
          }
        },
