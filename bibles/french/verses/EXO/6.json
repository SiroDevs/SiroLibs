                "verseId": "EXO.6.29",
                "verseOrgIds": [
                  "EXO.6.29"
                ]
              }
            }
          ]
        },
        {
          "text": "parla à Moïse, disant : Je suis l'",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.29",
            "verseOrgIds": [
              "EXO.6.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
