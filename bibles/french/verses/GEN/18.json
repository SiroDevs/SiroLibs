              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et Abraham répondit et dit : Voici, je te prie, j'ai osé parler au Seigneur, moi qui suis poussière et cendre.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.27",
