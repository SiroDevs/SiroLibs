              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et il continua encore de lui parler, et dit : Peut-être s'y en trouvera-t-il 40 ? Et il dit : Je ne le ferai pas, à cause des 40.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.29",
            "verseOrgIds": [
              "GEN.18.29"
            ]
          }
