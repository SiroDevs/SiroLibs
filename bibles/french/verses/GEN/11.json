              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et Saraï était stérile, elle n'avait pas d'enfants.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.30",
            "verseOrgIds": [
              "GEN.11.30"
            ]
          }
