              "type": "text",
              "attrs": {
                "verseId": "EZK.34.30",
                "verseOrgIds": [
                  "EZK.34.30"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.30",
            "verseOrgIds": [
              "EZK.34.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
