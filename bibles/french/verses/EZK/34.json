          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et vous, mon troupeau, le troupeau de ma pâture, vous êtes des hommes ; moi, je suis votre",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.31",
            "verseOrgIds": [
