          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "*Et ce sont ici les issues de la ville : du côté du nord, une mesure de 4 500 [coudées] ;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.30",
