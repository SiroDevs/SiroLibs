          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et vers le côté de l'orient, 4 500, et trois portes : la porte de Joseph, une ; la porte de Benjamin, une ; la porte de Dan, une.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.32",
            "verseOrgIds": [
