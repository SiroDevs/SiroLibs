              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et toi, fils d'homme, au jour où je leur ôterai ce qui a été leur confiance",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.25",
            "verseOrgIds": [
              "EZK.24.25"
            ]
          }
        },
        {
          "text": ", la joie de leur ornement, le désir de leurs yeux, et ce que recherchent leurs âmes, leurs fils et leurs filles,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.25",
            "verseOrgIds": [
              "EZK.24.25"
            ]
          }
        },
