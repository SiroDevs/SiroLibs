              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "en ce jour-là celui qui sera réchappé ne viendra-t-il pas vers toi pour le faire entendre à tes oreilles ?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.26",
            "verseOrgIds": [
              "EZK.24.26"
            ]
          }
        },
