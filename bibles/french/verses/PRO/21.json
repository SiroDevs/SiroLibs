          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Le sacrifice des méchants est une abomination ; combien plus s'ils l'apportent avec une pensée mauvaise.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.27",
            "verseOrgIds": [
              "PRO.21.27"
            ]
          }
