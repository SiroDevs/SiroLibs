  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "JDG 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et Debora chanta, en ce jour-là, avec Barak, fils d'Abinoam, en disant :",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.1",
            "verseOrgIds": [
              "JDG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Parce que des chefs se sont mis en avant en Israël, parce que le peuple a été porté de bonne volonté, bénissez l'",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.2",
            "verseOrgIds": [
              "JDG.5.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JDG.5.2",
                "verseOrgIds": [
                  "JDG.5.2"
                ]
              }
            }
          ]
        },
        {
          "text": "!",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.2",
            "verseOrgIds": [
              "JDG.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rois, écoutez ! princes, prêtez l'oreille ! Moi, moi, je chanterai à l'",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.3",
            "verseOrgIds": [
              "JDG.5.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JDG.5.3",
                "verseOrgIds": [
                  "JDG.5.3"
                ]
              }
            }
          ]
        },
        {
          "text": "; je chanterai un hymne à l'",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.3",
            "verseOrgIds": [
              "JDG.5.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JDG.5.3",
                "verseOrgIds": [
                  "JDG.5.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", le",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.3",
            "verseOrgIds": [
              "JDG.5.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "JDG.5.3",
                "verseOrgIds": [
                  "JDG.5.3"
                ]
              }
            }
          ]
        },
        {
          "text": "d'Israël.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.3",
            "verseOrgIds": [
              "JDG.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JDG.5.4",
                "verseOrgIds": [
                  "JDG.5.4"
                ]
              }
            }
          ]
        },
        {
          "text": "! quand tu sortis de Séhir, quand tu t'avanças des champs d'Édom, la terre trembla, et les cieux distillèrent, et les nuées distillèrent des eaux.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.4",
            "verseOrgIds": [
              "JDG.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Les montagnes se fondirent devant l'",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.5",
            "verseOrgIds": [
              "JDG.5.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JDG.5.5",
                "verseOrgIds": [
                  "JDG.5.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", ce Sinaï, devant l'",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.5",
            "verseOrgIds": [
              "JDG.5.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JDG.5.5",
                "verseOrgIds": [
                  "JDG.5.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", le",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.5",
            "verseOrgIds": [
              "JDG.5.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "JDG.5.5",
                "verseOrgIds": [
                  "JDG.5.5"
                ]
              }
            }
          ]
        },
        {
          "text": "d'Israël.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.5",
            "verseOrgIds": [
              "JDG.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aux jours de Shamgar, fils d'Anath, aux jours de Jaël, les chemins étaient délaissés",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.6",
            "verseOrgIds": [
              "JDG.5.6"
            ]
          }
        },
        {
          "text": ", et ceux qui allaient par les grands chemins allaient par des sentiers détournés ;",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.6",
            "verseOrgIds": [
              "JDG.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Les villes ouvertes",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.7",
            "verseOrgIds": [
              "JDG.5.7"
            ]
          }
        },
        {
          "text": "étaient délaissées",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.7",
            "verseOrgIds": [
              "JDG.5.7"
            ]
          }
        },
        {
          "text": "en Israël, elles étaient délaissées, – jusqu'à ce que je me suis levée, moi Debora, jusqu'à ce que je me suis levée, une mère en Israël.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.7",
            "verseOrgIds": [
              "JDG.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "On choisissait de nouveaux dieux, alors la guerre était aux portes ! On ne voyait ni bouclier ni pique chez quarante milliers en Israël.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.8",
            "verseOrgIds": [
              "JDG.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mon cœur est aux gouverneurs d'Israël qui ont été portés de bonne volonté parmi le peuple. Bénissez l'",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.9",
            "verseOrgIds": [
              "JDG.5.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JDG.5.9",
                "verseOrgIds": [
                  "JDG.5.9"
                ]
              }
            }
          ]
        },
        {
          "text": "!",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.9",
            "verseOrgIds": [
              "JDG.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vous qui montez sur des ânesses blanches, vous qui êtes assis sur des tapis, et vous qui allez par les chemins, méditez",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.10",
            "verseOrgIds": [
              "JDG.5.10"
            ]
          }
        },
        {
          "text": "!",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.10",
            "verseOrgIds": [
              "JDG.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "À cause de la voix de ceux qui partagent [le butin], au milieu des lieux où l'on puise l'eau : là, ils racontent les justes actes de l'",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.11",
            "verseOrgIds": [
              "JDG.5.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JDG.5.11",
                "verseOrgIds": [
                  "JDG.5.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", ses justes actes envers ses villes ouvertes en Israël. Alors le peuple de l'",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.11",
            "verseOrgIds": [
              "JDG.5.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JDG.5.11",
                "verseOrgIds": [
                  "JDG.5.11"
                ]
              }
            }
          ]
        },
        {
          "text": "est descendu aux portes.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.11",
            "verseOrgIds": [
              "JDG.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Réveille-toi, réveille-toi, Debora ! Réveille-toi, réveille-toi, dis un cantique ! Lève-toi, Barak, et emmène captifs tes captifs",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.12",
            "verseOrgIds": [
              "JDG.5.12"
            ]
          }
        },
        {
          "text": ", fils d'Abinoam !",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.12",
            "verseOrgIds": [
              "JDG.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alors descends, toi, le résidu des nobles, [comme son] peuple ;",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.13",
            "verseOrgIds": [
              "JDG.5.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JDG.5.13",
                "verseOrgIds": [
                  "JDG.5.13"
                ]
              }
            }
          ]
        },
        {
          "text": "! descends avec moi au milieu des",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.13",
            "verseOrgIds": [
              "JDG.5.13"
            ]
          }
        },
        {
          "text": "hommes forts.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.13",
            "verseOrgIds": [
              "JDG.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "D'Éphraïm [sont venus] ceux dont la racine",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.14",
            "verseOrgIds": [
              "JDG.5.14"
            ]
          }
        },
        {
          "text": "est en",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.14",
            "verseOrgIds": [
              "JDG.5.14"
            ]
          }
        },
        {
          "text": "Amalek ; derrière toi [vient] Benjamin, au milieu de tes peuples. De Makir sont descendus les gouverneurs, et de Zabulon sont venus ceux qui tiennent le bâton du commandant.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.14",
            "verseOrgIds": [
              "JDG.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et les princes d'Issacar ont été avec Debora, et Issacar, comme Barak ; [il a été] envoyé sur ses pas dans la vallée. Aux divisions",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.15",
            "verseOrgIds": [
              "JDG.5.15"
            ]
          }
        },
        {
          "text": "de Ruben, grandes considérations de cœur !",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.15",
            "verseOrgIds": [
              "JDG.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pourquoi es-tu resté entre les barres des étables, à écouter le bêlement des troupeaux ? Aux divisions",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.16",
            "verseOrgIds": [
              "JDG.5.16"
            ]
          }
        },
        {
          "text": "de Ruben, grandes délibérations de cœur !",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.16",
            "verseOrgIds": [
              "JDG.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Galaad est demeuré au-delà du Jourdain ; et Dan, pourquoi a-t-il séjourné sur les navires ? Aser est resté au bord de la mer",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.17",
            "verseOrgIds": [
              "JDG.5.17"
            ]
          }
        },
        {
          "text": ", et il est demeuré dans ses ports.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.17",
            "verseOrgIds": [
              "JDG.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zabulon est un peuple qui a exposé son âme à la mort, Nephthali aussi, sur les hauteurs des champs.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.18",
            "verseOrgIds": [
              "JDG.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Les rois sont venus, ils ont combattu ; alors les rois de Canaan ont combattu à Thaanac, près des eaux de Meguiddo ; [mais], de butin d'argent, ils n'en ont pas emporté.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.19",
            "verseOrgIds": [
              "JDG.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "On a combattu des cieux ; du chemin qu'elles parcourent, les étoiles ont combattu contre Sisera.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.20",
            "verseOrgIds": [
              "JDG.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Le torrent de Kison les a emportés, le torrent des anciens temps",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.21",
            "verseOrgIds": [
              "JDG.5.21"
            ]
          }
        },
        {
          "text": ", le torrent de Kison. Mon âme, tu as foulé aux pieds la force !",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.21",
            "verseOrgIds": [
              "JDG.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alors les talons des chevaux battirent [le sol] à cause de la course rapide, de la course rapide de leurs [hommes] vaillants.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.22",
            "verseOrgIds": [
              "JDG.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maudissez Méroz, dit l'Ange de l'",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.23",
            "verseOrgIds": [
              "JDG.5.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JDG.5.23",
                "verseOrgIds": [
                  "JDG.5.23"
                ]
              }
            }
          ]
        },
        {
          "text": "; maudissez, maudissez ses habitants ! car ils ne sont pas venus au secours de l'",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.23",
            "verseOrgIds": [
              "JDG.5.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JDG.5.23",
                "verseOrgIds": [
                  "JDG.5.23"
                ]
              }
            }
          ]
        },
        {
          "text": ", au secours de l'",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.23",
            "verseOrgIds": [
              "JDG.5.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JDG.5.23",
                "verseOrgIds": [
                  "JDG.5.23"
                ]
              }
            }
          ]
        },
        {
          "text": ", avec les hommes forts.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.23",
            "verseOrgIds": [
              "JDG.5.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bénie soit, au-dessus des femmes, Jaël, femme de Héber, le Kénien ! Qu'elle soit bénie au-dessus des femmes qui se tiennent dans les tentes !",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.24",
            "verseOrgIds": [
              "JDG.5.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Il a demandé de l'eau, elle lui a donné du lait ; dans la coupe des nobles elle lui a présenté du caillé.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.25",
            "verseOrgIds": [
              "JDG.5.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elle a étendu sa main vers le pieu, et sa droite vers le marteau des ouvriers ; elle a frappé Sisera, elle lui a brisé la tête, elle lui a fracassé et transpercé la tempe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.26",
            "verseOrgIds": [
              "JDG.5.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entre ses pieds il s'est courbé, il est tombé, il s'est étendu [par terre] ; entre ses pieds il s'est courbé, il est tombé ; là où il s'est courbé, là il est tombé anéanti.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.27",
            "verseOrgIds": [
              "JDG.5.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "La mère de Sisera regarde par la fenêtre, et s'écrie à travers le treillis : Pourquoi son char tarde-t-il à venir ? Pourquoi la marche de ses chars est-elle si lente ?",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.28",
            "verseOrgIds": [
              "JDG.5.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Les sages d'entre ses princesses lui répondent ; elle s'est donné la réponse à elle-même.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.29",
            "verseOrgIds": [
              "JDG.5.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ont-ils pas trouvé, n'ont-ils pas divisé le butin ? Une jeune fille, deux jeunes filles par tête d'homme ; du butin de vêtements de couleur pour Sisera, du butin de vêtements de couleur brodés, deux vêtements de couleur brodés, pour le cou des captives",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.30",
            "verseOrgIds": [
              "JDG.5.30"
            ]
          }
        },
        {
          "text": "!",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.30",
            "verseOrgIds": [
              "JDG.5.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qu'ainsi périssent tous tes ennemis, ô",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.31",
            "verseOrgIds": [
              "JDG.5.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JDG.5.31",
                "verseOrgIds": [
                  "JDG.5.31"
                ]
              }
            }
          ]
        },
        {
          "text": "! mais que ceux qui t'aiment soient comme le soleil quand il sort dans sa force !",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.31",
            "verseOrgIds": [
              "JDG.5.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 5:31"
      },
      "items": [
        {
          "text": "Et le pays fut en repos 40 ans.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.31",
            "verseOrgIds": [
              "JDG.5.31"
            ]
          }
        }
      ]
    }
  ],
