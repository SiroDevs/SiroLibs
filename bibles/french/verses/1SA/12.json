          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seulement, craignez l'",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.24",
            "verseOrgIds": [
              "1SA.12.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
