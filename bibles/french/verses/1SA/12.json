          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car l'",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.22",
            "verseOrgIds": [
              "1SA.12.22"
            ]
          }
        },
