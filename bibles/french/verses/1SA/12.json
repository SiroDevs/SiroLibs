          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'est-ce pas aujourd'hui la moisson des froments ? Je crierai à l'",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.17",
            "verseOrgIds": [
              "1SA.12.17"
            ]
          }
        },
        {
