              "attrs": {
                "verseId": "1SA.12.20",
                "verseOrgIds": [
                  "1SA.12.20"
                ]
              }
            }
          ]
        },
        {
          "text": ", et servez l'",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.20",
            "verseOrgIds": [
              "1SA.12.20"
            ]
          }
        },
