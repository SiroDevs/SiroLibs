              "attrs": {
                "verseId": "1SA.12.17",
                "verseOrgIds": [
                  "1SA.12.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", et il enverra des tonnerres et de la pluie ; et vous saurez et vous verrez que le mal que vous avez fait est grand aux yeux de l'",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.17",
            "verseOrgIds": [
