                "verseOrgIds": [
                  "NEH.12.36"
                ]
              }
            }
          ]
        },
        {
          "text": "; et Esdras, le scribe, devant eux.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.36",
            "verseOrgIds": [
              "NEH.12.36"
            ]
