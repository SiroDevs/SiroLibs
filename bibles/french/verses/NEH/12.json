          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "et au-dessus de la porte d'Éphraïm, et près de la porte du vieux [mur], et de la porte des poissons, et de la tour de Hananeël, et de la tour de Méa, jusqu'à la porte des brebis ; et ils s'arrêtèrent à la porte de la prison.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.39",
            "verseOrgIds": [
              "NEH.12.39"
            ]
          }
        }
      ]
    },
    {
