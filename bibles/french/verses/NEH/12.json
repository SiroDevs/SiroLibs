        },
        {
          "text": "et des fils des sacrificateurs avec des trompettes : Zacharie, fils de Jonathan, fils de Shemahia, fils de Matthania, fils de Michée, fils de Zaccur, fils d'Asaph,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.35",
            "verseOrgIds": [
              "NEH.12.35"
            ]
