              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "NEH.12.43",
                "verseOrgIds": [
                  "NEH.12.43"
                ]
              }
            }
          ]
        },
        {
          "text": "les avait réjouis d'une grande joie ; et les femmes aussi et les enfants se réjouirent ; et la joie de Jérusalem s'entendait au loin.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.43",
            "verseOrgIds": [
              "NEH.12.43"
            ]
          }
        }
