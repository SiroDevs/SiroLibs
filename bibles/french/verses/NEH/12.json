          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "et les sacrificateurs Éliakim, Maascéïa, Minjamin, Michée, Élioénaï, Zacharie, Hanania, avec des trompettes ;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.41",
            "verseOrgIds": [
              "NEH.12.41"
            ]
          }
        },
