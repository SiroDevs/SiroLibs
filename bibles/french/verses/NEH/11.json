          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lod et Ono, la vallée des artisans.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.35",
            "verseOrgIds": [
              "NEH.11.35"
            ]
          }
        },
        {
