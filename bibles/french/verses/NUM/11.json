{
  "id": "NUM.11",
  "number": "11",
  "bookId": "NUM",
  "reference": "Nombres 11",
  "copyright": "Texte libre de droits",
  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "NUM 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "*Et il arriva que comme le peuple se plaignait, cela fut mauvais aux oreilles de l'",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.1",
            "verseOrgIds": [
              "NUM.11.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.1",
                "verseOrgIds": [
                  "NUM.11.1"
                ]
              }
            }
          ]
        },
        {
          "text": "; et l'",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.1",
            "verseOrgIds": [
              "NUM.11.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.1",
                "verseOrgIds": [
                  "NUM.11.1"
                ]
              }
            }
          ]
        },
        {
          "text": "l'entendit, et sa colère s'embrasa, et le feu de l'",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.1",
            "verseOrgIds": [
              "NUM.11.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.1",
                "verseOrgIds": [
                  "NUM.11.1"
                ]
              }
            }
          ]
        },
        {
          "text": "brûla parmi eux, et dévora au bout du camp.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.1",
            "verseOrgIds": [
              "NUM.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et le peuple cria à Moïse, et Moïse pria l'",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.2",
            "verseOrgIds": [
              "NUM.11.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.2",
                "verseOrgIds": [
                  "NUM.11.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", et le feu s'éteignit.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.2",
            "verseOrgIds": [
              "NUM.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et on appela le nom de ce lieu Tabhéra",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.3",
            "verseOrgIds": [
              "NUM.11.3"
            ]
          }
        },
        {
          "text": ", parce que le feu de l'",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.3",
            "verseOrgIds": [
              "NUM.11.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.3",
                "verseOrgIds": [
                  "NUM.11.3"
                ]
              }
            }
          ]
        },
        {
          "text": "avait brûlé parmi eux.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.3",
            "verseOrgIds": [
              "NUM.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "*Et le ramassis [de peuple] qui était au milieu d'eux s'éprit de convoitise, et les fils d'Israël aussi se mirent encore à pleurer, et dirent : Qui nous fera manger de la chair ?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.4",
            "verseOrgIds": [
              "NUM.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Il nous souvient du poisson que nous mangions en Égypte pour rien, des concombres, et des melons, et des poireaux, et des oignons, et de l'ail ;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.5",
            "verseOrgIds": [
              "NUM.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "et maintenant notre âme est asséchée ; il n'y a rien, si ce n'est cette manne devant nos yeux.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.6",
            "verseOrgIds": [
              "NUM.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "– Et la manne était comme la graine de coriandre, et son apparence comme l'apparence du bdellium.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.7",
            "verseOrgIds": [
              "NUM.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Le peuple se dispersait et la ramassait ; et ils la broyaient sous la meule ou la pilaient dans le mortier ; et ils la cuisaient dans des pots, et en faisaient des gâteaux ; et son goût était comme le goût d'un gâteau à l'huile",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.8",
            "verseOrgIds": [
              "NUM.11.8"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.8",
            "verseOrgIds": [
              "NUM.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et quand la rosée descendait la nuit sur le camp la manne descendait dessus.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.9",
            "verseOrgIds": [
              "NUM.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et Moïse entendit le peuple pleurant, selon ses familles, chacun à l'entrée de sa tente ; et la colère de l'",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.10",
            "verseOrgIds": [
              "NUM.11.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.10",
                "verseOrgIds": [
                  "NUM.11.10"
                ]
              }
            }
          ]
        },
        {
          "text": "s'embrasa extrêmement, et cela fut mauvais aux yeux de Moïse.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.10",
            "verseOrgIds": [
              "NUM.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et Moïse dit à l'",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.11",
            "verseOrgIds": [
              "NUM.11.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.11",
                "verseOrgIds": [
                  "NUM.11.11"
                ]
              }
            }
          ]
        },
        {
          "text": ": Pourquoi as-tu fait ce mal à ton serviteur ? et pourquoi n'ai-je pas trouvé grâce à tes yeux, que tu aies mis sur moi le fardeau de tout ce peuple ?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.11",
            "verseOrgIds": [
              "NUM.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Est-ce moi qui ai conçu tout ce peuple ? Est-ce moi qui l'ai enfanté, pour que tu me dises : Porte-le dans ton sein, comme le nourricier porte l'enfant qui tète, jusqu'au pays que tu as promis par serment à ses pères ?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.12",
            "verseOrgIds": [
              "NUM.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "D'où aurais-je de la chair pour en donner à tout ce peuple ? car ils pleurent après moi, disant : Donne-nous de la chair, afin que nous en mangions.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.13",
            "verseOrgIds": [
              "NUM.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je ne puis, moi seul, porter tout ce peuple, car il est trop pesant pour moi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.14",
            "verseOrgIds": [
              "NUM.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et si tu agis ainsi avec moi, tue-moi donc, je te prie, si j'ai trouvé grâce à tes yeux, et que je ne voie pas mon malheur.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.15",
            "verseOrgIds": [
              "NUM.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et l'",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.16",
            "verseOrgIds": [
              "NUM.11.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.16",
                "verseOrgIds": [
                  "NUM.11.16"
                ]
              }
            }
          ]
        },
        {
          "text": "dit à Moïse : Assemble-moi 70 hommes des anciens d'Israël, que tu sais être les anciens du peuple et ses magistrats",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.16",
            "verseOrgIds": [
              "NUM.11.16"
            ]
          }
        },
        {
          "text": ", et amène-les à la tente d'assignation, et ils se tiendront là avec toi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.16",
            "verseOrgIds": [
              "NUM.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et je descendrai, et je parlerai là avec toi, et j'ôterai de l'Esprit qui est sur toi, et je le mettrai sur eux, afin qu'ils portent avec toi le fardeau du peuple, et que tu ne le portes pas toi seul.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.17",
            "verseOrgIds": [
              "NUM.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et tu diras au peuple : Sanctifiez-vous pour demain, et vous mangerez de la chair ; car vous avez pleuré aux oreilles de l'",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.18",
            "verseOrgIds": [
              "NUM.11.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.18",
                "verseOrgIds": [
                  "NUM.11.18"
                ]
              }
            }
          ]
        },
        {
          "text": ", disant : Qui nous fera manger de la chair ? car nous étions bien en Égypte ! Et l'",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.18",
            "verseOrgIds": [
              "NUM.11.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.18",
                "verseOrgIds": [
                  "NUM.11.18"
                ]
              }
            }
          ]
        },
        {
          "text": "vous donnera de la chair, et vous en mangerez.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.18",
            "verseOrgIds": [
              "NUM.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vous n'en mangerez pas un jour, ni deux jours, ni cinq jours, ni dix jours, ni 20 jours,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.19",
            "verseOrgIds": [
              "NUM.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "[mais] jusqu'à un mois entier, jusqu'à ce qu'elle vous sorte par les narines et que vous l'ayez en dégoût ; parce que vous avez méprisé l'",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.20",
            "verseOrgIds": [
              "NUM.11.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.20",
                "verseOrgIds": [
                  "NUM.11.20"
                ]
              }
            }
          ]
        },
        {
          "text": "qui est au milieu de vous, et que vous avez pleuré devant lui, disant : Pourquoi sommes-nous donc sortis d'Égypte ?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.20",
            "verseOrgIds": [
              "NUM.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et Moïse dit : Il y a 600 000 hommes de pied dans ce peuple au milieu duquel je suis, et tu as dit : Je leur donnerai de la chair, et ils en mangeront un mois entier.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.21",
            "verseOrgIds": [
              "NUM.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leur égorgera-t-on du menu et du gros bétail, afin qu'il y en ait assez pour eux ? ou assemblera-t-on tous les poissons de la mer pour eux, afin qu'il y en ait assez pour eux ?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.22",
            "verseOrgIds": [
              "NUM.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et l'",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.23",
            "verseOrgIds": [
              "NUM.11.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.23",
                "verseOrgIds": [
                  "NUM.11.23"
                ]
              }
            }
          ]
        },
        {
          "text": "dit à Moïse : La main de l'",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.23",
            "verseOrgIds": [
              "NUM.11.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.23",
                "verseOrgIds": [
                  "NUM.11.23"
                ]
              }
            }
          ]
        },
        {
          "text": "est-elle devenue courte ? Tu verras maintenant si ce que j'ai dit t'arrivera ou non.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.23",
            "verseOrgIds": [
              "NUM.11.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et Moïse sortit, et dit au peuple les paroles de l'",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.24",
            "verseOrgIds": [
              "NUM.11.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.24",
                "verseOrgIds": [
                  "NUM.11.24"
                ]
              }
            }
          ]
        },
        {
          "text": "; et il assembla 70 hommes des anciens du peuple, et les fit se tenir tout autour de la tente.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.24",
            "verseOrgIds": [
              "NUM.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et l'",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.25",
            "verseOrgIds": [
              "NUM.11.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.25",
                "verseOrgIds": [
                  "NUM.11.25"
                ]
              }
            }
          ]
        },
        {
          "text": "descendit dans la nuée, et lui parla ; et il ôta de l'Esprit qui était sur lui, et le mit sur les 70 anciens. Et il arriva qu'aussitôt que l'Esprit reposa sur eux, ils prophétisèrent, mais ils ne continuèrent pas.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.25",
            "verseOrgIds": [
              "NUM.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et il était demeuré deux hommes dans le camp ; le nom de l'un était Eldad, et le nom du second, Médad ; et l'Esprit reposa sur eux ; et ils étaient de ceux qui avaient été inscrits, mais ils n'étaient pas sortis vers la tente, et ils prophétisèrent dans le camp.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.26",
            "verseOrgIds": [
              "NUM.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et un jeune homme courut et rapporta cela à Moïse, disant : Eldad et Médad prophétisent dans le camp.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.27",
            "verseOrgIds": [
              "NUM.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et Josué, fils de Nun, qui servait Moïse, l'un de ses jeunes gens",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.28",
            "verseOrgIds": [
              "NUM.11.28"
            ]
          }
        },
        {
          "text": ", répondit et dit : Mon seigneur Moïse, empêche-les.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.28",
            "verseOrgIds": [
              "NUM.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et Moïse lui dit : Es-tu jaloux pour moi ? Ah ! que plutôt tout le peuple de l'",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.29",
            "verseOrgIds": [
              "NUM.11.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.29",
                "verseOrgIds": [
                  "NUM.11.29"
                ]
              }
            }
          ]
        },
        {
          "text": "soit prophète ; que l'",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.29",
            "verseOrgIds": [
              "NUM.11.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.29",
                "verseOrgIds": [
                  "NUM.11.29"
                ]
              }
            }
          ]
        },
        {
          "text": "mette son Esprit sur eux !",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.29",
            "verseOrgIds": [
              "NUM.11.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et Moïse revint dans le camp, lui et les anciens d'Israël.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.30",
            "verseOrgIds": [
              "NUM.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et il se leva, de par l'",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.31",
            "verseOrgIds": [
              "NUM.11.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.31",
                "verseOrgIds": [
                  "NUM.11.31"
                ]
              }
            }
          ]
        },
        {
          "text": ", un vent qui fit venir de la mer",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.31",
            "verseOrgIds": [
              "NUM.11.31"
            ]
          }
        },
        {
          "text": "des cailles, et les jeta sur le camp, environ une journée de chemin en deçà, et environ une journée de chemin en delà, tout autour du camp, et environ deux coudées sur la surface de la terre.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.31",
            "verseOrgIds": [
              "NUM.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et le peuple se leva tout ce jour-là, et toute la nuit, et tout le jour du lendemain, et amassa des cailles : celui qui en avait amassé le moins, en avait amassé dix khomers ; et ils les étendirent pour eux tout autour du camp.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.32",
            "verseOrgIds": [
              "NUM.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "– La chair était encore entre leurs dents, avant qu'elle soit mâchée, que la colère de l'",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.33",
            "verseOrgIds": [
              "NUM.11.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.33",
                "verseOrgIds": [
                  "NUM.11.33"
                ]
              }
            }
          ]
        },
        {
          "text": "s'embrasa contre le peuple, et que l'",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.33",
            "verseOrgIds": [
              "NUM.11.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "NUM.11.33",
                "verseOrgIds": [
                  "NUM.11.33"
                ]
              }
            }
          ]
        },
        {
          "text": "frappa le peuple d'un fort grand coup.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.33",
            "verseOrgIds": [
              "NUM.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et on appela le nom de ce lieu-là Kibroth-Hattaava",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.34",
            "verseOrgIds": [
              "NUM.11.34"
            ]
          }
        },
        {
          "text": ", parce qu'on y enterra le peuple qui avait convoité.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.34",
            "verseOrgIds": [
              "NUM.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "De Kibroth-Hattaava le peuple partit pour Hatséroth, et ils furent à Hatséroth.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.35",
            "verseOrgIds": [
              "NUM.11.35"
            ]
          }
        }
      ]
    }
  ],
