              "attrs": {
                "verseId": "DEU.7.25",
                "verseOrgIds": [
                  "DEU.7.25"
                ]
              }
            }
          ]
        },
        {
          "text": ", ton",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.25",
            "verseOrgIds": [
              "DEU.7.25"
            ]
          }
        },
