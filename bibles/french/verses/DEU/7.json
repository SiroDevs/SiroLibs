          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.25",
            "verseOrgIds": [
              "DEU.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
