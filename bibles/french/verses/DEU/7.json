          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne les crains point ; souviens-toi de ce que l'",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.18",
            "verseOrgIds": [
              "DEU.7.18"
            ]
          }
        },
