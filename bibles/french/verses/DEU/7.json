          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et l'",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.20",
            "verseOrgIds": [
              "DEU.7.20"
            ]
          }
        },
        {
