          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si tu dis dans ton cœur : Ces nations sont plus nombreuses que moi, comment pourrai-je les déposséder ?",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.17",
            "verseOrgIds": [
