          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Quand l'",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.1",
            "verseOrgIds": [
              "DEU.19.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "DEU.19.1",
                "verseOrgIds": [
                  "DEU.19.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", ton",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.1",
            "verseOrgIds": [
              "DEU.19.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "DEU.19.1",
                "verseOrgIds": [
                  "DEU.19.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", aura retranché les nations dont l'",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.1",
            "verseOrgIds": [
              "DEU.19.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "DEU.19.1",
                "verseOrgIds": [
                  "DEU.19.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", ton",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.1",
            "verseOrgIds": [
              "DEU.19.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "DEU.19.1",
                "verseOrgIds": [
                  "DEU.19.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", te donne le pays, et que tu les auras dépossédées, et que tu habiteras dans leurs villes et dans leurs maisons,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.1",
            "verseOrgIds": [
              "DEU.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "tu sépareras pour toi trois villes au milieu de ton pays que l'",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.2",
            "verseOrgIds": [
              "DEU.19.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "DEU.19.2",
                "verseOrgIds": [
                  "DEU.19.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", ton",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.2",
            "verseOrgIds": [
              "DEU.19.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "DEU.19.2",
                "verseOrgIds": [
                  "DEU.19.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", te donne pour le posséder :",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.2",
            "verseOrgIds": [
              "DEU.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "tu t'en prépareras le chemin, et tu diviseras en trois parties le territoire de ton pays que l'",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.3",
            "verseOrgIds": [
              "DEU.19.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "DEU.19.3",
                "verseOrgIds": [
                  "DEU.19.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", ton",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.3",
            "verseOrgIds": [
              "DEU.19.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "DEU.19.3",
                "verseOrgIds": [
                  "DEU.19.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", te donne en héritage ; et ce sera afin que tout homicide s'y enfuie.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.3",
            "verseOrgIds": [
              "DEU.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et voici ce qui concerne l'homicide qui s'y enfuira, pour qu'il vive : Celui qui aura frappé son prochain sans le savoir, et sans l'avoir haï auparavant,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.4",
            "verseOrgIds": [
              "DEU.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "comme si quelqu'un va avec son prochain dans la forêt pour couper du bois, et que sa main lève la hache pour couper l'arbre, et que le fer échappe du manche et atteigne son prochain, et qu'il meure : il s'enfuira dans une de ces villes, et il vivra ;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.5",
            "verseOrgIds": [
              "DEU.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "de peur que le vengeur du sang ne poursuive l'homicide pendant que son cœur est échauffé, et qu'il ne l'atteigne, parce que le chemin est long, et ne le frappe à mort, quoiqu'il ne mérite pas la mort",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.6",
            "verseOrgIds": [
              "DEU.19.6"
            ]
          }
        },
        {
          "text": ", car il ne le haïssait pas auparavant.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.6",
            "verseOrgIds": [
              "DEU.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "C'est pourquoi, je te commande, disant : Sépare-toi trois villes.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.7",
            "verseOrgIds": [
              "DEU.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et si l'",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.8",
            "verseOrgIds": [
              "DEU.19.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "DEU.19.8",
                "verseOrgIds": [
                  "DEU.19.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", ton",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.8",
            "verseOrgIds": [
              "DEU.19.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "DEU.19.8",
                "verseOrgIds": [
                  "DEU.19.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", étend tes limites, comme il l'a juré à tes pères, et qu'il te donne tout le pays qu'il a promis de donner à tes pères,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.8",
            "verseOrgIds": [
              "DEU.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "parce que tu auras gardé tout ce commandement que je te commande aujourd'hui, pour le pratiquer, en aimant l'",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.9",
            "verseOrgIds": [
              "DEU.19.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "DEU.19.9",
                "verseOrgIds": [
                  "DEU.19.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", ton",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.9",
            "verseOrgIds": [
              "DEU.19.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "DEU.19.9",
                "verseOrgIds": [
                  "DEU.19.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", et en marchant toujours dans ses voies, alors tu t'ajouteras encore trois villes à ces trois-là,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.9",
            "verseOrgIds": [
              "DEU.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "afin que le sang innocent ne soit pas versé au milieu de ton pays, que l'",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.10",
            "verseOrgIds": [
              "DEU.19.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "DEU.19.10",
                "verseOrgIds": [
                  "DEU.19.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", ton",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.10",
            "verseOrgIds": [
              "DEU.19.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "DEU.19.10",
                "verseOrgIds": [
                  "DEU.19.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", te donne en héritage, et qu'ainsi le sang ne soit pas sur toi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.10",
            "verseOrgIds": [
              "DEU.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mais si un homme hait son prochain, et lui dresse une embûche, et se lève contre lui et le frappe à mort, en sorte qu'il meure, et qu'il s'enfuie dans l'une de ces villes,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.11",
            "verseOrgIds": [
              "DEU.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "alors les anciens de sa ville enverront et le prendront de là, et le livreront en la main du vengeur du sang ; et il mourra.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.12",
            "verseOrgIds": [
              "DEU.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ton œil ne l'épargnera point, et tu ôteras d'Israël le sang innocent, et tu prospéreras.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.13",
            "verseOrgIds": [
              "DEU.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tu ne reculeras point les bornes de ton prochain, que des prédécesseurs auront fixées dans ton héritage lequel tu hériteras dans le pays que l'",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.14",
            "verseOrgIds": [
              "DEU.19.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "DEU.19.14",
                "verseOrgIds": [
                  "DEU.19.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", ton",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.14",
            "verseOrgIds": [
              "DEU.19.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "DEU.19.14",
                "verseOrgIds": [
                  "DEU.19.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", te donne pour le posséder.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.14",
            "verseOrgIds": [
              "DEU.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Un seul témoin ne se lèvera pas contre un homme, pour une iniquité ou un péché quelconque, quelque péché qu'il ait commis",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.15",
            "verseOrgIds": [
              "DEU.19.15"
            ]
          }
        },
        {
          "text": ": sur la déposition de deux témoins ou sur la déposition de trois témoins, la chose sera établie.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.15",
            "verseOrgIds": [
              "DEU.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Quand un témoin inique",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.16",
            "verseOrgIds": [
              "DEU.19.16"
            ]
          }
        },
        {
          "text": "s'élèvera contre un homme, pour témoigner contre lui d'un crime,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.16",
            "verseOrgIds": [
              "DEU.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "alors les deux hommes qui ont le différend, comparaîtront devant l'",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.17",
            "verseOrgIds": [
              "DEU.19.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "DEU.19.17",
                "verseOrgIds": [
                  "DEU.19.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", devant les sacrificateurs et les juges qu'il y aura en ces jours-là ;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.17",
            "verseOrgIds": [
              "DEU.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "et les juges rechercheront bien, et, si",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.18",
            "verseOrgIds": [
              "DEU.19.18"
            ]
          }
        },
        {
          "text": "le témoin est un faux témoin, s'il a témoigné faussement contre son frère,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.18",
            "verseOrgIds": [
              "DEU.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "alors vous lui ferez comme il pensait faire à son frère ; et tu ôteras le mal du milieu de toi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.19",
            "verseOrgIds": [
              "DEU.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et les autres l'entendront et craindront, et ne feront plus désormais une pareille méchante action au milieu de toi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.20",
            "verseOrgIds": [
              "DEU.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et ton œil n'épargnera point : vie pour vie, œil pour œil, dent pour dent, main pour main, pied pour pied.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.21",
            "verseOrgIds": [
              "DEU.19.21"
            ]
          }
        }
      ]
