              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Il m'a semblé bon de faire connaître les signes et les prodiges que le",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.32",
            "verseOrgIds": [
              "DAN.3.32"
            ]
          }
        },
