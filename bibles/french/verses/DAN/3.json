                "verseOrgIds": [
                  "DAN.3.29"
                ]
              }
            }
          ]
        },
        {
          "text": "qui puisse sauver ainsi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.29",
            "verseOrgIds": [
              "DAN.3.29"
            ]
          }
        },
