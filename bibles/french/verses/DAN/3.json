              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et de par moi l'ordre est donné qu'en tout peuple, peuplade, et langue, quiconque parlera mal du",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.29",
            "verseOrgIds": [
              "DAN.3.29"
            ]
          }
        },
