            }
          ]
        },
        {
          "text": "Y en aquel tiempo Josué les",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.26",
            "verseOrgIds": [
              "JOS.6.26"
            ]
          }
        },
        {
          "text": "juramentó diciendo:",
