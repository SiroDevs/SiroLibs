          "attrs": {
            "verseId": "JOS.6.26",
            "verseOrgIds": [
              "JOS.6.26"
            ]
          }
        },
        {
          "text": "Maldito delante de Jehová el hombre que se levantare y reedificare esta ciudad de Jericó. En su primogénito eche sus cimientos, y en su menor asiente sus puertas.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.26",
            "verseOrgIds": [
              "JOS.6.26"
            ]
          }
        }
      ]
