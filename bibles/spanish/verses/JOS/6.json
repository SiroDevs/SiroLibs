          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y los mancebos espías entraron, y sacaron á Rahab,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.23",
            "verseOrgIds": [
              "JOS.6.23"
            ]
          }
        },
        {
          "text": "y á su padre, y á su madre, y á sus hermanos, y todo lo que era suyo; y también sacaron á toda su parentela, y pusiéronlos fuera del campo de Israel.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.23",
            "verseOrgIds": [
              "JOS.6.23"
            ]
          }
        }
      ]
    },
