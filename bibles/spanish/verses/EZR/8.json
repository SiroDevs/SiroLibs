            "verseOrgIds": [
              "EZR.8.28"
            ]
          }
        },
        {
          "text": "y la plata y el oro ofrenda voluntaria á Jehová, Dios de nuestros padres.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.28",
            "verseOrgIds": [
              "EZR.8.28"
            ]
          }
