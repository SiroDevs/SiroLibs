          "attrs": {
            "verseId": "EZR.8.33",
            "verseOrgIds": [
              "EZR.8.33"
            ]
          }
        },
        {
          "text": "pesada la plata, y el oro, y los vasos, en la casa de nuestro Dios, por mano de",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.33",
            "verseOrgIds": [
              "EZR.8.33"
            ]
          }
        },
        {
          "text": "Meremoth hijo de Urías sacerdote, y con él Eleazar hijo de Phinees; y con ellos",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.33",
            "verseOrgIds": [
              "EZR.8.33"
            ]
          }
        },
        {
          "text": "Jozabad hijo de Jesuá, y Noadías hijo de Binnui, Levitas;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.33",
            "verseOrgIds": [
              "EZR.8.33"
            ]
          }
        }
