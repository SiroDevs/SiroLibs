              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayunamos pues, y pedimos á nuestro Dios sobre esto, y él nos",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.23",
            "verseOrgIds": [
              "EZR.8.23"
            ]
          }
        },
        {
          "text": "fué propicio.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.23",
            "verseOrgIds": [
              "EZR.8.23"
            ]
          }
        }
      ]
    },
