          "attrs": {
            "verseId": "JER.38.28",
            "verseOrgIds": [
              "JER.38.28"
            ]
          }
        },
        {
          "text": "quedó Jeremías",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.28",
            "verseOrgIds": [
              "JER.38.28"
            ]
          }
        },
        {
          "text": "en el patio de la cárcel hasta el día que fué tomada Jerusalem; y",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.28",
            "verseOrgIds": [
              "JER.38.28"
            ]
          }
        },
