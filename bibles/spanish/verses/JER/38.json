                "verseId": "JER.38.28",
                "verseOrgIds": [
                  "JER.38.28"
                ]
              }
            }
          ]
        },
        {
          "text": "estaba cuando Jerusalem fué tomada.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.28",
