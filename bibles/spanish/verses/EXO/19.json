              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y Moisés dijo á Jehová: El pueblo no podrá subir al monte de Sinaí, porque tú nos has requerido diciendo:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.23",
            "verseOrgIds": [
              "EXO.19.23"
            ]
          }
        },
        {
          "text": "Señala términos al monte, y santifícalo.",
          "type": "text",
          "attrs": {
