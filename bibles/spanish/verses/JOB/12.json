{
  "id": "JOB.12",
  "number": "12",
  "bookId": "JOB",
  "reference": "Job 12",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "JOB 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y RESPONDIÓ Job, y dijo:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.1",
            "verseOrgIds": [
              "JOB.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ciertamente que vosotros sois el pueblo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.2",
            "verseOrgIds": [
              "JOB.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 12:2"
      },
      "items": [
        {
          "text": "Y con vosotros morirá la sabiduría.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.2",
            "verseOrgIds": [
              "JOB.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Job se queja del",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 juicio de sus amigos.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "También tengo yo seso como vosotros;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.3",
            "verseOrgIds": [
              "JOB.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 12:3"
      },
      "items": [
        {
          "text": "No soy yo menos que vosotros:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.3",
            "verseOrgIds": [
              "JOB.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 12:3"
      },
      "items": [
        {
          "text": "¿Y quién habrá que no pueda decir otro tanto?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.3",
            "verseOrgIds": [
              "JOB.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo soy uno de quien su amigo se mofa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.4",
            "verseOrgIds": [
              "JOB.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 12:4"
      },
      "items": [
        {
          "text": "Que invoca á Dios, y él le responde:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.4",
            "verseOrgIds": [
              "JOB.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 12:4"
      },
      "items": [
        {
          "text": "Con todo, el justo y perfecto es escarnecido.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.4",
            "verseOrgIds": [
              "JOB.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aquel cuyos pies van á resbalar,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.5",
            "verseOrgIds": [
              "JOB.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 12:5"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Es como",
              "type": "text",
              "attrs": {
                "verseId": "JOB.12.5",
                "verseOrgIds": [
                  "JOB.12.5"
                ]
              }
            }
          ]
        },
        {
          "text": "una lámpara despreciada de aquel que está á sus anchuras.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.5",
            "verseOrgIds": [
              "JOB.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Prosperan las tiendas de los ladrones,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.6",
            "verseOrgIds": [
              "JOB.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 12:6"
      },
      "items": [
        {
          "text": "Y los que provocan á Dios viven seguros;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.6",
            "verseOrgIds": [
              "JOB.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 12:6"
      },
      "items": [
        {
          "text": "En cuyas manos él ha puesto",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.6",
            "verseOrgIds": [
              "JOB.12.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "cuanto tienen.",
              "type": "text",
              "attrs": {
                "verseId": "JOB.12.6",
                "verseOrgIds": [
                  "JOB.12.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y en efecto, pregunta ahora á las bestias, que ellas te enseñarán;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.7",
            "verseOrgIds": [
              "JOB.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 12:7"
      },
      "items": [
        {
          "text": "Y á las aves de los cielos, que ellas te lo mostrarán;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.7",
            "verseOrgIds": [
              "JOB.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "O habla á la tierra, que ella te enseñará;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.8",
            "verseOrgIds": [
              "JOB.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 12:8"
      },
      "items": [
        {
          "text": "Los peces de la mar te",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.8",
            "verseOrgIds": [
              "JOB.12.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "lo",
              "type": "text",
              "attrs": {
                "verseId": "JOB.12.8",
                "verseOrgIds": [
                  "JOB.12.8"
                ]
              }
            }
          ]
        },
        {
          "text": "declararán también.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.8",
            "verseOrgIds": [
              "JOB.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Qué cosa de todas estas no entiende",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.9",
            "verseOrgIds": [
              "JOB.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 12:9"
      },
      "items": [
        {
          "text": "Que",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.9",
            "verseOrgIds": [
              "JOB.12.9"
            ]
          }
        },
        {
          "text": "la mano de Jehová la hizo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.9",
            "verseOrgIds": [
              "JOB.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "En su mano está el alma de todo viviente,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.10",
            "verseOrgIds": [
              "JOB.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 12:10"
      },
      "items": [
        {
          "text": "Y el espíritu de toda carne humana.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.10",
            "verseOrgIds": [
              "JOB.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ciertamente el oído distingue las palabras,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.11",
            "verseOrgIds": [
              "JOB.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 12:11"
      },
      "items": [
        {
          "text": "Y el paladar gusta las viandas.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.11",
            "verseOrgIds": [
              "JOB.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "En los viejos está la ciencia,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.12",
            "verseOrgIds": [
              "JOB.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 12:12"
      },
      "items": [
        {
          "text": "Y en la larga edad la inteligencia.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.12",
            "verseOrgIds": [
              "JOB.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Con Dios está la sabiduría y la fortaleza;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.13",
            "verseOrgIds": [
              "JOB.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 12:13"
      },
      "items": [
        {
          "text": "Suyo es el consejo y la inteligencia.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.13",
            "verseOrgIds": [
              "JOB.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "He aquí, él derribará, y no será edificado:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.14",
            "verseOrgIds": [
              "JOB.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 12:14"
      },
      "items": [
        {
          "text": "Encerrará al hombre, y no habrá quien le abra.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.14",
            "verseOrgIds": [
              "JOB.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "He aquí,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.15",
            "verseOrgIds": [
              "JOB.12.15"
            ]
          }
        },
        {
          "text": "el detendrá las aguas, y se secarán;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.15",
            "verseOrgIds": [
              "JOB.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 12:15"
      },
      "items": [
        {
          "text": "El",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.15",
            "verseOrgIds": [
              "JOB.12.15"
            ]
          }
        },
        {
          "text": "las enviará, y destruirán la tierra.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.15",
            "verseOrgIds": [
              "JOB.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Con él está la fortaleza y la existencia;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.16",
            "verseOrgIds": [
              "JOB.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 12:16"
      },
      "items": [
        {
          "text": "Suyo es el que yerra, y el que hace errar.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.16",
            "verseOrgIds": [
              "JOB.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "El",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.17",
            "verseOrgIds": [
              "JOB.12.17"
            ]
          }
        },
        {
          "text": "hace andar á los consejeros desnudos",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.17",
            "verseOrgIds": [
              "JOB.12.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "de consejo,",
              "type": "text",
              "attrs": {
                "verseId": "JOB.12.17",
                "verseOrgIds": [
                  "JOB.12.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 12:17"
      },
      "items": [
        {
          "text": "Y hace enloquecer á los jueces.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.17",
            "verseOrgIds": [
              "JOB.12.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "El suelta la atadura de los tiranos,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.18",
            "verseOrgIds": [
              "JOB.12.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 12:18"
      },
      "items": [
        {
          "text": "Y ata el cinto á sus lomos.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.18",
            "verseOrgIds": [
              "JOB.12.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "El lleva",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.19",
            "verseOrgIds": [
              "JOB.12.19"
            ]
          }
        },
        {
          "text": "despojados á los príncipes,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.19",
            "verseOrgIds": [
              "JOB.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 12:19"
      },
      "items": [
        {
          "text": "Y trastorna á los poderosos.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.19",
            "verseOrgIds": [
              "JOB.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "El impide el labio á los que dicen verdad,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.20",
            "verseOrgIds": [
              "JOB.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 12:20"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.20",
            "verseOrgIds": [
              "JOB.12.20"
            ]
          }
        },
        {
          "text": "quita á los ancianos el consejo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.20",
            "verseOrgIds": [
              "JOB.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "El derrama menosprecio sobre los príncipes,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.21",
            "verseOrgIds": [
              "JOB.12.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 12:21"
      },
      "items": [
        {
          "text": "Y enflaquece la fuerza de los esforzados.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.21",
            "verseOrgIds": [
              "JOB.12.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "El descubre las profundidades de las tinieblas,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.22",
            "verseOrgIds": [
              "JOB.12.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 12:22"
      },
      "items": [
        {
          "text": "Y saca á luz la sombra de muerte.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.22",
            "verseOrgIds": [
              "JOB.12.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "El multiplica las gentes, y él las destruye:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.23",
            "verseOrgIds": [
              "JOB.12.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 12:23"
      },
      "items": [
        {
          "text": "El esparce las gentes, y las torna á recoger.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.23",
            "verseOrgIds": [
              "JOB.12.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "El quita el seso de las cabezas del pueblo de la tierra,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.24",
            "verseOrgIds": [
              "JOB.12.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 12:24"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.24",
            "verseOrgIds": [
              "JOB.12.24"
            ]
          }
        },
        {
          "text": "háceles que se pierdan vagueando sin camino:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.24",
            "verseOrgIds": [
              "JOB.12.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Van á tientas como en tinieblas y sin luz,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.25",
            "verseOrgIds": [
              "JOB.12.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 12:25"
      },
      "items": [
        {
          "text": "Y los hace",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.25",
            "verseOrgIds": [
              "JOB.12.25"
            ]
          }
        },
        {
          "text": "errar como borrachos.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.25",
            "verseOrgIds": [
              "JOB.12.25"
            ]
          }
        }
