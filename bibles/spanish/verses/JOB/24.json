{
  "id": "JOB.24",
  "number": "24",
  "bookId": "JOB",
  "reference": "Job 24",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "JOB 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "PUESTO que no son ocultos los tiempos al Todopoderoso,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.1",
            "verseOrgIds": [
              "JOB.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 24:1"
      },
      "items": [
        {
          "text": "¿Por qué los que le conocen no ven sus días?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.1",
            "verseOrgIds": [
              "JOB.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Traspasan",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.2",
            "verseOrgIds": [
              "JOB.24.2"
            ]
          }
        },
        {
          "text": "los términos,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.2",
            "verseOrgIds": [
              "JOB.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 24:2"
      },
      "items": [
        {
          "text": "Roban los ganados, y apaciéntanlos.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.2",
            "verseOrgIds": [
              "JOB.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Llévanse el asno de los huérfanos;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.3",
            "verseOrgIds": [
              "JOB.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 24:3"
      },
      "items": [
        {
          "text": "Prenden el buey de la viuda.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.3",
            "verseOrgIds": [
              "JOB.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hacen apartar del camino á los menesterosos:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.4",
            "verseOrgIds": [
              "JOB.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 24:4"
      },
      "items": [
        {
          "text": "Y todos",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.4",
            "verseOrgIds": [
              "JOB.24.4"
            ]
          }
        },
        {
          "text": "los pobres de la tierra se esconden.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.4",
            "verseOrgIds": [
              "JOB.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "He aquí, como asnos monteses en el desierto,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.5",
            "verseOrgIds": [
              "JOB.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 24:5"
      },
      "items": [
        {
          "text": "Salen á su obra madrugando para robar;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.5",
            "verseOrgIds": [
              "JOB.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 24:5"
      },
      "items": [
        {
          "text": "El desierto es mantenimiento de sus hijos.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.5",
            "verseOrgIds": [
              "JOB.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "En el campo siegan su pasto,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.6",
            "verseOrgIds": [
              "JOB.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 24:6"
      },
      "items": [
        {
          "text": "Y los impíos vendimian la viña",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.6",
            "verseOrgIds": [
              "JOB.24.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "ajena.",
              "type": "text",
              "attrs": {
                "verseId": "JOB.24.6",
                "verseOrgIds": [
                  "JOB.24.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Al desnudo hacen dormir sin ropa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.7",
            "verseOrgIds": [
              "JOB.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 24:7"
      },
      "items": [
        {
          "text": "Y que en el frío no tenga cobertura.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.7",
            "verseOrgIds": [
              "JOB.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Con las avenidas de los montes se mojan,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.8",
            "verseOrgIds": [
              "JOB.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 24:8"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.8",
            "verseOrgIds": [
              "JOB.24.8"
            ]
          }
        },
        {
          "text": "abrazan las peñas sin tener abrigo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.8",
            "verseOrgIds": [
              "JOB.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Quitan el pecho á los huérfanos,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.9",
            "verseOrgIds": [
              "JOB.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 24:9"
      },
      "items": [
        {
          "text": "Y de sobre el pobre toman la prenda.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.9",
            "verseOrgIds": [
              "JOB.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Al desnudo hacen andar sin vestido,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.10",
            "verseOrgIds": [
              "JOB.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 24:10"
      },
      "items": [
        {
          "text": "Y á los hambrientos quitan los hacecillos.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.10",
            "verseOrgIds": [
              "JOB.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "De dentro de sus paredes exprimen el aceite,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.11",
            "verseOrgIds": [
              "JOB.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 24:11"
      },
      "items": [
        {
          "text": "Pisan los lagares, y mueren de sed.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.11",
            "verseOrgIds": [
              "JOB.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "De la ciudad gimen los hombres,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.12",
            "verseOrgIds": [
              "JOB.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 24:12"
      },
      "items": [
        {
          "text": "Y claman las almas de los heridos de muerte:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.12",
            "verseOrgIds": [
              "JOB.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 24:12"
      },
      "items": [
        {
          "text": "Mas Dios no puso estorbo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.12",
            "verseOrgIds": [
              "JOB.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ellos son los que,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.13",
            "verseOrgIds": [
              "JOB.24.13"
            ]
          }
        },
        {
          "text": "rebeldes á la luz,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.13",
            "verseOrgIds": [
              "JOB.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 24:13"
      },
      "items": [
        {
          "text": "Nunca conocieron sus caminos,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.13",
            "verseOrgIds": [
              "JOB.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 24:13"
      },
      "items": [
        {
          "text": "Ni estuvieron en sus veredas.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.13",
            "verseOrgIds": [
              "JOB.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "A la luz se levanta el matador, mata al pobre y al necesitado,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.14",
            "verseOrgIds": [
              "JOB.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 24:14"
      },
      "items": [
        {
          "text": "Y de noche es como ladrón.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.14",
            "verseOrgIds": [
              "JOB.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "El ojo del adúltero está aguardando",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.15",
            "verseOrgIds": [
              "JOB.24.15"
            ]
          }
        },
        {
          "text": "la noche,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.15",
            "verseOrgIds": [
              "JOB.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 24:15"
      },
      "items": [
        {
          "text": "Diciendo: No me verá nadie:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.15",
            "verseOrgIds": [
              "JOB.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 24:15"
      },
      "items": [
        {
          "text": "Y esconde su rostro.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.15",
            "verseOrgIds": [
              "JOB.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "En las tinieblas minan las casas,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.16",
            "verseOrgIds": [
              "JOB.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 24:16"
      },
      "items": [
        {
          "text": "Que de día para sí señalaron;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.16",
            "verseOrgIds": [
              "JOB.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 24:16"
      },
      "items": [
        {
          "text": "No conocen la luz.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.16",
            "verseOrgIds": [
              "JOB.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.17",
            "verseOrgIds": [
              "JOB.24.17"
            ]
          }
        },
        {
          "text": "la mañana es á todos ellos como sombra de muerte;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.17",
            "verseOrgIds": [
              "JOB.24.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 24:17"
      },
      "items": [
        {
          "text": "Si son conocidos, terrores de sombra de muerte",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.17",
            "verseOrgIds": [
              "JOB.24.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "los toman.",
              "type": "text",
              "attrs": {
                "verseId": "JOB.24.17",
                "verseOrgIds": [
                  "JOB.24.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Son instables",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.18",
            "verseOrgIds": [
              "JOB.24.18"
            ]
          }
        },
        {
          "text": "más que la superficie de las aguas;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.18",
            "verseOrgIds": [
              "JOB.24.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 24:18"
      },
      "items": [
        {
          "text": "Su porción es maldita en la tierra;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.18",
            "verseOrgIds": [
              "JOB.24.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 24:18"
      },
      "items": [
        {
          "text": "No andarán por el camino de las viñas.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.18",
            "verseOrgIds": [
              "JOB.24.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Palabras de Bildad.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 Job reprende á Bildad",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "La sequía y el calor arrebatan las",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.19",
            "verseOrgIds": [
              "JOB.24.19"
            ]
          }
        },
        {
          "text": "aguas de la nieve;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.19",
            "verseOrgIds": [
              "JOB.24.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 24:19"
      },
      "items": [
        {
          "text": "Y el sepulcro á los pecadores.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.19",
            "verseOrgIds": [
              "JOB.24.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olvidaráse de ellos el seno materno; de ellos sentirán los gusanos dulzura;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.20",
            "verseOrgIds": [
              "JOB.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 24:20"
      },
      "items": [
        {
          "text": "Nunca más habrá de ellos memoria,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.20",
            "verseOrgIds": [
              "JOB.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 24:20"
      },
      "items": [
        {
          "text": "Y como un árbol serán los impíos quebrantados.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.20",
            "verseOrgIds": [
              "JOB.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "A la mujer estéril que no paría, afligió;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.21",
            "verseOrgIds": [
              "JOB.24.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 24:21"
      },
      "items": [
        {
          "text": "Y á la viuda nunca hizo bien.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.21",
            "verseOrgIds": [
              "JOB.24.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas á los fuertes adelantó con su poder:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.22",
            "verseOrgIds": [
              "JOB.24.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 24:22"
      },
      "items": [
        {
          "text": "Levantóse, y no se da por segura la vida.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.22",
            "verseOrgIds": [
              "JOB.24.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Le dieron á crédito, y se afirmó:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.23",
            "verseOrgIds": [
              "JOB.24.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 24:23"
      },
      "items": [
        {
          "text": "Sus ojos están sobre los caminos de ellos.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.23",
            "verseOrgIds": [
              "JOB.24.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fueron ensalzados",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.24",
            "verseOrgIds": [
              "JOB.24.24"
            ]
          }
        },
        {
          "text": "por un poco, mas desaparecen,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.24",
            "verseOrgIds": [
              "JOB.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 24:24"
      },
      "items": [
        {
          "text": "Y son abatidos como cada cual: serán encerrados,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.24",
            "verseOrgIds": [
              "JOB.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 24:24"
      },
      "items": [
        {
          "text": "Y cortados como cabezas de espigas.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.24",
            "verseOrgIds": [
              "JOB.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y si no, ¿quién me desmentirá ahora,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.25",
            "verseOrgIds": [
              "JOB.24.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 24:25"
      },
      "items": [
        {
          "text": "O reducirá á nada mis palabras?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.25",
            "verseOrgIds": [
              "JOB.24.25"
            ]
          }
        }
      ]
    }
  ],
