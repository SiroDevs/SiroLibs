            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Mas",
              "type": "text",
              "attrs": {
                "verseId": "JOB.6.20",
                "verseOrgIds": [
                  "JOB.6.20"
                ]
              }
            }
          ]
        },
        {
          "text": "fueron avergonzados por su esperanza;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.20",
            "verseOrgIds": [
              "JOB.6.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 6:20"
      },
      "items": [
        {
          "text": "Porque vinieron hasta ellas, y halláronse confusos.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.20",
            "verseOrgIds": [
              "JOB.6.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahora ciertamente como ellas sois vosotros:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.21",
            "verseOrgIds": [
              "JOB.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 6:21"
      },
      "items": [
        {
          "text": "Que habéis visto el tormento, y teméis.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.21",
            "verseOrgIds": [
              "JOB.6.21"
            ]
          }
        }
      ]
    },
    {
