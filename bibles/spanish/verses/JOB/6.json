          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y libradme de la mano del opresor,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.23",
            "verseOrgIds": [
              "JOB.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 6:23"
      },
      "items": [
        {
          "text": "Y redimidme del poder de los violentos?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.23",
            "verseOrgIds": [
              "JOB.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enseñadme, y yo callaré:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.24",
            "verseOrgIds": [
              "JOB.6.24"
            ]
          }
        }
      ]
    },
