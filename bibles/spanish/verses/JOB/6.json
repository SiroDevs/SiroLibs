      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 6:24"
      },
      "items": [
        {
          "text": "Y hacedme entender en qué he errado.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.24",
            "verseOrgIds": [
              "JOB.6.24"
            ]
          }
        }
      ]
    },
    {
