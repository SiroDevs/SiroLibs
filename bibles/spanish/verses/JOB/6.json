          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "¡Cuán fuertes son las palabras de rectitud!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.25",
            "verseOrgIds": [
              "JOB.6.25"
            ]
          }
        }
      ]
    },
