              "attrs": {
                "verseId": "JOB.6.29",
                "verseOrgIds": [
                  "JOB.6.29"
                ]
              }
            }
          ]
        },
        {
          "text": "mi justicia en esto.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.29",
            "verseOrgIds": [
              "JOB.6.29"
            ]
          }
        }
      ]
