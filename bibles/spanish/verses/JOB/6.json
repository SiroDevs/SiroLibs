          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miraron los caminantes",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.19",
            "verseOrgIds": [
              "JOB.6.19"
            ]
          }
        },
        {
          "text": "de Temán,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.19",
            "verseOrgIds": [
              "JOB.6.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 6:19"
      },
      "items": [
        {
          "text": "Los caminantes de",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.19",
            "verseOrgIds": [
              "JOB.6.19"
            ]
          }
        },
        {
          "text": "Saba esperaron en ellas:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.19",
            "verseOrgIds": [
              "JOB.6.19"
            ]
          }
        }
      ]
    },
