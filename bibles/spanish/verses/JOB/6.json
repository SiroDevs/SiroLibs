          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tornad ahora, y no haya iniquidad;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.29",
            "verseOrgIds": [
              "JOB.6.29"
            ]
          }
        }
      ]
    },
