          "text": "Y hacéis",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.27",
            "verseOrgIds": [
              "JOB.6.27"
            ]
          }
        },
        {
          "text": "hoyo delante de vuestro amigo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.27",
            "verseOrgIds": [
              "JOB.6.27"
            ]
          }
        }
      ]
    },
