          "attrs": {
            "verseId": "JOB.6.28",
            "verseOrgIds": [
              "JOB.6.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "ved",
              "type": "text",
              "attrs": {
                "verseId": "JOB.6.28",
                "verseOrgIds": [
                  "JOB.6.28"
                ]
              }
            }
          ]
        },
