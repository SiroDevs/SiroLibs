{
  "id": "JOB.6",
  "number": "6",
  "bookId": "JOB",
  "reference": "Job 6",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "JOB 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y RESPONDIÓ Job y dijo:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.1",
            "verseOrgIds": [
              "JOB.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "¡Oh si pesasen al justo mi queja y mi tormento,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.2",
            "verseOrgIds": [
              "JOB.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 6:2"
      },
      "items": [
        {
          "text": "Y se alzasen igualmente en balanza!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.2",
            "verseOrgIds": [
              "JOB.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.3",
            "verseOrgIds": [
              "JOB.6.3"
            ]
          }
        },
        {
          "text": "pesaría aquél más que la arena del mar:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.3",
            "verseOrgIds": [
              "JOB.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 6:3"
      },
      "items": [
        {
          "text": "Y por tanto mis palabras son cortadas.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.3",
            "verseOrgIds": [
              "JOB.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque las",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.4",
            "verseOrgIds": [
              "JOB.6.4"
            ]
          }
        },
        {
          "text": "saetas del Todopoderoso están en mí,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.4",
            "verseOrgIds": [
              "JOB.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 6:4"
      },
      "items": [
        {
          "text": "Cuyo veneno bebe mi espíritu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.4",
            "verseOrgIds": [
              "JOB.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 6:4"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.4",
            "verseOrgIds": [
              "JOB.6.4"
            ]
          }
        },
        {
          "text": "terrores de Dios me combaten.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.4",
            "verseOrgIds": [
              "JOB.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Acaso gime el asno montés junto á la hierba?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.5",
            "verseOrgIds": [
              "JOB.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 6:5"
      },
      "items": [
        {
          "text": "¿Muge el buey junto á su pasto?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.5",
            "verseOrgIds": [
              "JOB.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Job se queja",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 de sus amigos",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Comeráse lo desabrido sin sal?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.6",
            "verseOrgIds": [
              "JOB.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 6:6"
      },
      "items": [
        {
          "text": "¿O habrá gusto en la clara del huevo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.6",
            "verseOrgIds": [
              "JOB.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Las cosas que mi alma no quería tocar,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.7",
            "verseOrgIds": [
              "JOB.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 6:7"
      },
      "items": [
        {
          "text": "Por los dolores son mi comida.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.7",
            "verseOrgIds": [
              "JOB.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "¡Quién me diera que viniese",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.8",
            "verseOrgIds": [
              "JOB.6.8"
            ]
          }
        },
        {
          "text": "mi petición,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.8",
            "verseOrgIds": [
              "JOB.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 6:8"
      },
      "items": [
        {
          "text": "Y que Dios",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.8",
            "verseOrgIds": [
              "JOB.6.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "me",
              "type": "text",
              "attrs": {
                "verseId": "JOB.6.8",
                "verseOrgIds": [
                  "JOB.6.8"
                ]
              }
            }
          ]
        },
        {
          "text": "otorgase lo que espero;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.8",
            "verseOrgIds": [
              "JOB.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y que pluguiera á Dios quebrantarme;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.9",
            "verseOrgIds": [
              "JOB.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 6:9"
      },
      "items": [
        {
          "text": "Que soltara su mano, y me deshiciera!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.9",
            "verseOrgIds": [
              "JOB.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y sería aún mi consuelo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.10",
            "verseOrgIds": [
              "JOB.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 6:10"
      },
      "items": [
        {
          "text": "Si me asaltase con dolor sin dar más tregua,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.10",
            "verseOrgIds": [
              "JOB.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 6:10"
      },
      "items": [
        {
          "text": "Que yo no he escondido las palabras",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.10",
            "verseOrgIds": [
              "JOB.6.10"
            ]
          }
        },
        {
          "text": "del Santo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.10",
            "verseOrgIds": [
              "JOB.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Cuál es mi fortaleza para esperar aún?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.11",
            "verseOrgIds": [
              "JOB.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 6:11"
      },
      "items": [
        {
          "text": "¿Y cuál mi fin para dilatar mi vida?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.11",
            "verseOrgIds": [
              "JOB.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Es mi fortaleza la de las piedras?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.12",
            "verseOrgIds": [
              "JOB.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 6:12"
      },
      "items": [
        {
          "text": "¿O mi carne, es de acero?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.12",
            "verseOrgIds": [
              "JOB.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿No me ayudo cuanto puedo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.13",
            "verseOrgIds": [
              "JOB.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 6:13"
      },
      "items": [
        {
          "text": "Y el poder me falta del todo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.13",
            "verseOrgIds": [
              "JOB.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "El atribulado es consolado de su compañero:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.14",
            "verseOrgIds": [
              "JOB.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 6:14"
      },
      "items": [
        {
          "text": "Mas hase abandonado el temor del Omnipotente.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.14",
            "verseOrgIds": [
              "JOB.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mis hermanos han mentido cual arroyo:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.15",
            "verseOrgIds": [
              "JOB.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 6:15"
      },
      "items": [
        {
          "text": "Pasáronse como corrientes impetuosas,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.15",
            "verseOrgIds": [
              "JOB.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que están escondidas por la helada,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.16",
            "verseOrgIds": [
              "JOB.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 6:16"
      },
      "items": [
        {
          "text": "Y encubiertas con nieve;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.16",
            "verseOrgIds": [
              "JOB.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que al tiempo del calor son deshechas,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.17",
            "verseOrgIds": [
              "JOB.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 6:17"
      },
      "items": [
        {
          "text": "Y en calentándose, desaparecen de su lugar;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.17",
            "verseOrgIds": [
              "JOB.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apártanse de la senda de su rumbo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.18",
            "verseOrgIds": [
              "JOB.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 6:18"
      },
      "items": [
        {
          "text": "Van menguando y piérdense.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.18",
            "verseOrgIds": [
              "JOB.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
