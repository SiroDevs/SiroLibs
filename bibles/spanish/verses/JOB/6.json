      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 6:25"
      },
      "items": [
        {
          "text": "Mas ¿qué reprende el que reprende de vosotros?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.25",
            "verseOrgIds": [
              "JOB.6.25"
            ]
          }
        }
      ]
    },
    {
