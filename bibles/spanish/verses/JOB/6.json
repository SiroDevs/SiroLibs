      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 6:26"
      },
      "items": [
        {
          "text": "Y los discursos de un desesperado, que son como el viento?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.26",
            "verseOrgIds": [
              "JOB.6.26"
            ]
          }
        }
      ]
    },
