{
  "id": "JOB.14",
  "number": "14",
  "bookId": "JOB",
  "reference": "Job 14",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "JOB 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "EL HOMBRE",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.1",
            "verseOrgIds": [
              "JOB.14.1"
            ]
          }
        },
        {
          "text": "nacido de mujer,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.1",
            "verseOrgIds": [
              "JOB.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 14:1"
      },
      "items": [
        {
          "text": "Corto de días, y harto de sinsabores:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.1",
            "verseOrgIds": [
              "JOB.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que sale como",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.2",
            "verseOrgIds": [
              "JOB.14.2"
            ]
          }
        },
        {
          "text": "una flor y es",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.2",
            "verseOrgIds": [
              "JOB.14.2"
            ]
          }
        },
        {
          "text": "cortado;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.2",
            "verseOrgIds": [
              "JOB.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 14:2"
      },
      "items": [
        {
          "text": "Y huye",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.2",
            "verseOrgIds": [
              "JOB.14.2"
            ]
          }
        },
        {
          "text": "como la sombra, y no permanece.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.2",
            "verseOrgIds": [
              "JOB.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Y sobre éste abres tus ojos,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.3",
            "verseOrgIds": [
              "JOB.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 14:3"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.3",
            "verseOrgIds": [
              "JOB.14.3"
            ]
          }
        },
        {
          "text": "me traes á juicio contigo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.3",
            "verseOrgIds": [
              "JOB.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Quién hará limpio de inmundo? Nadie.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.4",
            "verseOrgIds": [
              "JOB.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ciertamente sus días están determinados, y el número de sus meses está cerca de ti:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.5",
            "verseOrgIds": [
              "JOB.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 14:5"
      },
      "items": [
        {
          "text": "Tú le pusiste términos, de los cuales no pasará.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.5",
            "verseOrgIds": [
              "JOB.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si tú lo dejares, él dejará",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.6",
            "verseOrgIds": [
              "JOB.14.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "de ser:",
              "type": "text",
              "attrs": {
                "verseId": "JOB.14.6",
                "verseOrgIds": [
                  "JOB.14.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 14:6"
      },
      "items": [
        {
          "text": "Entre tanto deseará,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.6",
            "verseOrgIds": [
              "JOB.14.6"
            ]
          }
        },
        {
          "text": "como el jornalero, su día.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.6",
            "verseOrgIds": [
              "JOB.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque si el árbol fuere cortado, aún queda de él esperanza; retoñecerá aún,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.7",
            "verseOrgIds": [
              "JOB.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 14:7"
      },
      "items": [
        {
          "text": "Y sus renuevos no faltarán.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.7",
            "verseOrgIds": [
              "JOB.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Brevedad de la vida.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 Repuesta de Eliphaz.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si se envejeciere en la tierra su raíz,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.8",
            "verseOrgIds": [
              "JOB.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 14:8"
      },
      "items": [
        {
          "text": "Y su tronco fuere muerto en el polvo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.8",
            "verseOrgIds": [
              "JOB.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Al percibir el agua reverdecerá,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.9",
            "verseOrgIds": [
              "JOB.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 14:9"
      },
      "items": [
        {
          "text": "Y hará copa como planta.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.9",
            "verseOrgIds": [
              "JOB.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas el hombre morirá, y será cortado;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.10",
            "verseOrgIds": [
              "JOB.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 14:10"
      },
      "items": [
        {
          "text": "Y perecerá el hombre, ¿y dónde estará él?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.10",
            "verseOrgIds": [
              "JOB.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Las aguas de la mar se fueron,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.11",
            "verseOrgIds": [
              "JOB.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 14:11"
      },
      "items": [
        {
          "text": "Y agotóse el río, secóse.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.11",
            "verseOrgIds": [
              "JOB.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Así el hombre yace, y no se tornará á levantar:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.12",
            "verseOrgIds": [
              "JOB.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 14:12"
      },
      "items": [
        {
          "text": "Hasta que no haya cielo no despertarán,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.12",
            "verseOrgIds": [
              "JOB.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 14:12"
      },
      "items": [
        {
          "text": "Ni se levantarán de su sueño.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.12",
            "verseOrgIds": [
              "JOB.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "¡Oh quién me diera que me",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.13",
            "verseOrgIds": [
              "JOB.14.13"
            ]
          }
        },
        {
          "text": "escondieses en el sepulcro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.13",
            "verseOrgIds": [
              "JOB.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 14:13"
      },
      "items": [
        {
          "text": "Que me encubrieras hasta apaciguarse tu ira,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.13",
            "verseOrgIds": [
              "JOB.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 14:13"
      },
      "items": [
        {
          "text": "Que me pusieses plazo, y de mí te acordaras!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.13",
            "verseOrgIds": [
              "JOB.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si el hombre muriere,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.14",
            "verseOrgIds": [
              "JOB.14.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "¿volverá",
              "type": "text",
              "attrs": {
                "verseId": "JOB.14.14",
                "verseOrgIds": [
                  "JOB.14.14"
                ]
              }
            }
          ]
        },
        {
          "text": "á vivir?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.14",
            "verseOrgIds": [
              "JOB.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 14:14"
      },
      "items": [
        {
          "text": "Todos los días de mi edad esperaré,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.14",
            "verseOrgIds": [
              "JOB.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 14:14"
      },
      "items": [
        {
          "text": "Hasta que venga mi mutación.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.14",
            "verseOrgIds": [
              "JOB.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aficionado á la",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.15",
            "verseOrgIds": [
              "JOB.14.15"
            ]
          }
        },
        {
          "text": "obra de tus manos,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.15",
            "verseOrgIds": [
              "JOB.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 14:15"
      },
      "items": [
        {
          "text": "Llamarás, y yo te responderé.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.15",
            "verseOrgIds": [
              "JOB.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pues ahora me cuentas los pasos,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.16",
            "verseOrgIds": [
              "JOB.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 14:16"
      },
      "items": [
        {
          "text": "Y no das tregua á mi pecado.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.16",
            "verseOrgIds": [
              "JOB.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tienes sellada en saco mi prevaricación,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.17",
            "verseOrgIds": [
              "JOB.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 14:17"
      },
      "items": [
        {
          "text": "Y coacervas mi iniquidad.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.17",
            "verseOrgIds": [
              "JOB.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y ciertamente el monte que cae se deshace,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.18",
            "verseOrgIds": [
              "JOB.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 14:18"
      },
      "items": [
        {
          "text": "Y las peñas son traspasadas de su lugar;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.18",
            "verseOrgIds": [
              "JOB.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Las piedras son desgastadas con el agua impetuosa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.19",
            "verseOrgIds": [
              "JOB.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 14:19"
      },
      "items": [
        {
          "text": "Que se lleva el polvo de la tierra: de tal manera haces tú perecer la esperanza del hombre.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.19",
            "verseOrgIds": [
              "JOB.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Para siempre serás más fuerte que él, y él se va;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.20",
            "verseOrgIds": [
              "JOB.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 14:20"
      },
      "items": [
        {
          "text": "Demudarás su rostro, y enviaráslo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.20",
            "verseOrgIds": [
              "JOB.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sus hijos serán honrados,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.21",
            "verseOrgIds": [
              "JOB.14.21"
            ]
          }
        },
        {
          "text": "y él no lo sabrá;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.21",
            "verseOrgIds": [
              "JOB.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 14:21"
      },
      "items": [
        {
          "text": "O serán humillados, y no entenderá de ellos.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.21",
            "verseOrgIds": [
              "JOB.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas su carne sobre él se dolerá,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.22",
            "verseOrgIds": [
              "JOB.14.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 14:22"
      },
      "items": [
        {
          "text": "Y entristecerse ha en él su alma.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.22",
            "verseOrgIds": [
              "JOB.14.22"
            ]
          }
        }
      ]
