            },
            "items": [
              {
                "text": "23",
                "type": "text"
              }
            ]
          },
          {
            "text": "Te saludan",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.23",
              "verseOrgIds": [
                "PHM.1.23"
              ]
            }
          },
          {
            "text": "Epafras, mi compañero en la prisión por Cristo Jesús,",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.23",
              "verseOrgIds": [
                "PHM.1.23"
              ]
            }
          }
        ]
      },
