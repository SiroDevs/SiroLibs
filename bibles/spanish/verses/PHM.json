{
  "PHM.1": {
    "id": "PHM.1",
    "number": "1",
    "bookId": "PHM",
    "reference": "Filemón 1",
    "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
    "verseCount": 25,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "1",
          "style": "c",
          "sid": "PHM 1"
        },
        "items": [
          {
            "text": "1",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "PHM 1:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "PABLO,",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.1",
              "verseOrgIds": [
                "PHM.1.1"
              ]
            }
          },
          {
            "text": "prisionero de Jesucristo, y el hermano",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.1",
              "verseOrgIds": [
                "PHM.1.1"
              ]
            }
          },
          {
            "text": "Timoteo, á Filemón amado,",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.1",
              "verseOrgIds": [
                "PHM.1.1"
              ]
            }
          },
          {
            "text": "y coadjutor nuestro;",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.1",
              "verseOrgIds": [
                "PHM.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "PHM 1:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "Y á la amada Apphia, y á",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.2",
              "verseOrgIds": [
                "PHM.1.2"
              ]
            }
          },
          {
            "text": "Archîpo, compañero de nuestra milicia, y á",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.2",
              "verseOrgIds": [
                "PHM.1.2"
              ]
            }
          },
          {
            "text": "la iglesia",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.2",
              "verseOrgIds": [
                "PHM.1.2"
              ]
            }
          },
          {
            "name": "char",
            "type": "tag",
            "attrs": {
              "style": "add"
            },
            "items": [
              {
                "text": "que está",
                "type": "text",
                "attrs": {
                  "verseId": "PHM.1.2",
                  "verseOrgIds": [
                    "PHM.1.2"
                  ]
                }
              }
            ]
          },
          {
            "text": "en tu casa:",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.2",
              "verseOrgIds": [
                "PHM.1.2"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "PHM 1:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Gracia á vosotros y paz de Dios nuestro Padre, y del Señor Jesucristo.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.3",
              "verseOrgIds": [
                "PHM.1.3"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "PHM 1:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Doy gracias á mi Dios, haciendo siempre memoria de ti en mis oraciones.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.4",
              "verseOrgIds": [
                "PHM.1.4"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "PHM 1:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "Oyendo tu caridad,",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.5",
              "verseOrgIds": [
                "PHM.1.5"
              ]
            }
          },
          {
            "text": "y la fe que tienes en el Señor Jesús, y para con todos los santos;",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.5",
              "verseOrgIds": [
                "PHM.1.5"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "PHM 1:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Para que la comunicación de tu fe sea eficaz,",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.6",
              "verseOrgIds": [
                "PHM.1.6"
              ]
            }
          },
          {
            "text": "en el conocimiento de todo el bien que está en vosotros, por Cristo Jesús.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.6",
              "verseOrgIds": [
                "PHM.1.6"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "PHM 1:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Porque tenemos gran gozo y consolación de tu caridad, de que por ti, oh hermano, han sido",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.7",
              "verseOrgIds": [
                "PHM.1.7"
              ]
            }
          },
          {
            "text": "recreadas",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.7",
              "verseOrgIds": [
                "PHM.1.7"
              ]
            }
          },
          {
            "text": "las entrañas de los santos.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.7",
              "verseOrgIds": [
                "PHM.1.7"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "PHM 1:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "Por lo cual,",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.8",
              "verseOrgIds": [
                "PHM.1.8"
              ]
            }
          },
          {
            "text": "aunque tengo mucha resolución en Cristo para mandarte lo que conviene,",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.8",
              "verseOrgIds": [
                "PHM.1.8"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "PHM 1:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ruégo",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.9",
              "verseOrgIds": [
                "PHM.1.9"
              ]
            }
          },
          {
            "name": "char",
            "type": "tag",
            "attrs": {
              "style": "add"
            },
            "items": [
              {
                "text": "te",
                "type": "text",
                "attrs": {
                  "verseId": "PHM.1.9",
                  "verseOrgIds": [
                    "PHM.1.9"
                  ]
                }
              }
            ]
          },
          {
            "text": "más bien por amor, siendo tal cual",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.9",
              "verseOrgIds": [
                "PHM.1.9"
              ]
            }
          },
          {
            "name": "char",
            "type": "tag",
            "attrs": {
              "style": "add"
            },
            "items": [
              {
                "text": "soy,",
                "type": "text",
                "attrs": {
                  "verseId": "PHM.1.9",
                  "verseOrgIds": [
                    "PHM.1.9"
                  ]
                }
              }
            ]
          },
          {
            "text": "Pablo viejo, y aun ahora",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.9",
              "verseOrgIds": [
                "PHM.1.9"
              ]
            }
          },
          {
            "text": "prisionero de Jesucristo:",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.9",
              "verseOrgIds": [
                "PHM.1.9"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "PHM 1:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ruégote por mi hijo",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.10",
              "verseOrgIds": [
                "PHM.1.10"
              ]
            }
          },
          {
            "text": "Onésimo,",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.10",
              "verseOrgIds": [
                "PHM.1.10"
              ]
            }
          },
          {
            "text": "que he engendrado en mis prisiones,",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.10",
              "verseOrgIds": [
                "PHM.1.10"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "PHM 1:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "El cual en otro tiempo te fué inútil, mas ahora á ti y á mí es útil;",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.11",
              "verseOrgIds": [
                "PHM.1.11"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "PHM 1:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "El cual te vuelvo á enviar; tu pues, recíbele como á mis entrañas.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.12",
              "verseOrgIds": [
                "PHM.1.12"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "13",
              "style": "v",
              "sid": "PHM 1:13"
            },
            "items": [
              {
                "text": "13",
                "type": "text"
              }
            ]
          },
          {
            "text": "Yo quisiera detenerle conmigo, para que en lugar de ti me sirviese en",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.13",
              "verseOrgIds": [
                "PHM.1.13"
              ]
            }
          },
          {
            "text": "las prisiones del evangelio;",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.13",
              "verseOrgIds": [
                "PHM.1.13"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "14",
              "style": "v",
              "sid": "PHM 1:14"
            },
            "items": [
              {
                "text": "14",
                "type": "text"
              }
            ]
          },
          {
            "text": "Mas nada quise hacer sin tu consejo, porque tu beneficio no fuese como de necesidad, sino voluntario.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.14",
              "verseOrgIds": [
                "PHM.1.14"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "15",
              "style": "v",
              "sid": "PHM 1:15"
            },
            "items": [
              {
                "text": "15",
                "type": "text"
              }
            ]
          },
          {
            "text": "Porque acaso por esto se ha apartado de ti por",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.15",
              "verseOrgIds": [
                "PHM.1.15"
              ]
            }
          },
          {
            "name": "char",
            "type": "tag",
            "attrs": {
              "style": "add"
            },
            "items": [
              {
                "text": "algún",
                "type": "text",
                "attrs": {
                  "verseId": "PHM.1.15",
                  "verseOrgIds": [
                    "PHM.1.15"
                  ]
                }
              }
            ]
          },
          {
            "text": "tiempo, para que le recibieses para siempre;",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.15",
              "verseOrgIds": [
                "PHM.1.15"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "16",
              "style": "v",
              "sid": "PHM 1:16"
            },
            "items": [
              {
                "text": "16",
                "type": "text"
              }
            ]
          },
          {
            "text": "No ya como siervo, antes más que siervo,",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.16",
              "verseOrgIds": [
                "PHM.1.16"
              ]
            }
          },
          {
            "name": "char",
            "type": "tag",
            "attrs": {
              "style": "add"
            },
            "items": [
              {
                "text": "como",
                "type": "text",
                "attrs": {
                  "verseId": "PHM.1.16",
                  "verseOrgIds": [
                    "PHM.1.16"
                  ]
                }
              }
            ]
          },
          {
            "text": "hermano amado, mayormente de mí, pero cuánto más de ti,",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.16",
              "verseOrgIds": [
                "PHM.1.16"
              ]
            }
          },
          {
            "text": "en la carne y en el Señor.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.16",
              "verseOrgIds": [
                "PHM.1.16"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "17",
              "style": "v",
              "sid": "PHM 1:17"
            },
            "items": [
              {
                "text": "17",
                "type": "text"
              }
            ]
          },
          {
            "text": "Así que,",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.17",
              "verseOrgIds": [
                "PHM.1.17"
              ]
            }
          },
          {
            "text": "si me tienes por compañero, recíbele como á mi.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.17",
              "verseOrgIds": [
                "PHM.1.17"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "18",
              "style": "v",
              "sid": "PHM 1:18"
            },
            "items": [
              {
                "text": "18",
                "type": "text"
              }
            ]
          },
          {
            "text": "Y si en algo te dañó, ó te debe, ponlo á mi cuenta.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.18",
              "verseOrgIds": [
                "PHM.1.18"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "19",
              "style": "v",
              "sid": "PHM 1:19"
            },
            "items": [
              {
                "text": "19",
                "type": "text"
              }
            ]
          },
          {
            "text": "Yo Pablo lo escribí de mi mano, yo",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.19",
              "verseOrgIds": [
                "PHM.1.19"
              ]
            }
          },
          {
            "name": "char",
            "type": "tag",
            "attrs": {
              "style": "add"
            },
            "items": [
              {
                "text": "lo",
                "type": "text",
                "attrs": {
                  "verseId": "PHM.1.19",
                  "verseOrgIds": [
                    "PHM.1.19"
                  ]
                }
              }
            ]
          },
          {
            "text": "pagaré: por no decirte que aun á ti mismo te me debes demás.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.19",
              "verseOrgIds": [
                "PHM.1.19"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "20",
              "style": "v",
              "sid": "PHM 1:20"
            },
            "items": [
              {
                "text": "20",
                "type": "text"
              }
            ]
          },
          {
            "text": "Sí, hermano, góceme yo de ti en el Señor;",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.20",
              "verseOrgIds": [
                "PHM.1.20"
              ]
            }
          },
          {
            "text": "recrea mis entrañas en el Señor.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.20",
              "verseOrgIds": [
                "PHM.1.20"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "21",
              "style": "v",
              "sid": "PHM 1:21"
            },
            "items": [
              {
                "text": "21",
                "type": "text"
              }
            ]
          },
          {
            "text": "Te he escrito confiando en tu obediencia, sabiendo que aun harás más de lo que digo.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.21",
              "verseOrgIds": [
                "PHM.1.21"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
