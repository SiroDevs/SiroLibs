                "text": "24",
                "type": "text"
              }
            ]
          },
          {
            "text": "Marcos,",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.24",
              "verseOrgIds": [
                "PHM.1.24"
              ]
            }
          },
          {
            "text": "Aristarco,",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.24",
              "verseOrgIds": [
                "PHM.1.24"
              ]
            }
          },
          {
            "text": "Demas y",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.24",
              "verseOrgIds": [
                "PHM.1.24"
              ]
            }
          },
          {
            "text": "Lucas, mis cooperadores.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.24",
              "verseOrgIds": [
                "PHM.1.24"
              ]
            }
          }
        ]
