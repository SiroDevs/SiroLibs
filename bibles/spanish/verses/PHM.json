            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "22",
              "style": "v",
              "sid": "PHM 1:22"
            },
            "items": [
              {
                "text": "22",
                "type": "text"
              }
            ]
          },
          {
            "text": "Y asimismo prepárame también alojamiento; porque espero que",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.22",
              "verseOrgIds": [
                "PHM.1.22"
              ]
            }
          },
          {
            "text": "por vuestras oraciones os tengo de ser concedido.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.22",
              "verseOrgIds": [
                "PHM.1.22"
              ]
            }
          }
        ]
      },
