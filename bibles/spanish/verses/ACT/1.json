      "attrs": {
        "style": "q",
        "vid": "ACT 1:20"
      },
      "items": [
        {
          "text": "Sea hecha desierta su habitación,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.20",
            "verseOrgIds": [
              "ACT.1.20"
            ]
          }
        }
