            "verseOrgIds": [
              "ACT.1.17"
            ]
          }
        },
        {
          "text": "este ministerio.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.17",
            "verseOrgIds": [
              "ACT.1.17"
            ]
          }
        }
      ]
