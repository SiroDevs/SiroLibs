          "attrs": {
            "verseId": "ACT.1.18",
            "verseOrgIds": [
              "ACT.1.18"
            ]
          }
        },
        {
          "text": "salario de su iniquidad, y colgándose, reventó por medio, y todas sus entrañas se derramaron.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.18",
            "verseOrgIds": [
              "ACT.1.18"
            ]
