          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas al cabo de dos años recibió Félix por sucesor á Porcio Festo: y queriendo Félix",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.27",
            "verseOrgIds": [
              "ACT.24.27"
