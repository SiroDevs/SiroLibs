            "number": "27",
            "style": "v",
            "sid": "GEN 45:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y ellos le contaron todas las palabras de José, que él les había hablado; y",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.27",
            "verseOrgIds": [
              "GEN.45.27"
            ]
          }
        },
        {
          "text": "viendo él los carros que José enviaba para llevarlo, el espíritu de Jacob su padre revivió.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.27",
            "verseOrgIds": [
              "GEN.45.27"
            ]
          }
        }
      ]
    },
    {
