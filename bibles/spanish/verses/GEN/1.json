        },
        {
          "text": "Y crió Dios al hombre á su imagen, á imagen de Dios lo crió;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.27",
            "verseOrgIds": [
              "GEN.1.27"
            ]
          }
        },
        {
          "text": "varón y hembra los crió.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.27",
            "verseOrgIds": [
              "GEN.1.27"
            ]
          }
        }
      ]
    },
