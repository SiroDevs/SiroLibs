              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y respondió Abram al rey de Sodoma:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.22",
            "verseOrgIds": [
              "GEN.14.22"
            ]
          }
        },
        {
          "text": "He alzado mi mano á Jehová Dios alto, poseedor de los cielos y de la tierra,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.22",
            "verseOrgIds": [
              "GEN.14.22"
            ]
          }
        }
