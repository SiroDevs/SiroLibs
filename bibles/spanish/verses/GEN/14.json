            }
          ]
        },
        {
          "text": "Sacando solamente lo que comieron los mancebos, y la porción de los varones que fueron conmigo,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.24",
            "verseOrgIds": [
              "GEN.14.24"
            ]
          }
