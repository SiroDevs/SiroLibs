        },
        {
          "text": "Entonces el rey de Sodoma dijo á Abram: Dame las",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.21",
            "verseOrgIds": [
              "GEN.14.21"
            ]
          }
        },
        {
          "text": "personas, y toma para ti la hacienda.",
          "type": "text",
          "attrs": {
