        },
        {
          "text": "En la cueva que está en el campo de Macpela, que está delante de Mamre en la tierra de Canaán,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.30",
            "verseOrgIds": [
              "GEN.49.30"
            ]
          }
        },
        {
          "text": "la cual compró Abraham con el mismo campo de Ephrón el Hetheo, para heredad de sepultura.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.30",
            "verseOrgIds": [
              "GEN.49.30"
            ]
          }
        }
      ]
