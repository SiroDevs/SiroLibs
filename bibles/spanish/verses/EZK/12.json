              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y fué á mí palabra de Jehová, diciendo:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.26",
            "verseOrgIds": [
