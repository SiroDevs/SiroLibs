              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hijo del hombre, he aquí que los de la casa de Israel dicen:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.27",
            "verseOrgIds": [
              "EZK.12.27"
            ]
          }
        },
        {
          "text": "La visión que éste ve es para muchos días, y para lejanos tiempos profetiza éste.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.27",
            "verseOrgIds": [
              "EZK.12.27"
            ]
          }
