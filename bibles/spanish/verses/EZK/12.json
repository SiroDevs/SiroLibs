        },
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.24",
            "verseOrgIds": [
              "EZK.12.24"
            ]
          }
        },
        {
          "text": "no habrá más alguna",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.24",
            "verseOrgIds": [
              "EZK.12.24"
            ]
          }
        },
        {
          "text": "visión vana, ni habrá adivinación de lisonjeros en medio de la casa de Israel.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.24",
            "verseOrgIds": [
              "EZK.12.24"
            ]
          }
