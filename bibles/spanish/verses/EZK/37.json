          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y mi siervo David",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.24",
            "verseOrgIds": [
              "EZK.37.24"
            ]
          }
        },
        {
          "text": "será rey sobre ellos, y á todos ellos será un pastor: y andarán en mis derechos, y mis ordenanzas guardarán, y las pondrán por obra.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.24",
            "verseOrgIds": [
              "EZK.37.24"
            ]
          }
        }
      ]
    },
