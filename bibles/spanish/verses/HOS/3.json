          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Después volverán los hijos de Israel, y buscarán á Jehová su Dios, y á",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.5",
            "verseOrgIds": [
              "HOS.3.5"
            ]
          }
        },
        {
          "text": "David su rey; y temerán á Jehová y á",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.5",
            "verseOrgIds": [
              "HOS.3.5"
            ]
          }
        },
        {
          "text": "su bondad en el fin de los días.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.5",
            "verseOrgIds": [
              "HOS.3.5"
            ]
          }
        }
