      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 2:19"
      },
      "items": [
        {
          "text": "Ni tomarán las veredas de la vida.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.19",
            "verseOrgIds": [
              "PRO.2.19"
            ]
          }
        }
      ]
    },
    {
