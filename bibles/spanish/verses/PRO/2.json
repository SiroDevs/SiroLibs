{
  "id": "PRO.2",
  "number": "2",
  "bookId": "PRO",
  "reference": "Proverbios 2",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "PRO 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "HIJO mío, si tomares mis palabras,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.1",
            "verseOrgIds": [
              "PRO.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 2:1"
      },
      "items": [
        {
          "text": "Y mis mandamientos guardares dentro de ti,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.1",
            "verseOrgIds": [
              "PRO.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haciendo estar atento tu oído á la sabiduría;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.2",
            "verseOrgIds": [
              "PRO.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 2:2"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Si",
              "type": "text",
              "attrs": {
                "verseId": "PRO.2.2",
                "verseOrgIds": [
                  "PRO.2.2"
                ]
              }
            }
          ]
        },
        {
          "text": "inclinares tu corazón á la prudencia;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.2",
            "verseOrgIds": [
              "PRO.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si clamares á la inteligencia,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.3",
            "verseOrgIds": [
              "PRO.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 2:3"
      },
      "items": [
        {
          "text": "Y á la prudencia dieres tu voz;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.3",
            "verseOrgIds": [
              "PRO.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si como á la plata la buscares,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.4",
            "verseOrgIds": [
              "PRO.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 2:4"
      },
      "items": [
        {
          "text": "Y la escudriñares como á tesoros;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.4",
            "verseOrgIds": [
              "PRO.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entonces entenderás el temor de Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.5",
            "verseOrgIds": [
              "PRO.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 2:5"
      },
      "items": [
        {
          "text": "Y hallarás el conocimiento de Dios.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.5",
            "verseOrgIds": [
              "PRO.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Excelencia y ventajas",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 de la sabiduría.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque Jehová da la sabiduría,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.6",
            "verseOrgIds": [
              "PRO.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 2:6"
      },
      "items": [
        {
          "text": "Y de su boca",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.6",
            "verseOrgIds": [
              "PRO.2.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "viene",
              "type": "text",
              "attrs": {
                "verseId": "PRO.2.6",
                "verseOrgIds": [
                  "PRO.2.6"
                ]
              }
            }
          ]
        },
        {
          "text": "el conocimiento y la inteligencia.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.6",
            "verseOrgIds": [
              "PRO.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "El provee de sólida sabiduría á los rectos:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.7",
            "verseOrgIds": [
              "PRO.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 2:7"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Es",
              "type": "text",
              "attrs": {
                "verseId": "PRO.2.7",
                "verseOrgIds": [
                  "PRO.2.7"
                ]
              }
            }
          ]
        },
        {
          "text": "escudo á los que caminan rectamente.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.7",
            "verseOrgIds": [
              "PRO.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Es",
              "type": "text",
              "attrs": {
                "verseId": "PRO.2.8",
                "verseOrgIds": [
                  "PRO.2.8"
                ]
              }
            }
          ]
        },
        {
          "text": "el que guarda las veredas del juicio,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.8",
            "verseOrgIds": [
              "PRO.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 2:8"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.8",
            "verseOrgIds": [
              "PRO.2.8"
            ]
          }
        },
        {
          "text": "preserva el camino de sus santos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.8",
            "verseOrgIds": [
              "PRO.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entonces entenderás justicia, juicio,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.9",
            "verseOrgIds": [
              "PRO.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 2:9"
      },
      "items": [
        {
          "text": "Y equidad, y todo buen camino.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.9",
            "verseOrgIds": [
              "PRO.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuando la sabiduría entrare en tu corazón,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.10",
            "verseOrgIds": [
              "PRO.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 2:10"
      },
      "items": [
        {
          "text": "Y la ciencia fuere dulce á tu alma,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.10",
            "verseOrgIds": [
              "PRO.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "El consejo te guardará,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.11",
            "verseOrgIds": [
              "PRO.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 2:11"
      },
      "items": [
        {
          "text": "Te preservará la inteligencia:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.11",
            "verseOrgIds": [
              "PRO.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Para librarte del mal camino,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.12",
            "verseOrgIds": [
              "PRO.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 2:12"
      },
      "items": [
        {
          "text": "De los hombres que hablan perversidades;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.12",
            "verseOrgIds": [
              "PRO.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que dejan las veredas derechas,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.13",
            "verseOrgIds": [
              "PRO.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 2:13"
      },
      "items": [
        {
          "text": "Por andar en caminos tenebrosos;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.13",
            "verseOrgIds": [
              "PRO.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.14",
            "verseOrgIds": [
              "PRO.2.14"
            ]
          }
        },
        {
          "text": "se alegran haciendo mal,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.14",
            "verseOrgIds": [
              "PRO.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 2:14"
      },
      "items": [
        {
          "text": "Que",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.14",
            "verseOrgIds": [
              "PRO.2.14"
            ]
          }
        },
        {
          "text": "se huelgan en las perversidades del vicio;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.14",
            "verseOrgIds": [
              "PRO.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuyas veredas son torcidas,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.15",
            "verseOrgIds": [
              "PRO.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 2:15"
      },
      "items": [
        {
          "text": "Y torcidos sus caminos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.15",
            "verseOrgIds": [
              "PRO.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Para librarte de la mujer extraña,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.16",
            "verseOrgIds": [
              "PRO.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 2:16"
      },
      "items": [
        {
          "text": "De la ajena que halaga con sus palabras;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.16",
            "verseOrgIds": [
              "PRO.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que desampara el príncipe de su mocedad,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.17",
            "verseOrgIds": [
              "PRO.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 2:17"
      },
      "items": [
        {
          "text": "Y se olvida del pacto de su Dios.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.17",
            "verseOrgIds": [
              "PRO.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por lo cual",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.18",
            "verseOrgIds": [
              "PRO.2.18"
            ]
          }
        },
        {
          "text": "su casa está inclinada á la muerte,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.18",
            "verseOrgIds": [
              "PRO.2.18"
            ]
          }
        }
