          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Para que andes por el camino de los buenos,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.20",
            "verseOrgIds": [
              "PRO.2.20"
            ]
          }
        }
