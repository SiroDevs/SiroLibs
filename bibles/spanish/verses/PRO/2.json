      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 2:18"
      },
      "items": [
        {
          "text": "Y sus veredas hacia los muertos:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.18",
            "verseOrgIds": [
              "PRO.2.18"
            ]
          }
        }
      ]
    },
    {
