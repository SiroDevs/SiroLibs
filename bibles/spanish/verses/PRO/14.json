{
  "id": "PRO.14",
  "number": "14",
  "bookId": "PRO",
  "reference": "Proverbios 14",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "PRO 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "LA",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.1",
            "verseOrgIds": [
              "PRO.14.1"
            ]
          }
        },
        {
          "text": "mujer sabia edifica su casa:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.1",
            "verseOrgIds": [
              "PRO.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:1"
      },
      "items": [
        {
          "text": "Mas la necia con sus manos la derriba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.1",
            "verseOrgIds": [
              "PRO.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que camina en su rectitud teme á Jehová:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.2",
            "verseOrgIds": [
              "PRO.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:2"
      },
      "items": [
        {
          "text": "Mas el pervertido en sus caminos lo menosprecia.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.2",
            "verseOrgIds": [
              "PRO.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "En la boca del necio está la vara de la soberbia:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.3",
            "verseOrgIds": [
              "PRO.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:3"
      },
      "items": [
        {
          "text": "Mas los labios de los sabios los guardarán.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.3",
            "verseOrgIds": [
              "PRO.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sin bueyes el granero está limpio:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.4",
            "verseOrgIds": [
              "PRO.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:4"
      },
      "items": [
        {
          "text": "Mas por la fuerza del buey hay abundancia de pan.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.4",
            "verseOrgIds": [
              "PRO.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "El testigo verdadero no mentirá:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.5",
            "verseOrgIds": [
              "PRO.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:5"
      },
      "items": [
        {
          "text": "Mas el testigo falso hablará mentiras.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.5",
            "verseOrgIds": [
              "PRO.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Busca el escarnecedor la sabiduría, y no",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.6",
            "verseOrgIds": [
              "PRO.14.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "la halla:",
              "type": "text",
              "attrs": {
                "verseId": "PRO.14.6",
                "verseOrgIds": [
                  "PRO.14.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:6"
      },
      "items": [
        {
          "text": "Mas la sabiduría al hombre entendido es fácil.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.6",
            "verseOrgIds": [
              "PRO.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vete de delante del hombre necio,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.7",
            "verseOrgIds": [
              "PRO.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:7"
      },
      "items": [
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.7",
            "verseOrgIds": [
              "PRO.14.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "en él",
              "type": "text",
              "attrs": {
                "verseId": "PRO.14.7",
                "verseOrgIds": [
                  "PRO.14.7"
                ]
              }
            }
          ]
        },
        {
          "text": "no advertirás labios de ciencia.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.7",
            "verseOrgIds": [
              "PRO.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "La ciencia del cuerdo es entender su camino:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.8",
            "verseOrgIds": [
              "PRO.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:8"
      },
      "items": [
        {
          "text": "Mas la indiscreción de los necios es engaño.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.8",
            "verseOrgIds": [
              "PRO.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los necios se mofan del pecado:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.9",
            "verseOrgIds": [
              "PRO.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:9"
      },
      "items": [
        {
          "text": "Mas entre los rectos hay favor.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.9",
            "verseOrgIds": [
              "PRO.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "El corazón conoce la amargura de su alma;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.10",
            "verseOrgIds": [
              "PRO.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:10"
      },
      "items": [
        {
          "text": "Y extraño no se entrometerá en su alegría.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.10",
            "verseOrgIds": [
              "PRO.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "La casa de los impíos será asolada:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.11",
            "verseOrgIds": [
              "PRO.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:11"
      },
      "items": [
        {
          "text": "Mas florecerá la tienda de los rectos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.11",
            "verseOrgIds": [
              "PRO.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hay camino que al hombre parece derecho;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.12",
            "verseOrgIds": [
              "PRO.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:12"
      },
      "items": [
        {
          "text": "Empero su fin son caminos de muerte.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.12",
            "verseOrgIds": [
              "PRO.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aun en la risa tendrá dolor el corazón;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.13",
            "verseOrgIds": [
              "PRO.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:13"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.13",
            "verseOrgIds": [
              "PRO.14.13"
            ]
          }
        },
        {
          "text": "el término de la alegría es congoja.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.13",
            "verseOrgIds": [
              "PRO.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "De sus caminos será harto el apartado de razón:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.14",
            "verseOrgIds": [
              "PRO.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:14"
      },
      "items": [
        {
          "text": "Y el hombre de bien",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.14",
            "verseOrgIds": [
              "PRO.14.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "estará contento",
              "type": "text",
              "attrs": {
                "verseId": "PRO.14.14",
                "verseOrgIds": [
                  "PRO.14.14"
                ]
              }
            }
          ]
        },
        {
          "text": "del",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.14",
            "verseOrgIds": [
              "PRO.14.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "suyo.",
              "type": "text",
              "attrs": {
                "verseId": "PRO.14.14",
                "verseOrgIds": [
                  "PRO.14.14"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "El simple cree á toda palabra:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.15",
            "verseOrgIds": [
              "PRO.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:15"
      },
      "items": [
        {
          "text": "Mas el avisado entiende sus pasos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.15",
            "verseOrgIds": [
              "PRO.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Proverbios sobre",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 diversos asuntos.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "El sabio teme, y se aparta del mal:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.16",
            "verseOrgIds": [
              "PRO.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:16"
      },
      "items": [
        {
          "text": "Mas el necio se arrebata, y confía.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.16",
            "verseOrgIds": [
              "PRO.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que presto se enoja, hará locura:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.17",
            "verseOrgIds": [
              "PRO.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:17"
      },
      "items": [
        {
          "text": "Y el hombre malicioso será aborrecido.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.17",
            "verseOrgIds": [
              "PRO.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los simples heredarán necedad:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.18",
            "verseOrgIds": [
              "PRO.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:18"
      },
      "items": [
        {
          "text": "Mas los cuerdos se coronarán de sabiduría.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.18",
            "verseOrgIds": [
              "PRO.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los malos se inclinarán delante de los buenos,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.19",
            "verseOrgIds": [
              "PRO.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:19"
      },
      "items": [
        {
          "text": "Y los impíos á las puertas del justo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.19",
            "verseOrgIds": [
              "PRO.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "El pobre es odioso aun á su amigo:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.20",
            "verseOrgIds": [
              "PRO.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:20"
      },
      "items": [
        {
          "text": "Pero muchos son los que aman al rico.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.20",
            "verseOrgIds": [
              "PRO.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Peca el que menosprecia á su prójimo:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.21",
            "verseOrgIds": [
              "PRO.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:21"
      },
      "items": [
        {
          "text": "Mas el que tiene misericordia de los pobres, es bienaventurado.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.21",
            "verseOrgIds": [
              "PRO.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿No yerran los que piensan mal?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.22",
            "verseOrgIds": [
              "PRO.14.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:22"
      },
      "items": [
        {
          "text": "Misericordia empero y verdad",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.22",
            "verseOrgIds": [
              "PRO.14.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "alcanzarán",
              "type": "text",
              "attrs": {
                "verseId": "PRO.14.22",
                "verseOrgIds": [
                  "PRO.14.22"
                ]
              }
            }
          ]
        },
        {
          "text": "los que piensan bien.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.22",
            "verseOrgIds": [
              "PRO.14.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "En toda labor hay fruto:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.23",
            "verseOrgIds": [
              "PRO.14.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:23"
      },
      "items": [
        {
          "text": "Mas la palabra de los labios solamente empobrece.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.23",
            "verseOrgIds": [
              "PRO.14.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Las riquezas de los sabios son su corona:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.24",
            "verseOrgIds": [
              "PRO.14.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:24"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Mas",
              "type": "text",
              "attrs": {
                "verseId": "PRO.14.24",
                "verseOrgIds": [
                  "PRO.14.24"
                ]
              }
            }
          ]
        },
        {
          "text": "es infatuación la insensatez de los necios.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.24",
            "verseOrgIds": [
              "PRO.14.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "El testigo verdadero libra las almas:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.25",
            "verseOrgIds": [
              "PRO.14.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:25"
      },
      "items": [
        {
          "text": "Mas el engañoso hablará mentiras.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.25",
            "verseOrgIds": [
              "PRO.14.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "En el temor de Jehová está la fuerte confianza;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.26",
            "verseOrgIds": [
              "PRO.14.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:26"
      },
      "items": [
        {
          "text": "Y esperanza tendrán sus hijos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.26",
            "verseOrgIds": [
              "PRO.14.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "El temor de Jehová es manantial de vida,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.27",
            "verseOrgIds": [
              "PRO.14.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:27"
      },
      "items": [
        {
          "text": "Para apartarse de los lazos de la muerte.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.27",
            "verseOrgIds": [
              "PRO.14.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "En la multitud de pueblo está la gloria del rey:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.28",
            "verseOrgIds": [
              "PRO.14.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:28"
      },
      "items": [
        {
          "text": "Y en la falta de pueblo la flaqueza del príncipe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.28",
            "verseOrgIds": [
              "PRO.14.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PRO 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que tarde se aira, es grande de entendimiento:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.29",
            "verseOrgIds": [
              "PRO.14.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:29"
      },
      "items": [
        {
          "text": "Mas el corto de espíritu engrandece el desatino.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.29",
            "verseOrgIds": [
              "PRO.14.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PRO 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "El corazón apacible es vida de las carnes:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.30",
            "verseOrgIds": [
              "PRO.14.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:30"
      },
      "items": [
        {
          "text": "Mas",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.30",
            "verseOrgIds": [
              "PRO.14.30"
            ]
          }
        },
        {
          "text": "la envidia, pudrimiento de huesos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.30",
            "verseOrgIds": [
              "PRO.14.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PRO 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que oprime al pobre, afrenta á su Hacedor:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.31",
            "verseOrgIds": [
              "PRO.14.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:31"
      },
      "items": [
        {
          "text": "Mas el que tiene misericordia del pobre, lo honra.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.31",
            "verseOrgIds": [
              "PRO.14.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "PRO 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por su maldad será lanzado el impío:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.32",
            "verseOrgIds": [
              "PRO.14.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:32"
      },
      "items": [
        {
          "text": "Mas",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.32",
            "verseOrgIds": [
              "PRO.14.32"
            ]
          }
        },
        {
          "text": "el justo en su muerte tiene esperanza.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.32",
            "verseOrgIds": [
              "PRO.14.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "PRO 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "En el corazón del cuerdo reposa la sabiduría;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.33",
            "verseOrgIds": [
              "PRO.14.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:33"
      },
      "items": [
        {
          "text": "Y es conocida en medio de los necios.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.33",
            "verseOrgIds": [
              "PRO.14.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "PRO 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "La justicia engrandece la nación:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.34",
            "verseOrgIds": [
              "PRO.14.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:34"
      },
      "items": [
        {
          "text": "Mas el pecado es afrenta de las naciones.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.34",
            "verseOrgIds": [
              "PRO.14.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "PRO 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "La benevolencia del rey es para con el ministro entendido:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.35",
            "verseOrgIds": [
              "PRO.14.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 14:35"
      },
      "items": [
        {
          "text": "Mas su enojo",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.35",
            "verseOrgIds": [
              "PRO.14.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "contra",
              "type": "text",
              "attrs": {
                "verseId": "PRO.14.35",
                "verseOrgIds": [
                  "PRO.14.35"
                ]
              }
            }
          ]
        },
        {
          "text": "el que",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.35",
            "verseOrgIds": [
              "PRO.14.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "lo",
              "type": "text",
              "attrs": {
                "verseId": "PRO.14.35",
                "verseOrgIds": [
                  "PRO.14.35"
                ]
              }
            }
          ]
        },
        {
          "text": "avergüenza.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.35",
            "verseOrgIds": [
              "PRO.14.35"
            ]
          }
        }
      ]
    }
  ],
