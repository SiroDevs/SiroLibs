      "attrs": {
        "style": "q",
        "vid": "PRO 12:18"
      },
      "items": [
        {
          "text": "Mas la lengua de los sabios es medicina.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.18",
            "verseOrgIds": [
              "PRO.12.18"
            ]
          }
