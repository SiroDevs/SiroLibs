          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Engaño hay en el corazón de los que piensan mal:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.20",
            "verseOrgIds": [
              "PRO.12.20"
            ]
          }
