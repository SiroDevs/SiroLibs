          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "El labio de verdad permanecerá para siempre:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.19",
            "verseOrgIds": [
              "PRO.12.19"
            ]
          }
