{
  "id": "PRO.12",
  "number": "12",
  "bookId": "PRO",
  "reference": "Proverbios 12",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "PRO 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "EL que ama la corrección ama la sabiduría:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.1",
            "verseOrgIds": [
              "PRO.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 12:1"
      },
      "items": [
        {
          "text": "Mas el que aborrece la reprensión, es ignorante.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.1",
            "verseOrgIds": [
              "PRO.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "El bueno alcanzará favor de Jehová:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.2",
            "verseOrgIds": [
              "PRO.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 12:2"
      },
      "items": [
        {
          "text": "Mas él condenará al hombre de malos pensamientos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.2",
            "verseOrgIds": [
              "PRO.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "El hombre no se afirmará por medio de la impiedad:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.3",
            "verseOrgIds": [
              "PRO.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 12:3"
      },
      "items": [
        {
          "text": "Mas la raíz de los justos no será movida.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.3",
            "verseOrgIds": [
              "PRO.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "La mujer virtuosa corona es de su marido:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.4",
            "verseOrgIds": [
              "PRO.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 12:4"
      },
      "items": [
        {
          "text": "Mas la mala, como",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.4",
            "verseOrgIds": [
              "PRO.12.4"
            ]
          }
        },
        {
          "text": "carcoma en sus huesos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.4",
            "verseOrgIds": [
              "PRO.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los pensamientos de los justos son rectitud;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.5",
            "verseOrgIds": [
              "PRO.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 12:5"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Mas",
              "type": "text",
              "attrs": {
                "verseId": "PRO.12.5",
                "verseOrgIds": [
                  "PRO.12.5"
                ]
              }
            }
          ]
        },
        {
          "text": "los consejos de los impíos, engaño.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.5",
            "verseOrgIds": [
              "PRO.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Las palabras de los impíos son para acechar la sangre:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.6",
            "verseOrgIds": [
              "PRO.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 12:6"
      },
      "items": [
        {
          "text": "Mas la boca de los rectos los librará.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.6",
            "verseOrgIds": [
              "PRO.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Dios",
              "type": "text",
              "attrs": {
                "verseId": "PRO.12.7",
                "verseOrgIds": [
                  "PRO.12.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.7",
            "verseOrgIds": [
              "PRO.12.7"
            ]
          }
        },
        {
          "text": "trastornará á los impíos, y no serán más:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.7",
            "verseOrgIds": [
              "PRO.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 12:7"
      },
      "items": [
        {
          "text": "Mas la casa de los justos permanecerá.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.7",
            "verseOrgIds": [
              "PRO.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Según su sabiduría es alabado el hombre:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.8",
            "verseOrgIds": [
              "PRO.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 12:8"
      },
      "items": [
        {
          "text": "Mas el perverso de corazón será en menosprecio.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.8",
            "verseOrgIds": [
              "PRO.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mejor es el que es menospreciado y tiene servidores,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.9",
            "verseOrgIds": [
              "PRO.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 12:9"
      },
      "items": [
        {
          "text": "Que el que se precia, y carece de pan.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.9",
            "verseOrgIds": [
              "PRO.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "El justo atiende á la vida de su bestia:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.10",
            "verseOrgIds": [
              "PRO.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 12:10"
      },
      "items": [
        {
          "text": "Mas las entrañas de los impíos son crueles.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.10",
            "verseOrgIds": [
              "PRO.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que labra su tierra, se hartará de pan:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.11",
            "verseOrgIds": [
              "PRO.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 12:11"
      },
      "items": [
        {
          "text": "Mas el que sigue los vagabundos es falto de entendimiento.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.11",
            "verseOrgIds": [
              "PRO.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Desea el impío la red de los malos:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.12",
            "verseOrgIds": [
              "PRO.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 12:12"
      },
      "items": [
        {
          "text": "Mas la raíz de los justos dará",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.12",
            "verseOrgIds": [
              "PRO.12.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "fruto.",
              "type": "text",
              "attrs": {
                "verseId": "PRO.12.12",
                "verseOrgIds": [
                  "PRO.12.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Proverbios sobre",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 diversos asuntos.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "El impío es enredado en la prevaricación de sus labios:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.13",
            "verseOrgIds": [
              "PRO.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 12:13"
      },
      "items": [
        {
          "text": "Mas el justo saldrá de la tribulación.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.13",
            "verseOrgIds": [
              "PRO.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "El hombre será",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.14",
            "verseOrgIds": [
              "PRO.12.14"
            ]
          }
        },
        {
          "text": "harto de bien del fruto de su boca:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.14",
            "verseOrgIds": [
              "PRO.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 12:14"
      },
      "items": [
        {
          "text": "Y la paga de las manos del hombre le será dada.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.14",
            "verseOrgIds": [
              "PRO.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "El camino del necio es derecho en su opinión:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.15",
            "verseOrgIds": [
              "PRO.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 12:15"
      },
      "items": [
        {
          "text": "Mas el que obedece al consejo es sabio.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.15",
            "verseOrgIds": [
              "PRO.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "El necio luego al punto da á conocer su ira:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.16",
            "verseOrgIds": [
              "PRO.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 12:16"
      },
      "items": [
        {
          "text": "Mas el que disimula la injuria es cuerdo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.16",
            "verseOrgIds": [
              "PRO.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que habla verdad, declara justicia;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.17",
            "verseOrgIds": [
              "PRO.12.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 12:17"
      },
      "items": [
        {
          "text": "Mas el testigo mentiroso, engaño.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.17",
            "verseOrgIds": [
              "PRO.12.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hay quienes hablan como",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.18",
            "verseOrgIds": [
              "PRO.12.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "dando",
              "type": "text",
              "attrs": {
                "verseId": "PRO.12.18",
                "verseOrgIds": [
                  "PRO.12.18"
                ]
              }
            }
          ]
        },
        {
          "text": "estocadas de espada:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.18",
            "verseOrgIds": [
              "PRO.12.18"
            ]
          }
        }
