      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 12:19"
      },
      "items": [
        {
          "text": "Mas la lengua de mentira por un momento.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.19",
            "verseOrgIds": [
              "PRO.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
