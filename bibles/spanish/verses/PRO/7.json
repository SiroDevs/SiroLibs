          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Caminos del sepulcro son su casa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.27",
            "verseOrgIds": [
              "PRO.7.27"
            ]
          }
        }
      ]
    },
