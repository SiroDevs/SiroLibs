          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque á muchos ha hecho caer heridos;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.26",
            "verseOrgIds": [
              "PRO.7.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 7:26"
      },
      "items": [
        {
          "text": "Y aun",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.26",
            "verseOrgIds": [
              "PRO.7.26"
            ]
          }
        },
        {
          "text": "los más fuertes han sido muertos por ella.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.26",
            "verseOrgIds": [
              "PRO.7.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
