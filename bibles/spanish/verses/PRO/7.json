      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vase en pos de ella luego,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.22",
            "verseOrgIds": [
              "PRO.7.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 7:22"
      },
      "items": [
        {
          "text": "Como va el buey al degolladero,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.22",
            "verseOrgIds": [
              "PRO.7.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 7:22"
      },
      "items": [
        {
          "text": "Y como el loco á las prisiones para ser castigado;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.22",
            "verseOrgIds": [
              "PRO.7.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Como",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.23",
            "verseOrgIds": [
              "PRO.7.23"
            ]
          }
        },
        {
          "text": "el ave que se apresura al lazo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.23",
            "verseOrgIds": [
              "PRO.7.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 7:23"
      },
      "items": [
        {
          "text": "Y no sabe que es contra su vida,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.23",
            "verseOrgIds": [
              "PRO.7.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 7:23"
      },
      "items": [
        {
          "text": "Hasta que la saeta traspasó su hígado.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.23",
            "verseOrgIds": [
              "PRO.7.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahora pues, hijos, oidme,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.24",
            "verseOrgIds": [
              "PRO.7.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 7:24"
      },
      "items": [
        {
          "text": "Y estad atentos á las razones de mi boca.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.24",
            "verseOrgIds": [
              "PRO.7.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "No se aparte á sus caminos tu corazón;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.25",
            "verseOrgIds": [
              "PRO.7.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 7:25"
      },
      "items": [
        {
          "text": "No yerres en sus veredas.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.25",
            "verseOrgIds": [
              "PRO.7.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
