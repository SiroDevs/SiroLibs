      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 7:27"
      },
      "items": [
        {
          "text": "Que descienden á las",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.27",
            "verseOrgIds": [
              "PRO.7.27"
            ]
          }
        },
        {
          "text": "cámaras de la muerte.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.27",
            "verseOrgIds": [
              "PRO.7.27"
            ]
          }
        }
