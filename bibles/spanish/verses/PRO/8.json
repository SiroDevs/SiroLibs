{
  "id": "PRO.8",
  "number": "8",
  "bookId": "PRO",
  "reference": "Proverbios 8",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "PRO 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿NO clama",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.1",
            "verseOrgIds": [
              "PRO.8.1"
            ]
          }
        },
        {
          "text": "la sabiduría,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.1",
            "verseOrgIds": [
              "PRO.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:1"
      },
      "items": [
        {
          "text": "Y da su voz la inteligencia?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.1",
            "verseOrgIds": [
              "PRO.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "En los",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.2",
            "verseOrgIds": [
              "PRO.8.2"
            ]
          }
        },
        {
          "text": "altos cabezos, junto al camino,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.2",
            "verseOrgIds": [
              "PRO.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:2"
      },
      "items": [
        {
          "text": "A las encrucijadas de las veredas se para;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.2",
            "verseOrgIds": [
              "PRO.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "En el lugar de las",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.3",
            "verseOrgIds": [
              "PRO.8.3"
            ]
          }
        },
        {
          "text": "puertas, á la entrada de la ciudad,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.3",
            "verseOrgIds": [
              "PRO.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:3"
      },
      "items": [
        {
          "text": "A la entrada de las puertas da voces:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.3",
            "verseOrgIds": [
              "PRO.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh hombres, á vosotros clamo;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.4",
            "verseOrgIds": [
              "PRO.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:4"
      },
      "items": [
        {
          "text": "Y mi voz es á los hijos de los hombres.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.4",
            "verseOrgIds": [
              "PRO.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entended, simples, discreción;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.5",
            "verseOrgIds": [
              "PRO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:5"
      },
      "items": [
        {
          "text": "Y vosotros, locos, entrad en cordura.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.5",
            "verseOrgIds": [
              "PRO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oid, porque hablaré cosas",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.6",
            "verseOrgIds": [
              "PRO.8.6"
            ]
          }
        },
        {
          "text": "excelentes;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.6",
            "verseOrgIds": [
              "PRO.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:6"
      },
      "items": [
        {
          "text": "Y abriré mis labios para cosas rectas.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.6",
            "verseOrgIds": [
              "PRO.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque mi boca hablará verdad,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.7",
            "verseOrgIds": [
              "PRO.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:7"
      },
      "items": [
        {
          "text": "Y la impiedad abominan mis labios.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.7",
            "verseOrgIds": [
              "PRO.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "En justicia son todas las razones de mi boca;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.8",
            "verseOrgIds": [
              "PRO.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:8"
      },
      "items": [
        {
          "text": "No hay en ellas cosa perversa ni torcida.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.8",
            "verseOrgIds": [
              "PRO.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Todas ellas son rectas al que entiende,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.9",
            "verseOrgIds": [
              "PRO.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:9"
      },
      "items": [
        {
          "text": "Y razonables á los que han hallado sabiduría.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.9",
            "verseOrgIds": [
              "PRO.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Recibid mi enseñanza, y no plata;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.10",
            "verseOrgIds": [
              "PRO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:10"
      },
      "items": [
        {
          "text": "Y ciencia antes que el oro escogido.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.10",
            "verseOrgIds": [
              "PRO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque mejor es la sabiduría que las piedras preciosas;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.11",
            "verseOrgIds": [
              "PRO.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:11"
      },
      "items": [
        {
          "text": "Y todas las cosas que se pueden desear, no son de comparar con ella.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.11",
            "verseOrgIds": [
              "PRO.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo, la sabiduría, habito con la discreción,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.12",
            "verseOrgIds": [
              "PRO.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:12"
      },
      "items": [
        {
          "text": "Y hallo la ciencia de los consejos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.12",
            "verseOrgIds": [
              "PRO.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "El temor de Jehová es aborrecer el mal;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.13",
            "verseOrgIds": [
              "PRO.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:13"
      },
      "items": [
        {
          "text": "La soberbia y la arrogancia, y el mal camino",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.13",
            "verseOrgIds": [
              "PRO.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:13"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.13",
            "verseOrgIds": [
              "PRO.8.13"
            ]
          }
        },
        {
          "text": "la boca perversa, aborrezco.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.13",
            "verseOrgIds": [
              "PRO.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Conmigo está el consejo y el ser;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.14",
            "verseOrgIds": [
              "PRO.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:14"
      },
      "items": [
        {
          "text": "Yo soy la inteligencia; mía es la fortaleza.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.14",
            "verseOrgIds": [
              "PRO.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por mí reinan los reyes,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.15",
            "verseOrgIds": [
              "PRO.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:15"
      },
      "items": [
        {
          "text": "Y los príncipes determinan justicia.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.15",
            "verseOrgIds": [
              "PRO.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Las obras y las delicias",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 de la sabiduría.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por mí dominan los príncipes,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.16",
            "verseOrgIds": [
              "PRO.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:16"
      },
      "items": [
        {
          "text": "Y todos los gobernadores juzgan la tierra.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.16",
            "verseOrgIds": [
              "PRO.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo amo á los que me aman;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.17",
            "verseOrgIds": [
              "PRO.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:17"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.17",
            "verseOrgIds": [
              "PRO.8.17"
            ]
          }
        },
        {
          "text": "me hallan los que madrugando me buscan.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.17",
            "verseOrgIds": [
              "PRO.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Las riquezas y la honra están conmigo;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.18",
            "verseOrgIds": [
              "PRO.8.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:18"
      },
      "items": [
        {
          "text": "Sólidas riquezas, y justicia.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.18",
            "verseOrgIds": [
              "PRO.8.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mejor es mi fruto que el oro, y que el",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.19",
            "verseOrgIds": [
              "PRO.8.19"
            ]
          }
        },
        {
          "text": "oro refinado;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.19",
            "verseOrgIds": [
              "PRO.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:19"
      },
      "items": [
        {
          "text": "Y mi rédito",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.19",
            "verseOrgIds": [
              "PRO.8.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "mejor",
              "type": "text",
              "attrs": {
                "verseId": "PRO.8.19",
                "verseOrgIds": [
                  "PRO.8.19"
                ]
              }
            }
          ]
        },
        {
          "text": "que la plata escogida.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.19",
            "verseOrgIds": [
              "PRO.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por vereda de justicia guiaré,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.20",
            "verseOrgIds": [
              "PRO.8.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:20"
      },
      "items": [
        {
          "text": "Por en medio de sendas de juicio;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.20",
            "verseOrgIds": [
              "PRO.8.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Para hacer heredar á mis amigos el ser,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.21",
            "verseOrgIds": [
              "PRO.8.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:21"
      },
      "items": [
        {
          "text": "Y que yo hincha sus tesoros.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.21",
            "verseOrgIds": [
              "PRO.8.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehová me poseía en el principio de su camino,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.22",
            "verseOrgIds": [
              "PRO.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:22"
      },
      "items": [
        {
          "text": "Ya de antiguo, antes de sus obras.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.22",
            "verseOrgIds": [
              "PRO.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eternalmente tuve el principado, desde el principio,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.23",
            "verseOrgIds": [
              "PRO.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:23"
      },
      "items": [
        {
          "text": "Antes de la tierra.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.23",
            "verseOrgIds": [
              "PRO.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antes de los abismos fuí engendrada;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.24",
            "verseOrgIds": [
              "PRO.8.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:24"
      },
      "items": [
        {
          "text": "Antes que fuesen las fuentes de las muchas aguas.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.24",
            "verseOrgIds": [
              "PRO.8.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antes que los montes fuesen fundados,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.25",
            "verseOrgIds": [
              "PRO.8.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:25"
      },
      "items": [
        {
          "text": "Antes de los collados, era yo engendrada:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.25",
            "verseOrgIds": [
              "PRO.8.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "No había aún hecho la tierra, ni las campiñas,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.26",
            "verseOrgIds": [
              "PRO.8.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:26"
      },
      "items": [
        {
          "text": "Ni el principio del polvo del mundo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.26",
            "verseOrgIds": [
              "PRO.8.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuando formaba los cielos, allí estaba yo;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.27",
            "verseOrgIds": [
              "PRO.8.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:27"
      },
      "items": [
        {
          "text": "Cuando señalaba por compás la sobrefaz del abismo;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.27",
            "verseOrgIds": [
              "PRO.8.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuando afirmaba los cielos arriba,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.28",
            "verseOrgIds": [
              "PRO.8.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:28"
      },
      "items": [
        {
          "text": "Cuando afirmaba las fuentes del abismo;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.28",
            "verseOrgIds": [
              "PRO.8.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PRO 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuando ponía á la mar su estatuto,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.29",
            "verseOrgIds": [
              "PRO.8.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:29"
      },
      "items": [
        {
          "text": "Y á las aguas, que no pasasen su mandamiento;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.29",
            "verseOrgIds": [
              "PRO.8.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:29"
      },
      "items": [
        {
          "text": "Cuando establecía los fundamentos de la tierra;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.29",
            "verseOrgIds": [
              "PRO.8.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PRO 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Con él estaba yo ordenándolo todo;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.30",
            "verseOrgIds": [
              "PRO.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:30"
      },
      "items": [
        {
          "text": "Y fuí",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.30",
            "verseOrgIds": [
              "PRO.8.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "su",
              "type": "text",
              "attrs": {
                "verseId": "PRO.8.30",
                "verseOrgIds": [
                  "PRO.8.30"
                ]
              }
            }
          ]
        },
        {
          "text": "delicia todos los días,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.30",
            "verseOrgIds": [
              "PRO.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:30"
      },
      "items": [
        {
          "text": "Teniendo solaz delante de él en todo tiempo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.30",
            "verseOrgIds": [
              "PRO.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PRO 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huélgome en la parte habitable de su tierra;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.31",
            "verseOrgIds": [
              "PRO.8.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:31"
      },
      "items": [
        {
          "text": "Y mis delicias son con los hijos de los hombres.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.31",
            "verseOrgIds": [
              "PRO.8.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "PRO 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahora pues, hijos, oidme:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.32",
            "verseOrgIds": [
              "PRO.8.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:32"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.32",
            "verseOrgIds": [
              "PRO.8.32"
            ]
          }
        },
        {
          "text": "bienaventurados los que guardaren mis caminos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.32",
            "verseOrgIds": [
              "PRO.8.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "PRO 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atended el consejo, y sed sabios,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.33",
            "verseOrgIds": [
              "PRO.8.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:33"
      },
      "items": [
        {
          "text": "Y no lo menospreciéis.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.33",
            "verseOrgIds": [
              "PRO.8.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "PRO 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bienaventurado el hombre que me oye,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.34",
            "verseOrgIds": [
              "PRO.8.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:34"
      },
      "items": [
        {
          "text": "Velando á mis puertas cada día,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.34",
            "verseOrgIds": [
              "PRO.8.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:34"
      },
      "items": [
        {
          "text": "Guardando los umbrales de mis entradas.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.34",
            "verseOrgIds": [
              "PRO.8.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "PRO 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque el que me hallare,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.35",
            "verseOrgIds": [
              "PRO.8.35"
            ]
          }
        },
        {
          "text": "hallará la vida,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.35",
            "verseOrgIds": [
              "PRO.8.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 8:35"
      },
      "items": [
        {
          "text": "Y alcanzará el favor de Jehová.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.35",
            "verseOrgIds": [
              "PRO.8.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "PRO 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas el que peca contra mí,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.36",
            "verseOrgIds": [
              "PRO.8.36"
            ]
          }
        },
        {
