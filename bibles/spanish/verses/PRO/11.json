{
  "id": "PRO.11",
  "number": "11",
  "bookId": "PRO",
  "reference": "Proverbios 11",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "PRO 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "EL",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.1",
            "verseOrgIds": [
              "PRO.11.1"
            ]
          }
        },
        {
          "text": "peso falso abominación es á Jehová:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.1",
            "verseOrgIds": [
              "PRO.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 11:1"
      },
      "items": [
        {
          "text": "Mas la pesa cabal le agrada.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.1",
            "verseOrgIds": [
              "PRO.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuando viene la soberbia, viene también la deshonra:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.2",
            "verseOrgIds": [
              "PRO.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 11:2"
      },
      "items": [
        {
          "text": "Mas con los humildes es la sabiduría.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.2",
            "verseOrgIds": [
              "PRO.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "La integridad de los rectos los encaminará:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.3",
            "verseOrgIds": [
              "PRO.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 11:3"
      },
      "items": [
        {
          "text": "Mas destruirá á los pecadores la perversidad de ellos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.3",
            "verseOrgIds": [
              "PRO.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "No aprovecharán las riquezas en el día de la ira:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.4",
            "verseOrgIds": [
              "PRO.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 11:4"
      },
      "items": [
        {
          "text": "Mas la justicia librará de muerte.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.4",
            "verseOrgIds": [
              "PRO.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "La justicia del perfecto enderezará su camino: mas el impío por su impiedad caerá.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.5",
            "verseOrgIds": [
              "PRO.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "La justicia de los rectos los librará:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.6",
            "verseOrgIds": [
              "PRO.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 11:6"
      },
      "items": [
        {
          "text": "Mas",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.6",
            "verseOrgIds": [
              "PRO.11.6"
            ]
          }
        },
        {
          "text": "los pecadores en su pecado serán presos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.6",
            "verseOrgIds": [
              "PRO.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuando muere el hombre impío, perece",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.7",
            "verseOrgIds": [
              "PRO.11.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "su",
              "type": "text",
              "attrs": {
                "verseId": "PRO.11.7",
                "verseOrgIds": [
                  "PRO.11.7"
                ]
              }
            }
          ]
        },
        {
          "text": "esperanza;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.7",
            "verseOrgIds": [
              "PRO.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 11:7"
      },
      "items": [
        {
          "text": "Y la espectativa de los malos perecerá.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.7",
            "verseOrgIds": [
              "PRO.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "El justo es librado de la tribulación:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.8",
            "verseOrgIds": [
              "PRO.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 11:8"
      },
      "items": [
        {
          "text": "Mas el impío viene en lugar suyo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.8",
            "verseOrgIds": [
              "PRO.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "El hipócrita con la boca daña á su prójimo:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.9",
            "verseOrgIds": [
              "PRO.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 11:9"
      },
      "items": [
        {
          "text": "Mas los justos son librados con la sabiduría.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.9",
            "verseOrgIds": [
              "PRO.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "En el bien de los justos la ciudad se alegra:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.10",
            "verseOrgIds": [
              "PRO.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 11:10"
      },
      "items": [
        {
          "text": "Mas cuando los impíos perecen, hay fiestas.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.10",
            "verseOrgIds": [
              "PRO.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por la bendición de los rectos la ciudad será engrandecida:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.11",
            "verseOrgIds": [
              "PRO.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 11:11"
      },
      "items": [
        {
          "text": "Mas por la boca de los impíos ella será trastornada.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.11",
            "verseOrgIds": [
              "PRO.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que carece de entendimiento, menosprecia á su prójimo:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.12",
            "verseOrgIds": [
              "PRO.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 11:12"
      },
      "items": [
        {
          "text": "Mas el hombre prudente calla.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.12",
            "verseOrgIds": [
              "PRO.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que anda en chismes, descubre el secreto:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.13",
            "verseOrgIds": [
              "PRO.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 11:13"
      },
      "items": [
        {
          "text": "Mas el de espíritu fiel encubre la cosa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.13",
            "verseOrgIds": [
              "PRO.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuando faltaren las industrias, caerá el pueblo:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.14",
            "verseOrgIds": [
              "PRO.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 11:14"
      },
      "items": [
        {
          "text": "Mas en la multitud de consejeros hay salud.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.14",
            "verseOrgIds": [
              "PRO.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Con ansiedad será afligido el que fiare al extraño:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.15",
            "verseOrgIds": [
              "PRO.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 11:15"
      },
      "items": [
        {
          "text": "Mas el que aborreciere las fianzas",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.15",
            "verseOrgIds": [
              "PRO.11.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "vivirá",
              "type": "text",
              "attrs": {
                "verseId": "PRO.11.15",
                "verseOrgIds": [
                  "PRO.11.15"
                ]
              }
            }
          ]
        },
        {
          "text": "confiado.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.15",
            "verseOrgIds": [
              "PRO.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "La mujer graciosa tendrá honra:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.16",
            "verseOrgIds": [
              "PRO.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 11:16"
      },
      "items": [
        {
          "text": "Y los fuertes tendrán riquezas.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.16",
            "verseOrgIds": [
              "PRO.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Proverbios sobre",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 diversos asuntos.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "A su alma hace bien el hombre misericordioso:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.17",
            "verseOrgIds": [
              "PRO.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 11:17"
      },
      "items": [
        {
          "text": "Mas el cruel atormenta su carne.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.17",
            "verseOrgIds": [
              "PRO.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "El impío hace obra falsa:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.18",
            "verseOrgIds": [
              "PRO.11.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 11:18"
      },
      "items": [
        {
          "text": "Mas",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.18",
            "verseOrgIds": [
              "PRO.11.18"
            ]
          }
        },
        {
          "text": "el que sembrare justicia, tendrá galardón firme.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.18",
            "verseOrgIds": [
              "PRO.11.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Como la justicia",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.19",
            "verseOrgIds": [
              "PRO.11.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "es",
              "type": "text",
              "attrs": {
                "verseId": "PRO.11.19",
                "verseOrgIds": [
                  "PRO.11.19"
                ]
              }
            }
          ]
        },
        {
          "text": "para vida,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.19",
            "verseOrgIds": [
              "PRO.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 11:19"
      },
      "items": [
        {
          "text": "Así el que sigue el mal",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.19",
            "verseOrgIds": [
              "PRO.11.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "es",
              "type": "text",
              "attrs": {
                "verseId": "PRO.11.19",
                "verseOrgIds": [
                  "PRO.11.19"
                ]
              }
            }
          ]
        },
        {
          "text": "para su muerte.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.19",
            "verseOrgIds": [
              "PRO.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abominación son á Jehová los perversos de corazón:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.20",
            "verseOrgIds": [
              "PRO.11.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 11:20"
      },
      "items": [
        {
          "text": "Mas los perfectos de camino le son agradables.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.20",
            "verseOrgIds": [
              "PRO.11.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Aunque llegue",
              "type": "text",
              "attrs": {
                "verseId": "PRO.11.21",
                "verseOrgIds": [
                  "PRO.11.21"
                ]
              }
            }
          ]
        },
        {
          "text": "la mano á la mano, el malo no quedará sin castigo:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.21",
            "verseOrgIds": [
              "PRO.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 11:21"
      },
      "items": [
        {
          "text": "Mas la simiente de los justos escapará.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.21",
            "verseOrgIds": [
              "PRO.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zarcillo de oro en la nariz del puerco,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.22",
            "verseOrgIds": [
              "PRO.11.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 11:22"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Es",
              "type": "text",
              "attrs": {
                "verseId": "PRO.11.22",
                "verseOrgIds": [
                  "PRO.11.22"
                ]
              }
            }
          ]
        },
        {
          "text": "la mujer hermosa y apartada de razón.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.22",
            "verseOrgIds": [
              "PRO.11.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "El deseo de los justos es solamente bien:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.23",
            "verseOrgIds": [
              "PRO.11.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 11:23"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Mas",
              "type": "text",
              "attrs": {
                "verseId": "PRO.11.23",
                "verseOrgIds": [
                  "PRO.11.23"
                ]
              }
            }
          ]
        },
        {
          "text": "la esperanza de los impíos es enojo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.23",
            "verseOrgIds": [
              "PRO.11.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hay quienes",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.24",
            "verseOrgIds": [
              "PRO.11.24"
            ]
          }
        },
        {
          "text": "reparten, y les es añadido más:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.24",
            "verseOrgIds": [
              "PRO.11.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 11:24"
      },
      "items": [
        {
          "text": "Y hay quienes son escasos más de lo que es justo, mas vienen á pobreza.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.24",
            "verseOrgIds": [
              "PRO.11.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "El alma liberal será engordada:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.25",
            "verseOrgIds": [
              "PRO.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 11:25"
      },
      "items": [
        {
          "text": "Y el que saciare, él también será saciado.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.25",
            "verseOrgIds": [
              "PRO.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Al que retiene el grano, el pueblo lo maldecirá:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.26",
            "verseOrgIds": [
              "PRO.11.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 11:26"
      },
      "items": [
        {
          "text": "Mas bendición será sobre la cabeza del que vende.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.26",
            "verseOrgIds": [
              "PRO.11.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que madruga al bien, buscará favor:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.27",
            "verseOrgIds": [
              "PRO.11.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 11:27"
      },
      "items": [
        {
          "text": "Mas el que busca el mal, vendrále.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.27",
            "verseOrgIds": [
              "PRO.11.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que confía en sus riquezas, caerá:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.28",
            "verseOrgIds": [
              "PRO.11.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 11:28"
      },
      "items": [
        {
          "text": "Mas los justos reverdecerán como ramos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.28",
            "verseOrgIds": [
              "PRO.11.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PRO 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que turba su casa",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.29",
            "verseOrgIds": [
              "PRO.11.29"
            ]
          }
        },
        {
          "text": "heredará viento;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.29",
            "verseOrgIds": [
              "PRO.11.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 11:29"
      },
      "items": [
        {
          "text": "Y el necio será siervo del sabio de corazón.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.29",
            "verseOrgIds": [
              "PRO.11.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PRO 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "El fruto del justo es árbol de vida:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.30",
            "verseOrgIds": [
              "PRO.11.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 11:30"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.30",
            "verseOrgIds": [
              "PRO.11.30"
            ]
          }
        },
        {
          "text": "el que prende almas, es sabio.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.30",
            "verseOrgIds": [
              "PRO.11.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PRO 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ciertamente el justo será pagado en la tierra:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.31",
            "verseOrgIds": [
              "PRO.11.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 11:31"
      },
      "items": [
        {
          "text": "¡Cuánto más el impío y el pecador!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.31",
            "verseOrgIds": [
              "PRO.11.31"
            ]
          }
        }
      ]
    }
  ],
