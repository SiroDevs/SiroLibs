      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 27:27"
      },
      "items": [
        {
          "text": "Y para sustento de tus criadas.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.27",
            "verseOrgIds": [
              "PRO.27.27"
            ]
          }
        }
      ]
