          "text": "Por lo cual, dejada la mentira,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.25",
            "verseOrgIds": [
              "EPH.4.25"
            ]
          }
        },
        {
          "text": "hablad verdad cada uno con su prójimo; porque somos",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.25",
            "verseOrgIds": [
              "EPH.4.25"
            ]
          }
        },
        {
          "text": "miembros los unos de los otros.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.25",
            "verseOrgIds": [
              "EPH.4.25"
            ]
          }
        }
      ]
    },
    {
