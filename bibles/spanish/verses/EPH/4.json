            "number": "21",
            "style": "v",
            "sid": "EPH 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si empero lo habéis oído,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.21",
            "verseOrgIds": [
              "EPH.4.21"
            ]
          }
        },
        {
          "text": "y habéis sido por él enseñados, como la verdad está en Jesús,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.21",
            "verseOrgIds": [
              "EPH.4.21"
            ]
          }
        }
      ]
    },
    {
