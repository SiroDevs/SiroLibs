          "text": "Y vestir",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.24",
            "verseOrgIds": [
              "EPH.4.24"
            ]
          }
        },
        {
          "text": "el nuevo hombre que es criado conforme á Dios en justicia y en santidad de verdad.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.24",
            "verseOrgIds": [
              "EPH.4.24"
            ]
          }
        }
      ]
    },
    {
