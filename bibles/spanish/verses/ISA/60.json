          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "El pequeño será por mil,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.22",
            "verseOrgIds": [
              "ISA.60.22"
            ]
          }
        },
        {
          "text": "el menor, por gente fuerte. Yo Jehová á su tiempo haré que esto sea presto.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.22",
            "verseOrgIds": [
              "ISA.60.22"
            ]
          }
        }
      ]
    }
