            }
          ]
        },
        {
          "text": "Porque he aquí que Jehová sale",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.21",
            "verseOrgIds": [
              "ISA.26.21"
            ]
          }
        },
        {
          "text": "de su lugar, para visitar la maldad del morador de la tierra contra él; y la tierra descubrirá sus sangres, y no más encubrirá sus muertos.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.21",
