                "verseOrgIds": [
                  "ISA.26.19"
                ]
              }
            }
          ]
        },
        {
          "text": "mi cuerpo muerto resucitarán.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.19",
            "verseOrgIds": [
              "ISA.26.19"
            ]
          }
        },
        {
          "text": "¡Despertad y cantad, moradores del polvo! porque tu rocío,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.19",
            "verseOrgIds": [
              "ISA.26.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "cual",
              "type": "text",
              "attrs": {
                "verseId": "ISA.26.19",
                "verseOrgIds": [
                  "ISA.26.19"
                ]
              }
            }
          ]
        },
        {
          "text": "rocío de hortalizas; y la tierra echará los muertos.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.19",
            "verseOrgIds": [
              "ISA.26.19"
            ]
          }
        }
      ]
    },
