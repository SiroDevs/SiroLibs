          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tus muertos vivirán;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.19",
            "verseOrgIds": [
              "ISA.26.19"
            ]
          }
        },
        {
          "name": "char",
