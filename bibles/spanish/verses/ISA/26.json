          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Concebimos, tuvimos dolores de parto, parimos como viento: salud ninguna hicimos en la tierra, ni cayeron",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.18",
            "verseOrgIds": [
              "ISA.26.18"
            ]
          }
        },
        {
          "text": "los moradores del mundo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.18",
            "verseOrgIds": [
              "ISA.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
