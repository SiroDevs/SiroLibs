{
  "id": "PSA.139",
  "number": "139",
  "bookId": "PSA",
  "reference": "Salmos 139",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "139",
        "style": "c",
        "sid": "PSA 139"
      },
      "items": [
        {
          "text": "139",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Al Músico principal: Salmo de David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 139:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "OH Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.1",
            "verseOrgIds": [
              "PSA.139.1"
            ]
          }
        },
        {
          "text": "tú me has examinado y conocido.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.1",
            "verseOrgIds": [
              "PSA.139.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 139:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tú has conocido mi sentarme y mi levantarme,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.2",
            "verseOrgIds": [
              "PSA.139.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 139:2"
      },
      "items": [
        {
          "text": "Has entendido desde lejos mis pensamientos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.2",
            "verseOrgIds": [
              "PSA.139.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 139:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi senda y mi acostarme has rodeado,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.3",
            "verseOrgIds": [
              "PSA.139.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 139:3"
      },
      "items": [
        {
          "text": "Y estás impuesto en todos mis caminos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.3",
            "verseOrgIds": [
              "PSA.139.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 139:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pues aun no está la palabra en mi lengua,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.4",
            "verseOrgIds": [
              "PSA.139.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 139:4"
      },
      "items": [
        {
          "text": "Y he aquí, oh Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.4",
            "verseOrgIds": [
              "PSA.139.4"
            ]
          }
        },
        {
          "text": "tú la sabes toda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.4",
            "verseOrgIds": [
              "PSA.139.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 139:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Detrás y delante me guarneciste,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.5",
            "verseOrgIds": [
              "PSA.139.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 139:5"
      },
      "items": [
        {
          "text": "Y sobre mí pusiste tu mano.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.5",
            "verseOrgIds": [
              "PSA.139.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 139:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Más maravillosa es la ciencia que mi capacidad;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.6",
            "verseOrgIds": [
              "PSA.139.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 139:6"
      },
      "items": [
        {
          "text": "Alta es, no puedo comprenderla.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.6",
            "verseOrgIds": [
              "PSA.139.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 139:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Adónde me iré de tu espíritu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.7",
            "verseOrgIds": [
              "PSA.139.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 139:7"
      },
      "items": [
        {
          "text": "¿Y adónde huiré de tu presencia?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.7",
            "verseOrgIds": [
              "PSA.139.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 139:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si subiere á los cielos, allí estás tú:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.8",
            "verseOrgIds": [
              "PSA.139.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 139:8"
      },
      "items": [
        {
          "text": "Y si en abismo hiciere mi estrado, he aquí allí tú estás.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.8",
            "verseOrgIds": [
              "PSA.139.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 139:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si tomare las",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.9",
            "verseOrgIds": [
              "PSA.139.9"
            ]
          }
        },
        {
          "text": "alas del alba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.9",
            "verseOrgIds": [
              "PSA.139.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 139:9"
      },
      "items": [
        {
          "text": "Y habitare en el extremo de la mar,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.9",
            "verseOrgIds": [
              "PSA.139.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 139:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aun allí me guiará tu mano,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.10",
            "verseOrgIds": [
              "PSA.139.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 139:10"
      },
      "items": [
        {
          "text": "Y me asirá tu diestra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.10",
            "verseOrgIds": [
              "PSA.139.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 139:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si dijere:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.11",
            "verseOrgIds": [
              "PSA.139.11"
            ]
          }
        },
        {
          "text": "Ciertamente las tinieblas me encubrirán;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.11",
            "verseOrgIds": [
              "PSA.139.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 139:11"
      },
      "items": [
        {
          "text": "Aun la noche resplandecerá tocante á mí.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.11",
            "verseOrgIds": [
              "PSA.139.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 139:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aun las tinieblas no encubren de ti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.12",
            "verseOrgIds": [
              "PSA.139.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 139:12"
      },
      "items": [
        {
          "text": "Y la noche resplandece como el día:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.12",
            "verseOrgIds": [
              "PSA.139.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 139:12"
      },
      "items": [
        {
          "text": "Lo mismo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.12",
            "verseOrgIds": [
              "PSA.139.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "te son",
              "type": "text",
              "attrs": {
                "verseId": "PSA.139.12",
                "verseOrgIds": [
                  "PSA.139.12"
                ]
              }
            }
          ]
        },
        {
          "text": "las tinieblas que la luz.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.12",
            "verseOrgIds": [
              "PSA.139.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 139:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque tú poseiste mis riñones;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.13",
            "verseOrgIds": [
              "PSA.139.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 139:13"
      },
      "items": [
        {
          "text": "Cubrísteme en el vientre de mi madre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.13",
            "verseOrgIds": [
              "PSA.139.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 139:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te alabaré; porque formidables, maravillosas son tus obras:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.14",
            "verseOrgIds": [
              "PSA.139.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 139:14"
      },
      "items": [
        {
          "text": "Estoy maravillado,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.14",
            "verseOrgIds": [
              "PSA.139.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 139:14"
      },
      "items": [
        {
          "text": "Y mi alma lo conoce mucho.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.14",
            "verseOrgIds": [
              "PSA.139.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 139:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "No fué encubierto de ti mi cuerpo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.15",
            "verseOrgIds": [
              "PSA.139.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 139:15"
      },
      "items": [
        {
          "text": "Bien que en oculto fuí formado,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.15",
            "verseOrgIds": [
              "PSA.139.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 139:15"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Y",
              "type": "text",
              "attrs": {
                "verseId": "PSA.139.15",
                "verseOrgIds": [
                  "PSA.139.15"
                ]
              }
            }
          ]
        },
        {
          "text": "compaginado en lo más bajo de la tierra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.15",
            "verseOrgIds": [
              "PSA.139.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Maldad de los impíos",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 y su castigo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 139:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi embrión vieron tus ojos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.16",
            "verseOrgIds": [
              "PSA.139.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 139:16"
      },
      "items": [
        {
          "text": "Y en tu libro estaban escritas todas aquellas cosas",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.16",
            "verseOrgIds": [
              "PSA.139.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 139:16"
      },
      "items": [
        {
          "text": "Que fueron luego formadas,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.16",
            "verseOrgIds": [
              "PSA.139.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 139:16"
      },
      "items": [
        {
          "text": "Sin",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.16",
            "verseOrgIds": [
              "PSA.139.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "faltar",
              "type": "text",
              "attrs": {
                "verseId": "PSA.139.16",
                "verseOrgIds": [
                  "PSA.139.16"
                ]
              }
            }
          ]
        },
        {
          "text": "una de ellas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.16",
            "verseOrgIds": [
              "PSA.139.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 139:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Así que ¡cuán preciosos me son, oh Dios, tus pensamientos!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.17",
            "verseOrgIds": [
              "PSA.139.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 139:17"
      },
      "items": [
        {
          "text": "¡Cuán multiplicadas son sus cuentas!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.17",
            "verseOrgIds": [
              "PSA.139.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 139:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si los cuento, multiplícanse más que la arena:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.18",
            "verseOrgIds": [
              "PSA.139.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 139:18"
      },
      "items": [
        {
          "text": "Despierto, y aun estoy contigo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.18",
            "verseOrgIds": [
              "PSA.139.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 139:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "De cierto, oh Dios,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.19",
            "verseOrgIds": [
              "PSA.139.19"
            ]
          }
        },
        {
          "text": "matarás al impío;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.19",
            "verseOrgIds": [
              "PSA.139.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 139:19"
      },
      "items": [
        {
          "text": "Apartaos pues de mí, hombres sanguinarios.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.19",
            "verseOrgIds": [
              "PSA.139.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 139:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.20",
            "verseOrgIds": [
              "PSA.139.20"
            ]
          }
        },
        {
          "text": "blasfemias dicen ellos contra ti:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.20",
            "verseOrgIds": [
              "PSA.139.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 139:20"
      },
      "items": [
        {
          "text": "Tus enemigos toman en vano",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.20",
            "verseOrgIds": [
              "PSA.139.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "tu nombre",
              "type": "text",
              "attrs": {
                "verseId": "PSA.139.20",
                "verseOrgIds": [
                  "PSA.139.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PSA 139:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿No tengo en odio, oh Jehová, á los que te aborrecen,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.21",
            "verseOrgIds": [
              "PSA.139.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 139:21"
      },
      "items": [
        {
          "text": "Y me conmuevo contra tus enemigos?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.21",
            "verseOrgIds": [
              "PSA.139.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PSA 139:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aborrézcolos con perfecto odio;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.22",
            "verseOrgIds": [
              "PSA.139.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 139:22"
      },
      "items": [
        {
          "text": "Téngolos por enemigos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.22",
            "verseOrgIds": [
              "PSA.139.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PSA 139:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Examíname, oh Dios, y conoce mi corazón:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.23",
            "verseOrgIds": [
              "PSA.139.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 139:23"
      },
      "items": [
        {
          "text": "Pruébame y reconoce mis pensamientos:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.23",
            "verseOrgIds": [
              "PSA.139.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PSA 139:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y ve si hay en mí camino de perversidad,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.24",
            "verseOrgIds": [
              "PSA.139.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 139:24"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.24",
            "verseOrgIds": [
              "PSA.139.24"
            ]
          }
        },
        {
          "text": "guíame en el camino eterno.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.24",
            "verseOrgIds": [
              "PSA.139.24"
            ]
          }
        }
      ]
    }
