{
  "id": "PSA.75",
  "number": "75",
  "bookId": "PSA",
  "reference": "Salmos 75",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 10,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "75",
        "style": "c",
        "sid": "PSA 75"
      },
      "items": [
        {
          "text": "75",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Al Músico principal: sobre No destruyas: Salmo de Asaph: Cántico.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 75:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "ALABARÉMOSTE, oh Dios, alabaremos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.1",
            "verseOrgIds": [
              "PSA.75.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 75:1"
      },
      "items": [
        {
          "text": "Que",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.1",
            "verseOrgIds": [
              "PSA.75.2"
            ]
          }
        },
        {
          "text": "cercano está tu nombre:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.1",
            "verseOrgIds": [
              "PSA.75.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 75:1"
      },
      "items": [
        {
          "text": "Cuenten tus maravillas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.1",
            "verseOrgIds": [
              "PSA.75.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 75:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuando yo tuviere tiempo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.2",
            "verseOrgIds": [
              "PSA.75.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 75:2"
      },
      "items": [
        {
          "text": "Yo juzgaré rectamente.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.2",
            "verseOrgIds": [
              "PSA.75.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 75:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arruinábase la tierra y sus moradores:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.3",
            "verseOrgIds": [
              "PSA.75.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 75:3"
      },
      "items": [
        {
          "text": "Yo sostengo sus",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.3",
            "verseOrgIds": [
              "PSA.75.4"
            ]
          }
        },
        {
          "text": "columnas. (Selah.)",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.3",
            "verseOrgIds": [
              "PSA.75.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Dios ensalza y abate.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 Majestad y poder de Dios.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 75:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dije á los",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.4",
            "verseOrgIds": [
              "PSA.75.5"
            ]
          }
        },
        {
          "text": "insensatos: No os infatuéis;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.4",
            "verseOrgIds": [
              "PSA.75.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 75:4"
      },
      "items": [
        {
          "text": "Y á los impíos: No levantéis el cuerno:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.4",
            "verseOrgIds": [
              "PSA.75.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 75:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "No levantéis en alto vuestro cuerno;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.5",
            "verseOrgIds": [
              "PSA.75.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 75:5"
      },
      "items": [
        {
          "text": "No habléis con",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.5",
            "verseOrgIds": [
              "PSA.75.6"
            ]
          }
        },
        {
          "text": "cerviz erguida.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.5",
            "verseOrgIds": [
              "PSA.75.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 75:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque ni de oriente, ni de occidente,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.6",
            "verseOrgIds": [
              "PSA.75.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 75:6"
      },
      "items": [
        {
          "text": "Ni del desierto",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.6",
            "verseOrgIds": [
              "PSA.75.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "viene",
              "type": "text",
              "attrs": {
                "verseId": "PSA.75.6",
                "verseOrgIds": [
                  "PSA.75.7"
                ]
              }
            }
          ]
        },
        {
          "text": "el ensalzamiento.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.6",
            "verseOrgIds": [
              "PSA.75.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 75:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.7",
            "verseOrgIds": [
              "PSA.75.8"
            ]
          }
        },
        {
          "text": "Dios es el juez:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.7",
            "verseOrgIds": [
              "PSA.75.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 75:7"
      },
      "items": [
        {
          "text": "A éste abate, y á aquel ensalza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.7",
            "verseOrgIds": [
              "PSA.75.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 75:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.8",
            "verseOrgIds": [
              "PSA.75.9"
            ]
          }
        },
        {
          "text": "el cáliz está",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.8",
            "verseOrgIds": [
              "PSA.75.9"
            ]
          }
        },
        {
          "text": "en la mano de Jehová, y el vino es tinto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.8",
            "verseOrgIds": [
              "PSA.75.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 75:8"
      },
      "items": [
        {
          "text": "Lleno de mistura; y él derrama del mismo:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.8",
            "verseOrgIds": [
              "PSA.75.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 75:8"
      },
      "items": [
        {
          "text": "Ciertamente sus heces chuparán y beberán todos los impíos de la tierra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.8",
            "verseOrgIds": [
              "PSA.75.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 75:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas yo anunciaré siempre,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.9",
            "verseOrgIds": [
              "PSA.75.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 75:9"
      },
      "items": [
        {
          "text": "Cantaré alabanzas al Dios de Jacob.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.9",
            "verseOrgIds": [
              "PSA.75.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 75:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y quebraré todos los cuernos de los pecadores:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.10",
            "verseOrgIds": [
              "PSA.75.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 75:10"
      },
      "items": [
        {
          "text": "Los cuernos del justo serán ensalzados.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.10",
            "verseOrgIds": [
              "PSA.75.11"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.76",
    "number": "76",
    "bookId": "PSA"
  },
  "previous": {
    "id": "PSA.74",
    "number": "74",
    "bookId": "PSA"
  }
}