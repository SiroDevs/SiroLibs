{
  "id": "PSA.66",
  "number": "66",
  "bookId": "PSA",
  "reference": "Salmos 66",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "66",
        "style": "c",
        "sid": "PSA 66"
      },
      "items": [
        {
          "text": "66",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Al Músico principal: Cántico: Salmo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 66:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "ACLAMAD",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.1",
            "verseOrgIds": [
              "PSA.66.1"
            ]
          }
        },
        {
          "text": "a Dios con alegría, toda la tierra:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.1",
            "verseOrgIds": [
              "PSA.66.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 66:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cantad la gloria de su nombre:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.2",
            "verseOrgIds": [
              "PSA.66.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 66:2"
      },
      "items": [
        {
          "text": "Poned gloria",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.2",
            "verseOrgIds": [
              "PSA.66.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "en",
              "type": "text",
              "attrs": {
                "verseId": "PSA.66.2",
                "verseOrgIds": [
                  "PSA.66.2"
                ]
              }
            }
          ]
        },
        {
          "text": "su alabanza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.2",
            "verseOrgIds": [
              "PSA.66.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 66:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Decid á Dios: ¡Cuán",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.3",
            "verseOrgIds": [
              "PSA.66.3"
            ]
          }
        },
        {
          "text": "terribles tus obras!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.3",
            "verseOrgIds": [
              "PSA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 66:3"
      },
      "items": [
        {
          "text": "Por lo grande de tu fortaleza te mentirán tus enemigos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.3",
            "verseOrgIds": [
              "PSA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 66:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toda la tierra te adorará,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.4",
            "verseOrgIds": [
              "PSA.66.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 66:4"
      },
      "items": [
        {
          "text": "Y cantará á ti;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.4",
            "verseOrgIds": [
              "PSA.66.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 66:4"
      },
      "items": [
        {
          "text": "Cantarán á tu nombre. (Selah.)",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.4",
            "verseOrgIds": [
              "PSA.66.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 66:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Venid, y ved las obras de Dios,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.5",
            "verseOrgIds": [
              "PSA.66.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 66:5"
      },
      "items": [
        {
          "text": "Terrible en hechos sobre los hijos de los hombres.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.5",
            "verseOrgIds": [
              "PSA.66.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 66:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Volvió la mar en seco;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.6",
            "verseOrgIds": [
              "PSA.66.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 66:6"
      },
      "items": [
        {
          "text": "Por el río pasaron á pie;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.6",
            "verseOrgIds": [
              "PSA.66.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 66:6"
      },
      "items": [
        {
          "text": "Allí en él nos alegramos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.6",
            "verseOrgIds": [
              "PSA.66.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 66:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "El se enseñorea con su fortaleza para siempre:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.7",
            "verseOrgIds": [
              "PSA.66.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 66:7"
      },
      "items": [
        {
          "text": "Sus ojos atalayan sobre las gentes:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.7",
            "verseOrgIds": [
              "PSA.66.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 66:7"
      },
      "items": [
        {
          "text": "Los rebeldes no serán ensalzados. (Selah.)",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.7",
            "verseOrgIds": [
              "PSA.66.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 66:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bendecid, pueblos, á nuestro Dios,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.8",
            "verseOrgIds": [
              "PSA.66.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 66:8"
      },
      "items": [
        {
          "text": "Y haced oir la voz de su alabanza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.8",
            "verseOrgIds": [
              "PSA.66.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 66:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "El",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.9",
            "verseOrgIds": [
              "PSA.66.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "es el",
              "type": "text",
              "attrs": {
                "verseId": "PSA.66.9",
                "verseOrgIds": [
                  "PSA.66.9"
                ]
              }
            }
          ]
        },
        {
          "text": "que puso nuestra alma en vida,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.9",
            "verseOrgIds": [
              "PSA.66.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 66:9"
      },
      "items": [
        {
          "text": "Y no permitió que nuestros pies resbalasen.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.9",
            "verseOrgIds": [
              "PSA.66.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 66:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.10",
            "verseOrgIds": [
              "PSA.66.10"
            ]
          }
        },
        {
          "text": "tú nos probaste, oh Dios:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.10",
            "verseOrgIds": [
              "PSA.66.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 66:10"
      },
      "items": [
        {
          "text": "Ensayástenos como se afina la plata.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.10",
            "verseOrgIds": [
              "PSA.66.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 66:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nos metiste en la red;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.11",
            "verseOrgIds": [
              "PSA.66.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 66:11"
      },
      "items": [
        {
          "text": "Pusiste apretura en nuestros lomos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.11",
            "verseOrgIds": [
              "PSA.66.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 66:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hombres hiciste subir sobre nuestra cabeza;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.12",
            "verseOrgIds": [
              "PSA.66.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 66:12"
      },
      "items": [
        {
          "text": "Entramos en fuego y en aguas,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.12",
            "verseOrgIds": [
              "PSA.66.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 66:12"
      },
      "items": [
        {
          "text": "Y sacástenos á hartura.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.12",
            "verseOrgIds": [
              "PSA.66.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 66:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entraré en tu casa con holocaustos:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.13",
            "verseOrgIds": [
              "PSA.66.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 66:13"
      },
      "items": [
        {
          "text": "Te pagaré mis votos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.13",
            "verseOrgIds": [
              "PSA.66.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 66:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que pronunciaron mis labios,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.14",
            "verseOrgIds": [
              "PSA.66.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 66:14"
      },
      "items": [
        {
          "text": "Y habló mi boca,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.14",
            "verseOrgIds": [
              "PSA.66.14"
            ]
          }
        },
        {
          "text": "cuando angustiado estaba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.14",
            "verseOrgIds": [
              "PSA.66.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 66:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Holocaustos de cebados te ofreceré,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.15",
            "verseOrgIds": [
              "PSA.66.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 66:15"
      },
      "items": [
        {
          "text": "Con perfume de carneros:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.15",
            "verseOrgIds": [
              "PSA.66.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 66:15"
      },
      "items": [
        {
          "text": "Sacrificaré bueyes y machos cabríos. (Selah.)",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.15",
            "verseOrgIds": [
              "PSA.66.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Poder, bondad,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 y majestad de Dios.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 66:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Venid, oid todos los que teméis á Dios,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.16",
            "verseOrgIds": [
              "PSA.66.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
