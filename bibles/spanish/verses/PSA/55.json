{
  "id": "PSA.55",
  "number": "55",
  "bookId": "PSA",
  "reference": "Salmos 55",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "55",
        "style": "c",
        "sid": "PSA 55"
      },
      "items": [
        {
          "text": "55",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Al Músico principal: en Neginoth: Masquil de David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 55:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "ESCUCHA, oh Dios, mi oración,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.1",
            "verseOrgIds": [
              "PSA.55.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 55:1"
      },
      "items": [
        {
          "text": "Y no te escondas de mi súplica.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.1",
            "verseOrgIds": [
              "PSA.55.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 55:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Estáme atento, y respóndeme:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.2",
            "verseOrgIds": [
              "PSA.55.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 55:2"
      },
      "items": [
        {
          "text": "Clamo en mi oración, y levanto el grito,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.2",
            "verseOrgIds": [
              "PSA.55.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 55:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "A causa de la voz del enemigo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.3",
            "verseOrgIds": [
              "PSA.55.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 55:3"
      },
      "items": [
        {
          "text": "Por la opresión del impío;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.3",
            "verseOrgIds": [
              "PSA.55.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 55:3"
      },
      "items": [
        {
          "text": "Porque echaron sobre mí iniquidad,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.3",
            "verseOrgIds": [
              "PSA.55.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 55:3"
      },
      "items": [
        {
          "text": "Y con furor me han amenazado.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.3",
            "verseOrgIds": [
              "PSA.55.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 55:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi corazón está doloroso dentro de mí,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.4",
            "verseOrgIds": [
              "PSA.55.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 55:4"
      },
      "items": [
        {
          "text": "Y terrores de muerte sobre mí han caído.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.4",
            "verseOrgIds": [
              "PSA.55.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Plegarias de David",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 en varias tribulaciones.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 55:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Temor y temblor vinieron sobre mí,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.5",
            "verseOrgIds": [
              "PSA.55.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 55:5"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.5",
            "verseOrgIds": [
              "PSA.55.6"
            ]
          }
        },
        {
          "text": "terror me ha cubierto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.5",
            "verseOrgIds": [
              "PSA.55.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 55:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y dije: ¡Quién me diese alas como de paloma!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.6",
            "verseOrgIds": [
              "PSA.55.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 55:6"
      },
      "items": [
        {
          "text": "Volaría yo, y descansaría.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.6",
            "verseOrgIds": [
              "PSA.55.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 55:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ciertamente huiría lejos:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.7",
            "verseOrgIds": [
              "PSA.55.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 55:7"
      },
      "items": [
        {
          "text": "Moraría en el desierto. (Selah.)",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.7",
            "verseOrgIds": [
              "PSA.55.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 55:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apresuraríame á escapar",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.8",
            "verseOrgIds": [
              "PSA.55.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 55:8"
      },
      "items": [
        {
          "text": "Del viento tempestuoso, de la tempestad.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.8",
            "verseOrgIds": [
              "PSA.55.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 55:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Deshace, oh Señor, divide la lengua de ellos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.9",
            "verseOrgIds": [
              "PSA.55.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 55:9"
      },
      "items": [
        {
          "text": "Porque he visto",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.9",
            "verseOrgIds": [
              "PSA.55.10"
            ]
          }
        },
        {
          "text": "violencia y rencilla en la ciudad.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.9",
            "verseOrgIds": [
              "PSA.55.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 55:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Día y noche la rodean sobre sus muros;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.10",
            "verseOrgIds": [
              "PSA.55.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 55:10"
      },
      "items": [
        {
          "text": "E iniquidad y trabajo hay en medio de ella.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.10",
            "verseOrgIds": [
              "PSA.55.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 55:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agravios hay en medio de ella,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.11",
            "verseOrgIds": [
              "PSA.55.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 55:11"
      },
      "items": [
        {
          "text": "Y el fraude y engaño no se apartan de sus plazas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.11",
            "verseOrgIds": [
              "PSA.55.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 55:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque no me afrentó un enemigo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.12",
            "verseOrgIds": [
              "PSA.55.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 55:12"
      },
      "items": [
        {
          "text": "Lo cual habría soportado;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.12",
            "verseOrgIds": [
              "PSA.55.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 55:12"
      },
      "items": [
        {
          "text": "Ni se alzó contra mí el que me aborrecía,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.12",
            "verseOrgIds": [
              "PSA.55.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 55:12"
      },
      "items": [
        {
          "text": "Porque me hubiera ocultado de él:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.12",
            "verseOrgIds": [
              "PSA.55.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 55:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas tú, hombre, al parecer íntimo mío,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.13",
            "verseOrgIds": [
              "PSA.55.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 55:13"
      },
      "items": [
        {
          "text": "Mi guía, y mi familiar:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.13",
            "verseOrgIds": [
              "PSA.55.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 55:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que juntos comunicábamos dulcemente los secretos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.14",
            "verseOrgIds": [
              "PSA.55.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 55:14"
      },
      "items": [
        {
          "text": "A la casa de Dios andábamos en compañía.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.14",
            "verseOrgIds": [
              "PSA.55.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 55:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Condenados sean á muerte,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.15",
            "verseOrgIds": [
              "PSA.55.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 55:15"
      },
      "items": [
        {
          "text": "Desciendan vivos al",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.15",
            "verseOrgIds": [
              "PSA.55.16"
            ]
          }
        },
        {
          "text": "infierno:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.15",
            "verseOrgIds": [
              "PSA.55.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 55:15"
      },
      "items": [
        {
          "text": "Porque maldades hay en su compañía, entre ellos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.15",
            "verseOrgIds": [
              "PSA.55.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 55:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo á Dios clamaré;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.16",
            "verseOrgIds": [
              "PSA.55.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 55:16"
      },
      "items": [
        {
          "text": "Y Jehová me salvará.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.16",
            "verseOrgIds": [
              "PSA.55.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 55:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tarde y mañana y á medio día oraré y clamaré;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.17",
            "verseOrgIds": [
              "PSA.55.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 55:17"
      },
      "items": [
        {
          "text": "Y él oirá mi voz.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.17",
            "verseOrgIds": [
              "PSA.55.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 55:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "El ha redimido en paz mi alma de la guerra contra mí;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.18",
            "verseOrgIds": [
              "PSA.55.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 55:18"
      },
      "items": [
        {
          "text": "Pues fueron contra mí muchos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.18",
            "verseOrgIds": [
              "PSA.55.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 55:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dios oirá, y los quebrantará luego,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.19",
            "verseOrgIds": [
              "PSA.55.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 55:19"
      },
      "items": [
        {
          "text": "El que desde la antigüedad permanece (Selah);",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.19",
            "verseOrgIds": [
              "PSA.55.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 55:19"
      },
      "items": [
        {
          "text": "Por cuanto no se mudan,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.19",
            "verseOrgIds": [
              "PSA.55.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 55:19"
      },
      "items": [
        {
          "text": "Ni temen á Dios.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.19",
            "verseOrgIds": [
              "PSA.55.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 55:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Extendió sus manos contra sus pacíficos:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.20",
            "verseOrgIds": [
              "PSA.55.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 55:20"
      },
      "items": [
        {
          "text": "Viólo su pacto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.20",
            "verseOrgIds": [
              "PSA.55.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PSA 55:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ablandan más que manteca su boca,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.21",
            "verseOrgIds": [
              "PSA.55.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 55:21"
      },
      "items": [
        {
          "text": "Pero guerra hay en su corazón:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.21",
            "verseOrgIds": [
              "PSA.55.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 55:21"
      },
      "items": [
        {
          "text": "Suavizan sus palabras más que el aceite,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.21",
            "verseOrgIds": [
              "PSA.55.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 55:21"
      },
      "items": [
        {
          "text": "Mas ellas son cuchillos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.21",
            "verseOrgIds": [
              "PSA.55.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PSA 55:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Echa sobre Jehová tu carga, y él te sustentará;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.22",
            "verseOrgIds": [
              "PSA.55.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 55:22"
      },
      "items": [
        {
          "text": "No dejará para siempre caído al justo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.22",
            "verseOrgIds": [
              "PSA.55.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PSA 55:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas tú, oh Dios, harás descender aquéllos al pozo de la sepultura:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.23",
            "verseOrgIds": [
              "PSA.55.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 55:23"
      },
      "items": [
        {
          "text": "Los hombres sanguinarios y engañadores",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.23",
            "verseOrgIds": [
              "PSA.55.24"
            ]
          }
        },
        {
          "text": "no demediarán sus días:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.23",
            "verseOrgIds": [
              "PSA.55.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 55:23"
      },
      "items": [
        {
          "text": "Empero yo confiaré en ti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.23",
            "verseOrgIds": [
              "PSA.55.24"
            ]
          }
        }
      ]
    }
  ],
