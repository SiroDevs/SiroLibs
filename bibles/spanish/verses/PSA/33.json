{
  "id": "PSA.33",
  "number": "33",
  "bookId": "PSA",
  "reference": "Salmos 33",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "33",
        "style": "c",
        "sid": "PSA 33"
      },
      "items": [
        {
          "text": "33",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "ALEGRAOS,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.1",
            "verseOrgIds": [
              "PSA.33.1"
            ]
          }
        },
        {
          "text": "justos, en Jehová:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.1",
            "verseOrgIds": [
              "PSA.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 33:1"
      },
      "items": [
        {
          "text": "A los rectos es hermosa la alabanza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.1",
            "verseOrgIds": [
              "PSA.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Celebrad á Jehová con arpa:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.2",
            "verseOrgIds": [
              "PSA.33.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 33:2"
      },
      "items": [
        {
          "text": "Cantadle con salterio y decacordio.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.2",
            "verseOrgIds": [
              "PSA.33.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cantadle canción nueva:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.3",
            "verseOrgIds": [
              "PSA.33.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 33:3"
      },
      "items": [
        {
          "text": "Hacedlo bien tañendo con júbilo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.3",
            "verseOrgIds": [
              "PSA.33.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque recta es la palabra de Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.4",
            "verseOrgIds": [
              "PSA.33.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 33:4"
      },
      "items": [
        {
          "text": "Y toda su obra con verdad",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.4",
            "verseOrgIds": [
              "PSA.33.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "hecha.",
              "type": "text",
              "attrs": {
                "verseId": "PSA.33.4",
                "verseOrgIds": [
                  "PSA.33.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "El ama justicia y juicio:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.5",
            "verseOrgIds": [
              "PSA.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 33:5"
      },
      "items": [
        {
          "text": "De la misericordia de Jehová está llena la tierra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.5",
            "verseOrgIds": [
              "PSA.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por la palabra de Jehová fueron hechos los cielos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.6",
            "verseOrgIds": [
              "PSA.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 33:6"
      },
      "items": [
        {
          "text": "Y todo el ejército de ellos por el espíritu de su boca.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.6",
            "verseOrgIds": [
              "PSA.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "El junta como en un montón las aguas de la mar:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.7",
            "verseOrgIds": [
              "PSA.33.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 33:7"
      },
      "items": [
        {
          "text": "El pone en depósitos los abismos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.7",
            "verseOrgIds": [
              "PSA.33.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tema á Jehová toda la tierra:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.8",
            "verseOrgIds": [
              "PSA.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 33:8"
      },
      "items": [
        {
          "text": "Teman de él todos los habitadores del mundo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.8",
            "verseOrgIds": [
              "PSA.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.9",
            "verseOrgIds": [
              "PSA.33.9"
            ]
          }
        },
        {
          "text": "él dijo, y fué hecho;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.9",
            "verseOrgIds": [
              "PSA.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 33:9"
      },
      "items": [
        {
          "text": "El mandó, y existió.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.9",
            "verseOrgIds": [
              "PSA.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Acciones de gracias",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 por la protección de Dios.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehová hace nulo el consejo de las gentes,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.10",
            "verseOrgIds": [
              "PSA.33.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 33:10"
      },
      "items": [
        {
          "text": "Y frustra las maquinaciones de los pueblos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.10",
            "verseOrgIds": [
              "PSA.33.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "El consejo de Jehová permanecerá para siempre;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.11",
            "verseOrgIds": [
              "PSA.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 33:11"
      },
      "items": [
        {
          "text": "Los pensamientos de su corazón por todas las generaciones.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.11",
            "verseOrgIds": [
              "PSA.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bienaventurada la gente de que Jehová es su Dios;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.12",
            "verseOrgIds": [
              "PSA.33.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 33:12"
      },
      "items": [
        {
          "text": "El pueblo á quien escogió por heredad para sí.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.12",
            "verseOrgIds": [
              "PSA.33.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Desde los cielos miró Jehová;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.13",
            "verseOrgIds": [
              "PSA.33.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 33:13"
      },
      "items": [
        {
          "text": "Vió á todos los hijos de los hombres:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.13",
            "verseOrgIds": [
              "PSA.33.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Desde la morada de su asiento miró",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.14",
            "verseOrgIds": [
              "PSA.33.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 33:14"
      },
      "items": [
        {
          "text": "Sobre todos los moradores de la tierra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.14",
            "verseOrgIds": [
              "PSA.33.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "El formó el corazón de todos ellos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.15",
            "verseOrgIds": [
              "PSA.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 33:15"
      },
      "items": [
        {
          "text": "El considera todas sus obras.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.15",
            "verseOrgIds": [
              "PSA.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "El rey no es salvo con la multitud del ejército:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.16",
            "verseOrgIds": [
              "PSA.33.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 33:16"
      },
      "items": [
        {
          "text": "No escapa el valiente por la mucha fuerza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.16",
            "verseOrgIds": [
              "PSA.33.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanidad es el caballo para salvarse:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.17",
            "verseOrgIds": [
              "PSA.33.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 33:17"
      },
      "items": [
        {
          "text": "Por la grandeza de su fuerza no librará.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.17",
            "verseOrgIds": [
              "PSA.33.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "He aquí, el ojo de Jehová sobre los que le temen,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.18",
            "verseOrgIds": [
              "PSA.33.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 33:18"
      },
      "items": [
        {
          "text": "Sobre los que esperan en su misericordia;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.18",
            "verseOrgIds": [
              "PSA.33.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Para librar sus almas de la muerte,",
          "type": "text",
          "attrs": {
