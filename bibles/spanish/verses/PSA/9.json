{
  "id": "PSA.9",
  "number": "9",
  "bookId": "PSA",
  "reference": "Salmos 9",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "PSA 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Al Músico principal: sobre Muth-labben: Salmo de David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "TE alabaré, oh Jehová, con todo mi corazón;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.1",
            "verseOrgIds": [
              "PSA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 9:1"
      },
      "items": [
        {
          "text": "Contaré todas tus maravillas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.1",
            "verseOrgIds": [
              "PSA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Los juicios de Dios.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 Audacia é impiedad",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alegraréme y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.2",
            "verseOrgIds": [
              "PSA.9.3"
            ]
          }
        },
        {
          "text": "regocijaréme en ti:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.2",
            "verseOrgIds": [
              "PSA.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 9:2"
      },
      "items": [
        {
          "text": "Cantaré á",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.2",
            "verseOrgIds": [
              "PSA.9.3"
            ]
          }
        },
        {
          "text": "tu nombre, oh Altísimo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.2",
            "verseOrgIds": [
              "PSA.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por haber sido mis enemigos vueltos atrás:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.3",
            "verseOrgIds": [
              "PSA.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 9:3"
      },
      "items": [
        {
          "text": "Caerán y perecerán delante de ti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.3",
            "verseOrgIds": [
              "PSA.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque has hecho mi juicio y mi causa:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.4",
            "verseOrgIds": [
              "PSA.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 9:4"
      },
      "items": [
        {
          "text": "Sentástete en silla juzgando justicia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.4",
            "verseOrgIds": [
              "PSA.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reprendiste gentes, destruiste al malo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.5",
            "verseOrgIds": [
              "PSA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 9:5"
      },
      "items": [
        {
          "text": "Raíste el nombre de ellos para siempre jamás.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.5",
            "verseOrgIds": [
              "PSA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh enemigo, acabados son para siempre los asolamientos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.6",
            "verseOrgIds": [
              "PSA.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 9:6"
      },
      "items": [
        {
          "text": "Y las ciudades que derribaste,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.6",
            "verseOrgIds": [
              "PSA.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 9:6"
      },
      "items": [
        {
          "text": "Su memoria pereció con ellas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.6",
            "verseOrgIds": [
              "PSA.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.7",
            "verseOrgIds": [
              "PSA.9.8"
            ]
          }
        },
        {
          "text": "Jehová permanecerá para siempre:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.7",
            "verseOrgIds": [
              "PSA.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 9:7"
      },
      "items": [
        {
          "text": "Dispuesto ha su trono para juicio.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.7",
            "verseOrgIds": [
              "PSA.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.8",
            "verseOrgIds": [
              "PSA.9.9"
            ]
          }
        },
        {
          "text": "él juzgará el mundo con justicia;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.8",
            "verseOrgIds": [
              "PSA.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 9:8"
      },
      "items": [
        {
          "text": "Y juzgará los pueblos con rectitud.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.8",
            "verseOrgIds": [
              "PSA.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y será Jehová refugio al pobre,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.9",
            "verseOrgIds": [
              "PSA.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 9:9"
      },
      "items": [
        {
          "text": "Refugio para el tiempo de angustia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.9",
            "verseOrgIds": [
              "PSA.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y en ti",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.10",
            "verseOrgIds": [
              "PSA.9.11"
            ]
          }
        },
        {
          "text": "confiarán los que conocen tu nombre;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.10",
            "verseOrgIds": [
              "PSA.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 9:10"
      },
      "items": [
        {
          "text": "Por cuanto tú, oh Jehová, no desamparaste á los que te buscaron.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.10",
            "verseOrgIds": [
              "PSA.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cantad á Jehová, que habita en Sión:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.11",
            "verseOrgIds": [
              "PSA.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 9:11"
      },
      "items": [
        {
          "text": "Noticiad en los pueblos sus obras.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.11",
            "verseOrgIds": [
              "PSA.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.12",
            "verseOrgIds": [
              "PSA.9.13"
            ]
          }
        },
        {
          "text": "demandando la sangre se acordó de ellos:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.12",
            "verseOrgIds": [
              "PSA.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 9:12"
      },
      "items": [
        {
          "text": "No se olvidó del clamor de los pobres.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.12",
            "verseOrgIds": [
              "PSA.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ten misericordia de mí, Jehová:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.13",
            "verseOrgIds": [
              "PSA.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 9:13"
      },
      "items": [
        {
          "text": "Mira mi aflicción",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.13",
            "verseOrgIds": [
              "PSA.9.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "que padezco",
              "type": "text",
              "attrs": {
                "verseId": "PSA.9.13",
                "verseOrgIds": [
                  "PSA.9.14"
                ]
              }
            }
          ]
        },
        {
          "text": "de los que me aborrecen,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.13",
            "verseOrgIds": [
              "PSA.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 9:13"
      },
      "items": [
        {
          "text": "Tú que me levantas de las",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.13",
            "verseOrgIds": [
              "PSA.9.14"
            ]
          }
        },
        {
          "text": "puertas de la muerte;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.13",
            "verseOrgIds": [
              "PSA.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque cuente yo todas tus alabanzas",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.14",
            "verseOrgIds": [
              "PSA.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 9:14"
      },
      "items": [
        {
          "text": "En las puertas de la hija de Sión,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.14",
            "verseOrgIds": [
              "PSA.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 9:14"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Y",
              "type": "text",
              "attrs": {
                "verseId": "PSA.9.14",
                "verseOrgIds": [
                  "PSA.9.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.14",
            "verseOrgIds": [
              "PSA.9.15"
            ]
          }
        },
        {
          "text": "me goce en tu salud.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.14",
            "verseOrgIds": [
              "PSA.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hundiéronse las gentes en la fosa que hicieron;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.15",
            "verseOrgIds": [
              "PSA.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 9:15"
      },
      "items": [
        {
          "text": "En la red que escondieron fué tomado su pie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.15",
            "verseOrgIds": [
              "PSA.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehová",
