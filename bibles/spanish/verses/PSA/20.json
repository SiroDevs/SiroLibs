{
  "id": "PSA.20",
  "number": "20",
  "bookId": "PSA",
  "reference": "Salmos 20",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 9,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "PSA 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Al Músico principal: Salmo de David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "OIGATE Jehová en el día de conflicto;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.1",
            "verseOrgIds": [
              "PSA.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 20:1"
      },
      "items": [
        {
          "text": "Defiéndate el nombre del Dios de Jacob.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.1",
            "verseOrgIds": [
              "PSA.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Envíete ayuda desde",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.2",
            "verseOrgIds": [
              "PSA.20.3"
            ]
          }
        },
        {
          "text": "el santuario,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.2",
            "verseOrgIds": [
              "PSA.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 20:2"
      },
      "items": [
        {
          "text": "Y desde",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.2",
            "verseOrgIds": [
              "PSA.20.3"
            ]
          }
        },
        {
          "text": "Sión te sostenga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.2",
            "verseOrgIds": [
              "PSA.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haga memoria de todos tus presentes,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.3",
            "verseOrgIds": [
              "PSA.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 20:3"
      },
      "items": [
        {
          "text": "Y reduzca á ceniza tu holocausto. (Selah.)",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.3",
            "verseOrgIds": [
              "PSA.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Déte conforme á tu corazón,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.4",
            "verseOrgIds": [
              "PSA.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 20:4"
      },
      "items": [
        {
          "text": "Y cumpla todo tu consejo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.4",
            "verseOrgIds": [
              "PSA.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nosotros",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.5",
            "verseOrgIds": [
              "PSA.20.6"
            ]
          }
        },
        {
          "text": "nos alegraremos por tu salud,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.5",
            "verseOrgIds": [
              "PSA.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 20:5"
      },
      "items": [
        {
          "text": "Y alzaremos pendón",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.5",
            "verseOrgIds": [
              "PSA.20.6"
            ]
          }
        },
        {
          "text": "en el nombre de nuestro Dios:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.5",
            "verseOrgIds": [
              "PSA.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 20:5"
      },
      "items": [
        {
          "text": "Cumpla Jehová todas tus peticiones.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.5",
            "verseOrgIds": [
              "PSA.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahora echo de ver que Jehová guarda á",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.6",
            "verseOrgIds": [
              "PSA.20.7"
            ]
          }
        },
        {
          "text": "su ungido:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.6",
            "verseOrgIds": [
              "PSA.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 20:6"
      },
      "items": [
        {
          "text": "Oirálo desde los cielos de su santidad,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.6",
            "verseOrgIds": [
              "PSA.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 20:6"
      },
      "items": [
        {
          "text": "Con la fuerza de la salvación de su diestra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.6",
            "verseOrgIds": [
              "PSA.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Estos",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.7",
            "verseOrgIds": [
              "PSA.20.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "confían",
              "type": "text",
              "attrs": {
                "verseId": "PSA.20.7",
                "verseOrgIds": [
                  "PSA.20.8"
                ]
              }
            }
          ]
        },
        {
          "text": "en carros, y aquéllos en caballos:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.7",
            "verseOrgIds": [
              "PSA.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 20:7"
      },
      "items": [
        {
          "text": "Mas nosotros del nombre de Jehová nuestro Dios tendremos memoria.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.7",
            "verseOrgIds": [
              "PSA.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ellos arrodillaron, y cayeron;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.8",
            "verseOrgIds": [
              "PSA.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 20:8"
      },
      "items": [
        {
          "text": "Mas nosotros nos levantamos, y nos enhestamos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.8",
            "verseOrgIds": [
              "PSA.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salva, Jehová:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.9",
            "verseOrgIds": [
              "PSA.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 20:9"
      },
      "items": [
        {
          "text": "Que el Rey nos oiga el día que lo invocáremos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.20.9",
            "verseOrgIds": [
              "PSA.20.10"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.21",
