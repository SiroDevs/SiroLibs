      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 134:1"
      },
      "items": [
        {
          "text": "Vosotros todos los siervos de Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.134.1",
            "verseOrgIds": [
              "PSA.134.1"
            ]
          }
        }
      ]
    },
