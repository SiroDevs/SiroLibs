      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 134:1"
      },
      "items": [
        {
          "text": "Los que en la casa de Jehová",
          "type": "text",
          "attrs": {
            "verseId": "PSA.134.1",
            "verseOrgIds": [
              "PSA.134.1"
            ]
          }
        },
        {
          "text": "estáis por las noches.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.134.1",
            "verseOrgIds": [
              "PSA.134.1"
            ]
          }
        }
