        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "A los hijos de Coré: Salmo: Canción.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 87:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "SU",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.1",
            "verseOrgIds": [
              "PSA.87.1"
            ]
          }
        },
        {
          "text": "cimiento es",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.1",
            "verseOrgIds": [
              "PSA.87.1"
            ]
          }
        },
        {
          "text": "en montes de santidad.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.1",
            "verseOrgIds": [
              "PSA.87.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 87:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama Jehová las puertas de Sión",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.2",
            "verseOrgIds": [
              "PSA.87.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 87:2"
      },
      "items": [
        {
          "text": "Más que todas las moradas de Jacob.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.2",
            "verseOrgIds": [
              "PSA.87.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 87:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cosas ilustres son dichas de ti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.3",
            "verseOrgIds": [
              "PSA.87.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 87:3"
      },
      "items": [
        {
          "text": "Ciudad de Dios. (Selah.)",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.3",
            "verseOrgIds": [
              "PSA.87.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 87:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo me acordaré de Rahab",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.4",
            "verseOrgIds": [
              "PSA.87.4"
            ]
          }
        },
        {
          "text": "y de Babilonia entre los que me conocen:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.4",
            "verseOrgIds": [
              "PSA.87.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 87:4"
      },
      "items": [
        {
          "text": "He aquí Palestina, y Tiro, con Etiopía:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.4",
            "verseOrgIds": [
              "PSA.87.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 87:4"
      },
      "items": [
        {
          "text": "Este nació allá.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.4",
            "verseOrgIds": [
              "PSA.87.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 87:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y de Sión se dirá: Este y aquél han nacido en ella;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.5",
            "verseOrgIds": [
              "PSA.87.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 87:5"
      },
      "items": [
        {
          "text": "Y fortificarála el mismo Altísimo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.5",
            "verseOrgIds": [
              "PSA.87.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 87:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehová contará cuando",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.6",
            "verseOrgIds": [
              "PSA.87.6"
            ]
          }
        },
        {
          "text": "se escribieren los pueblos:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.6",
            "verseOrgIds": [
              "PSA.87.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 87:6"
      },
      "items": [
        {
          "text": "Este nació allí. (Selah.)",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.6",
            "verseOrgIds": [
              "PSA.87.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 87:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y cantores y tañedores",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.7",
            "verseOrgIds": [
              "PSA.87.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "en ella dirán",
              "type": "text",
              "attrs": {
                "verseId": "PSA.87.7",
                "verseOrgIds": [
                  "PSA.87.7"
                ]
              }
            }
          ]
        },
        {
          "text": ":",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.7",
            "verseOrgIds": [
              "PSA.87.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 87:7"
      },
      "items": [
        {
          "text": "Todas mis fuentes estarán en ti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.7",
            "verseOrgIds": [
              "PSA.87.7"
            ]
          }
        }
      ]
    }
  ],
