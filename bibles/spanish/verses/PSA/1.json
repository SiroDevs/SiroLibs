{
  "id": "PSA.1",
  "number": "1",
  "bookId": "PSA",
  "reference": "Salmos 1",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 6,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "PSA 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "BIENAVENTURADO el varón que no anduvo en consejo de malos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.1",
            "verseOrgIds": [
              "PSA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 1:1"
      },
      "items": [
        {
          "text": "Ni estuvo en camino de pecadores,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.1",
            "verseOrgIds": [
              "PSA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 1:1"
      },
      "items": [
        {
          "text": "Ni en silla de",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.1",
            "verseOrgIds": [
              "PSA.1.1"
            ]
          }
        },
        {
          "text": "escarnecedores se ha sentado;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.1",
            "verseOrgIds": [
              "PSA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antes en la ley de Jehová está su delicia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.2",
            "verseOrgIds": [
              "PSA.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 1:2"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.2",
            "verseOrgIds": [
              "PSA.1.2"
            ]
          }
        },
        {
          "text": "en su ley medita de día y de noche.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.2",
            "verseOrgIds": [
              "PSA.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y será",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.3",
            "verseOrgIds": [
              "PSA.1.3"
            ]
          }
        },
        {
          "text": "como el árbol plantado junto á arroyos de aguas,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.3",
            "verseOrgIds": [
              "PSA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 1:3"
      },
      "items": [
        {
          "text": "Que da su fruto en su tiempo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.3",
            "verseOrgIds": [
              "PSA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 1:3"
      },
      "items": [
        {
          "text": "Y su hoja no cae;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.3",
            "verseOrgIds": [
              "PSA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 1:3"
      },
      "items": [
        {
          "text": "Y todo lo que hace,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.3",
            "verseOrgIds": [
              "PSA.1.3"
            ]
          }
        },
        {
          "text": "prosperará.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.3",
            "verseOrgIds": [
              "PSA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "No así los malos:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.4",
            "verseOrgIds": [
              "PSA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 1:4"
      },
      "items": [
        {
          "text": "Sino",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.4",
            "verseOrgIds": [
              "PSA.1.4"
            ]
          }
        },
        {
          "text": "como el tamo que arrebata el viento.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.4",
            "verseOrgIds": [
              "PSA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por tanto no",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.5",
            "verseOrgIds": [
              "PSA.1.5"
            ]
          }
        },
        {
          "text": "se levantarán los malos en el juicio,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.5",
            "verseOrgIds": [
              "PSA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 1:5"
      },
      "items": [
        {
          "text": "Ni los pecadores en la congregación de los justos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.5",
            "verseOrgIds": [
              "PSA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.6",
            "verseOrgIds": [
              "PSA.1.6"
            ]
          }
        },
        {
          "text": "Jehová conoce el camino de los justos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.6",
            "verseOrgIds": [
              "PSA.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 1:6"
      },
      "items": [
        {
          "text": "Mas la senda de los malos perecerá.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.6",
            "verseOrgIds": [
              "PSA.1.6"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.2",
    "number": "2",
    "bookId": "PSA"
  },
