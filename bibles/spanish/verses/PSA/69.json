      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:36"
      },
      "items": [
        {
          "text": "Y los que aman su nombre habitarán en ella.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.36",
            "verseOrgIds": [
              "PSA.69.37"
            ]
          }
        }
      ]
