{
  "id": "PSA.69",
  "number": "69",
  "bookId": "PSA",
  "reference": "Salmos 69",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "69",
        "style": "c",
        "sid": "PSA 69"
      },
      "items": [
        {
          "text": "69",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Al Músico principal: sobre Sosannim: Salmo de David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 69:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "SÁLVAME, oh Dios,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.1",
            "verseOrgIds": [
              "PSA.69.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:1"
      },
      "items": [
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.1",
            "verseOrgIds": [
              "PSA.69.2"
            ]
          }
        },
        {
          "text": "las aguas han entrado hasta el alma.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.1",
            "verseOrgIds": [
              "PSA.69.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 69:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Estoy hundido en cieno profundo, donde no hay pie:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.2",
            "verseOrgIds": [
              "PSA.69.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:2"
      },
      "items": [
        {
          "text": "He venido á abismos de aguas, y la corriente me ha anegado.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.2",
            "verseOrgIds": [
              "PSA.69.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 69:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cansado estoy de llamar; mi garganta se ha enronquecido;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.3",
            "verseOrgIds": [
              "PSA.69.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:3"
      },
      "items": [
        {
          "text": "Han desfallecido mis ojos esperando á mi Dios.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.3",
            "verseOrgIds": [
              "PSA.69.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Abatimiento",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 del Mesías.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 69:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanse aumentado más que los cabellos de mi cabeza los que me aborrecen sin causa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.4",
            "verseOrgIds": [
              "PSA.69.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:4"
      },
      "items": [
        {
          "text": "Hanse fortalecido mis enemigos, los que me destruyen sin por qué:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.4",
            "verseOrgIds": [
              "PSA.69.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:4"
      },
      "items": [
        {
          "text": "He venido pues á pagar lo que no he tomado.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.4",
            "verseOrgIds": [
              "PSA.69.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 69:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dios, tú sabes mi locura;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.5",
            "verseOrgIds": [
              "PSA.69.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:5"
      },
      "items": [
        {
          "text": "Y mis delitos no te son ocultos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.5",
            "verseOrgIds": [
              "PSA.69.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 69:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "No sean avergonzados por mi causa los que te esperan, oh Señor Jehová de los ejércitos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.6",
            "verseOrgIds": [
              "PSA.69.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:6"
      },
      "items": [
        {
          "text": "No sean confusos por mí los que te buscan, oh Dios de Israel.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.6",
            "verseOrgIds": [
              "PSA.69.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 69:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.7",
            "verseOrgIds": [
              "PSA.69.8"
            ]
          }
        },
        {
          "text": "por amor de ti he sufrido afrenta;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.7",
            "verseOrgIds": [
              "PSA.69.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:7"
      },
      "items": [
        {
          "text": "Confusión ha cubierto mi rostro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.7",
            "verseOrgIds": [
              "PSA.69.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 69:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "He sido extrañado de mis hermanos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.8",
            "verseOrgIds": [
              "PSA.69.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:8"
      },
      "items": [
        {
          "text": "Y extraño á los hijos de mi madre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.8",
            "verseOrgIds": [
              "PSA.69.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 69:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque me consumió el celo de tu casa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.9",
            "verseOrgIds": [
              "PSA.69.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:9"
      },
      "items": [
        {
          "text": "Y los denuestos de los que te vituperaban, cayeron sobre mí.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.9",
            "verseOrgIds": [
              "PSA.69.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 69:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y lloré",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.10",
            "verseOrgIds": [
              "PSA.69.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "afligiendo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.69.10",
                "verseOrgIds": [
                  "PSA.69.11"
                ]
              }
            }
          ]
        },
        {
          "text": "con ayuno mi alma;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.10",
            "verseOrgIds": [
              "PSA.69.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:10"
      },
      "items": [
        {
          "text": "Y esto me ha sido por afrenta.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.10",
            "verseOrgIds": [
              "PSA.69.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 69:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Puse además saco por mi vestido;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.11",
            "verseOrgIds": [
              "PSA.69.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:11"
      },
      "items": [
        {
          "text": "Y vine á serles por proverbio.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.11",
            "verseOrgIds": [
              "PSA.69.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 69:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hablaban contra mí los que se sentaban á la puerta,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.12",
            "verseOrgIds": [
              "PSA.69.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:12"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.12",
            "verseOrgIds": [
              "PSA.69.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "me zaherían",
              "type": "text",
              "attrs": {
                "verseId": "PSA.69.12",
                "verseOrgIds": [
                  "PSA.69.13"
                ]
              }
            }
          ]
        },
        {
          "text": "en las canciones de los bebederos de sidra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.12",
            "verseOrgIds": [
              "PSA.69.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 69:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Empero yo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.13",
            "verseOrgIds": [
              "PSA.69.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "enderezaba",
              "type": "text",
              "attrs": {
                "verseId": "PSA.69.13",
                "verseOrgIds": [
                  "PSA.69.14"
                ]
              }
            }
          ]
        },
        {
          "text": "mi oración á ti, oh Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.13",
            "verseOrgIds": [
              "PSA.69.14"
            ]
          }
        },
        {
          "text": "al tiempo de",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.13",
            "verseOrgIds": [
              "PSA.69.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "tu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.69.13",
                "verseOrgIds": [
                  "PSA.69.14"
                ]
              }
            }
          ]
        },
        {
          "text": "buena voluntad:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.13",
            "verseOrgIds": [
              "PSA.69.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:13"
      },
      "items": [
        {
          "text": "Oh Dios, por la multitud de tu misericordia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.13",
            "verseOrgIds": [
              "PSA.69.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:13"
      },
      "items": [
        {
          "text": "Por la verdad de tu salud, óyeme.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.13",
            "verseOrgIds": [
              "PSA.69.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 69:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sácame del lodo, y no sea yo sumergido:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.14",
            "verseOrgIds": [
              "PSA.69.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:14"
      },
      "items": [
        {
          "text": "Sea yo libertado de los que me aborrecen, y del profundo de las aguas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.14",
            "verseOrgIds": [
              "PSA.69.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 69:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "No me anegue el ímpetu de las aguas,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.15",
            "verseOrgIds": [
              "PSA.69.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:15"
      },
      "items": [
        {
          "text": "Ni me suerba la hondura,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.15",
            "verseOrgIds": [
              "PSA.69.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:15"
      },
      "items": [
        {
          "text": "Ni el",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.15",
            "verseOrgIds": [
              "PSA.69.16"
            ]
          }
        },
        {
          "text": "pozo cierre sobre mí su boca.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.15",
            "verseOrgIds": [
              "PSA.69.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 69:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyeme, Jehová, porque apacible es tu misericordia;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.16",
            "verseOrgIds": [
              "PSA.69.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:16"
      },
      "items": [
        {
          "text": "Mírame conforme á la multitud de tus miseraciones.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.16",
            "verseOrgIds": [
              "PSA.69.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 69:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y no escondas tu rostro de tu siervo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.17",
            "verseOrgIds": [
              "PSA.69.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:17"
      },
      "items": [
        {
          "text": "Porque estoy angustiado; apresúrate, óyeme.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.17",
            "verseOrgIds": [
              "PSA.69.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 69:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acércate á mi alma, redímela:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.18",
            "verseOrgIds": [
              "PSA.69.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:18"
      },
      "items": [
        {
          "text": "Líbrame á causa de mis enemigos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.18",
            "verseOrgIds": [
              "PSA.69.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 69:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tú sabes",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.19",
            "verseOrgIds": [
              "PSA.69.20"
            ]
          }
        },
        {
          "text": "mi afrenta, y mi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.19",
            "verseOrgIds": [
              "PSA.69.20"
            ]
          }
        },
        {
          "text": "confusión, y mi oprobio:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.19",
            "verseOrgIds": [
              "PSA.69.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:19"
      },
      "items": [
        {
          "text": "Delante de ti están todos mis enemigos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.19",
            "verseOrgIds": [
              "PSA.69.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 69:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "La afrenta ha quebrantado mi corazón, y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.20",
            "verseOrgIds": [
              "PSA.69.21"
            ]
          }
        },
        {
          "text": "estoy acongojado:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.20",
            "verseOrgIds": [
              "PSA.69.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:20"
      },
      "items": [
        {
          "text": "Y esperé quien se compadeciese de",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.20",
            "verseOrgIds": [
              "PSA.69.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "mí,",
              "type": "text",
              "attrs": {
                "verseId": "PSA.69.20",
                "verseOrgIds": [
                  "PSA.69.21"
                ]
              }
            }
          ]
        },
        {
          "text": "y no lo hubo:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.20",
            "verseOrgIds": [
              "PSA.69.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:20"
      },
      "items": [
        {
          "text": "Y consoladores, y ninguno hallé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.20",
            "verseOrgIds": [
              "PSA.69.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PSA 69:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pusiéronme además hiel por comida,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.21",
            "verseOrgIds": [
              "PSA.69.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:21"
      },
      "items": [
        {
          "text": "Y en mi sed me dieron á beber vinagre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.21",
            "verseOrgIds": [
              "PSA.69.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PSA 69:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sea su mesa delante de ellos por lazo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.22",
            "verseOrgIds": [
              "PSA.69.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:22"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.22",
            "verseOrgIds": [
              "PSA.69.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "lo que es",
              "type": "text",
              "attrs": {
                "verseId": "PSA.69.22",
                "verseOrgIds": [
                  "PSA.69.23"
                ]
              }
            }
          ]
        },
        {
          "text": "para bien por tropiezo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.22",
            "verseOrgIds": [
              "PSA.69.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PSA 69:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sean oscurecidos sus ojos para ver,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.23",
            "verseOrgIds": [
              "PSA.69.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:23"
      },
      "items": [
        {
          "text": "Y haz siempre titubear sus lomos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.23",
            "verseOrgIds": [
              "PSA.69.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PSA 69:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Derrama sobre ellos tu ira,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.24",
            "verseOrgIds": [
              "PSA.69.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:24"
      },
      "items": [
        {
          "text": "Y el furor de tu enojo los alcance.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.24",
            "verseOrgIds": [
              "PSA.69.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PSA 69:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sea su palacio asolado:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.25",
            "verseOrgIds": [
              "PSA.69.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:25"
      },
      "items": [
        {
          "text": "En sus tiendas no haya morador.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.25",
            "verseOrgIds": [
              "PSA.69.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PSA 69:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque persiguieron",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.26",
            "verseOrgIds": [
              "PSA.69.27"
            ]
          }
        },
        {
          "text": "al que tú heriste;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.26",
            "verseOrgIds": [
              "PSA.69.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:26"
      },
      "items": [
        {
          "text": "Y cuentan del dolor de los que tú llagaste.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.26",
            "verseOrgIds": [
              "PSA.69.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PSA 69:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pon maldad sobre su maldad,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.27",
            "verseOrgIds": [
              "PSA.69.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:27"
      },
      "items": [
        {
          "text": "Y no entren en tu justicia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.27",
            "verseOrgIds": [
              "PSA.69.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PSA 69:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sean raídos del libro de los vivientes,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.28",
            "verseOrgIds": [
              "PSA.69.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:28"
      },
      "items": [
        {
          "text": "Y no sean escritos con los justos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.28",
            "verseOrgIds": [
              "PSA.69.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PSA 69:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y yo afligido y dolorido,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.29",
            "verseOrgIds": [
              "PSA.69.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:29"
      },
      "items": [
        {
          "text": "Tu salud, oh Dios, me defenderá.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.29",
            "verseOrgIds": [
              "PSA.69.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PSA 69:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alabaré yo el nombre de Dios con cántico,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.30",
            "verseOrgIds": [
              "PSA.69.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:30"
      },
      "items": [
        {
          "text": "Ensalzarélo con alabanza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.30",
            "verseOrgIds": [
              "PSA.69.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 \"En ti, oh Jehová, he esperado.\"",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 Protección en la vejez.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PSA 69:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y agradará á Jehová más que",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.31",
            "verseOrgIds": [
              "PSA.69.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "sacrificio",
              "type": "text",
              "attrs": {
                "verseId": "PSA.69.31",
                "verseOrgIds": [
                  "PSA.69.32"
                ]
              }
            }
          ]
        },
        {
          "text": "de buey,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.31",
            "verseOrgIds": [
              "PSA.69.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:31"
      },
      "items": [
        {
          "text": "O becerro que echa cuernos y uñas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.31",
            "verseOrgIds": [
              "PSA.69.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "PSA 69:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Veránlo los humildes, y se gozarán;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.32",
            "verseOrgIds": [
              "PSA.69.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:32"
      },
      "items": [
        {
          "text": "Buscad á Dios, y vivirá vuestro corazón.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.32",
            "verseOrgIds": [
              "PSA.69.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "PSA 69:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque Jehová oye á los menesterosos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.33",
            "verseOrgIds": [
              "PSA.69.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:33"
      },
      "items": [
        {
          "text": "Y no menosprecia á sus prisioneros.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.33",
            "verseOrgIds": [
              "PSA.69.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "PSA 69:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alábenlo los cielos y la tierra,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.34",
            "verseOrgIds": [
              "PSA.69.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:34"
      },
      "items": [
        {
          "text": "Los mares,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.34",
            "verseOrgIds": [
              "PSA.69.35"
            ]
          }
        },
        {
          "text": "y todo lo que se mueve en ellos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.34",
            "verseOrgIds": [
              "PSA.69.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "PSA 69:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque Dios guardará á Sión, y reedificará las ciudades de Judá;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.35",
            "verseOrgIds": [
              "PSA.69.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 69:35"
      },
      "items": [
        {
          "text": "Y habitarán allí, y la poseerán.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.35",
            "verseOrgIds": [
              "PSA.69.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
