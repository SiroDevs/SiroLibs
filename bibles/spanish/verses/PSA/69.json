          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y la simiente de sus siervos la heredará,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.36",
            "verseOrgIds": [
              "PSA.69.37"
            ]
          }
        }
      ]
    },
    {
