  "verseCount": 9,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "113",
        "style": "c",
        "sid": "PSA 113"
      },
      "items": [
        {
          "text": "113",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Aleluya.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 113:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "ALABAD, siervos de Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.1",
            "verseOrgIds": [
              "PSA.113.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 113:1"
      },
      "items": [
        {
          "text": "Alabad el nombre de Jehová.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.1",
            "verseOrgIds": [
              "PSA.113.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 113:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sea el nombre de Jehová bendito,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.2",
            "verseOrgIds": [
              "PSA.113.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 113:2"
      },
      "items": [
        {
          "text": "Desde ahora y para siempre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.2",
            "verseOrgIds": [
              "PSA.113.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 113:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Desde el nacimiento del sol hasta donde se pone,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.3",
            "verseOrgIds": [
              "PSA.113.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 113:3"
      },
      "items": [
        {
          "text": "Sea alabado el nombre de Jehová.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.3",
            "verseOrgIds": [
              "PSA.113.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 113:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alto sobre todas las naciones es Jehová;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.4",
            "verseOrgIds": [
              "PSA.113.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 113:4"
      },
      "items": [
        {
          "text": "Sobre los cielos su gloria.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.4",
            "verseOrgIds": [
              "PSA.113.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 113:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Quién como Jehová nuestro Dios,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.5",
            "verseOrgIds": [
              "PSA.113.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 113:5"
      },
      "items": [
        {
          "text": "Que ha enaltecido su habitación,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.5",
            "verseOrgIds": [
              "PSA.113.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 113:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que se humilla á mirar",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.6",
            "verseOrgIds": [
              "PSA.113.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 113:6"
      },
      "items": [
        {
          "text": "En el cielo y en la tierra?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.6",
            "verseOrgIds": [
              "PSA.113.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 113:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "El levanta del polvo al pobre,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.7",
            "verseOrgIds": [
              "PSA.113.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 113:7"
      },
      "items": [
        {
          "text": "Y al menesteroso alza del estiércol,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.7",
            "verseOrgIds": [
              "PSA.113.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 113:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Para hacerlos sentar con los príncipes,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.8",
            "verseOrgIds": [
              "PSA.113.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 113:8"
      },
      "items": [
        {
          "text": "Con los príncipes de su pueblo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.8",
            "verseOrgIds": [
              "PSA.113.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 113:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "El hace habitar en familia á la estéril,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.9",
            "verseOrgIds": [
              "PSA.113.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 113:9"
      },
      "items": [
        {
          "text": "Gozosa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.9",
            "verseOrgIds": [
              "PSA.113.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "en ser",
              "type": "text",
              "attrs": {
                "verseId": "PSA.113.9",
                "verseOrgIds": [
                  "PSA.113.9"
                ]
              }
            }
          ]
        },
        {
          "text": "madre de hijos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.9",
            "verseOrgIds": [
              "PSA.113.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 113:9"
      },
      "items": [
        {
          "text": "Aleluya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.9",
            "verseOrgIds": [
              "PSA.113.9"
            ]
          }
        }
      ]
    }
  ],
