{
  "id": "PSA.25",
  "number": "25",
  "bookId": "PSA",
  "reference": "Salmos 25",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "PSA 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Salmo de David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "A TI,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.1",
            "verseOrgIds": [
              "PSA.25.1"
            ]
          }
        },
        {
          "text": "oh Jehová, levantaré mi alma.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.1",
            "verseOrgIds": [
              "PSA.25.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dios mío,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.2",
            "verseOrgIds": [
              "PSA.25.2"
            ]
          }
        },
        {
          "text": "en ti confío;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.2",
            "verseOrgIds": [
              "PSA.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 25:2"
      },
      "items": [
        {
          "text": "No sea yo avergonzado,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.2",
            "verseOrgIds": [
              "PSA.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 25:2"
      },
      "items": [
        {
          "text": "No se alegren de mí mis enemigos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.2",
            "verseOrgIds": [
              "PSA.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ciertamente",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.3",
            "verseOrgIds": [
              "PSA.25.3"
            ]
          }
        },
        {
          "text": "ninguno de cuantos en ti esperan será confundido:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.3",
            "verseOrgIds": [
              "PSA.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 25:3"
      },
      "items": [
        {
          "text": "Serán avergonzados los que se rebelan sin causa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.3",
            "verseOrgIds": [
              "PSA.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muéstrame, oh Jehová, tus caminos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.4",
            "verseOrgIds": [
              "PSA.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 25:4"
      },
      "items": [
        {
          "text": "Enséñame tus sendas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.4",
            "verseOrgIds": [
              "PSA.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Encamíname en tu verdad, y enséñame;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.5",
            "verseOrgIds": [
              "PSA.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 25:5"
      },
      "items": [
        {
          "text": "Porque tú eres el Dios de mi salud:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.5",
            "verseOrgIds": [
              "PSA.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 25:5"
      },
      "items": [
        {
          "text": "En ti he esperado todo el día.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.5",
            "verseOrgIds": [
              "PSA.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acuérdate, oh Jehová, de tus conmiseraciones y de tus misericordias,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.6",
            "verseOrgIds": [
              "PSA.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 25:6"
      },
      "items": [
        {
          "text": "Que son perpetuas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.6",
            "verseOrgIds": [
              "PSA.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "De los pecados de mi mocedad, y de mis rebeliones, no te acuerdes;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.7",
            "verseOrgIds": [
              "PSA.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 25:7"
      },
      "items": [
        {
          "text": "Conforme á tu misericordia acuérdate de mí,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.7",
            "verseOrgIds": [
              "PSA.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 25:7"
      },
      "items": [
        {
          "text": "Por tu bondad, oh Jehová.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.7",
            "verseOrgIds": [
              "PSA.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bueno y recto es Jehová:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.8",
            "verseOrgIds": [
              "PSA.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 25:8"
      },
      "items": [
        {
          "text": "Por tanto él enseñará á los pecadores el camino.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.8",
            "verseOrgIds": [
              "PSA.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Encaminará á los humildes por el juicio,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.9",
            "verseOrgIds": [
              "PSA.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 25:9"
      },
      "items": [
        {
          "text": "Y enseñará á los mansos su carrera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.9",
            "verseOrgIds": [
              "PSA.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Todas las sendas de Jehová son misericordia y verdad,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.10",
            "verseOrgIds": [
              "PSA.25.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 25:10"
      },
      "items": [
        {
          "text": "Para los que guardan su pacto y sus testimonios.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.10",
            "verseOrgIds": [
              "PSA.25.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por amor de tu nombre, oh Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.11",
            "verseOrgIds": [
              "PSA.25.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 25:11"
      },
      "items": [
        {
          "text": "Perdonarás también mi pecado;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.11",
            "verseOrgIds": [
              "PSA.25.11"
            ]
          }
        },
        {
          "text": "porque es grande.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.11",
            "verseOrgIds": [
              "PSA.25.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Quién es el hombre que teme á Jehová?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.12",
            "verseOrgIds": [
              "PSA.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 25:12"
      },
      "items": [
        {
          "text": "El le enseñará el camino que ha de escoger.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.12",
            "verseOrgIds": [
              "PSA.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Su alma reposará en el bien,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.13",
            "verseOrgIds": [
              "PSA.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 25:13"
      },
      "items": [
        {
          "text": "Y su simiente heredará la tierra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.13",
            "verseOrgIds": [
              "PSA.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "El secreto de Jehová es para los que le temen;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.14",
            "verseOrgIds": [
              "PSA.25.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 25:14"
      },
      "items": [
        {
          "text": "Y á ellos hará conocer su alianza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.14",
            "verseOrgIds": [
              "PSA.25.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mis ojos están siempre hacia Jehová;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.15",
            "verseOrgIds": [
              "PSA.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 25:15"
      },
      "items": [
        {
          "text": "Porque él",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.15",
            "verseOrgIds": [
              "PSA.25.15"
            ]
          }
        },
        {
          "text": "sacará mis pies",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.15",
            "verseOrgIds": [
              "PSA.25.15"
            ]
          }
        },
        {
          "text": "de la red.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.15",
            "verseOrgIds": [
              "PSA.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mírame, y ten misericordia de mí;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.16",
            "verseOrgIds": [
              "PSA.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 25:16"
      },
      "items": [
        {
          "text": "Porque estoy solo y afligido.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.16",
            "verseOrgIds": [
              "PSA.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Las angustias de mi corazón se han aumentado:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.17",
            "verseOrgIds": [
              "PSA.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 25:17"
      },
      "items": [
        {
          "text": "Sácame de mis congojas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.17",
            "verseOrgIds": [
              "PSA.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mira mi aflicción y mi trabajo:",
          "type": "text",
          "attrs": {
