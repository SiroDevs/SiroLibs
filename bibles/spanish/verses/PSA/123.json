    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Cántico gradual.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 123:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "A TI",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.1",
            "verseOrgIds": [
              "PSA.123.1"
            ]
          }
        },
        {
          "text": "que habitas en los cielos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.1",
            "verseOrgIds": [
              "PSA.123.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 123:1"
      },
      "items": [
        {
          "text": "Alcé mis ojos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.1",
            "verseOrgIds": [
              "PSA.123.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Socorro de Dios á su pueblo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 \"Los que sembraron con lágrimas.\"",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 123:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "He aquí como los ojos de los siervos",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.2",
            "verseOrgIds": [
              "PSA.123.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "miran",
              "type": "text",
              "attrs": {
                "verseId": "PSA.123.2",
                "verseOrgIds": [
                  "PSA.123.2"
                ]
              }
            }
          ]
        },
        {
          "text": "á la mano de sus señores,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.2",
            "verseOrgIds": [
              "PSA.123.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 123:2"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Y",
              "type": "text",
              "attrs": {
                "verseId": "PSA.123.2",
                "verseOrgIds": [
                  "PSA.123.2"
                ]
              }
            }
          ]
        },
        {
          "text": "como los ojos de la sierva á la mano de su señora;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.2",
            "verseOrgIds": [
              "PSA.123.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 123:2"
      },
      "items": [
        {
          "text": "Así nuestros ojos",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.2",
            "verseOrgIds": [
              "PSA.123.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "miran",
              "type": "text",
              "attrs": {
                "verseId": "PSA.123.2",
                "verseOrgIds": [
                  "PSA.123.2"
                ]
              }
            }
          ]
        },
        {
          "text": "á Jehová nuestro Dios,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.2",
            "verseOrgIds": [
              "PSA.123.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 123:2"
      },
      "items": [
        {
          "text": "Hasta que haya misericordia de nosotros.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.2",
            "verseOrgIds": [
              "PSA.123.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 123:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ten misericordia de nosotros, oh Jehová, ten misericordia de nosotros;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.3",
            "verseOrgIds": [
              "PSA.123.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 123:3"
      },
      "items": [
        {
          "text": "Porque estamos muy hartos de",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.3",
            "verseOrgIds": [
              "PSA.123.3"
            ]
          }
        },
        {
          "text": "menosprecio.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.3",
            "verseOrgIds": [
              "PSA.123.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 123:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muy harta está nuestra alma",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.4",
            "verseOrgIds": [
              "PSA.123.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 123:4"
      },
      "items": [
        {
          "text": "Del",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.4",
            "verseOrgIds": [
              "PSA.123.4"
            ]
          }
        },
        {
          "text": "escarnio de los",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.4",
            "verseOrgIds": [
              "PSA.123.4"
            ]
          }
        },
        {
          "text": "holgados,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.4",
            "verseOrgIds": [
              "PSA.123.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 123:4"
      },
      "items": [
        {
          "text": "Y del menosprecio de los soberbios.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.4",
            "verseOrgIds": [
              "PSA.123.4"
            ]
          }
        }
      ]
    }
  ],
