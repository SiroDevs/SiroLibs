{
  "id": "PSA.22",
  "number": "22",
  "bookId": "PSA",
  "reference": "Salmos 22",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "PSA 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Al Músico principal, sobre Ajeleth-sahar Salmo de David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "DIOS mío, Dios mío,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.1",
            "verseOrgIds": [
              "PSA.22.2"
            ]
          }
        },
        {
          "text": "¿por qué me has dejado?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.1",
            "verseOrgIds": [
              "PSA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "¿Por qué",
              "type": "text",
              "attrs": {
                "verseId": "PSA.22.1",
                "verseOrgIds": [
                  "PSA.22.2"
                ]
              }
            }
          ]
        },
        {
          "text": "estás lejos de mi salud, y de las palabras de",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.1",
            "verseOrgIds": [
              "PSA.22.2"
            ]
          }
        },
        {
          "text": "mi clamor?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.1",
            "verseOrgIds": [
              "PSA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dios mío, clamo de día, y no oyes;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.2",
            "verseOrgIds": [
              "PSA.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:2"
      },
      "items": [
        {
          "text": "Y de noche, y no hay para mí silencio.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.2",
            "verseOrgIds": [
              "PSA.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tú empero eres santo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.3",
            "verseOrgIds": [
              "PSA.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:3"
      },
      "items": [
        {
          "text": "Tú que habitas",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.3",
            "verseOrgIds": [
              "PSA.22.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "entre",
              "type": "text",
              "attrs": {
                "verseId": "PSA.22.3",
                "verseOrgIds": [
                  "PSA.22.4"
                ]
              }
            }
          ]
        },
        {
          "text": "las",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.3",
            "verseOrgIds": [
              "PSA.22.4"
            ]
          }
        },
        {
          "text": "alabanzas de Israel.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.3",
            "verseOrgIds": [
              "PSA.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "En ti esperaron nuestros padres:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.4",
            "verseOrgIds": [
              "PSA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:4"
      },
      "items": [
        {
          "text": "Esperaron, y tú los libraste.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.4",
            "verseOrgIds": [
              "PSA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Clamaron á ti, y fueron librados:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.5",
            "verseOrgIds": [
              "PSA.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:5"
      },
      "items": [
        {
          "text": "Esperaron en ti, y no se avergonzaron.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.5",
            "verseOrgIds": [
              "PSA.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas yo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.6",
            "verseOrgIds": [
              "PSA.22.7"
            ]
          }
        },
        {
          "text": "soy gusano, y no hombre;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.6",
            "verseOrgIds": [
              "PSA.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:6"
      },
      "items": [
        {
          "text": "Oprobio de los hombres, y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.6",
            "verseOrgIds": [
              "PSA.22.7"
            ]
          }
        },
        {
          "text": "desecho del pueblo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.6",
            "verseOrgIds": [
              "PSA.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Todos los que me ven, escarnecen de mí;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.7",
            "verseOrgIds": [
              "PSA.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:7"
      },
      "items": [
        {
          "text": "Estiran los labios, menean la cabeza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.7",
            "verseOrgIds": [
              "PSA.22.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "diciendo:",
              "type": "text",
              "attrs": {
                "verseId": "PSA.22.7",
                "verseOrgIds": [
                  "PSA.22.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Remítese á Jehová, líbrelo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.8",
            "verseOrgIds": [
              "PSA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:8"
      },
      "items": [
        {
          "text": "Sálvele, puesto que en él se complacía.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.8",
            "verseOrgIds": [
              "PSA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Empero tú eres el que me sacó del vientre,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.9",
            "verseOrgIds": [
              "PSA.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:9"
      },
      "items": [
        {
          "text": "El que me haces esperar",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.9",
            "verseOrgIds": [
              "PSA.22.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "desde que estaba",
              "type": "text",
              "attrs": {
                "verseId": "PSA.22.9",
                "verseOrgIds": [
                  "PSA.22.10"
                ]
              }
            }
          ]
        },
        {
          "text": "á los pechos de mi madre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.9",
            "verseOrgIds": [
              "PSA.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sobre ti fuí echado desde la matriz:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.10",
            "verseOrgIds": [
              "PSA.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:10"
      },
      "items": [
        {
          "text": "Desde el vientre de mi madre, tú eres mi Dios.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.10",
            "verseOrgIds": [
              "PSA.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "No te alejes de mí, porque la angustia está cerca;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.11",
            "verseOrgIds": [
              "PSA.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:11"
      },
      "items": [
        {
          "text": "Porque no hay quien ayude.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.11",
            "verseOrgIds": [
              "PSA.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanme rodeado muchos toros;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.12",
            "verseOrgIds": [
              "PSA.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:12"
      },
      "items": [
        {
          "text": "Fuertes toros de Basán me han cercado.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.12",
            "verseOrgIds": [
              "PSA.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrieron sobre mí su boca,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.13",
            "verseOrgIds": [
              "PSA.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:13"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Como",
              "type": "text",
              "attrs": {
                "verseId": "PSA.22.13",
                "verseOrgIds": [
                  "PSA.22.14"
                ]
              }
            }
          ]
        },
        {
          "text": "león rapante y rugiente.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.13",
            "verseOrgIds": [
              "PSA.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heme escurrido como aguas,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.14",
            "verseOrgIds": [
              "PSA.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:14"
      },
      "items": [
        {
          "text": "Y todos mis huesos se descoyuntaron:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.14",
            "verseOrgIds": [
              "PSA.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:14"
      },
      "items": [
        {
          "text": "Mi corazón fué como cera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.14",
            "verseOrgIds": [
              "PSA.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:14"
      },
      "items": [
        {
          "text": "Desliéndose en medio de mis entrañas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.14",
            "verseOrgIds": [
              "PSA.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Secóse como un tiesto mi vigor,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.15",
            "verseOrgIds": [
              "PSA.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:15"
      },
      "items": [
        {
          "text": "Y mi lengua se pegó á mi paladar;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.15",
            "verseOrgIds": [
              "PSA.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:15"
      },
      "items": [
        {
          "text": "Y me has puesto en el polvo de la muerte.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.15",
            "verseOrgIds": [
              "PSA.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque perros me han rodeado,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.16",
            "verseOrgIds": [
              "PSA.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:16"
      },
      "items": [
        {
          "text": "Hame cercado cuadrilla de malignos:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.16",
            "verseOrgIds": [
              "PSA.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:16"
      },
      "items": [
        {
          "text": "Horadaron mis manos y mis pies.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.16",
            "verseOrgIds": [
              "PSA.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Contar puedo todos mis huesos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.17",
            "verseOrgIds": [
              "PSA.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:17"
      },
      "items": [
        {
          "text": "Ellos miran, considéranme.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.17",
            "verseOrgIds": [
              "PSA.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Partieron entre sí mis vestidos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.18",
            "verseOrgIds": [
              "PSA.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:18"
      },
      "items": [
        {
          "text": "Y sobre mi ropa echaron suertes.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.18",
            "verseOrgIds": [
              "PSA.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas tú, Jehová, no te alejes;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.19",
            "verseOrgIds": [
              "PSA.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:19"
      },
      "items": [
        {
          "text": "Fortaleza mía, apresúrate para mi ayuda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.19",
            "verseOrgIds": [
              "PSA.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Libra de la espada mi alma;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.20",
            "verseOrgIds": [
              "PSA.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:20"
      },
      "items": [
        {
          "text": "Del poder del perro mi única.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.20",
            "verseOrgIds": [
              "PSA.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PSA 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sálvame de la boca del león,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.21",
            "verseOrgIds": [
              "PSA.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:21"
      },
      "items": [
        {
          "text": "Y óyeme",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.21",
            "verseOrgIds": [
              "PSA.22.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "librándome",
              "type": "text",
              "attrs": {
                "verseId": "PSA.22.21",
                "verseOrgIds": [
                  "PSA.22.22"
                ]
              }
            }
          ]
        },
        {
          "text": "de los cuernos de los unicornios.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.21",
            "verseOrgIds": [
              "PSA.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PSA 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anunciaré tu nombre á mis hermanos:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.22",
            "verseOrgIds": [
              "PSA.22.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:22"
      },
      "items": [
        {
          "text": "En medio de la congregación te alabaré.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.22",
            "verseOrgIds": [
              "PSA.22.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 \"Jehová es mi pastor.\"",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 El Rey de gloria.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PSA 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los que teméis á Jehová, alabadle;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.23",
            "verseOrgIds": [
              "PSA.22.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:23"
      },
      "items": [
        {
          "text": "Glorificadle, simiente toda de Jacob;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.23",
            "verseOrgIds": [
              "PSA.22.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:23"
      },
      "items": [
        {
          "text": "Y temed de él, vosotros, simiente toda de Israel.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.23",
            "verseOrgIds": [
              "PSA.22.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PSA 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque no menospreció ni abominó la aflicción del pobre,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.24",
            "verseOrgIds": [
              "PSA.22.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:24"
      },
      "items": [
        {
          "text": "Ni de él escondió su rostro;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.24",
            "verseOrgIds": [
              "PSA.22.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:24"
      },
      "items": [
        {
          "text": "Sino que",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.24",
            "verseOrgIds": [
              "PSA.22.25"
            ]
          }
        },
        {
          "text": "cuando clamó á él, oyóle.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.24",
            "verseOrgIds": [
              "PSA.22.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PSA 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "De ti será mi alabanza en la grande congregación;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.25",
            "verseOrgIds": [
              "PSA.22.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:25"
      },
      "items": [
        {
          "text": "Mis votos pagaré delante de los que le temen.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.25",
            "verseOrgIds": [
              "PSA.22.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PSA 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Comerán los pobres, y serán saciados:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.26",
            "verseOrgIds": [
              "PSA.22.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:26"
      },
      "items": [
        {
          "text": "Alabarán á Jehová los que le buscan:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.26",
            "verseOrgIds": [
              "PSA.22.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:26"
      },
      "items": [
        {
          "text": "Vivirá vuestro corazón para siempre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.26",
            "verseOrgIds": [
              "PSA.22.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PSA 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acordarse han, y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.27",
            "verseOrgIds": [
              "PSA.22.28"
            ]
          }
        },
        {
          "text": "volveránse á Jehová todos los términos de la tierra;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.27",
            "verseOrgIds": [
              "PSA.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:27"
      },
      "items": [
        {
          "text": "Y se humillarán delante de ti todas las familias de las gentes.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.27",
            "verseOrgIds": [
              "PSA.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PSA 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque de Jehová es el reino;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.28",
            "verseOrgIds": [
              "PSA.22.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:28"
      },
      "items": [
        {
          "text": "Y él se enseñoreará de las gentes.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.28",
            "verseOrgIds": [
              "PSA.22.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PSA 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Comerán y adorarán todos los poderosos de la tierra:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.29",
            "verseOrgIds": [
              "PSA.22.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:29"
      },
      "items": [
        {
          "text": "Postraránse delante de él todos los que descienden al polvo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.29",
            "verseOrgIds": [
              "PSA.22.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:29"
      },
      "items": [
        {
          "text": "Si bien ninguno puede conservar la vida á su propia alma.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.29",
            "verseOrgIds": [
              "PSA.22.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PSA 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "La posteridad le servirá;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.30",
            "verseOrgIds": [
              "PSA.22.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:30"
      },
      "items": [
        {
          "text": "Será ella contada por una generación de Jehová.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.30",
            "verseOrgIds": [
              "PSA.22.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PSA 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vendrán, y anunciarán al pueblo que naciere,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.31",
            "verseOrgIds": [
              "PSA.22.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 22:31"
      },
      "items": [
        {
          "text": "Su justicia que él hizo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.31",
            "verseOrgIds": [
              "PSA.22.32"
            ]
          }
        }
      ]
    }
  ],
