{
  "id": "PSA.95",
  "number": "95",
  "bookId": "PSA",
  "reference": "Salmos 95",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "95",
        "style": "c",
        "sid": "PSA 95"
      },
      "items": [
        {
          "text": "95",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.1",
            "verseOrgIds": [
              "PSA.95.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 95:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "VENID, celebremos alegremente á Jehová:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.1",
            "verseOrgIds": [
              "PSA.95.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 95:1"
      },
      "items": [
        {
          "text": "Cantemos con júbilo á",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.1",
            "verseOrgIds": [
              "PSA.95.1"
            ]
          }
        },
        {
          "text": "la roca de nuestra salud.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.1",
            "verseOrgIds": [
              "PSA.95.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 95:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lleguemos ante su acatamiento con alabanza;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.2",
            "verseOrgIds": [
              "PSA.95.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 95:2"
      },
      "items": [
        {
          "text": "Aclamémosle con cánticos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.2",
            "verseOrgIds": [
              "PSA.95.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 95:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.3",
            "verseOrgIds": [
              "PSA.95.3"
            ]
          }
        },
        {
          "text": "Jehová es Dios grande;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.3",
            "verseOrgIds": [
              "PSA.95.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 95:3"
      },
      "items": [
        {
          "text": "Y Rey grande sobre todos los dioses.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.3",
            "verseOrgIds": [
              "PSA.95.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 95:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque en su mano están las profundidades de la tierra,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.4",
            "verseOrgIds": [
              "PSA.95.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 95:4"
      },
      "items": [
        {
          "text": "Y las alturas de los montes son suyas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.4",
            "verseOrgIds": [
              "PSA.95.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 95:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suya también la mar, pues él la hizo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.5",
            "verseOrgIds": [
              "PSA.95.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 95:5"
      },
      "items": [
        {
          "text": "Y sus manos formaron la seca.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.5",
            "verseOrgIds": [
              "PSA.95.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 95:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Venid, adoremos y postrémonos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.6",
            "verseOrgIds": [
              "PSA.95.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 95:6"
      },
      "items": [
        {
          "text": "Arrodillémonos delante de Jehová nuestro hacedor.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.6",
            "verseOrgIds": [
              "PSA.95.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 95:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque él es nuestro Dios;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.7",
            "verseOrgIds": [
              "PSA.95.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 95:7"
      },
      "items": [
        {
          "text": "Nosotros el",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.7",
            "verseOrgIds": [
              "PSA.95.7"
            ]
          }
        },
        {
          "text": "pueblo de su dehesa, y ovejas de su mano.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.7",
            "verseOrgIds": [
              "PSA.95.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 95:7"
      },
      "items": [
        {
          "text": "Si hoy oyereis su voz,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.7",
            "verseOrgIds": [
              "PSA.95.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 95:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "No endurezcáis vuestro corazón como",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.8",
            "verseOrgIds": [
              "PSA.95.8"
            ]
          }
        },
        {
          "text": "en Meriba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.8",
            "verseOrgIds": [
              "PSA.95.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 95:8"
      },
      "items": [
        {
          "text": "Como el día de Masa en el desierto;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.8",
            "verseOrgIds": [
              "PSA.95.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 95:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Donde",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.9",
            "verseOrgIds": [
              "PSA.95.9"
            ]
          }
        },
        {
          "text": "me tentaron vuestros padres,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.9",
            "verseOrgIds": [
              "PSA.95.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 95:9"
      },
      "items": [
        {
          "text": "Probáronme, y vieron mi obra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.9",
            "verseOrgIds": [
              "PSA.95.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 95:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuarenta años estuve disgustado con la nación,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.10",
            "verseOrgIds": [
              "PSA.95.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 95:10"
      },
      "items": [
        {
          "text": "Y dije: Pueblo es que divaga de corazón,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.10",
            "verseOrgIds": [
              "PSA.95.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 95:10"
      },
      "items": [
        {
          "text": "Y no han conocido mis caminos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.10",
            "verseOrgIds": [
              "PSA.95.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 95:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por tanto juré en mi furor",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.11",
            "verseOrgIds": [
              "PSA.95.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 95:11"
      },
      "items": [
        {
          "text": "Que no entrarían en mi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.11",
            "verseOrgIds": [
              "PSA.95.11"
            ]
          }
        },
        {
          "text": "reposo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.11",
            "verseOrgIds": [
              "PSA.95.11"
            ]
          }
        }
      ]
    }
  ],
  "next": {
