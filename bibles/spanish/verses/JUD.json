{
  "JUD.1": {
    "id": "JUD.1",
    "number": "1",
    "bookId": "JUD",
    "reference": "Judas 1",
    "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
    "verseCount": 25,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "1",
          "style": "c",
          "sid": "JUD 1"
        },
        "items": [
          {
            "text": "1",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "JUD 1:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "JUDAS,",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.1",
              "verseOrgIds": [
                "JUD.1.1"
              ]
            }
          },
          {
            "text": "siervo de Jesucristo, y hermano de",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.1",
              "verseOrgIds": [
                "JUD.1.1"
              ]
            }
          },
          {
            "text": "Jacobo, á los",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.1",
              "verseOrgIds": [
                "JUD.1.1"
              ]
            }
          },
          {
            "text": "llamados, santificados en Dios Padre, y",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.1",
              "verseOrgIds": [
                "JUD.1.1"
              ]
            }
          },
          {
            "text": "conservados en Jesucristo:",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.1",
              "verseOrgIds": [
                "JUD.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "JUD 1:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "Misericordia, y",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.2",
              "verseOrgIds": [
                "JUD.1.2"
              ]
            }
          },
          {
            "text": "paz, y amor os sean multiplicados.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.2",
              "verseOrgIds": [
                "JUD.1.2"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "JUD 1:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Amados, por la gran solicitud que tenía de escribiros",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.3",
              "verseOrgIds": [
                "JUD.1.3"
              ]
            }
          },
          {
            "text": "de la común salud, me ha sido necesario escribiros amonestándoos que",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.3",
              "verseOrgIds": [
                "JUD.1.3"
              ]
            }
          },
          {
            "text": "contendáis eficazmente por",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.3",
              "verseOrgIds": [
                "JUD.1.3"
              ]
            }
          },
          {
            "text": "la fe que ha sido una vez dada á los santos.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.3",
              "verseOrgIds": [
                "JUD.1.3"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "JUD 1:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Porque algunos hombres",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.4",
              "verseOrgIds": [
                "JUD.1.4"
              ]
            }
          },
          {
            "text": "han entrado encubiertamente, los cuales desde antes habían estado ordenados para esta condenación, hombres impíos,",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.4",
              "verseOrgIds": [
                "JUD.1.4"
              ]
            }
          },
          {
            "text": "convirtiendo la gracia de nuestro Dios en disolución, y",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.4",
              "verseOrgIds": [
                "JUD.1.4"
              ]
            }
          },
          {
            "text": "negando á Dios que solo es el que tiene dominio, y á nuestro Señor Jesucristo.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.4",
              "verseOrgIds": [
                "JUD.1.4"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "JUD 1:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "Os quiero pues amonestar,",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.5",
              "verseOrgIds": [
                "JUD.1.5"
              ]
            }
          },
          {
            "name": "char",
            "type": "tag",
            "attrs": {
              "style": "add"
            },
            "items": [
              {
                "text": "ya",
                "type": "text",
                "attrs": {
                  "verseId": "JUD.1.5",
                  "verseOrgIds": [
                    "JUD.1.5"
                  ]
                }
              }
            ]
          },
          {
            "text": "que alguna vez habéis sabido esto, que",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.5",
              "verseOrgIds": [
                "JUD.1.5"
              ]
            }
          },
          {
            "text": "el Señor habiendo salvado al pueblo de Egipto, después",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.5",
              "verseOrgIds": [
                "JUD.1.5"
              ]
            }
          },
          {
            "text": "destruyó á los que no creían:",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.5",
              "verseOrgIds": [
                "JUD.1.5"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "JUD 1:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Y á",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.6",
              "verseOrgIds": [
                "JUD.1.6"
              ]
            }
          },
          {
            "text": "los ángeles que no guardaron su",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.6",
              "verseOrgIds": [
                "JUD.1.6"
              ]
            }
          },
          {
            "text": "dignidad, mas dejaron su habitación, los ha reservado debajo de oscuridad en prisiones eternas hasta el juicio del gran día:",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.6",
              "verseOrgIds": [
                "JUD.1.6"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "JUD 1:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Como",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.7",
              "verseOrgIds": [
                "JUD.1.7"
              ]
            }
          },
          {
            "text": "Sodoma y Gomorra, y las ciudades comarcanas, las cuales de la misma manera que ellos habían fornicado, y habían seguido la",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.7",
              "verseOrgIds": [
                "JUD.1.7"
              ]
            }
          },
          {
            "text": "carne extraña, fueron puestas por ejemplo, sufriendo",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.7",
              "verseOrgIds": [
                "JUD.1.7"
              ]
            }
          },
          {
            "text": "el juicio del fuego eterno.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.7",
              "verseOrgIds": [
                "JUD.1.7"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s"
        },
        "items": [
          {
            "text": "1 Contra la impiedad.",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s"
        },
        "items": [
          {
            "text": "2 Exhortaciones á los fieles.",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "JUD 1:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "De la misma",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.8",
              "verseOrgIds": [
                "JUD.1.8"
              ]
            }
          },
          {
            "text": "manera también estos soñadores amancillan la carne, y menosprecian la potestad, y vituperan las potestades superiores.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.8",
              "verseOrgIds": [
                "JUD.1.8"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "JUD 1:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Pero cuando",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.9",
              "verseOrgIds": [
                "JUD.1.9"
              ]
            }
          },
          {
            "text": "el arcángel",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.9",
              "verseOrgIds": [
                "JUD.1.9"
              ]
            }
          },
          {
            "text": "Miguel contendía con el diablo, disputando",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.9",
              "verseOrgIds": [
                "JUD.1.9"
              ]
            }
          },
          {
            "text": "sobre el cuerpo de Moisés,",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.9",
              "verseOrgIds": [
                "JUD.1.9"
              ]
            }
          },
          {
            "text": "no se atrevió á usar de juicio de maldición contra él, sino que dijo:",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.9",
              "verseOrgIds": [
                "JUD.1.9"
              ]
            }
          },
          {
            "text": "El Señor te reprenda.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.9",
              "verseOrgIds": [
                "JUD.1.9"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "JUD 1:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "Pero",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.10",
              "verseOrgIds": [
                "JUD.1.10"
              ]
            }
          },
          {
            "text": "éstos maldicen las cosas que no conocen; y las cosas que naturalmente conocen, se corrompen en ellas, como bestias brutas.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.10",
              "verseOrgIds": [
                "JUD.1.10"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "JUD 1:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "¡Ay de ellos! porque han seguido el camino de",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.11",
              "verseOrgIds": [
                "JUD.1.11"
              ]
            }
          },
          {
            "text": "Caín, y se lanzaron en el error",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.11",
              "verseOrgIds": [
                "JUD.1.11"
              ]
            }
          },
          {
            "text": "de Balaam por recompensa, y perecieron en la contradicción",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.11",
              "verseOrgIds": [
                "JUD.1.11"
              ]
            }
          },
          {
            "text": "de Coré.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.11",
              "verseOrgIds": [
                "JUD.1.11"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "JUD 1:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "Estos son manchas",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.12",
              "verseOrgIds": [
                "JUD.1.12"
              ]
            }
          },
          {
            "text": "en vuestros convites, que banquetean juntamente, apacentándose á sí mismos sin temor alguno:",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.12",
              "verseOrgIds": [
                "JUD.1.12"
              ]
            }
          },
          {
            "text": "nubes sin agua, las cuales son",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.12",
              "verseOrgIds": [
                "JUD.1.12"
              ]
            }
          },
          {
            "text": "llevadas de acá para allá de los vientos: árboles marchitos como en otoño, sin fruto, dos veces muertos y desarraigados;",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.12",
              "verseOrgIds": [
                "JUD.1.12"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "13",
              "style": "v",
              "sid": "JUD 1:13"
            },
            "items": [
              {
                "text": "13",
                "type": "text"
              }
            ]
          },
          {
            "text": "Fieras ondas de la mar, que espuman sus mismas abominaciones; estrellas erráticas, á las cuales es reservada eternalmente la oscuridad de las tinieblas.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.13",
              "verseOrgIds": [
                "JUD.1.13"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "14",
              "style": "v",
              "sid": "JUD 1:14"
            },
            "items": [
              {
                "text": "14",
                "type": "text"
              }
            ]
          },
          {
            "text": "De los cuales también profetizó Enoc,",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.14",
              "verseOrgIds": [
                "JUD.1.14"
              ]
            }
          },
          {
            "text": "séptimo desde Adam, diciendo: He aquí, el Señor es venido con sus santos",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.14",
              "verseOrgIds": [
                "JUD.1.14"
              ]
            }
          },
          {
            "text": "millares,",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.14",
              "verseOrgIds": [
                "JUD.1.14"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "15",
              "style": "v",
              "sid": "JUD 1:15"
            },
            "items": [
              {
                "text": "15",
                "type": "text"
              }
            ]
          },
          {
            "text": "A hacer juicio contra todos, y á convencer á todos los impíos de entre ellos tocante á todas sus obras de impiedad que han hecho impíamente, y á todas las cosas duras",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.15",
              "verseOrgIds": [
                "JUD.1.15"
              ]
            }
          },
          {
            "text": "que los pecadores impíos han hablado contra él.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.15",
              "verseOrgIds": [
                "JUD.1.15"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "16",
              "style": "v",
              "sid": "JUD 1:16"
            },
            "items": [
              {
                "text": "16",
                "type": "text"
              }
            ]
          },
          {
            "text": "Estos son murmuradores, querellosos, andando según sus deseos; y",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.16",
              "verseOrgIds": [
                "JUD.1.16"
              ]
            }
          },
          {
            "text": "su boca habla cosas soberbias,",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.16",
              "verseOrgIds": [
                "JUD.1.16"
              ]
            }
          },
          {
            "text": "teniendo en admiración las personas por causa del provecho.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.16",
              "verseOrgIds": [
                "JUD.1.16"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "17",
              "style": "v",
              "sid": "JUD 1:17"
            },
            "items": [
              {
                "text": "17",
                "type": "text"
              }
            ]
          },
          {
            "text": "Mas vosotros, amados,",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.17",
              "verseOrgIds": [
                "JUD.1.17"
              ]
            }
          },
          {
            "text": "tened memoria de las palabras que antes han sido dichas por los apóstoles de nuestro Señor Jesucristo;",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.17",
              "verseOrgIds": [
                "JUD.1.17"
              ]
            }
          }
        ]
