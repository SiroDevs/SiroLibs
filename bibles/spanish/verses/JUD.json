        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "18",
              "style": "v",
              "sid": "JUD 1:18"
            },
            "items": [
              {
                "text": "18",
                "type": "text"
              }
            ]
          },
          {
            "text": "Como os decían:",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.18",
              "verseOrgIds": [
                "JUD.1.18"
              ]
            }
          },
          {
            "text": "Que en el postrer tiempo habría burladores, que andarían según sus malvados deseos.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.18",
              "verseOrgIds": [
                "JUD.1.18"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "19",
              "style": "v",
              "sid": "JUD 1:19"
            },
            "items": [
              {
                "text": "19",
                "type": "text"
              }
            ]
          },
          {
            "text": "Estos son",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.19",
              "verseOrgIds": [
                "JUD.1.19"
              ]
            }
          },
          {
            "text": "los que hacen divisiones,",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.19",
              "verseOrgIds": [
                "JUD.1.19"
              ]
            }
          },
          {
            "text": "sensuales,",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.19",
              "verseOrgIds": [
                "JUD.1.19"
              ]
            }
          },
          {
            "text": "no teniendo el Espíritu.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.19",
              "verseOrgIds": [
                "JUD.1.19"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "20",
              "style": "v",
              "sid": "JUD 1:20"
            },
            "items": [
              {
                "text": "20",
                "type": "text"
              }
            ]
          },
          {
            "text": "Mas vosotros, oh amados,",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.20",
              "verseOrgIds": [
                "JUD.1.20"
              ]
            }
          },
          {
            "text": "edificándoos sobre vuestra santísima fe,",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.20",
              "verseOrgIds": [
                "JUD.1.20"
              ]
            }
          },
          {
            "text": "orando por el Espíritu Santo.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.20",
              "verseOrgIds": [
                "JUD.1.20"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
