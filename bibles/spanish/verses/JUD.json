            },
            "items": [
              {
                "text": "22",
                "type": "text"
              }
            ]
          },
          {
            "text": "Y recibid á",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.22",
              "verseOrgIds": [
                "JUD.1.22"
              ]
            }
          },
          {
            "text": "los unos en piedad, discerniendo:",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.22",
              "verseOrgIds": [
                "JUD.1.22"
              ]
            }
          }
        ]
