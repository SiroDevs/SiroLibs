              "sid": "JUD 1:23"
            },
            "items": [
              {
                "text": "23",
                "type": "text"
              }
            ]
          },
          {
            "text": "Mas haced salvos á los",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.23",
              "verseOrgIds": [
                "JUD.1.23"
              ]
            }
          },
          {
            "text": "otros por temor,",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.23",
              "verseOrgIds": [
                "JUD.1.23"
              ]
            }
          },
          {
            "text": "arrebatándolos del fuego; aborreciendo aun",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.23",
              "verseOrgIds": [
                "JUD.1.23"
              ]
            }
          },
          {
            "text": "la ropa que es contaminada de la carne.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.23",
              "verseOrgIds": [
                "JUD.1.23"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "24",
              "style": "v",
              "sid": "JUD 1:24"
            },
            "items": [
              {
                "text": "24",
                "type": "text"
              }
            ]
          },
          {
            "text": "A aquel, pues, que es poderoso para guardaros sin caída, y",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.24",
              "verseOrgIds": [
                "JUD.1.24"
              ]
            }
          },
          {
            "text": "presentaros delante de su gloria irreprensibles, con grande alegría,",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.24",
              "verseOrgIds": [
                "JUD.1.24"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "25",
              "style": "v",
              "sid": "JUD 1:25"
            },
            "items": [
              {
                "text": "25",
                "type": "text"
              }
            ]
          },
          {
            "text": "Al Dios",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.25",
              "verseOrgIds": [
                "JUD.1.25"
              ]
            }
          },
          {
            "text": "solo sabio,",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.25",
              "verseOrgIds": [
                "JUD.1.25"
              ]
            }
          },
          {
            "text": "nuestro Salvador, sea gloria y magnificencia, imperio y potencia, ahora y en todos los siglos. Amén.",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.25",
              "verseOrgIds": [
                "JUD.1.25"
              ]
            }
          }
