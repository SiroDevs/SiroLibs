              "sid": "JUD 1:21"
            },
            "items": [
              {
                "text": "21",
                "type": "text"
              }
            ]
          },
          {
            "text": "Conservaos en el amor de Dios,",
            "type": "text",
            "attrs": {
              "verseId": "JUD.1.21",
              "verseOrgIds": [
                "JUD.1.21"
              ]
            }
          },
          {
            "text": "esperando la misericordia de nuestro Señor Jesucristo, para vida eterna.",
