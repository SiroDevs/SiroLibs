  "reference": "1 Corintios 12",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "1CO 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y ACERCA",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.1",
            "verseOrgIds": [
              "1CO.12.1"
            ]
          }
        },
        {
          "text": "de los",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.1",
            "verseOrgIds": [
              "1CO.12.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "dones",
              "type": "text",
              "attrs": {
                "verseId": "1CO.12.1",
                "verseOrgIds": [
                  "1CO.12.1"
                ]
              }
            }
          ]
        },
        {
          "text": "espirituales, no quiero, hermanos, que ignoréis.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.1",
            "verseOrgIds": [
              "1CO.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sabéis",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.2",
            "verseOrgIds": [
              "1CO.12.2"
            ]
          }
        },
        {
          "text": "que cuando erais Gentiles, ibais, como erais llevados,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.2",
            "verseOrgIds": [
              "1CO.12.2"
            ]
          }
        },
        {
          "text": "a los ídolos mudos.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.2",
            "verseOrgIds": [
              "1CO.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por tanto os hago saber, que",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.3",
            "verseOrgIds": [
              "1CO.12.3"
            ]
          }
        },
        {
          "text": "nadie que hable por Espíritu de Dios, llama",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.3",
            "verseOrgIds": [
              "1CO.12.3"
            ]
          }
        },
        {
          "text": "anatema á Jesús; y",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.3",
            "verseOrgIds": [
              "1CO.12.3"
            ]
          }
        },
        {
          "text": "nadie puede llamar á Jesús Señor, sino por Espíritu Santo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.3",
            "verseOrgIds": [
              "1CO.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Empero",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.4",
            "verseOrgIds": [
              "1CO.12.4"
            ]
          }
        },
        {
          "text": "hay repartimiento de dones; mas",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.4",
            "verseOrgIds": [
              "1CO.12.4"
            ]
          }
        },
        {
          "text": "el mismo Espíritu",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.4",
            "verseOrgIds": [
              "1CO.12.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "es.",
              "type": "text",
              "attrs": {
                "verseId": "1CO.12.4",
                "verseOrgIds": [
                  "1CO.12.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y hay",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.5",
            "verseOrgIds": [
              "1CO.12.5"
            ]
          }
        },
        {
          "text": "repartimiento de ministerios; mas el mismo Señor",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.5",
            "verseOrgIds": [
              "1CO.12.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "es.",
              "type": "text",
              "attrs": {
                "verseId": "1CO.12.5",
                "verseOrgIds": [
                  "1CO.12.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y hay repartimiento de operaciones; mas el mismo Dios",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.6",
            "verseOrgIds": [
              "1CO.12.6"
            ]
          }
        },
        {
          "text": "es el que obra todas las cosas en todos.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.6",
            "verseOrgIds": [
              "1CO.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Empero á cada uno",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.7",
            "verseOrgIds": [
              "1CO.12.7"
            ]
          }
        },
        {
          "text": "le es dada manifestación del Espíritu para provecho.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.7",
            "verseOrgIds": [
              "1CO.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque á la verdad, á éste es dada por el Espíritu palabra de",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.8",
            "verseOrgIds": [
              "1CO.12.8"
            ]
          }
        },
        {
          "text": "sabiduría; á otro, palabra de",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.8",
            "verseOrgIds": [
              "1CO.12.8"
            ]
          }
        },
        {
          "text": "ciencia según el mismo Espíritu;",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.8",
            "verseOrgIds": [
              "1CO.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "A otro,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.9",
            "verseOrgIds": [
              "1CO.12.9"
            ]
          }
        },
        {
          "text": "fe por el mismo Espíritu, y á otro,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.9",
            "verseOrgIds": [
              "1CO.12.9"
            ]
          }
        },
        {
          "text": "dones de sanidades por el mismo Espíritu;",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.9",
            "verseOrgIds": [
              "1CO.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "A otro, operaciones de milagros; y á otro, profecía; y á otro,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.10",
            "verseOrgIds": [
              "1CO.12.10"
            ]
          }
        },
        {
          "text": "discreción de espíritus; y á otro,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.10",
            "verseOrgIds": [
              "1CO.12.10"
            ]
          }
        },
        {
          "text": "géneros de lenguas; y á otro,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.10",
            "verseOrgIds": [
              "1CO.12.10"
            ]
          }
        },
        {
          "text": "interpretación de lenguas.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.10",
            "verseOrgIds": [
              "1CO.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas todas estas cosas obra uno y el mismo Espíritu, repartiendo particularmente á cada uno como quiere.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.11",
            "verseOrgIds": [
              "1CO.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.12",
            "verseOrgIds": [
              "1CO.12.12"
            ]
          }
        },
        {
          "text": "de la manera que el cuerpo es uno, y tiene muchos miembros, empero todos los miembros del cuerpo, siendo muchos, son un cuerpo, así también Cristo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.12",
            "verseOrgIds": [
              "1CO.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque por un Espíritu somos todos bautizados en un cuerpo,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.13",
            "verseOrgIds": [
              "1CO.12.13"
            ]
          }
        },
        {
          "text": "ora Judíos ó Griegos, ora siervos ó libres; y todos",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.13",
            "verseOrgIds": [
              "1CO.12.13"
            ]
          }
        },
        {
          "text": "hemos bebido de",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.13",
            "verseOrgIds": [
              "1CO.12.13"
            ]
          }
        },
        {
          "text": "un mismo Espíritu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.13",
            "verseOrgIds": [
              "1CO.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pues ni tampoco el cuerpo es un miembro, sino muchos.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.14",
            "verseOrgIds": [
              "1CO.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si dijere el pie: Porque no soy mano, no soy del cuerpo: ¿por eso no será del cuerpo?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.15",
            "verseOrgIds": [
              "1CO.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y si dijere la oreja: Porque no soy ojo, no soy del cuerpo: ¿por eso no será del cuerpo?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.16",
            "verseOrgIds": [
              "1CO.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si todo el cuerpo fuese ojo, ¿dónde estaría el oído? Si todo fuese oído, ¿dónde estaría el olfato?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.17",
            "verseOrgIds": [
              "1CO.12.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas ahora Dios ha colocado los miembros cada uno de ellos en el cuerpo, como quiso.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.18",
            "verseOrgIds": [
              "1CO.12.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que si todos fueran un miembro, ¿dónde estuviera el cuerpo?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.19",
            "verseOrgIds": [
              "1CO.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas ahora muchos miembros son á la verdad, empero un cuerpo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.20",
            "verseOrgIds": [
              "1CO.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni el ojo puede decir á la mano: No te he menester: ni asimismo la cabeza á los pies: No tengo necesidad de vosotros.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.21",
            "verseOrgIds": [
              "1CO.12.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antes, mucho más los miembros del cuerpo que parecen más flacos, son necesarios;",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.22",
            "verseOrgIds": [
              "1CO.12.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y á aquellos del cuerpo que estimamos ser más viles, á éstos vestimos más honrosamente; y los que en nosotros son menos honestos, tienen más compostura.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.23",
            "verseOrgIds": [
              "1CO.12.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque los que en nosotros son más honestos, no tienen necesidad: mas Dios ordenó el cuerpo, dando más abundante honor al que le faltaba;",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.24",
            "verseOrgIds": [
              "1CO.12.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Para que no haya desavenencia en el cuerpo, sino que los miembros todos se interesen los unos por los otros.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.25",
            "verseOrgIds": [
              "1CO.12.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por manera que si un miembro padece, todos los miembros á una se duelen; y si un miembro es honrado, todos los miembros",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.26",
            "verseOrgIds": [
              "1CO.12.26"
            ]
          }
        },
        {
          "text": "a una se gozan.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.26",
            "verseOrgIds": [
              "1CO.12.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pues",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.27",
            "verseOrgIds": [
              "1CO.12.27"
            ]
          }
        },
        {
          "text": "vosotros sois el cuerpo de Cristo, y",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.27",
            "verseOrgIds": [
              "1CO.12.27"
            ]
          }
        },
        {
          "text": "miembros en parte.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.27",
            "verseOrgIds": [
              "1CO.12.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y á unos puso Dios en la iglesia, primeramente",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.28",
            "verseOrgIds": [
              "1CO.12.28"
            ]
          }
        },
        {
          "text": "apóstoles, luego",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.28",
            "verseOrgIds": [
              "1CO.12.28"
            ]
          }
        },
        {
          "text": "profetas, lo tercero doctores; luego",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.28",
            "verseOrgIds": [
              "1CO.12.28"
            ]
          }
        },
        {
          "text": "facultades; luego dones de sanidades, ayudas,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.28",
            "verseOrgIds": [
              "1CO.12.28"
            ]
          }
        },
        {
          "text": "gobernaciones, géneros de lenguas.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.28",
            "verseOrgIds": [
              "1CO.12.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Son todos apóstoles? ¿son todos profetas? ¿todos doctores? ¿todos facultades?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.29",
            "verseOrgIds": [
              "1CO.12.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Excelencia de la caridad.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 Dones de profecía",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Tienen todos dones de sanidad?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.30",
            "verseOrgIds": [
              "1CO.12.30"
            ]
          }
        },
        {
          "text": "¿hablan todos lenguas? ¿interpretan todos?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.30",
            "verseOrgIds": [
              "1CO.12.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Empero",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.31",
            "verseOrgIds": [
              "1CO.12.31"
            ]
          }
        },
        {
          "text": "procurad los mejores dones; mas aun yo os muestro un camino más excelente.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.31",
            "verseOrgIds": [
              "1CO.12.31"
            ]
          }
        }
      ]
    }
  ],
