{
  "id": "ROM.1",
  "number": "1",
  "bookId": "ROM",
  "reference": "Romanos 1",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "ROM 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "PABLO, siervo de Jesucristo,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.1",
            "verseOrgIds": [
              "ROM.1.1"
            ]
          }
        },
        {
          "text": "llamado",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.1",
            "verseOrgIds": [
              "ROM.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "á ser",
              "type": "text",
              "attrs": {
                "verseId": "ROM.1.1",
                "verseOrgIds": [
                  "ROM.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "apóstol,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.1",
            "verseOrgIds": [
              "ROM.1.1"
            ]
          }
        },
        {
          "text": "apartado para el evangelio de Dios,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.1",
            "verseOrgIds": [
              "ROM.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que él había antes prometido",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.2",
            "verseOrgIds": [
              "ROM.1.2"
            ]
          }
        },
        {
          "text": "por sus profetas en las santas Escrituras,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.2",
            "verseOrgIds": [
              "ROM.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acerca de su Hijo,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.3",
            "verseOrgIds": [
              "ROM.1.3"
            ]
          }
        },
        {
          "text": "(que fué hecho de la simiente de David según la carne;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.3",
            "verseOrgIds": [
              "ROM.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "El cual fué",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.4",
            "verseOrgIds": [
              "ROM.1.4"
            ]
          }
        },
        {
          "text": "declarado Hijo de Dios con potencia,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.4",
            "verseOrgIds": [
              "ROM.1.4"
            ]
          }
        },
        {
          "text": "según el espíritu de santidad, por la resurrección de los muertos), de Jesucristo Señor nuestro,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.4",
            "verseOrgIds": [
              "ROM.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por el cual",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.5",
            "verseOrgIds": [
              "ROM.1.5"
            ]
          }
        },
        {
          "text": "recibimos la gracia y el apostolado, para la obediencia de la fe en todas las naciones en su nombre,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.5",
            "verseOrgIds": [
              "ROM.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entre las cuales sois también vosotros,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.6",
            "verseOrgIds": [
              "ROM.1.6"
            ]
          }
        },
        {
          "text": "llamados de Jesucristo:",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.6",
            "verseOrgIds": [
              "ROM.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "A todos los que estáis en Roma, amados de Dios, llamados santos:",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.7",
            "verseOrgIds": [
              "ROM.1.7"
            ]
          }
        },
        {
          "text": "Gracia y paz tengáis de Dios nuestro Padre, y del Señor Jesucristo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.7",
            "verseOrgIds": [
              "ROM.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Primeramente,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.8",
            "verseOrgIds": [
              "ROM.1.8"
            ]
          }
        },
        {
          "text": "doy gracias á mi Dios por Jesucristo acerca de todos vosotros, de que",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.8",
            "verseOrgIds": [
              "ROM.1.8"
            ]
          }
        },
        {
          "text": "vuestra fe es predicada en todo el mundo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.8",
            "verseOrgIds": [
              "ROM.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque testigo me es Dios, al cual sirvo en mi espíritu en el evangelio de su Hijo, que",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.9",
            "verseOrgIds": [
              "ROM.1.9"
            ]
          }
        },
        {
          "text": "sin cesar me acuerdo de vosotros siempre en mis oraciones,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.9",
            "verseOrgIds": [
              "ROM.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Poder del evangelio.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 Depravación de los Gentiles.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rogando,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.10",
            "verseOrgIds": [
              "ROM.1.10"
            ]
          }
        },
        {
          "text": "si al fin algún tiempo haya de tener, por la voluntad de Dios, próspero viaje para ir á vosotros.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.10",
            "verseOrgIds": [
              "ROM.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque os deseo ver, para repartir con vosotros algún don espiritual, para confirmaros;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.11",
            "verseOrgIds": [
              "ROM.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Es á saber, para ser juntamente consolado con vosotros por la común fe vuestra y juntamente mía.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.12",
            "verseOrgIds": [
              "ROM.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas no quiero, hermanos, que ingnoréis que",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.13",
            "verseOrgIds": [
              "ROM.1.13"
            ]
          }
        },
        {
          "text": "muchas veces me he propuesto ir á vosotros (empero hasta ahora he sido estorbado), para tener también entre vosotros algún fruto, como entre los demás Gentiles.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.13",
            "verseOrgIds": [
              "ROM.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "A Griegos y",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.14",
            "verseOrgIds": [
              "ROM.1.14"
            ]
          }
        },
        {
          "text": "a bárbaros, á sabios y á no sabios soy deudor.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.14",
            "verseOrgIds": [
              "ROM.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Así que, cuanto á mí, presto estoy á anunciar el evangelio también á vosotros que estáis en Roma.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.15",
            "verseOrgIds": [
              "ROM.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque no me avergüenzo del evangelio:",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.16",
            "verseOrgIds": [
              "ROM.1.16"
            ]
          }
        },
        {
          "text": "porque es potencia de Dios para salud á todo aquel que cree;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.16",
            "verseOrgIds": [
              "ROM.1.16"
            ]
          }
        },
        {
          "text": "al Judío primeramente y también al Griego.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.16",
            "verseOrgIds": [
              "ROM.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.17",
            "verseOrgIds": [
              "ROM.1.17"
            ]
          }
        },
        {
          "text": "en él la justicia de Dios se descubre de fe en fe; como está escrito: Mas",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.17",
            "verseOrgIds": [
              "ROM.1.17"
            ]
          }
        },
        {
          "text": "el justo vivirá por la fe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.17",
            "verseOrgIds": [
              "ROM.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque manifiesta",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.18",
            "verseOrgIds": [
              "ROM.1.18"
            ]
          }
        },
        {
          "text": "es la ira de Dios del cielo contra toda impiedad é injusticia de los hombres, que detienen la verdad con injusticia:",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.18",
            "verseOrgIds": [
              "ROM.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.19",
            "verseOrgIds": [
              "ROM.1.19"
            ]
          }
        },
        {
          "text": "lo que de Dios se conoce, á ellos es manifiesto; porque Dios se lo manifestó.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.19",
            "verseOrgIds": [
              "ROM.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.20",
            "verseOrgIds": [
              "ROM.1.20"
            ]
          }
        },
        {
          "text": "las cosas invisibles de él, su eterna potencia y divinidad, se echan de ver desde la creación del mundo, siendo entendidas por las cosas que son hechas; de modo que son",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.20",
            "verseOrgIds": [
              "ROM.1.20"
            ]
          }
        },
        {
          "text": "inexcusables:",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.20",
            "verseOrgIds": [
              "ROM.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque habiendo conocido á Dios, no le glorificaron como á Dios, ni dieron gracias; antes",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.21",
            "verseOrgIds": [
              "ROM.1.21"
            ]
          }
        },
        {
          "text": "se desvanecieron en sus discursos, y el necio corazón de ellos fué entenebrecido.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.21",
            "verseOrgIds": [
              "ROM.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diciéndose ser sabios, se hicieron fatuos,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.22",
            "verseOrgIds": [
              "ROM.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y trocaron la gloria del Dios incorruptible en semejanza",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.23",
            "verseOrgIds": [
              "ROM.1.23"
            ]
          }
        },
        {
          "text": "de imagen de hombre corruptible, y de aves, y de animales de cuatro pies, y de serpientes.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.23",
            "verseOrgIds": [
              "ROM.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por lo cual también",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.24",
            "verseOrgIds": [
              "ROM.1.24"
            ]
          }
        },
        {
          "text": "Dios los entregó á inmundicia, en las concupiscencias de sus corazones,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.24",
            "verseOrgIds": [
              "ROM.1.24"
            ]
          }
        },
        {
          "text": "de suerte que contaminaron sus cuerpos entre sí mismos:",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.24",
            "verseOrgIds": [
              "ROM.1.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los cuales mudaron la verdad de Dios",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.25",
            "verseOrgIds": [
              "ROM.1.25"
            ]
          }
        },
        {
          "text": "en mentira, honrando y sirviendo á las criaturas antes que al Criador, el cual es bendito por los siglos. Amén.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.25",
            "verseOrgIds": [
              "ROM.1.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por esto Dios los entregó á afectos vergonzosos; pues aun sus mujeres mudaron el natural uso en el uso que es contra naturaleza:",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.26",
            "verseOrgIds": [
              "ROM.1.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ROM 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y del mismo modo también los hombres, dejando el uso natural de las mujeres, se encendieron en sus concupiscencias los unos con los otros, cometiendo cosas nefandas hombres con hombres, y recibiendo en sí mismos la recompensa que convino á su extravío.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.27",
            "verseOrgIds": [
              "ROM.1.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ROM 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y como á ellos no les pareció tener á Dios en",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.28",
            "verseOrgIds": [
              "ROM.1.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "su",
              "type": "text",
              "attrs": {
                "verseId": "ROM.1.28",
                "verseOrgIds": [
                  "ROM.1.28"
                ]
              }
            }
          ]
        },
        {
          "text": "noticia,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.28",
            "verseOrgIds": [
              "ROM.1.28"
            ]
          }
        },
        {
          "text": "Dios los entregó á una mente depravada,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.28",
            "verseOrgIds": [
              "ROM.1.28"
            ]
          }
        },
        {
          "text": "para hacer lo que no conviene,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.28",
            "verseOrgIds": [
              "ROM.1.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Estando atestados de toda iniquidad, de fornicación, de malicia, de avaricia, de maldad; llenos de envidia, de homicidios, de contiendas, de engaños, de malignidades;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.29",
            "verseOrgIds": [
              "ROM.1.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murmuradores, detractores, aborrecedores de Dios, injuriosos, soberbios, altivos, inventores de males, desobedientes á los padres,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.30",
            "verseOrgIds": [
              "ROM.1.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Necios, desleales, sin afecto natural, implacables, sin misericordia:",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.31",
            "verseOrgIds": [
              "ROM.1.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ROM 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.32",
            "verseOrgIds": [
              "ROM.1.32"
            ]
          }
        },
        {
          "text": "habiendo entendido el juicio de Dios que los que hacen tales cosas",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.32",
            "verseOrgIds": [
              "ROM.1.32"
            ]
          }
        },
        {
          "text": "son dignos de muerte, no sólo las hacen, más aún",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.32",
            "verseOrgIds": [
              "ROM.1.32"
            ]
          }
        },
        {
          "text": "consienten á los que las hacen.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.32",
            "verseOrgIds": [
              "ROM.1.32"
            ]
          }
        }
      ]
    }
  ],
