          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y Darío de Media",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.31",
            "verseOrgIds": [
              "DAN.6.1"
            ]
          }
        },
        {
