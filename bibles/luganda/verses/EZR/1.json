    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuulo Ayamba Abawaŋŋanguse okuddayo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo mu mwaka ogw'olubereberye ogw'obufuzi bwa Kuulo kabaka wa Buperusi, ekigambo",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.1",
            "verseOrgIds": [
              "EZR.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZR.1.1",
                "verseOrgIds": [
                  "EZR.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "kye yayogerera mu Yeremiya ne kituukirira,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.1",
            "verseOrgIds": [
              "EZR.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZR.1.1",
                "verseOrgIds": [
                  "EZR.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "n'akoma ku mutima gwa Kuulo kabaka w'e Buperusi okulangirira mu bwakabaka bwe bwonna, n'okukiteeka mu buwandiike nti,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.1",
            "verseOrgIds": [
              "EZR.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bw'ati bw'ayogera Kuulo",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.2",
            "verseOrgIds": [
              "EZR.1.2"
            ]
          }
        },
        {
          "text": "kabaka w'e Buperusi nti,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.2",
            "verseOrgIds": [
              "EZR.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "EZR 1:2"
      },
      "items": [
        {
          "text": "\" 'Obwakabaka bwonna obw'omu nsi",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.2",
            "verseOrgIds": [
              "EZR.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZR.1.2",
                "verseOrgIds": [
                  "EZR.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda w'eggulu abumpadde, era annonze okumuzimbira yeekaalu e Yerusaalemi mu Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.2",
            "verseOrgIds": [
              "EZR.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu yenna mu mmwe abantu be, Katonda we abeere naye, agende e Yerusaalemi mu Yuda addaabirize yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.3",
            "verseOrgIds": [
              "EZR.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZR.1.3",
                "verseOrgIds": [
                  "EZR.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", Katonda wa Isirayiri, Katonda ali mu Yerusaalemi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.3",
            "verseOrgIds": [
              "EZR.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na buli Muyisirayiri eyasigalawo gy'ali, abantu abo baabeeramu, banaamuwa ffeeza ne zaabu, n'ebintu n'ebisolo ebirundibwa, obutasaako ebiweebwayo bye bawaayo ku bwabwe ebya yeekaalu ya Katonda eri mu Yerusaalemi.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.4",
            "verseOrgIds": [
              "EZR.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo abakulu b'ennyumba za Yuda ne Benyamini, ne bakabona, n'Abaleevi, na buli muntu Katonda gwe yakubiriza, ne beeteekateeka okwambuka okugenda okuddaabiriza yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.5",
            "verseOrgIds": [
              "EZR.1.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZR.1.5",
                "verseOrgIds": [
                  "EZR.1.5"
                ]
              }
            }
          ]
        },
        {
          "text": "eri mu Yerusaalemi",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.5",
            "verseOrgIds": [
              "EZR.1.5"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.5",
            "verseOrgIds": [
              "EZR.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baliraanwa baabwe bonna ne babawa ebintu ebya ffeeza ne zaabu, n'ebintu ebirala n'ebisolo ebirundibwa, n'ebirabo eby'omuwendo omungi, okwo nga kwe kuli ebiweebwayo bye baawaayo nga beeyagalidde.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.6",
            "verseOrgIds": [
              "EZR.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebintu ebyali mu yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.7",
            "verseOrgIds": [
              "EZR.1.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZR.1.7",
                "verseOrgIds": [
                  "EZR.1.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", Nebukadduneeza bye yanyaga mu Yerusaalemi n'abiteeka mu ssabo lya bakatonda be, Kabaka Kuulo, n'abiggyayo.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.7",
            "verseOrgIds": [
              "EZR.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuulo kabaka w'e Buperusi n'abikwasa Misuledasi omuwanika, eyabikwasa Sesubazzali omulangira wa Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.8",
            "verseOrgIds": [
              "EZR.1.8"
            ]
          }
        }
      ]
    },
