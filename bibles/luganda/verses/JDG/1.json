  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "JDG 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oluvannyuma lw'okufa kwa Yoswa, Abayisirayiri ne babuuza",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.1",
            "verseOrgIds": [
              "JDG.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JDG.1.1",
                "verseOrgIds": [
                  "JDG.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda nti, \"Ani mu ffe alisooka okwaŋŋanga Abakanani okubalwanyisa?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.1",
            "verseOrgIds": [
              "JDG.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JDG.1.2",
                "verseOrgIds": [
                  "JDG.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda n'abaddamu nti Yuda yalisooka, era laba mbawadde obuwanguzi ku Bakanani.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.2",
            "verseOrgIds": [
              "JDG.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasajja ba Yuda ne bagamba baganda baabwe abasajja ba Simyoni",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.3",
            "verseOrgIds": [
              "JDG.1.3"
            ]
          }
        },
        {
          "text": "nti, \"Tugende ffenna mu kitundu kyaffe ekyatuweebwa tulwanyise Abakanani, era naffe tuligenda nammwe mu kitundu ekyabaweebwa.\" Awo ne bagenda bonna.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.3",
            "verseOrgIds": [
              "JDG.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda n'alumba Abakanani n'Abaperezi e Bezeki era",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.4",
            "verseOrgIds": [
              "JDG.1.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JDG.1.4",
                "verseOrgIds": [
                  "JDG.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": "n'amuwa obuwanguzi n'abattamu abasajja omutwalo mulamba.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.4",
            "verseOrgIds": [
              "JDG.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bagwikiriza Adonibezeki mu Bezeki; ne bamulwanyisa era ne batta abasajja be.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.5",
            "verseOrgIds": [
              "JDG.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Adonibezeki ne yeemulula, ne bamuwondera, ne bamukwata era ne bamusalako engalo ze ensajja n'ebigere ebisajja",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.6",
            "verseOrgIds": [
              "JDG.1.6"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.6",
            "verseOrgIds": [
              "JDG.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adonibezeki ne yejjusa n'agamba nti, \"Nga bakabaka ensanvu abaasalibwako engalo zaabwe ensajja n'ebigere ebisajja, bwe baalondalondanga obukunkumuka wansi w'emmeeza yange, nange bwe ŋŋenda okuba. Kye nakola bannange Katonda nange akintusizzaako.\" Ne bamutwala e Yerusaalemi n'afiira eyo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.7",
            "verseOrgIds": [
              "JDG.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasajja ba Yuda ne balumba ekibuga Yerusaalemi ne bakiwamba ne batta abantu baamu n'ekitala, oluvannyuma ne bakyokya.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.8",
            "verseOrgIds": [
              "JDG.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo abasajja ba Yuda ne balumba Abakanani abaabeeranga mu nsozi ne mu biwonvu ne mu bukiika obwa ddyo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.9",
            "verseOrgIds": [
              "JDG.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate Yuda n'alumba Abakanani abaabeeranga e Kebbulooni (edda ekyayitibwanga Kiriasualuba), mu lutalo olwali eyo mwe battira Sesayi, Akimaani ne Talumaayi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.10",
            "verseOrgIds": [
              "JDG.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate n'avaayo n'alumba abaabeeranga e Debiri edda ekyayitibwanga Kiriasuseferi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.11",
            "verseOrgIds": [
              "JDG.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Kalebu n'agamba nti, \"Oyo alirumba Kiriasuseferi n'akiwamba ndimuwa muwala wange Akusa okumuwasa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.12",
            "verseOrgIds": [
              "JDG.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osunieri, omwana wa Kenazi muto wa Kalebu n'akiwamba bw'atyo n'aweebwa Akusa okumuwasa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.13",
            "verseOrgIds": [
              "JDG.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Osunieri bwe yamala okuwasa Akusa n'amufukuutirira asabe kitaawe ennimiro; Akusa n'addayo eri kitaawe, bwe yali ava ku ndogoyi, Kalebe n'amubuuza nti, \"Oyagala ki?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.14",
            "verseOrgIds": [
              "JDG.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'amuddamu nti, \"Wampa ensi nkalu ey'obukiikaddyo naye kaakano nnyongera ekitundu ekirimu n'enzizi ez'amazzi.\" Kalebu n'amuwa ekitundu ekirimu enzizi ekyengulu n'ekyemmanga.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.15",
            "verseOrgIds": [
              "JDG.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abazzukulu b'Omukeeni, mukoddomi wa Musa ne bava mu kibuga eky'enkindu ne bagendera wamu n'abasajja ba Yuda ne batuuka mu ddungu lya Yuda eryali mu bukiikaddyo obwa Aladi ne babeera wamu n'abantu baayo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.16",
            "verseOrgIds": [
              "JDG.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yuda n'agenda ne muganda we Simyoni ne balumba Abakanani abaabeeranga e Zefasi, ne babazikiririza ddala era ne bakituuma erinnya Koluma",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.17",
            "verseOrgIds": [
              "JDG.1.17"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.17",
            "verseOrgIds": [
              "JDG.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era Yuda n'awamba Gaza, Asukulooni ne Ekuloni n'ebitundu ebyetoolodde ebibuga bino.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.18",
            "verseOrgIds": [
              "JDG.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JDG.1.19",
                "verseOrgIds": [
                  "JDG.1.19"
                ]
              }
            }
          ]
        },
        {
          "text": "yali wamu ne Yuda n'awangula abantu abaabeeranga mu nsozi okuggyako yalemwa okuwangula abantu abaabeeranga mu kiwonvu kubanga baalina amagaali ag'ekyuma.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.19",
            "verseOrgIds": [
              "JDG.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kebbulooni n'ekiweebwa Kalebu, nga Musa bwe yalagira, n'akifuumulamu batabani ba Anaki abasatu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.20",
            "verseOrgIds": [
              "JDG.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye abasajja ba Benyamini tebaagoba Bayebusi abaabeeranga mu Yerusaalemi noolwekyo Abayebusi babeera wamu n'abasajja ba Benyamini mu Yerusaalemi n'okutuusa kaakano.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.21",
            "verseOrgIds": [
              "JDG.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'abasajja ba Yusufu ne balumba Beseri era",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.22",
            "verseOrgIds": [
              "JDG.1.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JDG.1.22",
                "verseOrgIds": [
                  "JDG.1.22"
                ]
              }
            }
          ]
        },
        {
          "text": "yali wamu nabo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.22",
            "verseOrgIds": [
              "JDG.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasajja ba Yusufu ne batuma abakessi okuketta ekibuga ky'e Beseri edda ekyayitibwanga Luzi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.23",
            "verseOrgIds": [
              "JDG.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakessi bwe baalaba omusajja ng'ava mu kibuga ne bamugamba nti, \"Tukwegayiridde tulage omulyango oguyingira mu kibuga naffe tunaakuyisa bulungi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.24",
            "verseOrgIds": [
              "JDG.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo bwe yabalaga awayingirirwa, ne bazikiriza n'ekitala abantu b'omu kibuga ekyo; ne batakola kabi konna ku musajja oyo n'ab'omu nnyumba ye bonna.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.25",
            "verseOrgIds": [
              "JDG.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusajja oyo n'asengukira mu nsi y'Abakiiti, n'azimbayo n'ekibuga n'akituuma Luzi, n'okutuusa kaakano bwe kiyitibwa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.26",
            "verseOrgIds": [
              "JDG.1.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye Manase teyagoba bantu abaabeeranga mu Besuseani, ne mu Taanaki ne mu Poliyadde abaabeeranga mu Ibuleamu, ne mu Megiddo, n'ebyalo ebiriraanye ebibuga ebyo. Naye Abakanani ne bagaanira ddala okuva mu nsi eyo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.27",
            "verseOrgIds": [
              "JDG.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Abayisirayiri bwe beeyongera amaanyi ne bawaliriza Abakanani okubakoleranga emirimu mu kifo ky'okugobwa mu nsi eyo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.28",
            "verseOrgIds": [
              "JDG.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era ne Efulayimu teyagoba Bakanani naye yabakkiriza okubeera awamu naye mu Gezeri.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.29",
            "verseOrgIds": [
              "JDG.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era ne Zebbulooni teyagoba abantu abaabeeranga mu Kitulooni yadde abaabeeranga mu Nakaloli, naye Abakanani bano n'abakkiriza okubeeranga awamu naye nga bwe bamusasula omusolo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.30",
            "verseOrgIds": [
              "JDG.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aseri teyagoba bantu abaabeeranga mu Akko yadde ab'omu Sidoni n'ab'omu Alaba n'ab'omu Akuzibu n'ab'omu Keruba n'ab'omu Afiki yadde ab'omu Lekobu,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.31",
            "verseOrgIds": [
              "JDG.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye Abakanani ne bakkirizibwa okubeera awamu n'abantu ba Aseri.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.32",
            "verseOrgIds": [
              "JDG.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nafutaali teyagoba bantu abaabeeranga mu Besusemesi ne mu Besuanasi naye n'abakkirizanga okubeeranga awamu n'abantu be nga bwe bamusasula omusolo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.33",
            "verseOrgIds": [
              "JDG.1.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bo abasajja ba Ddaani tebaasobola kuwamba nsi y'Abamoli ey'omu kiwonvu era Abamoli ne babafuumuula ne baabazaayo mu nsozi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.34",
            "verseOrgIds": [
              "JDG.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Newaakubadde Abamoli baalwanirira nnyo okubeera ku lusozi Keresi, mu Ayalooni ne Saalubimu naye ab'omu kika kya Yusufu ne babafufuggaza era ne babawaliriza okubawanga omusolo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.35",
            "verseOrgIds": [
              "JDG.1.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JDG 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensalo y'Abamoli yayitanga awo ng'oyambuka Akulabbimu n'okweyongerayo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.36",
            "verseOrgIds": [
              "JDG.1.36"
            ]
          }
        }
      ]
    }
