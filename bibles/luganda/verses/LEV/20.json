              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kibasaanira okubeeranga abatukuvu gye ndi, kubanga Nze,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.26",
            "verseOrgIds": [
              "LEV.20.26"
            ]
          }
        },
        {
          "name": "char",
