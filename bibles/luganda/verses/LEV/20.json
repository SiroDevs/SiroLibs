                "verseOrgIds": [
                  "LEV.20.26"
                ]
              }
            }
          ]
        },
        {
          "text": ", ndi mutukuvu, era mbaawudde ku mawanga amalala mubeerenga ggwanga lyange.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.26",
