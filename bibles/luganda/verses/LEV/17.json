  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "LEV 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Etteeka ku Biweebwayo Ebitali bya Bulijjo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.1",
            "verseOrgIds": [
              "LEV.17.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.17.1",
                "verseOrgIds": [
                  "LEV.17.1"
                ]
              }
            }
          ]
        },
        {
          "text": "n'agamba Musa nti,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.1",
            "verseOrgIds": [
              "LEV.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tegeeza Alooni ne batabani be n'abaana ba Isirayiri bonna, obagambe nti, Kino",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.2",
            "verseOrgIds": [
              "LEV.17.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.17.2",
                "verseOrgIds": [
                  "LEV.17.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ky'alagidde:",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.2",
            "verseOrgIds": [
              "LEV.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu yenna Omuyisirayiri anaawangayo ekiweebwayo eky'ente, oba endiga ento, oba embuzi, munda mu lusiisira oba ebweru w'olusiisira,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.3",
            "verseOrgIds": [
              "LEV.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nga tagireese ku mulyango gw'Eweema ey'Okukuŋŋaanirangamu, okugiwaayo ng'ekirabo ekiweebwayo eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.4",
            "verseOrgIds": [
              "LEV.17.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.17.4",
                "verseOrgIds": [
                  "LEV.17.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda mu kisasi ky'Eweema ya",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.4",
            "verseOrgIds": [
              "LEV.17.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.17.4",
                "verseOrgIds": [
                  "LEV.17.4"
                ]
              }
            }
          ]
        },
        {
          "text": "; omuntu oyo anaabanga azzizza omusango ogw'okuyiwa omusaayi; olwokubanga ayiye omusaayi, anaagobwanga n'agaanibwa okukolagananga ne banne.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.4",
            "verseOrgIds": [
              "LEV.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyo kiri bwe kityo abaana ba Isirayiri balyoke balekeraawo okuweerangayo ebiweebwayo byabwe ebweru mu nnimiro, naye babireetenga awali",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.5",
            "verseOrgIds": [
              "LEV.17.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.17.5",
                "verseOrgIds": [
                  "LEV.17.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda. Kibagwanira okubireetanga eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.5",
            "verseOrgIds": [
              "LEV.17.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.17.5",
                "verseOrgIds": [
                  "LEV.17.5"
                ]
              }
            }
          ]
        },
        {
          "text": "babikwasenga kabona ku mulyango gw'Eweema ey'Okukuŋŋaanirangamu, ne biryoka bittibwa nga bye biweebwayo eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.5",
            "verseOrgIds": [
              "LEV.17.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.17.5",
                "verseOrgIds": [
                  "LEV.17.5"
                ]
              }
            }
          ]
        },
        {
          "text": "olw'emirembe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.5",
            "verseOrgIds": [
              "LEV.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabona anaamansiranga omusaayi ku kyoto kya",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.6",
            "verseOrgIds": [
              "LEV.17.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.17.6",
                "verseOrgIds": [
                  "LEV.17.6"
                ]
              }
            }
          ]
        },
        {
          "text": "ku mulyango gw'Eweema ey'Okukuŋŋaanirangamu, amasavu n'agookya ne muvaamu akaloosa akalungi akasanyusa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.6",
            "verseOrgIds": [
              "LEV.17.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.17.6",
                "verseOrgIds": [
                  "LEV.17.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.6",
            "verseOrgIds": [
              "LEV.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tebasaana kwongera kuwangayo biweebwayo byabwe eri bakatonda be beekoledde mu kifaananyi ky'embuzi, be bakola nabyo eby'obwamalaaya",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.7",
            "verseOrgIds": [
              "LEV.17.7"
            ]
          }
        },
        {
          "text": ". Eryo linaabanga tteeka lyabwe lya lubeerera n'okuyita mu mirembe egigenda okuddawo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.7",
            "verseOrgIds": [
              "LEV.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Era bagambe nti, Buli muntu yenna Omuyisirayiri, oba omunnaggwanga yenna abeera mu bo, aliwaayo ekiweebwayo ekyokebwa, oba ekiweebwayo eky'engeri yonna,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.8",
            "verseOrgIds": [
              "LEV.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nga takireese ku mulyango gw'Eweema ey'Okukuŋŋaanirangamu, okukiwaayo eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.9",
            "verseOrgIds": [
              "LEV.17.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.17.9",
                "verseOrgIds": [
                  "LEV.17.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda, omuntu oyo anaagobwanga n'agaanibwa okukolagananga ne banne.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.9",
            "verseOrgIds": [
              "LEV.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Omuntu yenna Omuyisirayiri oba ow'omu bannamawanga ababeera mu Isirayiri bw'anaalyanga omusaayi ogw'engeri yonna, nnaamunyiigiranga oyo anaalyanga omusaayi, era nnaamugobanga ne mugaana okukolagananga ne banne.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.10",
            "verseOrgIds": [
              "LEV.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga obulamu bw'ekitonde buli mu musaayi, ate nkibawadde okubatangiririra ku kyoto; omusaayi gwe gutangiririra obulamu bw'omuntu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.11",
            "verseOrgIds": [
              "LEV.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo Abayisirayiri mbagamba nti tewabanga n'omu mu mmwe anaalyanga omusaayi, era ne munnaggwanga abeera mu mmwe naye taalyenga musaayi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.12",
            "verseOrgIds": [
              "LEV.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Omuyisirayiri yenna, oba omunnaggwanga abeera mu mmwe, bw'anaayigganga ensolo oba ennyonyi nga ya kulya, anaagikenenulangamu omusaayi n'agubikkako ettaka,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.13",
            "verseOrgIds": [
              "LEV.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubanga obulamu bwa buli kitonde gwe musaayi gwakyo. Abayisirayiri kyenvudde mbagamba nti temulyanga musaayi gwa kitonde eky'engeri yonna, kubanga obulamu bwa buli kitonde gwe musaayi gwakyo, omuntu yenna anaagulyanga anaagobwanga n'agaanibwa okukolagana ne banne.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.14",
            "verseOrgIds": [
              "LEV.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Omuntu yenna omuzaaliranwa oba omunnaggwanga anaalyanga ekintu kyonna ekinaabanga kisangiddwa nga kifu, oba nga kitaaguddwataaguddwa ensolo enkambwe, anaayozanga ebyambalo bye, n'anaaba mu mazzi, era anaabeeranga atali mulongoofu okutuusa akawungeezi; oluvannyuma anaabeeranga mulongoofu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.15",
            "verseOrgIds": [
              "LEV.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye bw'ataayozenga byambalo bye, n'okunaaba n'atanaaba, ye anaabanga yeeretedde obutali bulongoofu bwe okumusigalako.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.16",
            "verseOrgIds": [
              "LEV.17.16"
            ]
          }
        }
      ]
    }
  ],
