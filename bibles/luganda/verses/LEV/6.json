          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabona ow'omu baana ba Alooni anaabanga afukiddwako amafuta ag'omuzeeyituuni okumusikira, y'anaakiwangayo eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.22",
            "verseOrgIds": [
              "LEV.6.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.6.22",
                "verseOrgIds": [
                  "LEV.6.15"
                ]
              }
            }
          ]
        },
        {
          "text": "ng'amateeka bwe galagira emirembe gyonna; ekiweebwayo kyonna kinaayokebwanga.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.22",
            "verseOrgIds": [
              "LEV.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli kiweebwayo kyonna eky'emmere ey'empeke kabona ky'anaawangayo kinaayokebwanga bulambalamba; tekiiriibwenga.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.23",
            "verseOrgIds": [
              "LEV.6.16"
            ]
          }
        }
      ]
    },
