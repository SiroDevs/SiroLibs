        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okutwalibwa kwa Eriya mu Ggulu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.1",
            "verseOrgIds": [
              "2KI.2.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.1",
                "verseOrgIds": [
                  "2KI.2.1"
                ]
              }
            }
          ]
        },
        {
          "text": "bwe yali ng'anaatera okutwala Eriya mu ggulu mu mbuyaga ey'amaanyi, nga Eriya ne Erisa bava e Girugaali,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.1",
            "verseOrgIds": [
              "2KI.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eriya n'agamba Erisa nti, \"Sigala wano, ŋŋende e Beseri",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.2",
            "verseOrgIds": [
              "2KI.2.2"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.2",
            "verseOrgIds": [
              "2KI.2.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.2",
                "verseOrgIds": [
                  "2KI.2.2"
                ]
              }
            }
          ]
        },
        {
          "text": "gy'antumye.\" Naye Erisa n'amuddamu nti, \"Mazima nga",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.2",
            "verseOrgIds": [
              "2KI.2.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.2",
                "verseOrgIds": [
                  "2KI.2.2"
                ]
              }
            }
          ]
        },
        {
          "text": "bw'ali omulamu, era nga nawe bw'oli omulamu, siireme kugenda naawe.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.2",
            "verseOrgIds": [
              "2KI.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 2:2"
      },
      "items": [
        {
          "text": "Awo ne baserengeta bonna e Beseri.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.2",
            "verseOrgIds": [
              "2KI.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekibiina ekya bannabbi abaali e Beseri ne bagenda eri Erisa ne bamugamba nti, \"Okimanyi nga",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.3",
            "verseOrgIds": [
              "2KI.2.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.3",
                "verseOrgIds": [
                  "2KI.2.3"
                ]
              }
            }
          ]
        },
        {
          "text": "anaatwala mukama wo olwa leero?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.3",
            "verseOrgIds": [
              "2KI.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 2:3"
      },
      "items": [
        {
          "text": "Erisa n'abaddamu nti, \"Nkimanyi, naye temukyogerako.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.3",
            "verseOrgIds": [
              "2KI.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eriya n'addamu omulundi ogwokubiri n'agamba Erisa nti, \"Sigala wano, ŋŋende e Yeriko",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.4",
            "verseOrgIds": [
              "2KI.2.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.4",
                "verseOrgIds": [
                  "2KI.2.4"
                ]
              }
            }
          ]
        },
        {
          "text": "gy'antumye.\" Naye Erisa n'amuddamu nti, \"Mazima nga",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.4",
            "verseOrgIds": [
              "2KI.2.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.4",
                "verseOrgIds": [
                  "2KI.2.4"
                ]
              }
            }
          ]
        },
        {
          "text": "bw'ali omulamu, era nga nawe bw'oli omulamu, siireme kugenda naawe.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.4",
            "verseOrgIds": [
              "2KI.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 2:4"
      },
      "items": [
        {
          "text": "Awo ne bagenda bonna e Yeriko.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.4",
            "verseOrgIds": [
              "2KI.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ekibiina ekya bannabbi abaali e Yeriko ne batuukirira Erisa ne bamugamba nti, \"Okimanyi nga",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.5",
            "verseOrgIds": [
              "2KI.2.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.5",
                "verseOrgIds": [
                  "2KI.2.5"
                ]
              }
            }
          ]
        },
        {
          "text": "anaatwala mukama wo olwa leero?\" Erisa n'abaddamu nti, \"Weewaawo nkimanyi, naye temukyogerako.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.5",
            "verseOrgIds": [
              "2KI.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eriya n'addamu nate n'amugamba nti, \"Sigala wano, nserengete ku Yoludaani",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.6",
            "verseOrgIds": [
              "2KI.2.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.6",
                "verseOrgIds": [
                  "2KI.2.6"
                ]
              }
            }
          ]
        },
        {
          "text": "gy'antumye.\" Naye Erisa n'amuddamu nti, \"Mazima nga",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.6",
            "verseOrgIds": [
              "2KI.2.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.6",
                "verseOrgIds": [
                  "2KI.2.6"
                ]
              }
            }
          ]
        },
        {
          "text": "bw'ali omulamu, era nga nawe bw'oli omulamu, siireme kugenda naawe.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.6",
            "verseOrgIds": [
              "2KI.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 2:6"
      },
      "items": [
        {
          "text": "Awo ne batambula bombi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.6",
            "verseOrgIds": [
              "2KI.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne waba ekibiina kya bannabbi amakumi ataano abaali bayimiridde akabanga okuva Eriya ne Erisa we baali ku lubalama lw'omugga Yoludaani.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.7",
            "verseOrgIds": [
              "2KI.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Eriya n'addira omunagiro gwe n'aguzinga wamu n'akuba amazzi ne gaawulibwamu, agamu ne gadda ku luuyi olwa ddyo n'amalala ku luuyi olwa kkono, bombi ne bayita ku lukalu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.8",
            "verseOrgIds": [
              "2KI.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo bwe baamala okusomoka, Eriya n'abuuza Erisa nti, \"Kiki ky'oyagala nkukolere nga sinnaba kukuggyibwako?\" Erisa n'amuddamu nti, \"Nkusaba, nsikire emigabo ebiri egy'Omwoyo akuliko.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.9",
            "verseOrgIds": [
              "2KI.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'amugamba nti, \"Ky'osabye kigambo kizibu, naye bw'onondaba nga ntwalibwa, kale kinaaba nga bw'osabye, naye bw'otondabe tekiibe bwe kityo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.10",
            "verseOrgIds": [
              "2KI.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo bwe baali batambula nga bwe banyumya bokka na bokka, ne walabika eggaali ey'omuliro n'embalaasi ez'omuliro ne zibaawula, era mu kiseera kye kimu Eriya n'atwalibwa mu ggulu mu mbuyaga ey'amaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.11",
            "verseOrgIds": [
              "2KI.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Erisa bwe yalaba ekyo, n'ayogerera waggulu nti, \"Kitange, Kitange, amagaali n'abeebagala embalaasi aba Isirayiri!\" Erisa n'ataddamu kumulaba nate. N'addira engoye ze yali ayambadde, n'aziyuzaayuza.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.12",
            "verseOrgIds": [
              "2KI.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaliwo omunagiro ogwali gusuulibbwa Eriya ng'atwalibwa mu ggulu, era ogwo Erisa gwe yalonda n'addayo ku mugga Yoludaani n'ayimirira ku lubalama lw'omugga.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.13",
            "verseOrgIds": [
              "2KI.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'addira omunagiro gwe yali alonze n'aguzinga n'akuba amazzi n'ayogera nti, \"Kaakano",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.14",
            "verseOrgIds": [
              "2KI.2.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.14",
                "verseOrgIds": [
                  "2KI.2.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", Katonda wa Eriya ali luuyi wa?\" Bwe yakuba amazzi ne geeyawulamu, agamu ne gadda ku luuyi olwa ddyo n'amalala ku luuyi olwa kkono, n'asomoka.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.14",
            "verseOrgIds": [
              "2KI.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ekibiina ekya bannabbi abaali mu Yeriko ne bayogera nti, \"Omwoyo wa Eriya ali ku Erisa.\" Ne bagenda okumusisinkana ne bamuvuunamira.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.15",
            "verseOrgIds": [
              "2KI.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bamugamba nti, \"Laba, ffe abaddu bo tulina abasajja abazira amakumi ataano. Bagende banoonye mukama wo, osanga Omwoyo wa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.16",
            "verseOrgIds": [
              "2KI.2.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.16",
                "verseOrgIds": [
                  "2KI.2.16"
                ]
              }
            }
          ]
        },
        {
          "text": "amututte n'amuteeka ku bumu ku busozi oba mu kiwonvu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.16",
            "verseOrgIds": [
              "2KI.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 2:16"
      },
      "items": [
        {
          "text": "Erisa n'abaddamu nti, \"Temutawaana, era temubatuma.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.16",
            "verseOrgIds": [
              "2KI.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye bwe baamuwaliriza, n'atendewalirwa, n'abagamba nti, \"Kale, mubatume.\" Awo ne batuma abasajja amakumi ataano, ne banoonya okumala ennaku ssatu naye ne batamulaba.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.17",
            "verseOrgIds": [
              "2KI.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe bakomawo gy'ali mu Yeriko, n'abagamba nti, \"Saabalabudde obutagenda?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.18",
            "verseOrgIds": [
              "2KI.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okutukuzibwa kwa Mazzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo abasajja ab'omu kibuga ne bagenda eri Erisa ne bamugamba nti, \"Mukama waffe, ekibuga kino kiri mu kifo kirungi, nga nawe bw'olaba, naye amazzi gaamu mabi, era n'ensi si njimu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.19",
            "verseOrgIds": [
              "2KI.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'abagamba nti, \"Mundeetere ebbakuli empya nga mutaddemu omunnyo.\" Ne bagimuleetera.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.20",
            "verseOrgIds": [
              "2KI.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'aserengeta ku nsulo ey'amazzi, n'ayiwamu omunnyo, n'ayogera nti, \"Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.21",
            "verseOrgIds": [
              "2KI.2.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.21",
                "verseOrgIds": [
                  "2KI.2.21"
                ]
              }
            }
          ]
        },
        {
          "text": "nti, 'Nnoongosezza amazzi gano era tegakyaddamu kuleeta kufa wadde okufuula ensi obutaba njimu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.21",
            "verseOrgIds": [
              "2KI.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazzi ne galongooka, ng'ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.22",
            "verseOrgIds": [
              "2KI.2.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.22",
                "verseOrgIds": [
                  "2KI.2.22"
                ]
              }
            }
          ]
        },
        {
          "text": "kye yayogerera mu Erisa bwe kyali, n'okutuusa ku lunaku lwa leero.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.22",
            "verseOrgIds": [
              "2KI.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abavubuka basekerera Erisa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erisa bwe yava eyo n'akwata ekkubo erigenda e Beseri. Naye ng'ali mu kkubo, n'asisinkana abavubuka ab'omu kibuga ekyo ne bamusekerera nga bwe boogera nti, \"Mulabe ow'ekiwalaata! Mulabe ow'ekiwalaata!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.23",
            "verseOrgIds": [
              "2KI.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'akyuka n'abatunuulira, n'abakolimira mu linnya lya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.24",
            "verseOrgIds": [
              "2KI.2.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.24",
                "verseOrgIds": [
                  "2KI.2.24"
                ]
              }
            }
          ]
        },
        {
          "text": ". Awo ebisolo ebinene bibiri eby'ekika eky'eddubu ne biva mu kibira ne bitaagulataagula abavubuka amakumi ana mu babiri ku bo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.24",
            "verseOrgIds": [
              "2KI.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yeeyongerayo n'alaga ku Lusozi Kalumeeri, oluvannyuma n'addayo e Samaliya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.25",
            "verseOrgIds": [
              "2KI.2.25"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.25",
            "verseOrgIds": [
              "2KI.2.25"
            ]
          }
        }
      ]
    }
  ],
