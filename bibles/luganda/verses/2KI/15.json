          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu biro ebyo",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.37",
            "verseOrgIds": [
              "2KI.15.37"
            ]
          }
        },
        {
          "name": "char",
