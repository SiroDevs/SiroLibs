          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka ogwokubiri ogw'obufuzi bwa Peka mutabani wa Lemaliya, Yosamu mutabani wa Uzziya n'alya obwakabaka bwa Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.32",
            "verseOrgIds": [
              "2KI.15.32"
            ]
          }
        },
        {
          "name": "verse",
