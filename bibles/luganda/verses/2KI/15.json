                "verseId": "2KI.15.34",
                "verseOrgIds": [
                  "2KI.15.34"
                ]
              }
            }
          ]
        },
        {
          "text": ", nga kitaawe Uzziya bwe yakola.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.34",
            "verseOrgIds": [
              "2KI.15.34"
            ]
          }
        },
        {
          "name": "verse",
