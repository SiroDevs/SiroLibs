          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.15.37",
                "verseOrgIds": [
                  "2KI.15.37"
                ]
              }
            }
          ]
        },
        {
          "text": "n'atandika okusindikira Yuda abalabe nga Lezini kabaka w'e Busuuli ne Peka mutabani wa Lemaliya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.37",
            "verseOrgIds": [
              "2KI.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2KI 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosamu n'afa, n'aziikibwa ku biggya bya bajjajjaabe mu kibuga kya Dawudi jjajjaawe, Akazi mutabani we n'amusikira okuba kabaka.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.38",
