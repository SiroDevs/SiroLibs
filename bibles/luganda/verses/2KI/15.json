          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yali wa myaka amakumi abiri mu etaano we yatandikira okufuga, era n'afugira emyaka kkumi na mukaaga mu Yerusaalemi, ne nnyina erinnya lye nga ye Yerusa muwala wa Zadooki.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.33",
            "verseOrgIds": [
              "2KI.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
