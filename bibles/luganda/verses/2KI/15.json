          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ebifo ebigulumivu tebyaggibwawo, era abantu ne beeyongeranga okuweerangayo ssaddaaka n'okwoterezangako obubaane. Yaddaabiriza n'Omulyango ogw'ekyengulu ogwa yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.35",
            "verseOrgIds": [
              "2KI.15.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
