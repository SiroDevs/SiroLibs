  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "2KI 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Endagaano Eragaanibwa buggya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo kabaka n'ayita abakadde bonna aba Yuda n'ab'omu Yerusaalemi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.1",
            "verseOrgIds": [
              "2KI.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ayambuka mu yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.2",
            "verseOrgIds": [
              "2KI.23.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.2",
                "verseOrgIds": [
                  "2KI.23.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ne bakabona, ne bannabbi, n'abantu bonna okuva ku wa wansi okutuukira ddala ku wa waggulu mu bitiibwa byabwe. N'asoma ebigambo eby'omu Kitabo eky'Endagaano ekyali kizuuliddwa mu yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.2",
            "verseOrgIds": [
              "2KI.23.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.2",
                "verseOrgIds": [
                  "2KI.23.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", nga bonna bawulira.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.2",
            "verseOrgIds": [
              "2KI.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo kabaka n'ayimirira okuliraana empagi n'azza obuggya endagaano ne",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.3",
            "verseOrgIds": [
              "2KI.23.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.3",
                "verseOrgIds": [
                  "2KI.23.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", okutambuliranga mu kkubo lya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.3",
            "verseOrgIds": [
              "2KI.23.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.3",
                "verseOrgIds": [
                  "2KI.23.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", n'okukwatanga amateeka ge, n'okutambuliranga mu mpya ze, n'okugonderanga ebiragiro bye, n'omutima gwe gwonna, n'emmeeme ye yonna, ng'akakasa ebyawandiikibwa ebyali mu kitabo ekyo. Awo abantu bonna ne beewaayo okuzza endagaano obuggya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.3",
            "verseOrgIds": [
              "2KI.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo kabaka n'alagira Kirukiya kabona asinga obukulu ne bakabona abaamuddiriranga, wamu n'abaggazi okuggya mu yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.4",
            "verseOrgIds": [
              "2KI.23.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.4",
                "verseOrgIds": [
                  "2KI.23.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ebintu byonna ebya Baali n'ebya Asera, n'eby'eggye lyonna ery'omu ggulu, n'abyokera ebweru wa Yerusaalemi mu ttale eriri mu kiwonvu kya Kiduloni, evvu n'alitwala e Beseri",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.4",
            "verseOrgIds": [
              "2KI.23.4"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.4",
            "verseOrgIds": [
              "2KI.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'agoba bakabona abaasinzanga ebifaananyi abaali balondeddwa bassekabaka ba Yuda okwoterezanga obubaane mu bifo ebigulumivu mu bibuga ebya Yuda n'okwetooloola Yerusaalemi, n'abo abayoterezanga obubaane eri Baali n'enjuba n'omwezi, n'eri emunyeenye n'eri eggye lyonna ery'omu ggulu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.5",
            "verseOrgIds": [
              "2KI.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'aggya empagi ya Asera",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.6",
            "verseOrgIds": [
              "2KI.23.6"
            ]
          }
        },
        {
          "text": "mu yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.6",
            "verseOrgIds": [
              "2KI.23.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.6",
                "verseOrgIds": [
                  "2KI.23.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", n'agitwala ebweru wa Yerusaalemi mu kiwonvu ekya Kiduloni, n'agyokera eyo. N'agisekulasekula n'asaasaanya evvu lyayo ku malaalo ag'abantu abaabulijjo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.6",
            "verseOrgIds": [
              "2KI.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate era yamenyaamenya n'ennyumba ez'abaalyanga ebisiyaga ezaali mu yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.7",
            "verseOrgIds": [
              "2KI.23.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.7",
                "verseOrgIds": [
                  "2KI.23.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", era eyo abakazi gye baalukiriranga Asera ebitimbibwa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.7",
            "verseOrgIds": [
              "2KI.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yosiya n'aleeta bakabona bonna okuva mu bibuga bya Yuda, n'ayonoona ebifo ebigulumivu okuva e Geba okutuuka e Beeruseba, bakabona gye baayoterezanga obubaane, era n'amenyaamenya amasabo agaali okumpi ne wankaaki ow'oku Mulyango gwa Yoswa, omukulembeze ow'ekibuga, agaali ku luuyi olwa kkono olwa wankaaki ow'ekibuga.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.8",
            "verseOrgIds": [
              "2KI.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Newaakubadde nga bakabona bali ab'oku bifo ebigulumivu tebaweerezanga ku kyoto kya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.9",
            "verseOrgIds": [
              "2KI.23.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.9",
                "verseOrgIds": [
                  "2KI.23.9"
                ]
              }
            }
          ]
        },
        {
          "text": "mu Yerusaalemi, balyanga emigaati egitali mizimbulukuse wamu ne bakabona bannaabwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.9",
            "verseOrgIds": [
              "2KI.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yavvoola era n'amenyaamenya ekyoto kya Tofesi ekyali mu Kiwonvu ky'abaana ba Kinomu, obutaganya muntu yenna kuwaayo mwana we owoobulenzi newaakubadde owoobuwala ng'ekiweebwayo eri Moleki.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.10",
            "verseOrgIds": [
              "2KI.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era yaggyawo n'embalaasi ezaali mu mulyango gwa yeekaalu, bassekabaka ba Yuda ze baali bawonze eri enjuba, era n'ayokya amagaali ze gaasikanga. Zaabeeranga mu luggya okuliraana n'ekisenge ekyali eky'omukungu Nasanumereki.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.11",
            "verseOrgIds": [
              "2KI.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamenyaamenya n'ebyoto bassekabaka ba Yuda bye baali bazimbye ku kasolya okumpi n'ekisenge ekya waggulu ekya Akazi, era n'ebyoto Manase bye yali azimbye mu mpya zombi eza yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.12",
            "verseOrgIds": [
              "2KI.23.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.12",
                "verseOrgIds": [
                  "2KI.23.12"
                ]
              }
            }
          ]
        },
        {
          "text": ". Byonna yabiggyayo, n'abimenyaamenya, enfuufu yaabyo n'agiyiwa mu kiwonvu ekya Kiduloni.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.12",
            "verseOrgIds": [
              "2KI.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era kabaka n'ayonoona n'ebifo ebigulumivu ebyali ebuvanjuba w'e Yerusaalemi ku luuyi olwa bukiikaddyo ku lusozi olw'okuzikirira, ebyo Sulemaani kabaka wa Isirayiri bye yazimbira bakatonda ab'omuzizo: Asutoleesi katonda omukazi ow'Abasidoni, ne Kemosi ow'Abamowaabu, ne Mirukomu ow'Abamoni.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.13",
            "verseOrgIds": [
              "2KI.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'amenyaamenya empagi, n'atemaatema empagi za Asera era ebifo ebyo n'abijjuza amagumba g'abantu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.14",
            "verseOrgIds": [
              "2KI.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amasabo n'Ebyoto Bimenyebwamenyebwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era n'ekyoto ekyali e Beseri, n'ekifo ekigulumivu ekyaleetera Isirayiri okwonoona, Yerobowaamu mutabani wa Nebati bye yali azimbye, byonna Yosiya n'abimenyaamenya. N'ayokya era n'asekulasekula ekifo ekigulumivu okutuusa lwe kyafuuka enfuufu era n'ayokya n'empagi eya Asera.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.15",
            "verseOrgIds": [
              "2KI.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yosiya bwe yatunulatunula, n'alaba amalaalo agaali ku lusozi, n'agenda n'aggyamu amagumba g'abafu n'agokera ku kyoto n'akyonoona, ng'ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.16",
            "verseOrgIds": [
              "2KI.23.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.16",
                "verseOrgIds": [
                  "2KI.23.16"
                ]
              }
            }
          ]
        },
        {
          "text": "bwe kyali omusajja wa Katonda kye yalangirira.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.16",
            "verseOrgIds": [
              "2KI.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo kabaka n'abuuza nti, \"Kijjukizo ki ekyo kye ndaba?\" Abasajja ab'ekibuga ne bamuddamu nti, \"Ago ge malaalo ag'omusajja wa Katonda eyava mu Yuda n'alangirira ebigambo ebikwata ku kyoto eky'e Beseri, by'okikoze.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.17",
            "verseOrgIds": [
              "2KI.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'abagamba nti, \"Mugaleke, era temuganya muntu yenna kukwata ku magumba ge.\" Awo ne batakwata ku magumba ge, wadde aga nnabbi ow'e Samaliya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.18",
            "verseOrgIds": [
              "2KI.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'amasabo gonna agaali mu bifo ebigulumivu bassekabaka ba Yuda bye baali bazimbye mu bibuga bya Samaliya ne baleetera obusungu bwa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.19",
            "verseOrgIds": [
              "2KI.23.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.19",
                "verseOrgIds": [
                  "2KI.23.19"
                ]
              }
            }
          ]
        },
        {
          "text": "okubuubuuka, Yosiya n'agavvoola era n'agaggyawo nga bwe yakola e Beseri.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.19",
            "verseOrgIds": [
              "2KI.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosiya n'atta bakabona bonna abaaweerezanga mu bifo ebigulumivu ku byoto byayo, era amagumba gaabwe n'agokera okwo, n'oluvannyuma n'addayo e Yerusaalemi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.20",
            "verseOrgIds": [
              "2KI.23.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okukuuma Embaga ey'Okuyitako",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo kabaka n'alagira abantu bonna ng'agamba nti, \"Mukwate Okuyitako kwa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.21",
            "verseOrgIds": [
              "2KI.23.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.21",
                "verseOrgIds": [
                  "2KI.23.21"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wammwe ng'ekyawandiikibwa bwe kiri mu Kitabo eky'endagaano.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.21",
            "verseOrgIds": [
              "2KI.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okuviira ddala ku mirembe gy'abalamuzi, ne ku mirembe gya bassekabaka ba Isirayiri n'aba Yuda, tewaaliwo kukwata Mbaga ey'Okuyitako.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.22",
            "verseOrgIds": [
              "2KI.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye mu mwaka ogw'ekkumi n'omunaana ogw'obufuzi bwa kabaka Yosiya, Embaga eyo n'ebaawo mu Yerusaalemi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.23",
            "verseOrgIds": [
              "2KI.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate era n'abafumu, n'aboogeza emizimu, n'ebifaananyi, n'eby'emizizo byonna ebyali mu Yuda ne mu Yerusaalemi, Yosiya, n'abiwera. Ekyo yakikola okutuukiriza ebigambo eby'etteeka eryali mu kitabo Kirukiya kabona kye yazuula mu Yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.24",
            "verseOrgIds": [
              "2KI.23.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.24",
                "verseOrgIds": [
                  "2KI.23.24"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.24",
            "verseOrgIds": [
              "2KI.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era tewali kabaka eyasooka Yosiya wadde eyamuddirira eyamufaanana era eyakyukira",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.25",
            "verseOrgIds": [
              "2KI.23.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.25",
                "verseOrgIds": [
                  "2KI.23.25"
                ]
              }
            }
          ]
        },
        {
          "text": "n'omutima gwe gwonna, n'emmeeme ye yonna era n'amaanyi ge gonna, ng'agoberera Amateeka ga Musa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.25",
            "verseOrgIds": [
              "2KI.23.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
