  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "HAB 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obulamu eri Abatuukirivu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HAB 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale ndiyimirira mu kifo kyange we ntera okubeera",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.1",
            "verseOrgIds": [
              "HAB.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:1"
      },
      "items": [
        {
          "text": "ntunule nga ndi waggulu eyo ku ggulumu",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.1",
            "verseOrgIds": [
              "HAB.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:1"
      },
      "items": [
        {
          "text": "nnindirire ky'aliŋŋamba,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.1",
            "verseOrgIds": [
              "HAB.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:1"
      },
      "items": [
        {
          "text": "era ne kye ndimuddamu ekikwata ku kwemulugunya kw'abantu.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.1",
            "verseOrgIds": [
              "HAB.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HAB 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.2",
            "verseOrgIds": [
              "HAB.2.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "HAB.2.2",
                "verseOrgIds": [
                  "HAB.2.2"
                ]
              }
            }
          ]
        },
        {
          "text": "n'anziramu n'ayogera nti,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.2",
            "verseOrgIds": [
              "HAB.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:2"
      },
      "items": [
        {
          "text": "\"Wandiika okwolesebwa okwo ku bipande.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.2",
            "verseOrgIds": [
              "HAB.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:2"
      },
      "items": [
        {
          "text": "Kuwandiike bulungi",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.2",
            "verseOrgIds": [
              "HAB.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:2"
      },
      "items": [
        {
          "text": "ate omubaka gwe banaatuma, akutwale bunnambiro.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.2",
            "verseOrgIds": [
              "HAB.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HAB 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga okwolesebwa okwo kujja mu kiseera kyakwo ekigere.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.3",
            "verseOrgIds": [
              "HAB.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:3"
      },
      "items": [
        {
          "text": "Kwogera ku by'enkomerero",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.3",
            "verseOrgIds": [
              "HAB.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:3"
      },
      "items": [
        {
          "text": "ate si kwa bulimba.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.3",
            "verseOrgIds": [
              "HAB.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:3"
      },
      "items": [
        {
          "text": "Bwe kunaaba ng'okuluddewo, mukulindirire,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.3",
            "verseOrgIds": [
              "HAB.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:3"
      },
      "items": [
        {
          "text": "kujja kutuukirira, tekugya kulwa.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.3",
            "verseOrgIds": [
              "HAB.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HAB 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Laba oyo ow'emmeeme eteri nnongoofu wa kugwa,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.4",
            "verseOrgIds": [
              "HAB.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:4"
      },
      "items": [
        {
          "text": "naye omutuukirivu aliba mulamu olw'obwesigwa bwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.4",
            "verseOrgIds": [
              "HAB.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akabi eri Aboonoonyi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HAB 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weewaawo, omwenge mulimba",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.5",
            "verseOrgIds": [
              "HAB.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:5"
      },
      "items": [
        {
          "text": "guleetera omuntu amalala, ate taguwummulako.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.5",
            "verseOrgIds": [
              "HAB.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:5"
      },
      "items": [
        {
          "text": "Ate olwokubanga gwa mululu ng'emagombe, mu butakkuta gufaanana okufa.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.5",
            "verseOrgIds": [
              "HAB.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:5"
      },
      "items": [
        {
          "text": "Era okufaanana ng'olumbe, tegukkuta,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.5",
            "verseOrgIds": [
              "HAB.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:5"
      },
      "items": [
        {
          "text": "amawanga gonna gugeekuŋŋanyizaako",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.5",
            "verseOrgIds": [
              "HAB.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:5"
      },
      "items": [
        {
          "text": "ne gugafuula abasibe.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.5",
            "verseOrgIds": [
              "HAB.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HAB 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bano bonna si be balimugererako engero bamusekerere nga bagamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.6",
            "verseOrgIds": [
              "HAB.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:6"
      },
      "items": [
        {
          "text": "\" 'Zimusanze oyo eyeyongeza ebitali bibye!",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.6",
            "verseOrgIds": [
              "HAB.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:6"
      },
      "items": [
        {
          "text": "Oyo eyeetuumako obugagga obuva mu nguzi!'",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.6",
            "verseOrgIds": [
              "HAB.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HAB 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakubanja tebalikuyimukirako nga tomanyiridde,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.7",
            "verseOrgIds": [
              "HAB.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:7"
      },
      "items": [
        {
          "text": "era tebalizuukuka ne bakweraliikiriza?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.7",
            "verseOrgIds": [
              "HAB.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:7"
      },
      "items": [
        {
          "text": "Oliba togudde mu mikono gyabwe?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.7",
            "verseOrgIds": [
              "HAB.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HAB 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga onyaze amawanga mangi,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.8",
            "verseOrgIds": [
              "HAB.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:8"
      },
      "items": [
        {
          "text": "abantu abasigaddewo balikunyaga;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.8",
            "verseOrgIds": [
              "HAB.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:8"
      },
      "items": [
        {
          "text": "Oyiye omusaayi gw'abantu,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.8",
            "verseOrgIds": [
              "HAB.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:8"
      },
      "items": [
        {
          "text": "n'oyonoona ensi n'ebibuga n'abantu bonna ababibeeramu.\"",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.8",
            "verseOrgIds": [
              "HAB.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HAB 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zimusanze oyo azimbira amaka ge ku bikolwa ebibi,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.9",
            "verseOrgIds": [
              "HAB.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:9"
      },
      "items": [
        {
          "text": "azimba ekisu kye waggulu,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.9",
            "verseOrgIds": [
              "HAB.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:9"
      },
      "items": [
        {
          "text": "okwekuuma obutatuukwako kabi!",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.9",
            "verseOrgIds": [
              "HAB.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HAB 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wategeka okuzikirira kw'abantu bangi,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.10",
            "verseOrgIds": [
              "HAB.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:10"
      },
      "items": [
        {
          "text": "n'oswaza ennyumba yo ne weefiiriza obulamu bwo.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.10",
            "verseOrgIds": [
              "HAB.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HAB 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amayinja g'oku bbugwe galikaaba,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.11",
            "verseOrgIds": [
              "HAB.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:11"
      },
      "items": [
        {
          "text": "n'emikiikiro gy'ebibajje girikyasanguza.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.11",
            "verseOrgIds": [
              "HAB.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
