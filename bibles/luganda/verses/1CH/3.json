  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "1CH 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Ennyumba ya Dawudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano be baana Dawudi be yazaalira mu Kebbulooni:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1CH 3:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 3:1"
      },
      "items": [
        {
          "text": "Omuggulanda ye yali Amunoni gwe yazaala mu Akinoamu Omuyezuleeri;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.1",
            "verseOrgIds": [
              "1CH.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 3:1"
      },
      "items": [
        {
          "text": "owookubiri ye yali Danyeri gwe yazaala mu Abbigayiri Omukalumeeri;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.1",
            "verseOrgIds": [
              "1CH.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "owookusatu ye yali Abusaalomu gwe yazaala mu Maaka muwala wa Talumaayi kabaka w'e Gesuli;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.2",
            "verseOrgIds": [
              "1CH.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 3:2"
      },
      "items": [
        {
          "text": "n'owookuna ye yali Adoniya gwe yazaala mu Kaggisi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.2",
            "verseOrgIds": [
              "1CH.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owookutaano ye yali Sefatiya, gwe yazaala mu Abitali",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.3",
            "verseOrgIds": [
              "1CH.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 3:3"
      },
      "items": [
        {
          "text": "n'ow'omukaaga nga ye Isuleyamu gwe yazaala mu Egula.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.3",
            "verseOrgIds": [
              "1CH.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano omukaaga Dawudi be yazaalira mu Kebbulooni, gye yafugira emyaka musanvu n'emyezi mukaaga.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1CH 3:4"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1CH 3:4"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "1CH 3:4"
      },
      "items": [
        {
          "text": "Dawudi yafugira mu Yerusaalemi emyaka amakumi asatu mu esatu,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "era bano be baana be yazaalira eyo:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1CH 3:5"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 3:5"
      },
      "items": [
        {
          "text": "Simeeyi, ne Sobabu, ne Nasani, ne Sulemaani be yazaala mu Besusebba muwala wa Amiyeeri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.5",
            "verseOrgIds": [
              "1CH.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'abalala baali Ibukali, ne Erisaama, ne Erifereti,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.6",
            "verseOrgIds": [
              "1CH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Noga, ne Nefegi, ne Yafiya,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.7",
            "verseOrgIds": [
              "1CH.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Erisaama, ne Eriyada, ne Erifereti, bonna awamu mwenda.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.8",
            "verseOrgIds": [
              "1CH.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano bonna be baali batabani ba Dawudi, obutabala batabani be abalala aba bazaana be. Tamali ye yali mwannyinaabwe.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Olulyo lwa Sulemaani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutabani wa Sulemaani yali Lekobowaamu,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.10",
            "verseOrgIds": [
              "1CH.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 3:10"
      },
      "items": [
        {
          "text": "ne Abiya nga ye mutabani wa Lekobowaamu,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.10",
            "verseOrgIds": [
              "1CH.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 3:10"
      },
      "items": [
        {
          "text": "ne Asa nga ye mutabani wa Abiya,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.10",
            "verseOrgIds": [
              "1CH.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 3:10"
      },
      "items": [
        {
          "text": "ne Yekosafaati nga ye mutabani wa Asa,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.10",
            "verseOrgIds": [
              "1CH.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
