        {
          "text": "ne Yolaamu nga ye mutabani wa Yekosafaati,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.11",
            "verseOrgIds": [
              "1CH.3.11"
            ]
          }
        }
