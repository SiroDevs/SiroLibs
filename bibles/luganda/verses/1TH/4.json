  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "1TH 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obulamu Obusanyusa Katonda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TH 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo abooluganda, ekisembayo, tubeegayirira nga tubazzaamu amaanyi mu Mukama waffe Yesu, nti nga bwe twababuulirira bwe kibagwanira okutambula n'okusanyusa Katonda, era nga bwe mukola bwe mutyo, mugende mu maaso okukolanga bwe mutyo n'okusingawo.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.1",
            "verseOrgIds": [
              "1TH.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TH 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga mumanyi ebiragiro bye twabawa mu Mukama waffe Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.2",
            "verseOrgIds": [
              "1TH.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TH 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga Katonda ayagala mutukuzibwe, era mwewalenga obwenzi,",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.3",
            "verseOrgIds": [
              "1TH.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TH 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "buli omu ku mmwe amanyenga okufuga omubiri gwe mu butukuvu n'ekitiibwa,",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.4",
            "verseOrgIds": [
              "1TH.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "so si mu kwegomba okw'obukaba ng'abamawanga abatamanyi Katonda bwe bakola.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.5",
            "verseOrgIds": [
              "1TH.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu nsonga eyo walemenga okubaawo ayingirira muganda we, newaakubadde amusobyako, kubanga Mukama yawoolera eggwanga mu nsonga zino. Ebintu bino byonna twabibagamba dda era ne tubawa n'obujulirwa.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.6",
            "verseOrgIds": [
              "1TH.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga Katonda teyatuyitira bugwenyufu wabula yatuyitira kutukuzibwa.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.7",
            "verseOrgIds": [
              "1TH.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo anyooma bino aba tanyoomye muntu wabula Katonda, atuwa Omwoyo we Omutukuvu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.8",
            "verseOrgIds": [
              "1TH.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TH 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaakano ku bikwata ku kwagalana kw'abooluganda sseetaaga kubibawandiikirako, kubanga mmwe mwennyini mwayigirizibwa Katonda okwagalananga.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.9",
            "verseOrgIds": [
              "1TH.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga ddala bwe mutyo bwe mwagala abooluganda bonna ab'omu Makedoniya, naye era abooluganda, tubakuutira mweyongere okubaagalanga.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.10",
            "verseOrgIds": [
              "1TH.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TH 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubeerenga bakkakkamu, nga temweyingiza mu by'abalala, era mukolenga emirimu gyammwe nga bwe twabakuutira,",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.11",
            "verseOrgIds": [
              "1TH.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TH 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "mutambule nga mwegendereza eri abatakkiriza, mube nga mwemalirira mu buli nsonga.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.12",
            "verseOrgIds": [
              "1TH.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okujja kwa Mukama waffe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TH 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaakano, abooluganda tetwagala mmwe obutategeera eby'abo abafu, ne munakuwala ng'abalala abatalina ssuubi.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.13",
            "verseOrgIds": [
              "1TH.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TH 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga bwe tukkiriza nti Yesu yafa era n'azuukira mu bafu bwe tutyo tukkiriza nti Katonda alikomyawo wamu naye abo abaafira mu Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.14",
            "verseOrgIds": [
              "1TH.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TH 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga ekyo kye tubategeeza mu kigambo kya Mukama waffe, nga ffe abalamu, abaasigalawo okutuusa okujja kwa Mukama waffe tetulisooka abaafa.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.15",
            "verseOrgIds": [
              "1TH.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TH 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga Mukama waffe yennyini alikka okuva mu ggulu n'eddoboozi ery'omwanguka, eddoboozi lya malayika omukulu nga liwulirwa, n'ekkondeere lya Katonda, n'abo abaafiira mu Kristo be balisooka okuzuukira,",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.16",
            "verseOrgIds": [
              "1TH.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TH 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "naffe abalamu abaasigalawo ne tulyoka tubeegattako, ne tusitulibwa mu bire okusisinkana Mukama waffe mu bbanga; bwe tutyo tunaabeeranga ne Mukama waffe ennaku zonna.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.17",
            "verseOrgIds": [
              "1TH.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale buli omu agumyenga munne n'ebigambo ebyo.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.18",
            "verseOrgIds": [
              "1TH.4.18"
            ]
          }
        }
      ]
    }
  ],
