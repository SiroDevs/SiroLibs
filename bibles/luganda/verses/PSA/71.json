          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu ggwe, Ayi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.1",
            "verseOrgIds": [
              "PSA.71.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.71.1",
                "verseOrgIds": [
                  "PSA.71.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", mwe neekweka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.1",
            "verseOrgIds": [
              "PSA.71.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:1"
      },
      "items": [
        {
          "text": "tondeka kuswazibwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.1",
            "verseOrgIds": [
              "PSA.71.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 71:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu butuukirivu bwo ondokole, omponye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.2",
            "verseOrgIds": [
              "PSA.71.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:2"
      },
      "items": [
        {
          "text": "ontegere okutu ondokole.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.2",
            "verseOrgIds": [
              "PSA.71.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 71:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onfuukire olwazi obuddukiro bwange,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.3",
            "verseOrgIds": [
              "PSA.71.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:3"
      },
      "items": [
        {
          "text": "ekifo eky'amaanyi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.3",
            "verseOrgIds": [
              "PSA.71.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 71:3"
      },
      "items": [
        {
          "text": "ondokole",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.3",
            "verseOrgIds": [
              "PSA.71.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:3"
      },
      "items": [
        {
          "text": "kubanga oli lwazi lwange era ekiddukiro kyange.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.3",
            "verseOrgIds": [
              "PSA.71.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 71:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi Katonda wange omponye mu mukono gw'ababi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.4",
            "verseOrgIds": [
              "PSA.71.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:4"
      },
      "items": [
        {
          "text": "omponye abantu abatali batuukirivu era abakambwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.4",
            "verseOrgIds": [
              "PSA.71.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 71:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga ggwe, Ayi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.5",
            "verseOrgIds": [
              "PSA.71.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.71.5",
                "verseOrgIds": [
                  "PSA.71.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", ggwe ssuubi lyange;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.5",
            "verseOrgIds": [
              "PSA.71.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:5"
      },
      "items": [
        {
          "text": "ggwe, ggwe neesiga, okuviira ddala mu buvubuka bwange.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.5",
            "verseOrgIds": [
              "PSA.71.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 71:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neesiga ggwe kasookedde nzalibwa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.6",
            "verseOrgIds": [
              "PSA.71.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:6"
      },
      "items": [
        {
          "text": "ggwe wanziggya mu lubuto lwa mmange.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.6",
            "verseOrgIds": [
              "PSA.71.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:6"
      },
      "items": [
        {
          "text": "Nnaakutenderezanga ennaku zonna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.6",
            "verseOrgIds": [
              "PSA.71.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 71:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri abangi nafuuka;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.7",
            "verseOrgIds": [
              "PSA.71.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:7"
      },
      "items": [
        {
          "text": "naye ggwe kiddukiro kyange eky'amaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.7",
            "verseOrgIds": [
              "PSA.71.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 71:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamwa kange kajjudde ettendo lyo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.8",
            "verseOrgIds": [
              "PSA.71.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:8"
      },
      "items": [
        {
          "text": "nga ntenda ekitiibwa kyo obudde okuziba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.8",
            "verseOrgIds": [
              "PSA.71.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 71:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tonsuula mu kiseera kyange eky'obukadde.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.9",
            "verseOrgIds": [
              "PSA.71.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:9"
      },
      "items": [
        {
          "text": "Tondekerera ng'amaanyi gampweddemu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.9",
            "verseOrgIds": [
              "PSA.71.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 71:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga abalabe bange banjogerako;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.10",
            "verseOrgIds": [
              "PSA.71.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:10"
      },
      "items": [
        {
          "text": "abo abaagala okunzita bansalira olukwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.10",
            "verseOrgIds": [
              "PSA.71.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 71:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagamba nti, \"Katonda amulese,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.11",
            "verseOrgIds": [
              "PSA.71.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:11"
      },
      "items": [
        {
          "text": "ka tumugobe tumukwate,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.11",
            "verseOrgIds": [
              "PSA.71.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:11"
      },
      "items": [
        {
          "text": "kubanga taliiko anaamuwonya.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.11",
            "verseOrgIds": [
              "PSA.71.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 71:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi Katonda, tombera wala, Ayi Katonda wange,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.12",
            "verseOrgIds": [
              "PSA.71.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:12"
      },
      "items": [
        {
          "text": "yanguwa ojje ombeere.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.12",
            "verseOrgIds": [
              "PSA.71.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 71:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo abampawaabira bazikirizibwe nga bajjudde ensonyi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.13",
            "verseOrgIds": [
              "PSA.71.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:13"
      },
      "items": [
        {
          "text": "abanoonya okunnumya baswale",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.13",
            "verseOrgIds": [
              "PSA.71.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:13"
      },
      "items": [
        {
          "text": "era banyoomebwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.13",
            "verseOrgIds": [
              "PSA.71.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 71:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nze nnaabanga n'essuubi ennaku zonna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.14",
            "verseOrgIds": [
              "PSA.71.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:14"
      },
      "items": [
        {
          "text": "Era nneeyongeranga okukutenderezanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.14",
            "verseOrgIds": [
              "PSA.71.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 71:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamwa kange kanaayogeranga ku bikolwa byo eby'obutuukirivu obudde okuziba;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.15",
            "verseOrgIds": [
              "PSA.71.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:15"
      },
      "items": [
        {
          "text": "nnaayogeranga ku bulokozi bwo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.15",
            "verseOrgIds": [
              "PSA.71.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:15"
      },
      "items": [
        {
          "text": "wadde siyinza kubupima.",
