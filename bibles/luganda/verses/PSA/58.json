  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "58",
        "style": "c",
        "sid": "PSA 58"
      },
      "items": [
        {
          "text": "58",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zabbuli 58",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Ya Mukulu wa Bayimbi. Ku ddoboozi, \"Tozikiriza.\" Zabbuli ya Dawudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 58:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ddala mwogera eby'amazima oba musirika busirisi?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.1",
            "verseOrgIds": [
              "PSA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:1"
      },
      "items": [
        {
          "text": "Abaana b'abantu mubasalira emisango mu bwenkanya?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.1",
            "verseOrgIds": [
              "PSA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 58:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nedda, mutegeka ebitali bya bwenkanya mu mitima gyammwe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.2",
            "verseOrgIds": [
              "PSA.58.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:2"
      },
      "items": [
        {
          "text": "era bye mukola bireeta obwegugungo mu nsi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.2",
            "verseOrgIds": [
              "PSA.58.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 58:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakola ebibi bakyama nga baakazaalibwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.3",
            "verseOrgIds": [
              "PSA.58.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:3"
      },
      "items": [
        {
          "text": "bava mu lubuto nga balina ekibi, era bakula boogera bya bulimba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.3",
            "verseOrgIds": [
              "PSA.58.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 58:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balina obusagwa ng'obw'omusota;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.4",
            "verseOrgIds": [
              "PSA.58.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:4"
      },
      "items": [
        {
          "text": "bali ng'enswera etawulira ezibikira amatu gaayo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.4",
            "verseOrgIds": [
              "PSA.58.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 58:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'etawulira na luyimba lwa mukugu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.5",
            "verseOrgIds": [
              "PSA.58.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:5"
      },
      "items": [
        {
          "text": "agisendasenda okugikwata.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.5",
            "verseOrgIds": [
              "PSA.58.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 58:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi Katonda, menya amannyo gaabwe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.6",
            "verseOrgIds": [
              "PSA.58.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:6"
      },
      "items": [
        {
          "text": "owangulemu amannyo g'empologoma zino, Ayi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.6",
            "verseOrgIds": [
              "PSA.58.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.58.6",
                "verseOrgIds": [
                  "PSA.58.7"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.6",
            "verseOrgIds": [
              "PSA.58.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 58:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leka babule ng'amazzi agakulukuta ne gagenda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.7",
            "verseOrgIds": [
              "PSA.58.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:7"
      },
      "items": [
        {
          "text": "Bwe banaanuula omutego, leka obusaale bwabwe bwe balasa bufufuggale.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.7",
            "verseOrgIds": [
              "PSA.58.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 58:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babe ng'ekkovu erisaanuukira mu lugendo lwalyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.8",
            "verseOrgIds": [
              "PSA.58.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:8"
      },
      "items": [
        {
          "text": "Babe ng'omwana azaaliddwa ng'afudde, ataliraba ku njuba!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.8",
            "verseOrgIds": [
              "PSA.58.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 58:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga n'entamu tennabuguma,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.9",
            "verseOrgIds": [
              "PSA.58.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:9"
      },
      "items": [
        {
          "text": "alibayerawo n'obusungu obungi nga kibuyaga ow'amaanyi ennyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.9",
            "verseOrgIds": [
              "PSA.58.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 58:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omutuukirivu alisanyuka ng'alabye bamuwalanidde eggwanga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.10",
            "verseOrgIds": [
              "PSA.58.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:10"
      },
      "items": [
        {
          "text": "olwo n'ebigere bye ne bisaabaana omusaayi ogw'abakola ebibi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.10",
            "verseOrgIds": [
              "PSA.58.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 58:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo abantu bonna balyogera nti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.11",
            "verseOrgIds": [
              "PSA.58.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:11"
      },
      "items": [
        {
          "text": "\"Ddala, abatuukirivu balwanirirwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.11",
            "verseOrgIds": [
              "PSA.58.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 58:11"
      },
      "items": [
        {
          "text": "Ddala waliwo Katonda alamula mu bwenkanya ku nsi.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.58.11",
            "verseOrgIds": [
              "PSA.58.12"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.59",
