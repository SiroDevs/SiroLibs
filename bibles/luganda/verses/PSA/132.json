      "attrs": {
        "style": "q2",
        "vid": "PSA 132:2"
      },
      "items": [
        {
          "text": "ne yeeyama eri Katonda Ayinzabyonna, Katonda wa Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.2",
            "verseOrgIds": [
              "PSA.132.2"
            ]
