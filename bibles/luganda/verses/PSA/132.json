      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:4"
      },
      "items": [
        {
          "text": "newaakubadde okuzibiriza amaaso gange,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.4",
            "verseOrgIds": [
              "PSA.132.4"
            ]
          }
        }
      ]
