          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakabona baakyo, obulokozi bunaabanga kyambalo kyabwe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.16",
            "verseOrgIds": [
              "PSA.132.16"
            ]
          }
        }
