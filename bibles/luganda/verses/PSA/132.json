      "attrs": {
        "style": "q2",
        "vid": "PSA 132:15"
      },
      "items": [
        {
          "text": "era n'abaavu baamu nnaabakkusanga ebyokulya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.15",
            "verseOrgIds": [
              "PSA.132.15"
            ]
          }
        }
      ]
    },
    {
