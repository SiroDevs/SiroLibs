      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:14"
      },
      "items": [
        {
          "text": "omwo mwe nnaatuulanga nga ndi ku ntebe ey'obwakabaka kubanga nkisiimye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.14",
            "verseOrgIds": [
