      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:3"
      },
      "items": [
        {
          "text": "wadde okulinnya ku kitanda kyange.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.3",
            "verseOrgIds": [
              "PSA.132.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
