                "verseId": "PSA.132.8",
                "verseOrgIds": [
                  "PSA.132.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", ogende mu kifo kyo mw'owummulira;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.8",
            "verseOrgIds": [
              "PSA.132.8"
            ]
          }
