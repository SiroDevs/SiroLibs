      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:8"
      },
      "items": [
        {
          "text": "ggwe n'Essanduuko yo ey'Endagaano, eraga obuyinza bwo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.8",
            "verseOrgIds": [
              "PSA.132.8"
            ]
          }
        }
      ]
    },
