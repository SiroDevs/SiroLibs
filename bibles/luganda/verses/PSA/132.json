          ]
        },
        {
          "text": "\"Kino kye kifo mwe nnaawummuliranga emirembe gyonna;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.14",
            "verseOrgIds": [
              "PSA.132.14"
            ]
          }
        }
