      "attrs": {
        "style": "q2",
        "vid": "PSA 132:9"
      },
      "items": [
        {
          "text": "n'abatukuvu bo bayimbe n'essanyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.9",
            "verseOrgIds": [
              "PSA.132.9"
            ]
          }
        }
      ]
