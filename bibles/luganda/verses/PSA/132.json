          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nnaakiwanga omukisa ne nkiwa n'ebirungi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.15",
            "verseOrgIds": [
              "PSA.132.15"
            ]
