      "attrs": {
        "style": "q2",
        "vid": "PSA 132:16"
      },
      "items": [
        {
          "text": "n'abatukuvu baakyo banaayimbanga ennyimba ez'essanyu n'essanyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.16",
            "verseOrgIds": [
              "PSA.132.16"
            ]
          }
        }
