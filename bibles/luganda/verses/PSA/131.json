          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi Isirayiri, weesigenga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.3",
            "verseOrgIds": [
              "PSA.131.3"
            ]
          }
        },
