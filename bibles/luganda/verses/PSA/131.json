          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ŋŋonzezza emmeeme yange era ngisiriikirizza",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.2",
            "verseOrgIds": [
              "PSA.131.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 131:2"
      },
      "items": [
        {
          "text": "ng'omwana bw'asiriikirira nga nnyina amuggye ku mabeere.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.2",
            "verseOrgIds": [
              "PSA.131.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 131:2"
      },
      "items": [
        {
          "text": "Omwana avudde ku mabeere nga bw'asiriikirira, n'emmeeme yange bw'eri bw'etyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.2",
            "verseOrgIds": [
              "PSA.131.2"
            ]
          }
        }
      ]
    },
    {
