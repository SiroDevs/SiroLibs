      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 24:4"
      },
      "items": [
        {
          "text": "era atalayirira bwereere.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.4",
            "verseOrgIds": [
              "PSA.24.4"
            ]
          }
