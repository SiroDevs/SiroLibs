          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo alina omutima omulongoofu, nga n'emikono gye mirongoofu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.4",
            "verseOrgIds": [
              "PSA.24.4"
            ]
          }
        }
      ]
    },
