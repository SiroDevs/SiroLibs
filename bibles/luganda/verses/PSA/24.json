          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alyambuka ku lusozi lwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.3",
            "verseOrgIds": [
              "PSA.24.3"
            ]
          }
        },
