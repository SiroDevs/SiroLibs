              "attrs": {
                "verseId": "PSA.24.1",
                "verseOrgIds": [
                  "PSA.24.1"
                ]
              }
            }
          ]
        },
        {
          "text": "n'ebigirimu byonna,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.1",
            "verseOrgIds": [
              "PSA.24.1"
            ]
          }
        }
      ]
