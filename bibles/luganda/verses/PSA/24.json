      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 24:2"
      },
      "items": [
        {
          "text": "n'agizimba ku mazzi amangi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.2",
            "verseOrgIds": [
              "PSA.24.2"
            ]
          }
        }
      ]
    },
    {
