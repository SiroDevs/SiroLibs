            "sid": "PSA 70:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi Katonda oyanguwa okundokole.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.1",
            "verseOrgIds": [
              "PSA.70.2"
            ]
          }
        }
      ]
    },
    {
