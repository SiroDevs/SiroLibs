        "style": "d"
      },
      "items": [
        {
          "text": "Zabbuli ya Asafu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 82:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda akubiriza olukiiko lwe olukulu olw'omu ggulu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.1",
            "verseOrgIds": [
              "PSA.82.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:1"
      },
      "items": [
        {
          "text": "ng'alamula bakatonda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.1",
            "verseOrgIds": [
              "PSA.82.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 82:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulituusa ddi okusala emisango n'obukuusa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.2",
            "verseOrgIds": [
              "PSA.82.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:2"
      },
      "items": [
        {
          "text": "nga musalira abanafu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.2",
            "verseOrgIds": [
              "PSA.82.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 82:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanafu n'abatalina bakitaabwe mubalamulenga mu bwenkanya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.3",
            "verseOrgIds": [
              "PSA.82.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:3"
      },
      "items": [
        {
          "text": "abaavu n'abanyigirizibwa mubayambenga mu bwenkanya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.3",
            "verseOrgIds": [
              "PSA.82.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 82:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulwanirire abatalina maanyi n'abali mu kwetaaga, mubawonye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.4",
            "verseOrgIds": [
              "PSA.82.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:4"
      },
      "items": [
        {
          "text": "mubanunule nga mubaggya mu mikono gy'ababi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.4",
            "verseOrgIds": [
              "PSA.82.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 82:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tebalina kye bamanyi, era tebategeera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.5",
            "verseOrgIds": [
              "PSA.82.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:5"
      },
      "items": [
        {
          "text": "Batambulira mu kizikiza;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.5",
            "verseOrgIds": [
              "PSA.82.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:5"
      },
      "items": [
        {
          "text": "emisingi gy'ensi gyonna ginyeenyezebwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.5",
            "verseOrgIds": [
              "PSA.82.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 82:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njogedde nti, Muli bakatonda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.6",
            "verseOrgIds": [
              "PSA.82.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:6"
      },
      "items": [
        {
          "text": "era mwenna muli baana b'oyo Ali Waggulu Ennyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.6",
            "verseOrgIds": [
              "PSA.82.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 82:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naye mugenda kufa ng'abantu obuntu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.7",
            "verseOrgIds": [
              "PSA.82.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:7"
      },
      "items": [
        {
          "text": "muliggwaawo ng'abafuzi abalala bonna bwe baggwaawo.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.7",
            "verseOrgIds": [
              "PSA.82.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 82:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogolokoke, Ayi Katonda, olamule ensi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.8",
            "verseOrgIds": [
              "PSA.82.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:8"
      },
      "items": [
        {
          "text": "kubanga amawanga gonna gago.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.8",
            "verseOrgIds": [
              "PSA.82.8"
            ]
          }
        }
      ]
    }
