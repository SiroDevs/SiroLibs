      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 23:2"
      },
      "items": [
        {
          "text": "Antwala awali amazzi amateefu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.2",
            "verseOrgIds": [
              "PSA.23.2"
            ]
