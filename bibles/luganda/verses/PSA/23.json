          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Newaakubadde nga ntambulira mu kiwonvu eky'ekisiikirize eky'olumbe, siritya kabi konna;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.4",
            "verseOrgIds": [
              "PSA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 23:4"
      },
      "items": [
        {
          "text": "kubanga ggwe oli nange.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.4",
            "verseOrgIds": [
              "PSA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 23:4"
      },
      "items": [
