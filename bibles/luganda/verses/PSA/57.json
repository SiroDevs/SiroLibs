  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "57",
        "style": "c",
        "sid": "PSA 57"
      },
      "items": [
        {
          "text": "57",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zabbuli 57",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Ya Mukulu wa Bayimbi. Ku ddoboozi, \"Tozikiriza.\" Zabbuli ya Dawudi bwe yadduka Sawulo, n'alaga mu mpuku.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 57:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onsaasire, Ayi Katonda, onsaasire,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.1",
            "verseOrgIds": [
              "PSA.57.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:1"
      },
      "items": [
        {
          "text": "kubanga neesiga ggwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.1",
            "verseOrgIds": [
              "PSA.57.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 57:1"
      },
      "items": [
        {
          "text": "Nzija kwekweka mu kisiikirize ky'ebiwaawaatiro byo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.1",
            "verseOrgIds": [
              "PSA.57.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:1"
      },
      "items": [
        {
          "text": "okutuusa okuzikirira bwe kulikoma.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.1",
            "verseOrgIds": [
              "PSA.57.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 57:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkoowoola Katonda Ali Waggulu Ennyo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.2",
            "verseOrgIds": [
              "PSA.57.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:2"
      },
      "items": [
        {
          "text": "Katonda atuukiriza bye yantegekera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.2",
            "verseOrgIds": [
              "PSA.57.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 57:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alisinzira mu ggulu n'andokola,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.3",
            "verseOrgIds": [
              "PSA.57.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:3"
      },
      "items": [
        {
          "text": "n'amponya abo abampalana.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.3",
            "verseOrgIds": [
              "PSA.57.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:3"
      },
      "items": [
        {
          "text": "Katonda anandaganga obwesigwa bwe n'okwagala kwe okutaggwaawo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.3",
            "verseOrgIds": [
              "PSA.57.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 57:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeera wakati mu mpologoma,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.4",
            "verseOrgIds": [
              "PSA.57.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:4"
      },
      "items": [
        {
          "text": "nsula mu bisolo ebirya abaana b'abantu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.4",
            "verseOrgIds": [
              "PSA.57.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 57:4"
      },
      "items": [
        {
          "text": "Amannyo g'abalabe bange gali ng'amafumu n'obusaale.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.4",
            "verseOrgIds": [
              "PSA.57.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:4"
      },
      "items": [
        {
          "text": "Ennimi zaabwe ziri ng'ebitala ebyogi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.4",
            "verseOrgIds": [
              "PSA.57.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 57:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi Katonda, ogulumizibwenga okusinga eggulu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.5",
            "verseOrgIds": [
              "PSA.57.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:5"
      },
      "items": [
        {
          "text": "n'ekitiibwa kyo kibune ensi yonna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.5",
            "verseOrgIds": [
              "PSA.57.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 57:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baatega ekitimba mu kkubo lyange,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.6",
            "verseOrgIds": [
              "PSA.57.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:6"
      },
      "items": [
        {
          "text": "ne ntya nnyo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.6",
            "verseOrgIds": [
              "PSA.57.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 57:6"
      },
      "items": [
        {
          "text": "ne basimamu obunnya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.6",
            "verseOrgIds": [
              "PSA.57.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:6"
      },
      "items": [
        {
          "text": "ate bo bennyini ne babugwamu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.6",
            "verseOrgIds": [
              "PSA.57.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 57:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omutima gwange munywevu, Ayi Katonda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.7",
            "verseOrgIds": [
              "PSA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:7"
      },
      "items": [
        {
          "text": "omutima gwange munywevu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.7",
            "verseOrgIds": [
              "PSA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:7"
      },
      "items": [
        {
          "text": "Nnaakutenderezanga n'ennyimba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.7",
            "verseOrgIds": [
              "PSA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 57:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zuukuka, ggwe omwoyo gwange!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.8",
            "verseOrgIds": [
              "PSA.57.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:8"
      },
      "items": [
        {
          "text": "Zuukuka ggwe ennanga ey'enkoba, naawe entongooli,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.8",
            "verseOrgIds": [
              "PSA.57.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:8"
      },
      "items": [
        {
          "text": "ndyoke nnyimbe okukeesa obudde.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.8",
            "verseOrgIds": [
              "PSA.57.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 57:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi Mukama, ndikwebaza mu mawanga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.9",
            "verseOrgIds": [
              "PSA.57.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:9"
      },
      "items": [
        {
          "text": "ndiyimba nga nkutendereza mu bantu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.9",
            "verseOrgIds": [
              "PSA.57.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 57:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga okwagala kwo kungi nnyo, kutuuka ne ku ggulu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.10",
            "verseOrgIds": [
              "PSA.57.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:10"
      },
      "items": [
        {
          "text": "n'obwesigwa bwo butuuka ku bire.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.10",
            "verseOrgIds": [
              "PSA.57.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 57:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogulumizibwenga, Ayi Katonda, okusinga eggulu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.11",
            "verseOrgIds": [
              "PSA.57.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:11"
      },
      "items": [
        {
          "text": "n'ekitiibwa kyo kibune ensi yonna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.11",
            "verseOrgIds": [
              "PSA.57.12"
            ]
          }
        }
      ]
    }
  ],
