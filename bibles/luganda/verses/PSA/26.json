          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naaba mu ngalo zange okulaga nga bwe sirina misango;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.6",
            "verseOrgIds": [
              "PSA.26.6"
            ]
