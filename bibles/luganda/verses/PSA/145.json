      "attrs": {
        "style": "q2",
        "vid": "PSA 145:12"
      },
      "items": [
        {
          "text": "n'ekitiibwa ky'obukulu obw'obwakabaka bwo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.12",
            "verseOrgIds": [
              "PSA.145.12"
            ]
          }
        }
