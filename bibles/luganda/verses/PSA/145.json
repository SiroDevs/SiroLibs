          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banaayogeranga ku bulungi bwo obw'ekitalo nga bajaguza;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.7",
            "verseOrgIds": [
              "PSA.145.7"
            ]
          }
        }
      ]
    },
