      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:7"
      },
      "items": [
        {
          "text": "era banaayimbanga olw'obutuukirivu bwo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.7",
            "verseOrgIds": [
              "PSA.145.7"
            ]
          }
        }
      ]
    },
