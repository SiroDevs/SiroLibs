            "number": "3",
            "style": "v",
            "sid": "PSA 145:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.145.3",
                "verseOrgIds": [
                  "PSA.145.3"
                ]
              }
            }
          ]
        },
        {
          "text": "mukulu, wa kitiibwa, era asaanira okutenderezebwanga ennyo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.3",
            "verseOrgIds": [
              "PSA.145.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:3"
      },
      "items": [
        {
          "text": "n'obukulu bwe tebwogerekeka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.3",
            "verseOrgIds": [
              "PSA.145.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 145:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli mulembe gunaatenderanga gunnaagwo ebikolwa byo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.4",
            "verseOrgIds": [
              "PSA.145.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:4"
      },
      "items": [
        {
          "text": "era gunaatendanga emirimu gyo egy'amaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.4",
            "verseOrgIds": [
              "PSA.145.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 145:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nnaatendanga obukulu n'obulungi bw'ekitiibwa kyo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.5",
            "verseOrgIds": [
              "PSA.145.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:5"
      },
      "items": [
        {
          "text": "era nnaafumiitirizanga ku bikolwa byo ebyewuunyisa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.5",
            "verseOrgIds": [
              "PSA.145.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
