  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "49",
        "style": "c",
        "sid": "PSA 49"
      },
      "items": [
        {
          "text": "49",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zabbuli 49",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Ya Mukulu wa Bayimbi. Zabbuli ya Batabani ba Koola.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 49:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muwulire mmwe amawanga gonna,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.1",
            "verseOrgIds": [
              "PSA.49.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:1"
      },
      "items": [
        {
          "text": "mutege amatu mmwe mwenna abali mu nsi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.1",
            "verseOrgIds": [
              "PSA.49.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 49:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab'ekitiibwa n'abakopi, abagagga n'abaavu, mwenna;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.2",
            "verseOrgIds": [
              "PSA.49.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:2"
      },
      "items": [
        {
          "text": "muwulirize ebigambo byange.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.2",
            "verseOrgIds": [
              "PSA.49.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 49:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga ebigambo by'omu kamwa kange bya magezi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.3",
            "verseOrgIds": [
              "PSA.49.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:3"
      },
      "items": [
        {
          "text": "ebiva mu mutima gwange bijjudde okutegeera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.3",
            "verseOrgIds": [
              "PSA.49.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 49:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nnaakozesanga ebikwata ku ngero,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.4",
            "verseOrgIds": [
              "PSA.49.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:4"
      },
      "items": [
        {
          "text": "nga nnyinnyonnyola amakulu gaazo n'oluyimba ku nnanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.4",
            "verseOrgIds": [
              "PSA.49.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 49:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siityenga ne bwe nnaabanga mu buzibu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.5",
            "verseOrgIds": [
              "PSA.49.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:5"
      },
      "items": [
        {
          "text": "newaakubadde ng'abalabe bange banneetoolodde,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.5",
            "verseOrgIds": [
              "PSA.49.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 49:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "abantu abeesiga obugagga bwabwe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.6",
            "verseOrgIds": [
              "PSA.49.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:6"
      },
      "items": [
        {
          "text": "beenyumiririza mu bintu ebingi bye balina.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.6",
            "verseOrgIds": [
              "PSA.49.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 49:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ddala ddala, tewali muntu ayinza kununula bulamu bwa munne,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.7",
            "verseOrgIds": [
              "PSA.49.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:7"
      },
      "items": [
        {
          "text": "wadde okwegula okuva eri Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.7",
            "verseOrgIds": [
              "PSA.49.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 49:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga omuwendo ogununula obulamu munene nnyo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.8",
            "verseOrgIds": [
              "PSA.49.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:8"
      },
      "items": [
        {
          "text": "tewali n'omu agusobola;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.8",
            "verseOrgIds": [
              "PSA.49.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 49:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "alyoke awangaale ennaku zonna",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.9",
            "verseOrgIds": [
              "PSA.49.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:9"
      },
      "items": [
        {
          "text": "nga tatuuse magombe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.9",
            "verseOrgIds": [
              "PSA.49.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 49:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga n'abantu abagezi bafa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.10",
            "verseOrgIds": [
              "PSA.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:10"
      },
      "items": [
        {
          "text": "abasirusiru n'abatalina magezi bonna baaggwaawo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.10",
            "verseOrgIds": [
              "PSA.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:10"
      },
      "items": [
        {
          "text": "obugagga bwabwe ne babulekera abalala.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.10",
            "verseOrgIds": [
              "PSA.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 49:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entaana zaabwe ge ganaabanga amaka gaabwe ennaku zonna;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.11",
            "verseOrgIds": [
              "PSA.49.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:11"
      },
      "items": [
        {
          "text": "nga bye bisulo ebya buli mulembe oguliddawo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.11",
            "verseOrgIds": [
              "PSA.49.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:11"
      },
      "items": [
        {
          "text": "baafuna ettaka mu mannya gaabwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.11",
            "verseOrgIds": [
              "PSA.49.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 49:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu tabeerera mirembe gyonna, ne bw'aba mugagga atya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.12",
            "verseOrgIds": [
              "PSA.49.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:12"
      },
      "items": [
        {
          "text": "alifa ng'ensolo bwe zifa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.12",
            "verseOrgIds": [
              "PSA.49.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 49:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ako ke kabi akatuuka ku beesiga ebitaliimu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.13",
            "verseOrgIds": [
              "PSA.49.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:13"
      },
      "items": [
        {
          "text": "era ye nkomerero y'abo abeesiga obugagga bwabwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.13",
            "verseOrgIds": [
              "PSA.49.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 49:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okufaanana ng'endiga, bateekwa kufa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.14",
            "verseOrgIds": [
              "PSA.49.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:14"
      },
      "items": [
        {
          "text": "olumbe ne lubalya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.14",
            "verseOrgIds": [
              "PSA.49.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 49:14"
      },
      "items": [
        {
          "text": "Bakka butereevu emagombe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.14",
            "verseOrgIds": [
              "PSA.49.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:14"
      },
      "items": [
        {
          "text": "obulungi bwabwe ne bubula,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.14",
            "verseOrgIds": [
              "PSA.49.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:14"
      },
      "items": [
        {
          "text": "amagombe ne gafuuka amaka gaabwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.14",
            "verseOrgIds": [
              "PSA.49.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 49:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Katonda alinunula emmeeme yange mu magombe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.15",
            "verseOrgIds": [
              "PSA.49.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:15"
      },
      "items": [
        {
          "text": "ddala ddala alintwala gy'ali.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.15",
            "verseOrgIds": [
              "PSA.49.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 49:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu bw'agaggawalanga n'ekitiibwa ky'ennyumba ye nga kyeyongedde,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.16",
            "verseOrgIds": [
              "PSA.49.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:16"
      },
      "items": [
        {
          "text": "tomutyanga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.16",
            "verseOrgIds": [
              "PSA.49.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
