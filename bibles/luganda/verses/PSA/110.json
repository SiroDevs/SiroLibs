      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 110:7"
      },
      "items": [
        {
          "text": "n'addamu amaanyi ag'obuwanguzi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.7",
            "verseOrgIds": [
              "PSA.110.7"
            ]
          }
