      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 110:3"
      },
      "items": [
        {
          "text": "ng'ekiseera ky'olutalo kituuse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.3",
            "verseOrgIds": [
              "PSA.110.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 110:3"
      },
      "items": [
