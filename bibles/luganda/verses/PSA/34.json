    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Ya Dawudi. Bwe yeefuula okuba omugu w'eddalu mu maaso ga Abimereki, oluvannyuma eyamugoba, era naye n'amuviira.",
