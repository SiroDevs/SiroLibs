      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 30:5"
      },
      "items": [
        {
          "text": "naye obulungi bwe bwa mirembe gyonna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.5",
            "verseOrgIds": [
              "PSA.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 30:5"
      },
      "items": [
