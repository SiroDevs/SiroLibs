  "verseCount": 39,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "2SA 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ne wabangawo entalo wakati w'ennyumba ya Sawulo n'ennyumba ya Dawudi okumala ebbanga ddene. Dawudi n'akulaakulana, n'aba w'amaanyi, naye ennyumba ya Sawulo ne yeeyongeranga okunafuwa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.1",
            "verseOrgIds": [
              "2SA.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawudi n'azaalirwa abaana aboobulenzi e Kebbulooni.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "2SA 3:2"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2SA 3:2"
      },
      "items": [
        {
          "text": "Omuggulanda yali Amunoni eyazaalibwa Akinoamu Omuyezuleeri,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.2",
            "verseOrgIds": [
              "2SA.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "owookubiri yali Kireyaabu eyazaalibwa Abbigayiri nnamwandu wa Nabali Omukalumeeri,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.3",
            "verseOrgIds": [
              "2SA.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2SA 3:3"
      },
      "items": [
        {
          "text": "n'owookusatu yali Abusaalomu eyazaalibwa Maaka muwala wa Talumaayi kabaka w'e Gesuli",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.3",
            "verseOrgIds": [
              "2SA.3.3"
            ]
          }
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.3",
            "verseOrgIds": [
              "2SA.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'owookuna yali Adoniya eyazaalibwa Kaggisi,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.4",
            "verseOrgIds": [
              "2SA.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2SA 3:4"
      },
      "items": [
        {
          "text": "n'owokutaano yali Sefatiya eyazaalibwa Abitali;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.4",
            "verseOrgIds": [
              "2SA.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ow'omukaaga yali Isuleyamu, eyazaalibwa Egula mukyala wa Dawudi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.5",
            "verseOrgIds": [
              "2SA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "2SA 3:5"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "2SA 3:5"
      },
      "items": [
        {
          "text": "Abo be baazaalirwa Dawudi mu Kebbulooni.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abuneeri Asala Eddiiro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entalo n'enkaayana nga zikyagenda mu maaso wakati w'ennyumba ya Sawulo n'ennyumba ya Dawudi, Abuneeri n'anyweza ekifo kye mu nnyumba ya Sawulo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.6",
            "verseOrgIds": [
              "2SA.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulo yalina omuzaana erinnya lye Lizupa muwala wa Aya. Isubosesi n'abuuza Abuneeri nti, \"Lwaki weetaba n'omuzaana wa kitange?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.7",
            "verseOrgIds": [
              "2SA.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Abuneeri n'asunguwala nnyo olw'ekigambo Isubosesi kye yamugamba, n'amuddamu nti, \"Nze mutwe gw'embwa ya Yuda? Mbadde wa kisa eri ennyumba ya kitaawo Sawulo, n'eri baganda be, ne mikwano gye, ne sibawaayo mu mukono gwa Dawudi. Kaakano onteekako omusango olw'omukazi oyo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.8",
            "verseOrgIds": [
              "2SA.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda akole Abuneeri bw'atyo n'okukirawo, bwe siituukirize ekyo",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.9",
            "verseOrgIds": [
              "2SA.3.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2SA.3.9",
                "verseOrgIds": [
                  "2SA.3.9"
                ]
              }
            }
          ]
        },
        {
          "text": "kye yalayirira Dawudi,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.9",
            "verseOrgIds": [
              "2SA.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "okuggya obwakabaka ku nnyumba ya Sawulo, n'okunyweza entebe ey'obwakabaka eya Dawudi okufuga Isirayiri ne Yuda okuva ku Ddaani okutuuka e Beeruseba",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.10",
            "verseOrgIds": [
              "2SA.3.10"
            ]
          }
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.10",
            "verseOrgIds": [
              "2SA.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isubosesi n'ataŋŋaanga kwanukula Abuneeri kigambo kirala, olw'okumutya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.11",
            "verseOrgIds": [
              "2SA.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Abuneeri n'atumira Dawudi ababaka okumugamba nti, \"Ensi y'ani? Kola endagaano nange, laba nnaafuula Isirayiri yonna okuba eyiyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.12",
            "verseOrgIds": [
              "2SA.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawudi n'ayogera nti, \"Kirungi. Nzija okukola endagaano naawe. Naye ekintu kimu kye nkusaba. Tojja mu maaso gange okuggyako ng'ojja ne Mikali muwala wa Sawulo, ng'ojja okundaba.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.13",
            "verseOrgIds": [
              "2SA.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Dawudi n'atumira Isubosesi mutabani wa Sawulo ababaka ng'agamba nti, \"Mpa mukyala wange Mikali gwe nayogereza n'ebikuta ekikumi eby'Abafirisuuti.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.14",
            "verseOrgIds": [
              "2SA.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amangwago Isubosesi n'alagira, bamuggye ku bba Palutiyeri mutabani wa Layisi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.15",
            "verseOrgIds": [
              "2SA.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye bba we n'abagoberera, nga bw'akaaba okutuukira ddala, e Bakulimu. Abuneeri n'amugamba nti, \"Ddayo eka. N'addayo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.16",
            "verseOrgIds": [
              "2SA.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abuneeri n'ateesa n'abakadde ba Isirayiri, n'abagamba nti, \"Mumaze ebbanga nga mwagala okufuula Dawudi kabaka wammwe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.17",
            "verseOrgIds": [
              "2SA.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaakano mukituukirize, kubanga",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.18",
            "verseOrgIds": [
              "2SA.3.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2SA.3.18",
                "verseOrgIds": [
                  "2SA.3.18"
                ]
              }
            }
          ]
        },
        {
          "text": "yasuubiza Dawudi nti, 'Ndirokola abantu bange Isirayiri okuva mu mukono gw'Abafirisuuti ne mu mukono gw'abalabe baabwe bonna, nga nkozesa omuddu wange Dawudi.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.18",
            "verseOrgIds": [
              "2SA.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abuneeri n'agenda n'eri Ababenyamini n'ayogera nabo, n'oluvannyuma n'agenda n'ategeeza Dawudi e Kebbulooni, ebyo byonna Isirayiri n'ennyumba ya Benyamini bye baasalawo okukola.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.19",
            "verseOrgIds": [
              "2SA.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Abuneeri n'agenda n'abasajja amakumi abiri ewa Dawudi e Kebbulooni, Dawudi n'abategekera embaga nnene.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.20",
            "verseOrgIds": [
              "2SA.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abuneeri n'agamba Dawudi nti, \"Ka ŋŋenderewo mukama wange Kabaka, nkuŋŋaanye Isirayiri yenna, bakole endagaano naawe, obafuge ng'omutima gwo bwe gunaasiima.\" Awo Dawudi n'asindika Abuneeri agende, n'agenda mirembe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.21",
            "verseOrgIds": [
              "2SA.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yowaabu Atta Abuneeri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo abasajja ba Dawudi ne bakomawo ne Yowaabu, nga baleese omunyago munene ddala. Naye we baakomerawo nga Abuneeri takyali ne Dawudi e Kebbulooni, kubanga yali amusiibudde agende mirembe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.22",
            "verseOrgIds": [
              "2SA.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowaabu n'eggye lyonna bwe baatuuka, Yowaabu n'ategeezebwa nga Abuneeri mutabani wa Neeri bwe yazze eri kabaka, naye kabaka n'amusiibula, n'agenda mirembe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.23",
            "verseOrgIds": [
              "2SA.3.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yowaabu n'agenda eri kabaka n'amugamba nti, \"Wakoze ki ekyo, okuleka Abuneeri n'agenda?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.24",
            "verseOrgIds": [
              "2SA.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okimanyi nga Abuneeri mutabani wa Neeri, yazze okukubuzaabuza, n'okuketta ennyingira yo n'enfuluma yo, ne byonna by'okola?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.25",
            "verseOrgIds": [
              "2SA.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowaabu n'ava mu maaso ga Dawudi, n'atuma ababaka okugoberera Abuneeri, era ne bamukomyawo okuva ku luzzi lwa Siira, naye Dawudi n'atakimanya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.26",
            "verseOrgIds": [
              "2SA.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Abuneeri bwe yakomawo e Kebbulooni, Yowaabu n'amutwala ku bbali w'omulyango, ne yeefuula ng'ayogera naye mu kyama, n'amufumita mu lubuto n'afa. Ekyo Yowaabu y'akikola okumusasula olw'omusaayi gwa Asakeri muganda we.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.27",
            "verseOrgIds": [
              "2SA.3.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oluvannyuma Dawudi bwe yakiwulira, n'ayogera nti, \"Nze n'obwakabaka bwange tetulivunaanibwa ennaku zonna mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.28",
            "verseOrgIds": [
              "2SA.3.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2SA.3.28",
                "verseOrgIds": [
                  "2SA.3.28"
                ]
              }
            }
          ]
        },
        {
          "text": "olw'omusaayi gwa Abuneeri mutabani wa Neeri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.28",
            "verseOrgIds": [
              "2SA.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusaayi gwe gubeerenga ku mutwe gwa Yowaabu ne ku nnyumba ya kitaawe, era mu nnyumba ya Yowaabu mulemenga okubulamu omuziku newaakubadde omugenge, newaakubadde omulema newaakubadde alifa n'ekitala, newaakubadde alibulwa emmere.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.29",
            "verseOrgIds": [
              "2SA.3.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowaabu ne Abisaayi muganda we ne batta Abuneeri kubanga yatta muganda waabwe Asakeri mu lutalo e Gibyoni.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.30",
            "verseOrgIds": [
              "2SA.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Dawudi n'agamba Yowaabu n'abantu bonna abaali naye nti, \"Mwambale ebibukutu, mukungubagire mu maaso ga Abuneeri.\" Kabaka Dawudi yennyini n'atambulira emabega w'essanduuko omwali omulambo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.31",
            "verseOrgIds": [
              "2SA.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abuneeri n'aziikibwa e Kebbulooni, kabaka n'akaaba n'eddoboozi ddene awamu n'abantu bonna ku ntaana ya Abuneeri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.32",
            "verseOrgIds": [
              "2SA.3.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 3:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabaka n'akungubagira Abuneeri, ng'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.33",
            "verseOrgIds": [
              "2SA.3.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 3:33"
      },
      "items": [
        {
          "text": "\"Abuneeri teyandifudde ng'omusirusiru bw'afa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.33",
            "verseOrgIds": [
              "2SA.3.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2SA 3:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emikono gyo tegyasibibwa, so",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.34",
            "verseOrgIds": [
              "2SA.3.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 3:34"
      },
      "items": [
        {
          "text": "n'ebigere byo tebyateekebwa mu masamba.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.34",
            "verseOrgIds": [
              "2SA.3.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 3:34"
      },
      "items": [
        {
          "text": "Ng'omuntu bw'agwa mu maaso g'abo abatali batuukirivu, bwe wagwa bw'otyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.34",
            "verseOrgIds": [
              "2SA.3.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 3:34"
      },
      "items": [
        {
          "text": "Abantu bonna ne bamukungubagira.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.34",
            "verseOrgIds": [
              "2SA.3.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2SA 3:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oluvannyuma bonna ne bagezaako okuwaliriza Dawudi alye ku mmere ng'obudde bukyalaba, naye n'alayira ng'agamba nti, \"Katonda ankole bw'atyo n'okukirawo, bwe nnaakomba ku mmere oba ku kintu kyonna, okutuusa enjuba ng'emaze okugwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.35",
            "verseOrgIds": [
              "2SA.3.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2SA 3:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo abantu bonna ne bakitegeera era ne kibasanyusa. Byonna kabaka bye yakolanga ne bisiimibwanga abantu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.36",
            "verseOrgIds": [
              "2SA.3.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2SA 3:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era ku lunaku olwo abantu bonna ne Isirayiri yenna ne bategeera nga kabaka teyasiima kuttibwa kwa Abuneeri mutabani wa Neeri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.37",
            "verseOrgIds": [
              "2SA.3.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2SA 3:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo kabaka n'agamba abantu be nti, \"Temumanyi nga leero mu Isirayiri mufuddemu omukungu era omusajja omuzira?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.38",
            "verseOrgIds": [
              "2SA.3.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2SA 3:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era leero, newaakubadde nga nze kabaka eyafukibwako amafuta, ndimunafu olw'abaana ba Zeruyiya abampitiriddeko obukakanyavu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.39",
            "verseOrgIds": [
              "2SA.3.39"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2SA.3.39",
                "verseOrgIds": [
                  "2SA.3.39"
                ]
              }
            }
          ]
        },
        {
          "text": "asasule bw'atyo omukozi w'ebibi olw'ebikolwa bye!\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.39",
            "verseOrgIds": [
              "2SA.3.39"
            ]
          }
        }
      ]
    }
  ],
