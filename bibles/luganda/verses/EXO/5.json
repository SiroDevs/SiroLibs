  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "EXO 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Falaawo Aziyiza Abayisirayiri Okuva mu Misiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oluvannyuma lw'ebyo, Musa ne Alooni ne bajja eri Falaawo, ne bamugamba nti, \"Tutumiddwa",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.1",
            "verseOrgIds": [
              "EXO.5.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.5.1",
                "verseOrgIds": [
                  "EXO.5.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wa Isirayiri ng'akugamba nti, 'Leka abantu bange bagende, bankolere embaga mu ddungu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.1",
            "verseOrgIds": [
              "EXO.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Falaawo n'abaddamu nti, \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.2",
            "verseOrgIds": [
              "EXO.5.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.5.2",
                "verseOrgIds": [
                  "EXO.5.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ye ani, mmugondere, nzikirize Abayisirayiri okugenda?",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.2",
            "verseOrgIds": [
              "EXO.5.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.5.2",
                "verseOrgIds": [
                  "EXO.5.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ssimumanyi, era sijja kubakkiriza kugenda.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.2",
            "verseOrgIds": [
              "EXO.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bamugamba nti, \"Katonda w'Abaebbulaniya yatulabikira. Tukusaba otuleke tugende olugendo lwa nnaku ssatu mu ddungu, tuweeyo ssaddaaka eri",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.3",
            "verseOrgIds": [
              "EXO.5.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.5.3",
                "verseOrgIds": [
                  "EXO.5.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda waffe;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.3",
            "verseOrgIds": [
              "EXO.5.3"
            ]
          }
        },
        {
          "text": "aleme kututta ne kawumpuli, oba n'ekitala.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.3",
            "verseOrgIds": [
              "EXO.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye kabaka w'e Misiri n'abagamba nti, \"Mmwe Musa ne Alooni, lwaki mwagala okuggya abantu ku mirimu gyabwe? Muddeeyo mangu ku mirimu gyammwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.4",
            "verseOrgIds": [
              "EXO.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Falaawo n'ayongera n'agamba nti, \"Kale, mulabe abantu nga bwe beeyongedde obungi mu ggwanga ate mmwe mubaziyiza kukola.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.5",
            "verseOrgIds": [
              "EXO.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lunaku olwo lwennyini Falaawo n'alagira abagabi b'emirimu ne bannampala b'abantu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.6",
            "verseOrgIds": [
              "EXO.5.6"
            ]
          }
        },
        {
          "text": "nti,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.6",
            "verseOrgIds": [
              "EXO.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mulekeraawo okuwanga abantu essubi ery'okukozesa mu kubumba amatoffaali; mubaleke bagende beenoonyezenga essubi lyabwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.7",
            "verseOrgIds": [
              "EXO.5.7"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.7",
            "verseOrgIds": [
              "EXO.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye mubalagire babumbenga obungi bw'amatoffaali bwe bumu nga ge babadde babumba; temukendeezanga ku muwendo ogwabasalirwa. Bagayaavu; era kyebava bankaabirira nti, 'Tuleke tugende tuweeyo ssaddaaka eri Katonda waffe.'",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.8",
            "verseOrgIds": [
              "EXO.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasajja mubongereko ku mirimu gye mubasalira, bakole nnyo, balyoke baleme na kufa ku ebyo bye babalimbalimba.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.9",
            "verseOrgIds": [
              "EXO.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abakozesa Bongera ku Mirimu gy'Abayisirayiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo abakozesa ne bannampala ne bagenda ne bategeeza abantu nti, \"Falaawo agambye bw'ati nti, 'Sijja kwongera kubawanga ssubi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.10",
            "verseOrgIds": [
              "EXO.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugende mwenoonyeze essubi yonna gye musobola okuliraba; kyokka emirimu gyammwe tegijja kukendeezebwako n'akatono.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.11",
            "verseOrgIds": [
              "EXO.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe batyo abantu ne basaasaanira Misiri yonna okukuŋŋaanya obukonge bw'essubi ly'eŋŋaano bakozese obwo mu kifo ky'essubi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.12",
            "verseOrgIds": [
              "EXO.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakozesa ne babakuluusanyanga nga babalagira nti, \"Emirimu gyammwe egibasalirwa buli lunaku, mugituukirize nga bwe mwakolanga ng'essubi likyabaweebwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.13",
            "verseOrgIds": [
              "EXO.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bannampala Abayisirayiri, abaalondebwa abakozesa ba Falaawo, ne bakubibwanga nga bwe babuuzibwa nti, \"Lwaki omuwendo gw'amatoffaali ogwa jjo n'ogwa leero ogwabasalirwa temugutuukirizza nga bwe mwakolanga edda?\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.14",
            "verseOrgIds": [
              "EXO.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo bannampala Abayisirayiri ne bajja ne bajulira ewa Falaawo, ne bamugamba nti, \"Ffe abaddu bo, lwaki otuyisizza bw'oti?",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.15",
            "verseOrgIds": [
              "EXO.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaddu bo tetuweebwa ssubi, kyokka tulagirwa nti, 'Mubumbe amatoffaali!' Abaddu bo tukubibwa, so ng'omusango guli mu bantu bo.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.16",
            "verseOrgIds": [
              "EXO.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Falaawo n'abaddamu nti, \"Muli bagayaavu bugayaavu kyokka. Kyemuva mundeeberera nti, 'Tuleke tugende tuweeyo ssaddaaka eri",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.17",
            "verseOrgIds": [
              "EXO.5.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.5.17",
                "verseOrgIds": [
                  "EXO.5.17"
                ]
              }
            }
          ]
        },
        {
          "text": ".'",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.17",
            "verseOrgIds": [
              "EXO.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale, mugende mukole! Temujja kuweebwa ssubi, naye muteekwa okubumba omuwendo gw'amatoffaali omujjuvu nga bwe gwabasalirwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.18",
            "verseOrgIds": [
              "EXO.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bannampala Abayisirayiri ne bategeera ng'akacwano kabatuukiridde, bwe baagambibwa nti, \"Omuwendo gw'amatoffaali ogwabasalirwa okubumbanga buli lunaku tegujja kukendeezebwako.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.19",
            "verseOrgIds": [
              "EXO.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe baava ewa Falaawo, baasanga Musa ne Alooni nga babalindiridde.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.20",
            "verseOrgIds": [
              "EXO.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bannampala ne babagamba nti, \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.21",
            "verseOrgIds": [
              "EXO.5.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.5.21",
                "verseOrgIds": [
                  "EXO.5.21"
                ]
              }
            }
          ]
        },
        {
          "text": "abatunuulire era asalewo; kubanga mutufudde ekyenyinyalwa ewa Falaawo n'abaweereza be, era mubakwasizza ekitala okututta.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.21",
            "verseOrgIds": [
              "EXO.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Katonda Asuubiza Okununula Abayisirayiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Musa n'akomawo awali",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.22",
            "verseOrgIds": [
              "EXO.5.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.5.22",
                "verseOrgIds": [
                  "EXO.5.22"
                ]
              }
            }
          ]
        },
        {
          "text": ", n'ayogera nti, \"Ayi Mukama, abantu bano lwaki obaleetedde emitawaana? Eyo y'ensonga kyewava ontuma?",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.22",
            "verseOrgIds": [
              "EXO.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
