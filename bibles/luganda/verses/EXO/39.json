              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'omusipi mu linena omulebevu omulungi omulange ow'ewuzi eza bbululu, ne kakobe ne myufu nga zitungiddwa ng'omudalizo n'amagezi mangi; nga",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.29",
            "verseOrgIds": [
