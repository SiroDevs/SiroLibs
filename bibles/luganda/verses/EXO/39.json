          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bakola n'ekitambaala eky'oku mutwe mu linena omulebevu omulungi, era n'enkuufiira ne bazikola mu linena omulebevu omulungi; ne bakola n'empale mu linena omulebevu omulungi omulange,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.28",
            "verseOrgIds": [
