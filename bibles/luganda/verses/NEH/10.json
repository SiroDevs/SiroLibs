          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Malluki, ne Kallimu ne Baana.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.27",
            "verseOrgIds": [
              "NEH.10.28"
            ]
          }
        }
