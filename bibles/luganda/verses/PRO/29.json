    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obukulembeze bw'Abatuukirivu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu akakanyaza omutima gwe oluvannyuma lw'okunenyezebwa emirundi emingi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.1",
            "verseOrgIds": [
              "PRO.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:1"
      },
      "items": [
        {
          "text": "alizikirira ng'atamanyiridde awatali kuwona.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.1",
            "verseOrgIds": [
              "PRO.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abatuukirivu bwe bakulaakulana, abantu basanyuka,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.2",
            "verseOrgIds": [
              "PRO.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:2"
      },
      "items": [
        {
          "text": "naye abakakanyalira mu kukola ebikyamu bwe bafuga abantu babeera mu kusinda.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.2",
            "verseOrgIds": [
              "PRO.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayagala amagezi asanyusa kitaawe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.3",
            "verseOrgIds": [
              "PRO.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:3"
      },
      "items": [
        {
          "text": "naye munne w'abamalaaya ayiwaayiwa obugagga bwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.3",
            "verseOrgIds": [
              "PRO.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabaka afuga n'obwenkanya, abantu be baba mu butebenkevu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.4",
            "verseOrgIds": [
              "PRO.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:4"
      },
      "items": [
        {
          "text": "naye oyo alulunkanira enguzi, ensi agyonoona.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.4",
            "verseOrgIds": [
              "PRO.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu awaanawaana munne,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.5",
            "verseOrgIds": [
              "PRO.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:5"
      },
      "items": [
        {
          "text": "aba yeetega yekka ekitimba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.5",
            "verseOrgIds": [
              "PRO.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebibi by'omwonoonyi bye bimutega,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.6",
            "verseOrgIds": [
              "PRO.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:6"
      },
      "items": [
        {
          "text": "naye omutuukirivu abeera mu kuyimba na kusanyuka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.6",
            "verseOrgIds": [
              "PRO.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omutuukirivu afaayo ku nsonga z'abaavu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.7",
            "verseOrgIds": [
              "PRO.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:7"
      },
      "items": [
        {
          "text": "naye abakozi b'ebibi tebakola bwe batyo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.7",
            "verseOrgIds": [
              "PRO.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakudaazi basasamaza ekibuga,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.8",
            "verseOrgIds": [
              "PRO.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:8"
      },
      "items": [
        {
          "text": "naye abantu abalina amagezi baziyiza entalo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.8",
            "verseOrgIds": [
              "PRO.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu ow'amagezi bw'awoza n'omusirusiru,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.9",
            "verseOrgIds": [
              "PRO.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:9"
      },
      "items": [
        {
          "text": "omusirusiru ayongera kusunguwala, n'okujerega ne wataba mirembe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.9",
            "verseOrgIds": [
              "PRO.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeegomba okuyiwa omusaayi bakyawa omuntu ow'amazima,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.10",
            "verseOrgIds": [
              "PRO.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:10"
      },
      "items": [
        {
          "text": "era banoonya okusaanyaawo obulamu bwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.10",
            "verseOrgIds": [
              "PRO.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusirusiru alaga obusungu bwe bwonna,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.11",
            "verseOrgIds": [
              "PRO.29.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:11"
      },
      "items": [
        {
          "text": "naye omuntu ow'amagezi abuziyiza n'abukkakkanya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.11",
            "verseOrgIds": [
              "PRO.29.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omufuzi bw'awuliriza eby'obulimba,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.12",
            "verseOrgIds": [
              "PRO.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:12"
      },
      "items": [
        {
          "text": "abakungu be bonna bafuuka babi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.12",
            "verseOrgIds": [
              "PRO.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwavu n'oyo amubonyaabonya balina ekibagatta:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.13",
            "verseOrgIds": [
              "PRO.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:13"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PRO.29.13",
                "verseOrgIds": [
                  "PRO.29.13"
                ]
              }
            }
          ]
        },
        {
          "text": "bombi ye yabawa amaaso.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.13",
            "verseOrgIds": [
              "PRO.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabaka bw'asalira abaavu emisango n'obwesigwa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.14",
            "verseOrgIds": [
              "PRO.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:14"
      },
      "items": [
        {
          "text": "obufuzi bwe bubeerera emirembe gyonna.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.14",
            "verseOrgIds": [
              "PRO.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaggo akakangavvula, kaleeta amagezi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.15",
            "verseOrgIds": [
              "PRO.29.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:15"
      },
      "items": [
        {
          "text": "naye omwana alekeddwa awo, aswaza nnyina.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.15",
            "verseOrgIds": [
              "PRO.29.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakozi b'ebibi bwe beeyongera obungi, okumenya amateeka kweyongera,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.16",
            "verseOrgIds": [
              "PRO.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:16"
      },
      "items": [
        {
          "text": "naye abatuukirivu baliraba okugwa kwabwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.16",
            "verseOrgIds": [
              "PRO.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
