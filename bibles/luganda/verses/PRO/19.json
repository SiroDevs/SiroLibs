          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwana omusirusiru aleetera kitaawe okuzikirira,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.13",
            "verseOrgIds": [
              "PRO.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 19:13"
      },
      "items": [
        {
          "text": "n'omukazi omuyombi ali ng'enkuba etonnya olutata.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.13",
            "verseOrgIds": [
              "PRO.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
