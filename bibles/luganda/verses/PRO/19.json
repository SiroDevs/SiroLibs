      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 19:9"
      },
      "items": [
        {
          "text": "n'oyo ayogera eby'obulimba alizikirira.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.9",
            "verseOrgIds": [
              "PRO.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
