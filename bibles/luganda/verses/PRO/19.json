            "sid": "PRO 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu omwavu atambulira mu butuukirivu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.1",
            "verseOrgIds": [
              "PRO.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 19:1"
      },
      "items": [
        {
          "text": "asinga akamwa ak'omusirusiru akaweebuula.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.1",
            "verseOrgIds": [
              "PRO.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si kirungi okuba omujjumbize naye nga tolina kumanya,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.2",
            "verseOrgIds": [
              "PRO.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 19:2"
      },
      "items": [
        {
          "text": "n'okwanguyiriza okukola ekintu kuleetera omuntu okukwata ekkubo ekyamu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.2",
            "verseOrgIds": [
              "PRO.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obusirusiru bw'omuntu bwe bwonoona obulamu bwe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.3",
            "verseOrgIds": [
              "PRO.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 19:3"
      },
      "items": [
        {
          "text": "kyokka omutima gwe ne gunenya",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.3",
            "verseOrgIds": [
              "PRO.19.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PRO.19.3",
                "verseOrgIds": [
                  "PRO.19.3"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.3",
            "verseOrgIds": [
              "PRO.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obugagga buleeta emikwano mingi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.4",
            "verseOrgIds": [
              "PRO.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 19:4"
      },
      "items": [
        {
          "text": "naye emikwano gy'omwavu gimuddukako.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.4",
            "verseOrgIds": [
              "PRO.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omujulizi ow'obulimba talirema kubonerezebwa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.5",
            "verseOrgIds": [
              "PRO.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 19:5"
      },
      "items": [
        {
          "text": "era oyo ayogera eby'obulimba taliba na buddukiro.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.5",
            "verseOrgIds": [
              "PRO.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangi banoonya okuganja mu maaso g'omufuzi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.6",
            "verseOrgIds": [
              "PRO.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 19:6"
      },
      "items": [
        {
          "text": "era buli muntu aba mukwano gw'oyo agaba ebirabo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.6",
            "verseOrgIds": [
              "PRO.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baganda b'omwavu bonna bamwewala,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.7",
            "verseOrgIds": [
              "PRO.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 19:7"
      },
      "items": [
        {
          "text": "mikwano gye tebaasingewo nnyo okumwewala?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.7",
            "verseOrgIds": [
              "PRO.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
