  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "1KI 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sulemaani Azimba Yeekaalu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka ogw'ebina mu kinaana, abaana ba Isirayiri kasookedde bava mu nsi y'e Misiri, mu mwaka ogwokuna ogw'obufuzi bwa Sulemaani, mu mwezi ogwokubiri ogwa Zivu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.1",
            "verseOrgIds": [
              "1KI.6.1"
            ]
          }
        },
        {
          "text": ", Sulemaani n'atandika okuzimba yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.1",
            "verseOrgIds": [
              "1KI.6.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1KI.6.1",
                "verseOrgIds": [
                  "1KI.6.1"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.1",
            "verseOrgIds": [
              "1KI.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyeekaalu kabaka Sulemaani gye yazimbira",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.2",
            "verseOrgIds": [
              "1KI.6.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1KI.6.2",
                "verseOrgIds": [
                  "1KI.6.2"
                ]
              }
            }
          ]
        },
        {
          "text": "yali obuwanvu mita amakumi abiri mu musanvu, n'obugazi mita mwenda, n'obuwanvu mita kkumi na ssatu n'ekitundu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.2",
            "verseOrgIds": [
              "1KI.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awayingirirwa mu maaso g'ekisenge ekinene ekya yeekaalu, waali mita mwenda, ng'obugazi bwa yeekaalu bwe bwali, ate ng'obugazi bwakyo mu maaso kiri mita nnya n'ekitundu okuva mu maaso ga yeekaalu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.3",
            "verseOrgIds": [
              "1KI.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'akola amadirisa amafunda mu kisenge kya yeekaalu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.4",
            "verseOrgIds": [
              "1KI.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati w'ebisenge eby'ekisenge ekinene, n'ekifo aw'okwogerera, n'azimba obusenge obw'okubbalibbali okwetooloola wo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.5",
            "verseOrgIds": [
              "1KI.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekisenge ekya wansi kyali mita bbiri ne desimoolo ssatu obugazi, n'ekisenge eky'essa erya wakati kyali mita bbiri ne desimoolo musanvu, n'ekisenge eky'essa eryokusatu kyali mita ssatu ne desimoolo bbiri. N'asalako emiti okwetooloola eyeekaalu gireme okukomererwa mu bisenge bya yeekaalu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.6",
            "verseOrgIds": [
              "1KI.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe baali nga bazimba yeekaalu, baakozesanga amayinja agaali galongosereddwa gye bagatemeranga, era tewaawulirwa kuvuga okw'engeri yonna okw'ennyondo newaakubadde embazzi wadde ekyuma eky'engeri yonna mu kifo awaali wazimbirwa yeekaalu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.7",
            "verseOrgIds": [
              "1KI.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omulyango ogw'ekisenge ekya wakati gwali ku luuyi olw'obukiikaddyo obwa yeekaalu; waabangawo amadaala agaakozesebwanga okugenda mu kisenge ekya wakati, n'okweyongerayo mu kisenge ekyokusatu ekya waggulu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.8",
            "verseOrgIds": [
              "1KI.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo n'azimba yeekaalu n'agimala, n'agisereka n'emiti n'embaawo ez'emivule.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.9",
            "verseOrgIds": [
              "1KI.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'azimba n'ebisenge ebitono okwetooloola yeekaalu, n'obugulumivu bwa buli kimu bwali mita emu n'ekitundu, nga byesigamizibbwa ku kisenge kya yeekaalu n'emiti gy'emivule.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.10",
            "verseOrgIds": [
              "1KI.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.11",
            "verseOrgIds": [
              "1KI.6.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1KI.6.11",
                "verseOrgIds": [
                  "1KI.6.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ne kijjira Sulemaani nti,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.11",
            "verseOrgIds": [
              "1KI.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bino bye bikwata ku yeekaalu eno gy'ozimba; bw'onootambuliranga mu mateeka gange, n'ogondera ebiragiro byange, n'okwatanga n'amateeka gange gonna ng'ogatambuliramu, kale ndituukiriza ekigambo kye nayogera eri Dawudi kitaawo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.12",
            "verseOrgIds": [
              "1KI.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era nnaabeeranga wamu n'abaana ba Isirayiri, so siryabuulira bantu bange Isirayiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.13",
            "verseOrgIds": [
              "1KI.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sulemaani n'azimba yeekaalu n'agimala.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.14",
            "verseOrgIds": [
              "1KI.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku bisenge eby'omunda n'assaako embaawo ez'emivule n'azikomelera okuva wansi wa yeekaalu okutuukira ddala ku kasolya, era ne wansi wa yeekaalu n'ayaliirirawo embaawo ez'emiberosi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.15",
            "verseOrgIds": [
              "1KI.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ayawuzaamu emabega wa yeekaalu, n'akolawo ekifo mu yeekaalu ekyenkana mita mwenda, nga ky'ekisenge awaayimirirwanga okwogera, eky'awatukuvu ennyo, ng'akozesa embaawo ez'emivule okuva wansi okutuuka ku kasolya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.16",
            "verseOrgIds": [
              "1KI.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekisenge ekinene ddala ekyali mu maaso g'ekisenge, awaayimirirwanga okwogera waali obuwanvu mita kkumi na munaana.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.17",
            "verseOrgIds": [
              "1KI.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne munda wa yeekaalu mwali mwaliriddwamu emivule egyayolebwako entaabwa n'ebimuli ebyanjulukuse. Byonna byali bya mivule; tewaali jjinja eryalabika.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.18",
            "verseOrgIds": [
              "1KI.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ateekateeka ekisenge eky'omunda ddala okumpi n'awaayimirirwanga okwogera mu yeekaalu, okuteekamu essanduuko ey'endagaano ya",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.19",
            "verseOrgIds": [
              "1KI.6.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1KI.6.19",
                "verseOrgIds": [
                  "1KI.6.19"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.19",
            "verseOrgIds": [
              "1KI.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era munda awaayimirirwanga okwogera mwalimu ebbanga erya mita mwenda obuwanvu, ne mita mwenda obugazi, ne mita mwenda obugulumivu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.20",
            "verseOrgIds": [
              "1KI.6.20"
            ]
          }
        },
        {
          "text": ". Munda mwonna n'asiigamu zaabu ennongoose",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.20",
            "verseOrgIds": [
              "1KI.6.20"
            ]
          }
        },
        {
          "text": ", era n'akola n'ekyoto n'akisabika n'emivule.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.20",
            "verseOrgIds": [
              "1KI.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sulemaani n'asabika munda wa yeekaalu ne zaabu ennongoose, n'ayongerako n'enjegere eza zaabu mu maaso g'omu kisenge eky'omunda ekyali kibikiddwako zaabu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.21",
            "verseOrgIds": [
              "1KI.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munda wa yeekaalu mwonna, n'assaamu zaabu, ne ku kyoto eky'omu kisenge awaayimirirwanga okwogera",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.22",
            "verseOrgIds": [
              "1KI.6.22"
            ]
          }
        },
        {
          "text": "n'asiigako zaabu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.22",
            "verseOrgIds": [
              "1KI.6.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kisenge awaayimirirwanga okwogera n'akolawo bakerubi babiri ab'emiti egy'emizeeyituuni, buli kerubi obugulumivu bwe mita nnya n'ekitundu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.23",
            "verseOrgIds": [
              "1KI.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obuwanvu bw'ekiwaawaatiro ekimu ekya kerubi omu bwali mita bbiri n'obutundu busatu, n'ekiwaawaatiro ekyokubiri mita bbiri n'obutundu busatu, ze mita nnya n'ekitundu okuva ku luuyi olumu olw'ekiwaawaatiro ekimu okutuuka ku luuyi olw'ekiwaawaatiro ekyokubiri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.24",
            "verseOrgIds": [
              "1KI.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kerubi owookubiri naye yali mita nnya n'ekitundu, era bakerubi bombi baali ekigero kye kimu n'endabika yaabwe nga y'emu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.25",
            "verseOrgIds": [
              "1KI.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obugulumivu bwa buli kerubi bwali mita nnya n'ekitundu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.26",
            "verseOrgIds": [
              "1KI.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ateeka bakerubi mu kisenge eky'omunda ddala mu yeekaalu, ng'ebiwaawaatiro byabwe byanjuluzibbwa. Ekiwaawaatiro ekya kerubi omu ne kikwata ku kisenge eruuyi, n'ekiwaawaatiro ekya kerubi omulala ne kikwata ku kisenge ekirala eruuyi, ebiwaawaatiro byabwe ne bikwatagana wakati wa yeekaalu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.27",
            "verseOrgIds": [
              "1KI.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakerubi n'abasiigako zaabu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.28",
            "verseOrgIds": [
              "1KI.6.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku bisenge byonna ebya yeekaalu okwetooloola, mu bisenge eby'omunda, ne mu bisenge eby'ebweru, n'akola ebifaananyi ebyole ebya bakerubi, n'enkindu, n'ebimuli ebyanjulukuse.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.29",
            "verseOrgIds": [
              "1KI.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne wansi mu bisenge eby'omunda n'eby'ebweru ebya yeekaalu n'assaamu zaabu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.30",
            "verseOrgIds": [
              "1KI.6.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awayingirirwa mu kifo awaayimirirwanga okwogera, waali wawaniriddwa emifuubeeto n'empagi ez'enzigi, omulyango nga gwa nsonda ttaano.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.31",
            "verseOrgIds": [
              "1KI.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku nzigi zombi ez'emiti egy'emizeeyituuni n'akubako ebifaananyi ebyole ebya bakerubi, n'enkindu, n'ebimuli ebyanjulukuse, bakerubi n'enkindu n'abisiiga zaabu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.32",
            "verseOrgIds": [
              "1KI.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu ngeri y'emu n'akola omulyango oguyingira mu kisenge ekinene ddala, n'ateekawo emifuubeeto egy'emizeeyituuni, omulyango nga gwa nsonda nnya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.33",
            "verseOrgIds": [
              "1KI.6.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'akola n'enzigi bbiri za miberosi, buli luggi nga lulina embaawo bbiri ezakyukiranga mu myango.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.34",
            "verseOrgIds": [
              "1KI.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku zo n'ayolako ebifaananyi ebya bakerubi, n'enkindu n'ebimuli ebyanjulukuse, n'abisiiga zaabu ensanuuse.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.35",
            "verseOrgIds": [
              "1KI.6.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'azimba oluggya olw'omunda n'embu ssatu ez'amayinja amateme obulungi, n'olubu olw'emiti egy'emivule.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.36",
            "verseOrgIds": [
              "1KI.6.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 6:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo mu mwaka ogwokuna, mu mwezi Zivu omusingi gwa yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.37",
            "verseOrgIds": [
              "1KI.6.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1KI.6.37",
                "verseOrgIds": [
                  "1KI.6.37"
                ]
              }
            }
          ]
        },
        {
          "text": "ne gumalirizibwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.37",
            "verseOrgIds": [
              "1KI.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka ogw'ekkumi n'ogumu mu mwezi Buli",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.38",
            "verseOrgIds": [
              "1KI.6.38"
            ]
          }
        },
        {
          "text": ", gwe mwezi ogw'omunaana, ebitundu byonna ebya yeekaalu ne bimalirizibwa ng'ebigero byabyo bwe byali. Yamala emyaka musanvu ng'agizimba.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.38",
            "verseOrgIds": [
              "1KI.6.38"
            ]
          }
        }
      ]
    }
