  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "JHN 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ebyo mbibategeezezza muleme kwesittala.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.1",
                "verseOrgIds": [
                  "JHN.16.1"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.1",
            "verseOrgIds": [
              "JHN.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Banaabagobanga mu makuŋŋaaniro, era ekiseera kijja buli anaabattanga n'alowooza nti aweereza Katonda.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.2",
                "verseOrgIds": [
                  "JHN.16.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.2",
            "verseOrgIds": [
              "JHN.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ebyo balibibakola kubanga Kitange tebaamumanya, era nange tebammanyi.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.3",
                "verseOrgIds": [
                  "JHN.16.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.3",
            "verseOrgIds": [
              "JHN.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kale bino mbibabuulidde nga tebinnabaawo, ekiseera bwe kirituuka ne bibaawo mulyoke mujjukire nti nabagamba. Ebyo saabibategeerezaawo ku lubereberye kubanga nnali nkyali nammwe.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.4",
                "verseOrgIds": [
                  "JHN.16.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.4",
            "verseOrgIds": [
              "JHN.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kaakano ŋŋenda eri eyantuma. Naye tewali n'omu ku mmwe ambuuza nti, 'Ogenda wa?'",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.5",
                "verseOrgIds": [
                  "JHN.16.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.5",
            "verseOrgIds": [
              "JHN.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye kubanga mbategeezezza ebyo emitima gyammwe gijjudde ennaku.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.6",
                "verseOrgIds": [
                  "JHN.16.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.6",
            "verseOrgIds": [
              "JHN.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye mbategeereza ddala nti ekisinga obulungi gye muli Nze kwe kugenda. Kubanga bwe sigenda Omubeezi tagenda kujja, kyokka bwe ŋŋenda, ndimutuma gye muli.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.7",
                "verseOrgIds": [
                  "JHN.16.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.7",
            "verseOrgIds": [
              "JHN.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ye bw'alijja, alirumiriza ensi olw'ekibi, n'olw'obutuukirivu n'olw'omusango,",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.8",
                "verseOrgIds": [
                  "JHN.16.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.8",
            "verseOrgIds": [
              "JHN.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "kubanga tebanzikkiriza,",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.9",
                "verseOrgIds": [
                  "JHN.16.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.9",
            "verseOrgIds": [
              "JHN.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "olw'obutuukirivu kubanga ŋŋenda eri Kitange era temukyandaba,",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.10",
                "verseOrgIds": [
                  "JHN.16.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.10",
            "verseOrgIds": [
              "JHN.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "n'olw'omusango, kubanga omufuzi w'ensi eno asaliddwa omusango.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.11",
                "verseOrgIds": [
                  "JHN.16.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nkyalina bingi eby'okubategeeza naye kaakano temusobola kubitegeera.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.12",
                "verseOrgIds": [
                  "JHN.16.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.12",
            "verseOrgIds": [
              "JHN.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye Omwoyo ow'amazima, bw'alijja alibaluŋŋamya mu mazima gonna, kubanga, taliyogera ku bubwe, wabula anaabategeezanga ebyo by'awulira. Anaababuuliranga ebigenda okubaawo.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.13",
                "verseOrgIds": [
                  "JHN.16.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.13",
            "verseOrgIds": [
              "JHN.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Oyo agenda kungulumiza, kubanga agenda kubategeeza bye nnaamubuuliranga.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.14",
                "verseOrgIds": [
                  "JHN.16.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.14",
            "verseOrgIds": [
              "JHN.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Byonna Kitange by'alina byange, kyenvudde ŋŋamba nti Mwoyo Mutukuvu anaabategeezanga bye nnaamubuuliranga.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.15",
                "verseOrgIds": [
                  "JHN.16.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.15",
            "verseOrgIds": [
              "JHN.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mu bbanga ttono munaaba temukyandaba, ate wanaayitawo ebbanga ttono ne mundaba!\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.16",
                "verseOrgIds": [
                  "JHN.16.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamu ku bayigirizwa be ne beebuzaganya nti, \"Kiki ekyo ky'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.17",
            "verseOrgIds": [
              "JHN.16.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "'Mu bbanga ttono temuliddayo kundaba, ate mu bbanga ttono munandaba,'",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.17",
                "verseOrgIds": [
                  "JHN.16.17"
                ]
              }
            }
          ]
        },
        {
          "text": "era nti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.17",
            "verseOrgIds": [
              "JHN.16.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "'Kubanga ŋŋenda eri Kitange?' \"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.17",
                "verseOrgIds": [
                  "JHN.16.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.17",
            "verseOrgIds": [
              "JHN.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne beeyongera okwebuuza nti, \"Kiki ekyo ky'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.18",
            "verseOrgIds": [
              "JHN.16.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "'Ebbanga ttono?'",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.18",
                "verseOrgIds": [
                  "JHN.16.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Tetutegeera ky'agamba.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.18",
            "verseOrgIds": [
              "JHN.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu bwe yamanya nga baagala okumubuuza n'abagamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.19",
            "verseOrgIds": [
              "JHN.16.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mwebuuzaganya ku kye ŋŋambye nti mu bbanga ttono munaaba temukyandaba ate wanaayitawo ebbanga ttono ne mundaba?",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.19",
                "verseOrgIds": [
                  "JHN.16.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.19",
            "verseOrgIds": [
              "JHN.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ddala ddala mbagamba nti mmwe mulikaaba, mulikuba ebiwoobe, naye ensi yo erisanyuka. Mmwe mulinakuwala naye okunakuwala kwammwe kulifuuka essanyu eritagambika bwe mulindabako nate.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.20",
                "verseOrgIds": [
                  "JHN.16.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.20",
            "verseOrgIds": [
              "JHN.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Omukazi ng'azaala aba mu bulumi buyitirivu, kubanga ekiseera kye kituuse. Naye omwana bw'amala okuzaalibwa olwo omukazi aba takyajjukira bulumi buli olw'essanyu ery'okuzaala omuntu mu nsi.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.21",
                "verseOrgIds": [
                  "JHN.16.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.21",
            "verseOrgIds": [
              "JHN.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kale nammwe kaakano munakuwadde, naye ndiddamu okubalaba ne musanyuka, era essanyu lyammwe tewali n'omu aliribaggyako.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.22",
                "verseOrgIds": [
                  "JHN.16.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.22",
            "verseOrgIds": [
              "JHN.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mu kiseera ekyo nga temukyansaba kintu na kimu, mmwe bennyini munaasabanga Kitange mu linnya lyange.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.23",
                "verseOrgIds": [
                  "JHN.16.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.23",
            "verseOrgIds": [
              "JHN.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kino mubadde temukikola, naye kaakano mukitandike. Musabe mu linnya lyange, mujja kuweebwa ekyo kye musaba, essanyu lyammwe liryoke lituukirire.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.24",
                "verseOrgIds": [
                  "JHN.16.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.24",
            "verseOrgIds": [
              "JHN.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ebyo mbibabuulidde mu ngero. Naye ekiseera kijja kutuuka nneme kwogera nammwe mu ngero, wabula mbabuulire lwatu ebifa ku Kitange.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.25",
                "verseOrgIds": [
                  "JHN.16.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.25",
            "verseOrgIds": [
              "JHN.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mu kiseera ekyo mulisaba mu linnya lyange, so si Nze okubasabira eri Kitange.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.26",
                "verseOrgIds": [
                  "JHN.16.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.26",
            "verseOrgIds": [
              "JHN.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kitange abaagala nnyo kubanga nammwe munjagala nnyo era mukkiriza nti nava eri Katonda.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.27",
                "verseOrgIds": [
                  "JHN.16.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.27",
            "verseOrgIds": [
              "JHN.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nava eri Kitange ne nzija mu nsi era nzija kuva mu nsi nzireyo eri Kitange.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.28",
                "verseOrgIds": [
                  "JHN.16.28"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo abayigirizwa be ne bamugamba nti, \"Kaakano oyogera lwatu, so si mu ngero.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.29",
            "verseOrgIds": [
              "JHN.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaakano tutegedde ng'omanyi byonna, era nga tewali kyetaagisa kukubuuza. Kyetuva tukkiriza nga wava eri Katonda.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.30",
            "verseOrgIds": [
              "JHN.16.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'abaddamu nti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.31",
            "verseOrgIds": [
              "JHN.16.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kaakano mukkirizza?",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.31",
                "verseOrgIds": [
                  "JHN.16.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.31",
            "verseOrgIds": [
              "JHN.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Laba, ekiseera kijja, era kituuse mwenna lwe munaasaasaana buli omu n'addayo ku bibye, ne mundeka nzekka. Kyokka sijja kuba nzekka, kubanga Kitange ali wamu nange.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.32",
                "verseOrgIds": [
                  "JHN.16.32"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mbategeezezza ebyo byonna mulyoke mube n'emirembe mu nze. Mu nsi muno mujja kubonaabona, naye mugume, kubanga Nze mpangudde ensi.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.33",
                "verseOrgIds": [
                  "JHN.16.33"
                ]
              }
            }
          ]
        }
      ]
    }
