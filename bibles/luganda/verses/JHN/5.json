        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ddala ddala mbagamba nti, Ekiseera kijja, era kituuse, abafu lwe baliwulira eddoboozi ly'Omwana wa Katonda, era n'abaliwulira baliba balamu.",
