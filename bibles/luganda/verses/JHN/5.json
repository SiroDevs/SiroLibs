        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Munoonya mu Byawandiikibwa kubanga mulowooza nti muyinza okubifuniramu obulamu obutaggwaawo. Kyokka Ebyawandiikibwa ebyo bye binjulira.",
