          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kale muyinza mutya okukkiriza nga munoonya kusiimibwa bantu bannammwe, so nga temunoonya kusiimibwa Katonda oyo Omu yekka?",
              "type": "text",
              "attrs": {
