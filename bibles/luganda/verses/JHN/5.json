        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nzize mu linnya lya Kitange ne mutannyaniriza. Omulala bw'anajja ku bubwe oyo mujja kumwaniriza.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.43",
