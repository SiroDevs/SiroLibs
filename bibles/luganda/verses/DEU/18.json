          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyinza okwebuuza nti, \"Tunaamanyanga tutya ng'ebigambo ebyo",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.21",
            "verseOrgIds": [
              "DEU.18.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.18.21",
                "verseOrgIds": [
                  "DEU.18.21"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda si y'anaabanga abyogedde?\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.21",
            "verseOrgIds": [
              "DEU.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebigambo nnabbi by'anaayogeranga mu linnya lya",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.22",
            "verseOrgIds": [
              "DEU.18.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.18.22",
                "verseOrgIds": [
                  "DEU.18.22"
                ]
              }
            }
          ]
        },
        {
          "text": "bwe bitaatuukirirenga oba bwe bitaabenga bya mazima, ng'ebigambo ebyo",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.22",
            "verseOrgIds": [
              "DEU.18.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
