  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "JOB 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zofali Ayogera",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Zofali Omunaamasi n'ayogera nti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.1",
            "verseOrgIds": [
              "JOB.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ebigambo ebyo byonna bisigale nga tebiddiddwamu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.2",
            "verseOrgIds": [
              "JOB.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:2"
      },
      "items": [
        {
          "text": "Omwogezi ono anaabalibwa ng'ataliiko musango?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.2",
            "verseOrgIds": [
              "JOB.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwogera kwo okutaliimu kunaatusirisa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.3",
            "verseOrgIds": [
              "JOB.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:3"
      },
      "items": [
        {
          "text": "Oduule bw'otyo wabulewo akunenya?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.3",
            "verseOrgIds": [
              "JOB.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogamba Katonda nti, 'Ebirowoozo byange tebirina nsobi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.4",
            "verseOrgIds": [
              "JOB.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:4"
      },
      "items": [
        {
          "text": "era ndi mutukuvu mu maaso go.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.4",
            "verseOrgIds": [
              "JOB.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye, singa Katonda ayogera,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.5",
            "verseOrgIds": [
              "JOB.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:5"
      },
      "items": [
        {
          "text": "singa abikkula akamwa ke n'akuddamu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.5",
            "verseOrgIds": [
              "JOB.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'akubikkulira ebyama by'amagezi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.6",
            "verseOrgIds": [
              "JOB.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:6"
      },
      "items": [
        {
          "text": "kubanga amagezi amatuufu ddala galiko enjuuyi bbiri.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.6",
            "verseOrgIds": [
              "JOB.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:6"
      },
      "items": [
        {
          "text": "Manya kino: Katonda n'okwerabira yeerabira ebimu ku bibi byo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.6",
            "verseOrgIds": [
              "JOB.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Osobola okupima ebyama bya Katonda?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.7",
            "verseOrgIds": [
              "JOB.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:7"
      },
      "items": [
        {
          "text": "Oyinza okunoonyereza ku Ayinzabyonna n'omumalayo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.7",
            "verseOrgIds": [
              "JOB.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bigulumivu okusinga eggulu, kiki ky'osobola okukola?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.8",
            "verseOrgIds": [
              "JOB.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:8"
      },
      "items": [
        {
          "text": "Bikka okusinga obuziba bw'emagombe, kiki ky'osobola okumanya?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.8",
            "verseOrgIds": [
              "JOB.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obuwanvu bwabyo businga ensi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.9",
            "verseOrgIds": [
              "JOB.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:9"
      },
      "items": [
        {
          "text": "era bugazi okusinga ennyanja.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.9",
            "verseOrgIds": [
              "JOB.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Singa ajja n'akusibira mu kkomera era n'atuuza olukiiko,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.10",
            "verseOrgIds": [
              "JOB.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:10"
      },
      "items": [
        {
          "text": "ani ayinza okumuwakanya?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.10",
            "verseOrgIds": [
              "JOB.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazima ddala amanya abantu abalimba.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.11",
            "verseOrgIds": [
              "JOB.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:11"
      },
      "items": [
        {
          "text": "Bw'alaba ebibi, tabifaako?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.11",
            "verseOrgIds": [
              "JOB.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omuntu omusirusiru, talifuna magezi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.12",
            "verseOrgIds": [
              "JOB.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:12"
      },
      "items": [
        {
          "text": "ng'omwana gw'endogoyi ogw'omu nsi bwe gutayinza kuzaalibwa nga gusobola okufugibwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.12",
            "verseOrgIds": [
              "JOB.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naye bw'owaayo omutima gwo gy'ali,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.13",
            "verseOrgIds": [
              "JOB.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:13"
      },
      "items": [
        {
          "text": "n'ogolola emikono gyo gy'ali,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.13",
            "verseOrgIds": [
              "JOB.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "singa oggyawo ekibi ekiri mu mukono gwo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.14",
            "verseOrgIds": [
              "JOB.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:14"
      },
      "items": [
        {
          "text": "n'otokkiriza kibi kubeera mu weema yo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.14",
            "verseOrgIds": [
              "JOB.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "olwo onoositula omutwe n'obwenyi bwo nga tokwatibwa nsonyi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.15",
            "verseOrgIds": [
              "JOB.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:15"
      },
      "items": [
        {
          "text": "era oyimirire ng'oli munywevu awatali kutya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.15",
            "verseOrgIds": [
              "JOB.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazima ddala ojja kwerabira emitawaana gyo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.16",
            "verseOrgIds": [
              "JOB.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:16"
      },
      "items": [
        {
          "text": "olijjukira bujjukizi ng'amazzi agaayita edda.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.16",
            "verseOrgIds": [
              "JOB.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obulamu bujja kwaka okusinga omusana ogw'omu ttuntu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.17",
            "verseOrgIds": [
              "JOB.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:17"
      },
      "items": [
        {
          "text": "n'ekizikiza kijja kufuuka ng'obudde obw'oku nkya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.17",
            "verseOrgIds": [
              "JOB.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olibeera munywevu, kubanga olibeera n'essuubi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.18",
            "verseOrgIds": [
              "JOB.11.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:18"
      },
      "items": [
        {
          "text": "olitunuulira ebikwetooloodde n'owummulira mu mirembe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.18",
            "verseOrgIds": [
              "JOB.11.18"
            ]
          }
        }
      ]
    },
    {
