  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "34",
        "style": "c",
        "sid": "JOB 34"
      },
      "items": [
        {
          "text": "34",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Eriku ne yeeyongera okwogera nti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.1",
            "verseOrgIds": [
              "JOB.34.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Muwulire ebigambo byange, mmwe abasajja ab'amagezi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.2",
            "verseOrgIds": [
              "JOB.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:2"
      },
      "items": [
        {
          "text": "mumpulirize mmwe abayivu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.2",
            "verseOrgIds": [
              "JOB.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga okutu kugezesa ebigambo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.3",
            "verseOrgIds": [
              "JOB.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:3"
      },
      "items": [
        {
          "text": "ng'olulimi bwe lugezesa emmere.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.3",
            "verseOrgIds": [
              "JOB.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leka twesalirewo ekituufu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.4",
            "verseOrgIds": [
              "JOB.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:4"
      },
      "items": [
        {
          "text": "muleke tulondewo ekisaanidde.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.4",
            "verseOrgIds": [
              "JOB.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yobu agamba nti, 'Siriiko musango,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.5",
            "verseOrgIds": [
              "JOB.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:5"
      },
      "items": [
        {
          "text": "naye Katonda agaanye okusala omusango gwange mu mazima.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.5",
            "verseOrgIds": [
              "JOB.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wadde nga ndi mutuufu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.6",
            "verseOrgIds": [
              "JOB.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:6"
      },
      "items": [
        {
          "text": "ntwalibwa okuba omulimba,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.6",
            "verseOrgIds": [
              "JOB.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 34:6"
      },
      "items": [
        {
          "text": "wadde nga siriiko musango,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.6",
            "verseOrgIds": [
              "JOB.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:6"
      },
      "items": [
        {
          "text": "akasaale ke kanteseeko ekiwundu ekitawonyezeka.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.6",
            "verseOrgIds": [
              "JOB.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musajja ki ali nga Yobu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.7",
            "verseOrgIds": [
              "JOB.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:7"
      },
      "items": [
        {
          "text": "anywa okunyoomebwa ng'anywa amazzi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.7",
            "verseOrgIds": [
              "JOB.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atambula n'abakozi b'ebibi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.8",
            "verseOrgIds": [
              "JOB.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:8"
      },
      "items": [
        {
          "text": "mukwano gw'abo abakola ebitali bya butuukirivu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.8",
            "verseOrgIds": [
              "JOB.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga agambye nti, 'Omuntu talina kyaganyulwa",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.9",
            "verseOrgIds": [
              "JOB.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:9"
      },
      "items": [
        {
          "text": "bw'agezaako okusanyusa Katonda.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.9",
            "verseOrgIds": [
              "JOB.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo mumpulirize mmwe abasajja abalina okutegeera.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.10",
            "verseOrgIds": [
              "JOB.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:10"
      },
      "items": [
        {
          "text": "Kikafuuwe Katonda okukola ebibi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.10",
            "verseOrgIds": [
              "JOB.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:10"
      },
      "items": [
        {
          "text": "wadde Ayinzabyonna okukola ebikyamu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.10",
            "verseOrgIds": [
              "JOB.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asasula omuntu olw'ekyo ky'aba akoze;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.11",
            "verseOrgIds": [
              "JOB.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:11"
      },
      "items": [
        {
          "text": "n'amutuusaako ebyo ebimusaanidde olw'empisa ze.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.11",
            "verseOrgIds": [
              "JOB.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weewaawo amazima gali nti, Katonda tasobya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.12",
            "verseOrgIds": [
              "JOB.34.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:12"
      },
      "items": [
        {
          "text": "Ayinzabyonna tasaliriza musango.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.12",
            "verseOrgIds": [
              "JOB.34.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obuyinza yabuggya eri ani okukulembera ensi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.13",
            "verseOrgIds": [
              "JOB.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:13"
      },
      "items": [
        {
          "text": "Ani eyamuwa olukusa okufuga ensi yonna?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.13",
            "verseOrgIds": [
              "JOB.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Singa asalawo n'atwala omwoyo gw'omuntu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.14",
            "verseOrgIds": [
              "JOB.34.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:14"
      },
      "items": [
        {
          "text": "awamu n'omukka gwe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.14",
            "verseOrgIds": [
              "JOB.34.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "abantu bonna bandizikiriridde wamu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.15",
            "verseOrgIds": [
              "JOB.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:15"
      },
      "items": [
        {
          "text": "era omuntu yandizzeeyo mu nfuufu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.15",
            "verseOrgIds": [
              "JOB.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bw'oba olina okutegeera, wuliriza kino;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.16",
            "verseOrgIds": [
              "JOB.34.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:16"
      },
      "items": [
        {
          "text": "wuliriza kye ŋŋamba.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.16",
            "verseOrgIds": [
              "JOB.34.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo atayagala bwenkanya asobola okufuga?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.17",
            "verseOrgIds": [
              "JOB.34.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:17"
      },
      "items": [
        {
          "text": "Onoosalira abatuukirivu n'oyo ow'amaanyi omusango?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.17",
            "verseOrgIds": [
              "JOB.34.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo si ye agamba bakabaka nti, 'Tolina mugaso,'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.18",
            "verseOrgIds": [
              "JOB.34.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:18"
      },
      "items": [
        {
