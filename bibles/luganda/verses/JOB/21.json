  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "JOB 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yobu Ayanukula",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yobu n'addamu n'ayogera nti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.1",
            "verseOrgIds": [
              "JOB.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Muwulirize n'obwegendereza ebigambo byange,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.2",
            "verseOrgIds": [
              "JOB.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:2"
      },
      "items": [
        {
          "text": "era kino kibazzeemu amaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.2",
            "verseOrgIds": [
              "JOB.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungumiikirizeeko nga njogera,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.3",
            "verseOrgIds": [
              "JOB.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:3"
      },
      "items": [
        {
          "text": "oluvannyuma museke.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.3",
            "verseOrgIds": [
              "JOB.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Okwemulugunya kwange nkw'olekezza muntu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.4",
            "verseOrgIds": [
              "JOB.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:4"
      },
      "items": [
        {
          "text": "Lwaki okugumiikiriza tekunzigwako?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.4",
            "verseOrgIds": [
              "JOB.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntunuulire mwewuunye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.5",
            "verseOrgIds": [
              "JOB.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:5"
      },
      "items": [
        {
          "text": "mujja kukwata ne ku mumwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.5",
            "verseOrgIds": [
              "JOB.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe ndowooza ku kino, nfuna entiisa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.6",
            "verseOrgIds": [
              "JOB.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:6"
      },
      "items": [
        {
          "text": "omubiri gwange ne gukankana.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.6",
            "verseOrgIds": [
              "JOB.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwaki abakozi b'ebibi bawangaala,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.7",
            "verseOrgIds": [
              "JOB.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:7"
      },
      "items": [
        {
          "text": "ne bakaddiwa ne beeyongera n'amaanyi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.7",
            "verseOrgIds": [
              "JOB.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaba abaana baabwe bwe banywezebbwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.8",
            "verseOrgIds": [
              "JOB.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:8"
      },
      "items": [
        {
          "text": "ezzadde lyabwe nga balaba.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.8",
            "verseOrgIds": [
              "JOB.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaka gaabwe gaba n'emirembe nga temuli kutya;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.9",
            "verseOrgIds": [
              "JOB.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:9"
      },
      "items": [
        {
          "text": "omuggo gwa Katonda tegubabeerako.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.9",
            "verseOrgIds": [
              "JOB.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ennume zaabwe teziremererwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.10",
            "verseOrgIds": [
              "JOB.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:10"
      },
      "items": [
        {
          "text": "ente zaabwe enkazi zizaala awatali kusowola mwana gwazo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.10",
            "verseOrgIds": [
              "JOB.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baabwe bagendera wamu nga kisibo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.11",
            "verseOrgIds": [
              "JOB.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:11"
      },
      "items": [
        {
          "text": "obuto ne bubeera mu kuzina.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.11",
            "verseOrgIds": [
              "JOB.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayimbira ku bitaasa n'ennanga,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.12",
            "verseOrgIds": [
              "JOB.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:12"
      },
      "items": [
        {
          "text": "ne basanyukira eddoboozi ly'omulere.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.12",
            "verseOrgIds": [
              "JOB.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emyaka gyabwe gyonna babeera bulungi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.13",
            "verseOrgIds": [
              "JOB.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:13"
      },
      "items": [
        {
          "text": "mangwago ne bakka mu ntaana.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.13",
            "verseOrgIds": [
              "JOB.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyokka bagamba Katonda nti, 'Tulekere emirembe gyaffe!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.14",
            "verseOrgIds": [
              "JOB.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:14"
      },
      "items": [
        {
          "text": "Tetwegomba kumanya makubo go.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.14",
            "verseOrgIds": [
              "JOB.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayinzabyonna ye ani tulyoke tumuweereze?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.15",
            "verseOrgIds": [
              "JOB.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:15"
      },
      "items": [
        {
          "text": "Kiki kye tuganyulwa bwe tumusaba?'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.15",
            "verseOrgIds": [
              "JOB.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye obugagga bwabwe tebuli mu mikono gyabwe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.16",
            "verseOrgIds": [
              "JOB.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:16"
      },
      "items": [
        {
          "text": "noolwekyo amagezi g'abakozi b'ebibi ganneewunyisa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.16",
            "verseOrgIds": [
              "JOB.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ettaala y'abakozi b'ebibi yo, ezikira emirundi emeka?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.17",
            "verseOrgIds": [
              "JOB.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:17"
      },
      "items": [
        {
          "text": "Ennaku ebajjira emirundi emeka?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.17",
            "verseOrgIds": [
              "JOB.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:17"
      },
      "items": [
        {
          "text": "Katonda abatuusaako obulumi, ng'abasunguwalidde.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.17",
            "verseOrgIds": [
              "JOB.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bali ng'ebisasiro ebitwaalibwa empewo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.18",
            "verseOrgIds": [
              "JOB.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:18"
      },
      "items": [
        {
          "text": "ng'ebisusunku embuyaga bye zitwala.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.18",
            "verseOrgIds": [
              "JOB.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
