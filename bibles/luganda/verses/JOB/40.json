      },
      "items": [
        {
          "text": "40",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 40:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.1",
            "verseOrgIds": [
              "JOB.40.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOB.40.1",
                "verseOrgIds": [
                  "JOB.40.1"
                ]
              }
            }
          ]
        },
        {
          "text": "n'agamba Yobu nti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.1",
            "verseOrgIds": [
              "JOB.40.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 40:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Oyo anoonya okuyombera ebitaliimu anaayombesa Ayinzabyonna?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.2",
            "verseOrgIds": [
              "JOB.40.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:2"
      },
      "items": [
        {
          "text": "Oyo aleeta empaka ku Katonda, amuddemu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.2",
            "verseOrgIds": [
              "JOB.40.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 40:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yobu n'addamu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.3",
            "verseOrgIds": [
              "JOB.40.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOB.40.3",
                "verseOrgIds": [
                  "JOB.40.3"
                ]
              }
            }
          ]
        },
        {
          "text": "nti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.3",
            "verseOrgIds": [
              "JOB.40.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 40:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Laba, sisaanidde, kiki kye nnaakuddamu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.4",
            "verseOrgIds": [
              "JOB.40.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:4"
      },
      "items": [
        {
          "text": "Emimwa kangibikkeko n'engalo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.4",
            "verseOrgIds": [
              "JOB.40.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 40:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njogedde omulundi gumu, so siddemu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.5",
            "verseOrgIds": [
              "JOB.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:5"
      },
      "items": [
        {
          "text": "weewaawo emirundi ebiri sseeyongere mulundi mulala.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.5",
            "verseOrgIds": [
              "JOB.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 40:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.6",
            "verseOrgIds": [
              "JOB.40.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOB.40.6",
                "verseOrgIds": [
                  "JOB.40.6"
                ]
              }
            }
          ]
        },
        {
          "text": "ng'ali mu muyaga ogw'amaanyi n'addamu Yobu nti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.6",
            "verseOrgIds": [
              "JOB.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 40:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Weesibe engoye zo onywere ng'omusajja.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.7",
            "verseOrgIds": [
              "JOB.40.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:7"
      },
      "items": [
        {
          "text": "Ka nkubuuze,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.7",
            "verseOrgIds": [
              "JOB.40.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:7"
      },
      "items": [
        {
          "text": "naawe onziremu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.7",
            "verseOrgIds": [
              "JOB.40.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Onojjulula ensala yange ey'emisango;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.8",
            "verseOrgIds": [
              "JOB.40.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:8"
      },
      "items": [
        {
          "text": "ononsingisa omusango ggwe atuukiridde?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.8",
            "verseOrgIds": [
              "JOB.40.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 40:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olina omukono ng'ogwa Katonda,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.9",
            "verseOrgIds": [
              "JOB.40.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:9"
      },
      "items": [
        {
          "text": "eddoboozi lyo lisobola okubwatuka ng'erirye?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.9",
            "verseOrgIds": [
              "JOB.40.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale nno yambala ekitiibwa n'obukulu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.10",
            "verseOrgIds": [
              "JOB.40.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:10"
      },
      "items": [
        {
          "text": "weesibe ekitiibwa n'okusukkuluma osukkulume.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.10",
            "verseOrgIds": [
              "JOB.40.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 40:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yolesa obusungu bw'ekiruyi kyo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.11",
            "verseOrgIds": [
              "JOB.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:11"
      },
      "items": [
        {
          "text": "otunuulire buli wa malala omusse wansi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.11",
            "verseOrgIds": [
              "JOB.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tunuulira buli musajja ow'amalala omukkakkanye",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.12",
            "verseOrgIds": [
              "JOB.40.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:12"
      },
      "items": [
        {
          "text": "era olinnyirire abakozi b'ebibi obabetentere we bali.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.12",
            "verseOrgIds": [
              "JOB.40.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonna baziikire wamu mu nfuufu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.13",
            "verseOrgIds": [
              "JOB.40.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:13"
      },
      "items": [
        {
          "text": "emitwe gyabwe ogibikkire mu ntaana.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.13",
            "verseOrgIds": [
              "JOB.40.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nange kennyini ndyoke nzikirize,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.14",
            "verseOrgIds": [
              "JOB.40.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:14"
      },
      "items": [
        {
          "text": "ng'omukono gwo ogwa ddyo, gusobola okukuwa amaanyi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.14",
            "verseOrgIds": [
              "JOB.40.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amaanyi g'Envubu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Laba ekisolo ekyefaananyiriza ng'envubu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.15",
            "verseOrgIds": [
              "JOB.40.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:15"
      },
      "items": [
        {
          "text": "kye natonda nga ggwe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.15",
            "verseOrgIds": [
              "JOB.40.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:15"
      },
      "items": [
        {
          "text": "erya omuddo ng'ente,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.15",
            "verseOrgIds": [
              "JOB.40.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nga kirina amaanyi mayitirivu mu kiwato kyakyo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.16",
            "verseOrgIds": [
              "JOB.40.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:16"
      },
      "items": [
        {
          "text": "amaanyi mangi mu binywa by'olubuto lwakyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.16",
            "verseOrgIds": [
              "JOB.40.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 40:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiwuuba omukira gwakyo ne guba ng'omukira gw'omuvule",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.17",
            "verseOrgIds": [
              "JOB.40.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:17"
      },
      "items": [
        {
          "text": "Ebinywa by'ebisambi byakyo byakwatagana nnyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.17",
            "verseOrgIds": [
              "JOB.40.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 40:18"
          },
          "items": [
            {
              "text": "18",
