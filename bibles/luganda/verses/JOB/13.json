  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "JOB 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Laba, eriiso lyange lyalaba ebyo byonna,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.1",
            "verseOrgIds": [
              "JOB.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:1"
      },
      "items": [
        {
          "text": "n'okutu kwange ne kuwulira ne mbitegeera.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.1",
            "verseOrgIds": [
              "JOB.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kye mumanyi nange kye mmanyi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.2",
            "verseOrgIds": [
              "JOB.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:2"
      },
      "items": [
        {
          "text": "siri wa wansi ku mmwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.2",
            "verseOrgIds": [
              "JOB.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye neegomba okwogera n'oyo Ayinzabyonna,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.3",
            "verseOrgIds": [
              "JOB.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:3"
      },
      "items": [
        {
          "text": "era n'okuleeta ensonga zange mu maaso ga Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.3",
            "verseOrgIds": [
              "JOB.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye mmwe mumpayiriza;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.4",
            "verseOrgIds": [
              "JOB.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:4"
      },
      "items": [
        {
          "text": "muli basawo abatagasa mmwe mwenna!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.4",
            "verseOrgIds": [
              "JOB.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale singa musirika!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.5",
            "verseOrgIds": [
              "JOB.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:5"
      },
      "items": [
        {
          "text": "Olwo lwe mwandibadde n'amagezi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.5",
            "verseOrgIds": [
              "JOB.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muwulire kaakano endowooza yange,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.6",
            "verseOrgIds": [
              "JOB.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:6"
      },
      "items": [
        {
          "text": "muwulirize okwegayirira kw'emimwa gyange.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.6",
            "verseOrgIds": [
              "JOB.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda munaamwogerera nga mwogera ebitali bya butuukirivu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.7",
            "verseOrgIds": [
              "JOB.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:7"
      },
      "items": [
        {
          "text": "Munaamwogerera eby'obulimba?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.7",
            "verseOrgIds": [
              "JOB.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munaamulaga ng'ataliiko luuyi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.8",
            "verseOrgIds": [
              "JOB.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:8"
      },
      "items": [
        {
          "text": "munaamuwoleza ensonga ze.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.8",
            "verseOrgIds": [
              "JOB.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Singa akukebera, anaakusanga oli bulungi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.9",
            "verseOrgIds": [
              "JOB.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:9"
      },
      "items": [
        {
          "text": "Oyinza okumulimba nga bw'oyinza okulimba abantu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.9",
            "verseOrgIds": [
              "JOB.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tayinza butakunenya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.10",
            "verseOrgIds": [
              "JOB.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:10"
      },
      "items": [
        {
          "text": "singa osaliriza mu bubba.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.10",
            "verseOrgIds": [
              "JOB.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekitiibwa kye ekisukiridde tekyandikutiisizza?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.11",
            "verseOrgIds": [
              "JOB.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:11"
      },
      "items": [
        {
          "text": "Entiisa ye teyandikuguddeko?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.11",
            "verseOrgIds": [
              "JOB.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebigambo byammwe ebijjukirwa ngero za vvu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.12",
            "verseOrgIds": [
              "JOB.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:12"
      },
      "items": [
        {
          "text": "n'okwewolereza kwammwe kwa bbumba.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.12",
            "verseOrgIds": [
              "JOB.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musirike nze njogere;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.13",
            "verseOrgIds": [
              "JOB.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:13"
      },
      "items": [
        {
          "text": "kyonna ekinantukako kale kintuukeko.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.13",
            "verseOrgIds": [
              "JOB.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwaki neeteeka mu mitawaana,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.14",
            "verseOrgIds": [
              "JOB.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:14"
      },
      "items": [
        {
          "text": "obulamu bwange ne mbutwalira mu mikono gyange?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.14",
            "verseOrgIds": [
              "JOB.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bw'anzita, mu ye mwe nnina essuubi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.15",
            "verseOrgIds": [
              "JOB.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:15"
      },
      "items": [
        {
          "text": "ddala ddala nditwala ensonga zange mu maaso ge.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.15",
            "verseOrgIds": [
              "JOB.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ddala kino kinaavaamu okusumululwa kwange,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.16",
            "verseOrgIds": [
              "JOB.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:16"
      },
      "items": [
        {
          "text": "kubanga teri muntu atatya Katonda ayinza kwetantala kujja mu maaso ge!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.16",
            "verseOrgIds": [
              "JOB.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muwulirize ebigambo byange n'obwegendereza;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.17",
            "verseOrgIds": [
              "JOB.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:17"
      },
      "items": [
        {
          "text": "amatu gammwe gawulire bye ŋŋamba.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.17",
            "verseOrgIds": [
              "JOB.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaakano nga bwe ntegese empoza yange,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.18",
            "verseOrgIds": [
              "JOB.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:18"
      },
      "items": [
        {
          "text": "mmanyi nti nzija kwejeerera.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.18",
            "verseOrgIds": [
              "JOB.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waliwo ayinza okuleeta emisango gye nvunaanibwa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.19",
            "verseOrgIds": [
              "JOB.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:19"
      },
      "items": [
        {
          "text": "Bwe kiba bwe kityo, nzija kusirika nfe.",
          "type": "text",
          "attrs": {
