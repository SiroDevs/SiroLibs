  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "JOB 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yobu Ayanukula",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yobu n'alyoka addamu nti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.1",
            "verseOrgIds": [
              "JOB.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ddala nkimanyi nga kino kituufu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.2",
            "verseOrgIds": [
              "JOB.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:2"
      },
      "items": [
        {
          "text": "Naye omuntu asobola atya okuba omutuukirivu eri Katonda?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.2",
            "verseOrgIds": [
              "JOB.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wadde ng'omuntu yandyagadde okuwakana naye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.3",
            "verseOrgIds": [
              "JOB.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:3"
      },
      "items": [
        {
          "text": "tayinza kumuddamu kibuuzo na kimu ku bibuuzo olukumi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.3",
            "verseOrgIds": [
              "JOB.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amagezi ge ga nsusso, amaanyi ge mangi nnyo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.4",
            "verseOrgIds": [
              "JOB.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:4"
      },
      "items": [
        {
          "text": "ani eyali amuwakanyizza n'avaayo nga taliiko binuubule?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.4",
            "verseOrgIds": [
              "JOB.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asimbula ensozi ne zivaayo nga tezimanyiridde",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.5",
            "verseOrgIds": [
              "JOB.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:5"
      },
      "items": [
        {
          "text": "era n'azivuunika ng'asunguwadde.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.5",
            "verseOrgIds": [
              "JOB.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensi aginyeenya n'eva mu kifo kyayo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.6",
            "verseOrgIds": [
              "JOB.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:6"
      },
      "items": [
        {
          "text": "era n'akankanya empagi zaayo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.6",
            "verseOrgIds": [
              "JOB.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayogera eri enjuba ne teyaka,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.7",
            "verseOrgIds": [
              "JOB.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:7"
      },
      "items": [
        {
          "text": "akugira n'alemesa ekitangaala ky'emmunyeenye okulabika.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.7",
            "verseOrgIds": [
              "JOB.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye yekka abamba eggulu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.8",
            "verseOrgIds": [
              "JOB.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:8"
      },
      "items": [
        {
          "text": "era n'atambulira ku mayengo g'ennyanja.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.8",
            "verseOrgIds": [
              "JOB.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye mukozi wa Nabaliyo, entungalugoye ne Kakaaga,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.9",
            "verseOrgIds": [
              "JOB.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:9"
      },
      "items": [
        {
          "text": "n'ebibinja eby'emunyeenye eby'obukiikaddyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.9",
            "verseOrgIds": [
              "JOB.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akola ebyewuunyo ebizibu okunnyonnyola,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.10",
            "verseOrgIds": [
              "JOB.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:10"
      },
      "items": [
        {
          "text": "n'akola n'ebyamagero ebitabalika.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.10",
            "verseOrgIds": [
              "JOB.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'ayita we ndi sisobola kumulaba,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.11",
            "verseOrgIds": [
              "JOB.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:11"
      },
      "items": [
        {
          "text": "bw'ampitako, sisobola kumutegeera.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.11",
            "verseOrgIds": [
              "JOB.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'aba alina ky'aggya ku muntu, ani ayinza okumuziyiza?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.12",
            "verseOrgIds": [
              "JOB.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:12"
      },
      "items": [
        {
          "text": "Ani ayinza okumubuuza nti kiki ky'okola?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.12",
            "verseOrgIds": [
              "JOB.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda taziyiza busungu bwe;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.13",
            "verseOrgIds": [
              "JOB.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:13"
      },
      "items": [
        {
          "text": "n'ebibinja bya Lakabu byakankanira wansi w'ebigere bye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.13",
            "verseOrgIds": [
              "JOB.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaakano nnyinza ntya okuwakana naye?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.14",
            "verseOrgIds": [
              "JOB.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:14"
      },
      "items": [
        {
          "text": "Nnyinza ntya okufuna ebigambo mpakane naye?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.14",
            "verseOrgIds": [
              "JOB.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wadde nga siriiko musango, sisobola kubaako kye muddamu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.15",
            "verseOrgIds": [
              "JOB.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:15"
      },
      "items": [
        {
          "text": "mba nnyinza kwegayirira bwegayirizi oyo Omulamuzi wange ankwatirwe ekisa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.15",
            "verseOrgIds": [
              "JOB.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bwe na ndimukoowodde n'ampitaba,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.16",
            "verseOrgIds": [
              "JOB.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:16"
      },
      "items": [
        {
          "text": "sirowooza nti yandimpadde ekiseera n'ampuliriza.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.16",
            "verseOrgIds": [
              "JOB.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yandimenyeemenye mu muyaga",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.17",
            "verseOrgIds": [
              "JOB.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:17"
      },
      "items": [
        {
          "text": "nannyongerako ebiwundu awatali nsonga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.17",
            "verseOrgIds": [
              "JOB.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teyandindese kuddamu mukka",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.18",
            "verseOrgIds": [
              "JOB.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:18"
      },
      "items": [
        {
          "text": "naye yandimmaliddewo ddala nga mbonaabona.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.18",
            "verseOrgIds": [
              "JOB.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe kiba nga kigambo kya maanyi bwanyi, ye wa maanyi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.19",
            "verseOrgIds": [
              "JOB.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:19"
      },
      "items": [
        {
          "text": "Era bwe kiba kya kusala musango, ani alimuyita?",
