  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "JOB 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ebiseera by'omuntu ku nsi, tebyagerebwa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.1",
            "verseOrgIds": [
              "JOB.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:1"
      },
      "items": [
        {
          "text": "Ennaku ze tezaagerebwa nga ez'omupakasi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.1",
            "verseOrgIds": [
              "JOB.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'omuddu eyeegomba ekisiikirize okujja,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.2",
            "verseOrgIds": [
              "JOB.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:2"
      },
      "items": [
        {
          "text": "ng'omupakasi bwe yeesunga empeera ye;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.2",
            "verseOrgIds": [
              "JOB.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "bwe ntyo bwe nnaweebwa emyezi egy'okubonaabona,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.3",
            "verseOrgIds": [
              "JOB.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:3"
      },
      "items": [
        {
          "text": "ebiro ebyokutegana bwe byangererwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.3",
            "verseOrgIds": [
              "JOB.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe ngalamira neebake, njogera nti, 'Ndiyimuka ddi, ekiro kinaakoma ddi?'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.4",
            "verseOrgIds": [
              "JOB.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:4"
      },
      "items": [
        {
          "text": "Nga nzijudde okukulungutana okutuusa obudde lwe bukya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.4",
            "verseOrgIds": [
              "JOB.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omubiri gwange gujjudde envunyu n'ebikakampa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.5",
            "verseOrgIds": [
              "JOB.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:5"
      },
      "items": [
        {
          "text": "n'olususu lwange lukutusekutuse era lulabika bubi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.5",
            "verseOrgIds": [
              "JOB.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ennaku zange zidduka okusinga ekyuma ky'omulusi w'engoye bw'atambuza ky'alusisa engoye ze;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.6",
            "verseOrgIds": [
              "JOB.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:6"
      },
      "items": [
        {
          "text": "era zikoma awatali ssuubi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.6",
            "verseOrgIds": [
              "JOB.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ojjukira Ayi Katonda, nti obulamu bwange tebuliimu, wabula mukka bukka,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.7",
            "verseOrgIds": [
              "JOB.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:7"
      },
      "items": [
        {
          "text": "amaaso gange tegaliddayo kulaba bulungi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.7",
            "verseOrgIds": [
              "JOB.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eriiso ly'oyo eryali lindabyeko teririddayo kundaba;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.8",
            "verseOrgIds": [
              "JOB.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:8"
      },
      "items": [
        {
          "text": "amaaso gammwe galinnoonya, naye nga sikyaliwo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.8",
            "verseOrgIds": [
              "JOB.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga ekire bwe kibulawo ne kigenda,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.9",
            "verseOrgIds": [
              "JOB.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:9"
      },
      "items": [
        {
          "text": "bw'atyo n'aziikwa mu ntaana talivaayo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.9",
            "verseOrgIds": [
              "JOB.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taliddayo mu nnyumba ye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.10",
            "verseOrgIds": [
              "JOB.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:10"
      },
      "items": [
        {
          "text": "amaka ge tegaliddayo kumumanya nate.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.10",
            "verseOrgIds": [
              "JOB.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo sijja kuziyiza kamwa kange, nzija kwogera okulumwa kw'omutima gwange;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.11",
            "verseOrgIds": [
              "JOB.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:11"
      },
      "items": [
        {
          "text": "nzija kwemulugunyiza mu bulumi bw'emmeeme yange.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.11",
            "verseOrgIds": [
              "JOB.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi nnyanja oba ndi lukwata ow'omu buziba,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.12",
            "verseOrgIds": [
              "JOB.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:12"
      },
      "items": [
        {
          "text": "olyoke onkuume?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.12",
            "verseOrgIds": [
              "JOB.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe ndowooza nti, obuliri bwange bunampa ku mirembe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.13",
            "verseOrgIds": [
              "JOB.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:13"
      },
      "items": [
        {
          "text": "ekiriri kyange kinakendeeza ku kulumwa kwange;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.13",
            "verseOrgIds": [
              "JOB.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'olyoka ontiisa n'ebirooto",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.14",
            "verseOrgIds": [
              "JOB.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:14"
      },
      "items": [
        {
          "text": "era n'onkanga okuyita mu kwolesebwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.14",
            "verseOrgIds": [
              "JOB.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emmeeme yange ne yeegomba okwetuga,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.15",
            "verseOrgIds": [
              "JOB.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:15"
      },
      "items": [
        {
          "text": "nfe okusinga okuba omulamu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.15",
            "verseOrgIds": [
              "JOB.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikyeyagala, neetamiddwa. Sijja kubeera mulamu emirembe gyonna.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.16",
            "verseOrgIds": [
              "JOB.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:16"
      },
      "items": [
        {
          "text": "Ndeka; kubanga ennaku zange butaliimu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.16",
            "verseOrgIds": [
              "JOB.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu kye ki ggwe okumugulumiza,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.17",
            "verseOrgIds": [
              "JOB.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:17"
      },
      "items": [
        {
          "text": "n'omulowoozaako?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.17",
            "verseOrgIds": [
              "JOB.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'otyo n'omwekebejja buli makya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.18",
            "verseOrgIds": [
              "JOB.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:18"
      },
      "items": [
        {
          "text": "n'omugezesa buli kaseera?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.18",
            "verseOrgIds": [
              "JOB.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olituusa ddi nga tonvuddeeko",
          "type": "text",
