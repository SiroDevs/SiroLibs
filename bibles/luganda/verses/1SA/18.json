          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulo ne yeeyongera okumutya, era n'aba mulabe wa Dawudi okuva mu kiseera ekyo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.29",
