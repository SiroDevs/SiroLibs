                "verseId": "1SA.18.28",
                "verseOrgIds": [
                  "1SA.18.28"
                ]
              }
            }
          ]
        },
        {
          "text": "ali wamu ne Dawudi, ate nga ne muwala we Mikali ayagala Dawudi,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.28",
            "verseOrgIds": [
              "1SA.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
