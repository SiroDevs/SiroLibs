              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino kaakano si biseera bya kukungula ŋŋaano. Naye nzija kusaba",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.17",
            "verseOrgIds": [
