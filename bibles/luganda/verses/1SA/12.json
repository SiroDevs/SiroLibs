                "verseOrgIds": [
                  "1SA.12.23"
                ]
              }
            }
          ]
        },
        {
          "text": "ne ssibasabira; nnaabalaganga ekkubo ettuufu era eggolokofu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.23",
            "verseOrgIds": [
