                "verseOrgIds": [
                  "1SA.12.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", aweereze okubwatuka n'enkuba, mulyoke mutegeere nga kye mwakola okusaba kabaka kyali kibi mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.17",
            "verseOrgIds": [
