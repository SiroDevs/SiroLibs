          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Temukyukanga okugoberera ebintu ebitaliimu, ebitayinza kubagasa wadde okubawonya, kubanga tebiriimu nsa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.21",
            "verseOrgIds": [
              "1SA.12.21"
            ]
          }
        },
