                "verseOrgIds": [
                  "1SA.12.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo, ffe abaweereza bo, tuleme kufa, kubanga twongedde ku bibi byaffe ebirala byonna, bwe twasabye kabaka.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.19",
            "verseOrgIds": [
              "1SA.12.19"
            ]
          }
        }
