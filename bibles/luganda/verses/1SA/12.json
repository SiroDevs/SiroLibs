                "verseOrgIds": [
                  "1SA.12.22"
                ]
              }
            }
          ]
        },
        {
          "text": "tagenda kwabulira bantu be, olw'erinnya lye ekkulu, kubanga",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.22",
            "verseOrgIds": [
              "1SA.12.22"
            ]
          }
