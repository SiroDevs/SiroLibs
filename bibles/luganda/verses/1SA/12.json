              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo abantu bonna ne bagamba Samwiri nti, \"Tusabire eri",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.19",
            "verseOrgIds": [
