                "verseOrgIds": [
                  "1SA.12.22"
                ]
              }
            }
          ]
        },
        {
          "text": "yasiima okubafuula ababe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.22",
            "verseOrgIds": [
              "1SA.12.22"
            ]
          }
        },
        {
