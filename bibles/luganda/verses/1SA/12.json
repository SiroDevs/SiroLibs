          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nze ku lwange, kikafuuwe, okwonoona eri",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.23",
            "verseOrgIds": [
              "1SA.12.23"
            ]
