                "verseOrgIds": [
                  "1SA.12.16"
                ]
              }
            }
          ]
        },
        {
          "text": "kyagenda okukola mu maaso gammwe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.16",
