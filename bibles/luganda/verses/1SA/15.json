              "attrs": {
                "verseId": "1SA.15.24",
                "verseOrgIds": [
                  "1SA.15.24"
                ]
              }
            }
          ]
        },
        {
          "text": "era n'ebigambo byo, kubanga natidde abantu ne ŋŋendera ku bigambo byabwe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.24",
            "verseOrgIds": [
              "1SA.15.24"
            ]
          }
        },
