          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo ayitibwa Ekitiibwa kya Isirayiri talimba ate takyusakyusa kirowoozo kye, kubanga si muntu nti anaakyusa ekirowoozo kye.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.29",
            "verseOrgIds": [
              "1SA.15.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
