                "verseOrgIds": [
                  "1SA.15.28"
                ]
              }
            }
          ]
        },
        {
          "text": "akuyuzizzaako obwakabaka bwa Isirayiri leero, n'abuwa omu ku baliraanwa bo akusinga.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.28",
            "verseOrgIds": [
              "1SA.15.28"
            ]
          }
        },
