                "verseOrgIds": [
                  "1SA.15.26"
                ]
              }
            }
          ]
        },
        {
          "text": ", ne",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.26",
            "verseOrgIds": [
              "1SA.15.26"
            ]
          }
        },
