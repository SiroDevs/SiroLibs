              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaserikale baatute endiga n'ente, ebisinga obulungi ku ebyo ebyali biteekeddwa okuzikirizibwa, babiweeyo eri",
          "type": "text",
          "attrs": {
