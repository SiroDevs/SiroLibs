  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "1SA 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Samwiri n'agamba Sawulo nti, \"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.1",
            "verseOrgIds": [
              "1SA.15.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.1",
                "verseOrgIds": [
                  "1SA.15.1"
                ]
              }
            }
          ]
        },
        {
          "text": "nze gwe yatuma okukufukako amafuta okuba kabaka w'abantu be Isirayiri, noolwekyo wuliriza obubaka obuva eri",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.1",
            "verseOrgIds": [
              "1SA.15.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.1",
                "verseOrgIds": [
                  "1SA.15.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.1",
            "verseOrgIds": [
              "1SA.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.2",
            "verseOrgIds": [
              "1SA.15.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.2",
                "verseOrgIds": [
                  "1SA.15.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Ayinzabyonna nti, 'Ndibonereza Abamaleki olw'ekyo kye baakola Isirayiri bwe baabateega nga bayambuka okuva mu Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.2",
            "verseOrgIds": [
              "1SA.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaakano genda olumbe Abamaleki obazikiririze ddala, n'ebintu byabwe byonna. Tobasaasira, otta abasajja n'abakazi, abaana n'abato ddala, ente, n'endiga, n'eŋŋamira n'endogoyi.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.3",
            "verseOrgIds": [
              "1SA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Sawulo n'akuŋŋaanya abasajja, n'ababalira e Terayimu, nga bawera abaserikale ab'ebigere emitwalo amakumi abiri, n'abalala omutwalo gumu okuva mu Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.4",
            "verseOrgIds": [
              "1SA.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulo n'asemberera ekibuga kya Amaleki n'abateegera mu kiwonvu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.5",
            "verseOrgIds": [
              "1SA.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'agamba Abakeeni nti, \"Muve mu Bamaleki mugende nneme okubazikiririza awamu nabo, kubanga mwakolera Abayisirayiri bonna ebyekisa bwe bayambuka okuva mu Misiri.\" Abakeeni ne basenguka okuva mu Bamaleki.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.6",
            "verseOrgIds": [
              "1SA.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Sawulo n'alumba Abamaleki okuviira ddala e Kavira okutuuka e Ssuuli, ekiri ebuvanjuba w'e Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.7",
            "verseOrgIds": [
              "1SA.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'awamba Agagi kabaka w'Abamaleki nga mulamu, naye abantu abalala bonna n'abazikiririza ddala n'ekitala.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.8",
            "verseOrgIds": [
              "1SA.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era Sawulo n'eggye ne baleka Agagi nga mulamu, era endiga n'ente, n'ennyana n'abaana b'endiga n'ebyassava, n'ebyo byonna bye baalaba nga bya muwendo, ne batabizikiririza ddala. Naye ebirala byonna ebitaali bya muwendo nga binyoomebwa oba nga binafu, ne babizikiririza ddala.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.9",
            "verseOrgIds": [
              "1SA.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.10",
            "verseOrgIds": [
              "1SA.15.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.10",
                "verseOrgIds": [
                  "1SA.15.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ne kijjira Samwiri nti,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.10",
            "verseOrgIds": [
              "1SA.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nejjusizza okufuula Sawulo kabaka, kubanga avudde kukungoberera, n'atakolera ku biragiro byange.\" Samwiri n'anyolwa nnyo, n'akabira",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.11",
            "verseOrgIds": [
              "1SA.15.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.11",
                "verseOrgIds": [
                  "1SA.15.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ekiro kyonna.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.11",
            "verseOrgIds": [
              "1SA.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enkeera ku makya Samwiri n'agolokoka n'agenda okusisinkana Sawulo, naye ne bamutegeeza nti, \"Sawulo yazze e Kalumeeri gye yeezimbidde ekijjukizo, kyokka kaakano avuddeyo n'aserengeta e Girugaali.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.12",
            "verseOrgIds": [
              "1SA.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Samwiri bwe yamutuukako, Sawulo n'ayogera nti, \"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.13",
            "verseOrgIds": [
              "1SA.15.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.13",
                "verseOrgIds": [
                  "1SA.15.13"
                ]
              }
            }
          ]
        },
        {
          "text": "akuwe omukisa. Ngoberedde ebiragiro bya",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.13",
            "verseOrgIds": [
              "1SA.15.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.13",
                "verseOrgIds": [
                  "1SA.15.13"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.13",
            "verseOrgIds": [
              "1SA.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Samwiri n'amuddamu nti, \"Ate okubejjagala okw'endiga n'okuŋooŋa kw'ente bye mpulira biva wa?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.14",
            "verseOrgIds": [
              "1SA.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulo n'amuddamu nti, \"Abaserikale baaziggye ku Bamaleki. Baaleseewo ente n'endiga ezisinga obulungi okuba ebiweebwayo eri",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.15",
            "verseOrgIds": [
              "1SA.15.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.15",
                "verseOrgIds": [
                  "1SA.15.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo, naye ebirala byonna twabizikiririzza ddala.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.15",
            "verseOrgIds": [
              "1SA.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Samwiri n'agamba Sawulo nti, \"Sirika! Ka nkutegeeze",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.16",
            "verseOrgIds": [
              "1SA.15.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.16",
                "verseOrgIds": [
                  "1SA.15.16"
                ]
              }
            }
          ]
        },
        {
          "text": "kye yaŋŋambye ekiro.\" Sawulo n'amuddamu nti, \"Ntegeeza.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.16",
            "verseOrgIds": [
              "1SA.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samwiri n'amugamba nti, \"Newaakubadde nga wali weeraba ng'oli mutono, tewafuuka mukulu wa bika bya Isirayiri?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.17",
            "verseOrgIds": [
              "1SA.15.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.17",
                "verseOrgIds": [
                  "1SA.15.17"
                ]
              }
            }
          ]
        },
        {
          "text": "yakufukako amafuta okuba kabaka wa Isirayiri.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.17",
            "verseOrgIds": [
              "1SA.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naakutuma omulimu, ng'agamba nti, 'Genda ozikiririze ddala abalina ebibi abo Abamaleki, obalwanyise okutuusa lw'olibamalirawo ddala.'",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.18",
            "verseOrgIds": [
              "1SA.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwaki tewagondedde ddoboozi lya",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.19",
            "verseOrgIds": [
              "1SA.15.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.19",
                "verseOrgIds": [
                  "1SA.15.19"
                ]
              }
            }
          ]
        },
        {
          "text": "? Lwaki mwalulunkanidde omunyago ne mukola ekibi mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.19",
            "verseOrgIds": [
              "1SA.15.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.19",
                "verseOrgIds": [
                  "1SA.15.19"
                ]
              }
            }
          ]
        },
        {
          "text": "?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.19",
            "verseOrgIds": [
              "1SA.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulo n'addamu Samwiri nti, \"Nagondedde eddoboozi lya",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.20",
            "verseOrgIds": [
              "1SA.15.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1SA.15.20",
