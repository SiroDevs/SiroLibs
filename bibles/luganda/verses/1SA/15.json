                "verseId": "1SA.15.26",
                "verseOrgIds": [
                  "1SA.15.26"
                ]
              }
            }
          ]
        },
        {
          "text": "akugaanye okuba kabaka wa Isirayiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.26",
            "verseOrgIds": [
              "1SA.15.26"
            ]
