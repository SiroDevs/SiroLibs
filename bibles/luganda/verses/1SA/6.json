              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1SA.6.20",
                "verseOrgIds": [
                  "1SA.6.20"
                ]
              }
            }
          ]
        },
        {
          "text": ", Katonda ono omutukuvu? Essanduuko ya",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.20",
            "verseOrgIds": [
              "1SA.6.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
