              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1SA.6.19",
                "verseOrgIds": [
                  "1SA.6.19"
                ]
              }
            }
          ]
        },
        {
          "text": ". Abantu ne banakuwala nnyo olw'ekibonerezo ekinene",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.19",
            "verseOrgIds": [
              "1SA.6.19"
            ]
          }
