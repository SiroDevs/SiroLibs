                "verseOrgIds": [
                  "1SA.6.20"
                ]
              }
            }
          ]
        },
        {
          "text": "tugiweereze ani?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.20",
            "verseOrgIds": [
              "1SA.6.20"
            ]
          }
        }
      ]
    },
