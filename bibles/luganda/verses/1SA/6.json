              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nsanvu ku basajja ab'e Besusemesi ne bafa kubanga balingiza mu ssanduuko ya",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.19",
            "verseOrgIds": [
