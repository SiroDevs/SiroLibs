          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "era abantu b'e Besusemesi ne beebuuza nti, \"Ani ayinza okuyimirira mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.20",
            "verseOrgIds": [
              "1SA.6.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
