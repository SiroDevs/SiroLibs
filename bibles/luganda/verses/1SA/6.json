              "type": "text"
            }
          ]
        },
        {
          "text": "Ne batuma ababaka eri abatuuze b'e Kiriyasuyalimu n'obubaka nti, \"Abafirisuuti bakomezzaawo essanduuko ya",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.21",
            "verseOrgIds": [
              "1SA.6.21"
            ]
