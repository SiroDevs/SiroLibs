                "verseOrgIds": [
                  "1SA.6.19"
                ]
              }
            }
          ]
        },
        {
          "text": "kye yabawa,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.19",
            "verseOrgIds": [
              "1SA.6.19"
            ]
          }
        },
