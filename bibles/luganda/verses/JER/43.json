  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "43",
        "style": "c",
        "sid": "JER 43"
      },
      "items": [
        {
          "text": "43",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 43:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeremiya bwe yamala okutegeeza abantu ebigambo byonna",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.1",
            "verseOrgIds": [
              "JER.43.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.43.1",
                "verseOrgIds": [
                  "JER.43.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda waabwe bye yamutuma okubagamba,",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.1",
            "verseOrgIds": [
              "JER.43.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 43:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azaliya mutabani wa Kosaaya ne Yokanaani mutabani wa Kaleya n'abasajja bonna ab'amalala ne bagamba Yeremiya nti, \"Olimba!",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.2",
            "verseOrgIds": [
              "JER.43.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.43.2",
                "verseOrgIds": [
                  "JER.43.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo takutumye kugamba nti, 'Temugenda Misiri kusenga eyo.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.2",
            "verseOrgIds": [
              "JER.43.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 43:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Baluki mutabani wa Neriya y'akusendasenda otugabule mu mukono gw'Abakaludaaya, batutte oba batutwale mu buwaŋŋanguse e Babulooni.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.3",
            "verseOrgIds": [
              "JER.43.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 43:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yokanaani mutabani wa Kaleya n'abaduumizi ba magye bonna n'abantu bonna ne bajeemera ekiragiro kya",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.4",
            "verseOrgIds": [
              "JER.43.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.43.4",
                "verseOrgIds": [
                  "JER.43.4"
                ]
              }
            }
          ]
        },
        {
          "text": "eky'okusigala mu nsi ya Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.4",
            "verseOrgIds": [
              "JER.43.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 43:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yokanaani mutabani wa Kaleya n'abaduumizi ba magye ga Yuda bonna ne bakulembera abantu ba Yuda abaali basigaddewo nga bakomyewo okuva mu mawanga gonna gye baali baddukidde okubeera mu nsi ya Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.5",
            "verseOrgIds": [
              "JER.43.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 43:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne batwala n'abasajja bonna, n'abakazi n'abaana n'abawala ba kabaka, Nebuzaladaani omuduumizi w'eggye lya kabaka w'e Babulooni be yali alekedde Gedaliya mutabani wa Akikamu, mutabani wa Safani, ne nnabbi Yeremiya ne Baluki mutabani wa Neriya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.6",
            "verseOrgIds": [
              "JER.43.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 43:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ne bayingira e Misiri nga bajeemedde",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.7",
            "verseOrgIds": [
              "JER.43.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.43.7",
                "verseOrgIds": [
                  "JER.43.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", ne bagenda okutuukira ddala e Tapaneese.",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.7",
            "verseOrgIds": [
              "JER.43.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 43:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe baba bali e Tapaneese, ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.8",
            "verseOrgIds": [
              "JER.43.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.43.8",
                "verseOrgIds": [
                  "JER.43.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ne kijjira Yeremiya nti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.8",
            "verseOrgIds": [
              "JER.43.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 43:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Twala amayinja amanene ogaziike mu bbumba mu lubalaza olw'amatoffaali ku mulyango gw'olubiri lwa Falaawo e Tapaneese, ng'Abayudaaya bonna balaba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.9",
            "verseOrgIds": [
              "JER.43.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 43:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obagambe nti, 'Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.10",
            "verseOrgIds": [
              "JER.43.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.43.10",
                "verseOrgIds": [
                  "JER.43.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Eggye, Katonda wa Isirayiri nti, Nditumya omuddu wange Nebukadduneeza kabaka w'e Babulooni, era nditeeka entebe ye ey'obwakabaka ku mayinja gano ge nziise wano. Ku go kwalikuba eweema ye ey'obwakabaka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.10",
            "verseOrgIds": [
              "JER.43.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 43:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alijja n'alumba Misiri, atte abo ab'okufa, awambe n'abo ab'okuwambibwa, n'ab'okuttibwa n'ekitala battibwe n'ekitala.",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.11",
            "verseOrgIds": [
              "JER.43.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 43:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alikoleeza omuliro ku masabo ga bakatonda b'e Misiri, n'abatwala mu busibe nga alese amasabo gaabwe agookezza. Ng'omulunzi w'endiga bwe yeezingirira ekyambalo kye, bw'atyo bw'alyezingirira ensi y'e Misiri n'avaayo nga tewali kabi konna kamutuuseeko.",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.12",
            "verseOrgIds": [
              "JER.43.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 43:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimenyamenya empagi ezaawongebwa mu ssabo ly'enjuba mu Misiri, n'ayokya n'amasabo ga bakatonda b'e Misiri.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.13",
            "verseOrgIds": [
              "JER.43.13"
            ]
          }
        }
      ]
    }
  ],
