                "verseOrgIds": [
                  "JER.29.32"
                ]
              }
            }
          ]
        },
        {
          "text": ".' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.32",
            "verseOrgIds": [
              "JER.29.32"
            ]
          }
        }
