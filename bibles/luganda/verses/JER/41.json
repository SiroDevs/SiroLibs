  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "41",
        "style": "c",
        "sid": "JER 41"
      },
      "items": [
        {
          "text": "41",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwezi ogw'omusanvu Isimayiri mutabani wa Nesaniya, mutabani wa Erisaama, omu ku balangira ate nga ye omu ku bakulu b'eggye lya Yuda n'ajja n'abasajja kkumi eri Gedaliya mutabani wa Akikamu e Mizupa. Bwe baali nga balya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.1",
            "verseOrgIds": [
              "JER.41.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isimayiri mutabani wa Nesaniya n'abasajja ekkumi abaali naye ne bayimuka ne batta Gedaliya, mutabani wa Akikamu, mutabani wa Safani, n'ekitala, gavana, kabaka w'e Babulooni gwe yali ataddewo okufuga mu nsi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.2",
            "verseOrgIds": [
              "JER.41.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isimayiri n'atta n'Abayudaaya bonna abaali ne Gedaliya e Mizupa, n'abaserikale Abakaludaaya abaaliyo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.3",
            "verseOrgIds": [
              "JER.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olunaku olwaddirira Gedaliya ng'amaze okuttibwa, nga tewannabaawo akimanyiiko,",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.4",
            "verseOrgIds": [
              "JER.41.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "abasajja kinaana abaali beemwedde ebirevu, nga bayuzizza engoye zaabwe era nga beesazeesaze, bajja okuva e Sekemu, ne Siiro ne Samaliya, nga baleese ekiweebwayo eky'emmere ey'empeke n'obubaane eby'omu nnyumba ya",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.5",
            "verseOrgIds": [
              "JER.41.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.41.5",
                "verseOrgIds": [
                  "JER.41.5"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.5",
            "verseOrgIds": [
              "JER.41.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isimayiri omwana wa Nesaniya n'ava e Mizupa okubasisinkana ng'agenda bw'akaaba. Bwe yabatuukako, n'abagamba nti, \"Mujje eri Gedaliya omwana wa Akikamu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.6",
            "verseOrgIds": [
              "JER.41.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe baatuuka mu kibuga, Isimayiri mutabani wa Nesaniya n'abasajja be ne batta abamu ku basajja abo, ne babasuula mu kinnya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.7",
            "verseOrgIds": [
              "JER.41.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye kkumi ku bo ne bagamba Isimayiri nti, \"Totutta! Tulina eŋŋaano ne sayiri, n'omuzigo, n'omubisi gw'enjuki, tubikwese mu nnimiro.\" Awo ne babaleka ne batabattira wamu na bali abalala.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.8",
            "verseOrgIds": [
              "JER.41.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekinnya mwe baasuula emirambo gy'abasajja bonna be battira awamu ne Gedaliya, kye kiri kabaka Asa kye yali asimye ng'alwanyisa Baasa kabaka wa Isirayiri. Isimayiri mutabani wa Nesaniya yakijjuza abafu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.9",
            "verseOrgIds": [
              "JER.41.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isimayiri n'awamba abantu bonna abalala abaali e Mizupa, abawala ba kabaka n'abalala bonna abaali basigaddeyo, Nebuzaladaani omuduumizi w'eggye lya kabaka Nebukadduneeza be yali awadde Gedaliya mutabani wa Akikamu. Isimayiri mutabani wa Nesaniya n'abatwala nga bawambe ne yeetegeka okubasomosa okubatwala eri Abamoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.10",
            "verseOrgIds": [
              "JER.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yokanaani mutabani wa Kaleya n'abaduumizi bonna abaali naye bwe baawulira ebikolobero Isimayiri mutabani wa Nesaniya bye yali akoze,",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.11",
            "verseOrgIds": [
              "JER.41.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne batwala abasajja baabwe bonna ne bagenda okulwanyisa Isimayiri mutabani wa Nesaniya. Ne bamutuukako okumpi n'amazzi amangi e Gibyoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.12",
            "verseOrgIds": [
              "JER.41.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bonna abaali ne Isimayiri bwe baalaba Yokanaani mutabani wa Kaleya n'abaduumizi ba magye be yali nabo, ne basanyuka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.13",
            "verseOrgIds": [
              "JER.41.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bonna Isimayiri be yali awambye e Mizupa ne bakyuka ne bagenda eri Yokanaani mutabani wa Kaleya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.14",
            "verseOrgIds": [
              "JER.41.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Isimayiri mutabani wa Nesaniya ne basajja be munaana ne batoloka okuva ku Yokanaani ne bagenda mu ba Amoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.15",
            "verseOrgIds": [
              "JER.41.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yokanaani mutabani wa Kaleya n'abaduumizi b'eggye bonna abaali naye ne batwala abawambe okuva e Mizupa be baali baggye ku Isimayiri mutabani wa Nesaniya ng'amaze okutta Gedaliya mutabani wa Akikamu: abaserikale, n'abakazi, n'abaana n'abakungu b'omu lubiri be yali aggye e Gibyoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.16",
            "verseOrgIds": [
              "JER.41.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne beeyongerayo ne bayimirirako e Gerusukimamu okumpi ne Besirekemu, nga boolekedde e Misiri,",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.17",
            "verseOrgIds": [
              "JER.41.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 41:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "badduke Abakaludaaya. Baali batidde Abakaludaaya kubanga Isimayiri mutabani wa Nesaniya yali asse Gedaliya mutabani wa Akikamu, oyo kabaka w'e Babulooni gwe yali ataddewo okufuga ensi nga gavana.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.18",
            "verseOrgIds": [
              "JER.41.18"
            ]
          }
        }
      ]
    }
  ],
