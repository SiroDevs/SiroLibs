      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'ati",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.1",
            "verseOrgIds": [
              "JER.13.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.1",
                "verseOrgIds": [
                  "JER.13.1"
                ]
              }
            }
          ]
        },
        {
          "text": "bwe yaŋŋamba nti, \"Genda ogule olukoba olwa linena olwesibe mu kiwato kyo, naye tolunnyikanga mu mazzi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.1",
            "verseOrgIds": [
              "JER.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe ntyo ne neegulira olukoba, nga",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.2",
            "verseOrgIds": [
              "JER.13.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.2",
                "verseOrgIds": [
                  "JER.13.2"
                ]
              }
            }
          ]
        },
        {
          "text": "bwe yandagira, ne ndwesiba mu kiwato kyange.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.2",
            "verseOrgIds": [
              "JER.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.3",
            "verseOrgIds": [
              "JER.13.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.3",
                "verseOrgIds": [
                  "JER.13.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ne kinzijira omulundi ogwokubiri",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.3",
            "verseOrgIds": [
              "JER.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nti, \"Ddira olukoba lwe wagula lwe weesibye mu kiwato kyo ogende ku mabbali g'omugga Fulaati olukweke eyo mu lwatika lw'olwazi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.4",
            "verseOrgIds": [
              "JER.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe ntyo ne ŋŋenda ne ndukweka ku mabbali g'omugga Fulaati nga",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.5",
            "verseOrgIds": [
              "JER.13.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.5",
                "verseOrgIds": [
                  "JER.13.5"
                ]
              }
            }
          ]
        },
        {
          "text": "bwe yandagira.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.5",
            "verseOrgIds": [
              "JER.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ennaku nnyingi nga ziyiseewo, ate",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.6",
            "verseOrgIds": [
              "JER.13.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.6",
                "verseOrgIds": [
                  "JER.13.6"
                ]
              }
            }
          ]
        },
        {
          "text": "nandagira nti, \"Genda kaakano ku Fulaati oleete olukoba lwe nakulagira okukwekayo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.6",
            "verseOrgIds": [
              "JER.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ne ndyoka ŋŋenda ku mugga Fulaati, ne nsimulayo olukoba ne nduggya mu kifo we nnali ndukwese. Naye laba, olukoba lwali lwonoonese, nga terukyalina kye lugasa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.7",
            "verseOrgIds": [
              "JER.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.8",
            "verseOrgIds": [
              "JER.13.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.8",
                "verseOrgIds": [
                  "JER.13.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ne kinzijira nga kyogera nti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.8",
            "verseOrgIds": [
              "JER.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.9",
            "verseOrgIds": [
              "JER.13.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.9",
                "verseOrgIds": [
                  "JER.13.9"
                ]
              }
            }
          ]
        },
        {
          "text": "nti, 'Bwe ntyo bwe ndikkakkanya okwegulumiza kwa Yuda ne Yerusaalemi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.9",
            "verseOrgIds": [
              "JER.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bano aboonoonyi abagaana okukwata ebigambo byange, abagoberera obujeemu bw'emitima gyabwe ne bagoberera bakatonda abalala okubaweereza n'okubasinza, bajja kuba ng'olukoba olwo olutaliiko kye lugasa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.10",
            "verseOrgIds": [
              "JER.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'olukoba bwe lunywerera mu kiwato ky'omuntu, bwe ntyo bwe nzija okwagala ennyumba ya Isirayiri yonna n'eya Yuda zinneesibeko,' bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.11",
            "verseOrgIds": [
              "JER.13.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.11",
                "verseOrgIds": [
                  "JER.13.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", 'balyoke babeere abantu bange, bagulumize erinnya lyange n'ettendo; naye bo ne batawulira.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.11",
            "verseOrgIds": [
              "JER.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Olugero lw'Ekita",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bagambe bw'oti nti, 'Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.12",
            "verseOrgIds": [
              "JER.13.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.12",
                "verseOrgIds": [
                  "JER.13.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wa Isirayiri, buli kita kiba kya kujjuza nvinnyo.' Nabo balikuddamu nti, 'Tetumanyi nga buli kita kiba kya kujjuza nvinnyo?'",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.12",
            "verseOrgIds": [
              "JER.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwo olyoke obagambe nti, 'Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.13",
            "verseOrgIds": [
              "JER.13.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.13",
                "verseOrgIds": [
                  "JER.13.13"
                ]
              }
            }
          ]
        },
        {
          "text": "nti, Laba nditamiiza abantu bonna abatuula mu nsi eno, ne bakabaka abatuula ku ntebe ya Dawudi ey'obwakabaka, ne bakabona, ne bannabbi n'abantu bonna ab'omu Yerusaalemi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.13",
            "verseOrgIds": [
              "JER.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era buli omu alikoonagana ne munne, abalenzi ne bakitaabwe, bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.14",
            "verseOrgIds": [
              "JER.13.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.14",
                "verseOrgIds": [
                  "JER.13.14"
                ]
              }
            }
          ]
        },
        {
          "text": ". Siribalumirwa, wadde okubaleka oba okubakwatirwa ekisa, ndibazikiriza.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.14",
            "verseOrgIds": [
              "JER.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amalala n'Okuswazibwa kwa Yerusaalemi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuliriza ontegere okutu;",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.15",
            "verseOrgIds": [
              "JER.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:15"
      },
      "items": [
        {
          "text": "toba na malala,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.15",
            "verseOrgIds": [
              "JER.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:15"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.15",
                "verseOrgIds": [
                  "JER.13.15"
                ]
              }
            }
          ]
        },
        {
          "text": "y'akyogedde.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.15",
            "verseOrgIds": [
              "JER.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.16",
                "verseOrgIds": [
                  "JER.13.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.16",
            "verseOrgIds": [
              "JER.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:16"
      },
      "items": [
        {
          "text": "mugulumize nga tannaleeta kizikiza,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.16",
            "verseOrgIds": [
              "JER.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 13:16"
      },
      "items": [
        {
          "text": "nga ebigere byo tebinneesittala ku nsozi",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.16",
            "verseOrgIds": [
              "JER.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:16"
      },
      "items": [
        {
          "text": "ezikutte ekizikiza.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.16",
            "verseOrgIds": [
              "JER.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 13:16"
      },
      "items": [
        {
          "text": "Musuubira ekitangaala,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.16",
            "verseOrgIds": [
              "JER.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
