    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yeremiya Abuulira mu Yeekaalu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kino kye kigambo ekyajjira Yeremiya okuva eri",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.1",
            "verseOrgIds": [
              "JER.7.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.1",
                "verseOrgIds": [
                  "JER.7.1"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.1",
            "verseOrgIds": [
              "JER.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yimirira ku mulyango gw'ennyumba ya",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.2",
            "verseOrgIds": [
              "JER.7.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.2",
                "verseOrgIds": [
                  "JER.7.2"
                ]
              }
            }
          ]
        },
        {
          "text": "otegeeze abantu obubaka buno.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.2",
            "verseOrgIds": [
              "JER.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JER 7:2"
      },
      "items": [
        {
          "text": "Muwuliriza ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.2",
            "verseOrgIds": [
              "JER.7.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.2",
                "verseOrgIds": [
                  "JER.7.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", mmwe mwenna abantu ba Yuda abayita mu miryango gino okusinza",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.2",
            "verseOrgIds": [
              "JER.7.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.2",
                "verseOrgIds": [
                  "JER.7.2"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.2",
            "verseOrgIds": [
              "JER.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.3",
            "verseOrgIds": [
              "JER.7.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.3",
                "verseOrgIds": [
                  "JER.7.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Eggye, Katonda wa Isirayiri nti, \"Mulongoose amakubo gammwe n'ebikolwa byammwe, nange ndibalekera ekifo kino ne mubeeramu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.3",
            "verseOrgIds": [
              "JER.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teweesiga bigambo bino ebibuzaabuza ne mwogera nti, 'Eno ye yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.4",
            "verseOrgIds": [
              "JER.7.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.4",
                "verseOrgIds": [
                  "JER.7.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.4",
            "verseOrgIds": [
              "JER.7.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.4",
                "verseOrgIds": [
                  "JER.7.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.4",
            "verseOrgIds": [
              "JER.7.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.4",
                "verseOrgIds": [
                  "JER.7.4"
                ]
              }
            }
          ]
        },
        {
          "text": "!'",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.4",
            "verseOrgIds": [
              "JER.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga bwe munaalongoosezanga ddala amakubo gammwe n'ebikolwa byammwe; era bwe munaalaganga obwenkanya eri omuntu ne munne,",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.5",
            "verseOrgIds": [
              "JER.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne mulekayo okunyigiriza omugwira, ne mulekwa, ne nnamwandu, ne mulekayo n'okutta abataliiko musango mu kifo ekyo, era ne mutasinza bakatonda abalala okwereetera emisango mmwe bennyini,",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.6",
            "verseOrgIds": [
              "JER.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kale ndibatuuza mu kifo ekyo mu nsi gye nawa bajjajjammwe ebeere yammwe emirembe n'emirembe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.7",
            "verseOrgIds": [
              "JER.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale laba, mwesiga ebigambo ebitaliimu, ebitagasa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.8",
            "verseOrgIds": [
              "JER.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Munabba ne mutta, ne mukola obwenzi ne mulayira eby'obulimba, ne mwoteza obubaane eri Baali, ne mutambula okugoberera bakatonda abalala be mutamanyanga;",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.9",
            "verseOrgIds": [
              "JER.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne mulyoka mujja ne muyimirira mu maaso gange mu nnyumba eno, eyitibwa Erinnya lyange, ne mugamba nti, 'Tuli bulungi, tuli bulungi,' ne mulyoka mukola eby'emizizo byonna?",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.10",
            "verseOrgIds": [
              "JER.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulowooza nti ennyumba eno eyitibwa ennyumba yange, mpuku y'abanyazi? Laba, nze kennyini nkirabye,\" bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.11",
            "verseOrgIds": [
              "JER.7.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.11",
                "verseOrgIds": [
                  "JER.7.11"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.11",
            "verseOrgIds": [
              "JER.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mugende kaakano mu kifo kyange ekyali e Siiro ekifo gye nasooka okuteeka essinzizo ly'erinnya lyange, mulabe kye nakikola olw'ekibi ky'abantu bange Isirayiri.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.12",
            "verseOrgIds": [
              "JER.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.13",
            "verseOrgIds": [
              "JER.7.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.13",
                "verseOrgIds": [
                  "JER.7.13"
                ]
              }
            }
          ]
        },
        {
          "text": "nti, Bwe mwali mukola ebintu bino byonna, nayogera nammwe emirundi mingi naye ne mutampulira; nabakoowoola ne mutampitaba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.13",
            "verseOrgIds": [
              "JER.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo, ekyo kye nakola e Siiro nzija kukikola kaakano ku nnyumba eyitibwa Erinnya lyange, era gye mwesiga, era n'ebifo bye nabawa mmwe ne bakitammwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.14",
            "verseOrgIds": [
              "JER.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndibagoba ne mu maaso gange, nga bwe nagoba baganda bammwe bonna, ezzadde lya Efulayimu lyonna.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.15",
            "verseOrgIds": [
              "JER.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Noolwekyo tosabira bantu abo wadde okubegayiririra newaakubadde okubasabira oba okubawolereza, kubanga siikuwulire.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.16",
            "verseOrgIds": [
              "JER.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolaba bye bakola mu bibuga bya Yuda era ne mu nguudo za Yerusaalemi?",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.17",
            "verseOrgIds": [
              "JER.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana balonda enku, bakitaabwe ne bakuma omuliro, olwo abakazi ne bakanda eŋŋaano ne bakolera kabaka w'eggulu omukazi emigaati. Bafuka ekiweebwayo ekyokunywa eri bakatonda abalala okunkwasa obusungu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.18",
            "verseOrgIds": [
              "JER.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nze gwe balumya?\" bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.19",
            "verseOrgIds": [
              "JER.7.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.19",
                "verseOrgIds": [
                  "JER.7.19"
                ]
              }
            }
          ]
        },
        {
          "text": ". \"Tebeerumya bokka, ne beeswazaswaza?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.19",
            "verseOrgIds": [
              "JER.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo bw'atyo bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.20",
            "verseOrgIds": [
              "JER.7.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.20",
                "verseOrgIds": [
                  "JER.7.20"
                ]
              }
            }
          ]
        },
        {
          "text": "nti, \"Laba obusungu bwange n'ekiruyi kyange bijja kufukibwa ku kifo kino, ku bantu ne ku nsolo, ku miti egy'omu ttale era ne ku bibala eby'omu ttaka; bujja kubuubuuka era tebujja kukoma.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.20",
            "verseOrgIds": [
              "JER.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okugaana Okuwulira Bannabbi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.21",
            "verseOrgIds": [
              "JER.7.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.21",
                "verseOrgIds": [
                  "JER.7.21"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Eggye, Katonda wa Isirayiri nti, Mugatte ebiweebwayo byammwe ebyokebwa ku ssaddaaka zammwe, ennyama mugyeriire.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.21",
            "verseOrgIds": [
              "JER.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga ku lunaku lwe nabaggya mu Misiri saayogera eri bakitammwe wadde okubalagira ebikwata ku biweebwayo ebyokebwa wadde ssaddaaka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.22",
            "verseOrgIds": [
              "JER.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye etteeka lino lye nabawa ligamba nti, 'Muŋŋondere, nange nnaabeera Katonda wammwe, nammwe munaabeera bantu bange. Mutambulire mu makubo gonna ge mbalagira, mulyoke mubeere bulungi.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.23",
            "verseOrgIds": [
              "JER.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye tebampulira wadde okunzisaako omwoyo, wabula bagoberera okuteesa kw'emitima gyabwe egijjudde ebibi. Badda emabega so tebaalaga mu maaso.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.24",
            "verseOrgIds": [
              "JER.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okuva mu biseera bajjajjammwe bye baaviiramu e Misiri okutuusa kaakano, mbadde mpeereza abaddu bange bannabbi emirundi n'emirundi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.25",
            "verseOrgIds": [
              "JER.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye tebampuliriza wadde okunzisaako omwoyo, bakakanyaza ensingo zaabwe era ne bakola ebibi ne basinga ne bajjajjaabwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.26",
            "verseOrgIds": [
              "JER.7.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kale ojja kubagamba bino byonna naye tebajja kukuwuliriza, bw'onoobayita tebajja kukwanukula.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.27",
            "verseOrgIds": [
              "JER.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo bagambe nti, 'Lino ly'eggwanga eritagondera",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.28",
            "verseOrgIds": [
              "JER.7.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.28",
                "verseOrgIds": [
                  "JER.7.28"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda waalyo oba okufaayo ku kugololwa. Amazima gabulawo, tegali ku mimwa gyabwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.28",
            "verseOrgIds": [
              "JER.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salako enviiri zo ggwe Yerusaalemi, ozisuule wala ddala okaabire ku ntikko z'ensozi, kubanga",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.29",
            "verseOrgIds": [
              "JER.7.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.29",
                "verseOrgIds": [
                  "JER.7.29"
                ]
              }
            }
          ]
        },
        {
          "text": "alese abantu be era n'asuula ab'omu mulembe guno mw'asunguwalidde ennyo.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.29",
            "verseOrgIds": [
              "JER.7.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekiwonvu eky'Okufiiramu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Abantu ba Yuda bakoze ekintu eky'ekivve mu maaso gange, bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.30",
            "verseOrgIds": [
              "JER.7.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.30",
                "verseOrgIds": [
                  "JER.7.30"
                ]
              }
            }
          ]
        },
        {
          "text": ". Batadde bakatonda abalala mu nnyumba yange eyitibwa erinnya lyange ne bagyonoona.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.30",
            "verseOrgIds": [
              "JER.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazimbye ebifo ebigulumivu ebya Tofesi mu kiwonvu kya mutabani wa Kinomu ne bassaddaakiramu batabani baabwe be bazaala n'abawala, kye saalowoozaako wadde okukibalagira.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.31",
            "verseOrgIds": [
              "JER.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laba, ennaku zijja,\" bw'atyo bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.32",
            "verseOrgIds": [
              "JER.7.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.32",
                "verseOrgIds": [
                  "JER.7.32"
                ]
              }
            }
          ]
        },
        {
          "text": ", bwe kitariyitibwa Kiwonvu kya Tofesi oba ekya Kinnomu ne kiyitibwa Kiwonvu kya ttambiro: kubanga baliziikamu Tofesi okutuusa we wataliba bbanga lya kuziikamu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.32",
            "verseOrgIds": [
              "JER.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era emirambo gy'abantu bano gifuuke emmere y'ebinyonyi eby'omu bbanga era n'ensolo ez'omu nsiko, era waleme kubaawo muntu wakuzigoba;",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.33",
            "verseOrgIds": [
              "JER.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "olwo nga nkomezza amaloboozi ag'okusanyuka n'okujaguza, n'eddoboozi ly'omusajja awasa n'ery'omugole we mu bibuga bya Yuda ne mu nguudo za Yerusaalemi, olwo ensi ng'efuuse matongo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.34",
            "verseOrgIds": [
              "JER.7.34"
            ]
          }
        }
      ]
    }
