          "type": "text",
          "attrs": {
            "verseId": "HOS.5.8",
            "verseOrgIds": [
              "HOS.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:8"
