        {
          "text": "Efulayimu alifuuka matongo",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.9",
            "verseOrgIds": [
              "HOS.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 5:9"
      },
      "items": [
        {
          "text": "ku lunaku olw'okubonerezebwa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.9",
            "verseOrgIds": [
              "HOS.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 5:9"
      },
      "items": [
