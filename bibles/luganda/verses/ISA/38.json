  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "38",
        "style": "c",
        "sid": "ISA 38"
      },
      "items": [
        {
          "text": "38",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okusaba Kwa Keezeekiya ng'Alwadde",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 38:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu nnaku ezo Keezeekiya n'alwala nnyo, katono afe. Nnabbi Isaaya mutabani wa Amozi n'ajja gy'ali n'amugamba nti, \"Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.1",
            "verseOrgIds": [
              "ISA.38.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.1",
                "verseOrgIds": [
                  "ISA.38.1"
                ]
              }
            }
          ]
        },
        {
          "text": "nti, Teekateeka ennyumba yo, kubanga togenda kulama, ogenda kufa.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.1",
            "verseOrgIds": [
              "ISA.38.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 38:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Keezeekiya n'akyuka n'atunuulira ekisenge n'asaba ne yeegayirira",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.2",
            "verseOrgIds": [
              "ISA.38.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.2",
                "verseOrgIds": [
                  "ISA.38.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.2",
            "verseOrgIds": [
              "ISA.38.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ng'agamba nti, \"Jjukira kaakano, Ayi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.3",
            "verseOrgIds": [
              "ISA.38.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.3",
                "verseOrgIds": [
                  "ISA.38.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", nkwegayiridde, engeri gye natambuliranga mu maaso go n'amazima n'omutima ogutuukiridde, ne nkola ebisaanidde mu maaso go.\" Era Keezeekiya n'akaaba nnyo amaziga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.3",
            "verseOrgIds": [
              "ISA.38.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Ekigambo kya Katonda ne kijja eri Isaaya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.4",
            "verseOrgIds": [
              "ISA.38.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nga",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.5",
            "verseOrgIds": [
              "ISA.38.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.5",
                "verseOrgIds": [
                  "ISA.38.5"
                ]
              }
            }
          ]
        },
        {
          "text": "agamba nti, \"Genda ogambe Keezeekiya nti, 'Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.5",
            "verseOrgIds": [
              "ISA.38.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.5",
                "verseOrgIds": [
                  "ISA.38.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wa Dawudi kitaawo nti, Mpulidde okusaba kwo, ndabye amaziga go: laba nzija kwongera ku nnaku zo emyaka kkumi n'ettaano.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.5",
            "verseOrgIds": [
              "ISA.38.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era ndikuwonya ggwe n'ekibuga kino mu mukono gwa kabaka w'e Bwasuli: Era ndikuuma ekibuga kino.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.6",
            "verseOrgIds": [
              "ISA.38.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Era kano ke kabonero k'onoofuna okuva eri",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.7",
            "verseOrgIds": [
              "ISA.38.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.7",
                "verseOrgIds": [
                  "ISA.38.7"
                ]
              }
            }
          ]
        },
        {
          "text": "nti",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.7",
            "verseOrgIds": [
              "ISA.38.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.7",
                "verseOrgIds": [
                  "ISA.38.7"
                ]
              }
            }
          ]
        },
        {
          "text": "alikola ekigambo ky'ayogedde.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.7",
            "verseOrgIds": [
              "ISA.38.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laba nzija kuzza emabega ekisiikirize ebigere kkumi enjuba bw'eneeba egwa, ky'eneekola ku madaala kabaka Akazi ge yazimba.' \" Bw'etyo enjuba n'edda emabega ebigere kkumi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.8",
            "verseOrgIds": [
              "ISA.38.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Keezeekiya Kabaka wa Yuda bwe yassuuka, n'awandiika ebigambo bino;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.9",
            "verseOrgIds": [
              "ISA.38.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nayogera nti, \"Mu maanyi g'obulamu bwange",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.10",
            "verseOrgIds": [
              "ISA.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:10"
      },
      "items": [
        {
          "text": "mwe nnali ŋŋenda okufiira nnyingire mu miryango gy'emagombe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.10",
            "verseOrgIds": [
              "ISA.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:10"
      },
      "items": [
        {
          "text": "nga simazeeyo myaka gyange egisigaddeyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.10",
            "verseOrgIds": [
              "ISA.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ndyoka njogera nti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.11",
            "verseOrgIds": [
              "ISA.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:11"
      },
      "items": [
        {
          "text": "\"Sigenda kuddayo kulaba",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.11",
            "verseOrgIds": [
              "ISA.38.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.11",
                "verseOrgIds": [
                  "ISA.38.11"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.11",
            "verseOrgIds": [
              "ISA.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 38:11"
      },
      "items": [
        {
          "text": "mu nsi y'abalamu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.11",
            "verseOrgIds": [
              "ISA.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:11"
      },
      "items": [
        {
          "text": "Sikyaddamu kulaba bantu mu nsi abantu mwe babeera.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.11",
            "verseOrgIds": [
              "ISA.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 38:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obulamu bwange buzingiddwako",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.12",
            "verseOrgIds": [
              "ISA.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:12"
      },
      "items": [
        {
          "text": "ng'eweema y'omusumba w'endiga bw'enzigibwako.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.12",
            "verseOrgIds": [
              "ISA.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 38:12"
      },
      "items": [
        {
          "text": "Ng'olugoye lwe babadde balanga ate ne balusala ku muti kwe babadde balulukira,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.12",
            "verseOrgIds": [
              "ISA.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:12"
      },
      "items": [
        {
          "text": "bwe ntyo bwe nawuliranga emisana n'ekiro nga obulamu bwange",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.12",
            "verseOrgIds": [
              "ISA.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:12"
      },
      "items": [
        {
          "text": "obumalirawo ddala.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.12",
            "verseOrgIds": [
              "ISA.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiro kyonna nakaabanga olw'obulumi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.13",
            "verseOrgIds": [
              "ISA.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:13"
      },
      "items": [
        {
          "text": "nga ndi ng'empologoma gw'emmenyaamenya amagumba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.13",
            "verseOrgIds": [
              "ISA.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:13"
      },
      "items": [
        {
          "text": "ekiro n'emisana nga ndowooza nga",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.13",
            "verseOrgIds": [
              "ISA.38.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.38.13",
                "verseOrgIds": [
                  "ISA.38.13"
                ]
              }
            }
          ]
        },
        {
          "text": "yali amalawo obulamu bwange.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.13",
            "verseOrgIds": [
              "ISA.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 38:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaabanga ng'akasanke oba akataayi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.14",
            "verseOrgIds": [
              "ISA.38.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:14"
      },
      "items": [
        {
          "text": "n'empuubaala ng'enjiibwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.14",
            "verseOrgIds": [
              "ISA.38.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 38:14"
      },
      "items": [
        {
          "text": "amaaso gange ne ganfuyirira olw'okutunula mu bbanga eri eggulu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.14",
            "verseOrgIds": [
              "ISA.38.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 38:14"
      },
      "items": [
        {
          "text": "Ne nkaaba nti, Ayi Mukama, nga nnyigirizibwa, nziruukirira.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.14",
            "verseOrgIds": [
              "ISA.38.14"
