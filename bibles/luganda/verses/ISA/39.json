          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Keezeekiya n'agamba Isaaya nti, \"Ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.8",
            "verseOrgIds": [
              "ISA.39.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.39.8",
                "verseOrgIds": [
                  "ISA.39.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ky'oŋŋambye kirungi.\" Kubanga yalowooza nti, \"Kasita emirembe, n'obutebenkevu binaabangawo mu mulembe gwange.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.8",
            "verseOrgIds": [
              "ISA.39.8"
            ]
          }
        }
