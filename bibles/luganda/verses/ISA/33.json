      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:2"
      },
      "items": [
        {
          "text": "obulokozi bwaffe mu biro eby'okulabiramu ennaku.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.2",
            "verseOrgIds": [
              "ISA.33.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
