          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zikusanze ggwe omuzikiriza",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.1",
            "verseOrgIds": [
              "ISA.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:1"
      },
      "items": [
        {
          "text": "ggwe atazikirizibwanga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.1",
            "verseOrgIds": [
              "ISA.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 33:1"
      },
      "items": [
        {
          "text": "Zikusanze ggwe alya olukwe mu balala,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.1",
            "verseOrgIds": [
              "ISA.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:1"
      },
      "items": [
        {
          "text": "ggwe, gwe batalyangamu lukwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.1",
            "verseOrgIds": [
              "ISA.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 33:1"
      },
      "items": [
        {
          "text": "bw'olirekaraawo okuzikiriza,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.1",
            "verseOrgIds": [
              "ISA.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:1"
      },
      "items": [
        {
          "text": "olizikirizibwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.1",
            "verseOrgIds": [
              "ISA.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 33:1"
      },
      "items": [
        {
          "text": "Bw'olirekeraawo okulya mu balala olukwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.1",
            "verseOrgIds": [
              "ISA.33.1"
            ]
          }
        }
      ]
    },
