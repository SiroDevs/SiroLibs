          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y'aliba omusingi omugumu mu biro byo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.6",
            "verseOrgIds": [
              "ISA.33.6"
            ]
          }
        }
