                "verseId": "ISA.33.2",
                "verseOrgIds": [
                  "ISA.33.2"
                ]
              }
            }
          ]
        },
        {
          "text": "tusaasire,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.2",
            "verseOrgIds": [
              "ISA.33.2"
            ]
          }
