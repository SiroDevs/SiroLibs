      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:1"
      },
      "items": [
        {
          "text": "balikulyamu olukwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.1",
            "verseOrgIds": [
              "ISA.33.1"
            ]
          }
        }
      ]
    },
