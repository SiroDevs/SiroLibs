              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu baligendayo na busaale na mitego, kubanga ensi yonna eriba efuuse myeramannyo na maggwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.24",
