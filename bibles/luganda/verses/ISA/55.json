    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abalumwa Ennyonta Bayitibwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 55:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kale mujje,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.1",
            "verseOrgIds": [
              "ISA.55.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:1"
      },
      "items": [
        {
          "text": "mmwe mwenna abalumwa ennyonta, mujje eri amazzi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.1",
            "verseOrgIds": [
              "ISA.55.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:1"
      },
      "items": [
        {
          "text": "Mujje mmwe abatalina ssente zigula,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.1",
            "verseOrgIds": [
              "ISA.55.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:1"
      },
      "items": [
        {
          "text": "mujje muweebwe bye mwagala,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.1",
            "verseOrgIds": [
              "ISA.55.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:1"
      },
      "items": [
        {
          "text": "envinnyo oba amata ebitali bya kugula",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.1",
            "verseOrgIds": [
              "ISA.55.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:1"
      },
      "items": [
        {
          "text": "ebitaliiko miwendo gya kusasula.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.1",
            "verseOrgIds": [
              "ISA.55.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 55:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwaki musaasaanya ensimbi zammwe ku ebyo ebitali bya kulya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.2",
            "verseOrgIds": [
              "ISA.55.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:2"
      },
      "items": [
        {
          "text": "muteganira ebyo ebitakkusa?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.2",
            "verseOrgIds": [
              "ISA.55.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:2"
      },
      "items": [
        {
          "text": "Mumpulirize, mumpulirize n'obwegendereza mulye ebyo ebirungi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.2",
            "verseOrgIds": [
              "ISA.55.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:2"
      },
      "items": [
        {
          "text": "emmeeme yammwe eneesanyuka nnyo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.2",
            "verseOrgIds": [
              "ISA.55.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 55:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumpulirize mujje gye ndi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.3",
            "verseOrgIds": [
              "ISA.55.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:3"
      },
      "items": [
        {
          "text": "Muwulirize mubeere balamu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.3",
            "verseOrgIds": [
              "ISA.55.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:3"
      },
      "items": [
        {
          "text": "nnaabakolera endagaano ey'olubeerera,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.3",
            "verseOrgIds": [
              "ISA.55.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:3"
      },
      "items": [
        {
          "text": "era egyo gy'emikisa gyange n'okwagala bye nasuubiza Dawudi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.3",
            "verseOrgIds": [
              "ISA.55.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 55:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laba namufuula omujulirwa eri abantu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.4",
            "verseOrgIds": [
              "ISA.55.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:4"
      },
      "items": [
        {
          "text": "omukulembeze era omugabe w'abantu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.4",
            "verseOrgIds": [
              "ISA.55.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 55:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laba oliyita amawanga g'otomanyi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.5",
            "verseOrgIds": [
              "ISA.55.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:5"
      },
      "items": [
        {
          "text": "era amawanga g'otomanyi galyanguwa okujja gy'oli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.5",
            "verseOrgIds": [
              "ISA.55.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:5"
      },
      "items": [
        {
          "text": "Kiribaawo olw'obuyinza bwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.5",
            "verseOrgIds": [
              "ISA.55.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.55.5",
                "verseOrgIds": [
                  "ISA.55.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.5",
            "verseOrgIds": [
              "ISA.55.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:5"
      },
      "items": [
        {
          "text": "era Omutukuvu wa Isirayiri",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.5",
            "verseOrgIds": [
              "ISA.55.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:5"
      },
      "items": [
        {
          "text": "kubanga akugulumizza.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.5",
            "verseOrgIds": [
              "ISA.55.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 55:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munoonye",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.6",
            "verseOrgIds": [
              "ISA.55.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.55.6",
                "verseOrgIds": [
                  "ISA.55.6"
                ]
              }
            }
          ]
        },
        {
          "text": "nga bw'akyayinzika okulabika,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.6",
            "verseOrgIds": [
              "ISA.55.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:6"
      },
      "items": [
        {
          "text": "mumukaabirire nga bw'akyali okumpi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.6",
            "verseOrgIds": [
              "ISA.55.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 55:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omubi aleke ekkubo lye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.7",
            "verseOrgIds": [
              "ISA.55.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:7"
      },
      "items": [
        {
          "text": "n'atali mutuukirivu aleke ebirowoozo bye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.7",
            "verseOrgIds": [
              "ISA.55.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:7"
      },
      "items": [
        {
          "text": "Leka adde eri",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.7",
            "verseOrgIds": [
              "ISA.55.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.55.7",
                "verseOrgIds": [
                  "ISA.55.7"
                ]
              }
            }
          ]
        },
        {
          "text": "naye anaamusaasira, adde eri Katonda waffe",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.7",
            "verseOrgIds": [
              "ISA.55.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:7"
      },
      "items": [
        {
          "text": "kubanga anaamusonyiyira ddala.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.7",
            "verseOrgIds": [
              "ISA.55.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 55:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kubanga ebirowoozo byange si birowoozo byammwe",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.8",
            "verseOrgIds": [
              "ISA.55.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:8"
      },
      "items": [
        {
          "text": "era n'amakubo gammwe si ge makubo gange,\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.8",
            "verseOrgIds": [
              "ISA.55.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:8"
      },
      "items": [
        {
          "text": "bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.8",
            "verseOrgIds": [
              "ISA.55.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.55.8",
                "verseOrgIds": [
                  "ISA.55.8"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.8",
            "verseOrgIds": [
              "ISA.55.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 55:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ng'eggulu bwe liri waggulu okukira n'ensi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.9",
            "verseOrgIds": [
              "ISA.55.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:9"
      },
      "items": [
        {
          "text": "bwe gatyo amakubo gange bwe gali ewala ennyo n'amakubo gammwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.9",
            "verseOrgIds": [
              "ISA.55.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:9"
      },
      "items": [
        {
          "text": "n'ebirowoozo byange bwe biri eri ebirowoozo byammwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.9",
            "verseOrgIds": [
              "ISA.55.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 55:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era ng'enkuba bwetonnya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.10",
            "verseOrgIds": [
              "ISA.55.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:10"
      },
      "items": [
        {
          "text": "n'omuzira ne gugwa okuva mu ggulu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.10",
            "verseOrgIds": [
              "ISA.55.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:10"
      },
      "items": [
        {
          "text": "n'ebitaddayo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.10",
            "verseOrgIds": [
              "ISA.55.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:10"
      },
      "items": [
        {
          "text": "wabula ne bifukirira ettaka, ebirime ne bikula,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.10",
            "verseOrgIds": [
              "ISA.55.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:10"
      },
