              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiseera eky'okuwona bwe kyatuuka n'alabika nga wakuzaala balongo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.27",
            "verseOrgIds": [
              "GEN.38.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 38:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era bwe yali mu ssanya omulongo omu n'afulumya omukono gwe, omuzaalisa n'agukwata n'agusibako akawuzi akaakakobe nga bw'agamba nti, \"Ono y'asoose okujja.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.28",
            "verseOrgIds": [
              "GEN.38.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 38:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omulongo bwe yazzaayo omukono gwe munda, muganda we n'afuluma; omuzaalisa n'agamba nti, \"Lwaki owaguzza?\" Erinnya ly'omwana kyeryava liba Pereezi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.29",
            "verseOrgIds": [
              "GEN.38.29"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.29",
            "verseOrgIds": [
              "GEN.38.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 38:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oluvannyuma muganda we n'afuluma n'akawuzi akaakakobe nga kali ku mukono gwe, n'ayitibwa Zeera.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.30",
            "verseOrgIds": [
              "GEN.38.30"
            ]
          }
        }
