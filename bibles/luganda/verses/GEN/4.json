  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "GEN 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kayini ne Aberi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adamu n'amanya Kaawa, mukazi we, n'aba olubuto n'azaala Kayini n'agamba nti, \"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.1",
            "verseOrgIds": [
              "GEN.4.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.4.1",
                "verseOrgIds": [
                  "GEN.4.1"
                ]
              }
            }
          ]
        },
        {
          "text": "annyambye nzadde omuntu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.1",
            "verseOrgIds": [
              "GEN.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oluvannyuma n'azaala muganda we Aberi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.2",
            "verseOrgIds": [
              "GEN.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 4:2"
      },
      "items": [
        {
          "text": "Aberi n'aba mulunzi, ye Kayini n'abeera mulimi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.2",
            "verseOrgIds": [
              "GEN.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ennaku bwe zaayitawo Kayini n'alyoka aleeta ebibala by'ebimera ebyava mu ttaka okubiwaayo eri",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.3",
            "verseOrgIds": [
              "GEN.4.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.4.3",
                "verseOrgIds": [
                  "GEN.4.3"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.3",
            "verseOrgIds": [
              "GEN.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aberi naye n'aleeta ku baana b'endiga ze ababereberye n'amasavu gaazo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.4",
            "verseOrgIds": [
              "GEN.4.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.4.4",
                "verseOrgIds": [
                  "GEN.4.4"
                ]
              }
            }
          ]
        },
        {
          "text": "n'asiima Aberi n'ekiweebwayo kye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.4",
            "verseOrgIds": [
              "GEN.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye teyasiima Kayini wadde ekiweebwayo kye. Awo Kayini n'asunguwala nnyo, n'endabika y'amaaso ge n'ewaanyisibwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.5",
            "verseOrgIds": [
              "GEN.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.4.6",
                "verseOrgIds": [
                  "GEN.4.6"
                ]
              }
            }
          ]
        },
        {
          "text": "n'abuuza Kayini nti, \"Osunguwalidde ki? Era n'endabika y'amaaso go lwaki ewaanyisiddwa?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.6",
            "verseOrgIds": [
              "GEN.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'onookolanga obulungi tokkirizibwenga? Naye bw'otokole bulungi ekibi, kiri kumpi naawe, nga kikulindiridde, naye oteekwa okukiwangula.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.7",
            "verseOrgIds": [
              "GEN.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kayini atta Aberi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kayini n'agamba Aberi muganda we nti, \"Tulageko mu nnimiro.\" Bwe baali nga bali mu nnimiro Kayini n'agolokokera ku muganda we Aberi, n'amutta.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.8",
            "verseOrgIds": [
              "GEN.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.9",
            "verseOrgIds": [
              "GEN.4.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.4.9",
                "verseOrgIds": [
                  "GEN.4.9"
                ]
              }
            }
          ]
        },
        {
          "text": "n'abuuza Kayini nti, \"Muganda wo Aberi ali ludda wa?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.9",
            "verseOrgIds": [
              "GEN.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 4:9"
      },
      "items": [
        {
          "text": "N'amuddamu nti, \"Ssimanyi; nze mukuumi wa muganda wange?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.9",
            "verseOrgIds": [
              "GEN.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.4.10",
                "verseOrgIds": [
                  "GEN.4.10"
                ]
              }
            }
          ]
        },
        {
          "text": "n'amugamba nti, \"Okoze ki? Eddoboozi ly'omusaayi gwa muganda wo oguyiyiddwa ku ttaka linkaabirira.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.10",
            "verseOrgIds": [
              "GEN.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kaakano okolimiddwa, era ettaka lyasamye okumira omusaayi gwa muganda wo gwe wasse.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.11",
            "verseOrgIds": [
              "GEN.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'onoolimanga ettaka teriikuwenga bibala byalyo; onoobanga momboze ku nsi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.12",
            "verseOrgIds": [
              "GEN.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kayini n'agamba",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.13",
            "verseOrgIds": [
              "GEN.4.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.4.13",
                "verseOrgIds": [
                  "GEN.4.13"
                ]
              }
            }
          ]
        },
        {
          "text": "nti, \"Ekibonerezo kyange kinzitooweredde sikisobola.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.13",
            "verseOrgIds": [
              "GEN.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laba, ongobye okuva ku nsi ne mu maaso go; era nnaabanga momboze ne buli anandaba ananzita.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.14",
            "verseOrgIds": [
              "GEN.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.15",
            "verseOrgIds": [
              "GEN.4.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.4.15",
                "verseOrgIds": [
                  "GEN.4.15"
                ]
              }
            }
          ]
        },
        {
          "text": "n'amugamba nti, \"Nedda si bwe kiri. Buli alitta Kayini ndimuwalana emirundi musanvu.\" Awo",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.15",
            "verseOrgIds": [
              "GEN.4.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.4.15",
                "verseOrgIds": [
                  "GEN.4.15"
                ]
              }
            }
          ]
        },
        {
          "text": "n'ateeka akabonero ku Kayini, buli amulaba aleme okumutta.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.15",
            "verseOrgIds": [
              "GEN.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kayini n'alyoka ava mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.16",
            "verseOrgIds": [
              "GEN.4.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.4.16",
                "verseOrgIds": [
                  "GEN.4.16"
                ]
              }
            }
          ]
        },
        {
          "text": ", n'abeera mu nsi ya Enodi ku luuyi olw'ebuvanjuba olwa Adeni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.16",
            "verseOrgIds": [
              "GEN.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abaana ba Kayini",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kayini n'amanya mukazi we, n'aba olubuto n'azaala Enoka. Kayini n'azimba ekibuga n'akituuma erinnya lyerimu erya mutabani we Enoka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.17",
            "verseOrgIds": [
              "GEN.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enoka n'azaalirwa Iradi ne Iradi n'azaala Mekujeeri, ne Mekujeeri n'azaala Mesuseera, ne Mesuseera n'azaala Lameka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.18",
            "verseOrgIds": [
              "GEN.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lameka n'awasa abakazi babiri: omu yali Ada n'omulala nga ye Zira.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.19",
            "verseOrgIds": [
              "GEN.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ada n'azaala Yabali. Ono ye yali kitaawe w'abo ababeera mu weema nga balunda.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.20",
            "verseOrgIds": [
              "GEN.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muganda we Yubali, ye yazaala abo abakuba ennanga n'okufuuwa omulere.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.21",
            "verseOrgIds": [
              "GEN.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zira n'azaala Tubalukayini omuweesi w'eby'ekikomo n'eby'ekyuma. Ne mwannyina wa Tubalukayini nga ye Naama.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.22",
            "verseOrgIds": [
              "GEN.4.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
