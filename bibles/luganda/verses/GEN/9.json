{
  "id": "GEN.9",
  "number": "9",
  "bookId": "GEN",
  "reference": "Olubereberye 9",
  "copyright": "Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™ Obwannannyini© 1984, 1986, 1993, 2014 bwa Biblica, Inc. Biblica® Open Luganda Contemporary Bible™ Copyright © 1984, 1986, 1993, 2014 by Biblica, Inc. \"Biblica\" Linnya ery'obwannannyini eryawandiisibwa Biblica mu Amerika era nga balina n'ekkakkalabozo, Inc. Bwaweebwa olukusa okulikozesa. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "GEN 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Endagaano ya Katonda ne Nuuwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Katonda n'awa Nuuwa ne batabani be omukisa n'agamba nti, \"Muzaale mwale mweyongerenga nnyo mujjuze ensi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.1",
            "verseOrgIds": [
              "GEN.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensolo zonna ez'omu nsiko, n'ebinyonyi eby'omu bbanga, na buli ekitambula ku nsi, buli ekiri mu nnyanja, byonna binaakutyanga, mbikuwadde mu mikono gyo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.2",
            "verseOrgIds": [
              "GEN.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli kintu ekiramu, ekitambula onookiryanga. Nga bwe nakuwa ebimera, kaakano nkuwa buli kintu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.3",
            "verseOrgIds": [
              "GEN.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naye toolyenga nnyama ng'ekyalimu omusaayi gwayo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.4",
            "verseOrgIds": [
              "GEN.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era ndivunaana ayiwa omusaayi gwammwe ne nvunaana n'omuntu olw'omusaayi gw'ensolo ne muvunaana n'olw'omusaayi gwa muntu munne.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.5",
            "verseOrgIds": [
              "GEN.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Buli anaayiwanga omusaayi gw'omuntu,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.6",
            "verseOrgIds": [
              "GEN.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 9:6"
      },
      "items": [
        {
          "text": "n'ogugwe gunaayiibwanga,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.6",
            "verseOrgIds": [
              "GEN.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 9:6"
      },
      "items": [
        {
          "text": "kubanga mu kifaananyi kya Katonda,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.6",
            "verseOrgIds": [
              "GEN.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 9:6"
      },
      "items": [
        {
          "text": "Katonda mwe yakolera omuntu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.6",
            "verseOrgIds": [
              "GEN.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ggwe onoozaalanga ne weeyongera obungi. Oneeyongeranga ku nsi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.7",
            "verseOrgIds": [
              "GEN.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Endagaano ne Nuuwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Katonda n'agamba Nuuwa ne batabani bwe baali",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.8",
            "verseOrgIds": [
              "GEN.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nti, \"Laba nkola endagaano yange nammwe ne bonna abaliva mu mmwe oluvannyuma lwammwe,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.9",
            "verseOrgIds": [
              "GEN.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "era na buli kitonde ekiramu ekiri naawe: ebinyonyi, n'ensolo ez'awaka n'ez'omu nsiko zonna, ne byonna bye muvudde nabyo mu lyato, ne buli kitonde kyonna ku nsi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.10",
            "verseOrgIds": [
              "GEN.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkola endagaano yange eno nammwe: tewaabengawo mataba gazikiriza bulamu bwonna, tewakyaddayo kubaawo mataba gasaanyaawo nsi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.11",
            "verseOrgIds": [
              "GEN.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda n'agamba nti, \"Kano ke kabonero ke nteeka wakati wange nammwe, na buli kitonde ekiramu ekiri nammwe, era n'ab'emirembe egiriddawo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.12",
            "verseOrgIds": [
              "GEN.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nteeka musoke wange mu kire, nga ke kabonero ak'endagaano wakati wange n'ensi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.13",
            "verseOrgIds": [
              "GEN.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kale olunaatuukanga, bwe nnaaleetaanga ekire ku nsi, musoke anaalabikiranga ku bire,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.14",
            "verseOrgIds": [
              "GEN.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne nzijukira endagaano yange nammwe na buli kiramu; era amazzi tegakyaddayo kuzikiriza biramu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.15",
            "verseOrgIds": [
              "GEN.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musoke bw'anaabanga ku bire, nnaamutunuuliranga ne nzijukira endagaano eteriggwaawo eriwo wakati wa Katonda na buli kitonde ekiramu ekiri ku nsi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.16",
            "verseOrgIds": [
              "GEN.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda n'agamba Nuuwa nti, \"Kano ke kabonero ak'endagaano gye ntaddewo wakati wange ne buli kiramu ekiri ku nsi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.17",
            "verseOrgIds": [
              "GEN.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Batabani ba Nuuwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Nuuwa abaava mu lyato ye Seemu, ne Kaamu ne Yafeesi. Kaamu ye yali kitaawe wa Kanani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.18",
            "verseOrgIds": [
              "GEN.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonna abasatu be baali batabani ba Nuuwa; era okuva mu bano ensi yonna yajjula abantu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.19",
            "verseOrgIds": [
              "GEN.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kanani Akolimirwa, Seemu ye Aweebwa Omukisa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuuwa n'atandika okulima n'asimba emizabbibu;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.20",
            "verseOrgIds": [
              "GEN.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'anywa omwenge n'atamiira, ne yeebaka mu weema ng'ali bwereere.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.21",
            "verseOrgIds": [
              "GEN.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaamu kitaawe wa Kanani n'alaba obwereere bwa kitaawe, n'abuulirako baganda be ababiri abaali ebweru.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.22",
            "verseOrgIds": [
              "GEN.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ne bateeka olugoye ku bibegabega byabwe ne batambula ekyennyumannyuma, ne babikka ku bwereere bwa kitaabwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.23",
            "verseOrgIds": [
              "GEN.9.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwenge bwe gwamwamukako, Nuuwa n'azuukuka n'ategeera mutabani we omuto ky'amukoze.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.24",
            "verseOrgIds": [
              "GEN.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'akolimira ezzadde lya Kaamu n'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.25",
            "verseOrgIds": [
              "GEN.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 9:25"
      },
      "items": [
        {
          "text": "\"Kanani akolimirwe,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.25",
            "verseOrgIds": [
              "GEN.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 9:25"
      },
      "items": [
        {
          "text": "abeere muddu wa baddu eri baganda be.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.25",
            "verseOrgIds": [
              "GEN.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era n'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.26",
            "verseOrgIds": [
              "GEN.9.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 9:26"
      },
      "items": [
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.26",
            "verseOrgIds": [
              "GEN.9.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.9.26",
                "verseOrgIds": [
                  "GEN.9.26"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wange, awe Seemu omukisa,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.26",
            "verseOrgIds": [
              "GEN.9.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
