          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nabaleetera enjala embuto zammwe ne ziba njereere mu buli kibuga,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.6",
            "verseOrgIds": [
              "AMO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:6"
      },
      "items": [
        {
          "text": "ne ssibawa kyakulya mu buli kabuga,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.6",
            "verseOrgIds": [
              "AMO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:6"
      },
      "items": [
