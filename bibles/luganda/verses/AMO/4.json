            "number": "5",
            "style": "v",
            "sid": "AMO 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muweeyo ekiweebwayo eky'okwebaza eky'emigaati egizimbulukusibbwa,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.5",
            "verseOrgIds": [
              "AMO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:5"
      },
      "items": [
        {
          "text": "mulangirire n'ebiweebwayo eby'ekyeyagalire;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.5",
            "verseOrgIds": [
              "AMO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:5"
      },
      "items": [
        {
          "text": "mwe mwenyumiririza, mmwe Abayisirayiri",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.5",
            "verseOrgIds": [
              "AMO.4.5"
            ]
          }
        }
      ]
    },
    {
