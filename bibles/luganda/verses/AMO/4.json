          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu ne bavanga mu kibuga ekimu ne balaga mu kirala nga banoonya amazzi banyweko,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.8",
            "verseOrgIds": [
              "AMO.4.8"
            ]
          }
        }
      ]
    },
