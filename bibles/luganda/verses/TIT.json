  "TIT.3": {
    "id": "TIT.3",
    "number": "3",
    "bookId": "TIT",
    "reference": "Tito 3",
    "copyright": "Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™ Obwannannyini© 1984, 1986, 1993, 2014 bwa Biblica, Inc. Biblica® Open Luganda Contemporary Bible™ Copyright © 1984, 1986, 1993, 2014 by Biblica, Inc. \"Biblica\" Linnya ery'obwannannyini eryawandiisibwa Biblica mu Amerika era nga balina n'ekkakkalabozo, Inc. Bwaweebwa olukusa okulikozesa. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
    "verseCount": 15,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "3",
          "style": "c",
          "sid": "TIT 3"
        },
        "items": [
          {
            "text": "3",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Okuwabula Abakkiriza",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "TIT 3:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ebintu ebyo bijjukizenga abafuzi n'ab'obuyinza, babiwulirenga, era babigonderenga, era babenga beetegefu okukola buli mulimu omulungi.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.1",
              "verseOrgIds": [
                "TIT.3.1"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "TIT 3:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "Bakuutire baleme kwogerebwako bubi, era beewalenga okuyomba, babenga bakkakkamu era babeerenga bawombeefu eri abantu bonna.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.2",
              "verseOrgIds": [
                "TIT.3.2"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "TIT 3:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Kubanga naffe ffennyini twali basirusiru era abajeemu, nga tuwabye, era nga tufugibwa okwegomba kwaffe okubi, n'amasanyu aga buli ngeri, nga tuli ba ttima era ab'obuggya, nga tukyayibwa era nga tukyawagana.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.3",
              "verseOrgIds": [
                "TIT.3.3"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "TIT 3:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Naye ekisa kya Katonda Omulokozi waffe n'okwagala kwe bwe byalabika,",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.4",
              "verseOrgIds": [
                "TIT.3.4"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "TIT 3:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "n'atulokola, si lwa bikolwa eby'omu butuukirivu bye twakola, wabula olw'okusaasira kwe mu kunaazibwa okw'okuzaalibwa okw'omulundi ogwokubiri n'okufuulibwa abaggya olwa Mwoyo Mutukuvu,",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.5",
              "verseOrgIds": [
                "TIT.3.5"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "TIT 3:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "gwe yatuyiwako mu bungi ku lwa Yesu Kristo Omulokozi waffe.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.6",
              "verseOrgIds": [
                "TIT.3.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "TIT 3:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Bwe tulimala okutukuzibwa olw'ekisa kye, tulyoke tufune omugabo mu kusuubira obulamu obutaggwaawo.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.7",
              "verseOrgIds": [
                "TIT.3.7"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "TIT 3:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ekigambo ekyo kyesigwa, era nkukuutira ebyo obinywezenga abakkiriza Katonda bajjukirenga okukola ebikolwa ebirungi; ebintu ebyo birungi era bigasa abantu.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.8",
              "verseOrgIds": [
                "TIT.3.8"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "TIT 3:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Naye weewalenga empaka ez'obusirusiru, n'okukaayana ku nkalala eziraga obuzaale bw'abantu, n'ennyombo, n'entalo ebikwata ku mateeka; kubanga tebiriiko kye bigasa era tebiriimu nsa.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.9",
              "verseOrgIds": [
                "TIT.3.9"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "TIT 3:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "Omuntu ayawulayawula mu bantu bw'omalanga okumulabula omulundi ogusooka, era n'ogwokubiri, omwewalanga,",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.10",
              "verseOrgIds": [
                "TIT.3.10"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "TIT 3:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "kubanga omuntu ng'oyo aba amaze okukyamizibwa mu kibi, era nga yeesalira yekka omusango.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.11",
              "verseOrgIds": [
                "TIT.3.11"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "TIT 3:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "Bwe nkutumiranga Atema oba Tukiko, oyanguwanga okujja gye ndi mu Nikopoli, kubanga nsazeewo okubeera eyo mu biseera eby'obutiti.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.12",
              "verseOrgIds": [
                "TIT.3.12"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "13",
              "style": "v",
              "sid": "TIT 3:13"
            },
            "items": [
              {
                "text": "13",
                "type": "text"
              }
            ]
          },
          {
            "text": "Fuba okusibirira Zeena munnamateeka ne Apolo obatume babe nga tebaliiko kye beetaaga.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.13",
              "verseOrgIds": [
                "TIT.3.13"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "14",
              "style": "v",
              "sid": "TIT 3:14"
            },
            "items": [
              {
                "text": "14",
                "type": "text"
              }
            ]
          },
          {
            "text": "Era kubiriza abantu baffe bayige okukolanga emirimu omuva ebyetaagibwa, balemenga kubeera awo nga tebaliiko kye bagasa.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.14",
              "verseOrgIds": [
                "TIT.3.14"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "15",
              "style": "v",
              "sid": "TIT 3:15"
            },
            "items": [
              {
                "text": "15",
                "type": "text"
              }
            ]
          },
          {
            "text": "Bonna abali nange bakulamusizza.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.15",
              "verseOrgIds": [
                "TIT.3.15"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p",
          "vid": "TIT 3:15"
        },
        "items": [
          {
            "text": "Olamuse abo bonna abatwagala mu kukkiriza.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.15",
              "verseOrgIds": [
                "TIT.3.15"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b",
          "vid": "TIT 3:15"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p",
          "vid": "TIT 3:15"
        },
        "items": [
          {
            "text": "Ekisa kibeerenga nammwe mwenna.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.3.15",
              "verseOrgIds": [
                "TIT.3.15"
              ]
            }
          }
        ]
      }
    ],
