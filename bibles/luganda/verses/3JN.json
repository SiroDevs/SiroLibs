    "verseCount": 15,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "1",
          "style": "c",
          "sid": "3JN 1"
        },
        "items": [
          {
            "text": "1",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "3JN 1:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nze, Omukadde, mpandiikira ggwe Gayo omwagalwa, gwe njagala mu mazima.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.1",
              "verseOrgIds": [
                "3JN.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "3JN 1:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "Munnange omwagalwa, nkusabira okole bulungi ebintu byonna era obeere mulamu mu mubiri, nga bw'oli mu mwoyo.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.2",
              "verseOrgIds": [
                "3JN.1.2"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "3JN 1:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Abooluganda bwe nabatuukako kya nsanyusa nnyo bwe bambuulira nti onyweredde mu mazima, era nti mw'otambulira.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.3",
              "verseOrgIds": [
                "3JN.1.3"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "3JN 1:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Tewali kindeetera ssanyu lisinga ng'eryo lye nfuna bwe mpulira nti abaana bange batambulira mu mazima.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.4",
              "verseOrgIds": [
                "3JN.1.4"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "3JN 1:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "Omwagalwa, okola ekintu kya bwesigwa buli lw'okolera abooluganda ebirungi na ddala ababeera ku ŋŋendo ne bw'oba tobamanyi.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.5",
              "verseOrgIds": [
                "3JN.1.5"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "3JN 1:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Baategeeza Ekkanisa omukwano gwe wabalaga awamu ne bye wabakolera. Kibeera kirungi singa obasiibuza ekirabo ekiba kisaanidde.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.6",
              "verseOrgIds": [
                "3JN.1.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "3JN 1:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Kubanga baatambulira mu linnya lya Mukama, nga tebakkiriza ebyo abatali bakkiriza bye baabawanga.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.7",
              "verseOrgIds": [
                "3JN.1.7"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "3JN 1:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "Noolwekyo ffe ffennyini, ffe tusaana okubalabirira tulyoke tufuuke bakozi bannaabwe mu mazima.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.8",
              "verseOrgIds": [
                "3JN.1.8"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Diyotuleefe ne Demeteriyo",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "3JN 1:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nawandiikira Ekkanisa ku nsonga eyo, kyokka Diyotuleefe, olw'okwagala okwefuula omukulembeze tatwagala.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.9",
              "verseOrgIds": [
                "3JN.1.9"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "3JN 1:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "Bwe ndijja ndibategeeza ebimu ku bintu by'akola, n'ebintu by'atwogerako ebitali birungi, era n'olulimi oluvuma lw'akozesa. Takoma ku kugaana kwaniriza abooluganda abatambuze kyokka, naye n'okulagira alagira abantu abalala nabo, baleme okubaaniriza era abo ababaaniriza agezaako okubagoba mu Kkanisa.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.10",
              "verseOrgIds": [
                "3JN.1.10"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "3JN 1:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Mukwano gwange, togobereranga kyakulabirako ekibi wabula eby'obutuukirivu. Gobereranga ebyo byokka by'olaba nga bya butuukirivu. Kirungi ojjukirenga nti abo abakola eby'obutuukirivu baba bakakasiza ddala nga bwe bali abaana ba Katonda; naye abakola ebitali bya butuukirivu balaga nga bwe bali ewala ne Katonda.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.11",
              "verseOrgIds": [
                "3JN.1.11"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "3JN 1:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "Naye buli omu ayogera bya mazima ku Demeteriyo. Nange mwogerako bya mazima byereere. Naye omanyi nga nze njogera mazima.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.12",
              "verseOrgIds": [
                "3JN.1.12"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "13",
              "style": "v",
              "sid": "3JN 1:13"
            },
            "items": [
              {
                "text": "13",
                "type": "text"
              }
            ]
          },
          {
            "text": "Mbadde na bingi eby'okukugamba, kyokka saagala kubikuwandiikira mu bbaluwa,",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.13",
              "verseOrgIds": [
                "3JN.1.13"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "14",
              "style": "v",
              "sid": "3JN 1:14"
            },
            "items": [
              {
                "text": "14",
                "type": "text"
              }
            ]
          },
          {
            "text": "kubanga nsuubira okukulaba mu bbanga ttono. Kale olwo tuliba na bingi eby'okwogerako ffembi nga tulabaganye amaaso n'amaaso.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.14",
              "verseOrgIds": [
                "3JN.1.14"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "15",
              "style": "v",
              "sid": "3JN 1:15"
            },
            "items": [
              {
                "text": "15",
                "type": "text"
              }
            ]
          },
          {
            "text": "Emirembe gibeerenga naawe.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.15",
              "verseOrgIds": [
                "3JN.1.15"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b",
          "vid": "3JN 1:15"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p",
          "vid": "3JN 1:15"
        },
        "items": [
          {
            "text": "Ab'emikwano abali wano bakulamusizza. Nange, mikwano gyange abali eyo, buli omu munnamusize.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.15",
              "verseOrgIds": [
                "3JN.1.15"
              ]
            }
          }
        ]
      }
