              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiyuza ebyambalo byo ebyokwebikkirira, ne mponya abantu bange mu mikono gyo, ne bataddayo kugwa mu mutego gwa buyinza bwo, olyoke omanye nga nze",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.21",
            "verseOrgIds": [
              "EZK.13.21"
            ]
