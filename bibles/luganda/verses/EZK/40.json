          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'antwala ku mulyango ogw'Obukiikakkono ogw'oluggya olw'omunda n'alupima ng'ebipimo bye bimu ng'emiryango emirala.",
          "type": "text",
          "attrs": {
