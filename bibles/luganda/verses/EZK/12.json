                "verseOrgIds": [
                  "EZK.12.25"
                ]
              }
            }
          ]
        },
        {
          "text": "ndyogera kye ndisiima, era kirituukirira amangu ddala. Mu nnaku zo ggwe ennyumba enjeemu, ndyogera ekigambo era ndikituukiriza, bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.25",
            "verseOrgIds": [
