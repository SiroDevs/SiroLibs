                "verseOrgIds": [
                  "EZK.12.23"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda nti, ŋŋenda kukomya olugero luno, era tebaliddayo nate kulwogera, mu Isirayiri.' Bagambe nti, 'Ebiro binaatera okutuuka, okwolesebwa kwonna lwe kulituukirira.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.23",
            "verseOrgIds": [
