              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nze",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.25",
            "verseOrgIds": [
              "EZK.12.25"
            ]
          }
