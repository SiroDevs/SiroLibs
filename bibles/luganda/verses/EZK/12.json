          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tewaliba nate kwolesebwa kwa bulimba newaakubadde obunnabbi obusavuwaze mu bantu ba Isirayiri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.24",
            "verseOrgIds": [
