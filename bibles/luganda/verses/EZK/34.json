                "verseOrgIds": [
                  "EZK.34.24"
                ]
              }
            }
          ]
        },
        {
          "text": "njogedde.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.24",
            "verseOrgIds": [
              "EZK.34.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ndikola endagaano yange ezisuubiza emirembe, era ndigoba mu nsi ensolo enkambwe, zibeerenga mu ddungu era zeebakenga mu bibira mirembe nga tezirumbibwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.25",
            "verseOrgIds": [
              "EZK.34.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiziwa omukisa wamu n'ebifo ebyetoolodde akasozi kange, era ndibatonnyeseza enkuba mu ntuuko yaayo; walibaawo enkuba ey'omukisa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.26",
            "verseOrgIds": [
              "EZK.34.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emiti egy'omu ttale girireeta ebibala byagyo, n'ettaka lirimeza ebimera byalyo, era n'abantu balituula mirembe mu nsi yaabwe. Balimanya nga nze",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.27",
            "verseOrgIds": [
              "EZK.34.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.34.27",
                "verseOrgIds": [
                  "EZK.34.27"
                ]
              }
            }
          ]
        },
        {
          "text": "bwe ndimenya ebisiba eby'ekikoligo kyabwe ne mbawonya mu mukono gwabwo abaabafuula abaddu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.27",
            "verseOrgIds": [
              "EZK.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teziriba munyago nate eri amawanga, so n'ensolo enkambwe tezirizitaagulataagula. Zirituula mirembe so tewaliba muntu n'omu azitiisatiisa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.28",
            "verseOrgIds": [
              "EZK.34.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiziwa ensi emanyiddwa olw'ebirime byayo, zireme okulumwa enjala nate mu nsi newaakubadde okunyoomebwa amawanga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.29",
            "verseOrgIds": [
              "EZK.34.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era zirimanya nga nze",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.30",
            "verseOrgIds": [
              "EZK.34.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.34.30",
                "verseOrgIds": [
                  "EZK.34.30"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda waazo, ndi wamu nazo, era nga zo, ennyumba ya Isirayiri, bantu bange, bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.30",
            "verseOrgIds": [
              "EZK.34.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.34.30",
                "verseOrgIds": [
                  "EZK.34.30"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.30",
            "verseOrgIds": [
              "EZK.34.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 34:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmwe ndiga zange, endiga ez'eddundiro lyange, muli bantu bange, era nze ndi Katonda wammwe, bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.31",
            "verseOrgIds": [
              "EZK.34.31"
            ]
          }
        },
