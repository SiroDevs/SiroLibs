          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinyweza emikono gya kabaka w'e Babulooni, naye emikono gya Falaawo giriremala, balyoke bamanye nga nze",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.25",
            "verseOrgIds": [
