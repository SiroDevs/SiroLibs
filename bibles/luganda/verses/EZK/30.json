            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.30.25",
                "verseOrgIds": [
                  "EZK.30.25"
                ]
              }
            }
          ]
        },
        {
          "text": ". Nditeeka ekitala mu mikono gya kabaka w'e Babulooni, n'akigololera ku nsi y'e Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.25",
            "verseOrgIds": [
