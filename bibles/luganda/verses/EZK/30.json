                  "EZK.30.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda kyava ayogera nti, Nnina ensonga ne Falaawo, ye kabaka w'e Misiri, era ndimenya emikono gye, omulamu ogw'amaanyi n'ogwo ogwamenyekako, ne nsuula ekitala okuva mu mukono gwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.22",
            "verseOrgIds": [
              "EZK.30.22"
            ]
          }
        },
