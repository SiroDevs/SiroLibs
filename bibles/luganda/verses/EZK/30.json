        },
        {
          "text": "Ndisaasaanya Abamisiri mu mawanga ne mu nsi ennyingi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.23",
            "verseOrgIds": [
              "EZK.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
