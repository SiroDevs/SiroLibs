              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinyweza emikono gya kabaka w'e Babulooni ne nteeka ekitala mu mukono gwe, naye ndimenya emikono gya Falaawo, era alisindira mu maaso ga kabaka w'e Babulooni, ng'omuntu afumitiddwa anaatera okufa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.24",
            "verseOrgIds": [
              "EZK.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
