    "number": "1",
    "bookId": "2TH",
    "reference": "2 Basessaloniika 1",
    "copyright": "Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™ Obwannannyini© 1984, 1986, 1993, 2014 bwa Biblica, Inc. Biblica® Open Luganda Contemporary Bible™ Copyright © 1984, 1986, 1993, 2014 by Biblica, Inc. \"Biblica\" Linnya ery'obwannannyini eryawandiisibwa Biblica mu Amerika era nga balina n'ekkakkalabozo, Inc. Bwaweebwa olukusa okulikozesa. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
    "verseCount": 12,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "1",
          "style": "c",
          "sid": "2TH 1"
        },
        "items": [
          {
            "text": "1",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "2TH 1:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nze Pawulo ne Sirwano",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.1",
              "verseOrgIds": [
                "2TH.1.1"
              ]
            }
          },
          {
            "text": "ne Timoseewo tuwandiikira Ekkanisa ey'Abasessaloniika, abantu ba Katonda Kitaffe ne Mukama waffe Yesu Kristo,",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.1",
              "verseOrgIds": [
                "2TH.1.1"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "2TH 1:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "ekisa n'emirembe ebiva eri Katonda Kitaffe ne Mukama waffe Yesu Kristo, bibeerenga nammwe.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.2",
              "verseOrgIds": [
                "2TH.1.2"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Okwebaza n'Okusaba",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "2TH 1:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Kitugwanidde okwebazanga Katonda bulijjo ku lwammwe abooluganda, nga bwe kisaana, kubanga okukkiriza kwammwe kweyongedde nnyo okukula, awamu n'okwagalana kwammwe mwekka na mwekka,",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.3",
              "verseOrgIds": [
                "2TH.1.3"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "2TH 1:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "ekyo ne kituleetera ffe ffennyini okubeenyumiririzaamu mu kkanisa za Katonda olw'okugumiikiriza kwammwe n'okukkiriza kwammwe wakati mu kuyigganyizibwa kwammwe kwonna awamu n'okubonaabona bye mugumiikiriza.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.4",
              "verseOrgIds": [
                "2TH.1.4"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "2TH 1:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ako kabonero akalaga nti Katonda mutuukirivu mu kulamula kwe, mmwe mulyoke musaanire obwakabaka bwa Katonda, bwe mubonaabonera,",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.5",
              "verseOrgIds": [
                "2TH.1.5"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "2TH 1:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "ate ng'abo ababanyigiriza alibabonereza nga bwe kibagwanidde.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.6",
              "verseOrgIds": [
                "2TH.1.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "2TH 1:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Era nammwe abanyigirizibwa muliweerwa wamu naffe ekiwummulo, mu kubikkulirwa kwa Mukama waffe Yesu bw'aliva mu ggulu, ne bamalayika be ab'amaanyi,",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.7",
              "verseOrgIds": [
                "2TH.1.7"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "2TH 1:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "mu muliro ogwaka, n'abonereza abo abatamanyi Katonda era abajeemera Enjiri ya Mukama waffe Yesu.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.8",
              "verseOrgIds": [
                "2TH.1.8"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "2TH 1:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Abo baliweebwa ekibonerezo kya kuzikirira emirembe n'emirembe, nga baawukanyiziddwa ne Mukama waffe, n'ekitiibwa ky'amaanyi ge.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.9",
              "verseOrgIds": [
                "2TH.1.9"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "2TH 1:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "Bw'alijja okugulumizibwa mu batukuvu be ku lunaku luli abo bonna abamukkiriza balyewuunya kubanga mwakkiriza bye twabategeeza ku ye.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.10",
              "verseOrgIds": [
                "2TH.1.10"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "2TH 1:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Kyetuva tubasabira bulijjo, Katonda waffe abasaanyize okuyitibwa kwammwe. Abawe amaanyi mutuukirize ebirungi byonna bye mukola, na buli mulimu ogw'okukkiriza mu maanyi,",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.11",
              "verseOrgIds": [
                "2TH.1.11"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "2TH 1:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "erinnya lya Mukama waffe Yesu liryoke ligulumizibwe mu mmwe, nammwe muweebwe ekitiibwa mu ye, ng'ekisa kya Katonda waffe ne Mukama waffe Yesu Kristo bwe kiri.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.12",
              "verseOrgIds": [
                "2TH.1.12"
              ]
            }
          }
        ]
      }
    ],
    "next": {
      "id": "2TH.2",
      "number": "2",
      "bookId": "2TH"
    },
    "previous": {
      "id": "2TH.intro",
      "number": "intro",
      "bookId": "2TH"
    }
  },
  "2TH.2": {
    "id": "2TH.2",
    "number": "2",
    "bookId": "2TH",
    "reference": "2 Basessaloniika 2",
    "copyright": "Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™ Obwannannyini© 1984, 1986, 1993, 2014 bwa Biblica, Inc. Biblica® Open Luganda Contemporary Bible™ Copyright © 1984, 1986, 1993, 2014 by Biblica, Inc. \"Biblica\" Linnya ery'obwannannyini eryawandiisibwa Biblica mu Amerika era nga balina n'ekkakkalabozo, Inc. Bwaweebwa olukusa okulikozesa. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
    "verseCount": 17,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "2",
          "style": "c",
          "sid": "2TH 2"
        },
        "items": [
          {
            "text": "2",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Ebikolwa by'Omulabe wa Kristo",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "2TH 2:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Kaakano abooluganda, ku by'okukomawo kwa Mukama waffe Yesu Kristo, era n'okukuŋŋaanyizibwa okumusisinkana, tubasaba",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.1",
              "verseOrgIds": [
                "2TH.2.1"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "2TH 2:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "muleme okweraliikirira wadde emitima okubeewanika newaakubadde olw'omwoyo, newaakubadde olw'ekigambo wadde olw'ebbaluwa, ebirabika ng'ebivudde gye tuli, nga biranga nti olunaku lwa Mukama lutuuse.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.2",
              "verseOrgIds": [
                "2TH.2.2"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "2TH 2:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Omuntu yenna tabalimbalimbanga mu ngeri yonna; kubanga okuggyako ng'obujeemu busoose okujja, n'omuntu oli ow'obujeemu, omwana w'okuzikirira ng'amaze okulabisibwa,",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.3",
              "verseOrgIds": [
                "2TH.2.3"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "2TH 2:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "oyo alivvoola Katonda ne yeegulumiza okusinga ebintu byonna nga yeeyita katonda oba ekissibwamu ekitiibwa atuule mu yeekaalu ya Katonda omwo nga yeefuula okuba Katonda.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.4",
              "verseOrgIds": [
                "2TH.2.4"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "2TH 2:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "Temujjukira ng'ebyo nabibategeeza bwe nnali nammwe?",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.5",
              "verseOrgIds": [
                "2TH.2.5"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "2TH 2:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Era ekikyamuziyizza mukimanyi kubanga tagenda kujja okutuusa ng'ekiseera kye kituuse.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.6",
              "verseOrgIds": [
                "2TH.2.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "2TH 2:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Kubanga ekyama ky'obujeemu kyatandika dda okukola, naye ye yennyini tagenda kujja okutuusa oyo amuziyiza lw'aliva mu kkubo.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.7",
              "verseOrgIds": [
                "2TH.2.7"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "2TH 2:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "Olwo omuntu ow'obujeemu alyoke alabisibwe, Mukama waffe Yesu gw'alimalawo n'omukka ogw'omu kamwa ke n'amuzikiriza n'okulabisibwa kw'okujja kwe.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.8",
              "verseOrgIds": [
                "2TH.2.8"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "2TH 2:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Omuntu oyo alijjira mu maanyi ga Setaani gonna n'akola obubonero n'eby'amagero, eby'obulimba,",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.9",
              "verseOrgIds": [
                "2TH.2.9"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "2TH 2:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "era n'obulimba obwa buli ngeri obw'obutali butuukirivu eri abo abazikirizibwa, kubanga bagaana okukkiriza amazima okulokolebwa.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.10",
              "verseOrgIds": [
                "2TH.2.10"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "2TH 2:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Katonda kyava abawaayo eri okubuzibwabuzibwa okw'amaanyi bakkirize eby'obulimba.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.11",
              "verseOrgIds": [
                "2TH.2.11"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "2TH 2:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "Era bonna balyoke basalirwe omusango olw'okukkiriza obulimba, ne bagaana amazima ne basanyukira okukola ebitali bya butuukirivu.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.12",
              "verseOrgIds": [
                "2TH.2.12"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "13",
              "style": "v",
              "sid": "2TH 2:13"
            },
            "items": [
              {
                "text": "13",
                "type": "text"
              }
            ]
          },
          {
            "text": "Naye kitugwanidde okwebazanga Katonda ennaku zonna ku lwammwe, abooluganda abaagalwa mu Mukama waffe, kubanga Katonda yabalondera obulokozi okuva ku lubereberye, ng'abatukuza olw'okukola kw'Omwoyo n'okukkiriza amazima,",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.13",
              "verseOrgIds": [
                "2TH.2.13"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "14",
              "style": "v",
              "sid": "2TH 2:14"
            },
            "items": [
              {
                "text": "14",
                "type": "text"
              }
            ]
          },
          {
            "text": "ge yabayitira ng'ayita mu Njiri yaffe mulyoke mufune ekitiibwa kya Mukama waffe Yesu Kristo.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.14",
              "verseOrgIds": [
                "2TH.2.14"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "15",
              "style": "v",
              "sid": "2TH 2:15"
            },
            "items": [
              {
                "text": "15",
                "type": "text"
              }
            ]
          },
          {
            "text": "Noolwekyo abooluganda, munywererenga ku ebyo bye twabayigiriza mu bbaluwa zaffe oba mu bigambo byaffe.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.15",
              "verseOrgIds": [
                "2TH.2.15"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "16",
              "style": "v",
              "sid": "2TH 2:16"
            },
            "items": [
              {
                "text": "16",
                "type": "text"
              }
            ]
          },
          {
            "text": "Kale Mukama waffe Yesu Kristo yennyini, ne Katonda Kitaffe eyatwagala n'atuwa essanyu n'essuubi eddungi olw'ekisa kye,",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.16",
              "verseOrgIds": [
                "2TH.2.16"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "17",
              "style": "v",
              "sid": "2TH 2:17"
            },
            "items": [
              {
                "text": "17",
                "type": "text"
              }
            ]
          },
          {
            "text": "abazzeemu amaanyi, era abanywezenga mu buli kye mukola ne mu buli kigambo ekirungi.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.17",
              "verseOrgIds": [
                "2TH.2.17"
              ]
            }
          }
        ]
      }
    ],
