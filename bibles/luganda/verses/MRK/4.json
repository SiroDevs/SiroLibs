  "verseCount": 41,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "MRK 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Olugero lw'Omusizi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate era n'atandika okuyigiriza ku lubalama lw'ennyanja. Ekibiina ky'abantu kinene nnyo ne bakuŋŋaana okumwetooloola. Kyeyava alinnya mu lyato n'ayigiriza ng'atudde omwo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.1",
            "verseOrgIds": [
              "MRK.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yabayigirizanga ebintu bingi mu ngero. N'abayigiriza ng'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.2",
            "verseOrgIds": [
              "MRK.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Muwulirize. Waaliwo omulimi eyafuluma okusiga ensigo.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.3",
                "verseOrgIds": [
                  "MRK.4.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.3",
            "verseOrgIds": [
              "MRK.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bwe yali ng'azimansa ng'asiga mu nnimiro, ezimu ne zigwa ku mabbali g'ekkubo ennyonyi ne zijja ne zizirya.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.4",
                "verseOrgIds": [
                  "MRK.4.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.4",
            "verseOrgIds": [
              "MRK.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "N'endala ne zigwa ku ttaka ery'ekyaziyazi awatali ttaka lingi, ezo ne zimera mangu kubanga tezaali mu ttaka gwanvu.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.5",
                "verseOrgIds": [
                  "MRK.4.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.5",
            "verseOrgIds": [
              "MRK.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Awo omusana bwe gwayaka ne zikalirawo, kubanga emirandira gyali kungulu.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.6",
                "verseOrgIds": [
                  "MRK.4.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.6",
            "verseOrgIds": [
              "MRK.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Endala ne zigwa mu maggwa. Awo ensigo ne zikula kyokka amaggwa ne gazitta ne zitabala bibala.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.7",
                "verseOrgIds": [
                  "MRK.4.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.7",
            "verseOrgIds": [
              "MRK.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Endala ne zigwa ku ttaka eddungi, ezo ne zibala ebibala, ezimu emirundi amakumi asatu, endala emirundi nkaaga, n'endala kikumi.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.8",
                "verseOrgIds": [
                  "MRK.4.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'abagamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.9",
            "verseOrgIds": [
              "MRK.4.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Oyo alina amatu agawulira awulire.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.9",
                "verseOrgIds": [
                  "MRK.4.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo bwe yasigala yekka, abayigirizwa be ekkumi n'ababiri n'abantu abalala, ne bamubuuza amakulu g'engero ezo ze yabagerera.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.10",
            "verseOrgIds": [
              "MRK.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'abagamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.11",
            "verseOrgIds": [
              "MRK.4.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mmwe muweereddwa omukisa okumanya ekyama ekifa ku bwakabaka bwa Katonda ekyakisibwa abantu abalala abali ebweru waabwo.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.11",
                "verseOrgIds": [
                  "MRK.4.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Balaba bulabi naye nga tebeetegereza,",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.12",
                "verseOrgIds": [
                  "MRK.4.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MRK 4:12"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "era n'okuwulira bawulira naye tebategeera,",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.12",
                "verseOrgIds": [
                  "MRK.4.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MRK 4:12"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "si kulwa nga bakyuka ne basonyiyibwa.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.12",
                "verseOrgIds": [
                  "MRK.4.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kale obanga temutegedde makulu ga lugero luno olwangu bwe luti mulitegeera mutya endala ze ŋŋenda okweyambisa nga njigiriza?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.13",
                "verseOrgIds": [
                  "MRK.4.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.13",
            "verseOrgIds": [
              "MRK.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Omusizi asiga ekigambo y'asiga.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.14",
                "verseOrgIds": [
                  "MRK.4.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.14",
            "verseOrgIds": [
              "MRK.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ate ensigo ezaagwa ku mabbali g'ekkubo, be bawulira ekigambo, amangwago Setaani n'ajja n'akibatwalako.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.15",
                "verseOrgIds": [
                  "MRK.4.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.15",
            "verseOrgIds": [
              "MRK.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ate ensigo ezaagwa ku byaziyazi, gy'emitima gy'abantu abawulira ekigambo amangwago ne bakyaniriza n'essanyu.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.16",
                "verseOrgIds": [
                  "MRK.4.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.16",
            "verseOrgIds": [
              "MRK.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye tebalina mirandira, babeera bulungi okusooka, naye olutuukibwako ebizibu oba okuyigganyizibwa olw'ekigambo amangwago babivaako.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.17",
                "verseOrgIds": [
                  "MRK.4.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.17",
            "verseOrgIds": [
              "MRK.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ate endala ezaagwa mu maggwa, be bawulira ekigambo,",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.18",
                "verseOrgIds": [
                  "MRK.4.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.18",
            "verseOrgIds": [
              "MRK.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "naye okweraliikirira n'okusikirizibwa eby'obugagga n'okwegomba ebintu ebirala, bizikiriza ekigambo ne kitabala bibala.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.19",
                "verseOrgIds": [
                  "MRK.4.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.19",
            "verseOrgIds": [
              "MRK.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ettaka eddungi gy'emitima gy'abantu abawulira ekigambo ne bakkiririza ddala era ne bavaamu ebibala, emirundi amakumi asatu, abalala emirundi nkaaga, n'abalala kikumi.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.20",
                "verseOrgIds": [
                  "MRK.4.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu n'ababuuza nti,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.21",
            "verseOrgIds": [
              "MRK.4.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Waliwo omuntu akoleeza ettaala n'agivuunikako ekibbo oba n'agiteeka wansi w'ekitanda? Naye omuntu bw'akoleeza ettaala tagiteeka ku kikondo waggulu?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.21",
                "verseOrgIds": [
                  "MRK.4.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.21",
            "verseOrgIds": [
              "MRK.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kubanga buli kintu kyonna ekikolebwa mu kyama kaakano, ekiseera kirituuka ne kiragibwa mu lwatu.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.22",
                "verseOrgIds": [
                  "MRK.4.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.22",
            "verseOrgIds": [
              "MRK.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Alina amatu agawulira awulire.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.23",
                "verseOrgIds": [
                  "MRK.4.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.23",
            "verseOrgIds": [
              "MRK.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye mwegendereze ebyo bye mbayigiriza.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.24",
                "verseOrgIds": [
                  "MRK.4.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.24",
            "verseOrgIds": [
              "MRK.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Alina aliweebwa na buli atalina aliggyibwako n'ebyo by'alina.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.25",
                "verseOrgIds": [
                  "MRK.4.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Olugero lw'Ensigo Ekula",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu n'abagamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.26",
            "verseOrgIds": [
              "MRK.4.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Obwakabaka bwa Katonda bufaanaanyirizibwa n'omusizi asiga ensigo mu ttaka.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.26",
                "verseOrgIds": [
                  "MRK.4.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.26",
            "verseOrgIds": [
              "MRK.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ekiro yeebaka, n'emisana ne yeekolera by'ayagala, mu kiseera ekyo kyonna ensigo ziba zimera, naye ate nga takimanyi.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.27",
                "verseOrgIds": [
                  "MRK.4.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.27",
            "verseOrgIds": [
              "MRK.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ku bwalyo ettaka lireeta ekibala. Ensigo zisooka kusindika bulimi bwazo okuva mu ttaka, amatabi ne gajjako ebirimba by'eŋŋaano.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.28",
                "verseOrgIds": [
                  "MRK.4.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.28",
            "verseOrgIds": [
              "MRK.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Eŋŋaano bw'eyengera omusizi ayanguwa mangu n'akwata akayuuyo, kubanga amakungula gatuuse.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.29",
                "verseOrgIds": [
                  "MRK.4.29"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu n'ayongera n'abagamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.30",
            "verseOrgIds": [
              "MRK.4.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Obwakabaka bwa Katonda tunaabugeraageranya na ki? Oba tukozese lugero ki okubunnyonnyola?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.30",
                "verseOrgIds": [
                  "MRK.4.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.30",
            "verseOrgIds": [
              "MRK.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bufaananyizibwa n'akasigo aka kaladaali! Kubanga newaakubadde katono nnyo okusinga ensigo zonna ez'oku nsi,",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.31",
                "verseOrgIds": [
                  "MRK.4.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.31",
            "verseOrgIds": [
              "MRK.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "naye kavaamu omuti omunene nga gulina amatabi amanene, ennyonyi ez'omu bbanga mwe ziyinza okuzimba ebisu byazo.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.32",
                "verseOrgIds": [
                  "MRK.4.32"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'abuulira abantu ekigambo kya Katonda ng'akozesa engero nnyingi ezifaanana ng'ezo, nga bwe baasobolanga okuwulira.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.33",
            "verseOrgIds": [
              "MRK.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu bwe yabanga ayigiriza ebibiina yakozesanga engero, naye bwe yaddanga ebbali n'abayigirizwa be n'abannyonnyola amakulu agali mu ngero ezo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.34",
            "verseOrgIds": [
              "MRK.4.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Akkakkanya Omuyaga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lunaku olwo obudde nga buwungedde Yesu n'agamba abayigirizwa be nti,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.35",
            "verseOrgIds": [
              "MRK.4.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Tuwunguke tulage emitala.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.35",
                "verseOrgIds": [
                  "MRK.4.35"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.35",
            "verseOrgIds": [
              "MRK.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'aleka awo ekibiina, abayigirizwa be ne balinnya mu lyato Yesu mwe yali ne bagenda naye. Abantu abamu ne babagobera mu maato agaabwe.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.36",
            "verseOrgIds": [
              "MRK.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amangwago omuyaga mungi nnyo ne gukunta n'amayengo amagulumivu ne geeyiwa mu lyato ne libulako katono okujjula amazzi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.37",
            "verseOrgIds": [
              "MRK.4.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yali agalamidde emabega mu lyato nga yeezizise omutto yeebase. Awo abayigirizwa be ne bamuzuukusa nga bagamba nti, \"Omuyigiriza, ggwe tofaayo nga ffenna tugenda okusaanawo?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.38",
            "verseOrgIds": [
              "MRK.4.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MRK 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'azuukuka n'aboggolera omuyaga n'agamba ennyanja nti,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.39",
            "verseOrgIds": [
              "MRK.4.39"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Tteeka, sirika.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.39",
                "verseOrgIds": [
                  "MRK.4.39"
                ]
              }
            }
          ]
        },
        {
          "text": "Omuyaga ne gusirika n'ennyanja n'eteekera ddala.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.39",
            "verseOrgIds": [
              "MRK.4.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MRK 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ababuuza nti,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.40",
            "verseOrgIds": [
              "MRK.4.40"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Lwaki mutidde? Temunnaba kubeera na kukkiriza?\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.4.40",
                "verseOrgIds": [
                  "MRK.4.40"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne batya nnyo, ne beebuuza nti, \"Ono ye ani, embuyaga n'ennyanja gwe bigondera?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.41",
            "verseOrgIds": [
              "MRK.4.41"
            ]
          }
        }
      ]
    }
