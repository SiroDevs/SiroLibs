  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "PHP 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okulamusa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PHP 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nze Pawulo ne Timoseewo abaddu ba Kristo Yesu tuwandiikira abatukuvu bonna mu Kristo Yesu abali mu Firipi, awamu n'abalabirizi n'abadiikoni;",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.1",
            "verseOrgIds": [
              "PHP.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PHP 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekisa n'emirembe ebiva eri Katonda Kitaffe ne Mukama waffe Yesu Kristo, bibeerenga nammwe.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.2",
            "verseOrgIds": [
              "PHP.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okwebaza n'Okusaba Katonda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PHP 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nneebaza Katonda wange buli lwe mbajjukira,",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.3",
            "verseOrgIds": [
              "PHP.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PHP 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "era buli lwe mbasabira mwenna nsaba nga nzijudde essanyu.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.4",
            "verseOrgIds": [
              "PHP.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PHP 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga okuviira ddala ku lunaku olwasooka n'okutuusiza ddala kaakano mwetaba wamu nange mu njiri.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.5",
            "verseOrgIds": [
              "PHP.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PHP 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkakasiza ddala nti oyo eyatandika omulimu omulungi mu mmwe, aligutuukiriza okutuusa ku lunaku lwa Kristo Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.6",
            "verseOrgIds": [
              "PHP.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PHP 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kino kituufu okubalowoozaako bwe ntyo mwenna, kubanga mundowoozaako mu kusibibwa kwange ne mu kulwanirira Enjiri, ne mu kuginyweza, nga mwenna mwetaba wamu nange mu kisa.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.7",
            "verseOrgIds": [
              "PHP.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PHP 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda ye mujulirwa wange nga mwenna bwe mbaagala n'okwagala okuva eri Kristo Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.8",
            "verseOrgIds": [
              "PHP.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PHP 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbasabira nti okwagala kwammwe kweyongerenga, era mujjule amagezi n'okutegeera,",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.9",
            "verseOrgIds": [
              "PHP.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PHP 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "mulyoke mulonde ekisinga obulungi, olunaku lwa Kristo bwe lulituuka lubasange nga muli balongoofu abataliiko kamogo,",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.10",
            "verseOrgIds": [
              "PHP.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PHP 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nga mujjudde ekibala eky'obutuukirivu ku bwa Yesu Kristo, olw'okuweesa Katonda ekitiibwa n'okumutendereza.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.11",
            "verseOrgIds": [
              "PHP.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obusibe bwa Pawulo Bubunyisa Njiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PHP 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abooluganda, njagala mmwe mutegeere kaakano nti ebimu ebyambaako byongera bwongezi kubunyisa Njiri,",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.12",
            "verseOrgIds": [
              "PHP.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PHP 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'okusibibwa kwange kulyoke kulabise Kristo eri olusiisira lwonna olw'abaserikale ba kabaka n'eri abalala bonna.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.13",
            "verseOrgIds": [
              "PHP.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHP 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'abooluganda mu Mukama waffe abasinga obungi beeyongedde okuguma olw'okusibibwa kwange, era nga bamaliridde okwaŋŋanga okubuulira nga tebatya.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.14",
            "verseOrgIds": [
              "PHP.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PHP 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weewaawo abamu bategeeza abantu Kristo lwa buggya na kuvuganya, naye abalala bakikola mu mwoyo mulungi.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.15",
            "verseOrgIds": [
              "PHP.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PHP 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano bakikola lwa kwagala, kubanga bamanyi nga nalondebwa lwa kulwanirira Njiri.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.16",
            "verseOrgIds": [
              "PHP.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PHP 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye bali bategeeza Kristo lwa kuvuganya, so si mu mazima, nga balowooza nti banaayongera okunnakuwaza mu busibe bwe ndimu.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.17",
            "verseOrgIds": [
              "PHP.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PHP 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nze nfaayo ki? Kristo bw'abuulirwa, mu buli ngeri, oba za bukuusa oba za mazima, nze nsanyuka busanyusi.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.18",
            "verseOrgIds": [
              "PHP.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "PHP 1:18"
      },
      "items": [
        {
          "text": "Era nzija kweyongera okusanyuka.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.18",
            "verseOrgIds": [
              "PHP.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PHP 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga mmanyi nti olw'okunsabira n'olw'amaanyi g'Omwoyo wa Yesu Kristo, ndifuna okulokolebwa kwange.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.19",
            "verseOrgIds": [
              "PHP.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PHP 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neesiga era nsubirira ddala nti sijja kuswala mu nsonga n'emu, wabula ne kaakano nzija kuguma nga bulijjo, Kristo agulumizibwe mu mubiri gwange, oba okuyita mu bulamu oba okuyita mu kufa.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.20",
            "verseOrgIds": [
              "PHP.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PHP 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nze mba mulamu lwa Kristo era ne bwe nfa mba ngobolodde.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.21",
            "verseOrgIds": [
              "PHP.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PHP 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye obanga bwe mba omulamu mu mubiri ng'ekyo kibala ky'okufuba kwange, simanyi kye nnaalondawo.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.22",
            "verseOrgIds": [
              "PHP.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PHP 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkwatiddwa buli luuyi; nneegomba okuva mu bulamu buno ŋŋende mbeere ne Kristo, kubanga ekyo kisingako obulungi.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.23",
            "verseOrgIds": [
              "PHP.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PHP 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye okusigala mu mubiri kye kisinga okwetaagibwa ku lwammwe",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.24",
            "verseOrgIds": [
              "PHP.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PHP 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyo nkikakasa era nkimanyi nti nzija kuba nga nkyaliwo mbeere nammwe, mulyoke mweyongere okusanyuka n'okukula mu kukkiriza,",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.25",
            "verseOrgIds": [
              "PHP.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PHP 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "bwe ndikomawo gye muli mulyoke mweyongere okwenyumiririza mu Kristo ku lwange.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.26",
            "verseOrgIds": [
              "PHP.1.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PHP 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye kirungi obulamu bwammwe bubeerenga nga bwe kisaanira Enjiri ya Kristo; ne bwe ndijja oba ne bwe sirijja kubalaba, mpulire nti muli banywevu era mwegasse mu mwoyo gumu, nga mulwanirira okukkiriza okw'enjiri n'emmeeme emu.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.27",
            "verseOrgIds": [
              "PHP.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PHP 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Temutyanga abo ababawakanya kubanga ke kabonero akakakasa nti balizikirizibwa, naye mmwe mulirokolebwa, era ekyo kiva eri Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.28",
            "verseOrgIds": [
              "PHP.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PHP 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga mwaweebwa omukisa, ku lwa Kristo, si mu kumukkiriza kyokka, naye n'okubonaabona ku lulwe.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.29",
            "verseOrgIds": [
              "PHP.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PHP 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olutalo lwe mwalaba nga nnwana, era lwe muwulira lwe ndiko kaakano, nammwe lwe muliko.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.30",
            "verseOrgIds": [
              "PHP.1.30"
            ]
          }
        }
      ]
    }
  ],
