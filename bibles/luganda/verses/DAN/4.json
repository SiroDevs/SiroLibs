  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "DAN 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekirooto kya Nebukadduneeza eky'Omuti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabaka Nebukadduneeza n'alangirira eri abantu, n'amawanga n'abantu ab'ennimi eza buli ngeri, mu nsi yonna bw'ati nti:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.1",
            "verseOrgIds": [
              "DAN.3.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo",
        "vid": "DAN 4:1"
      },
      "items": [
        {
          "text": "Emirembe gibeere nammwe!",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.1",
            "verseOrgIds": [
              "DAN.3.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lye ssanyu lyange okubategeeza ku bigambo eby'amagero era ebikulu Katonda Ali Waggulu Ennyo byankoledde.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.2",
            "verseOrgIds": [
              "DAN.3.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obubonero bwe nga bukulu,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 4:3"
      },
      "items": [
        {
          "text": "n'eby'amagero bye nga byewuunyisa!",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 4:3"
      },
      "items": [
        {
          "text": "Obwakabaka bwe bwa mirembe na mirembe;",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 4:3"
      },
      "items": [
        {
          "text": "N'okufuga kwe tekuliggwaawo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nze Nebukadduneeza, nnali mpumulidde mu maka gange wakati mu bugagga nga mpumuliddeko mu lubiri lwange.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.4",
            "verseOrgIds": [
              "DAN.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ndoota ekirooto ekyantiisa; bwe nnali nga ngalamidde ku kitanda kyange, ne ndaba ebifaananyi mu kwolesebwa, ebyantiisa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.5",
            "verseOrgIds": [
              "DAN.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyennava ndagira abasajja bonna abagezigezi ab'e Babulooni baleetebwe mu maaso gange bantegeeze amakulu g'ekirooto.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.6",
            "verseOrgIds": [
              "DAN.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalogo, n'abafumu, n'Abakaludaaya, n'abalaguzi ne bajja, ne mbategeeza ekirooto, naye ne balemwa okuntegeeza amakulu gaakyo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.7",
            "verseOrgIds": [
              "DAN.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye oluvannyuma Danyeri gwe natuuma Berutesazza ng'erinnya lya katonda wange bwe liri, era nga n'omwoyo ogwa bakatonda abatukuvu guli mu ye, n'ajja mu maaso gange ne mutegeeza ekirooto.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.8",
            "verseOrgIds": [
              "DAN.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mugamba nti, \"Berutesazza, omukulu w'abafumu, mmanyi ng'omwoyo ogwa bakatonda abatukuvu guli mu ggwe, so tewali kigambo eky'ekyama ekikuzibuwalira. Ntegeeza ekirooto kyange, n'amakulu gaakyo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.9",
            "verseOrgIds": [
              "DAN.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuno kwe kwolesebwa kwe nafunye nga ngalamidde ku kitanda kyange; nalabye omuti wakati mu nsi, nga muwanvu nnyo nnyini.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.10",
            "verseOrgIds": [
              "DAN.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuti ne gukula ne guba gwa maanyi, n'entikko yaagwo n'etuuka ku ggulu era nga gulengerwa okuva ku nkomerero y'ensi zonna.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.11",
            "verseOrgIds": [
              "DAN.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebikoola byagwo byali birungi okutunulako, n'ebibala byagwo nga bingi, era nga gulina emmere emala bonna. Ensolo enkambwe ez'omu nsiko zaatuulanga mu kisiikirize kyagwo, n'ennyonyi ez'omu bbanga zaatuulanga ku matabi gaagwo, na buli kiramu kyonna kyalisibwanga.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.12",
            "verseOrgIds": [
              "DAN.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Awo mu kiseera ekyo nga ngalamidde ku kitanda kyange, mu kwolesebwa, ne ndaba omubaka omutukuvu ng'ava mu ggulu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.13",
            "verseOrgIds": [
              "DAN.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ayogerera mu ddoboozi ery'omwanguka nti, 'Tema omuti, otemeko n'amatabi gaagwo; okunkumule amalagala gaagwo, osaasaanye n'ebibala byagwo, n'ennyonyi zibuuke zive ku matabi gaagwo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.14",
            "verseOrgIds": [
              "DAN.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ekikonge ky'ekikolo kyagwo kireke mu ttaka, nga kiriko ekyuma ekisiba n'ekikomo, mu muddo omuto ku ttale.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.15",
            "verseOrgIds": [
              "DAN.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "DAN 4:15"
      },
      "items": [
        {
          "text": "\" 'Muleke abisiwale n'omusulo ogw'omu ggulu, era muleke agabanire wamu omuddo, n'ensolo ez'omu nsiko.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.15",
            "verseOrgIds": [
              "DAN.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era n'amagezi ge ag'obuntu gakyusibwe, afuuke ng'ensolo enkambwe ey'omu nsiko okumala emyaka musanvu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.16",
            "verseOrgIds": [
              "DAN.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Omusango ogwo gulangiriddwa ababaka, abatukuvu be baasanguza ekisaliddwawo, abalamu balyoke bategeere ng'Oyo Ali Waggulu Ennyo y'afuga obwakabaka bw'abantu, era abuwa buli gw'asiima, era alonda abantu abasemberayo ddala okuba aba wansi okubafuga.'",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.17",
            "verseOrgIds": [
              "DAN.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ekyo kye kirooto, nze Kabaka Nebukadduneeza kye naloose. Kaakano ggwe Berutesazza, ntegeeza amakulu gaakyo kubanga tewali n'omu ku basajja abagezigezi mu bwakabaka bwange ayinza okuntegeeza amakulu gaakyo. Naye ggwe oyinza, kubanga omwoyo ogwa bakatonda abatukuvu guli mu ggwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.18",
            "verseOrgIds": [
              "DAN.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Danyeri Avvuunula Ekirooto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Danyeri eyayitibwanga Berutesazza n'atawanyizibwa mu mutima okumala akabanga, ne yeeraliikirira. Kabaka n'amugamba nti, \"Berutesazza, ekirooto n'amakulu gaakyo bireme okukweraliikiriza.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.19",
            "verseOrgIds": [
              "DAN.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "DAN 4:19"
      },
      "items": [
        {
          "text": "Berutesazza n'addamu nti, \"Mukama wange, ekirooto kibe nga kyogera ku abo abakukyawa, n'amakulu gaakyo gabe nga googera ku balabe bo!",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.19",
            "verseOrgIds": [
              "DAN.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuti gwe walaba, ogwakula ne guba gwa maanyi, ogwawanvuwa ne gutuuka ku ggulu, nga gulabibwa ensi yonna,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.20",
            "verseOrgIds": [
              "DAN.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ogwaliko amalagala amalungi n'ebibala byagwo nga bingi nnyo, era nga guliko n'emmere emala bonna, nga n'ensolo ez'omu nsiko zituula mu kisiikirize kyagwo, nga n'ennyonyi ez'omu bbanga zisiisira ku matabi gaagwo,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.21",
            "verseOrgIds": [
              "DAN.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ye ggwe, ayi kabaka! Okuze n'oba mukulu era n'oba w'amaanyi; n'obukulu bwo bweyongedde ne butuuka ku ggulu, n'obuyinza bwo butuuse ku nkomerero y'ensi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.22",
            "verseOrgIds": [
              "DAN.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ggwe ayi kabaka walabye omubaka, era omutukuvu ng'akka okuva mu ggulu, n'ayogera nti, 'Tema omuti oguzikirize, naye ekikonge ky'ekikolo kyagwo kireke mu ttaka ng'okisibye n'ekyuma n'ekikomo mu muddo omuto ogw'oku ttale; era muleke abisiwazibwe omusulo ogw'omu ggulu, n'omugabo gwe gubeere n'ensolo enkambwe ez'omu nsiko, emyaka musanvu.'",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.23",
            "verseOrgIds": [
              "DAN.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gano ge makulu, ayi kabaka, era lino lye tteeka Oyo Ali Waggulu Ennyo ly'alangiriridde mukama wange kabaka.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.24",
            "verseOrgIds": [
              "DAN.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oligobebwa okuva mu bantu era olibeera n'ensolo ez'omu nsiko; olirya omuddo ng'ente, era olibisiwala okumala emyaka musanvu okutuusa lw'olitegeera ng'Oyo Ali Waggulu Ennyo y'afuga obwakabaka bw'abantu, era abugabira buli gw'asiima.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.25",
            "verseOrgIds": [
              "DAN.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiragiro eky'okuleka ekikonge ky'ekikolo ky'omuti, amakulu gaakyo ge gano: obwakabaka bwo bulikuddizibwa bw'olitegeera ng'eggulu lye lifuga.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.26",
            "verseOrgIds": [
              "DAN.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo, ayi kabaka nteesa nti; weetoowaze olekeyo ebibi byo okole eby'obutuukirivu, era n'ebikolwa byo ebitali bya butuukirivu obireke obeere wa kisa eri abanyigirizibwa, olyoke ofuuke mugagga okusinga nga bw'oli kaakano.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.27",
            "verseOrgIds": [
              "DAN.4.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekirooto Kituukirira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyo byonna byatuukirira ku Kabaka Nebukadduneeza.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.28",
            "verseOrgIds": [
              "DAN.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DAN 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe wayitawo emyezi kkumi n'ebiri, kabaka yali atambulira ku kasolya k'olubiri lwe olwa Babulooni,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.29",
            "verseOrgIds": [
              "DAN.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DAN 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ayogera nti, \"Ono si ye Babulooni omukulu gwe nazimba n'amaanyi gange amangi okuba ekibuga ekikulu eky'ekitiibwa eky'obwakabaka bwange?\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.30",
            "verseOrgIds": [
              "DAN.4.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DAN 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo bwe yali ng'akyayogera, eddoboozi ne liva mu ggulu nga ligamba nti, \"Kuno kwe kulangirira okukukwatako Kabaka Nebukadduneeza: obwakabaka bwo bukuggyiddwako.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.31",
            "verseOrgIds": [
              "DAN.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DAN 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oligobebwa mu bantu era olibeera n'ensolo okumala emyaka musanvu okutuusa lw'olitegeera ng'Oyo Ali Waggulu ennyo y'afuga obwakabaka obw'abantu era abuwa buli gw'asiima.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.32",
            "verseOrgIds": [
              "DAN.4.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DAN 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amangwago ebyayogerwa ku Nebukadduneeza ne bituukirira. N'agobebwa mu bantu era n'alya omuddo ng'ente. Omubiri gwe ne gutoba omusulo ogw'omu ggulu okutuusa enviiri ze lwe zaakula ng'ebyoya by'empungu n'enjala ze ng'enjala z'ennyonyi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.33",
            "verseOrgIds": [
              "DAN.4.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DAN 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oluvannyuma lw'ebbanga eryo, nze, Nebukadduneeza, ne nnyimusa amaaso gange eri eggulu, amagezi gange ne gakomawo. Ne ntendereza Oyo Ali Waggulu Ennyo, ne muwa ekitiibwa ne mugulumiza oyo abeera omulamu emirembe n'emirembe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.34",
            "verseOrgIds": [
              "DAN.4.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1",
        "vid": "DAN 4:34"
      },
      "items": [
        {
          "text": "Okufuga kwe tekuliggwaawo,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 4:34"
      },
      "items": [
        {
          "text": "n'obwakabaka bwe bwa mirembe na mirembe.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DAN 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bonna ab'oku nsi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 4:35"
      },
      "items": [
        {
          "text": "abalaba nga si kintu,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1",
        "vid": "DAN 4:35"
      },
      "items": [
        {
          "text": "eggye ery'omu ggulu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 4:35"
      },
      "items": [
        {
          "text": "n'abantu ab'oku nsi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 4:35"
      },
      "items": [
        {
          "text": "abayisa nga bw'asiima.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1",
        "vid": "DAN 4:35"
      },
      "items": [
        {
          "text": "Tewali ayinza okumuziyiza,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 4:35"
      },
      "items": [
        {
          "text": "newaakubadde okumubuuza nti, \"Okola ki?\"",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DAN 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kiseera kyekimu okutegeera kwange ne kukomawo, n'ekitiibwa n'obuyinza obw'obwakabaka bwange ne bunzirira. Abawi b'amagezi bange n'abakungu bange ne bannoonya, ne banziriza entebe yange ey'obwakabaka ne nnyongerwako obukulu bungi okusinga ne bwe nalina.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.36",
            "verseOrgIds": [
              "DAN.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DAN 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale nze Nebukadduneeza kyennaava mmutendereza era ne mmuwa ekitiibwa ne mmugulumiza Kabaka ow'eggulu, kubanga emirimu gye gyonna gya mazima n'amakubo ge ga nsonga, n'abo ab'amalala abakkakkanya.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.37",
            "verseOrgIds": [
              "DAN.4.34"
            ]
          }
        }
      ]
    }
  ],
