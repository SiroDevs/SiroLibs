          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekire ne bwe kyabeeranga waggulu wa Weema okumala ennaku ebbiri oba omwezi, abaana ba Isirayiri nga babeera awo mu lusiisira lwabwe nga tebasitula kutambula; naye bwe kyaggyibwangawo ng'olwo basitula okutambula.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.22",
            "verseOrgIds": [
              "NUM.9.22"
            ]
          }
        },
