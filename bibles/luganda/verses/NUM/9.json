              "type": "text"
            }
          ]
        },
        {
          "text": "Oluusi ekire kyabeerangawo okuva akawungeezi okutuusa mu makya; naye ekire bwe kyaggyibwangawo mu makya, ng'olwo basitula okutambula; oba bwe kyasigalangawo olunaku n'ekiro kyonna oluvannyuma ne kiggyibwawo, ng'olwo basitula okutambula.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.21",
            "verseOrgIds": [
              "NUM.9.21"
            ]
          }
        },
        {
