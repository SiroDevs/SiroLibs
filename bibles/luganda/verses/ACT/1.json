              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ne balonda abasajja babiri, omu nga ye Yusufu (eyayitibwanga Balusaba ate era nga ye Yusito), n'owokubiri nga ye Matiya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.23",
            "verseOrgIds": [
              "ACT.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne balyoka basaba ne bagamba nti, \"Ayi Mukama, gw'omanyi emitima gy'abantu bonna, tulage gw'olonze ku bantu bano ababiri,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.24",
            "verseOrgIds": [
              "ACT.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
