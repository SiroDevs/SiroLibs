          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oluvannyuma ne bakuba akalulu, ne kagwa ku Matiya, n'agattibwa ku batume ekkumi n'omu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.26",
