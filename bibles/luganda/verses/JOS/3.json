  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "JOS 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abayisirayiri Beeteekerateekera Okusomoka Omugga Yoludaani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu makya ennyo Yoswa n'Abayisirayiri bonna ne bagolokoka okuva e Sittimu, bwe baatuuka ku mugga Yoludaani ne basooka balindirira awo nga tebannagusomoka.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.1",
            "verseOrgIds": [
              "JOS.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe waayitawo ennaku ssatu abakulembeze baabwe ne babayitaayitamu",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.2",
            "verseOrgIds": [
              "JOS.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nga bwe babalagira nti, \"Bwe munaalaba Essanduuko ey'Endagaano ya",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.3",
            "verseOrgIds": [
              "JOS.3.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.3.3",
                "verseOrgIds": [
                  "JOS.3.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wammwe, bakabona Abaleevi nga bagisitudde ne mulyoka muva mu kifo kino ne mugigoberera,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.3",
            "verseOrgIds": [
              "JOS.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubanga lino ekkubo temuliyitangamu. Naye wakati wammwe nayo, mulekawo ebbanga nga lya fuuti enkumi ssatu muleme okugisemberera.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.4",
            "verseOrgIds": [
              "JOS.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yoswa n'agamba Abayisirayiri nti, \"Mwetukuze kubanga enkya",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.5",
            "verseOrgIds": [
              "JOS.3.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.3.5",
                "verseOrgIds": [
                  "JOS.3.5"
                ]
              }
            }
          ]
        },
        {
          "text": "anaakola ebyamagero mu mmwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.5",
            "verseOrgIds": [
              "JOS.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate Yoswa n'agamba bakabona nti, \"Musitule Essanduuko ey'Endagaano era mukulemberemu abantu babagoberere.\" Bakabona nabo ne bakola nga Yoswa bwe yabalagira.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.6",
            "verseOrgIds": [
              "JOS.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asuubiza Yoswa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.3.7",
                "verseOrgIds": [
                  "JOS.3.7"
                ]
              }
            }
          ]
        },
        {
          "text": "n'agamba Yoswa nti, \"Olwa leero ŋŋenda okukugulumiza mu maaso g'Abayisirayiri bonna balyoke bamanye nti nga bwe nnali ne Musa, era bwe ntyo bwe ndi naawe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.7",
            "verseOrgIds": [
              "JOS.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'otyo onoolagira bakabona abasitula Essanduuko ey'Endagaano nti bwe mutuuka ku mugga Yoludaani, muyimirire buyimirizi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.8",
            "verseOrgIds": [
              "JOS.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoswa n'ayita Abayisirayiri nti, \"Musembere wano muwulire ebigambo bya",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.9",
            "verseOrgIds": [
              "JOS.3.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.3.9",
                "verseOrgIds": [
                  "JOS.3.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wammwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.9",
            "verseOrgIds": [
              "JOS.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa leero mugenda okutegeera nti Katonda omulamu ali mu mmwe, kubanga anaagobera ddala Abakanani, n'Abakiiti, n'Abakiivi, n'Abaperezi, n'Abagirugaasi, n'Abamoli, n'Abayebusi mmwe nga mulaba.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.10",
            "verseOrgIds": [
              "JOS.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laba, Essanduuko ey'Endagaano ya Mukama w'ensi zonna y'eneebakulemberamu nga musomoka omugga guno Yoludaani.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.11",
            "verseOrgIds": [
              "JOS.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale nno mulonde abasajja kkumi na babiri okuva mu bika bya Isirayiri nga buli kika mulondamu omu omu:",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.12",
            "verseOrgIds": [
              "JOS.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakabona abasitudde Essanduuko ya",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.13",
            "verseOrgIds": [
              "JOS.3.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.3.13",
                "verseOrgIds": [
                  "JOS.3.13"
                ]
              }
            }
          ]
        },
        {
          "text": "w'ensi zonna, olunaalinnya ebigere byabwe mu mugga Yoludaani, amazzi agabadde gakulukuta gonna ganaayimirira ne geetuuma.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.13",
            "verseOrgIds": [
              "JOS.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayisa Abayisirayiri mu Mugga Yoludaani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Abayisirayiri ne basimbula weema zaabwe okusomoka Yoludaani nga bakulembeddwamu bakabona abasitudde Essanduuko y'Endagaano.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.14",
            "verseOrgIds": [
              "JOS.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugga Yoludaani gwanjaala mu kiseera eky'amakungula kyonna. Mu kiseera ekyo bakabona abasitudde Essanduuko we baalinnyira ebigere byabwe ku Yoludaani.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.15",
            "verseOrgIds": [
              "JOS.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amangwago amazzi agaali gakulukuta ne gayimirira ne geetuuma eri ewala okuliraana ekibuga Adamu ku ludda lwa Zaresaani. N'ago agaali gaserengeta okweyiwa mu Araba Ennyanja ey'Omunnyo ne gasalikako, abantu ne basomokera Yoludaani ku ttaka ekkalu, mu maaso ga Yeriko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.16",
            "verseOrgIds": [
              "JOS.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakabona abasitudde Essanduuko ya",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.17",
            "verseOrgIds": [
              "JOS.3.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.3.17",
                "verseOrgIds": [
                  "JOS.3.17"
                ]
              }
            }
          ]
        },
        {
          "text": "ne bayimirira wakati mu Yoludaani awatakyali mazzi okutuusa Abayisirayiri bonna lwe baasomoka.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.17",
            "verseOrgIds": [
              "JOS.3.17"
            ]
          }
        }
      ]
    }
  ],
