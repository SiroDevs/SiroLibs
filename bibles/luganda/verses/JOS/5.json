  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "JOS 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo bakabaka ba ab'Amoli abaali emitala ebugwanjuba bw'omugga Yoludaani, ne bakabaka b'Abakanani abaliraanye ennyanja bwe baawulira nga",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.1",
            "verseOrgIds": [
              "JOS.5.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.5.1",
                "verseOrgIds": [
                  "JOS.5.1"
                ]
              }
            }
          ]
        },
        {
          "text": "yakaliza amazzi g'omugga Yoludaani Abayisirayiri basobole okusomoka, ne batekemuka omwoyo olw'Abayisirayiri.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.1",
            "verseOrgIds": [
              "JOS.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yoswa Akomola Abayisirayiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kiseera ekyo",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.2",
            "verseOrgIds": [
              "JOS.5.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.5.2",
                "verseOrgIds": [
                  "JOS.5.2"
                ]
              }
            }
          ]
        },
        {
          "text": "n'agamba Yoswa nti, \"Weekolere obwambe obw'amayinja amoogi, okomole abasajja bonna Abayisirayiri abatakomolwanga.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.2",
            "verseOrgIds": [
              "JOS.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'atyo Yoswa n'akola obwambe mu mayinja amoogi n'akomolera abasajja Abayisirayiri ku lusozi oluyitibwa Gibeyakalaloosi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.3",
            "verseOrgIds": [
              "JOS.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensonga Yoswa kyeyava abakomola y'eno: abasajja Abayisirayiri abaava e Misiri nga mwe muli n'abalwanyi bonna, baafiira mu ddungu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.4",
            "verseOrgIds": [
              "JOS.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaava e Misiri bonna baali bamaze okukomolebwa, kyokka abaana baabwe abaazaalirwa mu ddungu tebaali bakomole.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.5",
            "verseOrgIds": [
              "JOS.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayisirayiri baamala emyaka amakumi ana nga batambula mu ddungu okutuusa bonna, nga mwe muli n'abalwanyi, lwe baafa ne baggwaawo, kubanga baagaana okugondera eddoboozi lya",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.6",
            "verseOrgIds": [
              "JOS.5.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.5.6",
                "verseOrgIds": [
                  "JOS.5.6"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.6",
            "verseOrgIds": [
              "JOS.5.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.5.6",
                "verseOrgIds": [
                  "JOS.5.6"
                ]
              }
            }
          ]
        },
        {
          "text": "kyeyava abalayirira nti talibaganya kutuuka mu nsi eyo gye yasuubiza bajjajjaabwe, ensi ekulukuta amata n'omubisi gw'enjuki.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.6",
            "verseOrgIds": [
              "JOS.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale mu bifo byabwe",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.7",
            "verseOrgIds": [
              "JOS.5.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.5.7",
                "verseOrgIds": [
                  "JOS.5.7"
                ]
              }
            }
          ]
        },
        {
          "text": "yazzaawo baana baabwe era abo Yoswa be yakomola kubanga tebaakomolerwa mu kkubo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.7",
            "verseOrgIds": [
              "JOS.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonna nga bamaze okukomolwa tebaava mu weema zaabwe mu lusiisira, okutuusa nga bamaze okuwona.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.8",
            "verseOrgIds": [
              "JOS.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.5.9",
                "verseOrgIds": [
                  "JOS.5.9"
                ]
              }
            }
          ]
        },
        {
          "text": "n'agamba Yoswa nti, \"Okuva olwa leero mbaggyeeko ekivume ky'e Misiri.\" Ekifo ekyo kyekyava kiyitibwa Girugaali n'okutuusa kaakano.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.9",
            "verseOrgIds": [
              "JOS.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abayisirayiri Bakwata Okuyitako e Girugaali",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Abayisirayiri bwe baali bakyasiisidde e Girugaali embaga ey'Okuyitako n'etuuka era ne bagirya akawungeezi ku lunaku olw'ekkumi n'ennya olw'omwezi, mu lusenyi lw'e Yeriko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.10",
            "verseOrgIds": [
              "JOS.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enkeera ne balya emmere ey'omu nsi y'e Kanani: emigaati egitali mizimbulukuse n'empeke ensiike.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.11",
            "verseOrgIds": [
              "JOS.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okuva ku lunaku olwo lwe baalya ku mmere y'omu Kanani tebaddamu kufuna Maanu; olwo ne batandika kulyanga mmere ya mu nsi eyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.12",
            "verseOrgIds": [
              "JOS.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yoswa Asisinkana Omukulu w'Eggye lya",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yoswa bwe yali anaatera okutuuka e Yeriko bwe yayimusa amaaso n'alaba omusajja akutte ekitala ekisowole ng'amwolekedde. Yoswa kyeyava amusemberera n'amubuuza nti, \"Oli ku ludda lwaffe oba ku lwa balabe baffe?\" Ye n'amuddamu nti,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.13",
            "verseOrgIds": [
              "JOS.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Siriiko ludda. Nze mukulu w'eggye lya",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.14",
            "verseOrgIds": [
              "JOS.5.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.5.14",
                "verseOrgIds": [
                  "JOS.5.14"
                ]
              }
            }
          ]
        },
        {
          "text": "era ntuuse.\" Yoswa n'agwa wansi, n'avuunama n'amusinza era n'amubuuza nti, \"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.14",
            "verseOrgIds": [
              "JOS.5.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.5.14",
                "verseOrgIds": [
                  "JOS.5.14"
                ]
              }
            }
          ]
        },
        {
          "text": "wange, oŋŋamba ki omuddu wo?\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.14",
            "verseOrgIds": [
              "JOS.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omukulu w'eggye lya",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.15",
            "verseOrgIds": [
              "JOS.5.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.5.15",
                "verseOrgIds": [
                  "JOS.5.15"
                ]
              }
            }
          ]
        },
        {
          "text": "n'amuddamu nti, \"Yambulamu engatto zo kubanga ekifo kino mw'oli kitukuvu.\" Ne Yoswa naye n'akola nga bwe yalagirwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.15",
            "verseOrgIds": [
              "JOS.5.15"
            ]
          }
        }
      ]
    }
  ],
