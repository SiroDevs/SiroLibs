              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mukama we n'amugamba nti, 'Weebale, oli muddu mulungi era mwesigwa, obadde mwesigwa mu bintu ebitono, ndikusigira ebintu ebingi. Yingira osanyukire wamu ne mukama wo.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.23",
                "verseOrgIds": [
                  "MAT.25.23"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
