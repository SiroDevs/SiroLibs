              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kabaka, alibaddamu nti, 'Ddala ddala mbagamba nti bwe mwabikolera baganda bange bano abasembayo wansi kye kimu mwabikolera nze!'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.40",
                "verseOrgIds": [
                  "MAT.25.40"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 25:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Bw'atyo aligamba abo abali ku mukono gwe ogwa kkono nti, 'Muveewo, mmwe abakolimire, mulage mu muliro ogutazikira ogwateekerwateekerwa Setaani ne bamalayika be.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.41",
                "verseOrgIds": [
                  "MAT.25.41"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.41",
            "verseOrgIds": [
              "MAT.25.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 25:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kubanga nnali muyala ne mutampa kyakulya, nnali muyonta ne mutampa kyakunywa,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.42",
                "verseOrgIds": [
                  "MAT.25.42"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.42",
            "verseOrgIds": [
              "MAT.25.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 25:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "nnali mugenyi ne mutannyaniriza, nnali bwereere ne mutannyambaza, nnali mulwadde ne mu kkomera ne mutajja kunnambula.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.43",
                "verseOrgIds": [
                  "MAT.25.43"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 25:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nabo baliddamu nti, 'Mukama waffe, twakulaba ddi ng'oli muyala oba ng'oli muyonta, oba ng'oli mugenyi oba ng'oli bwereere oba mulwadde oba ng'oli mu kkomera, ne tutakuyamba?'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.44",
                "verseOrgIds": [
                  "MAT.25.44"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 25:45"
          },
          "items": [
