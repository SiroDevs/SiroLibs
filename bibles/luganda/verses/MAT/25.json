          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"N'alagira nti, 'Mumuggyeeko ettalanta eyo mugiwe oli alina ttalanta ekkumi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.28",
                "verseOrgIds": [
                  "MAT.25.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
