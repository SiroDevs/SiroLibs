          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "wanditadde ensimbi zange mu bbanka gye bandimpaddemu amagoba nga nkomyewo.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.27",
                "verseOrgIds": [
                  "MAT.25.27"
                ]
              }
            }
