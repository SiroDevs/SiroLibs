        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Naye alibaddamu nti, 'ddala ddala mbagamba nti, nga bwe mutaakikola omu ku bano abasembayo wansi, nange temwakinkola.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.45",
