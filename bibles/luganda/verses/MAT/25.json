          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Naye mukama we n'amugamba nti, 'Ggwe omuddu omubi era omugayaavu! Obanga wamanya nti ndi muntu akungulira gye ssaasigira,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.26",
                "verseOrgIds": [
                  "MAT.25.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.26",
            "verseOrgIds": [
              "MAT.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
