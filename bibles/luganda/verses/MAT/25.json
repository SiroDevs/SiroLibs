          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Omusajja eyalekerwa ttalanta emu n'ajja, n'agamba nti, 'Ssebo, nakumanya nga bw'oli omuntu omuzibu, okungulira gy'otaasigira era okuŋŋaanyiza gy'otaasaasaanyiza.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.24",
                "verseOrgIds": [
                  "MAT.25.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.24",
            "verseOrgIds": [
              "MAT.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Olw'okutya bwe wagenda ne nkweka ttalanta yo mu ttaka era yiino ttalanta yo.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.25",
                "verseOrgIds": [
                  "MAT.25.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
