          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kubanga alina aliweebwa abe na bingi naye atalina, n'ebyo by'alina ebitono birimuggyibwako.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.29",
                "verseOrgIds": [
                  "MAT.25.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
