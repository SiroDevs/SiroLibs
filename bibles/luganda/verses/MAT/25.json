          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "N'omuddu oyo ataliiko ky'agasa mumusuule ebweru mu kizikiza eri okukaaba n'okuluma obujiji.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.30",
