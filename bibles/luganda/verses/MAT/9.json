{
  "id": "MAT.9",
  "number": "9",
  "bookId": "MAT",
  "reference": "Matayo 9",
  "copyright": "Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™ Obwannannyini© 1984, 1986, 1993, 2014 bwa Biblica, Inc. Biblica® Open Luganda Contemporary Bible™ Copyright © 1984, 1986, 1993, 2014 by Biblica, Inc. \"Biblica\" Linnya ery'obwannannyini eryawandiisibwa Biblica mu Amerika era nga balina n'ekkakkalabozo, Inc. Bwaweebwa olukusa okulikozesa. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "MAT 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Awonya eyali Akoozimbye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu n'asaabala mu lyato n'awunguka n'atuuka mu kibuga ky'ewaabwe, Kaperunawumu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.1",
            "verseOrgIds": [
              "MAT.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amangwago ne bamuleetera omuntu eyali akoozimbye nga bamusitulidde ku katanda. Bwe yalaba okukkiriza kwabwe n'agamba omulwadde nti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.2",
            "verseOrgIds": [
              "MAT.9.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mwana wange, guma omwoyo, nkusonyiye ebibi byo!\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.2",
                "verseOrgIds": [
                  "MAT.9.2"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye waaliwo abamu ku bannyonnyozi b'amateeka ne boogeraganya bokka na bokka nti, \"Omuntu ono avvoola! Alowooza nti Ye Katonda!\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.3",
            "verseOrgIds": [
              "MAT.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'amanya bye balowooza. N'abagamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.4",
            "verseOrgIds": [
              "MAT.9.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Lwaki mubeera n'ebirowoozo ebibi mu mitima gyammwe?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.4",
                "verseOrgIds": [
                  "MAT.9.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.4",
            "verseOrgIds": [
              "MAT.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ekyo buli muntu ayinza okukyogera, kubanga kwogera bwogezi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.5",
                "verseOrgIds": [
                  "MAT.9.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.5",
            "verseOrgIds": [
              "MAT.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye mutegeere nga Omwana w'Omuntu alina obuyinza ku nsi okusonyiwa ebibi.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.6",
                "verseOrgIds": [
                  "MAT.9.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Awo n'agamba akoozimbye nti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.6",
            "verseOrgIds": [
              "MAT.9.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Yimirira weetikke akatanda ko, weddireyo ewammwe!\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.6",
                "verseOrgIds": [
                  "MAT.9.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.6",
            "verseOrgIds": [
              "MAT.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ayimirira ng'awonye, ne yeddirayo eka.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.7",
            "verseOrgIds": [
              "MAT.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye abantu abaali mu bibiina bwe baalaba ekyamagero kino ne beewuunya nnyo! Ne bagulumiza Katonda eyawa abantu obuyinza obwenkaniddaawo!",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.8",
            "verseOrgIds": [
              "MAT.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okuyitibwa kwa Matayo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu bwe yava mu kifo ekyo n'alaba omuntu, erinnya lye Matayo, ng'atudde mu kifo we basolooleza omusolo, n'amugamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.9",
            "verseOrgIds": [
              "MAT.9.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ngoberera.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.9",
                "verseOrgIds": [
                  "MAT.9.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Bw'atyo naye n'asitukiramu n'agoberera Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.9",
            "verseOrgIds": [
              "MAT.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu bwe yali ng'atudde ku mmere mu nnyumba ya Matayo, abawooza bangi n'abantu abaali bamanyiddwa mu kitundu ekyo nti babi ne bajja ne batuula naye n'abayigirizwa be ku mmere ne balya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.10",
            "verseOrgIds": [
              "MAT.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Abafalisaayo bwe baakiraba, ne bagamba abayigirizwa be nti, \"Lwaki Mukama wammwe alya n'abawooza n'abantu abalina ebibi?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.11",
            "verseOrgIds": [
              "MAT.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu bwe yawulira n'abaddamu nti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.12",
            "verseOrgIds": [
              "MAT.9.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Abalamu tebeetaaga musawo wabula abalwadde.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.12",
                "verseOrgIds": [
                  "MAT.9.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.12",
            "verseOrgIds": [
              "MAT.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mugende muyige amakulu g'Ekyawandiikibwa kino nti, 'Ssaddaaka zammwe n'ebirabo byammwe si bye neetaaga, wabula neetaaga mubeerenga ba kisa.' Najjirira kuyita boonoonyi, so sajjirira abo abeerowooza nti batuukirivu.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.13",
                "verseOrgIds": [
                  "MAT.9.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwali lumu abayigirizwa ba Yokaana ne bajja eri Yesu ne bamubuuza nti, \"Lwaki abayigirizwa bo tebasiiba nga ffe n'Abafalisaayo bwe tukola?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.14",
            "verseOrgIds": [
              "MAT.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'ababuuza nti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.15",
            "verseOrgIds": [
              "MAT.9.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mikwano gy'omugole bayinza okunakuwala ng'omugole akyali nabo? Naye ekiseera kirituuka omugole lwalibaggibwako. Olwo nno balisiiba.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.15",
                "verseOrgIds": [
                  "MAT.9.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Tewali muntu atunga kiwero kiggya mu lugoye lukadde, kubanga, ekiwero bwe kyetugga kiyuza olugoye olukadde, n'ekituli ne kigaziwa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.16",
                "verseOrgIds": [
                  "MAT.9.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.16",
            "verseOrgIds": [
              "MAT.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Era tewali ateeka wayini musu mu nsawo ez'amaliba enkadde. Ensawo",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.17",
                "verseOrgIds": [
                  "MAT.9.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.17",
            "verseOrgIds": [
              "MAT.9.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "enkadde zaabika wayini n'ayiika n'ensawo ne zoonooneka. Wayini omusu bamuteeka mu nsawo z'amaliba maggya, byombi ne bitayonooneka.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.17",
                "verseOrgIds": [
                  "MAT.9.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe yali ng'akyayogera nabo omufuzi n'ajja, n'amusinza n'amugamba nti, \"Omwana wange omuwala anfuddeko, naye singa ojja n'omukwatako anaalamuka.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.18",
            "verseOrgIds": [
              "MAT.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu bwe yasituka n'abayigirizwa be okugenda mu maka g'omukulu w'ekkuŋŋaaniro,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.19",
            "verseOrgIds": [
              "MAT.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "omukazi eyali alwadde ekikulukuto ky'omusaayi, okumala emyaka kkumi n'ebiri, n'ajja emabega we n'akoma ku lukugiro lw'ekyambalo kye.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.20",
            "verseOrgIds": [
              "MAT.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga y'agamba mu mutima gwe nti, \"Ne bwe nnaakoma obukomi ku kyambalo kye nnaawona.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.21",
            "verseOrgIds": [
              "MAT.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'akyuka n'alaba omukazi n'amugamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.22",
            "verseOrgIds": [
              "MAT.9.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Muwala, guma omwoyo! Owonye olw'okukkiriza kwo.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.22",
                "verseOrgIds": [
                  "MAT.9.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Omukazi n'awonera mu kiseera ekyo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.22",
            "verseOrgIds": [
              "MAT.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu bwe yatuuka mu maka g'omufuzi n'asanga abafuuyi b'amakondeere n'ekibiina nga kijagaladde,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.23",
            "verseOrgIds": [
              "MAT.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.24",
            "verseOrgIds": [
              "MAT.9.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mufulume kubanga omuwala tafudde wabula yeebase bwebasi.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.24",
                "verseOrgIds": [
                  "MAT.9.24"
                ]
              }
            }
          ]
        },
        {
          "text": "Bonna ne bamusekerera nga bwe beesooza.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.24",
            "verseOrgIds": [
              "MAT.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye abantu bwe bamala okufuluma, Yesu n'ayingira, n'akwata omukono gw'omuwala, n'agolokosa omuwala.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.25",
            "verseOrgIds": [
              "MAT.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebigambo ebyo ne bibuna mu kitundu ekyo kyonna.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.26",
            "verseOrgIds": [
              "MAT.9.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Awonya Bamuzibe ne Bakiggala",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu bwe yava eyo, abazibe b'amaaso babiri ne bamugoberera nga bwe baleekaana nti, \"Ayi Omwana wa Dawudi, otusaasire!\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.27",
            "verseOrgIds": [
              "MAT.9.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe yatuuka mu nju, bamuzibe ne bajja w'ali. Yesu n'ababuuza nti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.28",
            "verseOrgIds": [
              "MAT.9.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mukkiriza nga nnyinza okubazibula amaaso?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.28",
                "verseOrgIds": [
                  "MAT.9.28"
                ]
              }
            }
          ]
        },
        {
          "text": "Ne bamuddamu nti, \"Weewaawo, Mukama waffe.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.28",
            "verseOrgIds": [
              "MAT.9.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo n'akoma ku maaso gaabwe n'abagamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.29",
            "verseOrgIds": [
              "MAT.9.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kale, olw'okukkiriza kwammwe, kye musabye mukiweereddwa.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.29",
                "verseOrgIds": [
                  "MAT.9.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.29",
            "verseOrgIds": [
              "MAT.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amangwago amaaso gaabwe ne gazibuka. Yesu n'abakuutira nnyo baleme kubuulirako muntu yenna ng'abagamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.30",
            "verseOrgIds": [
              "MAT.9.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mulabe nga tewaba n'omu ategeera bibaddewo.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.30",
                "verseOrgIds": [
                  "MAT.9.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.30",
            "verseOrgIds": [
              "MAT.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye bwe baava awo, ne bagenda nga basaasaanya ebigambo ebyo, nga babuulira buli muntu gwe baasisinkananga mu kitundu ekyo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.31",
            "verseOrgIds": [
              "MAT.9.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu ne be yali nabo, bwe baali bafuluma ne bamuleetera kiggala eyali tayogera kubanga yaliko dayimooni.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.32",
            "verseOrgIds": [
              "MAT.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'amugobako dayimooni, era amangwago abadde kiggala n'ayogera. Ekibiina ky'abantu ne beewuunya nnyo nga bagamba nti, \"Kino tekibangawo mu Isirayiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.33",
            "verseOrgIds": [
              "MAT.9.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Abafalisaayo ne bagamba nti, \"Agoba baddayimooni lwa kubanga ye mukulu wa baddayimooni!\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.34",
            "verseOrgIds": [
              "MAT.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'agenda ng'ayita mu bibuga byonna eby'omu kitundu ekyo, ne mu byalo ng'ayigiriza mu makuŋŋaaniro gaabwe, era ng'abuulira Enjiri ey'obwakabaka. Era buli we yatuukanga n'awonya abalwadde n'abakoozimbye bonna.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.35",
            "verseOrgIds": [
              "MAT.9.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo bwe yatunuulira ekibiina ky'abantu nga bajja gy'ali, nga bakooye nnyo, era nga basaasaanye ng'endiga ezitalina musumba, n'abasaasira nnyo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.36",
            "verseOrgIds": [
              "MAT.9.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'agamba abayigirizwa be nti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.37",
            "verseOrgIds": [
              "MAT.9.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Eby'okukungula bingi nnyo, naye abakozi abakungula batono.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.37",
                "verseOrgIds": [
                  "MAT.9.37"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.37",
            "verseOrgIds": [
              "MAT.9.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Noolwekyo musabe nannyini nnimiro, aweereze abakozi mu nnimiro ye.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.38",
                "verseOrgIds": [
                  "MAT.9.38"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
