  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "MAT 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omukulu mu Bwakabaka obw'Omu Ggulu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kiseera ekyo abayigirizwa ba Yesu ne bajja gy'ali nga bagamba nti, \"Ani asinga obukulu mu bwakabaka obw'omu ggulu?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.1",
            "verseOrgIds": [
              "MAT.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'ayita omwana omuto n'amussa mu makkati gaabwe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.2",
            "verseOrgIds": [
              "MAT.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'abagamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.3",
            "verseOrgIds": [
              "MAT.18.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ddala ddala mbagamba nti bwe mutakyuke kufaanana ng'abaana abato temugenda kuyingira mu bwakabaka obw'omu ggulu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.3",
                "verseOrgIds": [
                  "MAT.18.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.3",
            "verseOrgIds": [
              "MAT.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Noolwekyo buli eyeetoowaza ng'omwana ono omuto y'aliba asinga obukulu mu bwakabaka obw'omu ggulu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.4",
                "verseOrgIds": [
                  "MAT.18.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Na buli asembeza omwana omuto ng'ono mu linnya lyange ng'asembeza Nze.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.5",
                "verseOrgIds": [
                  "MAT.18.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.5",
            "verseOrgIds": [
              "MAT.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye alyesittaza omu ku baana abato anzikiririzaamu, asaanidde okusibibwa olubengo mu bulago asuulibwe mu nnyanja.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.6",
                "verseOrgIds": [
                  "MAT.18.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ensi zigisanze! Kubanga ejjudde ebibi bingi. Okukemebwa okukola ebibi tekulema kubaawo, naye zimusanze oyo akuleeta.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.7",
                "verseOrgIds": [
                  "MAT.18.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.7",
            "verseOrgIds": [
              "MAT.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Obanga omukono gwo gukuleetera okwonoona gutemeko ogusuule. Kisinga okuyingira mu bulamu ng'ogongobadde oba ng'olemadde, okusinga okugenda mu muliro ogutazikira ng'olina emikono ebiri n'ebigere bibiri.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.8",
                "verseOrgIds": [
                  "MAT.18.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.8",
            "verseOrgIds": [
              "MAT.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Obanga eriiso lyo nga likuleetera okwonoona, liggyeemu olisuule. Kisinga okuyingira mu ggulu ng'olina eriiso limu okusinga okusuulibwa mu muliro gwa ggeyeena ng'olina amaaso go gombi.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.9",
                "verseOrgIds": [
                  "MAT.18.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Olugero lw'Endiga Eyabula",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mwekuume obutanyoomanga n'omu ku baana bano abato. Kubanga mbagamba nti bamalayika baabwe ennaku zonna babeera mu maaso ga Kitange ali mu ggulu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.10",
                "verseOrgIds": [
                  "MAT.18.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.10",
            "verseOrgIds": [
              "MAT.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kubanga Omwana w'Omuntu yajja okulokola ekyabula",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.11",
                "verseOrgIds": [
                  "MAT.18.11"
                ]
              }
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": ".",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.11",
                "verseOrgIds": [
                  "MAT.18.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mulowooza kiki ekituufu? Omuntu bw'aba n'endiga ze ekikumi, emu n'emubulako, taleka ziri ekyenda mu omwenda ku lusozi n'agenda anoonya eri emu ebuze?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.12",
                "verseOrgIds": [
                  "MAT.18.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.12",
            "verseOrgIds": [
              "MAT.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ddala ddala mbagamba nti, bw'agiraba agisanyukira nnyo okusinga ziri ekyenda mu omwenda ezitaabuze.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.13",
                "verseOrgIds": [
                  "MAT.18.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.13",
            "verseOrgIds": [
              "MAT.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kale bwe kityo ne Kitammwe ali mu ggulu tasiima kulaba ng'omu ku bato bano ng'azikirira.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.14",
                "verseOrgIds": [
                  "MAT.18.14"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Owooluganda Okusonyiwa Muganda we",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Muganda wo bw'akusobyanga ogendanga gy'ali n'omutegeeza ekisobyo kye nga muli babiri. Bw'akkirizanga n'akwetondera olwo ng'oggyeemu omuntu mu muganda wo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.15",
                "verseOrgIds": [
                  "MAT.18.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.15",
            "verseOrgIds": [
              "MAT.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye bw'agaananga okukuwuliriza, ofunangayo omuntu omulala omu oba babiri obujulirwa bw'abantu ababiri oba abasatu bukakase buli kigambo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.16",
                "verseOrgIds": [
                  "MAT.18.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.16",
            "verseOrgIds": [
              "MAT.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye bw'agaananga okubawuliriza ng'ensonga ozitwala eri Ekkanisa. Singa agaana okuwuliriza Ekkanisa, abeere nga munnaggwanga, era omuwooza w'omusolo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.17",
                "verseOrgIds": [
                  "MAT.18.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ddala ddala mbagamba nti byonna bye mulisiba ku nsi, ne mu ggulu birisibwa ne bye mulisumulula ku nsi, ne mu ggulu bigenda kusumululwa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.18",
                "verseOrgIds": [
                  "MAT.18.18"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Era ddala ddala mbagamba nti bwe munaabanga babiri mu nsi ne mukkiriziganya ku ekyo kye mwagala okusaba, Kitange ali mu ggulu alikibakolera.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.19",
                "verseOrgIds": [
                  "MAT.18.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.19",
            "verseOrgIds": [
              "MAT.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kubanga abantu ababiri oba abasatu bwe banaakuŋŋaananga mu linnya lyange, nange nnaabeeranga awo wakati waabwe.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.20",
                "verseOrgIds": [
                  "MAT.18.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Olugero lw'Omuddu Atasonyiwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Peetero n'ajja n'abuuza Yesu nti, \"Mukama wange, muganda wange bw'ansobyanga musonyiwanga emirundi emeka? Emirundi musanvu?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.21",
            "verseOrgIds": [
              "MAT.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'amuddamu nti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.22",
            "verseOrgIds": [
              "MAT.18.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Sikugamba nti emirundi musanvu naye emirundi nsanvu emirundi musanvu.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.22",
                "verseOrgIds": [
                  "MAT.18.22"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu n'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.23",
            "verseOrgIds": [
              "MAT.18.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Obwakabaka obw'omu ggulu bufaananyizibwa nga kabaka eyayagala okubala ebitabo bye eby'ensimbi, n'abaddu be.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.23",
                "verseOrgIds": [
                  "MAT.18.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.23",
            "verseOrgIds": [
              "MAT.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bwe yatandika okubikebera ne bamuleetera gw'abanja ettalanta",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.24",
                "verseOrgIds": [
                  "MAT.18.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.24",
            "verseOrgIds": [
              "MAT.18.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "omutwalo gumu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.24",
                "verseOrgIds": [
                  "MAT.18.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.24",
            "verseOrgIds": [
              "MAT.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye olw'okuba ng'omusajja teyalina nsimbi za kusasula bbanja eryo, mukama we kyeyava alagira batunde omusajja oyo ne mukazi we n'abaana be n'ebintu bye byonna ebbanja liggwe.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.25",
                "verseOrgIds": [
                  "MAT.18.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Naye omuddu oyo n'agwa wansi mu maaso ga mukama we, n'amwegayirira nti, 'Ngumiikiriza, nzija kukusasula ebbanja lyonna.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.26",
                "verseOrgIds": [
                  "MAT.18.26"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mukama we n'asaasira omuddu oyo n'amusonyiwa ebbanja lyonna!",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.27",
                "verseOrgIds": [
                  "MAT.18.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Omuddu oyo bwe yafuluma n'asanga munne gwe yali abanja eddinaali",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.28",
                "verseOrgIds": [
                  "MAT.18.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.28",
            "verseOrgIds": [
              "MAT.18.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "kikumi, n'amugwa mu bulago nga bw'amugamba nti, 'Ssasula kye nkubanja.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.28",
                "verseOrgIds": [
                  "MAT.18.28"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Naye munne n'agwa wansi, n'amwegayirira ng'agamba nti, 'Ngumiikiriza, nnaakusasula.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.29",
                "verseOrgIds": [
                  "MAT.18.29"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Naye amubanja n'agaana okumuwuliriza, n'amuteeka mu kkomera akuumirwe omwo okutuusa lw'alisasula ebbanja lyonna.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.30",
                "verseOrgIds": [
                  "MAT.18.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.30",
            "verseOrgIds": [
              "MAT.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Awo baddu banne bwe baakiraba ne banakuwala nnyo, ne bagenda bategeeza mukama we ebigambo bye balabye.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.31",
                "verseOrgIds": [
                  "MAT.18.31"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Awo mukama we n'atumya omuddu gwe yali asonyiye n'amugamba nti, 'Oli muddu mubi nnyo. Nakusonyiye ebbanja eryo lyonna, kubanga wanneegayiridde,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.32",
                "verseOrgIds": [
                  "MAT.18.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.32",
            "verseOrgIds": [
              "MAT.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "naye ggwe kyali tekikugwanira kusaasira muddu munno nga nange bwe nakusaasidde?'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.33",
                "verseOrgIds": [
                  "MAT.18.33"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.33",
            "verseOrgIds": [
              "MAT.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mukama we kyeyava asunguwala nnyo, n'amukwasa abaserikale bamusse mu kkomera okutuusa lw'alisasula ebbanja lyonna.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.34",
                "verseOrgIds": [
                  "MAT.18.34"
                ]
              }
            }
