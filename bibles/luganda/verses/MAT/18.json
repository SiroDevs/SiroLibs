          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kale ne Kitange ali mu ggulu bw'atyo bw'alibakola singa mmwe abooluganda temusonyiwa okuva mu mitima gyammwe.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.35",
