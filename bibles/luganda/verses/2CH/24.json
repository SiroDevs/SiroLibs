                "verseId": "2CH.24.19",
                "verseOrgIds": [
                  "2CH.24.19"
                ]
              }
            }
          ]
        },
        {
          "text": "yabatumira bannabbi okubakomyawo gy'ali, ne babalumiriza, tebassaayo mwoyo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.19",
            "verseOrgIds": [
