              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ensolo ezatukuzibwa okuba ssaddaaka zaali ente ennume lukaaga, n'endiga enkumi ssatu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.33",
            "verseOrgIds": [
