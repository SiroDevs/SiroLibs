            "number": "34",
            "style": "v",
            "sid": "2CH 29:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabula bakabona ne baba batono ne batayinza kubaaga biweebwayo ebyokebwa byonna, baganda baabwe Abaleevi ne babayambako okutuusa bakabona abalala bwe beetukuza; omulimu ne guggwa, kubanga Abaleevi baali beegendereza nnyo mu kwetukuza okusinga bakabona.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.34",
            "verseOrgIds": [
              "2CH.29.34"
            ]
          }
        },
        {
          "name": "verse",
