            "sid": "2CH 29:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebiweebwayo ebyokebwa bingi, wamu n'amasavu ag'ebiweebwayo olw'emirembe, n'ebiweebwayo ebyokunywa ebyawerekerezebwa ku biweebwayo ebyokebwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.35",
            "verseOrgIds": [
              "2CH.29.35"
            ]
          }
        }
      ]
