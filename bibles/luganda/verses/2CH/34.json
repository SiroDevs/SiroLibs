    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo kabaka n'akuŋŋaanya abakadde bonna aba Yuda n'ab'omu Yerusaalemi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.29",
            "verseOrgIds": [
              "2CH.34.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ayambuka mu yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.30",
            "verseOrgIds": [
              "2CH.34.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.30",
                "verseOrgIds": [
                  "2CH.34.30"
                ]
              }
            }
          ]
        },
        {
          "text": ", n'abantu bonna aba Yuda, n'abantu b'e Yerusaalemi, ne bakabona, n'abaleevi, n'abantu bonna ab'ekitiibwa n'abatali ba kitiibwa. N'asoma ebigambo byonna eby'omu kitabo eky'endagaano, ekyazuulibwa mu yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.30",
            "verseOrgIds": [
              "2CH.34.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.30",
                "verseOrgIds": [
                  "2CH.34.30"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.30",
            "verseOrgIds": [
              "2CH.34.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 34:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabaka n'ayimirira mu kifo kye, ne yeeyama mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.31",
            "verseOrgIds": [
              "2CH.34.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.31",
                "verseOrgIds": [
                  "2CH.34.31"
                ]
              }
            }
          ]
        },
        {
          "text": ", okutambuliranga mu mpya za",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.31",
            "verseOrgIds": [
              "2CH.34.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.31",
                "verseOrgIds": [
                  "2CH.34.31"
                ]
              }
            }
          ]
        },
        {
          "text": "n'okukwatanga amateeka ge, n'ebyo bye yategeeza, n'ebiragiro bye, n'omutima gwe gwonna n'omwoyo gwe gwonna, okutuukirizanga ebigambo ebyawandiikibwa mu kitabo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.31",
            "verseOrgIds": [
              "2CH.34.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 34:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oluvannyuma n'alagira bonna abaali mu Yerusaalemi ne mu Benyamini okweyama. Abatuuze b'omu Yerusaalemi ne bakola ng'endagaano ya Katonda, Katonda wa bajjajjaabwe bw'egamba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.32",
            "verseOrgIds": [
              "2CH.34.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 34:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosiya n'aggya eby'emizizo byonna ku butaka bwonna obw'Abayisirayiri, n'alagira bonna abaali mu Isirayiri okuweerezanga",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.33",
            "verseOrgIds": [
              "2CH.34.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.33",
                "verseOrgIds": [
                  "2CH.34.33"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda waabwe. Mu kufuga kwe kwonna, tebaava ku",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.33",
            "verseOrgIds": [
              "2CH.34.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.33",
                "verseOrgIds": [
                  "2CH.34.33"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wa bajjajjaabwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.33",
            "verseOrgIds": [
              "2CH.34.33"
            ]
          }
        }
      ]
