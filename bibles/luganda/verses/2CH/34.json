  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "34",
        "style": "c",
        "sid": "2CH 34"
      },
      "items": [
        {
          "text": "34",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Enkyukakyuka Yosiya ze yaleeta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosiya yali wa myaka munaana bwe yalya obwakabaka, era n'afugira emyaka amakumi asatu mu gumu mu Yerusaalemi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.1",
            "verseOrgIds": [
              "2CH.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'akola ebirungi mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.2",
            "verseOrgIds": [
              "2CH.34.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.2",
                "verseOrgIds": [
                  "2CH.34.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", n'atambulira mu makubo ga Dawudi jjajjaawe, n'akwata ekkubo lya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.2",
            "verseOrgIds": [
              "2CH.34.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.2",
                "verseOrgIds": [
                  "2CH.34.2"
                ]
              }
            }
          ]
        },
        {
          "text": "eggolokofu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.2",
            "verseOrgIds": [
              "2CH.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka ogw'omunaana ogw'okufuga kwe, ng'akyali muto, n'atandika okunoonya Katonda wa Dawudi jjajjaawe, era mu mwaka ogw'ekkumi n'ebiri n'atandika okuggya ebifo ebigulumivu, ne Baasera, n'ebifaananyi ebyole, n'ebifaananyi ebisaanuuse mu Yuda ne mu Yerusaalemi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.3",
            "verseOrgIds": [
              "2CH.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'alagira bamenyeemenye ebyoto bya Baali, n'atemaatema ebyoto kwe baayoterezanga obubaane ebyali waggulu waabyo, n'amenyaamenya ne Baasera, n'ebifaananyi ebyole, n'ebifaananyi ebisaanuuse; n'abisesebbula, enfuufu yaabyo n'agimansula ku malaalo g'abo abaaweerangayo ssaddaaka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.4",
            "verseOrgIds": [
              "2CH.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ayokera amagumba ga bakabona abaakolanga eby'ebivve ebyo ku byoto ebyo, n'atukuza Yuda ne Yerusaalemi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.5",
            "verseOrgIds": [
              "2CH.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mu bibuga bya Manase, ne Efulayimu, ne Simyoni, okutuukira ddala mu Nafutaali, ne mu matongo gaabyo okubyetooloola,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.6",
            "verseOrgIds": [
              "2CH.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'amenyaamenya ebyoto ne Baasera, n'asesebbula n'ebifaananyi ebyole, n'atemaatema ebyoto byonna kwe baayokeranga obubaane mu Isirayiri yonna, n'oluvannyuma n'addayo e Yerusaalemi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.7",
            "verseOrgIds": [
              "2CH.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo mu mwaka ogw'ekkumi n'omunaana ogw'okufuga kwe ng'amaze okulongoosa ensi ne yeekaalu, n'alonda Safani mutabani wa Azaliya, ne Maaseya omwami w'ekibuga, ne Yowa mutabani wa Yowakazi omujjukiza, okuddaabiriza yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.8",
            "verseOrgIds": [
              "2CH.34.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.8",
                "verseOrgIds": [
                  "2CH.34.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda we.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.8",
            "verseOrgIds": [
              "2CH.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bagenda eri Kirukiya kabona asinga obukulu ne bawaayo ensimbi ezaaleetebwa mu yeekaalu ya Katonda, Abaleevi abaggazi ze baali basoloozezza mu bantu b'e Manase, ne Efulayimu, n'ekitundu kyonna ekyasigalawo, ne Yuda yonna, ne Benyamini, n'okuva eri abantu b'e Yerusaalemi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.9",
            "verseOrgIds": [
              "2CH.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bazikwasa abakozi abaalondebwa okulabirira omulimu gwa yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.10",
            "verseOrgIds": [
              "2CH.34.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.10",
                "verseOrgIds": [
                  "2CH.34.10"
                ]
              }
            }
          ]
        },
        {
          "text": ". Abo be basajja abaasasulanga abakozi abaddaabirizanga n'okulongoosa yeekaalu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.10",
            "verseOrgIds": [
              "2CH.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ababazzi n'abazimbi nabo ne baweebwa ensimbi okugula amayinja amawoole, n'embaawo ez'ebizimbe bakabaka ba Yuda bye baalagajjalira okuddaabiriza.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.11",
            "verseOrgIds": [
              "2CH.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasajja ne bakola omulimu n'obwesigwa. Abaabalabiriranga baali: Yakasi ne Obadiya Abaleevi ab'omu kika kya Merali, ne Zekkaliya ne Mesullamu ab'omu kika ky'Abakokasi. Abaleevi bonna abaakubanga ebivuga",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.12",
            "verseOrgIds": [
              "2CH.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "be baavunaanyizibwanga abapakasi, n'okulabirira abakozi bonna mu kuweereza okw'engeri zonna. Abamu ku Baleevi baali bawandiisi, n'abalala ng'abaami, n'abalala nga baggazi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.13",
            "verseOrgIds": [
              "2CH.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekitabo ky'Amateeka Kirabibwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo bwe baali bakuŋŋaanya ensimbi ze baggya mu yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.14",
            "verseOrgIds": [
              "2CH.34.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.14",
                "verseOrgIds": [
                  "2CH.34.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", Kirukiya kabona, n'azuula ekitabo eky'amateeka ga",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.14",
            "verseOrgIds": [
              "2CH.34.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.14",
                "verseOrgIds": [
                  "2CH.34.14"
                ]
              }
            }
          ]
        },
        {
          "text": "agaaweebwa Musa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.14",
            "verseOrgIds": [
              "2CH.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Kirukiya kabona n'agamba Safani omuwandiisi nti, \"Nzudde ekitabo eky'amateeka mu yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.15",
            "verseOrgIds": [
              "2CH.34.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.15",
                "verseOrgIds": [
                  "2CH.34.15"
                ]
              }
            }
          ]
        },
        {
          "text": ".\" N'akiwa Safani.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.15",
            "verseOrgIds": [
              "2CH.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Safani n'akitwalira kabaka, n'amutegeeza ne ku by'omulimu ng'agamba nti, \"Byonna abaddu bo bye baalagirwa babikola.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.16",
            "verseOrgIds": [
              "2CH.34.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensimbi ezaali mu yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.17",
            "verseOrgIds": [
              "2CH.34.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.17",
                "verseOrgIds": [
                  "2CH.34.17"
                ]
              }
            }
          ]
        },
        {
          "text": "ziweereddwa abalabirira n'abakozi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.17",
            "verseOrgIds": [
              "2CH.34.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Safani omuwandiisi n'ategeeza kabaka nti, \"Kirukiya kabona ampadde ekitabo.\" Awo Safani n'akisomera kabaka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.18",
            "verseOrgIds": [
              "2CH.34.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabaka bwe yawulira ebigambo by'amateeka, n'ayuza ebyambalo bye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.19",
            "verseOrgIds": [
              "2CH.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'alagira Kirukiya ne Akikamu mutabani wa Safani, ne Abudoni mutabani wa Mikka, ne Safani omuwandiisi, ne Asaya omuddu wa kabaka, ng'ayogera nti,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.20",
            "verseOrgIds": [
              "2CH.34.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mugende mumbulize ku",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.21",
            "verseOrgIds": [
              "2CH.34.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.21",
                "verseOrgIds": [
                  "2CH.34.21"
                ]
              }
            }
          ]
        },
        {
          "text": ", nze n'abasigadde mu Isirayiri ne mu Yuda, ku bikwata ku bigambo eby'omu kitabo ekizuuliddwa, kubanga obusungu bwa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.21",
            "verseOrgIds": [
              "2CH.34.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.21",
                "verseOrgIds": [
                  "2CH.34.21"
                ]
              }
            }
          ]
        },
        {
          "text": "bungi nnyo nnyini era butubuubuukirako olwa bajjajjaffe abataagoberera kigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.21",
            "verseOrgIds": [
              "2CH.34.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
