                "verseOrgIds": [
                  "2CH.34.21"
                ]
              }
            }
          ]
        },
        {
          "text": "okukikola nga bwe kyawandiikibwa mu kitabo kino.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.21",
            "verseOrgIds": [
              "2CH.34.21"
            ]
          }
        }
