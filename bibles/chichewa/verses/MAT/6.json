  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "MAT 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zopereka Zachifundo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Samalani kuti musachite ntchito zanu zolungama pamaso pa anthu kuti akuoneni. Popeza ngati mutero simudzalandira mphotho yochokera kwa Atate anu akumwamba.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.1",
                "verseOrgIds": [
                  "MAT.6.1"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Pamene mupereka zachifundo, musachite modzionetsera monga amachita achiphamaso mʼmasunagoge ndi pa misewu kuti atamidwe ndi anthu. Zoonadi, Ine ndikuwuzani kuti iwowo alandiriratu mphotho yawo yonse.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.2",
                "verseOrgIds": [
                  "MAT.6.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.2",
            "verseOrgIds": [
              "MAT.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Koma pamene mupereka zachifundo, dzanja lanu lamanzere lisadziwe chimene dzanja lanu lamanja likuchita,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.3",
                "verseOrgIds": [
                  "MAT.6.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.3",
            "verseOrgIds": [
              "MAT.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "kotero kuti kupereka kwanu kukhale mwachinsinsi. Ndipo Atate anu amene amaona zochitika mwachinsinsi, adzakupatsani mphotho.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.4",
                "verseOrgIds": [
                  "MAT.6.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Za Kupemphera",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Pamene mupemphera, musakhale ngati achiphamaso, chifukwa iwo amakonda kupemphera choyimirira mʼmasunagoge ndi pa mphambano za mʼmisewu kuti anthu awaone. Zoonadi, Ine ndikuwuzani kuti iwo alandiriratu mphotho yawo yonse.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.5",
                "verseOrgIds": [
                  "MAT.6.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.5",
            "verseOrgIds": [
              "MAT.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Koma pamene mupemphera, lowani mʼchipinda chanu chamʼkati, ndi kutseka chitseko ndipo mupemphere kwa Atate anu amene saoneka. Ndipo Atate anu, amene amaona zochitika mseri, adzakupatsani mphotho.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.6",
                "verseOrgIds": [
                  "MAT.6.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.6",
            "verseOrgIds": [
              "MAT.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndipo pamene mukupemphera, musamabwerezabwereza monga akunja, pakuti iwo amaganiza kuti adzamveka chifukwa chochulutsa mawu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.7",
                "verseOrgIds": [
                  "MAT.6.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.7",
            "verseOrgIds": [
              "MAT.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Musakhale ngati iwo chifukwa Atate anu amadziwa zimene musowa musanapemphe.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.8",
                "verseOrgIds": [
                  "MAT.6.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Chifukwa chake pempherani motere:",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.9",
                "verseOrgIds": [
                  "MAT.6.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 6:9"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\" 'Atate athu akumwamba,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.9",
                "verseOrgIds": [
                  "MAT.6.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 6:9"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "dzina lanu lilemekezedwe,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.9",
                "verseOrgIds": [
                  "MAT.6.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ufumu wanu ubwere,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.10",
                "verseOrgIds": [
                  "MAT.6.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 6:10"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "chifuniro chanu chichitike",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.10",
                "verseOrgIds": [
                  "MAT.6.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 6:10"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "pansi pano monga kumwamba.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.10",
                "verseOrgIds": [
                  "MAT.6.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mutipatse chakudya chathu chalero.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.11",
                "verseOrgIds": [
                  "MAT.6.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mutikhululukire mangawa athu,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.12",
                "verseOrgIds": [
                  "MAT.6.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 6:12"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "monga ifenso tawakhululukira amangawa athu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.12",
                "verseOrgIds": [
                  "MAT.6.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndipo musatitengere kokatiyesa;",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.13",
                "verseOrgIds": [
                  "MAT.6.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 6:13"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "koma mutipulumutse kwa woyipayo.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.13",
                "verseOrgIds": [
                  "MAT.6.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ngati inu mukhululukira anthu pamene akuchimwirani, Atate anu akumwamba adzakukhululukirani.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.14",
                "verseOrgIds": [
                  "MAT.6.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.14",
            "verseOrgIds": [
              "MAT.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Koma ngati inu simukhululukira anthu zolakwa zawo, Atate anunso sadzakukhululukirani machimo anu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.15",
                "verseOrgIds": [
                  "MAT.6.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kusala Kudya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Pamene mukusala kudya, musaonetse nkhope yachisoni monga achita achiphamaso, pakuti iwo amasintha nkhope zawo kuonetsa anthu kuti akusala kudya. Zoonadi, Ine ndikuwuzani kuti iwo alandiriratu mphotho yawo yonse.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.16",
                "verseOrgIds": [
                  "MAT.6.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.16",
            "verseOrgIds": [
              "MAT.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Koma pamene ukusala kudya, samba mʼmaso nudzole mafuta kumutu,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.17",
                "verseOrgIds": [
                  "MAT.6.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.17",
            "verseOrgIds": [
              "MAT.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "kuti usaonekere kwa anthu kuti ukusala kudya koma kwa Atate ako ali mseri; ndipo Atate ako amene amaona za mseri adzakupatsa mphotho.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.18",
                "verseOrgIds": [
                  "MAT.6.18"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Za Chuma cha Kumwamba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Musadziwunjikire chuma pa dziko lapansi, pamene njenjete ndi dzimbiri zimawononga ndi pamene mbala zimathyola ndi kuba.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.19",
                "verseOrgIds": [
                  "MAT.6.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.19",
            "verseOrgIds": [
              "MAT.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Koma mudziwunjikire chuma kumwamba kumene njenjete ndi dzimbiri siziwononga ndipo mbala sizithyola ndi kuba.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.20",
                "verseOrgIds": [
                  "MAT.6.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.20",
            "verseOrgIds": [
              "MAT.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pakuti kumene kuli chuma chako, mtima wako udzakhala komweko.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.21",
                "verseOrgIds": [
                  "MAT.6.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Diso Nyale ya Thupi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Diso ndi nyale ya thupi. Ngati maso ako ali bwino, thupi lako lonse lidzakhala mʼkuwala.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.22",
                "verseOrgIds": [
                  "MAT.6.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.22",
            "verseOrgIds": [
              "MAT.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Koma ngati maso ako sali bwino, thupi lako lonse lidzakhala mu mdima. Koma ngati kuwala kuli mwa iwe ndi mdima, ndiye kuti mdimawo ndi waukulu bwanji!",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.23",
                "verseOrgIds": [
                  "MAT.6.23"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Palibe munthu angathe kukhala kapolo wa ambuye awiri. Pakuti pena adzamuda mmodzi ndi kukonda winayo kapena adzagwira ntchito mokhulupirika kwa mmodzi, nadzanyoza winayo. Simungathe kukhala kapolo wa Mulungu ndi wa chuma pa nthawi imodzi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.24",
                "verseOrgIds": [
                  "MAT.6.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Musade Nkhawa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nʼchifukwa chake ndikuwuzani kuti musadere nkhawa za moyo wanu kuti mudzadya chiyani kapena mudzamwa chiyani; kapenanso za thupi lanu kuti mudzavala chiyani. Kodi moyo suposa chakudya? Kodi thupi siliposa zovala?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.25",
                "verseOrgIds": [
                  "MAT.6.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.25",
            "verseOrgIds": [
              "MAT.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Onani mbalame zamlengalenga sizifesa kapena kukolola kapena kusunga mʼnkhokwe komabe Atate anu akumwamba amazidyetsa. Kodi inu simuziposa kwambiri?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.26",
                "verseOrgIds": [
                  "MAT.6.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.26",
            "verseOrgIds": [
              "MAT.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kodi ndani wa inu podandaula angathe kuwonjeza ora limodzi pa moyo wake?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.27",
                "verseOrgIds": [
                  "MAT.6.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ndipo bwanji inu mudera nkhawa za zovala? Onani makulidwe a maluwa akutchire. Sagwira ntchito kapena kuwomba nsalu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.28",
                "verseOrgIds": [
                  "MAT.6.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.28",
            "verseOrgIds": [
              "MAT.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndikukuwuzani kuti angakhale Solomoni mu ulemerero wake sanavale mofanana ndi limodzi la maluwa amenewa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.29",
                "verseOrgIds": [
                  "MAT.6.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.29",
            "verseOrgIds": [
              "MAT.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ngati umu ndi mmene Mulungu avekera udzu wa kutchire umene ulipo lero ndipo mawa uponyedwa ku moto, kodi sadzakuvekani koposa? Aa! Inu a chikhulupiriro chochepa!",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.30",
                "verseOrgIds": [
                  "MAT.6.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.30",
            "verseOrgIds": [
              "MAT.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Chifukwa chake musadere nkhawa ndi kuti, 'Tidzadya chiyani?' kapena 'Tidzamwa chiyani?' kapena 'Tidzavala chiyani?'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.31",
                "verseOrgIds": [
                  "MAT.6.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.31",
            "verseOrgIds": [
              "MAT.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pakuti anthu akunja amazifuna zinthu zonsezi ndipo Atate anu akumwamba adziwa kuti musowa zimenezi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.32",
                "verseOrgIds": [
                  "MAT.6.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.32",
            "verseOrgIds": [
              "MAT.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Koma muyambe mwafuna ufumu wake ndi chilungamo chake ndipo zinthu zonsezi zidzapatsidwa kwa inu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.33",
                "verseOrgIds": [
                  "MAT.6.33"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.33",
            "verseOrgIds": [
              "MAT.6.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Chifukwa chake musadere nkhawa ndi za mawa, popeza tsiku lililonse lili ndi zovuta zake zokwanira.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.34",
                "verseOrgIds": [
                  "MAT.6.34"
                ]
              }
            }
          ]
        }
      ]
