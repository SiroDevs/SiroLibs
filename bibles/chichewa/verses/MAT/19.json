  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "MAT 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Za Kuthetsa Ukwati",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu atatsiriza kunena zinthu zimenezi, anachoka ku Galileya ndi kupita ku chigawo cha Yudeya mbali ina ya mtsinje wa Yorodani.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.1",
            "verseOrgIds": [
              "MAT.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magulu akulu a anthu anamutsatira Iye, ndipo iwo anachiritsidwa pomwepo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.2",
            "verseOrgIds": [
              "MAT.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afarisi ena anabwera kwa Iye kudzamuyesa. Anamufunsa Iye nati, \"Kodi ndikololedwa kuti mwamuna amuleke mkazi wake pa chifukwa china chilichonse?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.3",
            "verseOrgIds": [
              "MAT.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anayankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.4",
            "verseOrgIds": [
              "MAT.19.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kodi simunawerenge kuti pachiyambi Mulungu analenga iwo, 'mwamuna ndi mkazi?'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.19.4",
                "verseOrgIds": [
                  "MAT.19.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.4",
            "verseOrgIds": [
              "MAT.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndipo anati, 'Pa chifukwa ichi mwamuna adzasiya abambo ake ndi amayi ake nakaphatikana ndi mkazi wake, ndipo awiriwo adzakhala thupi limodzi.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.19.5",
                "verseOrgIds": [
                  "MAT.19.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.5",
            "verseOrgIds": [
              "MAT.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Motero salinso awiri ayi koma mmodzi. Nʼchifukwa chake chimene Mulungu wachimanga pamodzi munthu wina asachilekanitse.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.19.6",
                "verseOrgIds": [
                  "MAT.19.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo iwo anamufunsa nati, \"Nanga nʼchifukwa chiyani Mose analamula kuti mwamuna azipatsa mkazi wake kalata ya chisudzulo ndi kumuchotsa?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.7",
            "verseOrgIds": [
              "MAT.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anayankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.8",
            "verseOrgIds": [
              "MAT.19.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mose anakulolezani kuti muzisudzula akazi anu chifukwa cha kuwuma mitima kwanu. Koma sizinali chotere kuyambira pachiyambi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.19.8",
                "verseOrgIds": [
                  "MAT.19.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.8",
            "verseOrgIds": [
              "MAT.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ine ndikuwuzani kuti aliyense amene asudzula mkazi wake, osati chifukwa cha chiwerewere nakakwatira mkazi wina, achita chigololo.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.19.9",
                "verseOrgIds": [
                  "MAT.19.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ophunzira ake anati kwa Iye, \"Ngati umu ndi mmene zilili pa mwamuna ndi mkazi, kuli bwino kusakwatira.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.10",
            "verseOrgIds": [
              "MAT.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anayankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.11",
            "verseOrgIds": [
              "MAT.19.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Si aliyense amene angavomere chiphunzitso ichi, koma kwa okhawo amene achimvetsetsa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.19.11",
                "verseOrgIds": [
                  "MAT.19.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.11",
            "verseOrgIds": [
              "MAT.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pakuti ena ndi akuti sangakwatire chifukwa anabadwa motero, ena ali motero chifukwa chofulidwa ndi anthu ndipo ena anawukana ukwati chifukwa cha ufumu wakumwamba. Iye amene angalandire ichi alandire.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.19.12",
                "verseOrgIds": [
                  "MAT.19.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Adalitsa Ana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo anabwera nawo ana kwa Yesu kuti awasanjike manja ndi kuwapempherera. Koma ophunzira ake anadzudzula amene anabweretsa anawo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.13",
            "verseOrgIds": [
              "MAT.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anati,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.14",
            "verseOrgIds": [
              "MAT.19.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Lolani ana abwere kwa Ine, ndipo musawaletse pakuti ufumu wakumwamba ndi wa iwo onga anawa.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.19.14",
                "verseOrgIds": [
                  "MAT.19.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.14",
            "verseOrgIds": [
              "MAT.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atasanjika manja ake pa anawo, anachokapo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.15",
            "verseOrgIds": [
              "MAT.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mnyamata Wolemera ndi Ufumu wa Mulungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taonani mnyamata wina anabwera kwa Yesu namufunsa kuti, \"Aphunzitsi, ndi chinthu chiti chabwino chimene ndiyenera kuchita kuti ndipeze moyo wosatha?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.16",
            "verseOrgIds": [
              "MAT.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anayankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.17",
            "verseOrgIds": [
              "MAT.19.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ukundifunsiranji Ine za chinthu chimene ndi chabwino? Pali mmodzi yekha amene ndi wabwino. Ngati ukufuna kulowa mʼmoyo wosatha mvera malamulo.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.19.17",
                "verseOrgIds": [
                  "MAT.19.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mnyamatayo anamufunsa kuti, \"Ndi ati?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.18",
            "verseOrgIds": [
              "MAT.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 19:18"
      },
      "items": [
        {
          "text": "Yesu anayankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.18",
            "verseOrgIds": [
              "MAT.19.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Usaphe, usachite chigololo, usabe, usapereke umboni onama,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.19.18",
                "verseOrgIds": [
                  "MAT.19.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.18",
            "verseOrgIds": [
              "MAT.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "lemekeza abambo ako ndi amayi ako ndipo konda mnansi wako monga iwe mwini.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.19.19",
                "verseOrgIds": [
                  "MAT.19.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mnyamatayo anati, \"Zonsezi ndimazisunga, nanga chatsala ndi chiyani?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.20",
            "verseOrgIds": [
              "MAT.19.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anayankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.21",
            "verseOrgIds": [
              "MAT.19.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ngati ukufuna kukhala wangwiro, pita kagulitse katundu wako ndi kupereka kwa osauka, ndipo udzakhala ndi chuma kumwamba. Ukakachita zimenezi, ukabwere udzanditsate Ine.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.19.21",
                "verseOrgIds": [
                  "MAT.19.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mnyamatayo atamva zimenezi, anachoka mokhumudwa, chifukwa anali ndi chuma chambiri.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.22",
            "verseOrgIds": [
              "MAT.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Yesu anati kwa ophunzira ake,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.23",
            "verseOrgIds": [
              "MAT.19.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Zoonadi, ndikuwuzani kuti nʼkovuta kuti olemera akalowe mu ufumu wakumwamba.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.19.23",
                "verseOrgIds": [
                  "MAT.19.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.23",
            "verseOrgIds": [
              "MAT.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Komanso ndikuwuzani kuti, nʼkwapafupi kuti ngamira idzere pa kabowo ka zingano kusiyana ndi kuti wolemera akalowe mu ufumu wa Mulungu.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.19.24",
                "verseOrgIds": [
                  "MAT.19.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ophunzira atamva zimenezi, anadabwa kwambiri ndipo anamufunsa kuti, \"Nanga angapulumuke ndani?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.25",
            "verseOrgIds": [
              "MAT.19.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anawayangʼana iwo nati,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.26",
            "verseOrgIds": [
              "MAT.19.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ndi anthu, izi nʼzosatheka, koma ndi Mulungu zinthu zonse zimatheka.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.19.26",
                "verseOrgIds": [
                  "MAT.19.26"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro anamuyankha Iye kuti, \"Ife tinasiya zonse ndi kukutsatirani Inu! Nanga tsono ife tidzalandira chiyani?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.27",
            "verseOrgIds": [
              "MAT.19.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anawawuza kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.28",
            "verseOrgIds": [
              "MAT.19.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Zoonadi, ndikuwuzani kuti pa nthawi yokonzanso zinthu zonse, pamene Mwana wa Munthu adzakhala pa mpando wake waufumu mu ulemerero wake kumwamba, inu amene mwanditsata Ine mudzakhalanso pa mipando khumi ndi iwiri yaufumu, kuweruza mafuko khumi ndi awiri a Israeli.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.19.28",
                "verseOrgIds": [
                  "MAT.19.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.28",
            "verseOrgIds": [
              "MAT.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndipo aliyense amene wasiya nyumba, kapena abale, kapena alongo, kapena bambo kapena mayi kapena mkazi, kapena ana, kapena minda chifukwa cha Ine adzalandira madalitso ochuluka ndi kulandiranso moyo wosatha.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.19.29",
                "verseOrgIds": [
                  "MAT.19.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.29",
            "verseOrgIds": [
              "MAT.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Koma ambiri amene ali oyambirira adzakhala omalizira, ndipo ambiri amene ndi omalizira adzakhala oyambirira.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.19.30",
                "verseOrgIds": [
                  "MAT.19.30"
                ]
              }
            }
          ]
        }
      ]
    }
