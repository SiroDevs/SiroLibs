  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "MAT 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Anzeru a Kummawa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atabadwa Yesu mʼBetelehemu wa ku Yudeya, mʼnthawi ya mfumu Herode, Anzeru a kummawa anabwera ku Yerusalemu",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.1",
            "verseOrgIds": [
              "MAT.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nafunsa kuti, \"Ali kuti amene wabadwa kukhala mfumu ya Ayuda? Chifukwa tinaona nyenyezi yake kummawa ndipo tabwera kudzamupembedza.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.2",
            "verseOrgIds": [
              "MAT.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu Herode atamva zimenezi, anavutika mu mtima kwambiri pamodzi ndi anthu onse a mu Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.3",
            "verseOrgIds": [
              "MAT.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo anayitanitsa anthu onse, akulu ansembe ndi aphunzitsi amalamulo nawafunsa kuti, \"Kodi Khristu adzabadwira kuti?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.4",
            "verseOrgIds": [
              "MAT.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo anamuyankha kuti, \"Ku Betelehemu wa ku Yudeya chifukwa izi ndi zimene mneneri analemba kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.5",
            "verseOrgIds": [
              "MAT.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Koma iwe Betelehemu, chigawo cha Yudeya,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.6",
            "verseOrgIds": [
              "MAT.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 2:6"
      },
      "items": [
        {
          "text": "sindiwe wamngʼonongʼono mwa olamulira a Yudeya;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.6",
            "verseOrgIds": [
              "MAT.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 2:6"
      },
      "items": [
        {
          "text": "pakuti otsogolera adzachokera mwa iwe,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.6",
            "verseOrgIds": [
              "MAT.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 2:6"
      },
      "items": [
        {
          "text": "amene adzaweta anthu anga Aisraeli.' \"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.6",
            "verseOrgIds": [
              "MAT.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pomwepo Herode anawayitanira mseri Anzeruwo nawafunsitsa nthawi yeniyeni yomwe nyenyeziyo inaoneka.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.7",
            "verseOrgIds": [
              "MAT.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo anawatumiza ku Betelehemu nawawuza kuti, \"Pitani mukafufuze za mwanayo mosamalitsa. Ndipo mukamupeza mudzandiwuze kuti inenso ndikamupembedze.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.8",
            "verseOrgIds": [
              "MAT.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atamva mawu a mfumu, ananyamuka ulendo wawo, ndipo taonani nyenyezi anayiona kummawa ija, inawatsogolera mpaka inayima pamwamba pa nyumba yomwe munali mwanayo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.9",
            "verseOrgIds": [
              "MAT.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene iwo anaona nyenyeziyo, anasangalala kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.10",
            "verseOrgIds": [
              "MAT.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pofika ku nyumbayo, anaona mwanayo pamodzi ndi amayi ake Mariya, ndipo anagwada namulambira Iye. Pomwepo anamasula chuma chawo ndi kupereka mphatso zawo za ndalama zagolide, lubani ndi mure.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.11",
            "verseOrgIds": [
              "MAT.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo atachenjezedwa mʼmaloto kuti asapitenso kwa Herode, anabwerera ku dziko la kwawo podzera njira ina.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.12",
            "verseOrgIds": [
              "MAT.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Athawira ku Igupto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atachoka, taonani mngelo wa Ambuye anaonekera kwa Yosefe mʼmaloto nati, \"Tadzuka, tenga mwanayo pamodzi ndi amayi ake ndipo muthawire ku Igupto. Mukakhale kumeneko mpaka nditakuwuza pakuti Herode adzafunafuna mwanayo kuti amuphe.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.13",
            "verseOrgIds": [
              "MAT.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atadzuka, Yosefe anatenga mwanayo ndi amayi ake usiku omwewo napita ku Igupto,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.14",
            "verseOrgIds": [
              "MAT.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nakhala kumeneko mpaka Herode atamwalira. Ndipo zinakwaniritsidwa zomwe ananena Ambuye mwa mneneri kuti, \"Ndinayitana mwana wanga kuti atuluke mu Igupto.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.15",
            "verseOrgIds": [
              "MAT.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuphedwa kwa Ana mʼBetelehemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Herode atazindikira kuti Anzeruwo anamupusitsa, anakwiya kwambiri. Ndipo anatumiza anthu kukapha ana onse aamuna a mʼBetelehemu ndi midzi yozungulira amene anali a zaka ziwiri kapena zocheperapo, molingana ndi nthawi imene Anzeruwo anamuwuza.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.16",
            "verseOrgIds": [
              "MAT.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo, zimene ananena mneneri Yeremiya zinakwaniritsidwa:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.17",
            "verseOrgIds": [
              "MAT.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kulira kukumveka ku Rama,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.18",
            "verseOrgIds": [
              "MAT.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 2:18"
      },
      "items": [
        {
          "text": "kubuma ndi kulira kwakukulu,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.18",
            "verseOrgIds": [
              "MAT.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 2:18"
      },
      "items": [
        {
          "text": "Rakele akulirira ana ake;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.18",
            "verseOrgIds": [
              "MAT.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 2:18"
      },
      "items": [
        {
          "text": "sakutonthozeka,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.18",
            "verseOrgIds": [
              "MAT.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 2:18"
      },
      "items": [
        {
          "text": "chifukwa ana akewo palibe.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.18",
            "verseOrgIds": [
              "MAT.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abwerera ku Nazareti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atamwalira Herode, mngelo wa Ambuye anaonekera kwa Yosefe mʼmaloto ku Igupto",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.19",
            "verseOrgIds": [
              "MAT.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nanena kuti, \"Nyamuka, tenga mwanayo ndi amayi ake ndipo mupite ku dziko la Israeli, popeza amene anafuna moyo wa mwanayo anamwalira.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.20",
            "verseOrgIds": [
              "MAT.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Yosefe atadzuka anatenga mwanayo ndi amayi ake kupita ku dziko la Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.21",
            "verseOrgIds": [
              "MAT.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma atamva kuti Arikelao akulamulira mu Yudeya mʼmalo mwa abambo ake, Herode, anaopa kupitako. Atachenjezedwa mʼmaloto, anapita ku Galileya,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.22",
            "verseOrgIds": [
              "MAT.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo anakakhazikika mu mzinda wa Nazareti. Pamenepo zinakwaniritsidwa zonenedwa ndi aneneri kuti, \"Adzatchedwa Mnazareti.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.23",
            "verseOrgIds": [
              "MAT.2.23"
            ]
          }
        }
      ]
    }
  ],
