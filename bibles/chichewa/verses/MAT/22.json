  "verseCount": 46,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "MAT 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fanizo la Phwando la Ukwati",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anayankhula nawonso mʼmafanizo, nati,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.1",
            "verseOrgIds": [
              "MAT.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ufumu wakumwamba uli ngati mfumu imene inakonzera phwando mwana wake wamwamuna.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.2",
                "verseOrgIds": [
                  "MAT.22.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.2",
            "verseOrgIds": [
              "MAT.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Anatumiza antchito ake kwa amene anayitanidwa kuphwando koma anakana kubwera.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.3",
                "verseOrgIds": [
                  "MAT.22.3"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kenaka anatumiza antchito ena nati, 'Awuzeni oyitanidwa kuti phwando lakonzedwa: ndapha ngʼombe yayimuna ndi nyama zina zonenepa ndipo zonse zakonzedwa. Bwerani ku phwando laukwati.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.4",
                "verseOrgIds": [
                  "MAT.22.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Koma iwo sanalabadire ndipo anachoka; wina anapita ku munda wake ndi wina ku malonda ake.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.5",
                "verseOrgIds": [
                  "MAT.22.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.5",
            "verseOrgIds": [
              "MAT.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndipo otsalawo anagwira antchito ake, nawazunza ndi kuwapha.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.6",
                "verseOrgIds": [
                  "MAT.22.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.6",
            "verseOrgIds": [
              "MAT.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mfumu inakwiya. Inatumiza asilikali ake ndipo anawononga opha anzawowo ndi kutentha mzinda wawo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.7",
                "verseOrgIds": [
                  "MAT.22.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Pamenepo anati kwa antchito ake, 'Phwando laukwati lakonzedwa, koma amene ndinawayitana sanali oyenera.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.8",
                "verseOrgIds": [
                  "MAT.22.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.8",
            "verseOrgIds": [
              "MAT.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pitani ku mphambano za misewu ndipo kayitaneni aliyense amene mukamupeze kuti abwere ku phwando.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.9",
                "verseOrgIds": [
                  "MAT.22.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.9",
            "verseOrgIds": [
              "MAT.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pamenepo antchitowo anapita ku misewu nakasonkhanitsa anthu onse amene anakawapeza, abwino ndi oyipa omwe, ndipo nyumba ya madyerero inadzaza ndi oyitanidwa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.10",
                "verseOrgIds": [
                  "MAT.22.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Koma pamene mfumu inabwera kudzaona oyitanidwawo, inaona munthu amene sanavale zovala zaukwati.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.11",
                "verseOrgIds": [
                  "MAT.22.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.11",
            "verseOrgIds": [
              "MAT.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Inamufunsa kuti, 'Bwenzi walowa bwanji muno wopanda zovala zaukwati?' Munthuyo anakhala chete.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.12",
                "verseOrgIds": [
                  "MAT.22.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Pamenepo mfumuyo inawuza otumikira kuti, 'Mʼmangeni manja ndi miyendo, ndipo muponyeni kunja, ku mdima kumene kudzakhale kulira ndi kukuta mano.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.13",
                "verseOrgIds": [
                  "MAT.22.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Popeza oyitanidwa ndi ambiri koma osankhidwa ndi ochepa.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.14",
                "verseOrgIds": [
                  "MAT.22.14"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Za Kupereka Msonkho",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Afarisi anatuluka nakakonza njira zomupezera zifukwa Yesu mʼmawu ake.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.15",
            "verseOrgIds": [
              "MAT.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anatumiza ophunzira awo kwa Iye pamodzi ndi Aherodia. Anati, \"Aphunzitsi, tidziwa kuti ndinu wangwiro ndi kuti mumaphunzitsa mawu a Mulungu monga mwa choonadi. Simutekeseka ndi anthu, popeza simusamala kuti kodi ndi ndani?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.16",
            "verseOrgIds": [
              "MAT.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiwuzeni tsono maganizo anu ndi otani, kodi nʼkololedwa kupereka msonkho kwa Kaisara kapena ayi?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.17",
            "verseOrgIds": [
              "MAT.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Yesu podziwa maganizo awo oyipa anati,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.18",
            "verseOrgIds": [
              "MAT.22.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Inu achiphamaso, bwanji mufuna kundipezera chifukwa?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.18",
                "verseOrgIds": [
                  "MAT.22.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.18",
            "verseOrgIds": [
              "MAT.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Onetseni ndalama imene mumapereka msonkho.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.19",
                "verseOrgIds": [
                  "MAT.22.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Iwo anabweretsa dinari,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.19",
            "verseOrgIds": [
              "MAT.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo anawafunsa kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.20",
            "verseOrgIds": [
              "MAT.22.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kodi chithunzi ichi ndi malemba awa ndi za ndani?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.20",
                "verseOrgIds": [
                  "MAT.22.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anayankha kuti, \"Ndi za Kaisara.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.21",
            "verseOrgIds": [
              "MAT.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 22:21"
      },
      "items": [
        {
          "text": "Pamenepo anawawuza kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.21",
            "verseOrgIds": [
              "MAT.22.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Perekani kwa Kaisara zake za Kaisara, ndi kwa Mulungu zake za Mulungu.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.21",
                "verseOrgIds": [
                  "MAT.22.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atamva izi, anadabwa, ndipo anamusiya Iye, nachoka.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.22",
            "verseOrgIds": [
              "MAT.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ukwati ndi za Kuuka kwa Akufa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku lomwelo Asaduki amene amati kulibe za kuukanso, anabwera kwa Iye ndi funso.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.23",
            "verseOrgIds": [
              "MAT.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anati, \"Aphunzitsi, Mose anatiwuza kuti munthu akamwalira wosasiya ana, mʼbale wake akuyenera kukwatira mkazi wamasiyeyo kuti amuberekere ana mʼbale wakeyo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.24",
            "verseOrgIds": [
              "MAT.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsopano panali abale asanu ndi awiri pakati pathu. Woyambayo anakwatira ndipo anamwalira, ndipo popeza analibe ana, mʼbale wake analowa chokolo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.25",
            "verseOrgIds": [
              "MAT.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izi zinachitikiranso mʼbale wa chiwiri ndi wachitatu mpaka wachisanu ndi chiwiri.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.26",
            "verseOrgIds": [
              "MAT.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa mapeto pake mkaziyo anamwaliranso.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.27",
            "verseOrgIds": [
              "MAT.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsopano, kodi akadzaukitsidwa adzakhala mkazi wa ndani mwa asanu ndi awiriwa popeza aliyense anamukwatirapo?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.28",
            "verseOrgIds": [
              "MAT.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anayankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.29",
            "verseOrgIds": [
              "MAT.22.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Inu mukulakwitsa chifukwa simukudziwa malemba kapena mphamvu ya Mulungu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.29",
                "verseOrgIds": [
                  "MAT.22.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.29",
            "verseOrgIds": [
              "MAT.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Anthu akadzaukitsidwa, sadzakwatira kapena kukwatiwa; adzakhala ngati angelo kumwamba.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.30",
                "verseOrgIds": [
                  "MAT.22.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.30",
            "verseOrgIds": [
              "MAT.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Koma za kuukitsidwa kwa akufa, kodi simunawerenge zimene Mulungu ananena kwa inu kuti,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.31",
                "verseOrgIds": [
                  "MAT.22.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.31",
            "verseOrgIds": [
              "MAT.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "'Ine ndine Mulungu wa Abrahamu, Mulungu wa Isake ndi Mulungu wa Yakobo?' Iyeyo si Mulungu wa akufa koma wa amoyo.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.32",
                "verseOrgIds": [
                  "MAT.22.32"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magulu a anthu atamva zimenezi, anazizwa ndi chiphunzitso chake.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.33",
            "verseOrgIds": [
              "MAT.22.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lamulo Lalikulu Koposa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 22:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakumva kuti Yesu anawakhalitsa chete Asaduki, Afarisi anasonkhana pamodzi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.34",
            "verseOrgIds": [
              "MAT.22.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 22:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmodzi wa iwo, katswiri wa malamulo anamuyesa Iye ndi funso ndipo anati,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.35",
            "verseOrgIds": [
              "MAT.22.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 22:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Aphunzitsi, kodi lamulo lalikulu koposa mu malamulo ndi liti?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.36",
            "verseOrgIds": [
              "MAT.22.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 22:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anayankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.37",
            "verseOrgIds": [
              "MAT.22.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Uzikonda Yehova Mulungu wako ndi mtima wako wonse ndi moyo wako wonse ndi nzeru zako zonse.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.37",
                "verseOrgIds": [
                  "MAT.22.37"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.37",
            "verseOrgIds": [
              "MAT.22.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 22:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ili ndi lamulo loyamba ndi loposa onse.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.38",
                "verseOrgIds": [
                  "MAT.22.38"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.38",
            "verseOrgIds": [
              "MAT.22.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 22:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndipo lachiwiri ndi lofanana nalo: 'Konda mnansi wako monga iwe mwini.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.39",
                "verseOrgIds": [
                  "MAT.22.39"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.39",
            "verseOrgIds": [
              "MAT.22.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 22:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Malamulo onse ndi aneneri zakhazikika pa malamulo awiriwa.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.40",
                "verseOrgIds": [
                  "MAT.22.40"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kodi Khristu ndi Mwana wa Ndani?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 22:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afarisi atasonkhana pamodzi, Yesu anawafunsa kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.41",
            "verseOrgIds": [
              "MAT.22.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 22:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kodi mukuganiza bwanji za Khristu? Ndi Mwana wa ndani?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.42",
                "verseOrgIds": [
                  "MAT.22.42"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 22:42"
      },
      "items": [
        {
          "text": "Iwo anayankha kuti, \"Mwana wa Davide.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.42",
            "verseOrgIds": [
              "MAT.22.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 22:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anawawuza kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.43",
            "verseOrgIds": [
              "MAT.22.43"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nanga zikutheka bwanji kuti Davide poyankhula mwa Mzimu Woyera amatchula Iye 'Ambuye?' Pakuti akuti,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.43",
                "verseOrgIds": [
                  "MAT.22.43"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 22:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ambuye anati kwa Ambuye wanga:",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.44",
                "verseOrgIds": [
                  "MAT.22.44"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 22:44"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "'Khala pa dzanja langa lamanja",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.44",
                "verseOrgIds": [
                  "MAT.22.44"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 22:44"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "mpaka ndiyike adani ako",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.44",
                "verseOrgIds": [
                  "MAT.22.44"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 22:44"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "pansi pa mapazi ako.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.44",
                "verseOrgIds": [
                  "MAT.22.44"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 22:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ngati tsono Davide amamutchula 'Ambuye,' zingatheke bwanji kukhala mwana wake?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.45",
                "verseOrgIds": [
                  "MAT.22.45"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.45",
            "verseOrgIds": [
              "MAT.22.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 22:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panalibe wina anatha kuyankha, ndipo kuchokera pamenepo, panalibe wina anayerekeza kumufunsa funso.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.46",
            "verseOrgIds": [
              "MAT.22.46"
            ]
          }
        }
      ]
    }
  ],
