  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "MAT 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wamkulu mu Ufumu Wakumwamba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa nthawi imeneyo ophunzira anabwera kwa Yesu ndipo anamufunsa kuti, \"Wamkulu woposa onse ndani mu ufumu wakumwamba?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.1",
            "verseOrgIds": [
              "MAT.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anayitana kamwana kakangʼono ndi kukayimiritsa pakati pawo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.2",
            "verseOrgIds": [
              "MAT.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Iye anati,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.3",
            "verseOrgIds": [
              "MAT.18.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Zoonadi, Ine ndikuwuzani kuti ngati simusintha ndi kukhala ngati tiana tatingʼono, simudzalowa konse mu ufumu wakumwamba.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.3",
                "verseOrgIds": [
                  "MAT.18.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.3",
            "verseOrgIds": [
              "MAT.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Chifukwa chake, aliyense amene adzichepetsa yekha ngati kamwana aka, ameneyo ndiye wamkulu koposa onse mu ufumu wakumwamba.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.4",
                "verseOrgIds": [
                  "MAT.18.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.4",
            "verseOrgIds": [
              "MAT.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndipo aliyense amene alandira kamwana kakangʼono ngati aka mu dzina langa, alandira Ine.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.5",
                "verseOrgIds": [
                  "MAT.18.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Za Kuchimwitsa Ena",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Koma ngati wina aliyense achimwitsa mmodzi wa ana awa, amene akhulupirira Ine, kuti achimwe, kukanakhala bwino kuti iye amangiriridwe chimwala chachikulu mʼkhosi mwake ndi kumizidwa pansi pa nyanja.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.6",
                "verseOrgIds": [
                  "MAT.18.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.6",
            "verseOrgIds": [
              "MAT.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tsoka dziko lapansi chifukwa cha zinthu zimene ziyenera kubwera, koma tsoka kwa munthu amene abweretsa zotere!",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.7",
                "verseOrgIds": [
                  "MAT.18.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.7",
            "verseOrgIds": [
              "MAT.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ngati dzanja lako kapena phazi lako likuchimwitsa, lidule ndi kulitaya. Ndi bwino kwa iwe kulowa mʼmoyo wosatha wolumala kusiyana ndi kukhala ndi manja awiri kapena mapazi awiri ndi kukaponyedwa ku moto wosatha.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.8",
                "verseOrgIds": [
                  "MAT.18.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.8",
            "verseOrgIds": [
              "MAT.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndipo ngati diso lako likuchimwitsa, ulichotse ndi kulitaya. Ndi bwino kwa iwe kuti ukalowe ku moyo wosatha ndi diso limodzi kuposa ndi kukhala ndi maso awiri ndi kukaponyedwa ku moto wa gehena.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.9",
                "verseOrgIds": [
                  "MAT.18.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fanizo la Nkhosa Yotayika",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Onetsetsani kuti musanyoze mmodzi wa anawa. Pakuti ndikuwuzani kuti angelo awo kumwamba amakhala pamaso pa Atate anga akumwamba nthawi zonse.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.10",
                "verseOrgIds": [
                  "MAT.18.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.10",
            "verseOrgIds": [
              "MAT.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "(Mwana wa Munthu anabwera kudzapulumutsa chimene chinatayika).",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.11",
                "verseOrgIds": [
                  "MAT.18.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kodi mukuganiza bwanji? Ngati munthu ali ndi nkhosa 100 ndipo imodzi nʼkusowa, kodi sasiya 99 zija mʼmapiri ndi kupita kukafuna imodzi yosocherayo?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.12",
                "verseOrgIds": [
                  "MAT.18.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.12",
            "verseOrgIds": [
              "MAT.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Zoonadi, Ine ndikuwuzani kuti akayipeza amasangalala kwambiri chifukwa cha nkhosa imodziyo kuposa nkhosa 99 zimene sizinasochere.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.13",
                "verseOrgIds": [
                  "MAT.18.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.13",
            "verseOrgIds": [
              "MAT.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Chimodzimodzinso Atate anu akumwamba safuna kuti mmodzi wa anawa atayike.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.14",
                "verseOrgIds": [
                  "MAT.18.14"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Za Mʼbale Amene Akuchimwirani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ngati mʼbale wako akuchimwira, pita kamuwuze cholakwa chake pa awiri. Ngati akumvera, wamubweza mʼbale wakoyo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.15",
                "verseOrgIds": [
                  "MAT.18.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.15",
            "verseOrgIds": [
              "MAT.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Koma ngati sakumvera, katenge wina mmodzi kapena ena awiri, 'kuti nkhani itsimikizike ndi umboni wa anthu awiri kapena atatu.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.16",
                "verseOrgIds": [
                  "MAT.18.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.16",
            "verseOrgIds": [
              "MAT.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ngati iye akana kuwamvera iwo, kaneneni ku mpingo; ndipo ngati sakamvera ngakhale mpingo, muchite naye monga mukanachitira ndi wakunja kapena wolandira msonkho.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.17",
                "verseOrgIds": [
                  "MAT.18.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Zoonadi, Ine ndikuwuzani kuti chilichonse chimene muchimanga pa dziko lapansi, chidzamangidwanso kumwamba, ndipo chilichonse chimene muchimasula pa dziko chidzamasulidwanso kumwamba.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.18",
                "verseOrgIds": [
                  "MAT.18.18"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Komanso ndikukuwuzani inu kuti ngati awiri a inu pa dziko lapansi avomerezana kanthu kalikonse kamene mukapempha, Atate anga akumwamba adzakuchitirani.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.19",
                "verseOrgIds": [
                  "MAT.18.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.19",
            "verseOrgIds": [
              "MAT.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pakuti pamene awiri kapena atatu asonkhana pamodzi mʼdzina langa, Ine ndili nawo pomwepo.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.20",
                "verseOrgIds": [
                  "MAT.18.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fanizo la Wantchito Wopanda Chifundo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Petro anabwera kwa Yesu ndi kumufunsa kuti, \"Ambuye, kodi mʼbale wanga akandichimwira ndimukhululukire kokwanira kangati? Mpaka kasanu nʼkawiri?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.21",
            "verseOrgIds": [
              "MAT.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anayankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.22",
            "verseOrgIds": [
              "MAT.18.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ine ndikukuwuza iwe kuti osati kasanu nʼkawiri, koma ka 70 kuchulukitsa ndi kasanu nʼkawiri.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.22",
                "verseOrgIds": [
                  "MAT.18.22"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nʼchifukwa chake, ufumu wakumwamba ukufanana ndi mfumu imene inafuna kuti antchito ake abweze ngongole.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.23",
                "verseOrgIds": [
                  "MAT.18.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.23",
            "verseOrgIds": [
              "MAT.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Atangoyamba kulandira, anamubweretsa munthu kwa iye amene anakongola ndalama 10,000.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.24",
                "verseOrgIds": [
                  "MAT.18.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.24",
            "verseOrgIds": [
              "MAT.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Popeza sakanatha kubweza, bwanayo analamula kuti iye, mkazi wake, ana ake ndi zonse anali nazo zigulitsidwe kuti zibweze ngongoleyo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.25",
                "verseOrgIds": [
                  "MAT.18.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Wantchitoyo anagwada pamaso pake namupempha iye kuti, 'Lezereni mtima ndipo ndidzabweza zonse.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.26",
                "verseOrgIds": [
                  "MAT.18.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.26",
            "verseOrgIds": [
              "MAT.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bwana wakeyo anamuchitira chifundo, namukhululukira ngongoleyo ndipo anamulola apite.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.27",
                "verseOrgIds": [
                  "MAT.18.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Koma wantchito uja atatuluka, anakumana ndi wantchito mnzake amene anakongola kwa iye madinari 100. Anamugwira, nayamba kumukanyanga pa khosi, namuwumiriza nati, 'Bwezere zimene unakongola kwa ine!'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.28",
                "verseOrgIds": [
                  "MAT.18.28"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Wantchito mnzakeyo anagwada namupempha iye kuti, 'Lezere mtima ine, ndipo ndidzakubwezera.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.29",
                "verseOrgIds": [
                  "MAT.18.29"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Koma iye anakana. Mʼmalo mwake, anachoka nakamumangitsa kufikira atabweza ngongoleyo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.30",
                "verseOrgIds": [
                  "MAT.18.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.30",
            "verseOrgIds": [
              "MAT.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pamene antchito ena anaona zomwe zinachitikazo, anamva chisoni kwambiri ndipo anapita nakawuza bwana wawo zonse zimene zinachitika.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.31",
                "verseOrgIds": [
                  "MAT.18.31"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Pamenepo bwanayo anayitana wantchitoyo nati, 'Iwe wantchito woyipa mtima, ndinakukhululukira ngongole yako yonse chifukwa unandipempha.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.32",
                "verseOrgIds": [
                  "MAT.18.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.32",
            "verseOrgIds": [
              "MAT.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kodi iwe sukanamuchitira chifundo wantchito mnzako monga momwe ine ndinakuchitira iwe?'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.33",
                "verseOrgIds": [
                  "MAT.18.33"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.33",
            "verseOrgIds": [
              "MAT.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndi mkwiyo, bwana wakeyo anamupereka kwa oyangʼanira ndende kuti amuzuze mpaka atabweza zonse zimene anakongola.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.34",
                "verseOrgIds": [
                  "MAT.18.34"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Umu ndi mmene Atate anga akumwamba adzachitira ndi aliyense wa inu ngati simukhululukira mʼbale wanu ndi mtima wonse.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.35",
                "verseOrgIds": [
                  "MAT.18.35"
                ]
              }
            }
          ]
        }
      ]
    }
