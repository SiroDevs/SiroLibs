  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "MAT 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Achiritsa Wakhate",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye atatsika ku phiri kuja, anthu ambirimbiri anamutsata.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.1",
            "verseOrgIds": [
              "MAT.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo munthu wakhate anadza kwa Yesu namugwadira nati, \"Ambuye, ngati mufuna, mukhoza kundiyeretsa.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.2",
            "verseOrgIds": [
              "MAT.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anatambasula dzanja lake namukhudza munthuyo nati,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.3",
            "verseOrgIds": [
              "MAT.8.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ndikufuna, yeretsedwa!\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.8.3",
                "verseOrgIds": [
                  "MAT.8.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Nthawi yomweyo anachiritsidwa khate lake.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.3",
            "verseOrgIds": [
              "MAT.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yesu anati kwa iye,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.4",
            "verseOrgIds": [
              "MAT.8.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Taona, usawuze wina aliyense. Koma upite kwa mkulu wa ansembe ukadzionetse wekha ndi kupereka mphatso imene Mose analamulira, kuti ukhale umboni kwa iwo.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.8.4",
                "verseOrgIds": [
                  "MAT.8.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chikhulupiriro cha Kenturiyo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu atalowa mʼKaperenamu, Kenturiyo anabwera kwa Iye napempha chithandizo,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.5",
            "verseOrgIds": [
              "MAT.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nati, \"Ambuye, wantchito wanga ali chigonere ku nyumba, sakuthanso kuyenda, akumva kuwawa kwambiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.6",
            "verseOrgIds": [
              "MAT.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yesu anati kwa iye,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.7",
            "verseOrgIds": [
              "MAT.8.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ine ndibwera kudzamuchiritsa.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.8.7",
                "verseOrgIds": [
                  "MAT.8.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenturiyo uja anayankha kuti, \"Ambuye, ndine wosayenera kuti Inu mukalowe mʼnyumba mwanga. Koma mungonena mawu ndipo wantchito wanga adzachiritsidwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.8",
            "verseOrgIds": [
              "MAT.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti inenso ndili pansi pa ulamuliro ndipo ndili ndi asilikali amene ndiwalamulira. Ndikalamulira mmodzi kuti, 'Pita,' amapita; ndi kwa wina kuti, 'Bwera,' amabwera. Ndikawuza wantchito wanga kuti, 'Chita ichi,' iye amachita.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.9",
            "verseOrgIds": [
              "MAT.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu atamva zimenezi, anadabwa ndipo anati kwa omutsatira,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.10",
            "verseOrgIds": [
              "MAT.8.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Zoonadi, Ine ndikuwuzani kuti sindinapeze wina aliyense mu Israeli wachikhulupiriro chachikulu chotere.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.8.10",
                "verseOrgIds": [
                  "MAT.8.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.10",
            "verseOrgIds": [
              "MAT.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndikuwuzani kuti ambiri adzabwera kuchokera kummawa ndi kumadzulo, nadzakhala nawo pa phwando pamodzi ndi Abrahamu, Isake ndi Yakobo mu ufumu wakumwamba.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.8.11",
                "verseOrgIds": [
                  "MAT.8.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.11",
            "verseOrgIds": [
              "MAT.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Koma eni ake ufumuwo adzaponyedwa ku mdima wakunja kumene kudzakhala kulira ndi kukukuta mano.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.8.12",
                "verseOrgIds": [
                  "MAT.8.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Yesu anati kwa Kenturiyo,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.13",
            "verseOrgIds": [
              "MAT.8.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Pita! Zichitike monga momwe wakhulupirira.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.8.13",
                "verseOrgIds": [
                  "MAT.8.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Ndipo wantchito wake anachira pa nthawi yomweyo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.13",
            "verseOrgIds": [
              "MAT.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Achiritsa Anthu Ambiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yesu atalowa mʼnyumba ya Petro, anaona mpongozi wake wa Petro ali gone akudwala malungo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.14",
            "verseOrgIds": [
              "MAT.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yesu anakhudza dzanja lake ndipo pomwepo anachira nayamba kumutumikira.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.15",
            "verseOrgIds": [
              "MAT.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itafika nthawi yamadzulo, anthu anabweretsa kwa Iye anthu ambiri ogwidwa ndi ziwanda ndipo anatulutsa ziwandazo ndi mawu okha, nachiritsa odwala onse.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.16",
            "verseOrgIds": [
              "MAT.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku kunali kukwaniritsa zimene ananena mneneri Yesaya kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.17",
            "verseOrgIds": [
              "MAT.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 8:17"
      },
      "items": [
        {
          "text": "\"Iye anatenga zofowoka zathu,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.17",
            "verseOrgIds": [
              "MAT.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 8:17"
      },
      "items": [
        {
          "text": "nanyamula nthenda zathu.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.17",
            "verseOrgIds": [
              "MAT.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Za Kutsatira Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ataona gulu la anthu litamuzungulira, analamula kuti awolokere kutsidya lina la nyanja.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.18",
            "verseOrgIds": [
              "MAT.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo mphunzitsi wa malamulo anabwera kwa Iye nati, \"Aphunzitsi, ine ndidzakutsatani kulikonse kumene muzipita.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.19",
            "verseOrgIds": [
              "MAT.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anayankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.20",
            "verseOrgIds": [
              "MAT.8.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nkhandwe zili ndi mapanga ndi mbalame zamlengalenga zili ndi zisa, koma Mwana wa Munthu alibe malo ogona ngakhale potsamira mutu wake.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.8.20",
                "verseOrgIds": [
                  "MAT.8.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wophunzira wina anati kwa Iye, \"Ambuye, mundilole ndiyambe ndakayika maliro a abambo anga.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.21",
            "verseOrgIds": [
              "MAT.8.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Yesu anamuwuza kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.22",
            "verseOrgIds": [
              "MAT.8.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nditsate Ine ndipo uwaleke akufa ayikane akufa okhaokha.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.8.22",
                "verseOrgIds": [
                  "MAT.8.22"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Aletsa Namondwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye atalowa mʼbwato, ophunzira ake anamutsatira.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.23",
            "verseOrgIds": [
              "MAT.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo taonani mwadzidzidzi mphepo yayikulu yamkuntho inawomba pa nyanjapo, kotero kuti bwatolo linayamba kumizidwa ndi mafunde. Koma Yesu anali mtulo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.24",
            "verseOrgIds": [
              "MAT.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ophunzira ake anapita namudzutsa nati, \"Ambuye! Tipulumutseni! Tikumira!\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.25",
            "verseOrgIds": [
              "MAT.8.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anawayankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.26",
            "verseOrgIds": [
              "MAT.8.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Inu achikhulupiriro chochepa, chifukwa chiyani mukuchita mantha?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.8.26",
                "verseOrgIds": [
                  "MAT.8.26"
                ]
              }
            }
          ]
        },
        {
          "text": "Ndipo anayimirira nadzudzula mphepoyo ndi mafunde ndipo panali bata lalikulu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.26",
            "verseOrgIds": [
              "MAT.8.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo ophunzirawo anadabwa nafunsa kuti, \"Ndi munthu wotani uyu? Kuti ngakhale mphepo ndi mafunde zimvera Iye!\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.27",
            "verseOrgIds": [
              "MAT.8.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ogwidwa ndi Ziwanda a ku Gadara",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo atafika ku mbali ina ya dera la Gadara, anakumana ndi anthu awiri ogwidwa ndi ziwanda akuchokera ku manda. Iwowa anali woopsa kwambiri kotero kuti panalibe munthu akanatha kudzera njira imeneyo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.28",
            "verseOrgIds": [
              "MAT.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo iwo anafuwulira kwa Yesu nati, \"Mukufuna chiyani kwa ife, Inu Mwana wa Mulungu? Kodi mwabwera kuno kudzatizunza nthawi yake isanafike?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.29",
            "verseOrgIds": [
              "MAT.8.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo patali pake panali gulu la nkhumba zimene zimadya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.30",
            "verseOrgIds": [
              "MAT.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo ziwandazo zinamupempha Yesu kuti, \"Ngati mutitulutsa ife mutitumize mu nkhumba izo.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.31",
            "verseOrgIds": [
              "MAT.8.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anati kwa ziwandazo,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.32",
            "verseOrgIds": [
              "MAT.8.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Pitani!\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.8.32",
                "verseOrgIds": [
                  "MAT.8.32"
                ]
              }
            }
          ]
        },
        {
          "text": "Ndipo pamenepo zinatuluka ndi kukalowa mʼnkhumbazo ndipo nkhumba zonse zinathamangira mʼnyanja ndi kufera momwemo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.32",
            "verseOrgIds": [
              "MAT.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma amene amaziweta anathawa nalowa mʼmudzi nafotokoza zonse, kuphatikizapo zimene zinachitika ndi anthu ogwidwa ndi ziwanda aja.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.33",
            "verseOrgIds": [
              "MAT.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo anthu onse a mʼmudziwo anatuluka kukakumana ndi Yesu. Ndipo atamuona Iye, anamupempha kuti achoke mʼdera lawo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.34",
            "verseOrgIds": [
              "MAT.8.34"
            ]
          }
        }
      ]
    }
  ],
