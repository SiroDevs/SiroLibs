  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "MRK 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Achiritsa Wolumala Dzanja",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthawi inanso analowa mʼsunagoge, ndipo munthu wa dzanja lolumala anali momwemo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.1",
            "verseOrgIds": [
              "MRK.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ena a iwo anafunafuna chifukwa chakuti akamuneneze Yesu, potero anamuyangʼanitsitsa kuti aone ngati angamuchiritse tsiku la Sabata.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.2",
            "verseOrgIds": [
              "MRK.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anati kwa munthu wolumala dzanjayo,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.3",
            "verseOrgIds": [
              "MRK.3.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Imirira, bwera kuno kutsogolo.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.3.3",
                "verseOrgIds": [
                  "MRK.3.3"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yesu anawafunsa kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.4",
            "verseOrgIds": [
              "MRK.3.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kodi chololedwa ndi chiyani pa tsiku la Sabata: kuchita chabwino kapena kuchita choyipa, kupulumutsa moyo kapena kupha?\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.3.4",
                "verseOrgIds": [
                  "MRK.3.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Koma iwo anakhala chete.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.4",
            "verseOrgIds": [
              "MRK.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anawayangʼana ndi mkwiyo ndipo powawidwa mtima chifukwa cha mitima yawo yowuma anati kwa munthuyo,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.5",
            "verseOrgIds": [
              "MRK.3.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Wongola dzanja lako.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.3.5",
                "verseOrgIds": [
                  "MRK.3.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Iye analiwongola, ndipo dzanja lake linachira.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.5",
            "verseOrgIds": [
              "MRK.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Afarisi anatuluka nayamba kukonza chiwembu ndi Aherode mmene angamuphere Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.6",
            "verseOrgIds": [
              "MRK.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Magulu a Anthu Amutsata Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anachoka pamodzi ndi ophunzira ake napita ku nyanja, ndipo gulu lalikulu la anthu lochokera ku Galileya linamutsata.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.7",
            "verseOrgIds": [
              "MRK.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atamva zonse zimene amachita, anthu ambiri anabwera kwa Iye kuchokera ku Yudeya, Yerusalemu, Idumeya ndi madera a ku tsidya kwa mtsinje wa Yorodani ndi ozungulira Turo ndi Sidoni.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.8",
            "verseOrgIds": [
              "MRK.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chifukwa cha gulu la anthu, anawuza ophunzira ake kuti apezeretu bwato likhale, kuti anthu angamupanikize.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.9",
            "verseOrgIds": [
              "MRK.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti anachiritsa ambiri, kotero kuti iwo amene anali ndi matenda amakankhana kutsogolo kuti amukhudze.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.10",
            "verseOrgIds": [
              "MRK.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthawi iliyonse mizimu yoyipa ikamuona, imagwa pansi pamaso pake ndi kufuwula kuti, \"Inu ndinu Mwana wa Mulungu!\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.11",
            "verseOrgIds": [
              "MRK.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma anayichenjeza mwamphamvu kuti isanene kuti Iye anali ndani.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.12",
            "verseOrgIds": [
              "MRK.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Asankha Ophunzira Khumi ndi Awiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anakwera ku phiri ndipo anayitana amene anawafuna, ndipo anabwera kwa Iye.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.13",
            "verseOrgIds": [
              "MRK.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anasankha khumi ndi awiri, nawayika akhale atumwi; pokhala ndi Iye aziwatuma kukalalikira",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.14",
            "verseOrgIds": [
              "MRK.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndi kuti akhale ndi ulamuliro wotulutsa ziwanda.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.15",
            "verseOrgIds": [
              "MRK.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awa ndi khumi ndi awiri amene anawasankha: Simoni (amene anapatsidwa dzina lakuti Petro);",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.16",
            "verseOrgIds": [
              "MRK.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo mwana wa Zebedayo, ndi mʼbale wake Yohane (iwowa anawapatsa dzina lakuti Bowanege, ndiye kuti ana a bingu);",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.17",
            "verseOrgIds": [
              "MRK.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andreya, Filipo, Bartumeyu, Mateyu, Tomasi, Yakobo mwana wa Alufeyo, Tadeyo, Simoni Zelote,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.18",
            "verseOrgIds": [
              "MRK.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndi Yudasi Isikarioti, amene anamupereka Iye.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.19",
            "verseOrgIds": [
              "MRK.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu ndi Belezebabu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pambuyo pake Yesu analowa mʼnyumba, ndipo gulu la anthu linasonkhananso, kotero kuti Iye pamodzi ndi ophunzira ake sanapeze mpata kuti adye.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.20",
            "verseOrgIds": [
              "MRK.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu a ku banja lake atamva zimenezi, anapita kuti akamutenga, pakuti ankanena kuti, \"Wazungulira mutu.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.21",
            "verseOrgIds": [
              "MRK.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo aphunzitsi amalamulo omwe anachokera ku Yerusalemu anati, \"Iye wagwidwa ndi Belezebabu! Ndi ulamuliro wa mkulu wa ziwanda akutulutsa ziwanda.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.22",
            "verseOrgIds": [
              "MRK.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Yesu anawayitana nawayankhula mʼmafanizo nati:",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.23",
            "verseOrgIds": [
              "MRK.3.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kodi Satana angatulutse bwanji Satana?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.3.23",
                "verseOrgIds": [
                  "MRK.3.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.23",
            "verseOrgIds": [
              "MRK.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ngati ufumu ugawanikana mwa iwo okha, ufumu umenewo sungakhalitse.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.3.24",
                "verseOrgIds": [
                  "MRK.3.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.24",
            "verseOrgIds": [
              "MRK.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ngati nyumba igawanikana mwa iyo yokha, nyumba imeneyo singathe kuyima.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.3.25",
                "verseOrgIds": [
                  "MRK.3.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.25",
            "verseOrgIds": [
              "MRK.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndipo ngati Satana adzitsutsa yekha sangathe kuyima; ulamuliro wake watha.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.3.26",
                "verseOrgIds": [
                  "MRK.3.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.26",
            "verseOrgIds": [
              "MRK.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kunena zoona, palibe munthu angalowe mʼnyumba ya munthu wamphamvu ndi kutenga katundu wake pokhapokha atayamba wamumanga munthu wamphamvuyo. Pamenepo akhoza kumubera.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.3.27",
                "verseOrgIds": [
                  "MRK.3.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.27",
            "verseOrgIds": [
              "MRK.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndikukuwuzani zoona kuti machimo onse ndi zamwano zonse za anthu zidzakhululukidwa,",
              "type": "text",
              "attrs": {
                "verseId": "MRK.3.28",
                "verseOrgIds": [
                  "MRK.3.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.28",
            "verseOrgIds": [
              "MRK.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "koma aliyense amene achitira mwano Mzimu Woyera sadzakhululukidwa pakuti wachita tchimo losatha.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.3.29",
                "verseOrgIds": [
                  "MRK.3.29"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ananena izi chifukwa anati, \"Ali ndi mzimu woyipa.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.30",
            "verseOrgIds": [
              "MRK.3.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amayi ndi Abale ake a Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo amayi ndi abale ake a Yesu anafika. Atayima kunja, anatuma wina kuti akamuyitane Iye.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.31",
            "verseOrgIds": [
              "MRK.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gulu la anthu linakhala momuzungulira Iye, ndipo anamuwuza kuti, \"Amayi ndi abale anu ali panja akukufunani.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.32",
            "verseOrgIds": [
              "MRK.3.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 3:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anafunsa kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.33",
            "verseOrgIds": [
              "MRK.3.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Amayi ndi abale anga ndi ndani?\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.3.33",
                "verseOrgIds": [
                  "MRK.3.33"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 3:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo anayangʼana anthu amene anakhala momuzungurira ndipo anati,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.34",
            "verseOrgIds": [
              "MRK.3.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Awa ndi amayi anga ndi abale anga!",
              "type": "text",
              "attrs": {
                "verseId": "MRK.3.34",
                "verseOrgIds": [
                  "MRK.3.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.34",
            "verseOrgIds": [
              "MRK.3.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 3:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Aliyense amene achita chifuniro cha Mulungu ndi mʼbale wanga ndi mlongo wanga ndi amayi anga.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.3.35",
                "verseOrgIds": [
                  "MRK.3.35"
                ]
              }
            }
          ]
        }
