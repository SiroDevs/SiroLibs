  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "EZK 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Munthu Wochimwa Adzafa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anandiyankhula nati:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.1",
            "verseOrgIds": [
              "EZK.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kodi anthu inu mumatanthauza chiyani mukamabwerezabwereza kunena mwambi uwu wokhudza dziko la Israeli kuti:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.2",
            "verseOrgIds": [
              "EZK.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:2"
      },
      "items": [
        {
          "text": "\" 'Nkhuyu zodya akulu zimapota",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.2",
            "verseOrgIds": [
              "EZK.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:2"
      },
      "items": [
        {
          "text": "ndi ana omwe?' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.2",
            "verseOrgIds": [
              "EZK.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndithu pali Ine wamoyo, akutero Ambuye Yehova, simudzanenanso mwambi umenewu mu Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.3",
            "verseOrgIds": [
              "EZK.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti moyo uliwonse ndi wanga. Moyo wa abambo ndi wanga, wamwananso ndi wanga. Munthu wochimwa ndi amene adzafe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.4",
            "verseOrgIds": [
              "EZK.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tiyerekeze kuti pali munthu wolungama",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.5",
            "verseOrgIds": [
              "EZK.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:5"
      },
      "items": [
        {
          "text": "amene amachita zolungama ndi zolondola.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.5",
            "verseOrgIds": [
              "EZK.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye sadyera nawo pa mapiri a chipembedzo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.6",
            "verseOrgIds": [
              "EZK.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:6"
      },
      "items": [
        {
          "text": "kapena kupembedza mafano a Aisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.6",
            "verseOrgIds": [
              "EZK.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:6"
      },
      "items": [
        {
          "text": "Iye sayipitsa mkazi wa mnzake",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.6",
            "verseOrgIds": [
              "EZK.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:6"
      },
      "items": [
        {
          "text": "kapena kugonana ndi mkazi pamene akusamba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.6",
            "verseOrgIds": [
              "EZK.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye sapondereza munthu wina aliyense,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.7",
            "verseOrgIds": [
              "EZK.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:7"
      },
      "items": [
        {
          "text": "koma amabwezera wangongole nʼchigwiriro chake.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.7",
            "verseOrgIds": [
              "EZK.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:7"
      },
      "items": [
        {
          "text": "Iye salanda zinthu za osauka,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.7",
            "verseOrgIds": [
              "EZK.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:7"
      },
      "items": [
        {
          "text": "koma amapereka chakudya kwa anthu anjala,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.7",
            "verseOrgIds": [
              "EZK.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:7"
      },
      "items": [
        {
          "text": "ndipo amapereka zovala kwa anthu ausiwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.7",
            "verseOrgIds": [
              "EZK.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye sakongoletsa ndalama mwa katapira,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.8",
            "verseOrgIds": [
              "EZK.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:8"
      },
      "items": [
        {
          "text": "kapena kulandira chiwongoladzanja chachikulu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.8",
            "verseOrgIds": [
              "EZK.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:8"
      },
      "items": [
        {
          "text": "Amadziletsa kuchita zoyipa",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.8",
            "verseOrgIds": [
              "EZK.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:8"
      },
      "items": [
        {
          "text": "ndipo sakondera poweruza milandu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.8",
            "verseOrgIds": [
              "EZK.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amatsatira malangizo anga,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.9",
            "verseOrgIds": [
              "EZK.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:9"
      },
      "items": [
        {
          "text": "ndipo amasunga malamulo anga mokhulupirika.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.9",
            "verseOrgIds": [
              "EZK.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:9"
      },
      "items": [
        {
          "text": "Munthu ameneyo ndi wolungama;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.9",
            "verseOrgIds": [
              "EZK.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:9"
      },
      "items": [
        {
          "text": "iye adzakhala ndithu ndi moyo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.9",
            "verseOrgIds": [
              "EZK.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "EZK 18:9"
      },
      "items": [
        {
          "text": "akutero Ambuye Yehova.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tiyerekeze kuti munthu wolungama chotere wabala mwana chimbalangondo amene amakhalira kupha anthu ndi kuchita zinthu zina zotere.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.10",
            "verseOrgIds": [
              "EZK.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye nʼkumachita zinthu zimene ngakhale abambo ake sanachitepo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.11",
            "verseOrgIds": [
              "EZK.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:11"
      },
      "items": [
        {
          "text": "\"Amadyera nawo ku mapiri achipembedzo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.11",
            "verseOrgIds": [
              "EZK.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:11"
      },
      "items": [
        {
          "text": "Amayipitsa mkazi wa mnzake.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.11",
            "verseOrgIds": [
              "EZK.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amapondereza munthu wosauka ndi wosowa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.12",
            "verseOrgIds": [
              "EZK.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:12"
      },
      "items": [
        {
          "text": "Amalanda zinthu za osauka.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.12",
            "verseOrgIds": [
              "EZK.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:12"
      },
      "items": [
        {
          "text": "Sabweza chikole cha munthu wa ngongole.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.12",
            "verseOrgIds": [
              "EZK.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:12"
      },
      "items": [
        {
          "text": "Iye amatembenukira ku mafano",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.12",
            "verseOrgIds": [
              "EZK.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:12"
      },
      "items": [
        {
          "text": "nachita zonyansa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.12",
            "verseOrgIds": [
              "EZK.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amakongoletsa mwa katapira ndipo amalandira chiwongoladzanja chachikulu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.13",
            "verseOrgIds": [
              "EZK.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "EZK 18:13"
      },
      "items": [
        {
          "text": "Kodi munthu wotereyu nʼkukhala ndi moyo? Ayi ndithu! Chifukwa wachita zinthu zonyansa zonsezi, adzaphedwa ndipo adzalandira chilango chomuyenera.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.13",
            "verseOrgIds": [
              "EZK.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tsono tiyerekeze kuti munthu woyipa uyu wabala mwana amene amaona machimo onse amene abambo ake ankachita. Ngakhale amaona koma osatsanzira ntchito zake zoyipazo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.14",
            "verseOrgIds": [
              "EZK.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sadyera nawo pa mapiri achipembedzo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.15",
            "verseOrgIds": [
              "EZK.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:15"
      },
      "items": [
        {
          "text": "Sapembedza mafano a ku Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.15",
            "verseOrgIds": [
              "EZK.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:15"
      },
      "items": [
        {
          "text": "Sayipitsa mkazi wa mnzake.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.15",
            "verseOrgIds": [
              "EZK.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sapondereza munthu wina aliyense.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.16",
            "verseOrgIds": [
              "EZK.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:16"
      },
      "items": [
        {
          "text": "Satenga chikole akabwereketsa chinthu. Salanda zinthu za osauka.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.16",
            "verseOrgIds": [
              "EZK.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:16"
      },
      "items": [
        {
          "text": "Salanda zinthu za munthu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.16",
            "verseOrgIds": [
              "EZK.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:16"
      },
      "items": [
        {
          "text": "Amapereka chakudya kwa anthu anjala.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.16",
            "verseOrgIds": [
              "EZK.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:16"
      },
      "items": [
        {
          "text": "Amapereka zovala kwa anthu aumphawi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.16",
            "verseOrgIds": [
              "EZK.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadziletsa kuchita zoyipa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.17",
            "verseOrgIds": [
              "EZK.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:17"
      },
      "items": [
        {
          "text": "Sakongoletsa kuti apezepo phindu. Salandira chiwongoladzanja.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.17",
            "verseOrgIds": [
              "EZK.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:17"
      },
      "items": [
        {
          "text": "Amasunga malangizo anga ndi kumvera malamulo anga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.17",
            "verseOrgIds": [
              "EZK.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "EZK 18:17"
      },
      "items": [
        {
          "text": "Munthu wotereyo sadzafa chifukwa cha machimo a abambo ake. Adzakhala ndi moyo ndithu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.17",
            "verseOrgIds": [
              "EZK.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma abambo ake, popeza kuti anazunza anthu ena ndi kubera mʼbale wawo ndiponso popeza kuti sanachitire zabwino anansi ake, adzafera machimo ake omwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.18",
            "verseOrgIds": [
              "EZK.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mwina inu mukhoza kufunsa kuti, 'Nʼchifukwa chiyani mwana salangidwa chifukwa cha kulakwa kwa abambo ake? Ayi, mwanayo adzakhala ndi moyo chifukwa ankachita zolungama ndi zolondola ndipo ankasamala kumvera malamulo anga onse.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.19",
            "verseOrgIds": [
              "EZK.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthu wochimwa ndiye amene adzafe. Mwana sadzapezeka wolakwa chifukwa cha abambo ake, kapena abambo kupezeka wolakwa chifukwa cha mwana wawo. Chilungamo cha munthu wolungama ndicho chidzamupulutse, ndipo kuyipa kwa munthu wochimwa ndiko kudzamuwonongetse.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.20",
            "verseOrgIds": [
              "EZK.18.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Munthu woyipa akatembenuka mtima ndi kusiya machimo amene ankachita ndi kuyamba kumvera malamulo anga ndi kumachita zolungama ndi zokhulupirika, ndiye kuti adzakhala ndi moyo. Sadzafa ayi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.21",
            "verseOrgIds": [
              "EZK.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zoyipa zake zonse zidzakhululukidwa. Chifukwa cha zinthu zolungama zimene anazichita adzakhala ndi moyo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.22",
            "verseOrgIds": [
              "EZK.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi Ine ndimakondwera ndi imfa ya munthu woyipa? Ayi, ndimakondwera pamene woyipa watembenuka mtima kuti akhale ndi moyo. Akutero Ambuye Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.23",
            "verseOrgIds": [
              "EZK.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Koma ngati munthu wolungama apatuka kusiya zachilungamo ndi kuyamba kuchita tchimo ndi zonyansa za mtundu uliwonse zimene amachita anthu oyipa, kodi munthu wotereyu nʼkukhala ndi moyo? Ayi ndithu, zolungama zake zonse sizidzakumbukiridwa. Iye adzayenera kufa chifukwa cha machimo amene anachita.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.24",
            "verseOrgIds": [
              "EZK.18.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Komabe inu mukunena kuti, 'Zimene Ambuye amachita ndi zopanda chilungamo.' Tamvani tsono inu Aisraeli: Kodi zochita zanga ndizo zosalungama? Kodi si zochita zanu zimene ndi zosalungama?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.25",
            "verseOrgIds": [
              "EZK.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati munthu wolungama atembenuka kusiya chilungamo chake ndi kuchita tchimo, iye adzafa chifukwa cha tchimolo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.26",
            "verseOrgIds": [
              "EZK.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ngati munthu woyipa aleka zoyipa zake zimene anazichita ndi kuyamba kuchita zimene ndi zolungama ndi zolondola, iye adzapulumutsa moyo wake.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.27",
            "verseOrgIds": [
              "EZK.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Popeza waganizira za zolakwa zonse ankachita ndipo wazileka, iye adzakhala ndi moyo ndithu; sadzafa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.28",
            "verseOrgIds": [
              "EZK.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komabe Aisraeli akunena kuti, 'Zimene Ambuye amachita ndi zopanda chilungamo.' Kodi zochita zanga ndizo zopanda chilungamo, inu Aisraeli? Kodi si zochita zanu zimene ndi zopanda chilungamo?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.29",
            "verseOrgIds": [
              "EZK.18.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Chifukwa chake Ine Ambuye Yehova ndikuti: inu Aisraeli, Ine ndidzakuweruzani aliyense wa inu molingana ndi ntchito zake. Lapani! Lekani zoyipa zanu kuti musawonongeke nazo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.30",
            "verseOrgIds": [
              "EZK.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tayani zolakwa zanu zonse zimene munandichimwira nazo ndipo khalani ndi mtima watsopano ndi mzimu watsopano. Kodi muferanji inu Aisraeli?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.31",
            "verseOrgIds": [
              "EZK.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine sindikondwera ndi imfa ya munthu aliyense, akutero Ambuye Yehova. Chifukwa chake, lapani kuti mukhale ndi moyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.32",
            "verseOrgIds": [
              "EZK.18.32"
            ]
          }
        }
      ]
    }
  ],
