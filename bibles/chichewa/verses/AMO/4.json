  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "AMO 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Israeli Sanabwerere kwa Mulungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "AMO 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imvani mawu awa, inu ngʼombe zazikazi za ku Basani, okhala pa Phiri la Samariya,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.1",
            "verseOrgIds": [
              "AMO.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:1"
      },
      "items": [
        {
          "text": "inu akazi amene mumapondereza anthu osauka ndi kuzunza anthu osowa",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.1",
            "verseOrgIds": [
              "AMO.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:1"
      },
      "items": [
        {
          "text": "ndi kumanena kwa amuna anu kuti, \"Tipatseni zakumwa!\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.1",
            "verseOrgIds": [
              "AMO.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambuye Yehova, mwa kuyera mtima kwake walumbira kuti,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.2",
            "verseOrgIds": [
              "AMO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:2"
      },
      "items": [
        {
          "text": "\"Nthawi idzafika ndithu",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.2",
            "verseOrgIds": [
              "AMO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:2"
      },
      "items": [
        {
          "text": "pamene adzakukokani ndi ngowe,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.2",
            "verseOrgIds": [
              "AMO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:2"
      },
      "items": [
        {
          "text": "womaliza wa inu adzakokedwa ndi mbedza.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.2",
            "verseOrgIds": [
              "AMO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mudzatulukira mʼmingʼalu ya pa khoma",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.3",
            "verseOrgIds": [
              "AMO.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:3"
      },
      "items": [
        {
          "text": "aliyense payekhapayekha,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.3",
            "verseOrgIds": [
              "AMO.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:3"
      },
      "items": [
        {
          "text": "ndipo mudzatayidwa ku Harimoni,\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.3",
            "verseOrgIds": [
              "AMO.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "AMO 4:3"
      },
      "items": [
        {
          "text": "akutero Yehova.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bwerani ku Beteli mudzachimwe;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.4",
            "verseOrgIds": [
              "AMO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:4"
      },
      "items": [
        {
          "text": "ndi ku Giligala kuti mudzapitirize kuchimwa.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.4",
            "verseOrgIds": [
              "AMO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:4"
      },
      "items": [
        {
          "text": "Bweretsani nsembe zanu mmawa uliwonse,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.4",
            "verseOrgIds": [
              "AMO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:4"
      },
      "items": [
        {
          "text": "bweretsani chakhumi chanu masiku atatu aliwonse.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.4",
            "verseOrgIds": [
              "AMO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wotchani buledi wokhala ndi yisiti ngati nsembe yachiyamiko",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.5",
            "verseOrgIds": [
              "AMO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:5"
      },
      "items": [
        {
          "text": "ndi kumanyadira poyera za zopereka zanu zaufulu.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.5",
            "verseOrgIds": [
              "AMO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:5"
      },
      "items": [
        {
          "text": "Inu Aisraeli, zinyadireni nsembezo,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.5",
            "verseOrgIds": [
              "AMO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:5"
      },
      "items": [
        {
          "text": "pakuti izi ndi zimene mumakonda kuchita,\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.5",
            "verseOrgIds": [
              "AMO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "AMO 4:5"
      },
      "items": [
        {
          "text": "akutero Ambuye Yehova.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndine amene ndinakusendetsani milomo mʼmizinda yanu yonse,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.6",
            "verseOrgIds": [
              "AMO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:6"
      },
      "items": [
        {
          "text": "ndipo munasowa chakudya mʼmizinda yanu.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.6",
            "verseOrgIds": [
              "AMO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:6"
      },
      "items": [
        {
          "text": "Komatu inu simunabwerere kwa Ine,\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.6",
            "verseOrgIds": [
              "AMO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "AMO 4:6"
      },
      "items": [
        {
          "text": "akutero Yehova.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndinenso amene ndinamanga mvula",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.7",
            "verseOrgIds": [
              "AMO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:7"
      },
      "items": [
        {
          "text": "patangotsala miyezi itatu kuti mukolole.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.7",
            "verseOrgIds": [
              "AMO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:7"
      },
      "items": [
        {
          "text": "Ndinagwetsa mvula pa mzinda wina,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.7",
            "verseOrgIds": [
              "AMO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:7"
      },
      "items": [
        {
          "text": "koma pa mzinda wina ayi,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.7",
            "verseOrgIds": [
              "AMO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:7"
      },
      "items": [
        {
          "text": "mvula inkagwa pa munda wina;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.7",
            "verseOrgIds": [
              "AMO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:7"
      },
      "items": [
        {
          "text": "koma sinagwe pa munda wina ndipo mbewu zinawuma.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.7",
            "verseOrgIds": [
              "AMO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu ankayenda mzinda ndi mzinda kufuna madzi,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.8",
            "verseOrgIds": [
              "AMO.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:8"
      },
      "items": [
        {
          "text": "koma sanapeze madzi okwanira kumwa.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.8",
            "verseOrgIds": [
              "AMO.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:8"
      },
      "items": [
        {
          "text": "Komabe inu simunabwerere kwa Ine,\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.8",
            "verseOrgIds": [
              "AMO.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "AMO 4:8"
      },
      "items": [
        {
          "text": "akutero Yehova.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nthawi zambiri ndinakantha mbewu zanu ndiponso minda ya mpesa,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.9",
            "verseOrgIds": [
              "AMO.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:9"
      },
      "items": [
        {
          "text": "ndinayikantha ndi chinsikwi ndiponso ndi chiwawu.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.9",
            "verseOrgIds": [
              "AMO.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:9"
      },
      "items": [
        {
          "text": "Dzombe linawononga mikuyu yanu ndi mitengo ya olivi.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.9",
            "verseOrgIds": [
              "AMO.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:9"
      },
      "items": [
        {
          "text": "Komabe inu simunabwerere kwa Ine,\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.9",
            "verseOrgIds": [
              "AMO.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "AMO 4:9"
      },
      "items": [
        {
          "text": "akutero Yehova.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ine ndinabweretsa miliri pakati panu",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.10",
            "verseOrgIds": [
              "AMO.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:10"
      },
      "items": [
        {
          "text": "monga ndinachitira ku Igupto.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.10",
            "verseOrgIds": [
              "AMO.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:10"
      },
      "items": [
        {
          "text": "Ndinapha anyamata anu ndi lupanga,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.10",
            "verseOrgIds": [
              "AMO.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:10"
      },
      "items": [
        {
          "text": "ndinapereka akavalo anu kwa adani.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.10",
