  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "AMO 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dengu la Zipatso Zakupsa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "AMO 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zimene Ambuye Yehova anandionetsa ndi izi: dengu la zipatso zakupsa.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.1",
            "verseOrgIds": [
              "AMO.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anandifunsa kuti, \"Amosi nʼchiyani ukuona?\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.2",
            "verseOrgIds": [
              "AMO.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "AMO 8:2"
      },
      "items": [
        {
          "text": "Ine ndinayankha kuti, \"Dengu la zipatso zakupsa.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.2",
            "verseOrgIds": [
              "AMO.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "AMO 8:2"
      },
      "items": [
        {
          "text": "Ndipo Yehova anati kwa ine, \"Nthawi yachimaliziro yawakwanira anthu anga Aisraeli; sindidzawakhululukiranso.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.2",
            "verseOrgIds": [
              "AMO.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tsiku limenelo,\" Ambuye Yehova akulengeza kuti, \"Nyimbo za mʼNyumba ya Mulungu zidzasanduka kulira kofuwula. Mitembo ya anthu idzachuluka, ndipo adzayiponya ponseponse! Kudzangoti zii!\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.3",
            "verseOrgIds": [
              "AMO.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imvani izi, inu amene mumapondereza anthu osowa",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.4",
            "verseOrgIds": [
              "AMO.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:4"
      },
      "items": [
        {
          "text": "ndipo simulabadira anthu osauka a mʼdzikomu.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.4",
            "verseOrgIds": [
              "AMO.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumanena kuti,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 8:5"
      },
      "items": [
        {
          "text": "\"Kodi chikondwerero cha mwezi watsopano chidzatha liti",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:5"
      },
      "items": [
        {
          "text": "kuti tigulitse zinthu?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 8:5"
      },
      "items": [
        {
          "text": "Ndipo tsiku la Sabata litha liti",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:5"
      },
      "items": [
        {
          "text": "kuti tigulitse tirigu,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 8:5"
      },
      "items": [
        {
          "text": "kuti tichepetse miyeso,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:5"
      },
      "items": [
        {
          "text": "kukweza mitengo",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:5"
      },
      "items": [
        {
          "text": "kuti tibere anthu ndi miyeso ya chinyengo,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "tigule osauka ndi ndalama zasiliva",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.6",
            "verseOrgIds": [
              "AMO.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:6"
      },
      "items": [
        {
          "text": "ndi osowa powapatsa nsapato,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.6",
            "verseOrgIds": [
              "AMO.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:6"
      },
      "items": [
        {
          "text": "tigulitse ngakhale mungu wa tirigu?\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.6",
            "verseOrgIds": [
              "AMO.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova amene Yakobo amamunyadira, walumbira kuti: Ine sindidzayiwala chilichonse chimene anachita.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.7",
            "verseOrgIds": [
              "AMO.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kodi dziko silidzagwedezeka chifukwa cha zimenezi,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.8",
            "verseOrgIds": [
              "AMO.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:8"
      },
      "items": [
        {
          "text": "ndi onse okhala mʼmenemo kulira mwachisoni?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.8",
            "verseOrgIds": [
              "AMO.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 8:8"
      },
      "items": [
        {
          "text": "Dziko lonse lidzavunduka ngati mtsinje wa Nailo;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.8",
            "verseOrgIds": [
              "AMO.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:8"
      },
      "items": [
        {
          "text": "lidzagwedezeka kenaka nʼkukhala bata",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.8",
            "verseOrgIds": [
              "AMO.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:8"
      },
      "items": [
        {
          "text": "ngati mtsinje wa ku Igupto.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.8",
            "verseOrgIds": [
              "AMO.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tsiku limenelo,\" Ambuye Yehova akunena kuti,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.9",
            "verseOrgIds": [
              "AMO.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 8:9"
      },
      "items": [
        {
          "text": "\"Ndidzadetsa dzuwa masana",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.9",
            "verseOrgIds": [
              "AMO.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:9"
      },
      "items": [
        {
          "text": "ndi kugwetsa mdima pa dziko lapansi dzuwa likuswa mtengo.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.9",
            "verseOrgIds": [
              "AMO.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maphwando anu achipembedzo ndidzawasandutsa kulira kwa chisoni",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.10",
            "verseOrgIds": [
              "AMO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:10"
      },
      "items": [
        {
          "text": "ndipo kuyimba kwanu konse ndidzakusandutsa maliro.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.10",
            "verseOrgIds": [
              "AMO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 8:10"
      },
      "items": [
        {
          "text": "Ndidzakuvekani chiguduli nonsenu",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.10",
            "verseOrgIds": [
              "AMO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:10"
      },
      "items": [
        {
          "text": "ndi kumeta mipala mitu yanu.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.10",
            "verseOrgIds": [
              "AMO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 8:10"
      },
      "items": [
        {
          "text": "Nthawi imeneyo idzakhala ngati yolira mwana wamwamuna mmodzi yekhayo,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.10",
            "verseOrgIds": [
              "AMO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:10"
      },
      "items": [
        {
          "text": "ndipo tsikulo lidzakhala lowawa mpaka kutha kwake.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.10",
            "verseOrgIds": [
              "AMO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nthawi ikubwera,\" Ambuye Yehova akunena kuti,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.11",
            "verseOrgIds": [
              "AMO.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:11"
      },
      "items": [
        {
          "text": "\"Ndidzagwetsa njala mʼdziko lonse;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.11",
            "verseOrgIds": [
              "AMO.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 8:11"
      },
      "items": [
        {
          "text": "osati njala ya chakudya kapena ludzu la madzi,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.11",
            "verseOrgIds": [
              "AMO.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:11"
      },
      "items": [
        {
          "text": "koma njala yofuna kumva mawu a Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.11",
            "verseOrgIds": [
              "AMO.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu azidzangoyendayenda kuchoka ku nyanja ina kupita ku nyanja ina.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.12",
            "verseOrgIds": [
              "AMO.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:12"
      },
      "items": [
        {
          "text": "Azidzangoyendayenda kuchoka kumpoto kupita kummawa,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.12",
            "verseOrgIds": [
              "AMO.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 8:12"
      },
      "items": [
        {
          "text": "kufunafuna mawu a Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.12",
            "verseOrgIds": [
              "AMO.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:12"
      },
      "items": [
