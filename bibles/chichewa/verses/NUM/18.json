        },
        {
          "text": "\"Nena kwa Alevi: 'Pamene mupereka gawo labwino lopambana zonse, gawo limenelo lidzawerengedwa kwa inu ngati lochokera popunthira tirigu kapenanso kopsinyira mphesa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.30",
            "verseOrgIds": [
              "NUM.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu ndi a pa banja panu mungathe kudyera zimenezi paliponse chifukwa ndi malipiro a ntchito yanu ya ku tenti ya msonkhano.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.31",
            "verseOrgIds": [
              "NUM.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Popereka gawo labwino kwambirilo simudzapezeka olakwa. Mukatero simudzadetsa zopereka zoyera za Aisraeli, ndipo simudzafa.' \"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.32",
            "verseOrgIds": [
              "NUM.18.32"
            ]
          }
