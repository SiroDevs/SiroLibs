  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "GEN 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yakobo Afika ku Padanaramu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo anapitiriza ulendo wake kupita ku dziko la anthu a kummawa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.1",
            "verseOrgIds": [
              "GEN.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atafika kumeneko anaona chitsime ku busa ndipo panali magulu atatu a nkhosa zitagona pafupi ndi chitsimecho chifukwa nkhosazo zimamwetsedwa madzi ochokera mʼchitsimecho. Pamwamba pa chitsimecho panali mwala waukulu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.2",
            "verseOrgIds": [
              "GEN.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amati nkhosa zonse zikasonkhana, abusawo ankagudubuza mwalawo, kuwuchotsa ndi kumwetsa madzi nkhosazo. Kenaka ankawubwezera mwalawo pamalo pake, pakamwa pa chitsimepo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.3",
            "verseOrgIds": [
              "GEN.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo anafunsa abusawo kuti, \"Abale anga, mwachokera kuti?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.4",
            "verseOrgIds": [
              "GEN.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 29:4"
      },
      "items": [
        {
          "text": "Iwo anayankha, \"Tachokera ku Harani.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.4",
            "verseOrgIds": [
              "GEN.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anawafunsanso kuti, \"Kodi Labani, mdzukulu wa Nahori mukumudziwa?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.5",
            "verseOrgIds": [
              "GEN.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 29:5"
      },
      "items": [
        {
          "text": "Iwo anayankha, \"Inde tikumudziwa?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.5",
            "verseOrgIds": [
              "GEN.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yakobo anawafunsanso, \"Kodi ali bwino?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.6",
            "verseOrgIds": [
              "GEN.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 29:6"
      },
      "items": [
        {
          "text": "Iwo anati, \"Inde ali bwino. Nayu Rakele mwana wake akubwera apoyu ndi nkhosa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.6",
            "verseOrgIds": [
              "GEN.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anati, \"Taonani, dzuwa likanalipo ndipo nthawi yosonkhanitsa nkhosa sinakwane. Bwanji osazimwetsa madzi nkhosazi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.7",
            "verseOrgIds": [
              "GEN.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anayankha, \"Ayi sitingatero. Tidikira mpaka nkhosa zonse zisonkhane. Zikatero, tigubuduza mwalawu kuwuchotsa pamwamba pa chitsimepo, kenaka nʼkuzimwetsa madzi nkhosazo.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.8",
            "verseOrgIds": [
              "GEN.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali chiyankhulire nawo, Rakele anafika ndi nkhosa za abambo ake popeza ndiye amene ankaweta nkhosazo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.9",
            "verseOrgIds": [
              "GEN.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo ataona Rakele mwana wa Labani, mlongo wa amayi ake, ali ndi nkhosa za Labani, anapita nawugudubuza mwala uja nazimwetsa madzi nkhosa za amalume akezo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.10",
            "verseOrgIds": [
              "GEN.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Yakobo anapsompsona Rakele nayamba kulira mokweza.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.11",
            "verseOrgIds": [
              "GEN.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Yakobo anawuza Rakele kuti iye ndi mwana wa Rebeka, mlongo wa abambo a Rakele uja. Choncho Rakele anathamanga nakawuza abambo ake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.12",
            "verseOrgIds": [
              "GEN.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani atamva za Yakobo, mwana wa mlongo wake, anafulumira kukakumana naye. Anamukupatira napsompsona, napita naye ku nyumba kwake. Yakobo anafotokozera Labani zonse zinachitika.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.13",
            "verseOrgIds": [
              "GEN.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo, Labani anati kwa iye, \"Iwe ndiwe ndithu fupa ndi mnofu wanga.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.14",
            "verseOrgIds": [
              "GEN.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1",
        "vid": "GEN 29:14"
      },
      "items": [
        {
          "text": "Yakobo Akwatira Leya ndi Rakele",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 29:14"
      },
      "items": [
        {
          "text": "Yakobo anakhala ndi Labani mwezi umodzi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.14",
            "verseOrgIds": [
              "GEN.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Labani anawuza Yakobo kuti, \"Zoona iwe ndi ife ndi abale. Koma suyenera kundigwirira ntchito popanda malipiro. Ndiwuze kuti malipiro ako azikhala wotani?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.15",
            "verseOrgIds": [
              "GEN.29.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Labani anali ndi ana aakazi awiri; dzina la wamkulu linali Leya, ndipo dzina la wamngʼono linali Rakele.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.16",
            "verseOrgIds": [
              "GEN.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leya anali ndi maonekedwe wofowoka koma Rakele anali wa maonekedwe wokongola kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.17",
            "verseOrgIds": [
              "GEN.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo anakonda Rakele ndipo anati, \"Ndidzakugwirirani ntchito kwa zaka zisanu ndi ziwiri chifukwa cha mwana wanu wamngʼono, Rakele.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.18",
            "verseOrgIds": [
              "GEN.29.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani anati, \"Kuli bwino kuti ndimupereke kwa iwe ameneyu kusiyana ndi munthu wina. Khala ndi ine kuno.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.19",
            "verseOrgIds": [
              "GEN.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Yakobo anagwira ntchito zaka zisanu ndi ziwiri chifukwa cha Rakele. Koma kwa iye zaka zonsezi zinakhala ngati masiku wochepa chifukwa anamukonda Rakele.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.20",
            "verseOrgIds": [
              "GEN.29.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Yakobo anati kwa Labani, \"Nthawi yanga ndakwanitsa, ndipatseni mwana wanu kuti ndimukwatire.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.21",
            "verseOrgIds": [
              "GEN.29.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Labani anakonza phwando la ukwati, nayitana anthu onse a pamalopo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.22",
            "verseOrgIds": [
              "GEN.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma pokwana usiku, Labani anatenga mwana wake wamkazi Leya namupatsa Yakobo, ndipo Yakobo anagona naye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.23",
            "verseOrgIds": [
              "GEN.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Labani anapereka wantchito wake wamkazi Zilipa kwa Leya kuti akhale wantchito wake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.24",
            "verseOrgIds": [
              "GEN.29.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakucha mmawa, Yakobo anaona kuti anagona ndi Leya. Choncho Yakobo anafunsa Labani, \"Nʼchiyani mwandichitirachi? Kodi ine sindinakugwirireni ntchito chifukwa cha Rakele? Bwanji mwandinyenga?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.25",
            "verseOrgIds": [
              "GEN.29.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani anayankha, \"Si mwambo wathu kuno kupereka wamngʼono ku banja, wamkulu asanakwatiwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.26",
            "verseOrgIds": [
              "GEN.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamba watsiriza sabata ya chikondwerero cha ukwati wa Leya; kenaka ndidzakupatsanso Rakele. Koma udzayenera kundigwirira ntchito zaka zisanu ndi ziwiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.27",
            "verseOrgIds": [
              "GEN.29.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo anachitadi momwemo. Anamaliza sabata ya chikondwerero cha Leya, ndipo Labani anamupatsa Rakele kuti akhale mkazi wake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.28",
            "verseOrgIds": [
              "GEN.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani anapereka wantchito wake wamkazi Biliha kwa Rakele kuti akhale wantchito wake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.29",
            "verseOrgIds": [
              "GEN.29.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo analowana ndi mkazi wake Rakele, ndipo Yakobo anakonda Rakele kuposa Leya. Ndipo anamugwirira ntchito Labani zaka zina zisanu ndi ziwiri chifukwa cha Rakele.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.30",
            "verseOrgIds": [
              "GEN.29.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ana a Yakobo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 29:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene Mulungu anaona kuti Yakobo sankamukonda Leya kwambiri, Iye analola kuti Leya uja akhale ndi ana, ndi kuti Rakele akhale wosabala.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.31",
            "verseOrgIds": [
              "GEN.29.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 29:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leya anakhala ndi pathupi ndipo anabereka mwana wamwamuna. Anamutcha Rubeni pakuti anati, \"Yehova waona kusauka kwanga. Zoonadi, mwamuna wanga adzandikonda tsopano.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.32",
            "verseOrgIds": [
              "GEN.29.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 29:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anakhalanso ndi pathupi ndipo pamene anabereka mwana wamwamuna anati, \"Yehova anamva kuti mwamuna wanga sakundikonda, choncho wandipatsanso mwana winayu.\" Ndipo anamutcha dzina lake Simeoni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.33",
            "verseOrgIds": [
              "GEN.29.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 29:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anatenganso pathupi kachitatu, ndipo pamene anabereka mwana wamwamuna anati, \"Pano pokha tidzaphatikana kwambiri ndi mwamuna wanga, chifukwa ndamubalira ana aamuna atatu.\" Kotero anamutcha dzina lake Levi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.34",
            "verseOrgIds": [
              "GEN.29.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 29:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anatenganso pathupi pena, ndipo pamene anabereka mwana wamwamuna, iye anati, \"Nthawi ino ndidzalemekeza Yehova.\" Choncho anamutcha Yuda. Kenaka analeka kubereka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.35",
            "verseOrgIds": [
              "GEN.29.35"
            ]
          }
        }
      ]
    }
  ],
