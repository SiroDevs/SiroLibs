          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zaka zonse za Enoki zinali 365.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.23",
            "verseOrgIds": [
              "GEN.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
