            "sid": "GEN 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zaka zonse za Lameki zinali 777, ndipo kenaka anamwalira.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.31",
            "verseOrgIds": [
              "GEN.5.31"
            ]
