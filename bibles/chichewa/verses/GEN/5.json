          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo anamutcha Nowa ndipo anati, \"Iyeyu adzatipumulitsa ku ntchito zathu zolemetsazi, zolima nthaka imene Yehova anayitemberera.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.29",
            "verseOrgIds": [
              "GEN.5.29"
            ]
          }
        },
