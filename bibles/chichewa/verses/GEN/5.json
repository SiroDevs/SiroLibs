            "number": "30",
            "style": "v",
            "sid": "GEN 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atabadwa Nowa, Lameki anakhala zaka zina 595 ndipo anabereka ana ena aamuna ndi aakazi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.30",
            "verseOrgIds": [
              "GEN.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
