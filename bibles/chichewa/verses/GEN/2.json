  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "GEN 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motero kumwamba, dziko lapansi ndi zonse za mʼmenemo zinatha kulengedwa monga mwa kuchuluka kwawo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.1",
            "verseOrgIds": [
              "GEN.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pofika tsiku lachisanu ndi chiwiri Mulungu anamaliza ntchito zonse zimene ankagwira ndipo pa tsiku lachisanu ndi chiwiri anapumula ku ntchito zake zonse.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.2",
            "verseOrgIds": [
              "GEN.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Mulungu anadalitsa tsiku lachisanu ndi chiwiri nalipatula, chifukwa pa tsiku limeneli Iye anapumula ku ntchito yonse yolenga imene anayigwira.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.3",
            "verseOrgIds": [
              "GEN.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Adamu ndi Hava",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbiri ya momwe kumwamba ndi dziko lapansi zinalengedwera pa tsiku lija Yehova Mulungu ankazilenga ndi iyi:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.4",
            "verseOrgIds": [
              "GEN.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "GEN 2:4"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 2:4"
      },
      "items": [
        {
          "text": "Yehova Mulungu atapanga dziko lapansi ndi kumwamba,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.4",
            "verseOrgIds": [
              "GEN.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "zitsamba zinali zisanamere ndipo chomera chilichonse chinali chisanamerenso popeza Yehova Mulungu anali asanagwetse mvula pa dziko lapansi. Panalibe munthu wolima nthaka,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.5",
            "verseOrgIds": [
              "GEN.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "koma kasupe ankatuluka mʼnthaka ndi kuthirira pa dziko lonse.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.6",
            "verseOrgIds": [
              "GEN.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Yehova Mulungu anawumba munthu kuchokera ku dothi nawuziramo mpweya wamoyo mʼmphuno mwake ndipo munthuyo anakhala wamoyo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.7",
            "verseOrgIds": [
              "GEN.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Yehova Mulungu anatsekula munda wa Edeni chakummawa; kumeneko anayikako munthu amene anamupanga uja.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.8",
            "verseOrgIds": [
              "GEN.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yehova Mulungu anameretsa mʼmundamo mitengo ya mitundu yonse. Inali mitengo yokongola ndi ya zipatso zokoma. Pakati pa munda uja panali mtengo wopatsa moyo ndi mtengo wopatsa nzeru zodziwitsa chabwino ndi choyipa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.9",
            "verseOrgIds": [
              "GEN.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtsinje wothirira mundawo unkatuluka mu Edeni; kuchokera apo unkagawikana kukhala mitsinje inayi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.10",
            "verseOrgIds": [
              "GEN.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzina la mtsinje woyamba ndi Pisoni; uwu umazungulira dziko lonse la Havila, kumene kuli golide.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.11",
            "verseOrgIds": [
              "GEN.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Golide wa ku dziko ili ndi wabwino. Kulinso miyala yokongola ya bedola ndi onikisi).",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.12",
            "verseOrgIds": [
              "GEN.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzina la mtsinje wachiwiri ndi Gihoni; uwu umazungulira dziko lonse la Kusi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.13",
            "verseOrgIds": [
              "GEN.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzina la mtsinje wachitatu ndi Tigirisi; umayenda chakummawa kwa Asiriya. Ndipo mtsinje wachinayi ndi Yufurate.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.14",
            "verseOrgIds": [
              "GEN.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova Mulungu anatenga munthu uja ndi kumuyika mʼmunda wa Edeni kuti awulime ndi kuwusamalira.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.15",
            "verseOrgIds": [
              "GEN.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yehova Mulungu analamula munthu uja kuti, \"Uzidya zipatso za mu mtengo wina uliwonse mʼmundamu;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.16",
            "verseOrgIds": [
              "GEN.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "koma usadye zipatso za mu mtengo wodziwitsa chabwino ndi choyipa, popeza ukadzadya za mu mtengowu udzafa ndithu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.17",
            "verseOrgIds": [
              "GEN.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yehova Mulungu anati, \"Sibwino kuti munthu akhale yekha. Ndidzamupangira mnzake womuthandiza.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.18",
            "verseOrgIds": [
              "GEN.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Yehova Mulungu anawumba ndi dothi nyama zonse zakuthengo ndi mbalame zonse zamlengalenga. Ndipo Iye anapita nazo kwa munthu uja kuti akazipatse mayina; ndipo dzina lililonse limene Adamu anapereka ku chamoyo chilichonse, lomwelo linakhala dzina lake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.19",
            "verseOrgIds": [
              "GEN.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Adamu anazitcha mayina ziweto zonse, mbalame zamlengalenga ndi nyama zakuthengo zonse.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.20",
            "verseOrgIds": [
              "GEN.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 2:20"
      },
      "items": [
        {
          "text": "Komabe munthu uja analibe mnzake womuthandiza.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.20",
            "verseOrgIds": [
              "GEN.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Yehova Mulungu anamugonetsa munthu uja tulo tofa nato; ali mtulo chomwecho, Mulungu anachotsa imodzi mwa nthiti zake ndi kutseka pamalopo ndi mnofu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.21",
            "verseOrgIds": [
              "GEN.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motero Yehova Mulungu anapanga mkazi ndi nthiti ija imene anatenga kwa munthu uja nabwera naye kwa iye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.22",
            "verseOrgIds": [
              "GEN.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthu uja anati,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.23",
            "verseOrgIds": [
              "GEN.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 2:23"
      },
      "items": [
        {
          "text": "\"Uyu ndiye fupa lochokera ku mafupa anga",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.23",
            "verseOrgIds": [
              "GEN.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 2:23"
      },
      "items": [
        {
          "text": "ndi mnofu wochokera ku mnofu wanga;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.23",
            "verseOrgIds": [
              "GEN.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 2:23"
      },
      "items": [
        {
          "text": "adzatchedwa 'mkazi,'",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.23",
            "verseOrgIds": [
              "GEN.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 2:23"
      },
      "items": [
        {
          "text": "popeza wachokera mwa mwamuna.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.23",
            "verseOrgIds": [
              "GEN.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼchifukwa chake, mwamuna amasiya abambo ndi amayi ake nakaphatikana ndi mkazi wake ndipo awiriwo amakhala thupi limodzi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.24",
            "verseOrgIds": [
              "GEN.2.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthu uja ndi mkazi wakeyo, onse awiri anali maliseche ndipo analibe manyazi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.25",
            "verseOrgIds": [
              "GEN.2.25"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "GEN.3",
