  "verseCount": 39,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "HEB 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Nsembe ya Anthu Onse",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malamulo ndi chithunzithunzi cha zinthu zabwino zimene zikubwera, osati madalitso enieniwo. Pa chifukwa chimenechi sizingatheke konse kuti nsembe zimodzimodzi, zoperekedwa kawirikawiri, kosalekeza ndi chaka ndi chaka, kuti nʼkusandutsa angwiro amene amabwera kudzapembedza.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.1",
            "verseOrgIds": [
              "HEB.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati zikanamatero iwowo akanasiya kupereka nsembezo. Pakuti opembedzawo akanamayeretsedwa kamodzi kokha, sibwenzi chikumbumtima chawo chikuwatsutsabe chifukwa cha machimo awo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.2",
            "verseOrgIds": [
              "HEB.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma nsembezo zimawakumbutsa anthuwo machimo awo chaka ndi chaka.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.3",
            "verseOrgIds": [
              "HEB.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chifukwa nʼkosatheka kuti magazi angʼombe yayimuna ndi mbuzi yayimuna achotse machimo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.4",
            "verseOrgIds": [
              "HEB.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼchifukwa chake Khristu atabwera pa dziko lapansi anati,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.5",
            "verseOrgIds": [
              "HEB.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 10:5"
      },
      "items": [
        {
          "text": "\"Simunafune nsembe kapena zopereka,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.5",
            "verseOrgIds": [
              "HEB.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:5"
      },
      "items": [
        {
          "text": "koma thupi munandikonzera.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.5",
            "verseOrgIds": [
              "HEB.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simunakondwere nazo nsembe zopsereza",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.6",
            "verseOrgIds": [
              "HEB.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:6"
      },
      "items": [
        {
          "text": "ndi nsembe zopereka chifukwa cha tchimo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.6",
            "verseOrgIds": [
              "HEB.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono, Ine ndinati, 'Ndili pano Ine,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.7",
            "verseOrgIds": [
              "HEB.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:7"
      },
      "items": [
        {
          "text": "Inu Mulungu, ndabwera kudzachita zimene mukufuna monga zinalembedwa mʼMalemba.' \"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.7",
            "verseOrgIds": [
              "HEB.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Poyamba Iye anati, \"Nsembe kapena zopereka zopsereza ndi nsembe zopereka chifukwa cha tchimo, Inu simunazifune kapena kukondwera nazo.\" Ngakhale kuti Malamulo ndiye amanena kuti ziperekedwe.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.8",
            "verseOrgIds": [
              "HEB.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Iye anati, \"Ndili pano Ine, ndabwera kudzachita zimene mukufuna.\" Khristu anachotsa nsembe zoyamba zija kuti mʼmalo mwake ayikemo nsembe za mtundu wachiwiri.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.9",
            "verseOrgIds": [
              "HEB.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chifukwa chakuti Yesu Khristu anachita zimene Mulungu anafuna kuti achite, ndife oyeretsedwa ndi nsembe ya thupi lake, limene analipereka kamodzi kokha.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.10",
            "verseOrgIds": [
              "HEB.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wansembe aliyense amayimirira tsiku ndi tsiku nʼkutumikira, ndipo amapereka nsembe imodzimodzi mobwerezabwereza, nsembe zimene sizingathe kuchotsa machimo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.11",
            "verseOrgIds": [
              "HEB.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma pamene wansembe uyu anapereka kamodzi kokha nsembe imodzi yokha chifukwa cha machimo, Iye anakhala pansi ku dzanja lamanja la Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.12",
            "verseOrgIds": [
              "HEB.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumeneko akudikira tsono kuti Mulungu asandutse adani ake kukhala chopondapo mapazi ake.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.13",
            "verseOrgIds": [
              "HEB.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chifukwa cha nsembe imodzi Iye anasandutsa angwiro kwamuyaya iwo amene akuwayeretsa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.14",
            "verseOrgIds": [
              "HEB.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mzimu Woyera nayenso akuchitira umboni za zimenezi kwa ife. Poyamba Iye anati,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.15",
            "verseOrgIds": [
              "HEB.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ili ndi pangano limene ndidzachita nawo",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.16",
            "verseOrgIds": [
              "HEB.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:16"
      },
      "items": [
        {
          "text": "atapita masiku amenewo,\" akutero Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.16",
            "verseOrgIds": [
              "HEB.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 10:16"
      },
      "items": [
        {
          "text": "\"Ndidzayika malamulo anga mʼmitima mwawo,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.16",
            "verseOrgIds": [
              "HEB.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:16"
      },
      "items": [
        {
          "text": "ndipo ndidzawalemba mʼmaganizo mwawo.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.16",
            "verseOrgIds": [
              "HEB.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo akutinso:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.17",
            "verseOrgIds": [
              "HEB.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 10:17"
      },
      "items": [
        {
          "text": "\"Sindidzakumbukiranso konse",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.17",
            "verseOrgIds": [
              "HEB.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:17"
      },
      "items": [
        {
          "text": "machimo awo ndi zolakwa zawo.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.17",
            "verseOrgIds": [
              "HEB.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo pamene machimo akhululukidwa, sipafunikanso nsembe yoperekedwa chifukwa cha machimowo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.18",
            "verseOrgIds": [
              "HEB.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kulimbika Mtima ndi Kupirira pa Chikhulupiriro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo tsono abale, molimba mtima timalowa mʼMalo Opatulika kwambiri chifukwa cha magazi a Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.19",
            "verseOrgIds": [
              "HEB.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anatitsekulira njira yatsopano ndi yamoyo kudutsa chinsalu chotchinga, chimene ndi thupi lake.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.20",
            "verseOrgIds": [
              "HEB.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiponso tili ndi wansembe wamkulu woyangʼanira nyumba ya Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.21",
            "verseOrgIds": [
              "HEB.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono tiyeni tiyandikire kwa Mulungu ndi mtima woona ndi wodzaza ndi chikhulupiriro. Popeza mitima yathu yayeretsedwa, ndi yopanda chikumbumtima chotitsutsa, ndiponso matupi athu asambitsidwa ndi madzi woyera.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.22",
            "verseOrgIds": [
              "HEB.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyeni tigwiritsitse mosagwedezeka zimene timaziyembekezera ndi kuzivomereza, pakuti amene anatilonjezayo ndi wokhulupirika.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.23",
            "verseOrgIds": [
              "HEB.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiziganizira mmene tingalimbikitsirane wina ndi mnzake pokondana ndi kuchita ntchito zabwino.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.24",
            "verseOrgIds": [
              "HEB.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "HEB 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyeni tisaleke kusonkhana kwathu pamodzi monga mmene ena amachitira, koma tizilimbikitsana makamaka poona kuti tsiku la Ambuye layandikira.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.25",
            "verseOrgIds": [
              "HEB.10.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "HEB 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati ife tipitirira kuchimwa mwadala pamene tikudziwa choona, palibenso nsembe ina imene ingaperekedwe chifukwa cha machimo athuwo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.26",
            "verseOrgIds": [
              "HEB.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "HEB 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma kumangodikira kokha ndi mantha chiweruzo ndiponso moto woopsa umene udzawononga adani a Mulungu",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.27",
            "verseOrgIds": [
              "HEB.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "HEB 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aliyense amene amakana malamulo a Mose amaphedwa popanda nʼchifundo chomwe, malingana pali mboni ziwiri kapena zitatu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.28",
            "verseOrgIds": [
              "HEB.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "HEB 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koposa kotani nanga ululu wachilango chimene adzalandire munthu amene amapeputsa Mwana wa Mulungu, amene amayesa magazi a pangano, amene anamuyeretsa, kukhala chinthu chodetsedwa, ndi kunyoza Mzimu wachisomo?",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.29",
            "verseOrgIds": [
              "HEB.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "HEB 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti timadziwa amene anati, \"Kubwezera chilango nʼkwanga; ndidzawalanga ndine.\" Iye anatinso, \"Ambuye adzaweruza anthu ake.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.30",
            "verseOrgIds": [
              "HEB.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "HEB 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼchinthu choopsa kugwa mʼmanja a Mulungu wamoyo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.31",
            "verseOrgIds": [
              "HEB.10.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "HEB 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumbukirani masiku akale aja mutangowunikiridwa chatsopano, pa nthawi imeneyi munapirira zowawa zambiri.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.32",
            "verseOrgIds": [
              "HEB.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "HEB 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthawi zina ankakunyozani pagulu ndi kukuzunzani. Nthawi zina munkamva zowawa pamodzi ndi amene ankasautsidwa chotere.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.33",
            "verseOrgIds": [
              "HEB.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "HEB 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munkawamvera chisoni amene anali mʼndende ndiponso munkalola mokondwera kuti akulandeni katundu wanu chifukwa munkadziwa kuti muli nacho chuma choposa ndi chosatha.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.34",
            "verseOrgIds": [
              "HEB.10.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "HEB 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono musataye kulimbika mtima kwanuko pakuti mudzalandira nako mphotho yayikulu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.35",
            "verseOrgIds": [
              "HEB.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "HEB 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼkofunika kuti mupirire kuti pamene muchita chifuniro cha Mulungu mudzalandire zimene Iye analonjeza.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.36",
            "verseOrgIds": [
              "HEB.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "HEB 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti nʼkanthawi kochepa chabe,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.37",
            "verseOrgIds": [
              "HEB.10.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 10:37"
      },
      "items": [
        {
          "text": "Iye amene akubwera adzabwera ndipo sadzachedwa ayi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.37",
            "verseOrgIds": [
              "HEB.10.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "HEB 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma wolungama wangayo adzakhala ndi moyo mwachikhulupiriro.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.38",
            "verseOrgIds": [
              "HEB.10.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:38"
      },
      "items": [
        {
          "text": "Ndipo ngati iye abwerera mʼmbuyo chifukwa cha mantha,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.38",
            "verseOrgIds": [
              "HEB.10.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:38"
      },
      "items": [
        {
          "text": "Ine sindidzakondwera naye.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.38",
            "verseOrgIds": [
              "HEB.10.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "HEB 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ife sindife amodzi a iwo obwerera mʼmbuyo mwa mantha ndi owonongedwa, koma ndife amodzi a amene akukhulupirira ndi wopulumutsidwa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.39",
            "verseOrgIds": [
              "HEB.10.39"
            ]
          }
        }
      ]
    }
  ],
