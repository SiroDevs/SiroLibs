  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "NEH 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "nb"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu onse anasonkhana ngati munthu mmodzi pabwalo limene lili patsogolo pa Chipata cha Madzi. Iwo anawuza mlembi Ezara kuti abwere ndi buku la malamulo a Mose limene Yehova anapereka kwa Aisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.1",
            "verseOrgIds": [
              "NEH.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho pa tsiku loyamba la mwezi wachisanu ndi chiwiri wansembe Ezara, anabwera ndi buku la malamulo ku msonkhano wa amuna, akazi ndi ana onse amene ankatha kumvetsa zinthu bwino.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.2",
            "verseOrgIds": [
              "NEH.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Ezara anawerenga bukulo atayangʼana bwalo la Chipata cha Madzi kuyambira mmawa mpaka masana pamaso pa amuna, akazi ndi onse amene ankamvetsa bwino zinthu. Ndipo anthu onse anatchera khutu kuti amve malamulowo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.3",
            "verseOrgIds": [
              "NEH.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlembi Ezara anayimirira pa nsanja ya mitengo imene anthu anamanga chifukwa cha msonkhanowu. Ku dzanja lake lamanja kunayimirira Matitiya, Sema, Anaya, Uriya, Hilikiya ndi Maaseya, ndipo kudzanja lake lamanzere kunali Pedaya, Misaeli, Malikiya, Hasumu, Hasibadana, Zekariya ndi Mesulamu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.4",
            "verseOrgIds": [
              "NEH.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Ezara anatsekula buku, akuona popeza anayima pa nsanja. Pamene anafutukula bukulo anthu onse anayimirira.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.5",
            "verseOrgIds": [
              "NEH.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezara anatamanda Yehova, Mulungu wamkulu, ndipo anthu onse anakweza manja awo ndi kuyankha kuti, \"Ameni, ameni.\" Pambuyo pake onse anaweramitsa pansi mitu yawo napembedza Yehova akanali chizolikire choncho.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.6",
            "verseOrgIds": [
              "NEH.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthuwo atayimiriranso Alevi awa: Yesuwa, Bani, Serebiya, Yamini, Akubu, Sabetayi, Hodiya, Maaseya, Kerita, Azariya, Yozabadi, Hanani ndi Pelaya anawathandiza kuti amvetse bwino malamulowo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.7",
            "verseOrgIds": [
              "NEH.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anawerenga buku la malamulo a Mulungu momveka bwino ndi kutanthauzira mawuwo kuti anthu amvetse bwino zowerengedwazo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.8",
            "verseOrgIds": [
              "NEH.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono bwanamkubwa Nehemiya pamodzi ndi wansembe ndi mlembi Ezara komanso Alevi amene amaphunzitsa anthu anati kwa anthu onse, \"Lero ndi tsiku lopatulika kwa Yehova Mulungu wanu. Musakhale ndi chisoni ndipo musalire.\" Anayankhula choncho popeza anthu onse ankalira atamva mawu a buku la malamulo lija.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.9",
            "verseOrgIds": [
              "NEH.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nehemiya anatinso, \"Pitani, kachiteni phwando ku nyumba ndipo mukawagawireko ena amene alibe kanthu kalikonse popeza lero ndi tsiku lopatulika kwa Yehova. Musakhale ndi chisoni, pakuti chimwemwe cha Yehova ndiye mphamvu yanu.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.10",
            "verseOrgIds": [
              "NEH.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alevi anakhalitsa bata anthu onse powawuza kuti, \"Khalani chete, pakuti lero ndi tsiku lopatulika ndipo musakhale ndi chisoni.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.11",
            "verseOrgIds": [
              "NEH.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu onse anachoka kupita kukadya ndi kumwa. Chakudya china anatumiza kwa anzawo. Choncho panali chikondwerero chachikulu popeza tsopano anali atamvetsa bwino mawu a Mulungu amene anawawerengera ndi kuwafotokozerawo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.12",
            "verseOrgIds": [
              "NEH.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmawa mwake atsogoleri a mabanja pamodzi ndi ansembe ndi alevi anasonkhana kwa Ezara, mlembi wa malamulo kuti aphunzire mawu a malamulowo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.13",
            "verseOrgIds": [
              "NEH.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono anapeza kuti zinalembedwa mʼbuku la malamulo kuti Yehova analamula kudzera mwa Mose kuti Aisraeli azikhala mʼzithando pa nthawi yonse ya chikondwerero cha mwezi wachisanu ndi chiwiri.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.14",
            "verseOrgIds": [
              "NEH.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho analengeza ndi kufalitsa mʼmizinda yawo yonse ndi mu Yerusalemu kuti, \"Pitani ku phiri mukadule nthambi za mtengo wa olivi, za mtengo wa olivi wa kutchire, za mtengo wa mchisu, za mtengo wa mgwalangwa ndiponso za mitengo ina ya masamba, zomangira zithando monga zalembedweramu ndi kubwera nazo.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.15",
            "verseOrgIds": [
              "NEH.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho anthu anapita kukatenga nthambi ndipo aliyense anadzimangira misasa pa denga ya nyumba yake, mʼmabwalo awo, mʼmabwalo a Nyumba ya Mulungu, mʼbwalo la pa Chipata cha Madzi ndiponso mʼbwalo la pa Chipata cha Efereimu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.16",
            "verseOrgIds": [
              "NEH.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gulu lonse la anthu limene linabwera ku ukapolo linamanga misasa ndipo linakhala mʼmenemo. Kuyambira nthawi ya Yoswa mwana wa Nuni mpaka tsiku limenelo nʼkuti Aisraeli asanachitepo zimenezi. Choncho panali chimwemwe chachikulu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.17",
            "verseOrgIds": [
              "NEH.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku ndi tsiku, kuyambira tsiku loyamba mpaka lomaliza, Ezara ankawerenga buku la malamulo a Mulungu. Anthu anachita chikondwerero masiku asanu ndi awiri. Pa tsiku lachisanu ndi chitatu panachitika msonkhano potsata buku la malamulo lija.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.18",
            "verseOrgIds": [
              "NEH.8.18"
            ]
          }
        }
      ]
    }
  ],
