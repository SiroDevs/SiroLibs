      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:28"
      },
      "items": [
        {
          "text": "chimakhala pa msonga penipeni pa mwala.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.28",
            "verseOrgIds": [
              "JOB.39.28"
            ]
          }
        }
      ]
