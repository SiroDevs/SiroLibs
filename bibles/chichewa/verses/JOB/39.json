      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:27"
      },
      "items": [
        {
          "text": "ndi kumanga chisa chake pamwamba penipeni?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.27",
            "verseOrgIds": [
              "JOB.39.27"
            ]
          }
        }
      ]
    },
    {
