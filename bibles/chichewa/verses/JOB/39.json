      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:26"
      },
      "items": [
        {
          "text": "ndi kutambasula mapiko ake kupita kummwera?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.26",
            "verseOrgIds": [
              "JOB.39.26"
            ]
          }
        }
      ]
    },
    {
