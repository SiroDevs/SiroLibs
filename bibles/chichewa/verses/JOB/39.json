          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lipenga likalira amati, 'Twee!'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.25",
            "verseOrgIds": [
              "JOB.39.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:25"
      },
      "items": [
        {
          "text": "Amamva fungo la nkhondo ali patali,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.25",
            "verseOrgIds": [
              "JOB.39.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:25"
      },
      "items": [
        {
          "text": "kufuwula kwa anthu olamulira nkhondo ndi mfuwu wankhondo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.25",
            "verseOrgIds": [
              "JOB.39.25"
            ]
          }
        }
      ]
    },
