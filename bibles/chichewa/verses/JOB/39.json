          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kavaloyo amanjenjemera ndi ukali ndi kulumphalumpha;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.24",
            "verseOrgIds": [
              "JOB.39.24"
            ]
          }
        }
      ]
    },
