          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana ake amayamwa magazi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.30",
            "verseOrgIds": [
              "JOB.39.30"
            ]
