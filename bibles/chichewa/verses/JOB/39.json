        "style": "q2",
        "vid": "JOB 39:30"
      },
      "items": [
        {
          "text": "ndipo kumene kuli mitembo ndiko chimapezeka.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.30",
            "verseOrgIds": [
              "JOB.39.30"
            ]
