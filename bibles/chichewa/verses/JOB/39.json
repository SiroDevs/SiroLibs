          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi umalamulira chiwombankhanga ndiwe kuti chiziwuluka",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.27",
            "verseOrgIds": [
              "JOB.39.27"
            ]
          }
        }
      ]
    },
