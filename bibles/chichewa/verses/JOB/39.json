      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:24"
      },
      "items": [
        {
          "text": "satha kungoyima pamene wamva kulira kwa lipenga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.24",
            "verseOrgIds": [
              "JOB.39.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
