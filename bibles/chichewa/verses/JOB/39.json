      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:29"
      },
      "items": [
        {
          "text": "maso ake amachionera patali chinthucho.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.29",
            "verseOrgIds": [
              "JOB.39.29"
            ]
          }
        }
      ]
    },
