  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "JOB 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kodi munthu sakhala ndi ntchito yowawa pa dziko lapansi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.1",
            "verseOrgIds": [
              "JOB.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:1"
      },
      "items": [
        {
          "text": "Kodi masiku ake sali ngati munthu waganyu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.1",
            "verseOrgIds": [
              "JOB.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monga ngati kapolo wolakalaka mthunzi wa nthawi yamadzulo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.2",
            "verseOrgIds": [
              "JOB.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:2"
      },
      "items": [
        {
          "text": "kapena ngati munthu waganyu woyembekezera malipiro ake,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.2",
            "verseOrgIds": [
              "JOB.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "choncho ine ndapatsidwa nthawi yongovutika pachabe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.3",
            "verseOrgIds": [
              "JOB.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:3"
      },
      "items": [
        {
          "text": "ndiponso usiku wamasautso wapatsidwa kwa ine.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.3",
            "verseOrgIds": [
              "JOB.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikamagona ndimaganiza kuti, 'Kodi kucha liti?'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.4",
            "verseOrgIds": [
              "JOB.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:4"
      },
      "items": [
        {
          "text": "Usikuwo umatalika ndipo sindigona tulo mpaka mmawa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.4",
            "verseOrgIds": [
              "JOB.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thupi langa ladzala mphutsi ndi zipsera,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.5",
            "verseOrgIds": [
              "JOB.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:5"
      },
      "items": [
        {
          "text": "khungu langa langʼambika ndipo likutuluka mafinya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.5",
            "verseOrgIds": [
              "JOB.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Masiku anga ndi othamanga kupambana makina wolukira nsalu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.6",
            "verseOrgIds": [
              "JOB.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:6"
      },
      "items": [
        {
          "text": "ndipo amatha wopanda chiyembekezo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.6",
            "verseOrgIds": [
              "JOB.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Mulungu kumbukirani kuti moyo wanga uli ngati mpweya;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.7",
            "verseOrgIds": [
              "JOB.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:7"
      },
      "items": [
        {
          "text": "sindidzaonanso masiku achisangalalo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.7",
            "verseOrgIds": [
              "JOB.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amene akundiona tsopano akundiona;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.8",
            "verseOrgIds": [
              "JOB.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:8"
      },
      "items": [
        {
          "text": "mudzandifunafuna koma sindidzapezekanso.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.8",
            "verseOrgIds": [
              "JOB.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monga mtambo umazimirira ndi kukanganuka,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.9",
            "verseOrgIds": [
              "JOB.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:9"
      },
      "items": [
        {
          "text": "momwemonso munthu amene walowa mʼmanda sabwerera.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.9",
            "verseOrgIds": [
              "JOB.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye sadzabweranso ku nyumba kwake",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.10",
            "verseOrgIds": [
              "JOB.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:10"
      },
      "items": [
        {
          "text": "ndipo onse omudziwa adzamuyiwala.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.10",
            "verseOrgIds": [
              "JOB.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼchifukwa chake ine sindidzakhala chete;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.11",
            "verseOrgIds": [
              "JOB.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:11"
      },
      "items": [
        {
          "text": "ndidzayankhula mopsinjika mtima,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.11",
            "verseOrgIds": [
              "JOB.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:11"
      },
      "items": [
        {
          "text": "ndidzadandaula mowawidwa mtima.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.11",
            "verseOrgIds": [
              "JOB.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi ine ndine nyanja kapena chirombo chamʼnyanja",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.12",
            "verseOrgIds": [
              "JOB.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:12"
      },
      "items": [
        {
          "text": "kuti inu mundiyikire alonda?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.12",
            "verseOrgIds": [
              "JOB.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene ndikuganiza kuti ndidzapeza chitonthozo pa bedi panga",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.13",
            "verseOrgIds": [
              "JOB.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:13"
      },
      "items": [
        {
          "text": "ndipo pogona panga padzachepetsa madandawulo anga,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.13",
            "verseOrgIds": [
              "JOB.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngakhale nthawi imeneyo mumandiopseza ndi maloto",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.14",
            "verseOrgIds": [
              "JOB.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:14"
      },
      "items": [
        {
          "text": "ndi kundichititsa mantha ndi masomphenya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.14",
            "verseOrgIds": [
              "JOB.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kotero kuti ndimalakalaka kudzikhweza kapena kufa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.15",
            "verseOrgIds": [
              "JOB.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:15"
      },
      "items": [
        {
          "text": "kupambana kupirira zowawa zimene ndikuzimva mʼthupi mwanga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.15",
            "verseOrgIds": [
              "JOB.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndatopa nawo moyo wanga; sindingakonde kukhala moyo nthawi zonse.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.16",
            "verseOrgIds": [
              "JOB.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:16"
      },
      "items": [
        {
          "text": "Ndisiyeni ndekha pakuti moyo wanga ulibe tanthauzo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.16",
            "verseOrgIds": [
              "JOB.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kodi munthu nʼchiyani kuti muzimuganizira chotere,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.17",
            "verseOrgIds": [
              "JOB.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:17"
      },
      "items": [
        {
          "text": "kuti muzisamala zochita zake,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.17",
            "verseOrgIds": [
              "JOB.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti muzimusanthula mmawa uliwonse",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.18",
            "verseOrgIds": [
              "JOB.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 7:18"
      },
      "items": [
        {
          "text": "ndi kumamuyesa nthawi yonse?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.7.18",
            "verseOrgIds": [
              "JOB.7.18"
            ]
          }
        }
      ]
    },
