  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "JOB 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mawu a Zofari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Zofari wa ku Naama anayankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.1",
            "verseOrgIds": [
              "JOB.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kodi mawu ambirimbiriwa nʼkukhala osayankhidwa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.2",
            "verseOrgIds": [
              "JOB.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:2"
      },
      "items": [
        {
          "text": "Kodi munthu woyankhulayankhulayu nʼkulungamitsidwa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.2",
            "verseOrgIds": [
              "JOB.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi anthu nʼkukhala chete atamva kubwebweta kwakoku?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.3",
            "verseOrgIds": [
              "JOB.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:3"
      },
      "items": [
        {
          "text": "Kodi palibe wina amene adzakudzudzule pamene ukuyankhula zonyoza?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.3",
            "verseOrgIds": [
              "JOB.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe ukunena kwa Mulungu kuti, 'Zikhulupiriro zanga ndi zopanda zolakwika",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.4",
            "verseOrgIds": [
              "JOB.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:4"
      },
      "items": [
        {
          "text": "ndipo ndine wangwiro pamaso panu.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.4",
            "verseOrgIds": [
              "JOB.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aa, nʼkanakonda Mulungu akanayankhula",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.5",
            "verseOrgIds": [
              "JOB.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:5"
      },
      "items": [
        {
          "text": "kuti Iye atsekule pakamwa pake kutsutsana nawe",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.5",
            "verseOrgIds": [
              "JOB.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndi kukuwululira chinsinsi cha nzeru yake,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.6",
            "verseOrgIds": [
              "JOB.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:6"
      },
      "items": [
        {
          "text": "pakuti nzeru yeniyeni ili ndi mbali ziwiri.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.6",
            "verseOrgIds": [
              "JOB.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:6"
      },
      "items": [
        {
          "text": "Dziwa izi: Mulungu wayiwala machimo ako ena.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.6",
            "verseOrgIds": [
              "JOB.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kodi iwe ungathe kumvetsa zinsinsi za Mulungu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.7",
            "verseOrgIds": [
              "JOB.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:7"
      },
      "items": [
        {
          "text": "Kodi ungafufuze malire a nzeru za Wamphamvuzonse?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.7",
            "verseOrgIds": [
              "JOB.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zili kutali kupambana mayiko akumwamba, nanga ungachite chiyani?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.8",
            "verseOrgIds": [
              "JOB.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:8"
      },
      "items": [
        {
          "text": "Ndi zakuya kupambana kuya kwa manda, nanga ungadziwe chiyani?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.8",
            "verseOrgIds": [
              "JOB.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muyeso wa nzeru zake ndi wautali kupambana dziko lapansi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.9",
            "verseOrgIds": [
              "JOB.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:9"
      },
      "items": [
        {
          "text": "ndipo ndi wopingasa kupambana nyanja.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.9",
            "verseOrgIds": [
              "JOB.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ngati Iye atabwera ndi kukutsekera mʼndende",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.10",
            "verseOrgIds": [
              "JOB.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:10"
      },
      "items": [
        {
          "text": "nakutengera ku bwalo la milandu, ndani angathe kumuletsa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.10",
            "verseOrgIds": [
              "JOB.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndithudi, Mulungu amazindikira anthu achinyengo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.11",
            "verseOrgIds": [
              "JOB.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:11"
      },
      "items": [
        {
          "text": "akaona choyipa, kodi sachizindikira?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.11",
            "verseOrgIds": [
              "JOB.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthu wopanda nzeru sizingatheke kukhala wanzeru",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.12",
            "verseOrgIds": [
              "JOB.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:12"
      },
      "items": [
        {
          "text": "monganso mwana wa bulu wakuthengo sangasanduke munthu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.12",
            "verseOrgIds": [
              "JOB.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Koma ngati upereka mtima wako kwa Iye",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.13",
            "verseOrgIds": [
              "JOB.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:13"
      },
      "items": [
        {
          "text": "ndi kutambasulira manja ako kwa Iyeyo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.13",
            "verseOrgIds": [
              "JOB.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngati utaya tchimo limene lili mʼdzanja lako",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.14",
            "verseOrgIds": [
              "JOB.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:14"
      },
      "items": [
        {
          "text": "ndi kusalola choyipa kuti chikhale mʼmoyo mwako,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.14",
            "verseOrgIds": [
              "JOB.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "udzatukula mutu wako wosachita manyazi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.15",
            "verseOrgIds": [
              "JOB.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:15"
      },
      "items": [
        {
          "text": "udzayima chilili ndipo sudzachita mantha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.15",
            "verseOrgIds": [
              "JOB.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Udzayiwala ndithu zowawa zako,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.16",
            "verseOrgIds": [
              "JOB.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:16"
      },
      "items": [
        {
          "text": "zidzakhala ngati madzi amene apita kale.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.16",
            "verseOrgIds": [
              "JOB.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyo wako udzawala kupambana usana,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.17",
            "verseOrgIds": [
              "JOB.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:17"
      },
      "items": [
        {
          "text": "ndipo mdima udzakhala ngati mmawa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.17",
            "verseOrgIds": [
              "JOB.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Udzalimba mtima popeza pali chiyembekezo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.18",
            "verseOrgIds": [
              "JOB.11.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 11:18"
      },
      "items": [
        {
          "text": "ndipo udzayangʼana mbali zonse ndi kugona mosatekeseka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.18",
            "verseOrgIds": [
              "JOB.11.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
