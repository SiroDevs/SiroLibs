      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:18"
      },
      "items": [
        {
          "text": "musalole kuti chiphuphu chachikulu chikusocheretseni.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.18",
            "verseOrgIds": [
              "JOB.36.18"
            ]
          }
        }
      ]
    },
    {
