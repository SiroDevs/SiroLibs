      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:21"
      },
      "items": [
        {
          "text": "chifukwa uchimowo ndiwo unabweretsa kuzunzika kwanu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.21",
            "verseOrgIds": [
              "JOB.36.21"
            ]
          }
        }
