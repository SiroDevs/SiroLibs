          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu onse amaziona ntchitozo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.25",
            "verseOrgIds": [
              "JOB.36.25"
            ]
