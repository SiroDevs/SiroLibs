      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:20"
      },
      "items": [
        {
          "text": "pakuti ndiyo nthawi imene anthu adzawonongeka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.20",
            "verseOrgIds": [
              "JOB.36.20"
            ]
          }
        }
      ]
