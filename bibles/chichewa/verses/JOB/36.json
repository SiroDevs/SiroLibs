  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "36",
        "style": "c",
        "sid": "JOB 36"
      },
      "items": [
        {
          "text": "36",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Elihu anapitirira kuyankhula nati:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.1",
            "verseOrgIds": [
              "JOB.36.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mundilole pangʼono pokha ndipo ndikuonetsani",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.2",
            "verseOrgIds": [
              "JOB.36.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:2"
      },
      "items": [
        {
          "text": "kuti zilipo zambiri zoti ziyankhulidwe mʼmalo mwa Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.2",
            "verseOrgIds": [
              "JOB.36.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzeru zanga ndimazitenga kutali;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.3",
            "verseOrgIds": [
              "JOB.36.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:3"
      },
      "items": [
        {
          "text": "ndidzaonetsa kulungama kwa Mlengi wanga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.3",
            "verseOrgIds": [
              "JOB.36.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndithudi mawu anga si abodza;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.4",
            "verseOrgIds": [
              "JOB.36.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:4"
      },
      "items": [
        {
          "text": "wanzeru zangwiro ali ndi inu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.4",
            "verseOrgIds": [
              "JOB.36.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mulungu ndi wamphamvu, koma sanyoza anthu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.5",
            "verseOrgIds": [
              "JOB.36.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:5"
      },
      "items": [
        {
          "text": "Iye ndi wamphamvu, ndipo ndi wokhazikika pa cholinga chake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.5",
            "verseOrgIds": [
              "JOB.36.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salola oyipa kuti akhalebe ndi moyo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.6",
            "verseOrgIds": [
              "JOB.36.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:6"
      },
      "items": [
        {
          "text": "koma amapereka ufulu kwa anthu osautsidwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.6",
            "verseOrgIds": [
              "JOB.36.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye saleka kuyangʼanira anthu olungama;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.7",
            "verseOrgIds": [
              "JOB.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:7"
      },
      "items": [
        {
          "text": "amawayika kuti alamulire pamodzi ndi mafumu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.7",
            "verseOrgIds": [
              "JOB.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:7"
      },
      "items": [
        {
          "text": "ndipo amawalemekeza mpaka muyaya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.7",
            "verseOrgIds": [
              "JOB.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ngati anthu amangidwa ndi unyolo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.8",
            "verseOrgIds": [
              "JOB.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:8"
      },
      "items": [
        {
          "text": "ndipo akondwa ndi zingwe zamasautso,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.8",
            "verseOrgIds": [
              "JOB.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amawafotokozera zomwe anachita,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.9",
            "verseOrgIds": [
              "JOB.36.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:9"
      },
      "items": [
        {
          "text": "kuti iwo anachimwa modzikuza.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.9",
            "verseOrgIds": [
              "JOB.36.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu amawatsekula makutu kuti amve malangizo ake",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.10",
            "verseOrgIds": [
              "JOB.36.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:10"
      },
      "items": [
        {
          "text": "ndipo amawalamula kuti alape zoyipa zawo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.10",
            "verseOrgIds": [
              "JOB.36.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati iwo amumvera ndi kumutumikira,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.11",
            "verseOrgIds": [
              "JOB.36.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:11"
      },
      "items": [
        {
          "text": "adzatsiriza masiku a moyo wawo mwamtendere,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.11",
            "verseOrgIds": [
              "JOB.36.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:11"
      },
      "items": [
        {
          "text": "adzatsiriza zaka zawo mosangalala.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.11",
            "verseOrgIds": [
              "JOB.36.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ngati samvera,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.12",
            "verseOrgIds": [
              "JOB.36.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:12"
      },
      "items": [
        {
          "text": "adzaphedwa ndi lupanga",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.12",
            "verseOrgIds": [
              "JOB.36.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:12"
      },
      "items": [
        {
          "text": "ndipo adzafa osadziwa kanthu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.12",
            "verseOrgIds": [
              "JOB.36.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Anthu osapembedza amasunga mkwiyo mu mtima mwawo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.13",
            "verseOrgIds": [
              "JOB.36.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:13"
      },
      "items": [
        {
          "text": "akawalanga, safuwulira kwa Iye kupempha thandizo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.13",
            "verseOrgIds": [
              "JOB.36.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amafa akanali achinyamata,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.14",
            "verseOrgIds": [
              "JOB.36.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:14"
      },
      "items": [
        {
          "text": "pakati pa amuna achiwerewere a kumalo azipembedzo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.14",
            "verseOrgIds": [
              "JOB.36.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ovutika, Iye amawapulumutsa pa mavuto awo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.15",
            "verseOrgIds": [
              "JOB.36.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:15"
      },
      "items": [
        {
          "text": "Mulungu amawayankhula mʼmasautso awowo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.15",
            "verseOrgIds": [
              "JOB.36.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iye akukukopani inu kuti muchoke mʼmasautso,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.16",
            "verseOrgIds": [
              "JOB.36.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:16"
      },
      "items": [
        {
          "text": "kuti mupite ku malo aakulu kumene kulibe chokutchingani,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.16",
            "verseOrgIds": [
              "JOB.36.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:16"
      },
      "items": [
        {
          "text": "kumalo a mpumulo kumene kuli chakudya chabwino kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.16",
            "verseOrgIds": [
              "JOB.36.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma tsopano inu mwapezeka wopalamula chifukwa cha kuyipa kwanu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.17",
            "verseOrgIds": [
              "JOB.36.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:17"
      },
      "items": [
        {
          "text": "chiweruzo ndi chilungamo chakugwerani.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.17",
            "verseOrgIds": [
              "JOB.36.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muchenjere kuti wina asakukopeni ndi chuma;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.18",
            "verseOrgIds": [
              "JOB.36.18"
            ]
          }
        }
      ]
    },
