      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:22"
      },
      "items": [
        {
          "text": "Kodi ndi mphunzitsi uti amene angafanane naye?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.22",
            "verseOrgIds": [
              "JOB.36.22"
            ]
          }
        }
      ]
    },
    {
