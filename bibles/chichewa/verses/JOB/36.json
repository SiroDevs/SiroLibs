      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:23"
      },
      "items": [
        {
          "text": "kapena kumuwuza kuti, 'Inu mwachita chinthu cholakwa?'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.23",
            "verseOrgIds": [
              "JOB.36.23"
            ]
          }
        }
      ]
    },
