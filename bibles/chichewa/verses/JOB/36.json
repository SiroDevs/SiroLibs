      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:19"
      },
      "items": [
        {
          "text": "kapena mphamvu zanu zonse",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.19",
            "verseOrgIds": [
              "JOB.36.19"
            ]
          }
        }
      ]
    },
    {
