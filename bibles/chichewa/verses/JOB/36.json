      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:26"
      },
      "items": [
        {
          "text": "Chiwerengero cha zaka zake nʼchosadziwika.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.26",
            "verseOrgIds": [
              "JOB.36.26"
            ]
          }
        }
      ]
    },
