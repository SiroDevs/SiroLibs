      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:19"
      },
      "items": [
        {
          "text": "zingakusungeni kotero kuti simungakhale pa masautso?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.19",
            "verseOrgIds": [
              "JOB.36.19"
            ]
          }
        }
      ]
