      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:33"
      },
      "items": [
        {
          "text": "ngʼombe nazo zimalengeza za kubwera kwake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.33",
