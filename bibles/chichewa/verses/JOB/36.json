          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muchenjere kuti musatembenukire ku uchimo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.21",
            "verseOrgIds": [
              "JOB.36.21"
            ]
          }
        }
