  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "JOB 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mawu a Yobu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yobu anayankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.1",
            "verseOrgIds": [
              "JOB.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zoonadi, ndikudziwa kuti zimenezi ndi zoona.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.2",
            "verseOrgIds": [
              "JOB.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:2"
      },
      "items": [
        {
          "text": "Koma munthu angathe bwanji kukhala wolungama pamaso pa Mulungu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.2",
            "verseOrgIds": [
              "JOB.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhale wina atafuna kutsutsana naye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.3",
            "verseOrgIds": [
              "JOB.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:3"
      },
      "items": [
        {
          "text": "Iye sangamuyankhe munthuyo ngakhale mawu amodzi omwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.3",
            "verseOrgIds": [
              "JOB.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu ndi wa nzeru zambiri ndipo mphamvu zake ndi zochuluka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.4",
            "verseOrgIds": [
              "JOB.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:4"
      },
      "items": [
        {
          "text": "Ndani analimbana naye popanda kupwetekeka?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.4",
            "verseOrgIds": [
              "JOB.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amasuntha mapiri, mapiriwo osadziwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.5",
            "verseOrgIds": [
              "JOB.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:5"
      },
      "items": [
        {
          "text": "ndipo amawagubuduza ali wokwiya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.5",
            "verseOrgIds": [
              "JOB.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amagwedeza dziko lapansi kulisuntha pamalo pake",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.6",
            "verseOrgIds": [
              "JOB.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:6"
      },
      "items": [
        {
          "text": "ndipo amanjenjemeretsa mizati yake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.6",
            "verseOrgIds": [
              "JOB.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amayankhula ndi dzuwa ndipo siliwala;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.7",
            "verseOrgIds": [
              "JOB.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:7"
      },
      "items": [
        {
          "text": "Iyeyo amaphimba kuwala kwa nyenyezi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.7",
            "verseOrgIds": [
              "JOB.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi Mulungu yekha amene anayala mayiko akumwamba",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.8",
            "verseOrgIds": [
              "JOB.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:8"
      },
      "items": [
        {
          "text": "ndipo amayenda pa mafunde a pa nyanja.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.8",
            "verseOrgIds": [
              "JOB.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye ndiye mlengi wa nyenyezi zamlalangʼamba ndi akamwiniatsatana,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.9",
            "verseOrgIds": [
              "JOB.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:9"
      },
      "items": [
        {
          "text": "nsangwe ndi kumpotosimpita.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.9",
            "verseOrgIds": [
              "JOB.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amachita zozizwitsa zimene sizimvetsetseka,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.10",
            "verseOrgIds": [
              "JOB.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:10"
      },
      "items": [
        {
          "text": "zodabwitsa zimene sizingawerengeke.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.10",
            "verseOrgIds": [
              "JOB.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapita pafupi ndi ine sindingathe kumuona;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.11",
            "verseOrgIds": [
              "JOB.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:11"
      },
      "items": [
        {
          "text": "akadutsa, sindingathe kumuzindikira.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.11",
            "verseOrgIds": [
              "JOB.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati Iye alanda zinthu, ndani angathe kumuletsa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.12",
            "verseOrgIds": [
              "JOB.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:12"
      },
      "items": [
        {
          "text": "Ndani anganene kwa Iye kuti, 'Mukuchita chiyani?'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.12",
            "verseOrgIds": [
              "JOB.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu sabweza mkwiyo wake;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.13",
            "verseOrgIds": [
              "JOB.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:13"
      },
      "items": [
        {
          "text": "ngakhale gulu lankhondo la Rahabe linawerama pa mapazi ake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.13",
            "verseOrgIds": [
              "JOB.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nanga ine ndingathe kukangana naye bwanji?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.14",
            "verseOrgIds": [
              "JOB.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:14"
      },
      "items": [
        {
          "text": "Ndingawapeze kuti mawu oti nʼkutsutsana naye?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.14",
            "verseOrgIds": [
              "JOB.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhale nditakhala wosalakwa, sindingamuyankhe;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.15",
            "verseOrgIds": [
              "JOB.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:15"
      },
      "items": [
        {
          "text": "ndikanangopempha chifundo kwa woweruza wanga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.15",
            "verseOrgIds": [
              "JOB.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhale ndikanamuyitana ndipo Iye ndi kuvomera,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.16",
            "verseOrgIds": [
              "JOB.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:16"
      },
      "items": [
        {
          "text": "sindikhulupirira kuti akanamva mawu angawo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.16",
            "verseOrgIds": [
              "JOB.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akanandikantha ndi mphepo yamkuntho,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.17",
            "verseOrgIds": [
              "JOB.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:17"
      },
      "items": [
        {
          "text": "ndipo akanandipweteka popanda chifukwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.17",
            "verseOrgIds": [
              "JOB.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu sakanandilola kuti ndipumenso",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.18",
            "verseOrgIds": [
              "JOB.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:18"
      },
      "items": [
        {
          "text": "koma akanandichulukitsira zowawa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.18",
            "verseOrgIds": [
              "JOB.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tikanena za mphamvu, Iye ndi wamphamvudi!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.19",
            "verseOrgIds": [
              "JOB.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:19"
      },
      "items": [
        {
          "text": "Ndipo tikanena za chiweruzo cholungama, ndani angamuzenge mlandu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.19",
            "verseOrgIds": [
              "JOB.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhale ndikanakhala wosalakwa, zoyankhula zanga zikananditsutsa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.20",
            "verseOrgIds": [
              "JOB.9.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:20"
      },
      "items": [
        {
          "text": "ndikanakhala wopanda cholakwa, pakamwa panga pakanandipeza wolakwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.20",
            "verseOrgIds": [
              "JOB.9.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ngakhale ine ndili wosalakwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.21",
            "verseOrgIds": [
              "JOB.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:21"
      },
      "items": [
        {
          "text": "sindidziyenereza ndekha;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.21",
            "verseOrgIds": [
              "JOB.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:21"
      },
      "items": [
        {
          "text": "moyo wanga ndimawupeputsa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.21",
            "verseOrgIds": [
              "JOB.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zonse nʼzofanana; nʼchifukwa chake ndikuti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.22",
            "verseOrgIds": [
              "JOB.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:22"
      },
      "items": [
        {
          "text": "'Iye amawononga anthu osalakwa ndi anthu oyipa omwe.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.22",
            "verseOrgIds": [
              "JOB.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene mkwapulo ubweretsa imfa yadzidzidzi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.23",
            "verseOrgIds": [
              "JOB.9.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:23"
      },
      "items": [
        {
          "text": "Iye amaseka tsoka la munthu wosalakwayo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.23",
            "verseOrgIds": [
              "JOB.9.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene dziko lagwa mʼmanja mwa anthu oyipa",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.24",
            "verseOrgIds": [
              "JOB.9.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:24"
      },
      "items": [
        {
          "text": "Iye amawatseka maso anthu oweruza dzikolo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.24",
            "verseOrgIds": [
              "JOB.9.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:24"
      },
      "items": [
        {
          "text": "Ngati si Iyeyo, nanga ndani?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.24",
            "verseOrgIds": [
              "JOB.9.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Masiku anga ndi othamanga kwambiri kupambana munthu waliwiro;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.25",
            "verseOrgIds": [
              "JOB.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:25"
      },
      "items": [
        {
          "text": "masikuwo amapita ine osaonapo zabwino.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.25",
            "verseOrgIds": [
              "JOB.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amayenda ngati mabwato a njedza pa nyanja,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.26",
            "verseOrgIds": [
              "JOB.9.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:26"
      },
      "items": [
        {
          "text": "ngati mphungu zothamangira nyama zoti zidye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.26",
            "verseOrgIds": [
              "JOB.9.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼtanena kuti, 'Ndidzayiwala madandawulo anga,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.27",
            "verseOrgIds": [
              "JOB.9.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:27"
      },
      "items": [
        {
          "text": "ndidzasintha nkhope yanga ndipo ndidzasekerera,'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.27",
            "verseOrgIds": [
              "JOB.9.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndikuopabe mavuto anga onse,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.28",
            "verseOrgIds": [
              "JOB.9.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:28"
      },
      "items": [
        {
          "text": "popeza ndikudziwa kuti simudzavomereza kuti ndine wosalakwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.28",
            "verseOrgIds": [
              "JOB.9.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Popeza ndapezeka kale wolakwa",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.29",
            "verseOrgIds": [
              "JOB.9.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:29"
      },
      "items": [
        {
          "text": "ndivutikirenji popanda phindu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.29",
            "verseOrgIds": [
              "JOB.9.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOB 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhale nditasamba mʼmadzi oyera kwambiri",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.30",
            "verseOrgIds": [
              "JOB.9.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:30"
      },
      "items": [
        {
          "text": "ndi kusamba mʼmanja mwanga ndi sopo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.30",
            "verseOrgIds": [
              "JOB.9.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOB 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "mutha kundiponyabe pa dzala,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.31",
            "verseOrgIds": [
              "JOB.9.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:31"
      },
      "items": [
        {
          "text": "kotero kuti ngakhale zovala zanga zomwe zidzandinyansa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.31",
            "verseOrgIds": [
              "JOB.9.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
