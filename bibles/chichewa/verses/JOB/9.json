          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOB 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mulungu si munthu ngati ine kuti ndithe kumuyankha,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.32",
            "verseOrgIds": [
              "JOB.9.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:32"
      },
      "items": [
        {
          "text": "sindingathe kutsutsana naye mʼbwalo la milandu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.32",
            "verseOrgIds": [
              "JOB.9.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOB 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakanapezeka munthu wina kuti akhale mʼkhalapakati wathu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.33",
            "verseOrgIds": [
              "JOB.9.33"
            ]
          }
        }
      ]
    },
