      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:33"
      },
      "items": [
        {
          "text": "kuti atibweretse ife tonse pamodzi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.33",
            "verseOrgIds": [
              "JOB.9.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOB 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "munthu wina woti achotse ndodo ya Mulungu pa ine",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.34",
            "verseOrgIds": [
              "JOB.9.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:34"
      },
      "items": [
        {
          "text": "kuti kuopsa kwake kusandichititsenso mantha!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.34",
            "verseOrgIds": [
              "JOB.9.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOB 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo ine ndikanatha kuyankhula mosamuopa Mulunguyo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.35",
            "verseOrgIds": [
              "JOB.9.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:35"
      },
      "items": [
        {
          "text": "koma monga zililimu, sindingathe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.35",
            "verseOrgIds": [
              "JOB.9.35"
            ]
          }
        }
      ]
