  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "1CH 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anabwera nalo Bokosi la Mulungu ndipo analiyika pamalo pake mʼkati mwa tenti imene Davide anayimika ndipo iwo anapereka nsembe zopsereza ndi nsembe zachiyanjano pamaso pa Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.1",
            "verseOrgIds": [
              "1CH.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davide atatsiriza kupereka nsembe zopsereza ndi nsembe zachiyanjano, iye anadalitsa anthu mʼdzina la Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.2",
            "verseOrgIds": [
              "1CH.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka anagawira Mwisraeli aliyense, wamwamuna ndi wamkazi, aliyense buledi mmodzi, nthuli yanyama ndiponso keke yamphesa zowuma.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.3",
            "verseOrgIds": [
              "1CH.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anasankha Alevi ena kuti azitumikira pamene panali Bokosi la Yehova, kuti azipemphera, azithokoza ndi kulemekeza Yehova Mulungu wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.4",
            "verseOrgIds": [
              "1CH.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtsogoleri wawo anali Asafu, wachiwiri anali Zekariya, kenaka Yeiyeli, Semiramoti, Yehieli, Matitiya, Eliabu, Benaya, Obedi-Edomu ndi Yeiyeli. Iwo amayimba azeze ndi apangwe, Asafu amayimba ziwaya za malipenga,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.5",
            "verseOrgIds": [
              "1CH.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo ansembe Benaya ndi Yahazieli amawomba malipenga nthawi zonse pamaso pa Bokosi la Chipangano la Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.6",
            "verseOrgIds": [
              "1CH.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyimbo Yotamanda ya Davide",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku limeneli Davide anayamba nʼkusankha Asafu ndi anzake kuti ndiwo apereke nyimbo iyi ya matamando kwa Yehova:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.7",
            "verseOrgIds": [
              "1CH.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamikani Yehova, itanani dzina lake;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.8",
            "verseOrgIds": [
              "1CH.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:8"
      },
      "items": [
        {
          "text": "lalikani za ntchito zake pakati pa mitundu ya anthu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.8",
            "verseOrgIds": [
              "1CH.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbirani Iye, muyimbireni nyimbo zamatamando;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.9",
            "verseOrgIds": [
              "1CH.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:9"
      },
      "items": [
        {
          "text": "nenani za ntchito zake zonse zodabwitsa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.9",
            "verseOrgIds": [
              "1CH.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyadirani dzina lake loyera;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.10",
            "verseOrgIds": [
              "1CH.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:10"
      },
      "items": [
        {
          "text": "ikondwere mitima ya iwo akufunafuna Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.10",
            "verseOrgIds": [
              "1CH.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dalirani Yehova ndi mphamvu zake;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.11",
            "verseOrgIds": [
              "1CH.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:11"
      },
      "items": [
        {
          "text": "funafunani nkhope yake nthawi zonse.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.11",
            "verseOrgIds": [
              "1CH.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumbukirani ntchito zodabwitsa wazichita,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.12",
            "verseOrgIds": [
              "1CH.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:12"
      },
      "items": [
        {
          "text": "zozizwitsa zake, ndi kuweruza kwa mʼkamwa mwake,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.12",
            "verseOrgIds": [
              "1CH.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "inu zidzukulu za Israeli mtumiki wake,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.13",
            "verseOrgIds": [
              "1CH.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:13"
      },
      "items": [
        {
          "text": "inu ana a Yakobo, osankhidwa ake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.13",
            "verseOrgIds": [
              "1CH.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye ndiye Yehova Mulungu wathu;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.14",
            "verseOrgIds": [
              "1CH.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:14"
      },
      "items": [
        {
          "text": "chiweruzo chake chili pa dziko lonse lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.14",
            "verseOrgIds": [
              "1CH.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amakumbukira pangano lake nthawi zonse,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.15",
            "verseOrgIds": [
              "1CH.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:15"
      },
      "items": [
        {
          "text": "mawu amene Iye analamula, kwa mibado miyandamiyanda,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.15",
            "verseOrgIds": [
              "1CH.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "pangano limene anachita ndi Abrahamu,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.16",
            "verseOrgIds": [
              "1CH.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:16"
      },
      "items": [
        {
          "text": "lonjezo limene analumbira kwa Isake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.16",
            "verseOrgIds": [
              "1CH.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye analitsimikiza kwa Yakobo monga lamulo,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.17",
            "verseOrgIds": [
              "1CH.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:17"
      },
      "items": [
        {
          "text": "kwa Israeli monga pangano lamuyaya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.17",
            "verseOrgIds": [
              "1CH.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kwa iwe, ine ndidzapereka dziko la Kanaani",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.18",
            "verseOrgIds": [
              "1CH.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:18"
      },
      "items": [
        {
          "text": "monga cholowa chimene udzachilandira.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.18",
            "verseOrgIds": [
              "1CH.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali anthu owerengeka,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.19",
            "verseOrgIds": [
              "1CH.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:19"
      },
      "items": [
        {
          "text": "ochepa ndithu, komanso alendo mʼdzikomo,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.19",
            "verseOrgIds": [
              "1CH.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "iwo anayendayenda kuchoka ku mtundu wina kupita ku mtundu wina,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.20",
            "verseOrgIds": [
              "1CH.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:20"
      },
      "items": [
        {
          "text": "ku ufumu wina kupita ku ufumu wina.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.20",
            "verseOrgIds": [
              "1CH.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye sanalole munthu aliyense kuti awapondereze;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.21",
            "verseOrgIds": [
              "1CH.16.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:21"
      },
      "items": [
        {
          "text": "chifukwa cha iwo, Iye anadzudzula mafumu:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.21",
            "verseOrgIds": [
              "1CH.16.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Musakhudze odzozedwa anga;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.22",
            "verseOrgIds": [
              "1CH.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:22"
      },
      "items": [
        {
          "text": "musawachitire choyipa aneneri anga.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.22",
            "verseOrgIds": [
              "1CH.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbirani Yehova, dziko lonse lapansi;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.23",
            "verseOrgIds": [
              "1CH.16.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:23"
      },
      "items": [
        {
          "text": "lalikani za chipulumutso chake tsiku ndi tsiku.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.23",
            "verseOrgIds": [
              "1CH.16.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lengezani za ulemerero wake kwa mitundu yonse,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.24",
            "verseOrgIds": [
              "1CH.16.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:24"
      },
      "items": [
        {
          "text": "ntchito zake zonse zodabwitsa kwa anthu onse.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.24",
            "verseOrgIds": [
              "1CH.16.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti Yehova ndi wamkulu ndi woyenera kwambiri kumutamanda;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.25",
            "verseOrgIds": [
              "1CH.16.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:25"
      },
      "items": [
        {
          "text": "Iyeyo ayenera kuopedwa kuposa milungu yonse.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.25",
            "verseOrgIds": [
              "1CH.16.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti milungu yonse ya anthu a mitundu ina ndi mafano wopanda pake,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.26",
            "verseOrgIds": [
              "1CH.16.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:26"
      },
      "items": [
        {
          "text": "koma Yehova analenga kumwamba.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.26",
            "verseOrgIds": [
              "1CH.16.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulemerero ndi ufumu zili pamaso pake;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.27",
            "verseOrgIds": [
              "1CH.16.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:27"
      },
      "items": [
        {
          "text": "mphamvu ndi chimwemwe zili pa malo pokhala Iye.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.27",
            "verseOrgIds": [
              "1CH.16.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Perekani kwa Yehova, Inu mabanja a anthu a mitundu ina,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.28",
            "verseOrgIds": [
              "1CH.16.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:28"
      },
      "items": [
        {
          "text": "perekani kwa Yehova ulemerero ndi mphamvu,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.28",
            "verseOrgIds": [
              "1CH.16.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "perekani kwa Yehova ulemerero woyenera dzina lake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.29",
            "verseOrgIds": [
              "1CH.16.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1CH 16:29"
      },
      "items": [
        {
          "text": "Bweretsani chopereka ndipo mufike pamaso pake;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.29",
            "verseOrgIds": [
              "1CH.16.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:29"
      },
      "items": [
        {
          "text": "pembedzani Yehova mu ulemerero wachiyero chake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.29",
            "verseOrgIds": [
              "1CH.16.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njenjemerani pamaso pake, dziko lonse lapansi!",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.30",
            "verseOrgIds": [
              "1CH.16.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:30"
      },
      "items": [
        {
          "text": "Dziko linakhazikika kolimba; silingasunthidwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.30",
            "verseOrgIds": [
              "1CH.16.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zakumwamba zisangalale, dziko lapansi likondwere;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.31",
            "verseOrgIds": [
              "1CH.16.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:31"
      },
      "items": [
        {
          "text": "anene anthu a mitundu ina, \"Yehova ndi mfumu!\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.31",
            "verseOrgIds": [
              "1CH.16.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyanja ikokome, ndi zonse zili mʼmenemo;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.32",
            "verseOrgIds": [
              "1CH.16.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:32"
      },
      "items": [
        {
          "text": "minda ikondwere, ndi zonse zili mʼmenemo!",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.32",
            "verseOrgIds": [
              "1CH.16.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo mitengo ya mʼnkhalango idzayimba,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.33",
            "verseOrgIds": [
              "1CH.16.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:33"
      },
      "items": [
        {
          "text": "idzayimba chifukwa cha chimwemwe pamaso pa Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.33",
            "verseOrgIds": [
              "1CH.16.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:33"
      },
      "items": [
        {
          "text": "pakuti akubwera kudzaweruza dziko lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.33",
            "verseOrgIds": [
              "1CH.16.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamikani Yehova, pakuti Iye ndi wabwino;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.34",
            "verseOrgIds": [
              "1CH.16.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:34"
      },
      "items": [
        {
          "text": "chikondi chake chikhala mpaka muyaya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.34",
            "verseOrgIds": [
              "1CH.16.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 16:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fuwulani kuti, \"Tipulumutseni, Inu Mulungu wa chipulumutso chathu,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.35",
            "verseOrgIds": [
              "1CH.16.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:35"
      },
      "items": [
        {
          "text": "mutisonkhanitse ndipo mutipulumutse kwa anthu a mitundu ina,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.35",
            "verseOrgIds": [
              "1CH.16.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1CH 16:35"
      },
      "items": [
        {
          "text": "kuti tiyamike dzina lanu loyera,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.35",
            "verseOrgIds": [
              "1CH.16.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:35"
      },
      "items": [
        {
          "text": "kuti tikutamandeni.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.35",
            "verseOrgIds": [
              "1CH.16.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 16:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atamandike Yehova Mulungu wa Israeli,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.36",
            "verseOrgIds": [
              "1CH.16.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:36"
      },
      "items": [
        {
          "text": "kuyambira muyaya mpaka muyaya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.36",
            "verseOrgIds": [
              "1CH.16.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "1CH 16:36"
      },
      "items": [
        {
          "text": "Ndipo anthu onse anati, \"Ameni\" ndipo \"Tikutamandani Yehova.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.36",
            "verseOrgIds": [
              "1CH.16.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 16:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Davide anasiya Asafu pamodzi ndi anzake kumene kunali Bokosi la Chipangano la Yehova kuti azitumikira kumeneko nthawi zonse, monga mwa zoyenera kuchita pa tsiku lililonse.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.37",
            "verseOrgIds": [
              "1CH.16.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 16:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anasiyanso Obedi-Edomu pamodzi ndi anzake 68 kuti azitumikira nawo pamodzi. Obedi-Edomu mwana wa Yedutuni ndi Hosa anali alonda a pa chipata.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.38",
            "verseOrgIds": [
              "1CH.16.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 16:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davide anasiya wansembe Zadoki ndi ansembe anzake ku chihema cha Yehova ku malo achipembedzo ku Gibiyoni",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.39",
            "verseOrgIds": [
              "1CH.16.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 16:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti azipereka nsembe zopsereza kwa Yehova pa guwa lansembe nthawi zonse mmawa ndi madzulo, potsata zonse zimene zinalembedwa mʼbuku la malamulo a Yehova, amene anawapereka kwa Aisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.40",
            "verseOrgIds": [
              "1CH.16.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 16:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthuwo anali pamodzi ndi Hemani ndi Yedutuni ndi onse amene anawasankha mowatchula dzina kuti apereke mayamiko kwa Yehova, \"pakuti chikondi chake ndi chosatha.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.41",
            "verseOrgIds": [
              "1CH.16.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 16:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hemani ndi Yedutuni anali oyangʼanira malipenga ndi ziwaya ndiponso zipangizo zina zoyimbira nyimbo zachipembedzo. Ana a Yedutuni anawayika kuti aziyangʼanira pa chipata.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.42",
            "verseOrgIds": [
              "1CH.16.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
