          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka anthu onse anachoka, aliyense kupita kwawo. Ndipo Davide anabwerera ku nyumba kwake kukadalitsa banja lake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.43",
            "verseOrgIds": [
              "1CH.16.43"
            ]
