  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "MIC 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Phiri la Yehova",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MIC 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼmasiku otsiriza,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.1",
            "verseOrgIds": [
              "MIC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:1"
      },
      "items": [
        {
          "text": "phiri la Nyumba ya Yehova adzalikhazikitsa",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.1",
            "verseOrgIds": [
              "MIC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:1"
      },
      "items": [
        {
          "text": "kukhala lalitali kuposa mapiri ena onse.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.1",
            "verseOrgIds": [
              "MIC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:1"
      },
      "items": [
        {
          "text": "Lidzaonekera pamwamba pa mapiri ena onse,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.1",
            "verseOrgIds": [
              "MIC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:1"
      },
      "items": [
        {
          "text": "ndipo anthu amitundu yonse adzathamangira kumeneko.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.1",
            "verseOrgIds": [
              "MIC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayiko ambiri adzabwera ndikunena kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:2"
      },
      "items": [
        {
          "text": "\"Tiyeni, tikwere ku phiri la Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:2"
      },
      "items": [
        {
          "text": "ku nyumba ya Mulungu wa Yakobo.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:2"
      },
      "items": [
        {
          "text": "Iye adzatiphunzitsa njira zake,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:2"
      },
      "items": [
        {
          "text": "ndipo tidzayenda mʼnjira zakezo.\"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:2"
      },
      "items": [
        {
          "text": "Malangizo adzachokera ku Ziyoni,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:2"
      },
      "items": [
        {
          "text": "mawu a Yehova adzachokera ku Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye adzaweruza pakati pa anthu amitundu yambiri",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.3",
            "verseOrgIds": [
              "MIC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:3"
      },
      "items": [
        {
          "text": "ndipo adzathetsa kusamvana pakati pa anthu amphamvu akutali ndi apafupi omwe.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.3",
            "verseOrgIds": [
              "MIC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:3"
      },
      "items": [
        {
          "text": "Anthuwo adzasandutsa malupanga awo kukhala makasu",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.3",
            "verseOrgIds": [
              "MIC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:3"
      },
      "items": [
        {
          "text": "ndiponso mikondo yawo kukhala zomwetera.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.3",
            "verseOrgIds": [
              "MIC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:3"
      },
      "items": [
        {
          "text": "Mtundu wina sudzatenganso lupanga kumenyana ndi mtundu wina,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.3",
            "verseOrgIds": [
              "MIC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:3"
      },
      "items": [
        {
          "text": "kapena kuphunziranso za nkhondo.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.3",
            "verseOrgIds": [
              "MIC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthu aliyense adzakhala pansi pa tsinde pa mtengo wake wa mpesa",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.4",
            "verseOrgIds": [
              "MIC.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:4"
      },
      "items": [
        {
          "text": "ndi pa tsinde pa mtengo wake wamkuyu,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.4",
            "verseOrgIds": [
              "MIC.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:4"
      },
      "items": [
        {
          "text": "ndipo palibe amene adzawachititse mantha,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.4",
            "verseOrgIds": [
              "MIC.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:4"
      },
      "items": [
        {
          "text": "pakuti Yehova Wamphamvuzonse wayankhula.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.4",
            "verseOrgIds": [
              "MIC.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mitundu yonse ya anthu",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.5",
            "verseOrgIds": [
              "MIC.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:5"
      },
      "items": [
        {
          "text": "itha kutsatira milungu yawo;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.5",
            "verseOrgIds": [
              "MIC.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:5"
      },
      "items": [
        {
          "text": "ife tidzayenda mʼnjira za Yehova",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.5",
            "verseOrgIds": [
              "MIC.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:5"
      },
      "items": [
        {
          "text": "Mulungu wathu mpaka muyaya.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.5",
            "verseOrgIds": [
              "MIC.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cholinga cha Yehova",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tsiku limenelo, Yehova akuti,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.6",
            "verseOrgIds": [
              "MIC.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:6"
      },
      "items": [
        {
          "text": "\"ndidzasonkhanitsa olumala;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.6",
            "verseOrgIds": [
              "MIC.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:6"
      },
      "items": [
        {
          "text": "ndidzasonkhanitsa pamodzi anthu ochotsedwa",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.6",
            "verseOrgIds": [
              "MIC.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:6"
      },
      "items": [
        {
          "text": "ndiponso amene ndinawalanga.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.6",
            "verseOrgIds": [
              "MIC.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu olumalawo ndidzawasandutsa anthu anga otsala.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.7",
            "verseOrgIds": [
              "MIC.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:7"
      },
      "items": [
        {
          "text": "Anthu amene ndinawachotsa ndidzawasandutsa mtundu wamphamvu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.7",
            "verseOrgIds": [
              "MIC.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:7"
      },
      "items": [
        {
          "text": "Yehova adzawalamulira mʼPhiri la Yehova",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.7",
            "verseOrgIds": [
              "MIC.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:7"
      },
      "items": [
        {
          "text": "kuyambira tsiku limenelo mpaka muyaya.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.7",
            "verseOrgIds": [
              "MIC.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunena za iwe, nsanja ya ziweto zanga,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.8",
            "verseOrgIds": [
              "MIC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:8"
      },
      "items": [
        {
          "text": "iwe linga la mwana wamkazi wa Ziyoni,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.8",
            "verseOrgIds": [
              "MIC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:8"
      },
      "items": [
        {
          "text": "ulamuliro wako wakale udzabwezeretsedwa kwa iwe;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.8",
            "verseOrgIds": [
              "MIC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:8"
      },
      "items": [
        {
          "text": "ufumu udzabwera pa mwana wamkazi wa Yerusalemu.\"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.8",
            "verseOrgIds": [
              "MIC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chifukwa chiyani tsopano ukulira mofuwula,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.9",
            "verseOrgIds": [
              "MIC.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:9"
      },
      "items": [
        {
          "text": "kodi ulibe mfumu?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.9",
            "verseOrgIds": [
              "MIC.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:9"
      },
      "items": [
        {
          "text": "Kodi phungu wako wawonongedwa,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.9",
            "verseOrgIds": [
              "MIC.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:9"
      },
      "items": [
        {
          "text": "kotero kuti ululu wako uli ngati wa mayi amene akubereka?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.9",
            "verseOrgIds": [
              "MIC.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
