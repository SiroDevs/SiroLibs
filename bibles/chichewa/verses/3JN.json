    "verseCount": 15,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "1",
          "style": "c",
          "sid": "3JN 1"
        },
        "items": [
          {
            "text": "1",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "3JN 1:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ndine mkulu wampingo, kulembera:",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.1",
              "verseOrgIds": [
                "3JN.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p",
          "vid": "3JN 1:1"
        },
        "items": [
          {
            "text": "Gayo mnzanga wokondedwa, amene ndimamukonda mʼchoonadi.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.1",
              "verseOrgIds": [
                "3JN.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "3JN 1:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "Wokondedwa, ndimakupempherera kuti zako zonse zikuyendere bwino, ndikuti ukhale bwino mʼthupi mwako, monga momwe ulili moyo wako wauzimu.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.2",
              "verseOrgIds": [
                "3JN.1.2"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "3JN 1:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ine ndinali ndi chimwemwe chachikulu pamene abale ena anafika nʼkundifotokozera za kukhulupirika kwako pa choonadi ndiponso mmene umayendera motsata choonadi.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.3",
              "verseOrgIds": [
                "3JN.1.3"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "3JN 1:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Palibe chondikondweretsa kwambiri kuposa kumva kuti ana anga akukhala mʼchoonadi.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.4",
              "verseOrgIds": [
                "3JN.1.4"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "3JN 1:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "Wokondedwa, ndiwe wokhulupirika pa zimene ukuchitira abale, ngakhale kuti iwowo ndi alendo.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.5",
              "verseOrgIds": [
                "3JN.1.5"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "3JN 1:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Iwo anafotokozera mpingo za chikondi chako. Chonde uwathandize kupitiriza ulendo mʼnjira yokondweretsa Mulungu.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.6",
              "verseOrgIds": [
                "3JN.1.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "3JN 1:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Pakuti ananyamuka ulendo wawo chifukwa cha dzina la Ambuye, osalandira thandizo kwa osakhulupirira.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.7",
              "verseOrgIds": [
                "3JN.1.7"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "3JN 1:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ife tiyenera kumathandiza anthu oterewa, kuti tigwirizane nawo pa ntchito ya choonadi.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.8",
              "verseOrgIds": [
                "3JN.1.8"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Za Diotrefe ndi Demetriyo",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "3JN 1:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ndinalembera mpingo, koma Diotrefe, amene amafuna kukhala wotsogolera, sanafune kutimvera.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.9",
              "verseOrgIds": [
                "3JN.1.9"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "3JN 1:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "Tsono ndikabwera ndidzakumbutsa zimene iye amachita. Iye amafalitsa nkhani zabodza zonena ife. Ndipo sakhutira ndi zimenezo, komanso iyeyo amakana kulandira abale. Komanso amaletsa amene akufuna kutero, ndipo amawachotsa mu mpingo.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.10",
              "verseOrgIds": [
                "3JN.1.10"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "3JN 1:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Wokondedwa, usatsatire zinthu zoyipa koma zinthu zabwino. Aliyense amene amachita zinthu zabwino ndi wochokera kwa Mulungu. Aliyense amene amachita zoyipa sanamuonepo Mulungu.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.11",
              "verseOrgIds": [
                "3JN.1.11"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "3JN 1:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "Aliyense akumuchitira umboni wabwino wa Demetriyo. Ngakhale choona chomwe chimamuchitira umboni, ndipo iweyo ukudziwa kuti umboni wathu ndi woona.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.12",
              "verseOrgIds": [
                "3JN.1.12"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "13",
              "style": "v",
              "sid": "3JN 1:13"
            },
            "items": [
              {
                "text": "13",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ndili ndi zambiri zoti ndikulembereni, koma sindikufuna kuzilemba mʼkalata.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.13",
              "verseOrgIds": [
                "3JN.1.13"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "14",
              "style": "v",
              "sid": "3JN 1:14"
            },
            "items": [
              {
                "text": "14",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ndiyembekezera kufika kwanuko posachedwapa, ndipo tidzakambirana pamaso ndi pamaso.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.14",
              "verseOrgIds": [
                "3JN.1.14"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "15",
              "style": "v",
              "sid": "3JN 1:15"
            },
            "items": [
              {
                "text": "15",
                "type": "text"
              }
            ]
          },
          {
            "text": "Mtendere ukhale nawe. Abwenzi anu kuno akupereka moni. Upereke moni kwa abwenzi onse mmodzimmodzi.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.15",
              "verseOrgIds": [
                "3JN.1.15"
              ]
            }
          }
        ]
      }
    ],
