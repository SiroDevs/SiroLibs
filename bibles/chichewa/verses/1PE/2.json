  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "1PE 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1PE 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho, lekani zoyipa zonse, chinyengo chilichonse, chiphamaso, nsanje ndi kusinjirira kulikonse.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.1",
            "verseOrgIds": [
              "1PE.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monga makanda obadwa kumene amalirira mkaka, inunso muzilakalaka mkaka weniweni wauzimu, kuti mukule ndi kukufikitsani ku chipulumutso chanu,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.2",
            "verseOrgIds": [
              "1PE.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "pakuti tsopano mwalawadi kuti Ambuye ndi wabwino.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.3",
            "verseOrgIds": [
              "1PE.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwala wa Moyo ndi Anthu Osankhidwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene mukubwera kwa Iye, amene ndi Mwala wa moyo, umene anthu anawukana, koma Mulungu anawusankha kuti ndi wa mtengowapatali,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.4",
            "verseOrgIds": [
              "1PE.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "inunso, mukhale ngati miyala ya moyo yoti Mulungu amangire nyumba yake yauzimu kuti mukhale ansembe opatulika, opereka nsembe zauzimu zovomerezeka ndi Mulungu mwa Yesu Khristu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.5",
            "verseOrgIds": [
              "1PE.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti mʼMalemba mwalembedwa kuti,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.6",
            "verseOrgIds": [
              "1PE.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1PE 2:6"
      },
      "items": [
        {
          "text": "\"Taonani, ndikuyika mwala wa maziko mu Ziyoni,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.6",
            "verseOrgIds": [
              "1PE.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1PE 2:6"
      },
      "items": [
        {
          "text": "wosankhika ndi wamtengowapatali.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.6",
            "verseOrgIds": [
              "1PE.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1PE 2:6"
      },
      "items": [
        {
          "text": "Amene akhulupirira Iye",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.6",
            "verseOrgIds": [
              "1PE.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1PE 2:6"
      },
      "items": [
        {
          "text": "sadzachititsidwa manyazi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.6",
            "verseOrgIds": [
              "1PE.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono kwa inu okhulupirira, mwalawo ndi wamtengowapatali. Koma kwa amene sakhulupirira,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.7",
            "verseOrgIds": [
              "1PE.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1PE 2:7"
      },
      "items": [
        {
          "text": "\"Mwala umene amisiri anawukana",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.7",
            "verseOrgIds": [
              "1PE.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1PE 2:7"
      },
      "items": [
        {
          "text": "wasanduka mwala wa maziko,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.7",
            "verseOrgIds": [
              "1PE.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1PE 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndi",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.8",
            "verseOrgIds": [
              "1PE.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1PE 2:8"
      },
      "items": [
        {
          "text": "\"Mwala wopunthwitsa anthu",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.8",
            "verseOrgIds": [
              "1PE.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1PE 2:8"
      },
      "items": [
        {
          "text": "ndiponso thanthwe limene limagwetsa anthu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.8",
            "verseOrgIds": [
              "1PE.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "1PE 2:8"
      },
      "items": [
        {
          "text": "Iwo amapunthwa chifukwa samvera uthenga, pakuti ichi ndiye chinali chifuniro cha Mulungu pa iwo.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.8",
            "verseOrgIds": [
              "1PE.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma inu ndinu anthu osankhidwa ndi Mulungu, ansembe achifumu, mtundu woyera mtima, anthu ake enieni a Mulungu, munasankhidwa kuti mulalikire za ntchito zamphamvu za Iye amene anakuyitanani kuti mutuluke mu mdima ndi kulowa mʼkuwunika kwake kodabwitsa.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.9",
            "verseOrgIds": [
              "1PE.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale simunali anthu ake, koma tsopano ndinu anthu a Mulungu. Kale simunalandire chifundo, koma tsopano mwalandira chifundo.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.10",
            "verseOrgIds": [
              "1PE.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okondedwa, ndikukupemphani, ngati alendo pansi pano, pewani zilakolako za uchimo, zimene zimachita nkhondo ndi moyo wanu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.11",
            "verseOrgIds": [
              "1PE.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khalani moyo wabwino pakati pa anthu osapembedza kuti ngakhale atakusinjirirani kuti mumachita zoyipa, iwowo akaona ntchito zanu zabwino, adzalemekeza Mulungu pa tsiku lomwe Iye adzatiyendere.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.12",
            "verseOrgIds": [
              "1PE.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kugonjera Olamulira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1PE 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gonjerani maulamuliro onse chifukwa cha Ambuye. Kaya ndi mfumu, imvereni chifukwa ili ndi ulamuliro waukulu,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.13",
            "verseOrgIds": [
              "1PE.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kaya ndi mabwanamkubwa, pakuti watumidwa ndi mfumu kuti alange onse amene amachita zoyipa ndi kuyamikira onse amene amachita zabwino.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.14",
            "verseOrgIds": [
              "1PE.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1PE 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti Mulungu akufuna kuti pochita ntchito zabwino muthetse kuyankhula mosazindikira ndi mopusa.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.15",
            "verseOrgIds": [
              "1PE.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1PE 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukhale monga mfulu, koma musagwiritse ntchito ufulu wanuwo ngati chophimbira zoyipa; mukhale monga atumiki a Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.16",
            "verseOrgIds": [
              "1PE.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chitirani ulemu aliyense, kondani abale okhulupirira, wopani Mulungu, ndipo chitirani mfumu ulemu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.17",
            "verseOrgIds": [
              "1PE.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akapolo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1PE 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu akapolo, gonjerani ambuye anu ndi kuwachitira ulemu, osati kwa iwo okha amene ndi abwino ndi omvetsa zinthu, komanso kwa amene ndi ankhanza.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.18",
            "verseOrgIds": [
              "1PE.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1PE 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti ndi chinthu chokoma ngati munthu apirira mu zowawa zimene sizinamuyenera chifukwa chodziwa kuti Mulungu alipo.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.19",
            "verseOrgIds": [
              "1PE.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1PE 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi pali choti akuyamikireni ngati mupirira pomenyedwa chifukwa choti mwalakwa? Koma ngati mumva zowawa chifukwa chochita zabwino ndi kupirira, mwachita choyamikika pamaso pa Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.20",
            "verseOrgIds": [
              "1PE.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1PE 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munayitanidwa kudzachita zimenezi, chifukwa Khristu anamva zowawa chifukwa cha inu, anakusiyirani chitsanzo, kuti inu mutsatire mʼmapazi ake.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.21",
            "verseOrgIds": [
              "1PE.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1PE 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iye sanachite tchimo",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.22",
            "verseOrgIds": [
              "1PE.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1PE 2:22"
      },
      "items": [
        {
          "text": "kapena kunena bodza.\"",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.22",
            "verseOrgIds": [
              "1PE.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1PE 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene anthu ankamuchita chipongwe, Iye sanabwezere chipongwe, pamene Iye ankamva zowawa, sanaopseze. Mʼmalo mwake, anadzipereka kwa Mulungu amene amaweruza molungama.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.23",
            "verseOrgIds": [
              "1PE.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1PE 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
