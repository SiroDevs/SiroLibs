  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "LEV 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ngati munthu anayitanidwa ku bwalo kuti akachitire umboni pa zimene anaziona kapena kuzimva koma iye nʼkukana kuchitira umboni, munthu ameneyo wachimwa ndipo ayenera kulangidwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.1",
            "verseOrgIds": [
              "LEV.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Munthu akakhudza chinthu chilichonse chodetsedwa, monga nyama yakufa ya mʼthengo, kapena chiweto chakufa kapenanso chokwawa chakufa, ngakhale iyeyo wachikhudza mosadziwa, wasanduka wodetsedwa ndipo wachimwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.2",
            "verseOrgIds": [
              "LEV.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Munthu akakhudza choyipitsa munthu cha mtundu uliwonse, ndipo pochikhudzapo ndi kuyipitsidwa nacho mosadziwa, munthuyo adzakhala wopalamula akangodziwa chimene wachitacho.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.3",
            "verseOrgIds": [
              "LEV.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Munthu akalumbira mofulumira kapena mosasamala kuti adzachita chinthu, choyipa kapena chabwino, ngakhale kuti wachita izi mosadziwa kuti nʼkulakwa, pamene wazindira kulakwa kwake, iye adzakhalabe wopalamula akangodziwa chimene wachitacho.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.4",
            "verseOrgIds": [
              "LEV.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Pamene munthu wazindikira kuti wachimwa motere, awulule tchimo limene wachitalo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.5",
            "verseOrgIds": [
              "LEV.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pambuyo pake, munthuyo abwere kwa Yehova ndi mwana wankhosa wamkazi kapena mbuzi kuti ikhale chopereka chopepesera tchimo ndipo wansembe achite mwambo wopepesera tchimo lomwe wachitalo. Tsono wansembe achite mwambo wopepesera tchimo la munthuyo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.6",
            "verseOrgIds": [
              "LEV.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ngati munthuyo alibe mwana wankhosa, abweretse njiwa ziwiri kapena nkhunda ziwiri kwa Yehova ngati chopereka chopepesera tchimo lake. Imodzi ikhale nsembe yopepesera tchimo, ndipo inayo ikhale nsembe yopsereza.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.7",
            "verseOrgIds": [
              "LEV.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono abwere nazo kwa wansembe, ndipo wansembeyo ayambe wapereka mbalame imodzi ngati yopepesera tchimo. Apotole khosi koma osayidula mutu,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.8",
            "verseOrgIds": [
              "LEV.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kenaka awaze magazi a chopereka chopepesera tchimocho mʼmbali mwa guwa. Magazi ena onse awathire pa tsinde la guwa. Imeneyi ndi nsembe yopepesera tchimo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.9",
            "verseOrgIds": [
              "LEV.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pambuyo pake wansembe apereke mbalame inayo kuti ikhale chopereka chopsereza potsata mwambo wake. Wansembe atatha kupereka nsembe yopepesera tchimo limene munthu uja wachita, wochimwayo adzakhululukidwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.10",
            "verseOrgIds": [
              "LEV.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Koma ngati munthuyo alibe njiwa ziwiri kapena nkhunda ziwiri, abweretse ufa wosalala wokwanira kilogalamu imodzi kuti ukhale chopereka chopepesera tchimo limene wachita. Asathiremo mafuta kapena lubani chifukwa ndi chopereka chopepesera tchimo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.11",
            "verseOrgIds": [
              "LEV.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abweretse ufawo kwa wansembe ndipo wansembeyo atapeko dzanja limodzi kuti ukhale ufa wachikumbutso ndi kuwutentha pa guwa pamodzi ndi chopereka chopsereza kwa Yehova. Imeneyi ndi nsembe yopepesera tchimo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.12",
            "verseOrgIds": [
              "LEV.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umu ndi mmene wansembe adzachitire mwambo wopepesera machimo ena aliwonse amene munthu wachita, ndipo munthuyo adzakhululukidwa. Zopereka zonse zotsala zidzakhala za wansembeyo monga momwe amachitira ndi chopereka chachakudya.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.13",
            "verseOrgIds": [
              "LEV.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chopereka Chopepesera Kupalamula",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anawuza Mose kuti,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.14",
            "verseOrgIds": [
              "LEV.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Munthu akachita zinthu mosakhulupirika, nachimwa mosadziwa posapereka zinthu zopatulika zofunika kwa Yehova, munthuyo apereke kwa Yehova nsembe yopepesera machimo ake. Nsembeyo ikhale nkhosa yayimuna yopanda chilema ndipo mtengo wake ukhale wokwana masekeli oyenera a siliva pakawerengedwe ka ku Nyumba ya Mulungu. Imeneyi ndi nsembe yopepesera kupalamula.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.15",
            "verseOrgIds": [
              "LEV.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthuyo ayenera kubweza zinthu zopatulika zimene sanaperekezo. Awonjezepo chimodzi mwa zigawo zisanu zilizonse ndi kuzipereka zonsezo kwa wansembe amene adzachita mwambo wopepesera machimo a munthuyo, popereka nkhosa yayimuna ija ngati nsembe yopepesera ndipo wochimwayo adzakhululukidwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.16",
            "verseOrgIds": [
              "LEV.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ngati munthu wachimwa mosadziwa pochita chilichonse chimene Yehova salola, munthuyo ndi wopalamula ndithu, ndipo ayenera kulangidwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.17",
            "verseOrgIds": [
              "LEV.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abwere kwa wansembe ndi chopereka chopepesera kupalamula kwake. Chopereka chikhale nkhosa yayimuna yopanda chilema ndipo mtengo wake ukhale woyenera nsembe yopepesera kupalamula kumene anachimwa mosadziwako, ndipo munthuyo adzakhululukidwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.18",
            "verseOrgIds": [
              "LEV.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imeneyi ndi nsembe yopepesera kupalamula popeza munthuyo wapezeka wolakwa pamaso pa Yehova.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.19",
            "verseOrgIds": [
              "LEV.5.19"
            ]
          }
        }
      ]
    }
  ],
