            "sid": "LEV 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Aaroni ndi ana ake anachita zonse zimene Yehova analamula kudzera mwa Mose.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.36",
