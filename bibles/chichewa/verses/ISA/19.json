            "verseId": "ISA.19.14",
            "verseOrgIds": [
              "ISA.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 19:14"
      },
      "items": [
        {
          "text": "Iwo akuchita kudzandira pa zonse zimene akuchita,",
          "type": "text",
