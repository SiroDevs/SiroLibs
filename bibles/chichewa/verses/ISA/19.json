            "verseId": "ISA.19.14",
            "verseOrgIds": [
              "ISA.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:14"
      },
      "items": [
        {
          "text": "ngati chidakwa choterereka pa masanzi ake.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.14",
            "verseOrgIds": [
              "ISA.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Palibe chimene munthu wa mu Igupto angachite,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.15",
            "verseOrgIds": [
              "ISA.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:15"
      },
      "items": [
        {
          "text": "mtsogoleri kapena wotsatira, nthambi ya kanjedza kapena bango.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.15",
            "verseOrgIds": [
              "ISA.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku limenelo Aigupto adzakhala ngati amayi. Adzanjenjemera ndi kuchita mantha akadzaona Yehova Wamphamvuzonse, atakweza dzanja lake kufuna kuwalanga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.16",
            "verseOrgIds": [
              "ISA.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo dziko la Yuda lidzaopsa dziko la Aigupto. Aliyense amene adzamve dzina la Yuda adzaopsedwa chifukwa cha zimene Yehova Wamphamvuzonse wakonzekera kuchitira dziko la Igupto.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.17",
            "verseOrgIds": [
              "ISA.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku limenelo ku dziko la Igupto kudzakhala mizinda isanu yoyankhula chiyankhulo cha Akanaani, ndipo anthu ake adzalumbira kwa Yehova Wamphamvuzonse kuti adzamutumikira. Umodzi mwa mizindayo udzatchedwa Mzinda Wachilungamo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.18",
            "verseOrgIds": [
              "ISA.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku limenelo mʼkati mwa dziko la Igupto mudzakhala guwa lansembe la Yehova, ndipo mʼmalire mwake adzayikira Yehova mwala wachikumbutso.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.19",
            "verseOrgIds": [
              "ISA.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zimenezo zidzakhala umboni wozindikiritsa kuti Yehova Wamphamvuzonse alimo mʼdziko la Igupto. Pamene Aigupto adzalirira Yehova chifukwa cha owapondereza, Iye adzawatumizira mpulumutsi ndi mtetezi ndipo adzawalanditsa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.20",
            "verseOrgIds": [
              "ISA.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotero Yehova adzadziulula yekha kwa Aigupto, ndipo tsiku limenelo adzadziwa Yehova. Adzapembedza Yehova popereka nsembe ndi popereka zopereka zachakudya; Adzalumbira kwa Yehova ndipo adzachita zimene alumbirazo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.21",
            "verseOrgIds": [
              "ISA.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova adzakantha Aigupto ndi mliri. Iye adzawakanthadi ndipo kenaka adzawachiritsa. Aigupto adzatembenukira kwa Yehova ndipo Iye adzamva madandawulo awo ndi kuwachiritsa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.22",
            "verseOrgIds": [
              "ISA.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku limenelo kudzakhala msewu waukulu wochoka ku Igupto kupita ku Asiriya. Aasiriya adzapita ku Igupto ndi Aigupto ku Asiriya. Aigupto ndi Aasiriya adzapembedza pamodzi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.23",
            "verseOrgIds": [
              "ISA.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku limenelo Israeli adzakhala pamodzi ndi Igupto ndi Asiriya, mayiko atatuwa adzakhala dalitso pa dziko lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.24",
            "verseOrgIds": [
              "ISA.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova Wamphamvuzonse adzawadalitsa, ndi mawu awa, \"Adalitsike anthu anga Aigupto, Aasiriya, ntchito ya manja anga, ndi Aisraeli osankhidwa anga.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.25",
            "verseOrgIds": [
              "ISA.19.25"
            ]
          }
        }
      ]
    }
  ],
