  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "58",
        "style": "c",
        "sid": "ISA 58"
      },
      "items": [
        {
          "text": "58",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kusala Kwenikweni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 58:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Fuwula kwambiri, usaleke.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.1",
            "verseOrgIds": [
              "ISA.58.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:1"
      },
      "items": [
        {
          "text": "Mawu ako amveke ngati lipenga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.1",
            "verseOrgIds": [
              "ISA.58.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:1"
      },
      "items": [
        {
          "text": "Uwawuze anthu anga za kulakwa kwawo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.1",
            "verseOrgIds": [
              "ISA.58.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:1"
      },
      "items": [
        {
          "text": "uwuze nyumba ya Yakobo za machimo awo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.1",
            "verseOrgIds": [
              "ISA.58.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 58:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti tsiku ndi tsiku amafunafuna Ine;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.2",
            "verseOrgIds": [
              "ISA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:2"
      },
      "items": [
        {
          "text": "amaoneka ngati a chidwi chofuna kudziwa zimene ndimafuna,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.2",
            "verseOrgIds": [
              "ISA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:2"
      },
      "items": [
        {
          "text": "kukhala ngati kuti ndi dziko limene limachita zolondola",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.2",
            "verseOrgIds": [
              "ISA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:2"
      },
      "items": [
        {
          "text": "ndipo silinasiye zolamulira za Mulungu wake.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.2",
            "verseOrgIds": [
              "ISA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:2"
      },
      "items": [
        {
          "text": "Amandipempha kuti ndigamule mlandu wawo mwachilungamo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.2",
            "verseOrgIds": [
              "ISA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:2"
      },
      "items": [
        {
          "text": "ndipo amaonetsa chidwi chofuna kukhala pafupi ndi Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.2",
            "verseOrgIds": [
              "ISA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 58:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu akufunsa kuti, 'Chifukwa chiyani ife tasala",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.3",
            "verseOrgIds": [
              "ISA.58.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:3"
      },
      "items": [
        {
          "text": "kudya pamene Inu simukulabadirapo?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.3",
            "verseOrgIds": [
              "ISA.58.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:3"
      },
      "items": [
        {
          "text": "Kodi ife tavutikiranji nʼkudzichepetsa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.3",
            "verseOrgIds": [
              "ISA.58.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:3"
      },
      "items": [
        {
          "text": "pamene Inu simunasamalepo?' \"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.3",
            "verseOrgIds": [
              "ISA.58.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ISA 58:3"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:3"
      },
      "items": [
        {
          "text": "Yehova akuti, \"Komatu tsiku lanu losala kudya, mumachita zinthu zokukondweretsani,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.3",
            "verseOrgIds": [
              "ISA.58.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:3"
      },
      "items": [
        {
          "text": "ndipo mumazunza antchito anu onse.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.3",
            "verseOrgIds": [
              "ISA.58.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 58:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumati uku mukusala kudya, uku mukukangana ndi kumenyana,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.4",
            "verseOrgIds": [
              "ISA.58.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:4"
      },
      "items": [
        {
          "text": "mpaka kumenyana ndi nkhonya zopweteka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.4",
            "verseOrgIds": [
              "ISA.58.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:4"
      },
      "items": [
        {
          "text": "Kusala kudya mukuchitiramu musayembekezere kuti mawu anu amveka kumwamba.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.4",
            "verseOrgIds": [
              "ISA.58.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 58:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi kusala kudya kumene ndimakufuna Ine nʼkumeneku,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.5",
            "verseOrgIds": [
              "ISA.58.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:5"
      },
      "items": [
        {
          "text": "kungokhala tsiku loti munthu adzichepetse basi?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.5",
            "verseOrgIds": [
              "ISA.58.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:5"
      },
      "items": [
        {
          "text": "Kodi ndi tsiku loti munthu angowerama pansi ngati bango",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.5",
            "verseOrgIds": [
              "ISA.58.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:5"
      },
      "items": [
        {
          "text": "ndi kumayala ziguduli nʼkuthirapo phulusa nʼkugonapo?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.5",
            "verseOrgIds": [
              "ISA.58.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:5"
      },
      "items": [
        {
          "text": "Kodi ndiye mumati kusala kudya kumeneko,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.5",
            "verseOrgIds": [
              "ISA.58.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:5"
      },
      "items": [
        {
          "text": "tsiku lokondweretsa Yehova?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.5",
            "verseOrgIds": [
              "ISA.58.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 58:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kodi si uku kusala kudya kumene Ine ndimakufuna:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.6",
            "verseOrgIds": [
              "ISA.58.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:6"
      },
      "items": [
        {
          "text": "Kumasula maunyolo ozunzizira anthu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.6",
            "verseOrgIds": [
              "ISA.58.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:6"
      },
      "items": [
        {
          "text": "ndi kumasula zingwe za goli,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.6",
            "verseOrgIds": [
              "ISA.58.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:6"
      },
      "items": [
        {
          "text": "kupereka ufulu kwa oponderezedwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.6",
            "verseOrgIds": [
              "ISA.58.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:6"
      },
      "items": [
        {
          "text": "ndi kuphwanya goli lililonse?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.6",
            "verseOrgIds": [
              "ISA.58.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 58:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu anjala kodi mwawagawira chakudya chanu?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.7",
            "verseOrgIds": [
              "ISA.58.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:7"
      },
      "items": [
        {
          "text": "Osowa ndi ongoyendayenda,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.7",
            "verseOrgIds": [
              "ISA.58.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:7"
      },
      "items": [
        {
          "text": "kodi mwawapatsa malo ogona?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.7",
            "verseOrgIds": [
              "ISA.58.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:7"
      },
      "items": [
        {
          "text": "Munthu wausiwa kodi mwamupatsa chovala?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.7",
            "verseOrgIds": [
              "ISA.58.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 58:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukatero chipulumutso chanu chidzabwera ngati mʼbandakucha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.8",
            "verseOrgIds": [
              "ISA.58.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:8"
      },
      "items": [
        {
          "text": "ndipo mabala anu adzachira msangamsanga;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.8",
            "verseOrgIds": [
              "ISA.58.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:8"
      },
      "items": [
        {
          "text": "chilungamo chanu chidzakutsogolerani",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.8",
            "verseOrgIds": [
              "ISA.58.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:8"
      },
      "items": [
        {
          "text": "ndipo ulemerero wa Yehova udzakhala chokutchinjirizani kumbuyo kwanu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.8",
            "verseOrgIds": [
              "ISA.58.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 58:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukamadzapemphera Yehova adzakuyankhani;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.9",
            "verseOrgIds": [
              "ISA.58.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:9"
      },
      "items": [
        {
          "text": "mukadzapempha thandizo, Iye adzati: Ine ndili pano.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.9",
            "verseOrgIds": [
              "ISA.58.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ISA 58:9"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:9"
      },
      "items": [
        {
          "text": "\"Ngati muleka kuzunza anzanu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.9",
            "verseOrgIds": [
              "ISA.58.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:9"
      },
      "items": [
        {
          "text": "ngati musiya kuloza chala ndiponso kunena zoyipa za anzanu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.9",
            "verseOrgIds": [
              "ISA.58.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
