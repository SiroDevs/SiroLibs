  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "ISA 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tsoka kwa Mzinda wa Davide",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsoka kwa iwe, Arieli, Arieli,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.1",
            "verseOrgIds": [
              "ISA.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:1"
      },
      "items": [
        {
          "text": "mzinda umene Davide anakhazikitsamo zithando za nkhondo!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.1",
            "verseOrgIds": [
              "ISA.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:1"
      },
      "items": [
        {
          "text": "Papite chaka chimodzi kapena ziwiri",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.1",
            "verseOrgIds": [
              "ISA.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:1"
      },
      "items": [
        {
          "text": "ndipo masiku a zikondwerero zanu azipitirirabe ndithu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.1",
            "verseOrgIds": [
              "ISA.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komatu Ine ndidzathira nkhondo Arieli",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.2",
            "verseOrgIds": [
              "ISA.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:2"
      },
      "items": [
        {
          "text": "ndipo kudzakhala kulira ndi kudandaula,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.2",
            "verseOrgIds": [
              "ISA.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:2"
      },
      "items": [
        {
          "text": "mzindawo udzasanduka ngati ngʼanjo ya guwa lansembe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.2",
            "verseOrgIds": [
              "ISA.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndidzamanga misasa ya nkhondo kulimbana ndi mzindawo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.3",
            "verseOrgIds": [
              "ISA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:3"
      },
      "items": [
        {
          "text": "ndidzakuzungulira ndi nsanja za nkhondo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.3",
            "verseOrgIds": [
              "ISA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:3"
      },
      "items": [
        {
          "text": "ndi kumanga mitumbira yanga ya nkhondo kulimbana nawe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.3",
            "verseOrgIds": [
              "ISA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utagwetsedwa pansi, iwe udzayankhula kuchokera mʼnthaka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.4",
            "verseOrgIds": [
              "ISA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:4"
      },
      "items": [
        {
          "text": "mawu ako adzatuluka uli mʼfumbi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.4",
            "verseOrgIds": [
              "ISA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:4"
      },
      "items": [
        {
          "text": "adzamveka ngati a mzukwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.4",
            "verseOrgIds": [
              "ISA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:4"
      },
      "items": [
        {
          "text": "Mawu ako adzamveka ngati onongʼona kuchokera mʼfumbi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.4",
            "verseOrgIds": [
              "ISA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma chigulu cha adani ako chidzasanduka chifwirimbwiti.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.5",
            "verseOrgIds": [
              "ISA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:5"
      },
      "items": [
        {
          "text": "Chigulu cha ankhondo achilendo chidzabalalika ngati mungu wowuluzika ndi mphepo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.5",
            "verseOrgIds": [
              "ISA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:5"
      },
      "items": [
        {
          "text": "Mwadzidzidzi ndi mosayembekezereka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.5",
            "verseOrgIds": [
              "ISA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova Wamphamvuzonse adzabwera",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.6",
            "verseOrgIds": [
              "ISA.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:6"
      },
      "items": [
        {
          "text": "ndi mabingu ndi chivomerezi ndi phokoso lalikulu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.6",
            "verseOrgIds": [
              "ISA.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:6"
      },
      "items": [
        {
          "text": "kamvuluvulu ndi namondwe ndi malawi a moto wonyeketsa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.6",
            "verseOrgIds": [
              "ISA.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono chigulu chankhondo cha mitundu ina yonse chimene chikulimbana ndi mzinda wa Arieli",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.7",
            "verseOrgIds": [
              "ISA.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:7"
      },
      "items": [
        {
          "text": "nʼkumathira nkhondo mzindawo, malinga ake ndi kuwuzinga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.7",
            "verseOrgIds": [
              "ISA.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:7"
      },
      "items": [
        {
          "text": "chigulu chonsecho chidzazimirira ngati maloto,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.7",
            "verseOrgIds": [
              "ISA.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:7"
      },
      "items": [
        {
          "text": "gati zinthu zoziona mʼmasomphenya usiku.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.7",
            "verseOrgIds": [
              "ISA.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chidzakhala ngati munthu wanjala wolota akudya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.8",
            "verseOrgIds": [
              "ISA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:8"
      },
      "items": [
        {
          "text": "koma podzuka ali nayobe njala;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.8",
            "verseOrgIds": [
              "ISA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:8"
      },
      "items": [
        {
          "text": "kapena ngati munthu waludzu wolota akumwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.8",
            "verseOrgIds": [
              "ISA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:8"
      },
      "items": [
        {
          "text": "koma podzuka, ali nalobe ludzu, kummero kwake kuli gwaa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.8",
            "verseOrgIds": [
              "ISA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:8"
      },
      "items": [
        {
          "text": "Izi zidzachitika pamene chigulu cha nkhondo cha mitundu ina yonse",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.8",
            "verseOrgIds": [
              "ISA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:8"
      },
      "items": [
        {
          "text": "chikunthira nkhondo Phiri la Ziyoni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.8",
            "verseOrgIds": [
              "ISA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pitirizani kuledzera ndipo mudzakhala opusa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.9",
            "verseOrgIds": [
              "ISA.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:9"
      },
      "items": [
        {
          "text": "Dzitsekeni mʼmaso ndipo mukhale osapenya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.9",
            "verseOrgIds": [
              "ISA.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:9"
      },
      "items": [
        {
          "text": "ledzerani, koma osati ndi vinyo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.9",
            "verseOrgIds": [
              "ISA.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:9"
      },
      "items": [
        {
          "text": "dzandirani, koma osati ndi mowa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.9",
            "verseOrgIds": [
              "ISA.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wakugonetsani tulo tofa nato.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.10",
            "verseOrgIds": [
              "ISA.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:10"
      },
      "items": [
        {
          "text": "Watseka maso anu, inu aneneri;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.10",
            "verseOrgIds": [
              "ISA.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:10"
      },
      "items": [
        {
          "text": "waphimba mitu yanu, inu alosi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.10",
            "verseOrgIds": [
              "ISA.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa inu mawu onsewa ali ngati buku lotsekedwa, ndipo ngati lipatsidwa kwa wina wodziwa kuwerenga ndi kunena kuti, \"Chonde tawerengani bukuli,\" iye adzati, \"Sindingathe popeza ndi lomatidwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.11",
            "verseOrgIds": [
              "ISA.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapena ngati lipatsidwa kwa amene sadziwa kuwerenga ndi kunena kuti, \"Chonde werenga bukuli,\" iye adzayankha kuti, \"Ine sindidziwa kuwerenga.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.12",
            "verseOrgIds": [
              "ISA.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambuye akuti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.13",
            "verseOrgIds": [
              "ISA.29.13"
            ]
          }
        }
      ]
