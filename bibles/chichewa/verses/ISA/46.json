  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "46",
        "style": "c",
        "sid": "ISA 46"
      },
      "items": [
        {
          "text": "46",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Za Kupasuka kwa Babuloni ndi Mafano Ake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 46:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beli wagwada pansi, Nebo wawerama;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.1",
            "verseOrgIds": [
              "ISA.46.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:1"
      },
      "items": [
        {
          "text": "nyama zonyamula katundu za nyamula milungu yawo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.1",
            "verseOrgIds": [
              "ISA.46.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:1"
      },
      "items": [
        {
          "text": "Mafano awo asanduka katundu wolemera pa msana pa ngʼombe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.1",
            "verseOrgIds": [
              "ISA.46.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:1"
      },
      "items": [
        {
          "text": "Asandukadi ngati katundu pa msana pa nyama zotopa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.1",
            "verseOrgIds": [
              "ISA.46.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 46:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyamazo zikuwerama ndi kufuna kugwa ndi milunguyo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.2",
            "verseOrgIds": [
              "ISA.46.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:2"
      },
      "items": [
        {
          "text": "sizikutha kupulumutsa katunduyo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.2",
            "verseOrgIds": [
              "ISA.46.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:2"
      },
      "items": [
        {
          "text": "izo zomwe zikupita ku ukapolo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.2",
            "verseOrgIds": [
              "ISA.46.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 46:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mverani Ine, Inu nyumba ya Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.3",
            "verseOrgIds": [
              "ISA.46.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:3"
      },
      "items": [
        {
          "text": "inu nonse otsala a mʼnyumba ya Israeli,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.3",
            "verseOrgIds": [
              "ISA.46.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:3"
      },
      "items": [
        {
          "text": "Ine ndakhala ndi kukusamalirani kuyambira mʼmimba ya amayi anu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.3",
            "verseOrgIds": [
              "ISA.46.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:3"
      },
      "items": [
        {
          "text": "ndakhala ndikukunyamulani chibadwire chanu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.3",
            "verseOrgIds": [
              "ISA.46.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 46:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpaka pamene mudzakalambe ndi kumera imvi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.4",
            "verseOrgIds": [
              "ISA.46.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:4"
      },
      "items": [
        {
          "text": "ndidzakusamalirani ndithu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.4",
            "verseOrgIds": [
              "ISA.46.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:4"
      },
      "items": [
        {
          "text": "Ndinakulengani ndipo ndidzakunyamulani,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.4",
            "verseOrgIds": [
              "ISA.46.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:4"
      },
      "items": [
        {
          "text": "ndidzakusamalirani ndi kukulanditsani.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.4",
            "verseOrgIds": [
              "ISA.46.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 46:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kodi inu mudzandifanizira ndi yani, kapena mufananitsa ndi yani?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.5",
            "verseOrgIds": [
              "ISA.46.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:5"
      },
      "items": [
        {
          "text": "Kodi mudzandiyerekeza kapena kundifanizitsa ndi yani?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.5",
            "verseOrgIds": [
              "ISA.46.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 46:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu ena amakhuthula golide mʼzikwama zawo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.6",
            "verseOrgIds": [
              "ISA.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:6"
      },
      "items": [
        {
          "text": "ndipo amayeza siliva pa masikelo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.6",
            "verseOrgIds": [
              "ISA.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:6"
      },
      "items": [
        {
          "text": "amalemba ntchito mʼmisiri wosula kuti awapangire mulungu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.6",
            "verseOrgIds": [
              "ISA.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:6"
      },
      "items": [
        {
          "text": "kenaka iwo amagwada pansi ndikupembedza kamulunguko.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.6",
            "verseOrgIds": [
              "ISA.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 46:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amanyamula nʼkumayenda nayo milunguyo pa mapewa awo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.7",
            "verseOrgIds": [
              "ISA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:7"
      },
      "items": [
        {
          "text": "amayikhazika pa malo pake ndipo imakhala pomwepo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.7",
            "verseOrgIds": [
              "ISA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:7"
      },
      "items": [
        {
          "text": "Singathe kusuntha pamalo pakepo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.7",
            "verseOrgIds": [
              "ISA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:7"
      },
      "items": [
        {
          "text": "Ngakhale wina apemphere kwa milunguyo singathe kuyankha;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.7",
            "verseOrgIds": [
              "ISA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:7"
      },
      "items": [
        {
          "text": "kapena kumupulumutsa ku mavuto ake.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.7",
            "verseOrgIds": [
              "ISA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 46:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kumbukirani zimenezi ndipo muchite manyazi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.8",
            "verseOrgIds": [
              "ISA.46.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:8"
      },
      "items": [
        {
          "text": "Muzilingalire mu mtima, inu anthu owukira.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.8",
            "verseOrgIds": [
              "ISA.46.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 46:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumbukirani zinthu zakale zinthu zamakedzana;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.9",
            "verseOrgIds": [
              "ISA.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:9"
      },
      "items": [
        {
          "text": "chifukwa Ine ndine Mulungu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.9",
            "verseOrgIds": [
              "ISA.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:9"
      },
      "items": [
        {
          "text": "ndipo palibe wina ofanana nane.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.9",
            "verseOrgIds": [
              "ISA.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 46:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinaneneratu zakumathero kuchokera pachiyambi pomwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.10",
            "verseOrgIds": [
              "ISA.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:10"
      },
      "items": [
        {
          "text": "Kuyambira nthawi yamakedzana ndinaloseratu zoti zidzachitike.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.10",
            "verseOrgIds": [
              "ISA.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:10"
      },
      "items": [
        {
          "text": "Ndikanena zimene ndifuna kuchita ndipo zimachitikadi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.10",
            "verseOrgIds": [
              "ISA.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:10"
      },
      "items": [
        {
          "text": "Chilichonse chimene ndafuna ndimachichita.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.10",
            "verseOrgIds": [
              "ISA.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 46:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikuyitana chiwombankhanga kuchokera kummawa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.11",
            "verseOrgIds": [
              "ISA.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:11"
      },
      "items": [
        {
          "text": "Ndikuyitana kuchokera ku dziko lakutali munthu amene adzakwaniritsa cholinga changa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.11",
            "verseOrgIds": [
              "ISA.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:11"
      },
      "items": [
        {
          "text": "Zimene ndanena ndidzazikwaniritsadi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.11",
            "verseOrgIds": [
              "ISA.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:11"
      },
      "items": [
        {
          "text": "zimene ndafuna ndidzazichitadi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.11",
            "verseOrgIds": [
              "ISA.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 46:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndimvereni, inu anthu owuma mtima,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.12",
            "verseOrgIds": [
              "ISA.46.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:12"
      },
      "items": [
        {
          "text": "inu amene muli kutali ndi chipulumutso.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.12",
            "verseOrgIds": [
              "ISA.46.12"
