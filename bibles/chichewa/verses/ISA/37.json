          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Senakeribu mfumu ya ku Asiriya anasasula misasa nʼkuchoka kubwerera kukakhala ku Ninive.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.37",
