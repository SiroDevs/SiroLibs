  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "50",
        "style": "c",
        "sid": "ISA 50"
      },
      "items": [
        {
          "text": "50",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tchimo la Israeli, Kumvera kwa Mtumiki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 50:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova akuti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:1"
      },
      "items": [
        {
          "text": "\"Kalata imene ndinasudzulira amayi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:1"
      },
      "items": [
        {
          "text": "anu ili kuti?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:1"
      },
      "items": [
        {
          "text": "Kapena mwa anthu amene ndili nawo ngongole,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:1"
      },
      "items": [
        {
          "text": "ndinakugulitsani kwa ati?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:1"
      },
      "items": [
        {
          "text": "Inu munagulitsidwa ku ukapolo chifukwa cha machimo anu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:1"
      },
      "items": [
        {
          "text": "amayi anu anachotsedwa chifukwa cha kulakwa kwanu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 50:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼchifukwa chiyani pamene ndinabwera kudzakupulumutsani panalibe munthu?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:2"
      },
      "items": [
        {
          "text": "Pamene ndinayitana, nʼchifukwa chiyani panalibe wondiyankha?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:2"
      },
      "items": [
        {
          "text": "Kodi dzanja langa ndi lalifupi kuti nʼkulephera kukuwombolani?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:2"
      },
      "items": [
        {
          "text": "Kodi ndilibe mphamvu zokupulumutsirani?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:2"
      },
      "items": [
        {
          "text": "Ndi kudzudzula kokha ndinawumitsa nyanja yayikulu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:2"
      },
      "items": [
        {
          "text": "mitsinje ndinayisandutsa chipululu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:2"
      },
      "items": [
        {
          "text": "nsomba za mʼmenemo zinawola chifukwa chosowa madzi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:2"
      },
      "items": [
        {
          "text": "ndipo zinafa ndi ludzu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 50:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinaphimba thambo ndi mdima",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.3",
            "verseOrgIds": [
              "ISA.50.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:3"
      },
      "items": [
        {
          "text": "ndipo chiguduli chinakhala chofunda chake.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.3",
            "verseOrgIds": [
              "ISA.50.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 50:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambuye Yehova anandiphunzitsa mawu oyenera kuyankhula",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.4",
            "verseOrgIds": [
              "ISA.50.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:4"
      },
      "items": [
        {
          "text": "kudziwa mawu olimbitsa mtima anthu ofowoka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.4",
            "verseOrgIds": [
              "ISA.50.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:4"
      },
      "items": [
        {
          "text": "Mmawa mulimonse amandidzutsa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.4",
            "verseOrgIds": [
              "ISA.50.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:4"
      },
      "items": [
        {
          "text": "amathwetsa khutu langa kuti ndimve monga amachitira munthu amene akuphunzira.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.4",
            "verseOrgIds": [
              "ISA.50.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 50:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambuye Yehova wanditsekula makutu anga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.5",
            "verseOrgIds": [
              "ISA.50.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:5"
      },
      "items": [
        {
          "text": "ndipo sindinakhale munthu wowukira",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.5",
            "verseOrgIds": [
              "ISA.50.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:5"
      },
      "items": [
        {
          "text": "ndipo sindinabwerere mʼmbuyo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.5",
            "verseOrgIds": [
              "ISA.50.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 50:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinapereka msana wanga kwa ondimenya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.6",
            "verseOrgIds": [
              "ISA.50.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:6"
      },
      "items": [
        {
          "text": "masaya anga ndinawapereka kwa anthu ondizula ndevu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.6",
            "verseOrgIds": [
              "ISA.50.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:6"
      },
      "items": [
        {
          "text": "sindinawabisire nkhope yanga",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.6",
            "verseOrgIds": [
              "ISA.50.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:6"
      },
      "items": [
        {
          "text": "anthu ondinyoza ndi ondilavulira.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.6",
            "verseOrgIds": [
              "ISA.50.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 50:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Popeza Ambuye Yehova amandithandiza,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.7",
            "verseOrgIds": [
              "ISA.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:7"
      },
      "items": [
        {
          "text": "sindidzachita manyazi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.7",
            "verseOrgIds": [
              "ISA.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:7"
      },
      "items": [
        {
          "text": "Tsono ndalimba mtima ngati msangalabwi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.7",
            "verseOrgIds": [
              "ISA.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:7"
      },
      "items": [
        {
          "text": "chifukwa ndikudziwa kuti sindidzachita manyazi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.7",
            "verseOrgIds": [
              "ISA.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 50:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wondikhalira kumbuyo ali pafupi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.8",
            "verseOrgIds": [
              "ISA.50.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:8"
      },
      "items": [
        {
          "text": "ndaninso amene adzandiyimba mlandu?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.8",
            "verseOrgIds": [
              "ISA.50.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:8"
      },
      "items": [
        {
          "text": "Abwere kuti tionane maso ndi maso!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.8",
            "verseOrgIds": [
              "ISA.50.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:8"
      },
      "items": [
        {
          "text": "Mdani wanga ndi ndani?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.8",
            "verseOrgIds": [
              "ISA.50.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:8"
      },
      "items": [
        {
          "text": "Abweretu kuti tilimbane!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.8",
            "verseOrgIds": [
              "ISA.50.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 50:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambuye Yehova ndiye amene amandithandiza.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.9",
            "verseOrgIds": [
              "ISA.50.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:9"
      },
      "items": [
        {
          "text": "Ndaninso amene adzanditsutsa?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.9",
            "verseOrgIds": [
              "ISA.50.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:9"
      },
      "items": [
        {
          "text": "Onse adzatha ngati chovala",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.9",
            "verseOrgIds": [
              "ISA.50.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:9"
      },
      "items": [
        {
          "text": "chodyedwa ndi njenjete.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.9",
            "verseOrgIds": [
              "ISA.50.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 50:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndani mwa inu amaopa Yehova",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.10",
            "verseOrgIds": [
              "ISA.50.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:10"
      },
      "items": [
        {
          "text": "ndi kumvera mawu a mtumiki wake?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.10",
