  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "61",
        "style": "c",
        "sid": "ISA 61"
      },
      "items": [
        {
          "text": "61",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uthenga Wabwino wa Yehova",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 61:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mzimu wa Ambuye Yehova uli pa ine,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.1",
            "verseOrgIds": [
              "ISA.61.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:1"
      },
      "items": [
        {
          "text": "chifukwa Yehova wandidzoza",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.1",
            "verseOrgIds": [
              "ISA.61.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:1"
      },
      "items": [
        {
          "text": "kuti ndilalikire uthenga wabwino kwa anthu osauka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.1",
            "verseOrgIds": [
              "ISA.61.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:1"
      },
      "items": [
        {
          "text": "Wandituma kuti ndikatonthoze anthu osweka mtima,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.1",
            "verseOrgIds": [
              "ISA.61.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:1"
      },
      "items": [
        {
          "text": "ndikalengeze kwa akapolo kuti alandire ufulu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.1",
            "verseOrgIds": [
              "ISA.61.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:1"
      },
      "items": [
        {
          "text": "ndiponso kuti ndikamasule a mʼndende.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.1",
            "verseOrgIds": [
              "ISA.61.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 61:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wandituma kuti ndikalengeze nthawi imene Yehova adzapulumutsa anthu ake;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.2",
            "verseOrgIds": [
              "ISA.61.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:2"
      },
      "items": [
        {
          "text": "za tsiku limene Yehova adzalanga adani a anthu ake.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.2",
            "verseOrgIds": [
              "ISA.61.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:2"
      },
      "items": [
        {
          "text": "Wandituma kuti ndikatonthoze olira.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.2",
            "verseOrgIds": [
              "ISA.61.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 61:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wandituma kuti ndiwakonzere olira a ku Ziyoni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.3",
            "verseOrgIds": [
              "ISA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:3"
      },
      "items": [
        {
          "text": "nkhata ya maluwa yokongola",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.3",
            "verseOrgIds": [
              "ISA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:3"
      },
      "items": [
        {
          "text": "mʼmalo mwa phulusa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.3",
            "verseOrgIds": [
              "ISA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:3"
      },
      "items": [
        {
          "text": "ndiwapatse mafuta achikondwerero",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.3",
            "verseOrgIds": [
              "ISA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:3"
      },
      "items": [
        {
          "text": "mʼmalo mwa kulira.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.3",
            "verseOrgIds": [
              "ISA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:3"
      },
      "items": [
        {
          "text": "Ndiwapatse chovala cha matamando",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.3",
            "verseOrgIds": [
              "ISA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:3"
      },
      "items": [
        {
          "text": "mʼmalo mwa mtima wopsinjika.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.3",
            "verseOrgIds": [
              "ISA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:3"
      },
      "items": [
        {
          "text": "Ndipo iwo adzatchedwa mitengo ya thundu yamphamvu yachilungamo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.3",
            "verseOrgIds": [
              "ISA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:3"
      },
      "items": [
        {
          "text": "yoyidzala Yehova",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.3",
            "verseOrgIds": [
              "ISA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:3"
      },
      "items": [
        {
          "text": "kuti Iye mwini apezemo ulemerero wake.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.3",
            "verseOrgIds": [
              "ISA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 61:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adzamanganso mabwinja akale a mzinda",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.4",
            "verseOrgIds": [
              "ISA.61.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:4"
      },
      "items": [
        {
          "text": "ndipo malo amene anawonongeka kalekale aja adzakonzanso.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.4",
            "verseOrgIds": [
              "ISA.61.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:4"
      },
      "items": [
        {
          "text": "Adzakonzanso mizinda imene inapasuka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.4",
            "verseOrgIds": [
              "ISA.61.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:4"
      },
      "items": [
        {
          "text": "imene yakhala yowonongeka kwa nthawi yayitali kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.4",
            "verseOrgIds": [
              "ISA.61.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 61:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu achilendo adzakutumikirani; adzazidyetsa ziweto zanu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.5",
            "verseOrgIds": [
              "ISA.61.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:5"
      },
      "items": [
        {
          "text": "iwo adzagwira ntchito mʼminda yanu ya mpesa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.5",
            "verseOrgIds": [
              "ISA.61.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 61:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo inu mudzatchedwa ansembe a Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.6",
            "verseOrgIds": [
              "ISA.61.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:6"
      },
      "items": [
        {
          "text": "adzakutchulani kuti ndinu atumiki a Mulungu wathu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.6",
            "verseOrgIds": [
              "ISA.61.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:6"
      },
      "items": [
        {
          "text": "Mudzadyerera chuma cha mitundu ya anthu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.6",
            "verseOrgIds": [
              "ISA.61.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:6"
      },
      "items": [
        {
          "text": "ndipo mudzanyadira ulemu umene mwalandira.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.6",
            "verseOrgIds": [
              "ISA.61.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 61:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chifukwa manyazi awo anali owirikiza;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.7",
            "verseOrgIds": [
              "ISA.61.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:7"
      },
      "items": [
        {
          "text": "ndi kuti munalandira",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.7",
            "verseOrgIds": [
              "ISA.61.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:7"
      },
      "items": [
        {
          "text": "chitonzo ndi kutukwana,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.7",
            "verseOrgIds": [
              "ISA.61.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:7"
      },
      "items": [
        {
          "text": "adzakondwera ndi cholowa chawo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.7",
            "verseOrgIds": [
              "ISA.61.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:7"
      },
      "items": [
        {
          "text": "tsono adzalandira cholowa chawo cha chigawo cha dziko mowirikiza,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.7",
            "verseOrgIds": [
              "ISA.61.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:7"
      },
      "items": [
        {
          "text": "ndipo chimwemwe chamuyaya chidzakhala chawo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.7",
            "verseOrgIds": [
              "ISA.61.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 61:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pakuti Ine Yehova, ndimakonda chilungamo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.8",
            "verseOrgIds": [
              "ISA.61.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:8"
      },
      "items": [
        {
          "text": "ndimadana ndi zakuba ndi zoyipa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.8",
            "verseOrgIds": [
              "ISA.61.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:8"
      },
      "items": [
        {
          "text": "Anthu anga ndidzawapatsa mphotho mokhulupirika",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.8",
            "verseOrgIds": [
              "ISA.61.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:8"
      },
      "items": [
        {
          "text": "ndikupangana nawo pangano losatha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.8",
            "verseOrgIds": [
              "ISA.61.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 61:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana awo adzakhala odziwika pakati pa mitundu ya anthu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.9",
            "verseOrgIds": [
              "ISA.61.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:9"
      },
      "items": [
        {
          "text": "ndipo adzukulu awo adzakhala otchuka pakati pa anthu a mitundu ina.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.9",
            "verseOrgIds": [
              "ISA.61.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:9"
      },
      "items": [
        {
          "text": "Aliyense wowaona adzazindikira",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.9",
            "verseOrgIds": [
              "ISA.61.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:9"
      },
      "items": [
        {
          "text": "kuti ndi anthu amene Yehova wawadalitsa.\"",
          "type": "text",
          "attrs": {
