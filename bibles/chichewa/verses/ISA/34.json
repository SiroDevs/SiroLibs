  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "34",
        "style": "c",
        "sid": "ISA 34"
      },
      "items": [
        {
          "text": "34",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chiweruzo cha Anthu a Mitundu Yonse",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu anthu a mitundu yonse, bwerani pafupi kuti mumve:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.1",
            "verseOrgIds": [
              "ISA.34.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:1"
      },
      "items": [
        {
          "text": "tcherani khutu, inu anthu a mitundu ina yonse:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.1",
            "verseOrgIds": [
              "ISA.34.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 34:1"
      },
      "items": [
        {
          "text": "Limvetsere dziko lapansi pamodzi ndi zonse zili mʼmenemo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.1",
            "verseOrgIds": [
              "ISA.34.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:1"
      },
      "items": [
        {
          "text": "dziko lonse pamodzi ndi zonse zochokera mʼmenemo!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.1",
            "verseOrgIds": [
              "ISA.34.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wayipidwa ndi anthu a mitundu yonse;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.2",
            "verseOrgIds": [
              "ISA.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:2"
      },
      "items": [
        {
          "text": "wapsera mtima magulu awo onse ankhondo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.2",
            "verseOrgIds": [
              "ISA.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 34:2"
      },
      "items": [
        {
          "text": "Iye adzawawononga kotheratu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.2",
            "verseOrgIds": [
              "ISA.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:2"
      },
      "items": [
        {
          "text": "nawapereka kuti aphedwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.2",
            "verseOrgIds": [
              "ISA.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu awo ophedwa adzatayidwa kunja,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.3",
            "verseOrgIds": [
              "ISA.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:3"
      },
      "items": [
        {
          "text": "mitembo yawo idzawola ndi kununkha;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.3",
            "verseOrgIds": [
              "ISA.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:3"
      },
      "items": [
        {
          "text": "mapiri adzafiira ndi magazi awo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.3",
            "verseOrgIds": [
              "ISA.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzuwa, mwezi ndi nyenyezi zidzasungunuka",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.4",
            "verseOrgIds": [
              "ISA.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:4"
      },
      "items": [
        {
          "text": "ndipo mlengalenga mudzakulungidwa ngati chipepala;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.4",
            "verseOrgIds": [
              "ISA.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 34:4"
      },
      "items": [
        {
          "text": "nyenyezi zonse zidzayoyoka",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.4",
            "verseOrgIds": [
              "ISA.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:4"
      },
      "items": [
        {
          "text": "ngati masamba ofota a mphesa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.4",
            "verseOrgIds": [
              "ISA.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:4"
      },
      "items": [
        {
          "text": "ngati masamba onyala a mtengo wa mkuyu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.4",
            "verseOrgIds": [
              "ISA.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova akuti, \"Lupanga langa lakhutiratu magazi kumwamba;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.5",
            "verseOrgIds": [
              "ISA.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:5"
      },
      "items": [
        {
          "text": "taonani, likutsika kudzalanga anthu a ku Edomu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.5",
            "verseOrgIds": [
              "ISA.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:5"
      },
      "items": [
        {
          "text": "anthu amene ndawawononga kotheratu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.5",
            "verseOrgIds": [
              "ISA.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lupanga la Yehova lakhuta magazi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.6",
            "verseOrgIds": [
              "ISA.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:6"
      },
      "items": [
        {
          "text": "lakutidwa ndi mafuta;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.6",
            "verseOrgIds": [
              "ISA.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 34:6"
      },
      "items": [
        {
          "text": "magazi a ana ankhosa onenepa ndi ambuzi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.6",
            "verseOrgIds": [
              "ISA.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:6"
      },
      "items": [
        {
          "text": "mafuta a ku impsyo za nkhosa zazimuna.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.6",
            "verseOrgIds": [
              "ISA.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 34:6"
      },
      "items": [
        {
          "text": "Pakuti Yehova ali ndi nsembe mu Bozira",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.6",
            "verseOrgIds": [
              "ISA.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:6"
      },
      "items": [
        {
          "text": "ndiko kuphedwa kwa anthu ambiri mʼdziko la Edomu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.6",
            "verseOrgIds": [
              "ISA.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamodzi ndi anthuwo zidzaphedwanso njati,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.7",
            "verseOrgIds": [
              "ISA.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:7"
      },
      "items": [
        {
          "text": "ngʼombe zazimuna zazingʼono ndi zazikulu zomwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.7",
            "verseOrgIds": [
              "ISA.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 34:7"
      },
      "items": [
        {
          "text": "Dziko lawo lidzakhala magazi okhaokha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.7",
            "verseOrgIds": [
              "ISA.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:7"
      },
      "items": [
        {
          "text": "ndipo nthaka idzakutidwa ndi mafuta.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.7",
            "verseOrgIds": [
              "ISA.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyi ndi nthawi imene Yehova adzalipsira",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.8",
            "verseOrgIds": [
              "ISA.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:8"
      },
      "items": [
        {
          "text": "ndi kulanga adani a Ziyoni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.8",
            "verseOrgIds": [
              "ISA.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madzi a mʼmitsinje ya Edomu adzasanduka phula,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.9",
            "verseOrgIds": [
              "ISA.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:9"
      },
      "items": [
        {
          "text": "ndipo fumbi lake lidzasanduka sulufule;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.9",
            "verseOrgIds": [
              "ISA.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:9"
      },
      "items": [
        {
          "text": "dziko lake lidzasanduka phula lamoto!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.9",
            "verseOrgIds": [
              "ISA.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motowo sudzazimitsidwa usiku ndi usana;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.10",
            "verseOrgIds": [
              "ISA.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:10"
      },
      "items": [
        {
          "text": "utsi wake udzafuka kosalekeza.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.10",
            "verseOrgIds": [
              "ISA.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 34:10"
      },
      "items": [
        {
          "text": "Dzikolo lidzakhala chipululu pa mibado ndi mibado;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.10",
            "verseOrgIds": [
              "ISA.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:10"
      },
      "items": [
        {
          "text": "palibe ndi mmodzi yemwe amene adzadutsemo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.10",
            "verseOrgIds": [
              "ISA.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼdzikomo mudzakhala akabawi ndi anungu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.11",
            "verseOrgIds": [
              "ISA.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:11"
      },
      "items": [
        {
          "text": "amantchichi ndi akhwangwala adzapanga zisa zawo mʼmenemo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.11",
            "verseOrgIds": [
              "ISA.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 34:11"
      },
      "items": [
        {
          "text": "Mulungu adzatambalitsa pa Edomu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.11",
            "verseOrgIds": [
              "ISA.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 34:11"
      },
      "items": [
        {
          "text": "chingwe choyezera cha chisokonezo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.11",
            "verseOrgIds": [
              "ISA.34.11"
            ]
          }
        }
