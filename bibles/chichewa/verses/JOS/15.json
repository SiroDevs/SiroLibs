  "verseCount": 63,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "JOS 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dziko Limene Yuda Analandira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chigawo cha dzikolo chimene mabanja a fuko la Yuda analandira chinafika ku malire ndi Edomu mpaka ku chipululu cha Zini kummwera kwenikweni.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.1",
            "verseOrgIds": [
              "JOS.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malire awo a kummwera anayambira kummwera kwenikweni kwa Nyanja ya Mchere,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kudutsa cha kummwera ku Akirabimu, nʼkupitirira mpaka ku Zini. Kuchokera pamenepo nʼkumapita cha kummwera kwa Kadesi Barinea, kudutsa Hezironi mpaka ku Adari ndi kutembenuka mpaka ku Karika.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anapitirira mpaka ku Azimoni motsata mtsinje umene uli malire a Igupto mpaka ku nyanja. Awa ndiwo malire awo a kummwera.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malire a kummawa anali Nyanja Yakufa mpaka kumene Yorodani amathira mu Nyanja ya Mchere.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JOS 15:5"
      },
      "items": [
        {
          "text": "Malire a kumpoto anayambira kumene Yorodani amathirira nyanjayo,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "napitirira mpaka ku Beti-Hogila ndi kupitirira kumpoto mpaka ku Beti-Araba. Anapitirira mpaka anakafika ku Mwala wa Bohani.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo malirewo anachokeranso ku chigwa cha Akori mpaka ku Debri, kuchokera ku chigwa cha Akori ndi kutembenukira kumpoto ku Giligala, dera limene linayangʼanana ndi msewu wa Adumimu kummwera kwa chigwa. Anapitirira mpaka ku madzi a ku Eni Semesi ndi kutulukira ku Eni Rogeli.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo anapitirira mpaka ku chigwa cha Hinomu mbali ya kummwera kwa mzinda wa Ayebusi (mzinda wa Yerusalemu). Kuchokera kumeneko anakwera mpaka pamwamba pa phiri kumadzulo kwa chigwa cha Hinomu cha kumpoto kwenikweni kwa chigwa cha Refaimu.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo anachokeranso pamwamba pa phiri, kukafika mpaka ku akasupe a ku Nepitowa, nadzatulukira ku mizinda ya phiri la Efroni, ndi kutsikira ku Baalahi (ndiye Kiriati Yearimu).",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchokera kumeneko anazungulira cha kumadzulo ku Baalahi mpaka ku phiri la Seiri. Anapitirira cha kumpoto kutsata phiri la Yearimu (lomwe ndi Kesaloni). Anapitirirabe kutsika ku Beti Semesi ndi kuwolokera ku Timna.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malirewo anapitirira kumatsitso a mapiri chakumpoto kwa Ekroni, ndi kukhotera ku Sikeroni. Malirewo anadutsa phiri la Baalahi ndi kufika ku Yabineeli. Malirewo anathera ku nyanja.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malire a mbali ya kumadzulo anali Nyanja Yayikulu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "JOS 15:12"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "JOS 15:12"
      },
      "items": [
        {
          "text": "Awa ndi malire ozungulira malo amene anapatsidwa kwa mabanja a fuko la Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.12",
            "verseOrgIds": [
              "JOS.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Potsata lamulo la Yehova, Yoswa anapereka kwa Kalebe mwana wa Yefune gawo lina la dziko la Yuda dera la Kiriati Ariba, limene ndi Hebroni. (Ariba anali gogo wa Aanaki).",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.13",
            "verseOrgIds": [
              "JOS.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchokera ku Hebroni, Kalebe anathamangitsamo mafuko a Aanaki awa: Sesai, Ahimani ndi Talimai, zidzukulu za Aanaki.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.14",
            "verseOrgIds": [
              "JOS.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchokera kumeneko, Kalebe anakathira nkhondo anthu amene ankakhala ku Debri (mzindawu poyamba unkatchedwa Kiriati Seferi).",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.15",
            "verseOrgIds": [
              "JOS.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Kalebe anati, \"Munthu amene angathire nkhondo mzinda wa Kiriati Seferi ndi kuwulanda, ndidzamupatsa mwana wanga Akisa kuti akhale mkazi wake.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.16",
            "verseOrgIds": [
              "JOS.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otanieli, mwana wa mʼbale wa Kalebe, Kenazi, ndiye anawulanda. Choncho Kalebe anamupatsa mwana wake Akisa kuti akhale mkazi wake.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.17",
            "verseOrgIds": [
              "JOS.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku lina atafika Akisayo, Otanieli anamuwumiriza mkazi wakeyo kuti apemphe munda kwa Kalebe abambo ake. Pamene Akisa anatsika pa bulu wake, Kalebe anamufunsa kuti, \"Kodi ukufuna ndikuchitire chiyani.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.18",
            "verseOrgIds": [
              "JOS.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anayankha kuti \"Mundikomere mtima. Popeza mwandipatsa ku Negevi, kumalo kumene kulibe madzi, mundipatsenso akasupe amadzi.\" Choncho Kalebe anamupatsa akasupe a kumtunda ndi a kumunsi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.19",
            "verseOrgIds": [
              "JOS.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dziko limene mabanja a fuko la Yuda analandira ngati cholowa chawo ndi ili:",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.20",
            "verseOrgIds": [
              "JOS.15.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mizinda yakummwera kwenikweni kwa fuko la Yuda yoyandikana ndi malire a Edomu anali:",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.21",
            "verseOrgIds": [
              "JOS.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JOS 15:21"
      },
      "items": [
        {
          "text": "Kabizeeli, Ederi, Yaguri",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kina, Dimona, Adada",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kedesi, Hazori, Itinani",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zifi, Telemu, Bealoti,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazori-Hadata, Keriyoti Hezironi (ndiye kuti Hazori)",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amamu, Sema, Molada",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazari-Gada, Hesimoni, Beti-Peleti",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazari-Suwali, Beeriseba, Biziotiya,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baalahi, Iyimu, Ezemu",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elitoladi, Kesili, Horima",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zikilagi, Madimena, Sanisana,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lebaoti, Silihimu, Aini ndi Rimoni. Mizinda yonse inalipo 29 pamodzi ndi midzi yake yozungulira.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mizinda ya ku chigwa cha kumadzulo ndi iyi:",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.33",
            "verseOrgIds": [
              "JOS.15.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JOS 15:33"
      },
      "items": [
        {
          "text": "Esitaoli, Zora, Asina",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOS 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zanowa, Eni-Ganimu, Tapuwa, Enamu,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yarimuti, Adulamu, Soko, Azeka,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JOS 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saaraimu, Aditaimu, ndi Gederi (kapena Gederotaimu). Mizinda yonse inalipo 14 pamodzi ndi midzi yake yozungulira.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JOS 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mizinda ina inali iyi: Zenani, Hadasa, Migidali-Gadi,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JOS 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dileani, Mizipa, Yokiteeli,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JOS 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakisi, Bozikati, Egiloni,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JOS 15:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaboni, Lahimasi, Kitilisi,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JOS 15:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gederoti, Beti-Dagoni, Naama ndi Makeda. Mizinda yonse pamodzi inalipo 16 pamodzi ndi midzi yake yozungulira.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JOS 15:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mizinda ina inali iyi: Libina, Eteri, Asani,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JOS 15:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifita, Asina, Nezibu,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JOS 15:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keila, Akizibu ndi Maresa, mizinda isanu ndi inayi pamodzi ndi midzi yake.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JOS 15:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panalinso Ekroni pamodzi ndi midzi yake;",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JOS 15:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "komanso yonse imene inali mʼmbali mwa Asidodi ndi midzi yake kuyambira ku Ekroni mpaka ku Nyanja Yayikulu.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JOS 15:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panalinso mizinda ya Asidodi ndi Gaza pamodzi ndi midzi yawo. Malire ake anafika ku mtsinje wa Igupto mpaka ku Nyanja Yayikulu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JOS 15:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mizinda ya kumapiri inali:",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.48",
            "verseOrgIds": [
              "JOS.15.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JOS 15:48"
      },
      "items": [
        {
          "text": "Samiri, Yatiri, Soko,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JOS 15:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dana, Kiriati-Sana, (ndiye kuti Debri)",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JOS 15:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anabu, Esitemo, Animu,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JOS 15:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Goseni, Holoni ndi Gilo. Mizinda yonse pamodzi inali khumi ndi umodzi pamodzi ndi midzi yake.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "JOS 15:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Analandiranso mizinda iyi: Arabu, Duma, Esani,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "JOS 15:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yanumu, Beti-Tapuwa, Afeki",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "JOS 15:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Humita, Kiriati-Ariba (ndiye kuti Hebroni) ndi Ziori, mizinda isanu ndi inayi pamodzi ndi midzi yake.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "JOS 15:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panalinso Maoni, Karimeli, Zifi, Yuta",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "JOS 15:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yezireeli, Yokideamu, Zanowa,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "JOS 15:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaini, Gibeya ndi Timna, mizinda khumi ndi midzi yake.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "JOS 15:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mizinda ina inali: Halihuli, Beti Zuri, Gedori,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "JOS 15:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maarati, Beti-Anoti ndi Elitekoni, mizinda isanu ndi umodzi pamodzi ndi midzi yake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "60",
            "style": "v",
            "sid": "JOS 15:60"
          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panalinso Kiriati Baala (ndiye kuti Kiriati Yearimu) ndi Raba; mizinda iwiri pamodzi ndi midzi yake.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "61",
            "style": "v",
            "sid": "JOS 15:61"
          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mizinda ya ku chipululu inali iyi:",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.61",
            "verseOrgIds": [
              "JOS.15.61"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JOS 15:61"
      },
      "items": [
        {
          "text": "Beti-Araba, Midini, Sekaka,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "JOS 15:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibisani, Mzinda wa Mchere ndi Eni Gedi, mizinda isanu ndi umodzi pamodzi ndi midzi yake.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "63",
            "style": "v",
            "sid": "JOS 15:63"
          },
          "items": [
            {
              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Yuda sanathe kuthamangitsa Ayebusi amene amakhala ku Yerusalemu, ndipo mpaka lero Ayebusi akukhala komweko pamodzi ndi Ayudawo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.63",
            "verseOrgIds": [
              "JOS.15.63"
            ]
          }
        }
      ]
    }
  ],
