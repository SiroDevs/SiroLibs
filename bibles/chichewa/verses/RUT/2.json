  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "RUT 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rute Akumana ndi Bowazi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "RUT 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naomi anali ndi mʼbale wake wolemera kwambiri wochokera ku banja la mwamuna wake Elimeleki, dzina lake Bowazi.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.1",
            "verseOrgIds": [
              "RUT.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "RUT 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku lina Rute, Mmowabu uja anati kwa Naomi, \"Mundilole kuti ndikakunkhe barele ku munda wa munthu aliyense amene akandikomere mtima.\" Naomi anati kwa iye, \"Pita mwana wanga.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.2",
            "verseOrgIds": [
              "RUT.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "RUT 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Rute ananyamuka kupita kukakunkha ku minda yokololedwa kale. Tsono zinangochitika kuti Rute anafika mʼmunda wa Bowazi, yemwe anali wochokera ku banja la Elimeleki.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.3",
            "verseOrgIds": [
              "RUT.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "RUT 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Posakhalitsa Bowazi anafika kuchokera ku Betelehemu ndipo analonjera okolola aja kuti, \"Yehova akhale nanu!\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.4",
            "verseOrgIds": [
              "RUT.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "RUT 2:4"
      },
      "items": [
        {
          "text": "Iwo anayankha kuti, \"Yehova akudalitseni.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.4",
            "verseOrgIds": [
              "RUT.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "RUT 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bowazi anafunsa kapitawo wake amene ankayangʼanira okolola aja kuti, \"Mayi uyo ndi ndani?\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.5",
            "verseOrgIds": [
              "RUT.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "RUT 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapitawo uja anayankha kuti, \"Mayiyu ndi Mmowabu amene anabwera ndi Naomi kuchokera ku dziko la Mowabu.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.6",
            "verseOrgIds": [
              "RUT.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "RUT 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anandipempha kuti, 'Chonde mundilole kuti ndikunkhe barele mʼminda moti akololamo kale.' Iye wakhala akukunkha kuyambira mmawa mpaka tsopano lino osapuma nʼpangʼono pomwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.7",
            "verseOrgIds": [
              "RUT.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "RUT 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Bowazi anati kwa Rute, \"Tamvera mwana wanga, usapite kukakunkha mʼmunda wina, ndipo usachoke mʼmunda uno. Koma uzitsata adzakazi angawa.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.8",
            "verseOrgIds": [
              "RUT.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "RUT 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uziyangʼana munda akukolola anyamatawo akamakolola mʼmundamu, ndipo iwe uzitsata pambuyo pawo. Ndawawuza anyamatawo kuti asakuvutitse. Ndipo ukamva ludzu, uzipita ku mitsuko ndi kukamwa madzi amene anyamatawa atunga.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.9",
            "verseOrgIds": [
              "RUT.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "RUT 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atamva zimenezi Rute anawerama nazolikitsa nkhope yake pansi. Kenaka anafunsa kuti, \"Mwandikomera mtima chotere mlendo ngati ine chifukwa chiyani?\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.10",
            "verseOrgIds": [
              "RUT.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "RUT 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bowazi anayankha kuti, \"Ine ndawuzidwa zonse zimene wakhala ukuchitira apongozi ako chimwalirire mwamuna wako. Ndamvanso kuti unasiya abambo ndi amayi ako komanso dziko la kwanu ndi kubwera kudzakhala ndi anthu amene sumawadziwa ndi kale lonse.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.11",
            "verseOrgIds": [
              "RUT.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "RUT 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova akubwezere pa zimene wachitazi. Yehova Mulungu wa Israeli, amene wabwera pansi pa mapiko ake kuti akuteteze, akupatse mphotho yayikulu.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.12",
            "verseOrgIds": [
              "RUT.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "RUT 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rute anati, \"Mwandikomera mtima, mbuye wanga. Ndipo mwandisangalatsa ndi kundiyankhula mwa chifundo ngakhale sindili mmodzi mwa adzakazi anu.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.13",
            "verseOrgIds": [
              "RUT.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "RUT 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthawi ya chakudya cha masana Bowazi anati kwa iye, \"Bwera kuno, utenge buledi ndi kusunsa nthongo mu vinyo.\" Choncho anakhala pansi pafupi ndi okololawo, ndipo Bowazi anamupatsa chakudya ndi nyama yowotcha. Anadya chilichonse amafuna ndipo chakudya china chinatsalako.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.14",
            "verseOrgIds": [
              "RUT.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "RUT 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atanyamuka kuti azikakunkha, Bowazi analangiza anyamata ake kuti, \"Ngakhale mayiyu azikunkha pakati pa mitolo musamuletse ndi kumuchititsa manyazi.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.15",
            "verseOrgIds": [
              "RUT.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "RUT 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma muzimusololerako ngala zina za mʼmitolo ndi kumusiyira kuti azikunkha ndipo musamukalipire.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.16",
            "verseOrgIds": [
              "RUT.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "RUT 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Rute anakunkha mʼmundamo mpaka madzulo. Kenaka anapuntha barele anakunkhayo, ndipo anakwanira pafupifupi makilogalamu khumi.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.17",
            "verseOrgIds": [
              "RUT.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "RUT 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anasenza barele uja kupita naye ku mudzi, nakaonetsa apongozi ake. Kenaka anatulutsa chakudya chimene chinatsalira atakhuta chija ndi kupatsa apongozi ake.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.18",
            "verseOrgIds": [
              "RUT.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "RUT 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apongozi akewo anamufunsa kuti, \"Kodi lero unakakunkha kuti? Unakagwira kuti ntchitoyi? Adalitsike munthu amene anakukomera mtimayo.\" Ndipo Rute anawuza mpongozi wake za munthu amene ku malo ake anakagwirako ntchito. Iye anati, \"Munthuyo dzina lake ndi Bowazi.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.19",
            "verseOrgIds": [
              "RUT.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "RUT 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naomi anati kwa mpongozi wakeyo, \"Munthu ameneyu amudalitse Yehova, amene sanasiye kuchitira chifundo anthu amoyo ndi akufa omwe. Anatinso munthu ameneyu ndi mnansi wapaphata. Ndiye ali ndi udindo wotisamalira.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.20",
            "verseOrgIds": [
              "RUT.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "RUT 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Rute Mmowabuyo anati, \"Iye anandiwuzanso kuti, 'Uzitsata antchito angawa mpaka atamaliza kukolola munda wonse.' \"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.21",
            "verseOrgIds": [
              "RUT.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "RUT 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naomi anati kwa Rute mpongozi wake, \"Kuli bwino mwana wanga kuti uzipita ndi adzakazi ake kuopa kuti mʼmunda wa munthu wina angakuvute.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.22",
            "verseOrgIds": [
              "RUT.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "RUT 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Rute ankatsatira adzakazi a Bowazi namakunkha mpaka anthu atamaliza kudula barele ndi tirigu. Ndipo amakhalabe ndi mpongozi wakeyo.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.23",
            "verseOrgIds": [
              "RUT.2.23"
            ]
          }
        }
      ]
    }
  ],
