  "verseCount": 44,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "2KI 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mafuta a Mkazi Wamasiye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkazi wa mmodzi mwa ana a aneneri anafuwula kwa Elisa kuti, \"Mtumiki wanu, mwamuna wanga wamwalira ndipo inu mukudziwa kuti ankaopa Yehova. Koma tsopano munthu amene mwamuna wanga anakongolako zinthu zake, akubwera kudzatenga ana anga awiri aamuna kuti akhale akapolo ake.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.1",
            "verseOrgIds": [
              "2KI.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa anayankha mayiyo kuti, \"Kodi ufuna ndikuchitire chiyani? Tandiwuza uli ndi chiyani mʼnyumba mwako?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.2",
            "verseOrgIds": [
              "2KI.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 4:2"
      },
      "items": [
        {
          "text": "Mayiyo anayankha kuti, \"Mdzakazi wanu alibe kanthu kalikonse koma timafuta pangʼono chabe.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.2",
            "verseOrgIds": [
              "2KI.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa anati, \"Pita kabwereke mitsuko yonse yopanda kanthu kwa anzako. Usakabwereke mitsuko yochepa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.3",
            "verseOrgIds": [
              "2KI.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka ukalowe mʼnyumba mwako ndi kudzitsekera iwe ndi ana ako. Mukakatero mukakhuthulire mafuta mʼmitsuko yonseyo, ndipo mtsuko uliwonse ukadzaza muzikawuyika pambali.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.4",
            "verseOrgIds": [
              "2KI.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayi uja anachoka kwa Elisa nakadzitsekera ndi ana ake. Anthu anabweretsa mitsuko kwa iye ndipo ankathiramo mafuta.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.5",
            "verseOrgIds": [
              "2KI.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mitsuko yonse itadzaza, mayiyo anawuza mwana wake kuti, \"Bweretsa mtsuko wina.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.6",
            "verseOrgIds": [
              "2KI.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 4:6"
      },
      "items": [
        {
          "text": "Koma iye anayankha kuti, \"Mitsuko yonse yatha.\" Pamenepo mafuta analeka kutuluka.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.6",
            "verseOrgIds": [
              "2KI.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayiyo anapita nakamuwuza munthu wa Mulungu amene anamuyankha kuti, \"Pita, kagulitse mafutawo ndipo ukabweze ngongole ija. Ndalama zotsalazo zikakhale zako ndi ana ako.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.7",
            "verseOrgIds": [
              "2KI.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Elisa Aukitsa Mwana wa Mayi wa ku Sunemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku lina Elisa anapita ku Sunemu. Kumeneko kunkakhala mayi wina wachuma amene anawumiriza Elisa kuti adye chakudya. Choncho nthawi iliyonse imene Elisa amadutsa kumeneko, ankayima ndi kudya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.8",
            "verseOrgIds": [
              "2KI.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayiyo anawuza mwamuna wake kuti, \"Taonani, ine ndikudziwa kuti munthu amene amadutsa pano nthawi zambiriyu ndi munthu woyera wa Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.9",
            "verseOrgIds": [
              "2KI.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyeni timumangire kachipinda kakangʼono pa denga la nyumbayi ndi kumuyikiramo bedi ndi tebulo, mpando ndi nyale. Akabwera kuno azikhala mʼmenemo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.10",
            "verseOrgIds": [
              "2KI.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku lina pamene Elisa anafika ku Sunemu, iye anakalowa mʼchipinda chake chija nagona mʼmenemo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.11",
            "verseOrgIds": [
              "2KI.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anati kwa mtumiki wake Gehazi, \"Muyitane Msunemuyu.\" Ndipo anapita kukamuyitana mayiyo, ndipo anabwera nayima pamaso pa Elisa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.12",
            "verseOrgIds": [
              "2KI.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa anati kwa Gehazi, \"Muwuze mayiyo kuti, 'Wavutika potichitira zonsezi. Nanga tsopano ifeyo tikuchitire chiyani? Kodi ukufuna kuti tikadziwitse mfumu kapena mtsogoleri wa ankhondo zimene watichitirazi?' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.13",
            "verseOrgIds": [
              "2KI.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 4:13"
      },
      "items": [
        {
          "text": "Mayiyo anayankha kuti, \"Ine ndimakhala mwamtendere pakati pa abale anga.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.13",
            "verseOrgIds": [
              "2KI.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa anafunsanso Gehazi kuti, \"Kodi tingamuchitire chiyani?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.14",
            "verseOrgIds": [
              "2KI.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 4:14"
      },
      "items": [
        {
          "text": "Gehazi anati, \"Ndithu, mayiyu alibe mwana ndipo mwamuna wake ndi wokalamba.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.14",
            "verseOrgIds": [
              "2KI.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Elisa anati, \"Muyitane.\" Choncho Gehazi anamuyitana, ndipo iye anabwera nayima pa khomo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.15",
            "verseOrgIds": [
              "2KI.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa anati kwa mayiyo, \"Nthawi ngati yomwe ino chaka chamawa, udzakhala utanyamula mwana wamwamuna mʼmanja mwako.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.16",
            "verseOrgIds": [
              "2KI.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 4:16"
      },
      "items": [
        {
          "text": "Mayiyo anatsutsa zimenezi nanena kuti, \"Ayi mbuye wanga. Inu munthu wa Mulungu, musanamize mdzakazi wanu!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.16",
            "verseOrgIds": [
              "2KI.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma mayi uja anakhala woyembekezera, ndipo chaka chotsatiracho, nthawi ngati yomweyo anabereka mwana wamwamuna monga momwe Elisa anamuwuzira.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.17",
            "verseOrgIds": [
              "2KI.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana uja anakula, ndipo tsiku lina anapita kwa abambo ake amene anali ndi anthu odula tirigu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.18",
            "verseOrgIds": [
              "2KI.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanayo anafuwula kwa abambo ake kuti, \"Mayo! Mutu wanga ine! Mayo! Mutu wanga ine!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.19",
            "verseOrgIds": [
              "2KI.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 4:19"
      },
      "items": [
        {
          "text": "Abambo akewo anawuza wantchito wake kuti, \"Munyamule ndi kukamupereka kwa amayi ake.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.19",
            "verseOrgIds": [
              "2KI.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wantchito uja atamunyamula ndi kumupereka kwa amayi ake. Mwanayo anakhala pa miyendo ya amayi akeyo mpaka masana, ndipo pambuyo pake anamwalira.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.20",
            "verseOrgIds": [
              "2KI.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayiyo ananyamula mwanayo nakamugoneka pa bedi la munthu wa Mulungu uja. Kenaka anatseka chitseko iye nʼkuchokapo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.21",
            "verseOrgIds": [
              "2KI.4.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anayitanitsa mwamuna wake namuwuza kuti, \"Tumizireni wantchito mmodzi ndi bulu mmodzi kuti ndipite mofulumira kwa munthu wa Mulungu nʼkubwererako.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.22",
            "verseOrgIds": [
              "2KI.4.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwamuna wakeyo anafunsa kuti, \"Chifukwa chiyani ukupita kwa iyeyo lero? Lero si tsiku la Chikondwerero cha Mwezi Watsopano kapena tsiku la Sabata.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.23",
            "verseOrgIds": [
              "2KI.4.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 4:23"
      },
      "items": [
        {
          "text": "Mayiyo anayankha kuti, \"Zonse zili bwino.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.23",
            "verseOrgIds": [
              "2KI.4.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayiyo anamangirira chishalo pa bulu ndipo anawuza wantchito wake kuti, \"Yendetsa bulu mofulumira. Usachepetse liwiro pokhapokha nditakuwuza.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.24",
            "verseOrgIds": [
              "2KI.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho ananyamuka nakafika kwa munthu wa Mulungu uja ku Phiri la Karimeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.25",
            "verseOrgIds": [
              "2KI.4.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 4:25"
      },
      "items": [
        {
          "text": "Munthu wa Mulungu ataona mayiyo patali, anawuza mtumiki wake Gehazi kuti, \"Taona! Msunemu uyo!",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.25",
            "verseOrgIds": [
              "2KI.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thamanga msanga ukakumane naye ndipo ukamufunse kuti, 'Kodi muli bwino? Kodi mwamuna wanu ali bwino? Kodi mwana wanu ali bwino?' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.26",
            "verseOrgIds": [
              "2KI.4.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 4:26"
      },
      "items": [
        {
          "text": "Mayiyo anayankha kuti, \"Zonse zili bwino.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.26",
            "verseOrgIds": [
              "2KI.4.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atafika kwa munthu wa Mulunguyo pa phiripo, mayiyo anagwira mapazi a Elisa. Gehazi anabwera kuti amukankhe, koma munthu wa Mulungu anati, \"Musiye! Iyeyu ali pa mavuto aakulu, koma Yehova wandibisira zimenezi ndipo sanandiwuze chifukwa chake.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.27",
            "verseOrgIds": [
              "2KI.4.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono mayiyo anati, \"Mbuye wanga, kodi ine ndinakupemphani mwana? Kodi sindinakuwuzeni kuti musandinamize?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.28",
            "verseOrgIds": [
              "2KI.4.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa anawuza Gehazi kuti, \"Manga lamba mʼchiwuno mwako, tenga ndodo yanga mʼdzanja lako ndipo thamanga. Ngati ukumana ndi munthu wina aliyense, usamupatse moni, ndipo ngati wina akupatsa moni, usayankhe. Ukagoneke ndodo yanga pa nkhope ya mwanayo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.29",
            "verseOrgIds": [
              "2KI.4.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma mayi wake wa mwana uja anati, \"Pali Yehova wamoyo ndiponso pali inu nomwe, ineyo sindidzakusiyani.\" Choncho Elisa ananyamuka natsatira mayiyo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.30",
            "verseOrgIds": [
              "2KI.4.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gehazi anatsogola nakagoneka ndodoyo pa nkhope ya mwanayo, koma sipanamveke mawu kapena kugwedezeka kuonetsa kuti ali moyo. Choncho Gehazi anabwerera kukakumana ndi Elisa ndipo anamuwuza kuti, \"Mwanayo sanatsitsimuke.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.31",
            "verseOrgIds": [
              "2KI.4.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Elisa atafika ku nyumbako, taonani, mwanayo anali wakufa atamugoneka pa bedi lake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.32",
            "verseOrgIds": [
              "2KI.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa analowa mʼnyumbamo natseka chitseko. Anali awiri okha mʼchipindamo ndipo iye anapemphera kwa Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.33",
            "verseOrgIds": [
              "2KI.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka anakwera pa bedi ndi kumugonera mwanayo, pakamwa pake panakhudzana ndi pakamwa pa mwanayo, maso ake anakhudzana ndi maso a mwanayo, ndipo manja ake anakhudzana ndi manja a mwanayo. Pamene ankadzitambalitsa yekha pa mwanayo, thupi la mwanayo linayamba kufunda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.34",
            "verseOrgIds": [
              "2KI.4.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa anatembenuka nayenda uku ndi uku kamodzi mʼchipindamo ndipo kenaka anakweranso pa bedi nagoneranso mwanayo. Mwanayo anayetsemula kasanu ndi kawiri ndipo anatsekula maso ake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.35",
            "verseOrgIds": [
              "2KI.4.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa anayitana Gehazi ndipo anati, \"Muyitane Msunemuyo.\" Ndipo anaterodi. Mayiyo atabwera, Elisa anati, \"Tenga mwana wako.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.36",
            "verseOrgIds": [
              "2KI.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayiyo analowa, nagwada pa mapazi a Elisa, naweramitsa mutu wake pansi. Kenaka ananyamula mwana wake natuluka.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.37",
            "verseOrgIds": [
              "2KI.4.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Imfa mu Mʼphika",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2KI 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa anabwerera ku Giligala ndipo ku dera limenelo kunali njala. Elisa akukumana ndi ana a aneneri, anati kwa mtumiki wake, \"Ika mʼphika waukulu pa moto ndipo uwaphikire chakudya anthu awa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.38",
            "verseOrgIds": [
              "2KI.4.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2KI 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmodzi mwa ana aneneriwo anapita kuthengo kukafuna ndiwo ndipo anakapeza mpesa wakuthengo. Iye anathyolako zipatso zake nadzaza nsalu yake. Atabwerera, anazidula zipatsozo naziyika mu mʼphika, ngakhale kuti panalibe amene ankazidziwa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.39",
            "verseOrgIds": [
              "2KI.4.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "2KI 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anawapakulira anthu chakudyacho, koma atayamba kudya, anthuwo anafuwula kuti, \"Inu munthu wa Mulungu muli imfa mu mʼphikamu!\" Ndipo sakanatha kudya chakudyacho.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.40",
            "verseOrgIds": [
              "2KI.4.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "2KI 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa anati, \"Bweretsani ufa.\" Iye anathira ufa mu mʼphikamo ndipo anati, \"Perekani chakudyachi kwa anthu kuti adye.\" Ndipo mu mʼphikamo munalibenso zoopsa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.41",
            "verseOrgIds": [
              "2KI.4.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kudyetsa Anthu 100",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "2KI 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthu wina wochokera ku Baala-Salisa anabwera atamutengera munthu wa Mulungu malofu a barele makumi awiri opangidwa kuchokera ku zokolola zoyamba kucha, pamodzinso ndi ngala zatsopano za tirigu. Elisa anati kwa munthuyo, \"Apatse anthu kuti adye.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.42",
            "verseOrgIds": [
              "2KI.4.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "2KI 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtumiki wake anafunsa kuti, \"Kodi ndikachigawe motani chakudyachi kwa anthu 100?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.43",
            "verseOrgIds": [
              "2KI.4.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 4:43"
      },
      "items": [
        {
          "text": "Koma Elisa anamuwuzanso kuti, \"Apatse anthu adye. Pakuti izi ndi zimene Yehova akunena kuti, 'Iwo adzadya chakudyachi ndipo china chidzatsalako.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.43",
            "verseOrgIds": [
              "2KI.4.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "2KI 4:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono iye anachipereka kwa anthuwo ndipo anadya china nʼkutsalako, molingana ndi mawu a Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.44",
            "verseOrgIds": [
              "2KI.4.44"
            ]
          }
        }
      ]
    }
  ],
