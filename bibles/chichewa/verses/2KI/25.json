  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "2KI 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho mʼchaka chachisanu ndi chinayi cha ulamuliro wa Zedekiya, mwezi wakhumi, pa tsiku lakhumi la mwezi, Nebukadinezara mfumu ya Babuloni anabwera ndi gulu lake lonse la ankhondo, nadzathira nkhondo mzinda wa Yerusalemu. Iye anamanga misasa kunja kwa mzindawo ndipo anamanga mitumbira ya nkhondo kuzungulira mzindawo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.1",
            "verseOrgIds": [
              "2KI.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mzindawo anawuzinga mpaka chaka cha khumi ndi chimodzi cha Mfumu Zedekiya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.2",
            "verseOrgIds": [
              "2KI.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa tsiku lachisanu ndi chinayi pa mwezi wachinayi, njala inakula kwambiri mu mzindamo kotero kuti anthu analibe chakudya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.3",
            "verseOrgIds": [
              "2KI.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo khoma la mzindawo linabowoledwa ndipo gulu lonse la ankhondo linathawa usiku kudzera pa chipata cha pakati pa makoma awiri pafupi ndi munda wa mfumu, ngakhale kuti Ababuloni anali atazinga mzindawo. Iwo anathawira cha ku Araba,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.4",
            "verseOrgIds": [
              "2KI.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "koma gulu la ankhondo la ku Babuloni linalondola mfumu Zedekiya ndi kumupeza mʼchigwa cha ku Yeriko. Ankhondo onse anamusiya yekha nabalalika.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.5",
            "verseOrgIds": [
              "2KI.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anagwidwa napita naye kwa mfumu ya ku Babuloni ku Ribula, kumene anagamula mlandu wa Zedekiyayo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.6",
            "verseOrgIds": [
              "2KI.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anapha ana a Zedekiya iyeyo akuona. Kenaka anakolowola maso a Zedekiya namumanga ndi unyolo wamkuwa ndi kupita naye ku Babuloni.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.7",
            "verseOrgIds": [
              "2KI.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwezi wachisanu, pa tsiku lachisanu ndi chiwiri la mwezi, mʼchaka cha 19 cha Nebukadinezara, mfumu ya Babuloni, Nebuzaradani, mkulu wa asilikali oteteza mfumu, nduna ya mfumu ya Babuloni, anabwera ku Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.8",
            "verseOrgIds": [
              "2KI.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anatentha Nyumba ya Yehova, nyumba ya mfumu pamodzi ndi nyumba zonse za mu Yerusalemu. Anatentha nyumba iliyonse yofunika.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.9",
            "verseOrgIds": [
              "2KI.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gulu lonse la ankhondo la ku Babuloni limene linali ndi mkulu wa asilikali oteteza mfumu ija, linagumula malinga ozungulira Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.10",
            "verseOrgIds": [
              "2KI.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebuzaradani mkulu wa asilikali uja anatenga anthu amene anatsala mu mzindamo, ndi ena amene anathawira kwa mfumu ya Babuloni, pamodzi ndi ena onse kupita nawo ku ukapolo ku Babuloni.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.11",
            "verseOrgIds": [
              "2KI.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma mkulu wa asilikaliyo anasiya anthu ena osauka kwambiri mʼdzikomo kuti azisamalira minda ya mpesa ndi minda ina.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.12",
            "verseOrgIds": [
              "2KI.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ababuloni anaphwanya zipilala zamkuwa, maphaka ndiponso mbiya ya mkuwa zimene zinali mʼNyumba ya Yehova ndipo anatenga mkuwawo napita nawo ku Babuloni.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.13",
            "verseOrgIds": [
              "2KI.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anatenganso miphika, mafosholo, mbaniro za nyale, mbale ndi ziwiya zonse zamkuwa zimene ankagwiritsa ntchito potumikira mʼNyumbayo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.14",
            "verseOrgIds": [
              "2KI.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkulu wa asilikali uja anatenganso zofukizira lubani ndi mbale zowazira magazi. Zonsezi zinali zopangidwa ndi golide wabwino kwambiri kapena siliva.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.15",
            "verseOrgIds": [
              "2KI.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkuwa wochokera ku zipilala ziwiri zija, mbiya ija ndi maphaka aja, zimene Solomoni anapanga mʼNyumba ya Yehova, kuchuluka kwake kunali kosawerengeka.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.16",
            "verseOrgIds": [
              "2KI.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chipilala chilichonse chinali chotalika mamita asanu ndi atatu. Mutu wa mkuwa umene unali pamwamba pa chipilalacho unali mita imodzi ndi theka ndipo unakongoletsedwa ndi ukonde wa makangadza a mkuwa amene anazungulira mutuwo. Chipilala chachiwiri chinali chofanana ndi chinacho, ndipo chinali ndi ukonde.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.17",
            "verseOrgIds": [
              "2KI.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkulu wa asilikali uja anagwira ukapolo mkulu wa ansembe Seraya, Zefaniya wachiwiri wa mkulu wa ansembe ndi alonda atatu apakhomo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.18",
            "verseOrgIds": [
              "2KI.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwa anthu amene anali mu mzindamo, anatenga mkulu amene ankalamulira ankhondo ndiponso alangizi asanu a mfumu. Anatenganso mlembi wa mtsogoleri wa ankhondo amene ankalemba anthu ntchito ya usilikali mʼdzikomo pamodzi ndi anthu ake 60 amene anali mu mzindamo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.19",
            "verseOrgIds": [
              "2KI.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebuzaradani mkulu wa asilikali uja anawatenga onsewo napita nawo kwa mfumu ya Babuloni ku Ribula.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.20",
            "verseOrgIds": [
              "2KI.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku Ribulako, mʼdziko la Hamati, mfumu ya ku Babuloni inalamula kuti awakwapule ndi kuwapha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.21",
            "verseOrgIds": [
              "2KI.25.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 25:21"
      },
      "items": [
        {
          "text": "Choncho Ayuda anatengedwa ukapolo kuwachotsa mʼdziko lawo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.21",
            "verseOrgIds": [
              "2KI.25.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadinezara mfumu ya Babuloni anasankha Gedaliya mwana wa Ahikamu, mwana wa Safani, kukhala woyangʼanira anthu amene anatsala ku Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.22",
            "verseOrgIds": [
              "2KI.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atsogoleri onse ankhondo ndi anthu awo atamva kuti mfumu ya Babuloni yasankha Gedaliya kukhala bwanamkubwa, anabwera kwa Gedaliya ku Mizipa. Atsogoleriwo mayina awo anali awa: Ismaeli mwana wa Netaniya, Yohanani mwana wa Kareya, Seraya mwana wa Tanihumeti wa ku Netofa ndi Yaazaniya mwana wa Maakati, pamodzi ndi anthu awo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.23",
            "verseOrgIds": [
              "2KI.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gedaliya analumbira powatsimikizira iwo ndi anthu awo. Iye anati, \"Musachite mantha ndi atsogoleri Ababuloniwa. Khalani mʼdziko muno ndipo tumikirani mfumu ya Babuloni. Mukatero zinthu zidzakuyenderani bwino.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.24",
            "verseOrgIds": [
              "2KI.25.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma pa mwezi wachisanu ndi chiwiri, Ismaeli mwana wa Netaniya, mwana wa Elisama, wa banja laufumu, anabwera ndi anthu khumi ndipo anapha Gedaliya pamodzi ndi Ayuda ndi anthu a ku Babuloni amene anali naye limodzi ku Mizipa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.25",
            "verseOrgIds": [
              "2KI.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chifukwa cha zimenezi, anthu onse kuyambira wamngʼono mpaka wamkulu, pamodzi ndi atsogoleri a ankhondo anathawira ku Igupto chifukwa choopa Ababuloni.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.26",
            "verseOrgIds": [
              "2KI.25.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kumasulidwa kwa Yehoyakini",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa chaka cha 37 cha ukapolo wa Yehoyakini mfumu ya Yuda, chaka chimene Evili-Merodaki anakhala mfumu ya Babuloni, anamasula Yehoyakini mʼndende pa mwezi wa 12 pa tsiku la 27.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.27",
            "verseOrgIds": [
              "2KI.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anamukomera mtima namukweza kupambana mafumu ena onse amene anali naye ku Babuloni.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.28",
            "verseOrgIds": [
              "2KI.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Yoyakini anavula zovala zake za ku ndende, ndipo ankadya ndi mfumu masiku onse a moyo wake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.29",
            "verseOrgIds": [
              "2KI.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
