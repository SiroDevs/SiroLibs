  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "2KI 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nkhwangwa Iyandama pa madzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana a aneneri anati kwa Elisa, \"Taonani malo amene timakhala ndi inu atichepera kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.1",
            "verseOrgIds": [
              "2KI.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiloleni tipite ku Yorodani kumene aliyense wa ife akadule mtengo umodzi, kuti timange malo woti tizikhalamo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.2",
            "verseOrgIds": [
              "2KI.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 6:2"
      },
      "items": [
        {
          "text": "Ndipo Elisa anati, \"Pitani.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.2",
            "verseOrgIds": [
              "2KI.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmodzi wa iwo anati, \"Chonde mulole kutsagana nawo atumiki anu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.3",
            "verseOrgIds": [
              "2KI.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 6:3"
      },
      "items": [
        {
          "text": "Elisa anayankha kuti, \"Ndipita nanu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.3",
            "verseOrgIds": [
              "2KI.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo anapita nawo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.4",
            "verseOrgIds": [
              "2KI.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 6:4"
      },
      "items": [
        {
          "text": "Anapita ku Yorodani nayamba kudula mitengo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.4",
            "verseOrgIds": [
              "2KI.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene wina ankadula mtengo, nkhwangwa yake inaguluka nigwera mʼmadzi. Iye anafuwula kuti, \"Mayo! Mbuye wanga! Popeza ndi yobwereka!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.5",
            "verseOrgIds": [
              "2KI.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo munthu wa Mulungu uja anafunsa, \"Yagwera pati?\" Pamene anamuonetsa malowo, Elisa anadula kamtengo nakaponya pamenepo, ndipo nkhwangwayo inayandama.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.6",
            "verseOrgIds": [
              "2KI.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa anati, \"Itenge.\" Ndipo munthuyo anatambalitsa dzanja lake nayitenga.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.7",
            "verseOrgIds": [
              "2KI.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Elisa Achititsa Khungu Ankhondo a ku Aramu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono mfumu ya ku Aramu inali pa nkhondo ndi Israeli. Itakambirana ndi atsogoleri ake ankhondo inati, \"Ndidzamanga misasa yanga pamalo akutiakuti.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.8",
            "verseOrgIds": [
              "2KI.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthu wa Mulungu anatumiza mawu kwa mfumu ya ku Israeli kuti \"Musamale podutsa malo akuti, chifukwa Aaramu akupita kumeneko.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.9",
            "verseOrgIds": [
              "2KI.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho mfumu ya ku Israeli inatuma anthu kumalo kumene munthu wa Mulunguyo ananena. Nthawi ndi nthawi Elisa ankachenjeza mfumu, kotero kuti ankakhala tcheru ku malo amenewo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.10",
            "verseOrgIds": [
              "2KI.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zimenezi zinakwiyitsa kwambiri mfumu ya ku Aramu. Mfumuyo inayitanitsa atsogoleri ake ankhondo ndipo inawafunsa kuti, \"Kodi simungandiwuze munthu amene pakati pathu pano ali mbali ya mfumu ya ku Israeli?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.11",
            "verseOrgIds": [
              "2KI.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmodzi mwa atsogoleri a ankhondowo anati, \"Palibe ndi mmodzi yemwe pakati pathu, inu mbuye wanga, koma Elisa mneneri amene ali ku Israeli amawuza mfumu ya ku Israeli mawu enieni amene inu mumayankhula ku chipinda kwanu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.12",
            "verseOrgIds": [
              "2KI.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho mfumu inalamula kuti, \"Pitani, kafufuzeni kumene akukhala kuti ine nditume anthu kukamugwira.\" Anthuwo anabweretsa mawu oti, \"Taonani, Elisa ali ku Dotani.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.13",
            "verseOrgIds": [
              "2KI.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo mfumu inatumizako magaleta ndi akavalo ndiponso gulu lankhondo lamphamvu. Anapita usiku nakawuzungulira mzindawo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.14",
            "verseOrgIds": [
              "2KI.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtumiki wa munthu wa Mulungu atadzuka mmamawa ndi kutuluka panja, gulu la ankhondo pamodzi ndi akavalo ndi magaleta anali atazungulira mzindawo. Mtumikiyo anafunsa kuti, \"Kalanga mbuye wanga, tidzachita chiyani?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.15",
            "verseOrgIds": [
              "2KI.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mneneri anamuyankha kuti, \"Usachite mantha. Amene ali mbali yathu ndi ambiri kupambana amene ali mbali yawo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.16",
            "verseOrgIds": [
              "2KI.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Elisa anapemphera kuti, \"Inu Yehova tsekulani maso ake kuti aone.\" Pamenepo Yehova anatsekula maso a mtumikiyo, ndipo anayangʼana naona kuti phiri lonse linali lodzaza ndi akavalo ndi magaleta a moto atazungulira Elisa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.17",
            "verseOrgIds": [
              "2KI.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene adaniwo ankabwera kudzalimbana naye, Elisa anapemphera kwa Yehova kuti, \"Achititseni khungu anthu awa.\" Kotero Yehova anawachititsa khungu monga anapemphera Elisa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.18",
            "verseOrgIds": [
              "2KI.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa anawawuza ankhondowo kuti, \"Njira si imeneyi ndipo mzinda sumenewunso. Tsateni, ndipo ndidzakutengerani kwa munthu amene mukumufunayo.\" Ndipo anawatengera ku Samariya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.19",
            "verseOrgIds": [
              "2KI.6.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atalowa mu mzinda wa Samariya, Elisa anati, \"Yehova tsekulani maso a anthu awa kuti aone.\" Choncho Yehova anatsekula maso awo ndipo anangoona kuti ali mʼkati mwenimweni mwa Samariya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.20",
            "verseOrgIds": [
              "2KI.6.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu ya ku Israeli itawaona, inafunsa Elisa kuti, \"Abambo anga, kodi ndiwaphe? Kodi ndiwaphe?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.21",
            "verseOrgIds": [
              "2KI.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa anayankha kuti, \"Musawaphe. Kodi mungaphe anthu amene munawagwira pogwiritsa ntchito lupanga ndi uta? Apatseni chakudya ndi madzi kuti adye ndi kumwa kenaka apite kwa mbuye wawo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.22",
            "verseOrgIds": [
              "2KI.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho anawakonzera mphwando lalikulu, ndipo atatsiriza kudya ndi kumwa, anawatumiza kwawo ndipo anabwerera kwa mbuye wawo. Kotero magulu a ankhondo a ku Aramu analeka kuthira nkhondo dziko la Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.23",
            "verseOrgIds": [
              "2KI.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Njala mu Mzinda wa Samariya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Patapita nthawi, Beni-Hadadi mfumu ya Aramu anasonkhanitsa gulu lake lonse la ankhondo, napita kukazungulira mzinda wa Samariya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.24",
            "verseOrgIds": [
              "2KI.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mzinda wa Samariya munali njala yoopsa. Ndipo taonani, Aaramu anazungulira mzindawu kwa nthawi yayitali kotero kuti mutu wa bulu ankawugulitsa ndalama za siliva 80, ndipo magalamu 200 a zitosi za nkhunda ankawagulitsa pa mtengo wa masekeli asanu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.25",
            "verseOrgIds": [
              "2KI.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene mfumu inkayenda pa khoma la mzindawo, mayi wina anafuwulira mfumuyo kuti, \"Thandizeni mbuye wanga mfumu!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.26",
            "verseOrgIds": [
              "2KI.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu inayankha kuti, \"Ngati Yehova sakuthandiza iwe, ine thandizo lako ndingalipeze kuti? Kuchokera ku malo opunthira tirigu kodi? Kuchokera kumalo opsinyira mphesa kodi?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.27",
            "verseOrgIds": [
              "2KI.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo mfumuyo inafunsa mayiyo kuti, \"Kodi chakuvuta nʼchiyani?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.28",
            "verseOrgIds": [
              "2KI.6.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 6:28"
      },
      "items": [
        {
          "text": "Iye anayankha kuti, \"Mayi uyu anandiwuza kuti, 'Bweretsa mwana wako kuti timudye lero, ndipo mawa tidzadya mwana wangayu.'",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.28",
            "verseOrgIds": [
              "2KI.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho tinaphika mwana wanga ndi kumudya. Tsiku lotsatira lakelo ine ndinati, 'Bweretsa mwana wako kuti timudye,' koma iye anabisa mwana wakeyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.29",
            "verseOrgIds": [
              "2KI.6.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu itamva mawu a mayiyo, inangʼamba mkanjo wake. Pamene inkayenda pa khoma, anthu anayangʼana, ndipo anaona zovala zamʼkati, pakuti anavala chiguduli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.30",
            "verseOrgIds": [
              "2KI.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumuyo inati, \"Mulungu andilange, andilange kwambiri ndikapanda kudula mutu wa Elisa mwana wa Safati lero!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.31",
            "verseOrgIds": [
              "2KI.6.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Elisa nʼkuti atakhala mʼnyumba mwake, ndipo akuluakulu anali naye limodzi. Mfumu inatuma munthu wina kuti imutsogolere, koma asanafike, Elisa anawuza akuluakuluwo kuti, \"Kodi simukuona momwe wopha munthu uja watumizira munthu wina kuti adzadule mutu wanga? Taonani mthengayo akafika, mutseke chitseko ndipo muchigwiritsitse kuti asalowe. Kodi ndikumvawo pambuyo pake si mgugu wa mbuye wake?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.32",
            "verseOrgIds": [
              "2KI.6.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa akuyankhulabe ndi anthuwo, taonani, wamthengayo anafika kwa iye. Ndipo mfumu inati, \"Mavuto amenewa ndi ochokera kwa Yehova. Kodi nʼchifukwa chiyani ine ndiyenera kudikira thandizo lochokera kwa Yehova?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.33",
            "verseOrgIds": [
              "2KI.6.33"
            ]
          }
        }
      ]
    }
  ],
