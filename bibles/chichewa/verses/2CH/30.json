  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "2CH 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hezekiya Achita Chikondwerero cha Paska",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekiya anatumiza uthenga mʼdziko lonse la Israeli ndi ku Yuda ndiponso analemba makalata ku Efereimu ndi Manase, oyitana anthu kuti abwere ku Nyumba ya Yehova ku Yerusalemu kudzakondwerera Paska wa Yehova, Mulungu wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.1",
            "verseOrgIds": [
              "2CH.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu ndi akuluakulu ake pamodzi ndi anthu onse a mu Yerusalemu anagwirizana kuti akondwerere Paska pa mwezi wachiwiri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.2",
            "verseOrgIds": [
              "2CH.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo sanathe kukondwerera pa nthawi yake chifukwa si ansembe ambiri amene anadziyeretsa ndiponso anthu anali asanasonkhane mu Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.3",
            "verseOrgIds": [
              "2CH.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chikonzerochi chinaoneka kuti chinali chabwino kwa mfumu pamodzi ndi anthu onse.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.4",
            "verseOrgIds": [
              "2CH.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anagwirizana zoti alengeze mu Israeli monse kuyambira ku Beeriseba mpaka ku Dani, kuyitana anthu kuti abwere ku Yerusalemu ndi kudzakondwerera Paska wa Yehova, Mulungu wa Israeli. Si ambiri amene ankachita chikondwererochi monga momwe kunalembedwera.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.5",
            "verseOrgIds": [
              "2CH.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Molamulidwa ndi mfumu, amithenga anapita mu Israeli yense ndi Yuda ndi makalata ochokera kwa mfumu ndi kwa akuluakulu ake, olembedwa kuti,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.6",
            "verseOrgIds": [
              "2CH.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2CH 30:6"
      },
      "items": [
        {
          "text": "\"Aisraeli bwererani kwa Yehova, Mulungu wa Abrahamu, Isake ndi Israeli, kuti abwerere kwa inu amene mwatsala, amene mwapulumuka mʼdzanja la mafumu a ku Asiriya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.6",
            "verseOrgIds": [
              "2CH.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musakhale ngati makolo anu ndi abale anu, amene anali osakhulupirika kwa Yehova Mulungu wa makolo awo kotero kuti anawachititsa kuti akhale chinthu chochititsa mantha, monga mukuoneramu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.7",
            "verseOrgIds": [
              "2CH.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musawumitse khosi monga anachitira makolo anu, Gonjerani Yehova. Bwerani ku malo opatulika, amene anawapatula kwamuyaya. Tumikirani Yehova Mulungu wanu kuti mkwiyo wake ukuchokereni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.8",
            "verseOrgIds": [
              "2CH.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati inu mubwerera kwa Yehova, pamenepo abale anu ndi ana anu adzachitiridwa chifundo ndi amene anawagwira ukapolo ndipo adzabwereranso ku dziko lino pakuti Yehova, Mulungu wanu ndi wokoma mtima ndi wachifundo. Iye sadzakufulatirani ngati inuyo mubwerera kwa Iye.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.9",
            "verseOrgIds": [
              "2CH.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amithenga aja anapita mzinda ndi mzinda wa ku Efereimu ndi Manase mpaka ku Zebuloni, koma anthu anawanyoza ndi kuwachita chipongwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.10",
            "verseOrgIds": [
              "2CH.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komabe anthu ena a ku Aseri, Manase ndi Zebuloni anadzichepetsa ndipo anapita ku Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.11",
            "verseOrgIds": [
              "2CH.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzanja la Mulungu linalinso pa anthu a ku Yuda, kuwapatsa mtima umodzi wochita zimene mfumu ndi akuluakulu ake analamula potsata mawu a Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.12",
            "verseOrgIds": [
              "2CH.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gulu lalikulu la anthu linasonkhana mu Yerusalemu kudzachita chikondwerero cha Buledi Wopanda Yisiti pa mwezi wachiwiri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.13",
            "verseOrgIds": [
              "2CH.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anachotsa mu Yerusalemu maguwa ofukizira lubani ndipo anakawaponya mʼchigwa cha Kidroni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.14",
            "verseOrgIds": [
              "2CH.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anapha mwana wankhosa wa Paska pa tsiku la 14 la mwezi wachiwiri. Ansembe ndi Alevi anachita manyazi ndipo anadziyeretsa ndi kubweretsa nsembe zopsereza ku Nyumba ya Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.15",
            "verseOrgIds": [
              "2CH.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo anakhala mʼmalo awo a nthawi zonse potsatira zolembedwa mʼmalamulo a Mose munthu wa Mulungu. Ansembe anawaza magazi amene anawapatsa Alevi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.16",
            "verseOrgIds": [
              "2CH.30.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Popeza ambiri mʼgululo anali asanadziyeretse, Alevi anapha ana ankhosa a Paska a iwo amene, mwa mwambo, anali osayeretsedwa ndipo sakanatha kupereka ana ankhosa awo kwa Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.17",
            "verseOrgIds": [
              "2CH.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhale kuti ambiri mwa anthu ochokera ku Efereimu, Manase, Isakara ndi Zebuloni sanadziyeretse okha, komabe anadya Paska motsutsana ndi zimene zinalembedwa. Koma Hezekiya anawapempherera, kunena kuti, \"Yehova wabwino, khululukirani aliyense",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.18",
            "verseOrgIds": [
              "2CH.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "amene wayika mtima wake kufunafuna Yehova, Mulungu wa makolo ake, ngakhale ali wosayeretsedwa molingana ndi malamulo a malo opatulika.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.19",
            "verseOrgIds": [
              "2CH.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yehova anamvera Hezekiya ndipo anachiritsa anthuwo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.20",
            "verseOrgIds": [
              "2CH.30.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aisraeli amene anali mu Yerusalemu anachita chikondwerero cha Buledi Wopanda Yisiti kwa masiku asanu ndi awiri akusangalala kwambiri, pamene Alevi ndi ansembe amayimbira Yehova tsiku lililonse, akuyimbira zida zamatamando za Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.21",
            "verseOrgIds": [
              "2CH.30.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekiya anayankhula molimbikitsa Alevi onse amene anaonetsa kumvetsa bwino za kutumikira Yehova. Kwa masiku asanu ndi awiri anadya gawo lawo ndi kupereka nsembe zachiyanjano ndi kutamanda Yehova, Mulungu wa makolo awo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.22",
            "verseOrgIds": [
              "2CH.30.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo msonkhano wonse unagwirizana zopitiriza chikondwerero kwa masiku ena asanu ndi awiri. Kotero kwa masiku ena asanu ndi awiri anachita chikondwererocho mosangalala.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.23",
            "verseOrgIds": [
              "2CH.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekiya mfumu ya Yuda anapereka ngʼombe zamphongo 1,000 ndi nkhosa ndi mbuzi 7,000 ku msonkhanoko ndipo akuluakulu ake anapereka ngʼombe zamphongo 1,000, nkhosa ndi mbuzi 10,000. Ansembe ambiri anadziyeretsa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.24",
            "verseOrgIds": [
              "2CH.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gulu lonse la ku Yuda linasangalala, pamodzi ndi ansembe ndi Alevi ndi onse amene anasonkhana ochokera ku Israeli, kuphatikizanso alendo amene anachokera ku Israeli ndi amene amakhala ku Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.25",
            "verseOrgIds": [
              "2CH.30.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munali chikondwerero chachikulu mu Yerusalemu, pakuti kuyambira masiku a Solomoni mwana wa Davide mfumu ya Israeli sizinachitikepo zotere mu Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.26",
            "verseOrgIds": [
              "2CH.30.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ansembe ndi Alevi anayimirira kudalitsa anthu, ndipo Mulungu anawamvera pakuti pemphero lawo linafika kumwamba, malo ake oyera.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.27",
            "verseOrgIds": [
              "2CH.30.27"
            ]
          }
        }
      ]
    }
  ],
