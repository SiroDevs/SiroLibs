        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ahaziya Mfumu ya Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu a mu Yerusalemu anayika Ahaziya mwana wamngʼono kwambiri wa Yehoramu kukhala mfumu mʼmalo mwake, popeza gulu lankhondo limene linabwera ndi Aarabu ku misasa, linapha ana onse aakulu. Motero Ahaziya mwana wa Yehoramu mfumu ya Yuda anayamba kulamulira.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.1",
            "verseOrgIds": [
              "2CH.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahaziya anali wa zaka 22 pamene anakhala mfumu ndipo analamulira mu Yerusalemu chaka chimodzi. Dzina la amayi ake linali Ataliya, chidzukulu cha Omuri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.2",
            "verseOrgIds": [
              "2CH.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayenso anayenda mʼnjira ya banja la Ahabu, pakuti amayi ake anamulimbikitsa kuchita zolakwika.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.3",
            "verseOrgIds": [
              "2CH.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anachita zoyipa pamaso pa Yehova monga momwe banja la Ahabu linachitira, pakuti atamwalira abambo ake, iwo anakhala alangizi ake, kumene kunali kudziwononga kwake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.4",
            "verseOrgIds": [
              "2CH.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyeyo anatsatiranso uphungu wawo pamene anapita ndi Yehoramu, mwana wa Ahabu, mfumu ya Israeli kukachita nkhondo ndi Hazaeli mfumu ya Aramu ku Ramoti Giliyadi. Aaramu anavulaza Yehoramu,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.5",
            "verseOrgIds": [
              "2CH.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kotero iye anabwerera ku Yezireeli kuti akachire mabala amene anamuvulaza ku Ramoti pa nkhondo ndi Hazaeli mfumu ya Aaramu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.6",
            "verseOrgIds": [
              "2CH.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 22:6"
      },
      "items": [
        {
          "text": "Ndipo Ahaziya, mwana wa Yehoramu mfumu ya Yuda anapita ku Yezireeli kukaona Yehoramu mwana wa Ahabu chifukwa anavulazidwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.6",
            "verseOrgIds": [
              "2CH.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu anakonza kuti Ahaziya akaphedwe pa ulendo wake wokacheza. Ahaziya atafika, iye ndi Yoramu anapita kukakumana ndi Yehu mwana wa Nimisi, amene Yehova anamudzoza kuti akawononge banja la Ahabu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.7",
            "verseOrgIds": [
              "2CH.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene Yehu ankalanga banja la Ahabu anapeza atsogoleri a ku Yuda ndiponso ana aamuna a abale ake a Ahaziya amene amatumikira Ahaziya, ndipo anawapha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.8",
            "verseOrgIds": [
              "2CH.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka anapita kukafunafuna Ahaziya, ndipo anthu ake anagwira Ahaziya pamene amabisala mu Samariya. Anabwera naye kwa Yehu ndipo anaphedwa. Iwo anamuyika mʼmanda, pakuti anati, \"Iyeyu anali mwana wa Yehosafati amene anafunafuna Yehova ndi mtima wake wonse.\" Kotero panalibe wamphamvu mʼbanja la Ahaziya kuti nʼkukhala mfumu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.9",
            "verseOrgIds": [
              "2CH.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ataliya ndi Yowasi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ataliya, amayi ake a Ahaziya, ataona kuti mwana wawo wafa, ananyamuka nakapha onse a banja laufumu la Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.10",
            "verseOrgIds": [
              "2CH.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Yehoseba, mwana wamkazi wa mfumu Yehoramu, anatenga Yowasi mwana wa Ahaziya, momuba ndi kumuchotsa pakati pa ana aamuna a mfumu amene amati aphedwe ndipo anamuyika iye ndi mlezi wake mʼchipinda chogona. Motero Yehoseba, mwana wamkazi wa mfumu Yehoramu, mkazi wa wansembe Yehoyada, yemwe anali mlongo wake wa Ahaziya anamubisa mwanayo kuti Ataliya asamuphe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.11",
            "verseOrgIds": [
              "2CH.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanayo anakhala mobisala pamodzi ndi iwo mu Nyumba ya Mulungu kwa zaka zisanu ndi chimodzi muulamuliro wa Ataliya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.12",
            "verseOrgIds": [
              "2CH.22.12"
            ]
          }
        }
      ]
    }
  ],
