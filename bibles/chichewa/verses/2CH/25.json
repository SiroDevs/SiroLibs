  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "2CH 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amaziya Mfumu ya Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaziya anali wa zaka 25 pamene anakhala mfumu, ndipo analamulira mu Yerusalemu kwa zaka 29. Dzina la amayi ake linali Yehoyadini wa ku Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.1",
            "verseOrgIds": [
              "2CH.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anachita zolungama pamaso pa Yehova, koma osati ndi mtima wonse.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.2",
            "verseOrgIds": [
              "2CH.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene mphamvu zonse zaufumu zinali mʼmanja mwake, iye anapha akuluakulu amene anapha abambo ake, mfumu ija.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.3",
            "verseOrgIds": [
              "2CH.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komabe iye sanaphe ana awo koma anatsatira zolembedwa mʼbuku la Mose, mʼmene Yehova analamula kuti, \"Makolo sadzaphedwa chifukwa cha ana awo kapena ana kuphedwa chifukwa cha makolo awo. Aliyense adzafera machimo ake.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.4",
            "verseOrgIds": [
              "2CH.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaziya anasonkhanitsa anthu a ku Yuda ndipo anawapatsa zochita molingana ndi mabanja awo kukhala anthu olamulira 1,000, ndi olamulira 100 pa Ayuda onse ndi Benjamini. Ndipo iye anawerenga amene anali ndi zaka makumi awiri kapena kupitirirapo napeza kuti analipo amuna 300,000 okonzeka kugwira ntchito ya usilikali, okhoza kugwiritsa ntchito mkondo ndi chishango.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.5",
            "verseOrgIds": [
              "2CH.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye analembanso ntchito anthu odziwa nkhondo 100,000 ochokera ku Israeli pa mtengo wa makilogalamu 3,400 a siliva.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.6",
            "verseOrgIds": [
              "2CH.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma munthu wa Mulungu anabwera kwa iye ndipo anati, \"Inu mfumu, asilikali awa ochokera ku Israeli asapite ndi inu, pakuti Yehova sali ndi Israeli kapena ndi aliyense wa anthu a Efereimu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.7",
            "verseOrgIds": [
              "2CH.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhale mupite ndi kuchita nkhondo molimba mtima, Mulungu adzakugonjetsani pamaso pa adani anu, pakuti Mulungu ali ndi mphamvu yothandiza kapena kugonjetsa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.8",
            "verseOrgIds": [
              "2CH.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaziya anafunsa munthu wa Mulungu kuti, \"Koma nanga za makilogalamu aja a siliva amene ndapereka kwa asilikali a Israeli?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.9",
            "verseOrgIds": [
              "2CH.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 25:9"
      },
      "items": [
        {
          "text": "Munthu wa Mulungu anayankha kuti, \"Yehova atha kukupatsani zambiri kuposa zimenezo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.9",
            "verseOrgIds": [
              "2CH.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Amaziya anachotsa asilikali amene anabwera kwa iye kuchokera ku Efereimu ndipo anawatumiza kwawo. Iwo anakwiyira anthu a ku Yuda ndipo anapita kwawo atapsa mtima kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.10",
            "verseOrgIds": [
              "2CH.25.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Amaziya analimba mtima ndipo anatsogolera gulu lake lankhondo ku Chigwa cha Mchere, kumene anapha anthu 10,000 a ku Seiri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.11",
            "verseOrgIds": [
              "2CH.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gulu la ankhondo la Yuda linagwiranso anthu amoyo 10,000, napita nawo pamwamba pa thanthwe ndipo anawaponya pansi kotero kuti onse ananyenyeka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.12",
            "verseOrgIds": [
              "2CH.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa nthawi imeneyi asilikali amene Amaziya anawabweza ndipo sanawalole kuti achite nawo nkhondo, anakathira nkhondo mizinda ya Yuda kuyambira ku Samariya mpaka ku Beti-Horoni. Iwo anapha anthu 3,000 ndipo anafunkha katundu wambiri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.13",
            "verseOrgIds": [
              "2CH.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaziya atabwerera kuja anakapha Aedomu, anabweretsa milungu ya anthu a ku Seiri. Ndipo anayika kuti ikhale milungu yake, ankayipembedza ndi kupereka nsembe zopsereza.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.14",
            "verseOrgIds": [
              "2CH.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anakwiyira Amaziya, ndipo anamutumizira mneneri amene anati, \"Nʼchifukwa chiyani mukupembedza milungu ya anthu awa, imene sinathe kupulumutsa anthu ake mʼdzanja lanu?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.15",
            "verseOrgIds": [
              "2CH.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye ali kuyankhula, mfumu inati, \"Kodi ife takusankha iwe kuti ukhale mlangizi wa mfumu? Khala chete! Ufuna kuphedweranji?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.16",
            "verseOrgIds": [
              "2CH.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 25:16"
      },
      "items": [
        {
          "text": "Choncho mneneriyo analeka koma anati, \"Ine ndikudziwa kuti Mulungu watsimikiza kukuwonongani chifukwa mwachita izi ndipo simunamvere uphungu wanga.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.16",
            "verseOrgIds": [
              "2CH.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaziya mfumu ya ku Yuda, atafunsa alangizi ake, anatumiza mawu awa kwa Yowasi mwana wa Yehowahazi mwana wa Yehu, mfumu ya Israeli: \"Bwera udzakumane nane maso ndi maso.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.17",
            "verseOrgIds": [
              "2CH.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Yowasi mfumu ya Israeli inayankha Amaziya mfumu ya Yuda kuti, \"Nthawi ina kamtengo kaminga ka ku Lebanoni kanatumiza mawu kwa mkungudza wa ku Lebanoni kuti, 'Pereka mwana wako wamkazi kwa mwana wanga kuti amukwatire!' Koma chirombo cha ku Lebanoni chinabwera ndi kupondaponda mtengo wa minga uja.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.18",
            "verseOrgIds": [
              "2CH.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe ukuti wagonjetsa Edomu, ndipo tsopano ukudzikuza ndi kudzitamandira, koma khala kwanu komweko! Nʼchifukwa chiyani ukufuna mavuto ndi kudzichititsa kuti ugwe pamodzinso ndi Yuda?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.19",
            "verseOrgIds": [
              "2CH.25.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komabe Amaziya sanamvere pakuti ndi Mulungu amene anakonzeratu kuti awapereke kwa Yehowasi, chifukwa iwo amapembedza milungu ya ku Edomu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.20",
            "verseOrgIds": [
              "2CH.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotero Yowasi mfumu ya Israeli inakamuthira nkhondo. Iye ndi Amaziya anayangʼanana maso ndi maso ku Beti-Semesi ku Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.21",
            "verseOrgIds": [
              "2CH.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda anagonjetsedwa ndi Israeli ndipo munthu aliyense anathawira kwawo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.22",
            "verseOrgIds": [
              "2CH.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowahazi mfumu ya Israeli inagwira Amaziya mfumu ya Yuda, mwana wa Yowasi, mwana wa Ahaziya ku Beti-Semesi. Yehowasi anabwera naye ku Yerusalemu ndipo anagwetsa khoma la Yerusalemu kuyambira pa Chipata cha Efereimu mpaka ku Chipata Chapangodya, khoma lotalika mamita 180.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.23",
            "verseOrgIds": [
              "2CH.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anatenga golide ndi siliva yense ndi zida zonse zimene zimapezeka mʼNyumba ya Mulungu zimene ankazisamalira Obedi-Edomu, pamodzinso ndi chuma cha mʼnyumba yaufumu ndipo anatenga anthu ngati chikole.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.24",
            "verseOrgIds": [
              "2CH.25.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaziya mwana wa Yowasi mfumu ya Yuda anakhala ndi moyo kwa zaka khumi ndi zisanu atamwalira Yehowasi mwana wa Yehowahazi mfumu ya Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.25",
            "verseOrgIds": [
              "2CH.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntchito zina za mfumu Amaziya, kuyambira pachiyambi mpaka pa mapeto, kodi sizinalembedwe mʼbuku la mafumu a Yuda ndi Israeli?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.26",
            "verseOrgIds": [
              "2CH.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyambira nthawi imene Amaziya analeka kutsatira Yehova anthu anamukonzera chiwembu mu Yerusalemu ndipo anathawira ku Lakisi, koma adaniwo anatumiza anthu ku Lakisiko ndipo anamupha komweko.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.27",
            "verseOrgIds": [
              "2CH.25.27"
            ]
          }
        },
