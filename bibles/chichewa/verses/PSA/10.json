  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "PSA 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼchifukwa chiyani Yehova mwayima patali?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.1",
            "verseOrgIds": [
              "PSA.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:1"
      },
      "items": [
        {
          "text": "Chifukwa chiyani mukudzibisa nokha pa nthawi ya mavuto?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.1",
            "verseOrgIds": [
              "PSA.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwa kunyada kwake munthu woyipa asaka wofowoka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.2",
            "verseOrgIds": [
              "PSA.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:2"
      },
      "items": [
        {
          "text": "amene akodwa mʼnjira zimene iye wakonza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.2",
            "verseOrgIds": [
              "PSA.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amatamandira zokhumba za mu mtima wake;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.3",
            "verseOrgIds": [
              "PSA.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:3"
      },
      "items": [
        {
          "text": "amadalitsa aumbombo ndi kuchitira chipongwe Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.3",
            "verseOrgIds": [
              "PSA.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwa kunyada kwake woyipa safunafuna Mulungu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.4",
            "verseOrgIds": [
              "PSA.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:4"
      },
      "items": [
        {
          "text": "mʼmaganizo ake wonse mulibe malo a Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.4",
            "verseOrgIds": [
              "PSA.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zinthu zake zimamuyendera bwino;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.5",
            "verseOrgIds": [
              "PSA.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:5"
      },
      "items": [
        {
          "text": "iye ndi wamwano ndipo malamulo anu ali nawo kutali;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.5",
            "verseOrgIds": [
              "PSA.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:5"
      },
      "items": [
        {
          "text": "amanyogodola adani ake onse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.5",
            "verseOrgIds": [
              "PSA.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amadziyankhulira kuti, \"Palibe chimene chidzandigwedeze.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.6",
            "verseOrgIds": [
              "PSA.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:6"
      },
      "items": [
        {
          "text": "Ndidzakhala wokondwa nthawi zonse ndipo sindidzakhala pa mavuto.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.6",
            "verseOrgIds": [
              "PSA.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼkamwa mwake mwadzaza matemberero, mabodza ndi zoopseza;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.7",
            "verseOrgIds": [
              "PSA.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:7"
      },
      "items": [
        {
          "text": "zovutitsa ndi zoyipa zili pansi pa lilime lake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.7",
            "verseOrgIds": [
              "PSA.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amabisalira anthu pafupi ndi midzi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.8",
            "verseOrgIds": [
              "PSA.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:8"
      },
      "items": [
        {
          "text": "kuchokera pobisalapo amapha anthu osalakwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.8",
            "verseOrgIds": [
              "PSA.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:8"
      },
      "items": [
        {
          "text": "amayangʼanayangʼana mwachinsinsi anthu oti awawononge.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.8",
            "verseOrgIds": [
              "PSA.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amabisalira anthu ngati mkango pa zitsamba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.9",
            "verseOrgIds": [
              "PSA.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:9"
      },
      "items": [
        {
          "text": "Amabisalira kuti agwire anthu opanda mphamvu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.9",
            "verseOrgIds": [
              "PSA.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:9"
      },
      "items": [
        {
          "text": "amagwira anthu opanda mphamvu ndi kuwakokera mu ukonde wake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.9",
            "verseOrgIds": [
              "PSA.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthuwo amawapondaponda ndipo amakomoka;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.10",
            "verseOrgIds": [
              "PSA.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:10"
      },
      "items": [
        {
          "text": "amakhala pansi pa mphamvu zake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.10",
            "verseOrgIds": [
              "PSA.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amati mu mtima mwake, \"Mulungu wayiwala,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.11",
            "verseOrgIds": [
              "PSA.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:11"
      },
      "items": [
        {
          "text": "wabisa nkhope yake ndipo sakuonanso.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.11",
            "verseOrgIds": [
              "PSA.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzukani Yehova! Onetsani dzanja lanu Inu Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.12",
            "verseOrgIds": [
              "PSA.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:12"
      },
      "items": [
        {
          "text": "Musayiwale anthu opanda mphamvu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.12",
            "verseOrgIds": [
              "PSA.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼchifukwa chiyani munthu woyipa amachitira chipongwe Mulungu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.13",
            "verseOrgIds": [
              "PSA.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:13"
      },
      "items": [
        {
          "text": "Chifukwa chiyani amati mu mtima mwake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.13",
            "verseOrgIds": [
              "PSA.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:13"
      },
      "items": [
        {
          "text": "\"Iye sandiyimba mlandu?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.13",
            "verseOrgIds": [
              "PSA.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komatu Inu Mulungu, mumazindikira mavuto ndi zosautsa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.14",
            "verseOrgIds": [
              "PSA.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:14"
      },
      "items": [
        {
          "text": "mumaganizira zochitapo kanthu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.14",
            "verseOrgIds": [
              "PSA.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 10:14"
      },
      "items": [
        {
          "text": "Wovutikayo amadzipereka yekha kwa Inu pakuti",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.14",
            "verseOrgIds": [
              "PSA.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:14"
      },
      "items": [
        {
          "text": "Inu ndi mthandizi wa ana amasiye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.14",
            "verseOrgIds": [
              "PSA.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thyolani dzanja la woyipitsitsa ndi la munthu woyipa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.15",
            "verseOrgIds": [
              "PSA.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:15"
      },
      "items": [
        {
          "text": "muzengeni mlandu chifukwa cha zoyipa zake",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.15",
            "verseOrgIds": [
              "PSA.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:15"
      },
      "items": [
        {
          "text": "zimene sizikanadziwika.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.15",
            "verseOrgIds": [
              "PSA.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova ndi Mfumu kwamuyaya;",
          "type": "text",
