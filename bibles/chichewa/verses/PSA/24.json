          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi Mfumu yaulemereroyo ndani?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.8",
            "verseOrgIds": [
              "PSA.24.8"
            ]
          }
        }
