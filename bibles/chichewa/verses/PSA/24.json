    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Salimo la Davide.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dziko lapansi ndi la Yehova ndi zonse zimene zili mʼmenemo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.1",
            "verseOrgIds": [
              "PSA.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 24:1"
      },
      "items": [
        {
          "text": "dziko ndi onse amene amakhala mʼmenemo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.1",
            "verseOrgIds": [
              "PSA.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "pakuti Iye ndiye anayika maziko ake pa nyanja",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.2",
            "verseOrgIds": [
              "PSA.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 24:2"
      },
      "items": [
        {
          "text": "ndi kulikhazika pamwamba pa madzi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.2",
            "verseOrgIds": [
              "PSA.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndani angakwere phiri la Yehova?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.3",
            "verseOrgIds": [
              "PSA.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 24:3"
      },
      "items": [
        {
          "text": "Ndani angathe kuyima pa malo ake opatulika?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.3",
            "verseOrgIds": [
              "PSA.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amene ali ndi mʼmanja moyera ndi mtima woyera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.4",
            "verseOrgIds": [
              "PSA.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 24:4"
      },
      "items": [
        {
          "text": "amene sapereka moyo wake kwa fano",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.4",
            "verseOrgIds": [
              "PSA.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 24:4"
      },
      "items": [
        {
          "text": "kapena kulumbira mwachinyengo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.4",
            "verseOrgIds": [
              "PSA.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyeyo adzalandira madalitso kwa Yehova",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.5",
            "verseOrgIds": [
              "PSA.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 24:5"
      },
      "items": [
        {
          "text": "ndipo Mulungu mpulumutsi wake adzagamula kuti alibe mlandu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.5",
            "verseOrgIds": [
              "PSA.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umenewo ndiwo mʼbado wa amene amafunafuna Yehova;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.6",
            "verseOrgIds": [
              "PSA.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 24:6"
      },
      "items": [
        {
          "text": "amene amafunafuna nkhope yanu, Inu Mulungu wa Yakobo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.6",
            "verseOrgIds": [
              "PSA.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "PSA 24:6"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.24.6",
                "verseOrgIds": [
                  "PSA.24.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukulani mitu yanu inu zipata;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.7",
            "verseOrgIds": [
              "PSA.24.7"
            ]
          }
        }
      ]
    },
    {
