    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 24:8"
      },
      "items": [
        {
          "text": "Yehova Wamphamvuzonse,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.8",
            "verseOrgIds": [
              "PSA.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 24:8"
      },
      "items": [
        {
          "text": "Yehova ndiye wamphamvu pa nkhondo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.8",
            "verseOrgIds": [
              "PSA.24.8"
            ]
          }
        }
      ]
    },
