      "attrs": {
        "style": "q2",
        "vid": "PSA 24:7"
      },
      "items": [
        {
          "text": "tsekukani, inu zitseko zakalekalenu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.7",
            "verseOrgIds": [
              "PSA.24.7"
            ]
          }
        }
