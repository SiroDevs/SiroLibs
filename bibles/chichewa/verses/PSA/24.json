      "attrs": {
        "style": "q2",
        "vid": "PSA 24:7"
      },
      "items": [
        {
          "text": "kuti Mfumu yaulemerero ilowe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.7",
            "verseOrgIds": [
              "PSA.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
