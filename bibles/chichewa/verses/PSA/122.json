  "verseCount": 9,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "122",
        "style": "c",
        "sid": "PSA 122"
      },
      "items": [
        {
          "text": "122",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 122",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Salimo la Davide. Nyimbo yoyimba pokwera ku Yerusalemu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 122:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinakondwera atandiwuza kuti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.1",
            "verseOrgIds": [
              "PSA.122.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:1"
      },
      "items": [
        {
          "text": "\"Tiyeni ku nyumba ya Yehova.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.1",
            "verseOrgIds": [
              "PSA.122.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 122:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mapazi athu akuyima mʼzipata",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.2",
            "verseOrgIds": [
              "PSA.122.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:2"
      },
      "items": [
        {
          "text": "zako, Iwe Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.2",
            "verseOrgIds": [
              "PSA.122.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 122:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yerusalemu anamangidwa ngati mzinda",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.3",
            "verseOrgIds": [
              "PSA.122.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:3"
      },
      "items": [
        {
          "text": "umene uli wothithikana pamodzi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.3",
            "verseOrgIds": [
              "PSA.122.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 122:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumeneko ndiye kumene kumapita mafuko,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.4",
            "verseOrgIds": [
              "PSA.122.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:4"
      },
      "items": [
        {
          "text": "mafuko a Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.4",
            "verseOrgIds": [
              "PSA.122.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 122:4"
      },
      "items": [
        {
          "text": "umboni wa kwa Israeli,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.4",
            "verseOrgIds": [
              "PSA.122.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:4"
      },
      "items": [
        {
          "text": "kuti atamande dzina la Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.4",
            "verseOrgIds": [
              "PSA.122.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 122:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumeneko anayikako mipando yaufumu yachiweruzo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.5",
            "verseOrgIds": [
              "PSA.122.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:5"
      },
      "items": [
        {
          "text": "mipando yaufumu ya nyumba ya Davide.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.5",
            "verseOrgIds": [
              "PSA.122.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 122:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pemphererani mtendere wa Yerusalemu:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.6",
            "verseOrgIds": [
              "PSA.122.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:6"
      },
      "items": [
        {
          "text": "\"Iwo amene amakukonda iwe zinthu ziwayendere bwino.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.6",
            "verseOrgIds": [
              "PSA.122.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 122:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukhale mtendere mʼkati mwa makoma ako,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.7",
            "verseOrgIds": [
              "PSA.122.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:7"
      },
      "items": [
        {
          "text": "ndipo mʼnyumba zako zaufumu mukhale chitetezo.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.7",
            "verseOrgIds": [
              "PSA.122.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 122:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chifukwa cha abale anga ndi abwenzi anga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.8",
            "verseOrgIds": [
              "PSA.122.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:8"
      },
      "items": [
        {
          "text": "ndidzati, \"Mtendere ukhale mʼkati mwako.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.8",
            "verseOrgIds": [
              "PSA.122.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 122:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chifukwa cha Nyumba ya Yehova Mulungu wathu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.9",
            "verseOrgIds": [
              "PSA.122.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:9"
      },
      "items": [
        {
          "text": "ndidzakufunira zabwino.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.9",
            "verseOrgIds": [
              "PSA.122.9"
            ]
          }
        }
      ]
    }
  ],
