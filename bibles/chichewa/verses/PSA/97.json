      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 97",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 97:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova akulamulira, dziko lapansi lisangalale;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.1",
            "verseOrgIds": [
              "PSA.97.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:1"
      },
      "items": [
        {
          "text": "magombe akutali akondwere.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.1",
            "verseOrgIds": [
              "PSA.97.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 97:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mitambo ndi mdima waukulu zamuzungulira;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.2",
            "verseOrgIds": [
              "PSA.97.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:2"
      },
      "items": [
        {
          "text": "chilungamo ndi kuweruza molungama ndiwo maziko a mpando wake waufumu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.2",
            "verseOrgIds": [
              "PSA.97.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 97:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto umapita patsogolo pake",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.3",
            "verseOrgIds": [
              "PSA.97.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:3"
      },
      "items": [
        {
          "text": "ndi kunyeketsa amaliwongo kumbali zonse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.3",
            "verseOrgIds": [
              "PSA.97.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 97:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zingʼaningʼani zake zimawalitsa dziko lonse;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.4",
            "verseOrgIds": [
              "PSA.97.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:4"
      },
      "items": [
        {
          "text": "dziko lapansi limaona ndipo limanjenjemera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.4",
            "verseOrgIds": [
              "PSA.97.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 97:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mapiri amasungunuka ngati phula pamaso pa Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.5",
            "verseOrgIds": [
              "PSA.97.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:5"
      },
      "items": [
        {
          "text": "pamaso pa Ambuye a dziko lonse lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.5",
            "verseOrgIds": [
              "PSA.97.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 97:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayiko akumwamba amalengeza za chilungamo chake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.6",
            "verseOrgIds": [
              "PSA.97.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:6"
      },
      "items": [
        {
          "text": "ndipo mitundu yonse ya anthu imaona ulemerero wake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.6",
            "verseOrgIds": [
              "PSA.97.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 97:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onse amene amalambira mafano osema amachititsidwa manyazi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.7",
            "verseOrgIds": [
              "PSA.97.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:7"
      },
      "items": [
        {
          "text": "iwo amene amanyadira mafano;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.7",
            "verseOrgIds": [
              "PSA.97.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:7"
      },
      "items": [
        {
          "text": "mulambireni, inu milungu yonse!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.7",
            "verseOrgIds": [
              "PSA.97.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 97:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ziyoni akumva ndipo akukondwera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.8",
            "verseOrgIds": [
              "PSA.97.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:8"
      },
      "items": [
        {
          "text": "midzi ya Yuda ikusangalala",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.8",
            "verseOrgIds": [
              "PSA.97.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:8"
      },
      "items": [
        {
          "text": "chifukwa cha maweruzo anu Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.8",
            "verseOrgIds": [
              "PSA.97.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 97:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti Inu Yehova ndi Wammwambamwamba pa dziko lonse lapansi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.9",
            "verseOrgIds": [
              "PSA.97.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:9"
      },
      "items": [
        {
          "text": "ndinu wokwezeka kupambana milungu yonse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.9",
            "verseOrgIds": [
              "PSA.97.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 97:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo amene amakonda Yehova adane ndi zoyipa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.10",
            "verseOrgIds": [
              "PSA.97.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:10"
      },
      "items": [
        {
          "text": "pakuti Iye amayangʼanira miyoyo ya amene amamukhulupirira",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.10",
            "verseOrgIds": [
              "PSA.97.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:10"
      },
      "items": [
        {
          "text": "ndipo amawapulumutsa mʼdzanja la anthu oyipa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.10",
            "verseOrgIds": [
              "PSA.97.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 97:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwala kumafika pa anthu olungama,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.11",
            "verseOrgIds": [
              "PSA.97.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:11"
      },
      "items": [
        {
          "text": "ndi chimwemwe kwa olungama mtima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.11",
            "verseOrgIds": [
              "PSA.97.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 97:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kondwerani mwa Yehova Inu olungama",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.12",
            "verseOrgIds": [
              "PSA.97.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:12"
      },
      "items": [
        {
          "text": "ndipo tamandani dzina lake loyera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.12",
            "verseOrgIds": [
              "PSA.97.12"
            ]
          }
        }
      ]
    }
