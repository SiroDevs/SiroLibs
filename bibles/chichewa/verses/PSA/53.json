  "verseCount": 6,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "53",
        "style": "c",
        "sid": "PSA 53"
      },
      "items": [
        {
          "text": "53",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 53",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mtsogoleri wa mayimbidwe. Potsata mayimbidwe a Mahalati. Ndakatulo ya Davide.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 53:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chitsiru chimati mu mtima mwake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.1",
            "verseOrgIds": [
              "PSA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:1"
      },
      "items": [
        {
          "text": "\"Kulibe Mulungu.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.1",
            "verseOrgIds": [
              "PSA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 53:1"
      },
      "items": [
        {
          "text": "Iwo ndi oyipa ndipo njira zawo ndi zonyansa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.1",
            "verseOrgIds": [
              "PSA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:1"
      },
      "items": [
        {
          "text": "palibe ndi mmodzi yemwe amene amachita chabwino.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.1",
            "verseOrgIds": [
              "PSA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 53:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu kumwamba amayangʼana pansi pano",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.2",
            "verseOrgIds": [
              "PSA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:2"
      },
      "items": [
        {
          "text": "pa ana a anthu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.2",
            "verseOrgIds": [
              "PSA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 53:2"
      },
      "items": [
        {
          "text": "kuti aone ngati alipo wina wanzeru,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.2",
            "verseOrgIds": [
              "PSA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:2"
      },
      "items": [
        {
          "text": "wofunafuna Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.2",
            "verseOrgIds": [
              "PSA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 53:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aliyense wabwerera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.3",
            "verseOrgIds": [
              "PSA.53.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:3"
      },
      "items": [
        {
          "text": "iwo onse pamodzi akhala oyipa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.3",
            "verseOrgIds": [
              "PSA.53.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 53:3"
      },
      "items": [
        {
          "text": "palibe ndi mmodzi yemwe amene amachita chabwino,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.3",
            "verseOrgIds": [
              "PSA.53.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:3"
      },
      "items": [
        {
          "text": "ngakhale mmodzi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.3",
            "verseOrgIds": [
              "PSA.53.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 53:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi anthu ochita zoyipawa adzaphunziradi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.4",
            "verseOrgIds": [
              "PSA.53.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:4"
      },
      "items": [
        {
          "text": "anthu amene amadya anthu anga monga mmene anthu amadyera buledi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.4",
            "verseOrgIds": [
              "PSA.53.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:4"
      },
      "items": [
        {
          "text": "ndipo sapemphera kwa Mulungu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.4",
            "verseOrgIds": [
              "PSA.53.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 53:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anali pamenepo atathedwa nzeru ndi mantha aakulu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.5",
            "verseOrgIds": [
              "PSA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:5"
      },
      "items": [
        {
          "text": "pamene panalibe kanthu kochititsa mantha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.5",
            "verseOrgIds": [
              "PSA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 53:5"
      },
      "items": [
        {
          "text": "Mulungu anamwazamwaza mafupa a anthu amene anakuthirani nkhondo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.5",
            "verseOrgIds": [
              "PSA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:5"
      },
      "items": [
        {
          "text": "inuyo munawachititsa manyazi, pakuti Mulungu anawanyoza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.5",
            "verseOrgIds": [
              "PSA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 53:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndithu, chipulumutso cha Israeli nʼchochokera ku Ziyoni!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.6",
            "verseOrgIds": [
              "PSA.53.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:6"
      },
      "items": [
        {
          "text": "Pamene Mulungu adzabwezeretsanso ulemerero wa anthu ake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.6",
            "verseOrgIds": [
              "PSA.53.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:6"
      },
      "items": [
        {
          "text": "lolani Yakobo akondwere ndi Israeli asangalale!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.6",
            "verseOrgIds": [
              "PSA.53.7"
            ]
          }
        }
      ]
    }
  ],
