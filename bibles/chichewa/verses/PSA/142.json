  "verseCount": 7,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "142",
        "style": "c",
        "sid": "PSA 142"
      },
      "items": [
        {
          "text": "142",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 142",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Ndakatulo ya Davide, pamene iyeyo anali mʼphanga. Pemphero.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 142:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikulirira Yehova mofuwula;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.1",
            "verseOrgIds": [
              "PSA.142.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:1"
      },
      "items": [
        {
          "text": "ndikukweza mawu anga kwa Yehova kupempha chifundo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.1",
            "verseOrgIds": [
              "PSA.142.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 142:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikukhuthula madandawulo anga pamaso pake;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.2",
            "verseOrgIds": [
              "PSA.142.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:2"
      },
      "items": [
        {
          "text": "ndikufotokoza za masautso anga pamaso pake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.2",
            "verseOrgIds": [
              "PSA.142.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 142:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene mzimu wanga walefuka mʼkati mwanga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.3",
            "verseOrgIds": [
              "PSA.142.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:3"
      },
      "items": [
        {
          "text": "ndinu amene mudziwa njira yanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.3",
            "verseOrgIds": [
              "PSA.142.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 142:3"
      },
      "items": [
        {
          "text": "Mʼnjira imene ndimayendamo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.3",
            "verseOrgIds": [
              "PSA.142.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:3"
      },
      "items": [
        {
          "text": "anthu anditchera msampha mobisa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.3",
            "verseOrgIds": [
              "PSA.142.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 142:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yangʼanani kumanja kwanga ndipo onani;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.4",
            "verseOrgIds": [
              "PSA.142.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:4"
      },
      "items": [
        {
          "text": "palibe amene akukhudzika nane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.4",
            "verseOrgIds": [
              "PSA.142.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 142:4"
      },
      "items": [
        {
          "text": "Ndilibe pothawira;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.4",
            "verseOrgIds": [
              "PSA.142.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:4"
      },
      "items": [
        {
          "text": "palibe amene amasamala za moyo wanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.4",
            "verseOrgIds": [
              "PSA.142.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 142:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndilirira Inu Yehova;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.5",
            "verseOrgIds": [
              "PSA.142.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:5"
      },
      "items": [
        {
          "text": "ndikuti, \"Ndinu pothawirapo panga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.5",
            "verseOrgIds": [
              "PSA.142.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:5"
      },
      "items": [
        {
          "text": "gawo langa mʼdziko la anthu amoyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.5",
            "verseOrgIds": [
              "PSA.142.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 142:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mverani kulira kwanga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.6",
            "verseOrgIds": [
              "PSA.142.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:6"
      },
      "items": [
        {
          "text": "pakuti ndathedwa nzeru;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.6",
            "verseOrgIds": [
              "PSA.142.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 142:6"
      },
      "items": [
        {
          "text": "pulumutseni kwa amene akundithamangitsa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.6",
            "verseOrgIds": [
              "PSA.142.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:6"
      },
      "items": [
        {
          "text": "pakuti ndi amphamvu kuposa ine.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.6",
            "verseOrgIds": [
              "PSA.142.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 142:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tulutseni mʼndende yanga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.7",
            "verseOrgIds": [
              "PSA.142.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:7"
      },
      "items": [
        {
          "text": "kuti nditamande dzina lanu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.7",
            "verseOrgIds": [
              "PSA.142.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 142:7"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 142:7"
      },
      "items": [
        {
          "text": "Ndipo anthu olungama adzandizungulira",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.7",
            "verseOrgIds": [
              "PSA.142.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 142:7"
      },
      "items": [
        {
          "text": "chifukwa cha zabwino zanu pa ine.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.142.7",
            "verseOrgIds": [
              "PSA.142.8"
            ]
          }
        }
      ]
    }
  ],
