        "style": "ms"
      },
      "items": [
        {
          "text": "BUKU LACHITATU",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "mr"
      },
      "items": [
        {
          "text": "Masalimo",
          "type": "text"
        },
        {
