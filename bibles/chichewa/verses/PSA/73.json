    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 73",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Salimo la Asafu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 73:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu ndi wabwino ndithu kwa Israeli,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.1",
            "verseOrgIds": [
              "PSA.73.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:1"
      },
      "items": [
        {
          "text": "kwa iwo amene ndi oyera mtima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.1",
            "verseOrgIds": [
              "PSA.73.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 73:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma kunena za ine, mapazi anga anali pafupi kuterereka;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.2",
            "verseOrgIds": [
              "PSA.73.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:2"
      },
      "items": [
        {
          "text": "ndinatsala pangʼono kugwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.2",
            "verseOrgIds": [
              "PSA.73.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 73:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti ndinkachitira nsanje odzitamandira,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.3",
            "verseOrgIds": [
              "PSA.73.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:3"
      },
      "items": [
        {
          "text": "pamene ndinaona mtendere wa anthu oyipa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.3",
            "verseOrgIds": [
              "PSA.73.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 73:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo alibe zosautsa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.4",
            "verseOrgIds": [
              "PSA.73.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:4"
      },
      "items": [
        {
          "text": "matupi awo ndi athanzi ndi amphamvu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.4",
            "verseOrgIds": [
              "PSA.73.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 73:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saona mavuto monga anthu ena;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.5",
            "verseOrgIds": [
              "PSA.73.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:5"
      },
      "items": [
        {
          "text": "sazunzika ngati anthu ena onse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.5",
            "verseOrgIds": [
              "PSA.73.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 73:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼchifukwa chake kunyada kuli monga mkanda wa mʼkhosi mwawo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.6",
            "verseOrgIds": [
              "PSA.73.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:6"
      },
      "items": [
        {
          "text": "amadziveka chiwawa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.6",
            "verseOrgIds": [
              "PSA.73.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 73:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼmitima yawo yokhota mumachokera zolakwa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.7",
            "verseOrgIds": [
              "PSA.73.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:7"
      },
      "items": [
        {
          "text": "zoyipa zochokera mʼmaganizo awo sizidziwa malire.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.7",
            "verseOrgIds": [
              "PSA.73.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 73:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwowo amanyogodola ndi kumayankhula zoyipa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.8",
            "verseOrgIds": [
              "PSA.73.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:8"
      },
      "items": [
        {
          "text": "mwa kudzikuza kwawo amaopseza ena nʼkumati, \"Tikuponderezani.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.8",
            "verseOrgIds": [
              "PSA.73.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 73:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakamwa pawo pamayankhula monyoza Mulungu kumwamba",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.9",
            "verseOrgIds": [
              "PSA.73.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:9"
      },
      "items": [
        {
          "text": "ndipo lilime lawo limayenda pa dziko lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.9",
            "verseOrgIds": [
              "PSA.73.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 73:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼchifukwa chake anthu awo amapita kwa iwowo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.10",
            "verseOrgIds": [
              "PSA.73.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:10"
      },
      "items": [
        {
          "text": "ndi kumwa madzi mochuluka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.10",
            "verseOrgIds": [
              "PSA.73.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 73:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo amati, \"Kodi Mulungu angadziwe bwanji?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.11",
            "verseOrgIds": [
              "PSA.73.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:11"
      },
      "items": [
        {
          "text": "Kodi Wammwambamwamba angadziwe kalikonse?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.11",
            "verseOrgIds": [
              "PSA.73.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 73:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umu ndi mmene oyipa alili;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.12",
            "verseOrgIds": [
              "PSA.73.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:12"
      },
      "items": [
        {
          "text": "nthawi zonse ali pabwino ndipo chuma chawo chimachulukirachulukira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.12",
            "verseOrgIds": [
              "PSA.73.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 73:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndithudi ine ndawusunga pachabe mtima wanga woyera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.13",
            "verseOrgIds": [
              "PSA.73.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:13"
      },
      "items": [
        {
          "text": "pachabe ndasamba mʼmanja mwanga mwa kusalakwa kwanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.13",
            "verseOrgIds": [
              "PSA.73.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 73:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku lonse ndapeza mavuto;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.14",
            "verseOrgIds": [
              "PSA.73.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:14"
      },
      "items": [
        {
          "text": "ndakhala ndi kulangidwa mmawa uliwonse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.14",
            "verseOrgIds": [
              "PSA.73.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 73:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikanati, \"Ndidzayankhula motere,\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.15",
            "verseOrgIds": [
              "PSA.73.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:15"
      },
      "items": [
        {
          "text": "ndikanachita chosakhulupirika kwa ana anu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.15",
            "verseOrgIds": [
              "PSA.73.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 73:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene ndinayesa kuti ndimvetse zonsezi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.16",
            "verseOrgIds": [
              "PSA.73.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:16"
      },
      "items": [
        {
          "text": "zinandisautsa kwambiri",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.16",
            "verseOrgIds": [
              "PSA.73.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 73:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kufikira nditalowa mʼmalo opatulika a Mulungu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.17",
            "verseOrgIds": [
              "PSA.73.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:17"
      },
      "items": [
        {
          "text": "pamenepo ndinamvetsa mathero awo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.17",
            "verseOrgIds": [
              "PSA.73.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
