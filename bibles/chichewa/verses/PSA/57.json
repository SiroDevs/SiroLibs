  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "57",
        "style": "c",
        "sid": "PSA 57"
      },
      "items": [
        {
          "text": "57",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 57",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mtsogoleri wa mayimbidwe. Potsata mayimbidwe a \"Musawononge.\" Ndakatulo ya Davide, pamene anathawa Sauli kupita ku phanga.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 57:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundichitire chifundo, Inu Mulungu mundichitire chifundo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.1",
            "verseOrgIds": [
              "PSA.57.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:1"
      },
      "items": [
        {
          "text": "pakuti mwa Inu moyo wanga umathawiramo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.1",
            "verseOrgIds": [
              "PSA.57.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 57:1"
      },
      "items": [
        {
          "text": "Ndidzathawira mu mthunzi wa mapiko anu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.1",
            "verseOrgIds": [
              "PSA.57.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:1"
      },
      "items": [
        {
          "text": "mpaka chiwonongeko chitapita.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.1",
            "verseOrgIds": [
              "PSA.57.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 57:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndikufuwulira kwa Mulungu Wammwambamwamba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.2",
            "verseOrgIds": [
              "PSA.57.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:2"
      },
      "items": [
        {
          "text": "kwa Mulungu amene amakwaniritsa cholinga chake pa ine.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.2",
            "verseOrgIds": [
              "PSA.57.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 57:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu amanditumizira kuchokera kumwamba ndi kundipulumutsa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.3",
            "verseOrgIds": [
              "PSA.57.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:3"
      },
      "items": [
        {
          "text": "kudzudzula iwo amene akundithamangitsa kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.3",
            "verseOrgIds": [
              "PSA.57.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:3"
      },
      "items": [
        {
          "text": "Mulungu amatumiza chikondi chake ndi kukhulupirika kwake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.3",
            "verseOrgIds": [
              "PSA.57.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 57:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndili pakati pa mikango,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.4",
            "verseOrgIds": [
              "PSA.57.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:4"
      },
      "items": [
        {
          "text": "ndagona pakati pa zirombo zolusa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.4",
            "verseOrgIds": [
              "PSA.57.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 57:4"
      },
      "items": [
        {
          "text": "anthu amene mano awo ndi milomo yawo ndi mivi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.4",
            "verseOrgIds": [
              "PSA.57.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:4"
      },
      "items": [
        {
          "text": "malilime awo ndi malupanga akuthwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.4",
            "verseOrgIds": [
              "PSA.57.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 57:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukwezekedwe Inu Mulungu, kuposa mayiko onse akumwamba;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.5",
            "verseOrgIds": [
              "PSA.57.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:5"
      },
      "items": [
        {
          "text": "mulole kuti ulemerero wanu ukhale pa dziko lonse lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.5",
            "verseOrgIds": [
              "PSA.57.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 57:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anatchera mapazi anga ukonde",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.6",
            "verseOrgIds": [
              "PSA.57.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:6"
      },
      "items": [
        {
          "text": "ndipo ndinawerama pansi mosautsidwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.6",
            "verseOrgIds": [
              "PSA.57.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 57:6"
      },
      "items": [
        {
          "text": "Anakumba dzenje mʼnjira yanga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.6",
            "verseOrgIds": [
              "PSA.57.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:6"
      },
      "items": [
        {
          "text": "koma agweramo okha mʼmenemo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.6",
            "verseOrgIds": [
              "PSA.57.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 57:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtima wanga ndi wokhazikika, Inu Mulungu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.7",
            "verseOrgIds": [
              "PSA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:7"
      },
      "items": [
        {
          "text": "mtima wanga ndi wokhazikika.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.7",
            "verseOrgIds": [
              "PSA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:7"
      },
      "items": [
        {
          "text": "Ndidzayimba nyimbo, nyimbo yake yamatamando.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.7",
            "verseOrgIds": [
              "PSA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 57:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzuka moyo wanga!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.8",
            "verseOrgIds": [
              "PSA.57.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:8"
      },
      "items": [
        {
          "text": "Dzukani zeze ndi pangwe!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.8",
            "verseOrgIds": [
              "PSA.57.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:8"
      },
      "items": [
        {
          "text": "Ndidzadzuka mʼbandakucha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.8",
            "verseOrgIds": [
              "PSA.57.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 57:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzakutamandani Ambuye, pakati pa mitundu ya anthu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.9",
            "verseOrgIds": [
              "PSA.57.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:9"
      },
      "items": [
        {
          "text": "ndidzayimba za Inu pakati pa mayiko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.9",
            "verseOrgIds": [
              "PSA.57.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 57:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti chikondi chanu nʼchachikulu, kufikira ku mayiko akumwamba;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.10",
            "verseOrgIds": [
              "PSA.57.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:10"
      },
      "items": [
        {
          "text": "kukhulupirika kwanu kwafika ku mitambo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.10",
            "verseOrgIds": [
              "PSA.57.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 57:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukwezekedwe Inu Mulungu kuposa mayiko akumwamba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.11",
            "verseOrgIds": [
              "PSA.57.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:11"
      },
      "items": [
        {
          "text": "mulole kuti ulemerero wanu ukhale pa dziko lonse lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.11",
            "verseOrgIds": [
              "PSA.57.12"
            ]
          }
        }
      ]
    }
  ],
