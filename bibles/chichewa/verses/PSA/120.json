      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 120",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Nyimbo yoyimba pokwera ku Yerusalemu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 120:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndimafuwulira kwa Yehova mʼmasautso anga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.1",
            "verseOrgIds": [
              "PSA.120.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 120:1"
      },
      "items": [
        {
          "text": "ndipo Iye amandiyankha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.1",
            "verseOrgIds": [
              "PSA.120.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 120:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pulumutseni Yehova ku milomo yabodza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.2",
            "verseOrgIds": [
              "PSA.120.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 120:2"
      },
      "items": [
        {
          "text": "ndi kwa anthu achinyengo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.2",
            "verseOrgIds": [
              "PSA.120.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 120:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi adzakuchitani chiyani,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.3",
            "verseOrgIds": [
              "PSA.120.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 120:3"
      },
      "items": [
        {
          "text": "ndipo adzawonjezerapo zotani, inu anthu achinyengo?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.3",
            "verseOrgIds": [
              "PSA.120.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 120:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adzakulangani ndi mivi yakuthwa ya munthu wankhondo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.4",
            "verseOrgIds": [
              "PSA.120.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 120:4"
      },
      "items": [
        {
          "text": "ndi makala oyaka a mtengo wa tsanya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.4",
            "verseOrgIds": [
              "PSA.120.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 120:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsoka ine kuti ndimakhala ku Mesaki,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.5",
            "verseOrgIds": [
              "PSA.120.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 120:5"
      },
      "items": [
        {
          "text": "kuti ndimakhala pakati pa matenti a ku Kedara!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.5",
            "verseOrgIds": [
              "PSA.120.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 120:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa nthawi yayitali ndakhala pakati",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.6",
            "verseOrgIds": [
              "PSA.120.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 120:6"
      },
      "items": [
        {
          "text": "pa iwo amene amadana ndi mtendere.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.6",
            "verseOrgIds": [
              "PSA.120.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 120:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndine munthu wamtendere;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.7",
            "verseOrgIds": [
              "PSA.120.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 120:7"
      },
      "items": [
        {
          "text": "koma ndikamayankhula, iwo amafuna nkhondo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.7",
            "verseOrgIds": [
              "PSA.120.7"
            ]
          }
        }
      ]
    }
  ],
