    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Salimo la Davide. Atathawa mwana wake Abisalomu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Yehova, achulukadi adani anga!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.1",
            "verseOrgIds": [
              "PSA.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 3:1"
      },
      "items": [
        {
          "text": "Achulukadi amene andiwukira!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.1",
            "verseOrgIds": [
              "PSA.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambiri akunena za ine kuti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.2",
            "verseOrgIds": [
              "PSA.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 3:2"
      },
      "items": [
        {
          "text": "\"Mulungu sadzamupulumutsa.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.2",
            "verseOrgIds": [
              "PSA.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "PSA 3:2"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.3.2",
                "verseOrgIds": [
                  "PSA.3.3"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Inu Yehova, ndinu chishango chonditeteza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.3",
            "verseOrgIds": [
              "PSA.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 3:3"
      },
      "items": [
        {
          "text": "Inu mwandiveka ulemerero ndipo mwanditukula.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.3",
            "verseOrgIds": [
              "PSA.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa Yehova, Ine ndilira mofuwula",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.4",
            "verseOrgIds": [
              "PSA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 3:4"
      },
      "items": [
        {
          "text": "ndipo Iye amandiyankha kuchokera ku phiri lake loyera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.4",
            "verseOrgIds": [
              "PSA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "PSA 3:4"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.3.4",
                "verseOrgIds": [
                  "PSA.3.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndimagona ndi kupeza tulo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.5",
            "verseOrgIds": [
              "PSA.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 3:5"
      },
      "items": [
        {
          "text": "ndimadzukanso chifukwa Yehova amandichirikiza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.5",
            "verseOrgIds": [
              "PSA.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sindidzaopa adani anga osawerengeka amene",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.6",
            "verseOrgIds": [
              "PSA.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 3:6"
      },
      "items": [
        {
          "text": "abwera kulimbana nane kuchokera ku madera onse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.6",
            "verseOrgIds": [
              "PSA.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzukani, Inu Yehova!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.7",
            "verseOrgIds": [
              "PSA.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 3:7"
      },
      "items": [
        {
          "text": "Pulumutseni, Inu Mulungu wanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.7",
            "verseOrgIds": [
              "PSA.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 3:7"
      },
      "items": [
        {
          "text": "Akantheni adani anga onse pa msagwada;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.7",
            "verseOrgIds": [
              "PSA.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 3:7"
      },
      "items": [
        {
          "text": "gululani mano a anthu oyipa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.7",
            "verseOrgIds": [
              "PSA.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chipulumutso chimachokera kwa Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.8",
            "verseOrgIds": [
              "PSA.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 3:8"
      },
      "items": [
        {
          "text": "Madalitso akhale pa anthu anu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.8",
            "verseOrgIds": [
              "PSA.3.9"
            ]
          }
        }
      ]
    },
