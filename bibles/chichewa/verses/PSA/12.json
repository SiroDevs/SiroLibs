  "verseCount": 8,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "PSA 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mtsogoleri wa mayimbidwe. Monga mwa mayimbidwe seminiti. Salimo la Davide.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thandizeni Yehova pakuti palibe munthu wokhulupirika;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.1",
            "verseOrgIds": [
              "PSA.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:1"
      },
      "items": [
        {
          "text": "okhulupirika akusowa pakati pa anthu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.1",
            "verseOrgIds": [
              "PSA.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aliyense amanamiza mʼbale wake;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.2",
            "verseOrgIds": [
              "PSA.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:2"
      },
      "items": [
        {
          "text": "ndi pakamwa pawo pabodza amayankhula zachinyengo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.2",
            "verseOrgIds": [
              "PSA.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Yehova tsekani milomo yonse yachinyengo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.3",
            "verseOrgIds": [
              "PSA.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:3"
      },
      "items": [
        {
          "text": "ndi pakamwa paliponse podzikuza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.3",
            "verseOrgIds": [
              "PSA.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakamwa pamene pamati, \"Ife tidzapambana ndi kuyankhula kwathu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.4",
            "verseOrgIds": [
              "PSA.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:4"
      },
      "items": [
        {
          "text": "pakamwapa ndi pathupathu, tsono mbuye wathu ndani?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.4",
            "verseOrgIds": [
              "PSA.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Chifukwa cha kuponderezedwa kwa anthu opanda mphamvu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.5",
            "verseOrgIds": [
              "PSA.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:5"
      },
      "items": [
        {
          "text": "ndi kubuwula kwa anthu osowa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.5",
            "verseOrgIds": [
              "PSA.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 12:5"
      },
      "items": [
        {
          "text": "Ine ndidzauka tsopano,\" akutero Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.5",
            "verseOrgIds": [
              "PSA.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:5"
      },
      "items": [
        {
          "text": "\"Ndidzawateteza kwa owazunza.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.5",
            "verseOrgIds": [
              "PSA.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo mawu a Yehova ndi angwiro",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.6",
            "verseOrgIds": [
              "PSA.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:6"
      },
      "items": [
        {
          "text": "monga siliva oyengedwa mʼngʼanjo yadothi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.6",
            "verseOrgIds": [
              "PSA.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:6"
      },
      "items": [
        {
          "text": "oyengedwa kasanu nʼkawiri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.6",
            "verseOrgIds": [
              "PSA.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Yehova mudzatitchinjiriza ndipo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.7",
            "verseOrgIds": [
              "PSA.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:7"
      },
      "items": [
        {
          "text": "mudzatiteteza kwa anthu otere kwamuyaya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.7",
            "verseOrgIds": [
              "PSA.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyipa amangoyendayenda ponseponse",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.8",
            "verseOrgIds": [
              "PSA.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 12:8"
      },
      "items": [
        {
          "text": "anthu akamayamikira zochita zawo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.12.8",
            "verseOrgIds": [
              "PSA.12.9"
            ]
          }
        }
      ]
    }
  ],
