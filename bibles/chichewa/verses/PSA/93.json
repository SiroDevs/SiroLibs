      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 93:5"
      },
      "items": [
        {
          "text": "chiyero chimakongoletsa nyumba yanu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.5",
            "verseOrgIds": [
              "PSA.93.5"
            ]
          }
        }
      ]
    },
