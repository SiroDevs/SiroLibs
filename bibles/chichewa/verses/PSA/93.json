          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 93:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyanja zakweza Inu Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.3",
            "verseOrgIds": [
              "PSA.93.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 93:3"
      },
      "items": [
        {
          "text": "nyanja zakweza mawu ake;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.3",
            "verseOrgIds": [
              "PSA.93.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 93:3"
      },
      "items": [
        {
          "text": "nyanja zakweza mafunde ake ochita mkokomo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.3",
            "verseOrgIds": [
              "PSA.93.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 93:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova ndi wamphamvu kupambana mkokomo wa madzi ambiri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.4",
            "verseOrgIds": [
              "PSA.93.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 93:4"
      },
      "items": [
        {
          "text": "ndi wamphamvu kupambana mafunde a nyanja,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.4",
            "verseOrgIds": [
              "PSA.93.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 93:4"
      },
      "items": [
        {
          "text": "Yehova mmwamba ndi wamphamvu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.4",
            "verseOrgIds": [
              "PSA.93.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
