  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "50",
        "style": "c",
        "sid": "PSA 50"
      },
      "items": [
        {
          "text": "50",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 50",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Salimo la Asafu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 50:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamphamvuyo, Yehova Mulungu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.1",
            "verseOrgIds": [
              "PSA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:1"
      },
      "items": [
        {
          "text": "akuyankhula ndi kuyitanitsa dziko lapansi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.1",
            "verseOrgIds": [
              "PSA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:1"
      },
      "items": [
        {
          "text": "kuyambira kotulukira dzuwa mpaka kumene limalowera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.1",
            "verseOrgIds": [
              "PSA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 50:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchokera ku Ziyoni, mokongola kwambiri",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.2",
            "verseOrgIds": [
              "PSA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:2"
      },
      "items": [
        {
          "text": "Mulungu akuwala.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.2",
            "verseOrgIds": [
              "PSA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 50:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu wathu akubwera ndipo sadzakhala chete;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.3",
            "verseOrgIds": [
              "PSA.50.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:3"
      },
      "items": [
        {
          "text": "moto ukunyeketsa patsogolo pake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.3",
            "verseOrgIds": [
              "PSA.50.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:3"
      },
      "items": [
        {
          "text": "ndipo pomuzungulira pali mphepo yamkuntho",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.3",
            "verseOrgIds": [
              "PSA.50.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 50:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akuyitanitsa zamumlengalenga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.4",
            "verseOrgIds": [
              "PSA.50.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:4"
      },
      "items": [
        {
          "text": "ndi za pa dziko lapansi kuti aweruze anthu ake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.4",
            "verseOrgIds": [
              "PSA.50.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 50:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundisonkhanitsire okhulupirika anga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.5",
            "verseOrgIds": [
              "PSA.50.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:5"
      },
      "items": [
        {
          "text": "amene anachita pangano ndi ine pochita nsembe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.5",
            "verseOrgIds": [
              "PSA.50.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 50:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo mayiko akumwamba akulengeza chilungamo chake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.6",
            "verseOrgIds": [
              "PSA.50.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:6"
      },
      "items": [
        {
          "text": "pakuti Mulungu mwini ndi woweruza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.6",
            "verseOrgIds": [
              "PSA.50.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 50:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imvani inu anthu anga, ndipo Ine ndidzayankhula,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.7",
            "verseOrgIds": [
              "PSA.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:7"
      },
      "items": [
        {
          "text": "iwe Israeli, ndipo Ine ndidzayankhula mokutsutsa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.7",
            "verseOrgIds": [
              "PSA.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:7"
      },
      "items": [
        {
          "text": "ndine Mulungu, Mulungu wako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.7",
            "verseOrgIds": [
              "PSA.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 50:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sindikudzudzula chifukwa cha nsembe zako,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.8",
            "verseOrgIds": [
              "PSA.50.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:8"
      },
      "items": [
        {
          "text": "kapena nsembe zako zopsereza zimene zili pamaso panga nthawi zonse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.8",
            "verseOrgIds": [
              "PSA.50.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 50:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine sindikufuna ngʼombe yayimuna kuchokera mʼkhola lako",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.9",
            "verseOrgIds": [
              "PSA.50.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:9"
      },
      "items": [
        {
          "text": "kapena mbuzi za mʼkhola lako,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.9",
            "verseOrgIds": [
              "PSA.50.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 50:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "pakuti nyama iliyonse yakunkhalango ndi yanga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.10",
            "verseOrgIds": [
              "PSA.50.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:10"
      },
      "items": [
        {
          "text": "ndiponso ngʼombe za ku mapiri ochuluka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.10",
            "verseOrgIds": [
              "PSA.50.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 50:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndimadziwa mbalame iliyonse mʼmapiri",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.11",
            "verseOrgIds": [
              "PSA.50.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:11"
      },
      "items": [
        {
          "text": "ndiponso zolengedwa zonse zakutchire ndi zanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.11",
            "verseOrgIds": [
              "PSA.50.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 50:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikanakhala ndi njala sindikanakuwuzani,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.12",
            "verseOrgIds": [
              "PSA.50.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:12"
      },
      "items": [
        {
          "text": "pakuti dziko lonse ndi zonse zimene zili mʼmenemo ndi zanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.12",
            "verseOrgIds": [
              "PSA.50.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 50:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi ndimadya nyama ya ngʼombe zazimuna",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.13",
            "verseOrgIds": [
              "PSA.50.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:13"
      },
      "items": [
        {
          "text": "kapena kumwa magazi a mbuzi?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.13",
            "verseOrgIds": [
              "PSA.50.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 50:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pereka nsembe zachiyamiko kwa Mulungu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.14",
            "verseOrgIds": [
              "PSA.50.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:14"
      },
      "items": [
        {
          "text": "kwaniritsa malonjezo ako kwa Wammwambamwamba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.14",
            "verseOrgIds": [
              "PSA.50.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 50:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo undiyitane pa tsiku lako la masautso;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.15",
            "verseOrgIds": [
              "PSA.50.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:15"
      },
      "items": [
        {
          "text": "Ine ndidzakulanditsa, ndipo udzandilemekeza.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.15",
            "verseOrgIds": [
              "PSA.50.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 50:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma kwa woyipa, Mulungu akuti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.16",
            "verseOrgIds": [
              "PSA.50.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 50:16"
      },
      "items": [
        {
          "text": "\"Kodi uli ndi mphamvu yanji kuti uzinena malamulo anga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.16",
            "verseOrgIds": [
              "PSA.50.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:16"
      },
      "items": [
        {
          "text": "kapena kutenga pangano langa pa milomo yako?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.16",
            "verseOrgIds": [
              "PSA.50.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 50:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe umadana ndi malangizo anga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.50.17",
            "verseOrgIds": [
              "PSA.50.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 50:17"
      },
      "items": [
        {
