        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 71",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 71:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwa Inu Yehova ine ndathawiramo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.1",
            "verseOrgIds": [
              "PSA.71.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:1"
      },
      "items": [
        {
          "text": "musalole kuti ndichititsidwe manyazi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.1",
            "verseOrgIds": [
              "PSA.71.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 71:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundilanditse ndi kundipulumutsa mwa chilungamo chanu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.2",
            "verseOrgIds": [
              "PSA.71.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:2"
      },
      "items": [
        {
          "text": "mutchere khutu lanu ndi kundipulumutsa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.2",
            "verseOrgIds": [
              "PSA.71.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 71:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukhale thanthwe langa lothawirapo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.3",
            "verseOrgIds": [
              "PSA.71.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:3"
      },
      "items": [
        {
          "text": "kumene ine nditha kupita nthawi zonse;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.3",
            "verseOrgIds": [
              "PSA.71.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 71:3"
      },
      "items": [
        {
          "text": "lamulani kuti ndipulumuke,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.3",
            "verseOrgIds": [
              "PSA.71.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:3"
      },
      "items": [
        {
          "text": "pakuti Inu ndinu thanthwe langa ndi linga langa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.3",
            "verseOrgIds": [
              "PSA.71.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 71:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Landitseni Inu Mulungu wanga, kuchoka mʼdzanja la oyipa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.4",
            "verseOrgIds": [
              "PSA.71.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:4"
      },
      "items": [
        {
          "text": "kuchoka mʼdzanja la oyipa ndi anthu ankhanza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.4",
            "verseOrgIds": [
              "PSA.71.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 71:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti Inu mwakhala chiyembekezo changa, Inu Ambuye Wamphamvuzonse,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.5",
            "verseOrgIds": [
              "PSA.71.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:5"
      },
      "items": [
        {
          "text": "chilimbikitso changa kuyambira ndili mwana.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.5",
            "verseOrgIds": [
              "PSA.71.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 71:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyambira pamene ndinabadwa, ndakhala ndikudalira Inu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.6",
            "verseOrgIds": [
              "PSA.71.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:6"
      },
      "items": [
        {
          "text": "Inu munanditulutsa mʼmimba mwa amayi anga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.6",
            "verseOrgIds": [
              "PSA.71.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:6"
      },
      "items": [
        {
          "text": "ndipo ndidzakupembedzani nthawi zonse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.6",
            "verseOrgIds": [
              "PSA.71.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 71:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndakhala chinthu chodabwitsa kwa anthu ambiri",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.7",
            "verseOrgIds": [
              "PSA.71.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:7"
      },
      "items": [
        {
          "text": "koma Inu ndinu wonditchinjiriza wamphamvu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.7",
            "verseOrgIds": [
              "PSA.71.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 71:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakamwa panga padzaza ndi matamando anu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.8",
            "verseOrgIds": [
              "PSA.71.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:8"
      },
      "items": [
        {
          "text": "kulengeza ulemerero wanu tsiku lonse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.8",
            "verseOrgIds": [
              "PSA.71.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 71:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musanditaye pamene ndakalamba;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.9",
            "verseOrgIds": [
              "PSA.71.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:9"
      },
      "items": [
        {
          "text": "musandisiye pamene mphamvu zanga zatha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.9",
            "verseOrgIds": [
              "PSA.71.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 71:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti adani anga ayankhula motsutsana nane;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.10",
            "verseOrgIds": [
              "PSA.71.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:10"
      },
      "items": [
        {
          "text": "iwo amene amadikira kuti andiphe amapangana pamodzi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.10",
            "verseOrgIds": [
              "PSA.71.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 71:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo amati, \"Mulungu wamusiya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.11",
            "verseOrgIds": [
              "PSA.71.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:11"
      },
      "items": [
        {
          "text": "mutsatireni ndi kumugwira,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.11",
            "verseOrgIds": [
              "PSA.71.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:11"
      },
      "items": [
        {
          "text": "pakuti palibe amene adzamupulumutse.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.11",
            "verseOrgIds": [
              "PSA.71.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 71:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musakhale kutali ndi ine Inu Mulungu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.12",
            "verseOrgIds": [
              "PSA.71.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:12"
      },
      "items": [
        {
          "text": "bwerani msanga, Inu Mulungu wanga; thandizeni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.12",
            "verseOrgIds": [
              "PSA.71.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 71:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ondineneza anga awonongeke mwa manyazi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.13",
            "verseOrgIds": [
              "PSA.71.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:13"
      },
      "items": [
        {
          "text": "iwo amene akufuna kundipweteka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.13",
            "verseOrgIds": [
              "PSA.71.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:13"
      },
      "items": [
        {
          "text": "avale chitonzo ndi manyazi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.13",
            "verseOrgIds": [
              "PSA.71.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 71:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ine ndidzakhala ndi chiyembekezo mwa Inu nthawi zonse,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.14",
            "verseOrgIds": [
              "PSA.71.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:14"
      },
      "items": [
        {
          "text": "ndidzakutamandani mowirikizawirikiza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.14",
            "verseOrgIds": [
              "PSA.71.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 71:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakamwa panga padzafotokoza za chilungamo chanu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.15",
            "verseOrgIds": [
              "PSA.71.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:15"
      },
      "items": [
        {
          "text": "za chipulumutso chanu tsiku lonse,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.15",
            "verseOrgIds": [
              "PSA.71.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:15"
      },
      "items": [
        {
          "text": "ngakhale sindikudziwa muyeso wake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.15",
            "verseOrgIds": [
              "PSA.71.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 71:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzabwera ndi kulengeza za machitidwe amphamvu zanu Inu Ambuye Wamphamvuzonse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.16",
            "verseOrgIds": [
              "PSA.71.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:16"
      },
      "items": [
        {
          "text": "Ndidzalengeza chilungamo chanu, chanu chokha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.16",
            "verseOrgIds": [
              "PSA.71.16"
            ]
