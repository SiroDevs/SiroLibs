  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "40",
        "style": "c",
        "sid": "PSA 40"
      },
      "items": [
        {
          "text": "40",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 40",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mtsogoleri wa mayimbidwe. Salimo la Davide.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 40:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mofatsa ndinadikira Yehova",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.1",
            "verseOrgIds": [
              "PSA.40.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:1"
      },
      "items": [
        {
          "text": "Iye anatembenukira kwa ine ndipo anamva kulira kwanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.1",
            "verseOrgIds": [
              "PSA.40.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 40:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ananditulutsa mʼdzenje lachitayiko,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.2",
            "verseOrgIds": [
              "PSA.40.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:2"
      },
      "items": [
        {
          "text": "mʼthope ndi mʼchithaphwi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.2",
            "verseOrgIds": [
              "PSA.40.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 40:2"
      },
      "items": [
        {
          "text": "Iye anakhazikitsa mapazi anga pa thanthwe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.2",
            "verseOrgIds": [
              "PSA.40.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:2"
      },
      "items": [
        {
          "text": "ndipo anandipatsa malo oyimapo olimba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.2",
            "verseOrgIds": [
              "PSA.40.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 40:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anayika nyimbo yatsopano mʼkamwa mwanga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.3",
            "verseOrgIds": [
              "PSA.40.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:3"
      },
      "items": [
        {
          "text": "nyimbo yamatamando kwa Mulungu wanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.3",
            "verseOrgIds": [
              "PSA.40.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 40:3"
      },
      "items": [
        {
          "text": "Ambiri adzaona,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.3",
            "verseOrgIds": [
              "PSA.40.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:3"
      },
      "items": [
        {
          "text": "nadzaopa ndipo adzakhulupirira Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.3",
            "verseOrgIds": [
              "PSA.40.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 40:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi wodala munthu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.4",
            "verseOrgIds": [
              "PSA.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:4"
      },
      "items": [
        {
          "text": "amakhulupirira Yehova;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.4",
            "verseOrgIds": [
              "PSA.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 40:4"
      },
      "items": [
        {
          "text": "amene sayembekezera kwa odzikuza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.4",
            "verseOrgIds": [
              "PSA.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:4"
      },
      "items": [
        {
          "text": "kapena kwa amene amatembenukira kwa milungu yabodza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.4",
            "verseOrgIds": [
              "PSA.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 40:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zambiri, Yehova Mulungu wanga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.5",
            "verseOrgIds": [
              "PSA.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:5"
      },
      "items": [
        {
          "text": "ndi zodabwitsa zimene Inu mwachita.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.5",
            "verseOrgIds": [
              "PSA.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 40:5"
      },
      "items": [
        {
          "text": "Zinthu zimene munazikonzera ife",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.5",
            "verseOrgIds": [
              "PSA.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:5"
      },
      "items": [
        {
          "text": "palibe amene angathe kukuwerengerani.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.5",
            "verseOrgIds": [
              "PSA.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 40:5"
      },
      "items": [
        {
          "text": "Nditati ndiyankhule ndi kufotokozera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.5",
            "verseOrgIds": [
              "PSA.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:5"
      },
      "items": [
        {
          "text": "zidzakhala zambiri kuzifotokoza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.5",
            "verseOrgIds": [
              "PSA.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 40:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsembe ndi zopereka Inu simuzifuna,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.6",
            "verseOrgIds": [
              "PSA.40.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:6"
      },
      "items": [
        {
          "text": "koma makutu anga mwawatsekula;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.6",
            "verseOrgIds": [
              "PSA.40.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 40:6"
      },
      "items": [
        {
          "text": "zopereka zopsereza ndi zopereka chifukwa cha tchimo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.6",
            "verseOrgIds": [
              "PSA.40.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:6"
      },
      "items": [
        {
          "text": "Inu simunazipemphe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.6",
            "verseOrgIds": [
              "PSA.40.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 40:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotero ndinati, \"Ndili pano, ndabwera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.7",
            "verseOrgIds": [
              "PSA.40.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:7"
      },
      "items": [
        {
          "text": "Mʼbuku mwalembedwa za ine.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.7",
            "verseOrgIds": [
              "PSA.40.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikufuna kuchita chifuniro chanu, Inu Mulungu wanga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.8",
            "verseOrgIds": [
              "PSA.40.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:8"
      },
      "items": [
        {
          "text": "lamulo lanu lili mu mtima mwanga.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.8",
            "verseOrgIds": [
              "PSA.40.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 40:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikulalikira uthenga wa chilungamo chanu mu msonkhano waukulu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.9",
            "verseOrgIds": [
              "PSA.40.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:9"
      },
      "items": [
        {
          "text": "sinditseka milomo yanga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.9",
            "verseOrgIds": [
              "PSA.40.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:9"
      },
      "items": [
        {
          "text": "monga mukudziwa Inu Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.9",
            "verseOrgIds": [
              "PSA.40.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sindibisa chilungamo chanu mu mtima mwanga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.10",
            "verseOrgIds": [
              "PSA.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:10"
      },
      "items": [
        {
          "text": "ndinayankhula za kukhulupirika kwanu ndi chipulumutso chanu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.10",
            "verseOrgIds": [
              "PSA.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 40:10"
      },
      "items": [
        {
          "text": "Ine sindiphimba chikondi chanu ndi choonadi chanu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.10",
            "verseOrgIds": [
              "PSA.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:10"
      },
      "items": [
        {
          "text": "pa msonkhano waukulu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.10",
            "verseOrgIds": [
              "PSA.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 40:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musandichotsere chifundo chanu Yehova;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.11",
            "verseOrgIds": [
              "PSA.40.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:11"
      },
      "items": [
        {
          "text": "chikondi chanu ndi choonadi chanu zinditeteze nthawi zonse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.11",
            "verseOrgIds": [
              "PSA.40.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti mavuto osawerengeka andizungulira;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.12",
            "verseOrgIds": [
              "PSA.40.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:12"
      },
      "items": [
        {
          "text": "machimo anga andigonjetsa, ndipo sindingathe kuona.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.12",
            "verseOrgIds": [
              "PSA.40.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 40:12"
      },
      "items": [
        {
          "text": "Alipo ambiri kuposa tsitsi la mʼmutu mwanga,",
          "type": "text",
