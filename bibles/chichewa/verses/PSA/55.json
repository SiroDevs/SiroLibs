  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "55",
        "style": "c",
        "sid": "PSA 55"
      },
      "items": [
        {
          "text": "55",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 55",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mtsogoleri wa mayimbidwe. Ndakatulo ya Davide. Pa zoyimbira za zingwe.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 55:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mvetserani pemphero langa, Inu Mulungu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.1",
            "verseOrgIds": [
              "PSA.55.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:1"
      },
      "items": [
        {
          "text": "musakufulatire kupempha kwanga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.1",
            "verseOrgIds": [
              "PSA.55.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 55:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mverani ndipo mundiyankhe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.2",
            "verseOrgIds": [
              "PSA.55.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 55:2"
      },
      "items": [
        {
          "text": "Maganizo anga akundisautsa ndipo ndathedwa nzeru",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.2",
            "verseOrgIds": [
              "PSA.55.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 55:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "chifukwa cha mawu a adani anga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.3",
            "verseOrgIds": [
              "PSA.55.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:3"
      },
      "items": [
        {
          "text": "chifukwa cha kupondereza kwa anthu oyipa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.3",
            "verseOrgIds": [
              "PSA.55.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 55:3"
      },
      "items": [
        {
          "text": "pakuti andidzetsera masautso",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.3",
            "verseOrgIds": [
              "PSA.55.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:3"
      },
      "items": [
        {
          "text": "ndipo akundizunza mu mkwiyo wawo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.3",
            "verseOrgIds": [
              "PSA.55.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 55:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtima wanga ukupweteka mʼkati mwanga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.4",
            "verseOrgIds": [
              "PSA.55.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:4"
      },
      "items": [
        {
          "text": "mantha a imfa andigwera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.4",
            "verseOrgIds": [
              "PSA.55.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 55:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mantha ndi kunjenjemera zandizinga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.5",
            "verseOrgIds": [
              "PSA.55.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:5"
      },
      "items": [
        {
          "text": "mantha aakulu andithetsa nzeru.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.5",
            "verseOrgIds": [
              "PSA.55.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 55:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinati, \"Ndithu, ndikanakhala ndi mapiko ankhunda!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.6",
            "verseOrgIds": [
              "PSA.55.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:6"
      },
      "items": [
        {
          "text": "Ndikanawulukira kutali ndi kukapuma.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.6",
            "verseOrgIds": [
              "PSA.55.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 55:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikanathawira kutali",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.7",
            "verseOrgIds": [
              "PSA.55.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:7"
      },
      "items": [
        {
          "text": "ndi kukakhala mʼchipululu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.7",
            "verseOrgIds": [
              "PSA.55.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 55:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikanathamangira kumalo anga a chitetezo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.8",
            "verseOrgIds": [
              "PSA.55.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:8"
      },
      "items": [
        {
          "text": "kutali ndi mphepo yaukali ndi yamkuntho.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.8",
            "verseOrgIds": [
              "PSA.55.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 55:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sokonezani maganizo a oyipa, Inu Ambuye, tsutsani mawu awo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.9",
            "verseOrgIds": [
              "PSA.55.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:9"
      },
      "items": [
        {
          "text": "pakuti ine ndikuona chiwawa ndi mkangano mu mzinda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.9",
            "verseOrgIds": [
              "PSA.55.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 55:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usana ndi usiku iwo akuzungulirazungulira pa makoma ake;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.10",
            "verseOrgIds": [
              "PSA.55.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:10"
      },
      "items": [
        {
          "text": "nkhwidzi ndi kuzunza kuli mʼkati mwake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.10",
            "verseOrgIds": [
              "PSA.55.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 55:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mphamvu zowononga zili pa ntchito mu mzinda;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.11",
            "verseOrgIds": [
              "PSA.55.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:11"
      },
      "items": [
        {
          "text": "kuopseza ndi mabodza sizichoka mʼmisewu yake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.11",
            "verseOrgIds": [
              "PSA.55.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 55:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanakhala mdani akundinyoza, ine",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.12",
            "verseOrgIds": [
              "PSA.55.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:12"
      },
      "items": [
        {
          "text": "ndikanapirira;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.12",
            "verseOrgIds": [
              "PSA.55.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 55:12"
      },
      "items": [
        {
          "text": "akanakhala mdani akudzikweza yekha kutsutsana nane,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.12",
            "verseOrgIds": [
              "PSA.55.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:12"
      },
      "items": [
        {
          "text": "ndikanakabisala.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.12",
            "verseOrgIds": [
              "PSA.55.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 55:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma iweyo mnzanga, mnzanga woyenda naye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.13",
            "verseOrgIds": [
              "PSA.55.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:13"
      },
      "items": [
        {
          "text": "bwenzi langa la pondaapanʼpondepo, ndi amene ukuchita zimenezi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.13",
            "verseOrgIds": [
              "PSA.55.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 55:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mnzanga amene nthawi ina tinkasangalala",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.14",
            "verseOrgIds": [
              "PSA.55.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:14"
      },
      "items": [
        {
          "text": "pa chiyanjano chokoma ku nyumba ya Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.14",
            "verseOrgIds": [
              "PSA.55.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 55:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulole imfa itenge adani anga mwadzidzidzi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.15",
            "verseOrgIds": [
              "PSA.55.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:15"
      },
      "items": [
        {
          "text": "alowe mʼmanda ali amoyo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.15",
            "verseOrgIds": [
              "PSA.55.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:15"
      },
      "items": [
        {
          "text": "pakuti choyipa chili pakati pawo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.15",
            "verseOrgIds": [
              "PSA.55.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 55:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ine ndinafuwulira kwa Mulungu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.16",
            "verseOrgIds": [
              "PSA.55.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:16"
      },
      "items": [
        {
          "text": "ndipo Yehova anandipulumutsa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.16",
            "verseOrgIds": [
              "PSA.55.17"
            ]
