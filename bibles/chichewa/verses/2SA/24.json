  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "2SA 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Davide Awerenga Ankhondo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthawi inanso Yehova anawakwiyira Aisraeli ndipo anawutsa mtima wa Davide kuti awavutitse ndipo anati, \"Pita kawerenge Aisraeli ndi Ayuda.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.1",
            "verseOrgIds": [
              "2SA.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho mfumu inati kwa Yowabu pamodzi ndi atsogoleri a ankhondo amene anali nawo. \"Pitani pakati pa mafuko onse a Israeli kuyambira ku Dani mpaka ku Beeriseba kuti mukawerenge anthu omenya nkhondo ndi cholinga choti ndidziwe chiwerengero chawo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.2",
            "verseOrgIds": [
              "2SA.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Yowabu anayankha mfumu kuti, \"Yehova Mulungu wanu achulukitse ankhondo anu kukhala miyandamiyanda, ndipo alole inu mbuye wanga mfumu mudzazione zimenezi. Koma nʼchifukwa chiyani inu mbuye wanga mfumu mukufuna kuchita zimenezi?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.3",
            "verseOrgIds": [
              "2SA.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komabe mawu a mfumu anapambana mawu a Yowabu ndi atsogoleri a ankhondo. Choncho anachoka pamaso pa mfumu kupita kukawerenga anthu omenya nkhondo mu Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.4",
            "verseOrgIds": [
              "2SA.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atawoloka Yorodani, iwo anamanga misasa yawo pafupi ndi Aroeri kummwera kwa mzinda wa ku chigwa ndipo kenaka iwo anapita ku dziko la Gadi mpaka ku Yazeri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.5",
            "verseOrgIds": [
              "2SA.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anapita ku Giliyadi ndi ku chigwa cha Tahitimu Hodisi ndipo anapitirira mpaka ku Dani Yaani ndi madera ozungulira Sidoni.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.6",
            "verseOrgIds": [
              "2SA.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka iwo anapita molunjika linga la ku Turo ndi ku mizinda yonse ya Ahivi ndi Akanaani. Pomaliza anapita ku Beeriseba ku Negevi wa ku Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.7",
            "verseOrgIds": [
              "2SA.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atayendayenda mʼdziko lonse anabwerera ku Yerusalemu patapita miyezi isanu ndi inayi ndi masiku makumi awiri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.8",
            "verseOrgIds": [
              "2SA.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowabu anapereka chiwerengero cha anthu ankhondo kwa mfumu: Mu Israeli munali anthu 800,000 amphamvu amene amadziwa kugwiritsa ntchito lupanga ndipo mu Yuda munali anthu 500,000.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.9",
            "verseOrgIds": [
              "2SA.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davide anatsutsika mu mtima mwake atatha kuwerenga anthuwo ndipo anapemphera kwa Yehova kuti, \"Ine ndachimwa kwambiri pa zimene ndachita. Tsono Yehova, ndikupempha kuti mukhululuke kulakwa kwa mtumiki wanu. Ine ndachita zopusa kwambiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.10",
            "verseOrgIds": [
              "2SA.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davide asanadzuke mmawa mwake mawu a Yehova anafika kwa mneneri Gadi, mlosi wa Davide kuti,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.11",
            "verseOrgIds": [
              "2SA.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pita ukamuwuze Davide kuti, 'Yehova akuti, Ine ndikukupatsa zinthu zitatu izi. Usankhepo chimodzi pa zimenezi choti ndikuchitire.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.12",
            "verseOrgIds": [
              "2SA.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Gadi anapita kwa Davide ndipo anati kwa iye, \"Kodi mungakonde kuti mʼdziko mwanu mukhale njala kwa zaka zitatu? Kapena kuti mukhale mukuthawa adani anu kwa miyezi itatu? Kapena kuti mʼdziko muno mukhale mliri kwa masiku atatu? Tsopano, ganizirani bwino ndipo musankhe chomwe mudzamuyankhe amene wandituma.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.13",
            "verseOrgIds": [
              "2SA.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davide anati kwa Gadi, \"Ine ndavutika kwambiri mu mtima mwanga. Ife atilange ndi Yehova pakuti chifundo chake ndi chachikulu, koma ndisalangidwe ndi anthu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.14",
            "verseOrgIds": [
              "2SA.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Yehova anabweretsa mliri pa Aisraeli, kuyambira mmawa mpaka pa nthawi imene anafuna mwini wake, ndipo unapha anthu 70,000 kuyambira ku Dani mpaka ku Beeriseba.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.15",
            "verseOrgIds": [
              "2SA.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene mngelo anatambasula dzanja lake kuti awononge Yerusalemu, Yehova anamva chisoni chifukwa cha zowawazo ndipo anati kwa mngelo amene ankawononga anthu uja, \"Basi kwakwanira! Leka kuwononga.\" Nthawi imeneyo mngelo wa Yehova anali atayima pamalo opunthira tirigu a Arauna Myebusi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.16",
            "verseOrgIds": [
              "2SA.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davide ataona mngelo amene ankakantha anthu uja, anati kwa Yehova, \"Ine ndi amene ndachimwa. Ine mʼbusa ndiye ndachita zoyipa. Anthuwa ali ngati nkhosa zosalakwa. Kodi iwowa achita chiyani? Langani ineyo pamodzi ndi banja langa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.17",
            "verseOrgIds": [
              "2SA.24.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Davide Amanga Guwa la Nsembe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku limenelo Gadi anapita kwa Davide ndi kukanena kuti, \"Pitani kamangeni guwa lansembe la Yehova pamalo opunthira tirigu a Arauna Myebusi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.18",
            "verseOrgIds": [
              "2SA.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Davide anapita monga momwe Yehova anamulamulira kudzera mwa Gadi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.19",
            "verseOrgIds": [
              "2SA.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arauna atayangʼana ndi kuona mfumu ndi anthu ake akubwera kumene kunali iye, iyeyo anatuluka ndi kuwerama pamaso pa mfumu mpaka nkhope yake kugunda pansi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.20",
            "verseOrgIds": [
              "2SA.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arauna anati, \"Nʼchifukwa chiyani mbuye wanga mfumu mwabwera kwa mtumiki wanu?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.21",
            "verseOrgIds": [
              "2SA.24.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 24:21"
      },
      "items": [
        {
          "text": "Davide anayankha kuti, \"Kudzagula malo ako opunthira tirigu kuti ndimangire Yehova guwa lansembe kuti mliri uli pa anthuwa usiye.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.21",
            "verseOrgIds": [
              "2SA.24.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arauna anati kwa Davide, \"Mbuye wanga mfumu mutenge chilichonse chimene chikukondweretseni ndi kuchipereka nsembe. Nazi ngʼombe zazimuna za nsembe yopsereza, nazi zopunthira tirigu ndi magoli angʼombe kuti zikhale nkhuni.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.22",
            "verseOrgIds": [
              "2SA.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu mfumu, Arauna akupereka zonsezi kwa inu mfumu.\" Arauna anatinso kwa iye, \"Yehova Mulungu wanu akuvomerezeni.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.23",
            "verseOrgIds": [
              "2SA.24.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma mfumu inayankha Arauna kuti, \"Ayi, Ine ndikunenetsa kuti ndikulipira. Sindidzapereka kwa Yehova Mulungu wanga nsembe yopsereza imene sindinavutikire.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.24",
            "verseOrgIds": [
              "2SA.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 24:24"
      },
      "items": [
        {
          "text": "Kotero Davide anagula malo wopunthira tiriguwo ndi ngʼombe ndipo anapereka kwa Araunayo masekeli asiliva makumi asanu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.24",
            "verseOrgIds": [
              "2SA.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davide anamanga guwa lansembe la Yehova pamenepo ndipo anaperekapo nsembe zopsereza ndi nsembe zachiyanjano. Ndipo Yehova anayankha pempherolo mʼmalo mwa dziko lonse, ndipo mliri unatha pa Aisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.25",
            "verseOrgIds": [
              "2SA.24.25"
            ]
          }
        }
      ]
    }
  ],
