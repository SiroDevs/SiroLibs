  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "1SA 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pemphero la Hana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Hana anapemphera nati,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.1",
            "verseOrgIds": [
              "1SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 2:1"
      },
      "items": [
        {
          "text": "\"Moyo wanga ukukondwera mwa Yehova;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.1",
            "verseOrgIds": [
              "1SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:1"
      },
      "items": [
        {
          "text": "Ndiyenda mwa tukumutukumu chifukwa cha Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.1",
            "verseOrgIds": [
              "1SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 2:1"
      },
      "items": [
        {
          "text": "Pakamwa panga pakula ndi kuseka adani anga mowanyogodola.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.1",
            "verseOrgIds": [
              "1SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:1"
      },
      "items": [
        {
          "text": "Ndikukondwa chifukwa mwandipulumutsa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.1",
            "verseOrgIds": [
              "1SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Palibe wina woyera ngati Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.2",
            "verseOrgIds": [
              "1SA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:2"
      },
      "items": [
        {
          "text": "palibe wina koma inu nokha,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.2",
            "verseOrgIds": [
              "1SA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:2"
      },
      "items": [
        {
          "text": "palibe thanthwe lofanana ndi Mulungu wathu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.2",
            "verseOrgIds": [
              "1SA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Musandiyankhulenso modzitama,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.3",
            "verseOrgIds": [
              "1SA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:3"
      },
      "items": [
        {
          "text": "pakamwa panu pasatuluke zonyada,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.3",
            "verseOrgIds": [
              "1SA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 2:3"
      },
      "items": [
        {
          "text": "pakuti Yehova ndi Mulungu wanzeru,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.3",
            "verseOrgIds": [
              "1SA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:3"
      },
      "items": [
        {
          "text": "ndipo ndiye amene amayesa ntchito za anthu onse.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.3",
            "verseOrgIds": [
              "1SA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mauta a anthu ankhondo athyoka",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.4",
            "verseOrgIds": [
              "1SA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:4"
      },
      "items": [
        {
          "text": "koma anthu ofowoka avala dzilimbe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.4",
            "verseOrgIds": [
              "1SA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amene kale anali okhuta tsopano akukagula chakudya,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.5",
            "verseOrgIds": [
              "1SA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:5"
      },
      "items": [
        {
          "text": "koma iwo amene anali ndi njala sakumvanso njala.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.5",
            "verseOrgIds": [
              "1SA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 2:5"
      },
      "items": [
        {
          "text": "Amene anali wosabereka, wabereka ana aamuna asanu ndi awiri,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.5",
            "verseOrgIds": [
              "1SA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:5"
      },
      "items": [
        {
          "text": "koma iye wobereka ana ambiri watsala yekha.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.5",
            "verseOrgIds": [
              "1SA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yehova amabweretsa imfa ndipo amaperekanso moyo,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.6",
            "verseOrgIds": [
              "1SA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:6"
      },
      "items": [
        {
          "text": "amatsitsira ku manda ndipo amawatulutsakonso.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.6",
            "verseOrgIds": [
              "1SA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova amasaukitsa ndipo amalemeretsa,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.7",
            "verseOrgIds": [
              "1SA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:7"
      },
      "items": [
        {
          "text": "amatsitsa ndipo amakweza.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.7",
            "verseOrgIds": [
              "1SA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amakweza osauka kuwachotsa pa fumbi,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.8",
            "verseOrgIds": [
              "1SA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:8"
      },
      "items": [
        {
          "text": "ndipo amachotsa anthu osowa pa dzala.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.8",
            "verseOrgIds": [
              "1SA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 2:8"
      },
      "items": [
        {
          "text": "Iye amawakhazika pamodzi ndi ana a mafumu,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.8",
            "verseOrgIds": [
              "1SA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:8"
      },
      "items": [
        {
          "text": "amawapatsa mpando waulemu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.8",
            "verseOrgIds": [
              "1SA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1SA 2:8"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 2:8"
      },
      "items": [
        {
          "text": "\"Pakuti nsanamira za dziko lapansi ndi za Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.8",
            "verseOrgIds": [
              "1SA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:8"
      },
      "items": [
        {
          "text": "anakhazika dziko lapansi pa nsanamirazo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.8",
            "verseOrgIds": [
              "1SA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye adzateteza moyo wa anthu okhulupirika",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.9",
            "verseOrgIds": [
              "1SA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:9"
      },
      "items": [
        {
          "text": "koma anthu oyipa adzawonongedwa mu mdima.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.9",
            "verseOrgIds": [
              "1SA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1SA 2:9"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 2:9"
      },
      "items": [
        {
          "text": "\"Pakuti munthu sapambana ndi mphamvu zake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.9",
            "verseOrgIds": [
              "1SA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova adzaphwanya omutsutsa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.10",
            "verseOrgIds": [
              "1SA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 2:10"
      },
      "items": [
        {
          "text": "Adzawaopsa ndi bingu kuchokera kumwamba;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.10",
            "verseOrgIds": [
              "1SA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:10"
      },
      "items": [
        {
          "text": "Yehova adzaweruza mathero a dziko lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.10",
            "verseOrgIds": [
              "1SA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1SA 2:10"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 2:10"
      },
      "items": [
        {
          "text": "\"Koma adzapereka mphamvu kwa mfumu yake,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.10",
            "verseOrgIds": [
              "1SA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:10"
      },
      "items": [
        {
          "text": "adzakuza mphamvu za odzozedwa wake.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.10",
            "verseOrgIds": [
              "1SA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Elikana anapita ku mudzi kwawo ku Rama, koma mnyamatayo amatumikira Yehova pansi pa ulamuliro wa wansembe Eli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.11",
            "verseOrgIds": [
              "1SA.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuyipa kwa Ana a Eli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana a Eli anali ana achabechabe pakuti samasamala za Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.12",
            "verseOrgIds": [
              "1SA.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo chizolowezi cha ansembe pakati pa anthu chinali motere kuti pamene munthu aliyense ankapereka nsembe ndipo nyama ija ikuwira pa moto, mtumiki wa wansembe ankabwera ndi chifoloko cha mano atatu mʼdzanja lake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.13",
            "verseOrgIds": [
              "1SA.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye ankachipisa mu mʼphikamo, ndipo wansembeyo amatenga chilichonse chimene folokoyo yabaya. Umu ndi mmene ansembewo amachitira ndi Aisraeli onse amene amabwera ku Silo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.14",
            "verseOrgIds": [
              "1SA.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo ngakhale mafuta asanatenthedwe, mtumiki wansembe amabwera ndi kunena kwa munthu amene akupereka nsembeyo kuti, \"Ndipatse nyama kuti ndiwotche, pakuti Yehova salandira nyama yophika koma yayiwisi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.15",
            "verseOrgIds": [
              "1SA.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati munthuyo anena kuti, \"Apseretu mafuta poyamba, ndipo kenaka mutenge mmene mufunira,\" mtumikiyo amayankha kuti, \"Ayi ndipatse tsopano lino. Ngati sutero, ine nditenga molanda.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.16",
            "verseOrgIds": [
              "1SA.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tchimo la ana a Eli linali lalikulu kwambiri pamaso pa Yehova pakuti iwo amanyoza nsembe za Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.17",
            "verseOrgIds": [
              "1SA.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Samueli amatumikira pamaso pa Yehova atavala efodi ya nsalu yofewa yosalala.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.18",
            "verseOrgIds": [
              "1SA.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chaka chilichonse amayi ake ankamusokera kamkanjo ndi kukamupatsa akamapita ndi mwamuna wake kukapereka nsembe za pa chaka.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.19",
            "verseOrgIds": [
              "1SA.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Eli amadalitsa Elikana ndi mkazi wake ndi mawu akuti \"Yehova akupatseni ana mwa mkazi uyu kulowa mʼmalo mwa amene anapempha ndi kumupereka kwa Yehova.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.20",
            "verseOrgIds": [
              "1SA.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yehova anamukomera mtima Hana. Anakhala ndi pathupi ndi kubereka ana aamuna atatu ndi ana aakazi awiri. Ndipo Samueli ankakula pamaso pa Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.21",
            "verseOrgIds": [
              "1SA.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Eli anakalamba kwambiri. Iye ankamva zonse zimene ana ake aamuna ankachitira Aisraeli onse, ndiponso kuti ankagona ndi akazi pa chipata cha tenti ya msonkhano.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.22",
            "verseOrgIds": [
              "1SA.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho anawafunsa kuti, \"Nʼchifukwa chiyani mukuchita zinthu zotere? Ine ndikumva kuchokera kwa anthu onse za zoyipa zanuzo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.23",
            "verseOrgIds": [
              "1SA.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi, ana anga si mbiri yabwino imene ndikumva anthu a Mulungu akufalitsa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.24",
            "verseOrgIds": [
              "1SA.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati munthu alakwira munthu mnzake, mwina Mulungu adzamupepesera, koma ngati munthu achimwira Yehova adzamupepesera ndani?\" Koma ana ake sanamvere kudzudzula kwa abambo awo, pakuti chinali cholinga cha Yehova kuti awaphe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.25",
            "verseOrgIds": [
              "1SA.2.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo mnyamata Samueli anapitirira kukula mu msinkhu, ndipo ankapeza kuyanja pamaso pa Yehova ndi anthu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.26",
            "verseOrgIds": [
              "1SA.2.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uneneri Wotsutsa Banja la Eli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku lina munthu wa Mulungu anabwera kwa Eli ndipo anamuwuza kuti, \"Yehova akuti, 'Kodi Ine sindinadziwulule ndekha kwa banja la kholo lako pamene iwo anali akapolo a Farao ku Igupto?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.27",
            "verseOrgIds": [
              "1SA.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo ndinamusankha pakati pa mafuko a Israeli kuti akhale wansembe wanga ndi kuti azipita pa guwa langa la nsembe, kufukiza Lubani ndi kuvala efodi pamaso panga. Ndinapatsa banja la abambo ako gawo la nsembe zonse zopsereza zimene Aisraeli amapereka.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.28",
            "verseOrgIds": [
              "1SA.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼchifukwa chiyani ukunyoza nsembe ndi zopereka zanga zimene ndinalamula? Nʼchifukwa chiyani ukupereka ulemu kwa ana ako kuposa Ine podzinenepetsa nokha ndi zopereka zabwino kwambiri za nsembe zimene Aisraeli amapereka?' \"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.29",
            "verseOrgIds": [
              "1SA.2.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Paja Ine Yehova Mulungu wa Israeli 'Ndinalonjeza kuti anthu a pa banja lako ndi a pa banja la abambo ako azidzanditumikira nthawi zonse.' Koma tsopano ndikuti, 'Zonsezi zithe!' Tsopano anthu amene amandilemekeza Inenso ndidzawalemekeza koma iwo amene amandinyoza Ine ndidzawanyoza.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.30",
            "verseOrgIds": [
              "1SA.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthawi ikubwera imene ndidzachotsa anyamata ako ndi anyamata a pa banja la abambo ako, kotero kuti sipadzakhala munthu wokalamba pa banja lako.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.31",
            "verseOrgIds": [
              "1SA.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1SA 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa mavuto ako udzayangʼana ndi maso ansanje zabwino zimene ndidzachitira Aisraeli ena. Mʼbanja lako simudzapezeka munthu wokalamba.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.32",
            "verseOrgIds": [
              "1SA.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1SA 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komabe pa banja lako mmodzi yekha ndidzamuleka wosamuchotsa kuti azidzanditumikira. Iyeyu azidzakuliritsa ndi kukumvetsa chisoni. Koma ena onse pa banja lako adzafa akanali aangʼono.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.33",
            "verseOrgIds": [
              "1SA.2.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1SA 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ndipo chimene chidzachitike kwa ana ako awiriwa, Hofini ndi Finehasi, chidzakhala chizindikiro kwa iwe. Onse awiri adzafa pa tsiku limodzi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.34",
            "verseOrgIds": [
              "1SA.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1SA 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pambuyo pake ndidzasankha wansembe wokhulupirika, amene adzachita zimene zili mu mtima ndi mʼmaganizo mwanga. Ndidzakhazikitsa banja lako kolimba ndipo adzatumikira pamaso pa wodzozedwa wanga nthawi zonse.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.35",
            "verseOrgIds": [
              "1SA.2.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1SA 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo aliyense wotsala wa banja lako adzabwera ndi kugwada pamaso pake kupempha ndalama kapena chakudya.' Adzati, 'Chonde ndiloleni kuti ndizithandizako pa ntchito iliyonse ya unsembe kuti ndipeze chakudya.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.36",
            "verseOrgIds": [
              "1SA.2.36"
            ]
          }
        }
      ]
    }
  ],
