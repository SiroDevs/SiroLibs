  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "1SA 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Davide Pakati pa Afilisti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davide anaganiza mu mtima mwake nati, \"Tsiku lina ine ndidzaphedwa ndi Sauli. Palibe chabwino ndingachite, koma kuthawira ku dziko la Afilisti. Kotero Sauli adzasiya kundifunafuna mʼdziko lonse la Israeli, ndipo ndidzapulumuka.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.1",
            "verseOrgIds": [
              "1SA.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Davide ndi anthu 600 amene anali nawo anachoka napita kwa Akisi mwana wa Maoki mfumu ya ku Gati.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.2",
            "verseOrgIds": [
              "1SA.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davide anakhala ndi Akisi ku Gati pamodzi ndi ankhondo ake, aliyense ndi banja lake. Davide ali ndi akazi ake awiri, Ahinoamu wa ku Yezireeli ndi Abigayeli wa ku Karimeli, mkazi wamasiye wa Nabala.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.3",
            "verseOrgIds": [
              "1SA.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauli anamva kuti Davide wathawira ku Gati, ndipo sanamufunefunenso.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.4",
            "verseOrgIds": [
              "1SA.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Davide anawuza Akisi kuti, \"Ngati ndapeza kuyanja pamaso panu mundipatse malo dera limodzi la dziko lanu kuti ndizikhala kumeneko. Mtumiki wanu adzakhala mu mzinda waufumu chifukwa chiyani?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.5",
            "verseOrgIds": [
              "1SA.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho tsiku limenelo Akisi anamupatsa Zikilagi ndipo mzindawo wakhala wa mafumu a Yuda mpaka lero.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.6",
            "verseOrgIds": [
              "1SA.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davide anakhala mʼdziko la Afilisti kwa chaka chimodzi ndi miyezi inayi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.7",
            "verseOrgIds": [
              "1SA.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Davide ndi anthu ake ankapita kukathira nkhondo Agesuri, Agirizi ndi Aamaleki. (Mitundu ya anthu imeneyi kuyambira kale inkakhala mʼdziko la pakati pa Suri ndi Igupto).",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.8",
            "verseOrgIds": [
              "1SA.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davide ankati akathira nkhondo dera lina, sankasiya munthu wamoyo, mwamuna kapena mkazi, koma ankatenga nkhosa, ngʼombe, abulu, ngamira ndi zovala, pambuyo pake nʼkubwerera kwa Akisi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.9",
            "verseOrgIds": [
              "1SA.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akisi akafunsa kuti, \"Kodi lero unapita kukathira nkhondo kuti?\" Davide ankayankha kuti, \"Ndinapita kukathira nkhondo kummwera kwa Yuda,\" mwinanso ankanena kuti, \"Ndinapita ku dziko la Ayerahimeeli\" kapenanso ankanena kuti, \"Ndinapita ku dziko la Akeni.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.10",
            "verseOrgIds": [
              "1SA.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davide sankasiya mwamuna kapena mkazi wamoyo kuti akafotokozere anthu a ku Gati zochitikazo kuopa kuti opulumukawo akhoza kudzanena kuti \"Davide watichita zakutizakuti.\" Tsono izi ndi zimene Davide ankachita pamene ankakhala mʼdziko la Afilisti.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.11",
            "verseOrgIds": [
              "1SA.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akisi ankamukhulupirira Davide ndipo ankati mu mtima mwake, \"Davide wadzisandutsa munthu woyipa kwambiri pakati pa anthu ake omwe, Aisraeli. Tsono adzakhala mtumiki wanga mpaka kalekale.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.12",
            "verseOrgIds": [
              "1SA.27.12"
            ]
          }
        }
      ]
    }
  ],
