    "verseCount": 12,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "1",
          "style": "c",
          "sid": "2TH 1"
        },
        "items": [
          {
            "text": "1",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "2TH 1:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Paulo, Silivano ndi Timoteyo.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.1",
              "verseOrgIds": [
                "2TH.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p",
          "vid": "2TH 1:1"
        },
        "items": [
          {
            "text": "Kulembera mpingo wa ku Tesalonika, umene uli mwa Mulungu Atate athu ndi Ambuye Yesu Khristu.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.1",
              "verseOrgIds": [
                "2TH.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "2TH 1:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "Chisomo ndi mtendere kwa inu kuchokera kwa Mulungu Atate ndi Ambuye Yesu Khristu.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.2",
              "verseOrgIds": [
                "2TH.1.2"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Kuyamika ndi Pemphero",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "2TH 1:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ife tiyenera kuyamika Mulungu nthawi zonse chifukwa cha inu abale. Ndipo tiyenera kutero chifukwa chikhulupiriro chanu chikukulirakulirabe, ndiponso chikondi chimene aliyense wa inu ali nacho pa mnzake chikuchulukirachulukirabe.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.3",
              "verseOrgIds": [
                "2TH.1.3"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "2TH 1:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nʼchifukwa chake, timayankhula monyadira mʼmipingo yonse ya Mulungu za kupirira kwanu ndi chikhulupiriro chanu pakati pa masautso onse ndi mayesero amene mukudutsamo.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.4",
              "verseOrgIds": [
                "2TH.1.4"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "2TH 1:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "Zonsezi zikutsimikiza kuti Mulungu amaweruza molungama. Zotsatira zake ndi zakuti mudzatengedwa kukhala oyenera kulowa mu ufumu wa Mulungu umene mukuwuvutikira.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.5",
              "verseOrgIds": [
                "2TH.1.5"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "2TH 1:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Mulungu ndi wolungama ndipo adzalanga amene amakusautsaniwo",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.6",
              "verseOrgIds": [
                "2TH.1.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "2TH 1:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "ndikukupatsani mpumulo amene mukusautsidwa, pamodzi ndi ifenso. Izi zidzachitika Ambuye Yesu akadzaoneka mʼmalawi amoto kuchokera kumwamba pamodzi ndi angelo ake amphamvu.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.7",
              "verseOrgIds": [
                "2TH.1.7"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "2TH 1:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "Iye adzalanga amene sadziwa Mulungu ndi amene samvera Uthenga Wabwino wa Ambuye athu Yesu.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.8",
              "verseOrgIds": [
                "2TH.1.8"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "2TH 1:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Adzalangidwa ndi chiwonongeko chamuyaya ndipo sadzaonanso nkhope ya Ambuye ndi ulemerero wamphamvu zake",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.9",
              "verseOrgIds": [
                "2TH.1.9"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "2TH 1:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "pa tsiku limene iye adzabwera kudzalemekezedwa mwa oyera mtima ndi kuyamikidwa ndi onse amene anakhulupirira. Inu mudzakhala nawo mʼgulumo chifukwa munakhulupirira umboni wathu.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.10",
              "verseOrgIds": [
                "2TH.1.10"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "2TH 1:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nʼchifukwa chake timakupemphererani nthawi zonse, kuti Mulungu wathu akusandutseni oyenera mayitanidwe ake, ndi kuti mwa mphamvu zake akwaniritse cholinga chanu chilichonse chabwino ndi chilichonse chochitika mwachikhulupiriro.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.11",
              "verseOrgIds": [
                "2TH.1.11"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "2TH 1:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ife timapempherera zimenezi kuti dzina la Ambuye athu Yesu lilemekezedwe mwa inu, ndi inu mulemekezedwe mwa Iyeyo. Zonsezi zidzachitika chifukwa cha chisomo cha Mulungu wathu ndi Ambuye Yesu Khristu.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.12",
              "verseOrgIds": [
                "2TH.1.12"
              ]
            }
          }
        ]
      }
    ],
    "next": {
      "id": "2TH.2",
      "number": "2",
      "bookId": "2TH"
    },
    "previous": {
      "id": "2TH.intro",
      "number": "intro",
      "bookId": "2TH"
    }
  },
  "2TH.2": {
    "id": "2TH.2",
    "number": "2",
    "bookId": "2TH",
    "reference": "2 Atesalonika 2",
    "copyright": "The Word of God in Contemporary Chichewa Copyright © 2002, 2016 by Biblica, Inc.® Used by permission of Biblica, Inc.® All rights reserved worldwide. Mawu a Mulungu mu Chichewa Chalero Mwini © 2002, 2016 ndi Biblica, Inc.® Kugwiritsa ntchito mwachilolezo. Umwini ndi otetezedwa pa dziko lonse.",
    "verseCount": 17,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "2",
          "style": "c",
          "sid": "2TH 2"
        },
        "items": [
          {
            "text": "2",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Kubwera kwa Munthu Woyipitsitsa",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "2TH 2:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Pa za kubweranso kwa Ambuye athu Yesu Khristu ndiponso za kusonkhana kwathu kuti tikumane naye, abale, tikukupemphani",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.1",
              "verseOrgIds": [
                "2TH.2.1"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "2TH 2:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "kuti musagwedezeke msanga mʼmaganizo kapena kuopsezedwa ndi uneneri, mbiri kapena kalata yokhala ngati yachokera kwa ife, yonena kuti tsiku lija la Ambuye linafika kale.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.2",
              "verseOrgIds": [
                "2TH.2.2"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "2TH 2:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Musalole kuti wina aliyense akunamizeni mwa njira ina iliyonse. Pakuti tsikulo lisanafike, kudzakhala mpatuko waukulu kwambiri, ndipo kudzaoneka munthu woyipitsitsa uja, munthu woyenera kuwonongedwayo.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.3",
              "verseOrgIds": [
                "2TH.2.3"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "2TH 2:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Iyeyo adzatsutsa ndi kudziyika pamwamba pa chilichonse chimene anthu amachitcha mulungu kapena amachipembedza. Iyeyo adzadzikhazika mʼNyumba ya Mulungu ndi kudzitcha Mulungu.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.4",
              "verseOrgIds": [
                "2TH.2.4"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "2TH 2:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "Kodi simukukumbukira kuti pamene ndinali nanu pamodzi ndinkakuwuzani zimenezi?",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.5",
              "verseOrgIds": [
                "2TH.2.5"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "2TH 2:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ndipo tsopano mukudziwa chimene chikumuletsa kuonekera, koma adzawululika pa nthawi yake yoyenera.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.6",
              "verseOrgIds": [
                "2TH.2.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "2TH 2:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Pakuti mphamvu yobisika yoyipitsitsa ikugwira ntchito ngakhale tsopano; koma amene akutchinga mphamvuyo adzapitiriza kutero mpaka pamene wotchingayo adzachotsedwe.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.7",
              "verseOrgIds": [
                "2TH.2.7"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "2TH 2:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ndipo kenaka woyipitsitsayo adzaonekera, amene Ambuye Yesu adzamugonjetsa ndi mpweya otuluka mʼkamwa mwake ndi kumuwononga ndi ulemerero wa kubwera kwake.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.8",
              "verseOrgIds": [
                "2TH.2.8"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "2TH 2:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Woyipitsitsayo adzabwera ndi mphamvu za Satana. Adzaonetsa mphamvu zake pochita zizindikiro ndi zodabwitsa zachinyengo.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.9",
              "verseOrgIds": [
                "2TH.2.9"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "2TH 2:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "Iye adzagwiritsa ntchito mtundu uliwonse wachinyengo kupusitsa amene akuwonongeka. Iwo akuwonongeka chifukwa akukana kukonda choonadi ndi kuti apulumutsidwe.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.10",
              "verseOrgIds": [
                "2TH.2.10"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "2TH 2:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Chifukwa cha chimenechi, Mulungu akuwatumizira chinyengo chachikulu kuti akhulupirire bodza.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.11",
              "verseOrgIds": [
                "2TH.2.11"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "2TH 2:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "Choncho adzalangidwa onse amene sanakhulupirire choonadi, koma anakondwera mu zoyipa.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.12",
              "verseOrgIds": [
                "2TH.2.12"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Imani Mwamphamvu",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "13",
              "style": "v",
              "sid": "2TH 2:13"
            },
            "items": [
              {
                "text": "13",
                "type": "text"
              }
            ]
          },
          {
            "text": "Koma tiyenera kuyamika Mulungu chifukwa cha inu abale okondedwa mwa Ambuye, pakuti Mulungu anakusankhani pachiyambi pomwe kuti mupulumuke chifukwa cha ntchito yoyeretsa ya Mzimu ndi chikhulupiriro chanu mʼchoonadi.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.13",
              "verseOrgIds": [
                "2TH.2.13"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "14",
              "style": "v",
              "sid": "2TH 2:14"
            },
            "items": [
              {
                "text": "14",
                "type": "text"
              }
            ]
          },
          {
            "text": "Iye anakuyitanirani zimenezi kudzera mwa uthenga wathu wabwino, kuti mulandire nawo ulemerero wa Ambuye athu Yesu Khristu.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.14",
              "verseOrgIds": [
                "2TH.2.14"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "15",
              "style": "v",
              "sid": "2TH 2:15"
            },
            "items": [
              {
                "text": "15",
                "type": "text"
              }
            ]
          },
          {
            "text": "Kotero tsono, abale, imani mwamphamvu ndi kugwiritsa ziphunzitso zimene tinakupatsani kudzera mʼmawu apakamwa kapena kudzera mʼkalata.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.15",
              "verseOrgIds": [
                "2TH.2.15"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "16",
              "style": "v",
              "sid": "2TH 2:16"
            },
            "items": [
              {
                "text": "16",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ambuye athu Yesu Khristu mwini ndi Mulungu Atate wathu, amene anatikonda ife ndipo mwachisomo chake anatipatsa kulimba mtima kwamuyaya ndi chiyembekezo chabwino,",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.16",
              "verseOrgIds": [
                "2TH.2.16"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "17",
              "style": "v",
              "sid": "2TH 2:17"
            },
            "items": [
              {
                "text": "17",
                "type": "text"
              }
            ]
          },
          {
            "text": "akulimbikitseni ndi kukupatsani mphamvu yogwirira ntchito ndi kuyankhula zabwino zilizonse.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.17",
              "verseOrgIds": [
                "2TH.2.17"
              ]
            }
          }
        ]
      }
    ],
    "next": {
      "id": "2TH.3",
      "number": "3",
      "bookId": "2TH"
    },
    "previous": {
      "id": "2TH.1",
      "number": "1",
      "bookId": "2TH"
    }
  },
  "2TH.3": {
    "id": "2TH.3",
    "number": "3",
    "bookId": "2TH",
    "reference": "2 Atesalonika 3",
    "copyright": "The Word of God in Contemporary Chichewa Copyright © 2002, 2016 by Biblica, Inc.® Used by permission of Biblica, Inc.® All rights reserved worldwide. Mawu a Mulungu mu Chichewa Chalero Mwini © 2002, 2016 ndi Biblica, Inc.® Kugwiritsa ntchito mwachilolezo. Umwini ndi otetezedwa pa dziko lonse.",
    "verseCount": 18,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "3",
          "style": "c",
          "sid": "2TH 3"
        },
        "items": [
          {
            "text": "3",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Tipempherereni",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "2TH 3:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Potsiriza, abale, mutipempherere kuti uthenga wa Ambuye ufalikire msanga ndi kulemekezedwa monga momwe munachitira inu.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.1",
              "verseOrgIds": [
                "2TH.3.1"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "2TH 3:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ndipo pempherani kuti tilanditsidwe mʼmanja mwa anthu ovuta ndi oyipa, pakuti si onse amene ali nacho chikhulupiriro.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.2",
              "verseOrgIds": [
                "2TH.3.2"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "2TH 3:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Koma Ambuye ndi wokhulupirika, ndipo adzakulimbikitsani ndi kukutetezani kwa woyipayo.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.3",
              "verseOrgIds": [
                "2TH.3.3"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "2TH 3:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Tili ndi chikhulupiriro mwa Ambuye kuti mukuchita zonse ndipo mudzapitirira kuchita zimene tinakulamulirani.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.4",
              "verseOrgIds": [
                "2TH.3.4"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "2TH 3:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ambuye atsogolere mitima yanu kuti mudziwe chikondi cha Mulungu ndiponso kupirira kumene Khristu amapereka.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.5",
              "verseOrgIds": [
                "2TH.3.5"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Awachenjeza za Kusagwira Ntchito",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "2TH 3:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Abale, tikukulamulani mʼdzina la Ambuye Yesu Khristu, kuti mupewe mʼbale aliyense amene ndi waulesi ndi wachisokonezo, wosafuna kutsata zimene tinakuphunzitsani.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.6",
              "verseOrgIds": [
                "2TH.3.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "2TH 3:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Pakuti inu mukudziwa zimene muyenera kuchita pofuna kutitsatira. Ife sitinali alesi pamene tinali nanu",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.7",
              "verseOrgIds": [
                "2TH.3.7"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "2TH 3:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "ndipo sitinadye chakudya cha aliyense osalipira. Komatu tinkagwira ntchito mwamphamvu usiku ndi usana kuti tisakhale cholemetsa kwa aliyense.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.8",
              "verseOrgIds": [
                "2TH.3.8"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "2TH 3:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Sitinachite zimenezi chifukwa choti tinalibe mphamvu zolamula kuti mutithandize koma kuti tikhale chitsanzo choti mutsatire.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.9",
              "verseOrgIds": [
                "2TH.3.9"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "2TH 3:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "Pakuti ngakhale pamene tinali nanu, tinakupatsani lamulo lakuti, \"Munthu wosafuna kugwira ntchito, asadye.\"",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.10",
              "verseOrgIds": [
                "2TH.3.10"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "2TH 3:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ife tikumva kuti pakati panu pali ena amene ndi alesi. Iwo safuna kugwira ntchito, koma amangolowerera pa za eni.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.11",
              "verseOrgIds": [
                "2TH.3.11"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "2TH 3:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "Mʼdzina la Ambuye Yesu Khristu, tikuwalamula ndi kuwakakamiza kuti azigwira ntchito mwabata ndi kumadya chakudya chodzigwirira ntchito okha.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.12",
              "verseOrgIds": [
                "2TH.3.12"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "13",
              "style": "v",
              "sid": "2TH 3:13"
            },
            "items": [
              {
                "text": "13",
                "type": "text"
              }
            ]
          },
          {
            "text": "Koma inu abale, musatope nʼkuchita zabwino.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.13",
              "verseOrgIds": [
                "2TH.3.13"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "14",
              "style": "v",
              "sid": "2TH 3:14"
            },
            "items": [
              {
                "text": "14",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ngati wina aliyense akana kumvera malangizo athu a mʼkalatayi, mumuonetsetse ameneyo ndipo musayanjane naye kuti achite manyazi.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.14",
              "verseOrgIds": [
                "2TH.3.14"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "15",
              "style": "v",
              "sid": "2TH 3:15"
            },
            "items": [
              {
                "text": "15",
                "type": "text"
              }
            ]
          },
          {
            "text": "Komatu musamutenge kukhala mdani, koma muchenjezeni ngati mʼbale.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.15",
              "verseOrgIds": [
                "2TH.3.15"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Malonje Otsiriza",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "16",
              "style": "v",
              "sid": "2TH 3:16"
            },
            "items": [
              {
                "text": "16",
                "type": "text"
              }
            ]
          },
          {
            "text": "Tsopano Ambuye mwini mtendere akupatseni mtendere nthawi zonse mwa njira iliyonse. Ambuye akhale ndi inu nonse.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.16",
              "verseOrgIds": [
                "2TH.3.16"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "17",
              "style": "v",
              "sid": "2TH 3:17"
            },
            "items": [
              {
                "text": "17",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ine Paulo, ndikulemba malonje awa ndi dzanja langa, chimene ndi chizindikiro chodziwika mʼmakalata anga onse. Umo ndi mmene ndimalembera.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.17",
              "verseOrgIds": [
                "2TH.3.17"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "18",
              "style": "v",
              "sid": "2TH 3:18"
            },
            "items": [
              {
                "text": "18",
                "type": "text"
              }
            ]
          },
          {
            "text": "Chisomo cha Ambuye athu Yesu Khristu chikhale ndi inu nonse.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.18",
              "verseOrgIds": [
                "2TH.3.18"
              ]
            }
          }
        ]
      }
    ],
