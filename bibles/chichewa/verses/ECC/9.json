  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "ECC 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mathero a Zinthu Zonse ndi Wofanana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinalingalira zonse ndanenazi ndipo ndinapeza kuti anthu olungama ndi anthu anzeru ali mʼmanja mwa Mulungu pamodzi ndi zimene amachita, koma palibe amene amadziwa zimene zikumudikira mʼtsogolo mwake, kaya chikondi kapena chidani.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.1",
            "verseOrgIds": [
              "ECC.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onsewa mathero awo ndi amodzi, anthu olungama ndi anthu oyipa, abwino ndi oyipa, oyera ndi odetsedwa, amene amapereka nsembe ndi amene sapereka nsembe.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.2",
            "verseOrgIds": [
              "ECC.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 9:2"
      },
      "items": [
        {
          "text": "Zomwe zimachitikira munthu wabwino,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.2",
            "verseOrgIds": [
              "ECC.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 9:2"
      },
      "items": [
        {
          "text": "zimachitikiranso munthu wochimwa,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.2",
            "verseOrgIds": [
              "ECC.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 9:2"
      },
      "items": [
        {
          "text": "zomwe zimachitikira amene amalumbira,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.2",
            "verseOrgIds": [
              "ECC.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 9:2"
      },
      "items": [
        {
          "text": "zimachitikiranso amene amaopa kulumbira.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.2",
            "verseOrgIds": [
              "ECC.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choyipa chimene chili mʼzonse zochitika pansi ndi ichi: Mathero a zonse ndi amodzi. Ndithu, mitima ya anthu ndi yodzaza ndi zoyipa, ndipo mʼmitima mwawo muli zamisala pamene ali ndi moyo, potsiriza pake iwo amakakhala pamodzi ndi anthu akufa.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.3",
            "verseOrgIds": [
              "ECC.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aliyense amene ali ndi moyo amakhala ndi chiyembekezo, pajatu galu wamoyo aposa mkango wakufa!",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.4",
            "verseOrgIds": [
              "ECC.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti amoyo amadziwa kuti adzafa,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.5",
            "verseOrgIds": [
              "ECC.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 9:5"
      },
      "items": [
        {
          "text": "koma akufa sadziwa kanthu;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.5",
            "verseOrgIds": [
              "ECC.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 9:5"
      },
      "items": [
        {
          "text": "alibe mphotho ina yowonjezera,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.5",
            "verseOrgIds": [
              "ECC.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 9:5"
      },
      "items": [
        {
          "text": "ndipo palibe amene amawakumbukira.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.5",
            "verseOrgIds": [
              "ECC.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chikondi chawo, chidani chawo",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.6",
            "verseOrgIds": [
              "ECC.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 9:6"
      },
      "items": [
        {
          "text": "ndiponso nsanje yawo, zonse zinatha kalekale;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.6",
            "verseOrgIds": [
              "ECC.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 9:6"
      },
      "items": [
        {
          "text": "sadzakhalanso ndi gawo",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.6",
            "verseOrgIds": [
              "ECC.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 9:6"
      },
      "items": [
        {
          "text": "pa zonse zochitika pansi pano.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.6",
            "verseOrgIds": [
              "ECC.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pita, kadye chakudya chako mokondwera ndi kumwa vinyo wako ndi mtima wosangalala, pakuti tsopano Mulungu akukondwera ndi zochita zako.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.7",
            "verseOrgIds": [
              "ECC.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzivala zovala zoyera nthawi zonse, uzidzola mafuta mʼmutu mwako nthawi zonse.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.8",
            "verseOrgIds": [
              "ECC.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzikondwerera moyo pamodzi ndi mkazi wako amene umamukonda, masiku onse a moyo uno wopanda phindu, amene Mulungu wakupatsa pansi pano. Pakuti mkaziyo ndiye gawo la moyo wako pa ntchito yako yolemetsa pansi pano.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.9",
            "verseOrgIds": [
              "ECC.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntchito iliyonse imene ukuyigwira, uyigwire ndi mphamvu zako zonse, pakuti ku manda kumene ukupita kulibe kugwira ntchito, kulibe malingaliro, chidziwitso ndiponso nzeru.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.10",
            "verseOrgIds": [
              "ECC.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndinaonanso chinthu china pansi pano:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.11",
            "verseOrgIds": [
              "ECC.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 9:11"
      },
      "items": [
        {
          "text": "opambana pa kuthamanga si aliwiro,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.11",
            "verseOrgIds": [
              "ECC.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 9:11"
      },
      "items": [
        {
          "text": "kapena opambana pa nkhondo si amphamvu,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.11",
            "verseOrgIds": [
              "ECC.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 9:11"
      },
      "items": [
        {
          "text": "ndiponso okhala ndi chakudya si anzeru,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.11",
            "verseOrgIds": [
              "ECC.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 9:11"
      },
      "items": [
        {
          "text": "kapena okhala ndi chuma si odziwa zambiri,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.11",
            "verseOrgIds": [
              "ECC.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 9:11"
      },
      "items": [
        {
          "text": "kapena okomeredwa mtima si ophunzira;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.11",
            "verseOrgIds": [
              "ECC.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 9:11"
      },
      "items": [
        {
          "text": "koma mwayi umangowagwera onsewa pa nthawi yake.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.11",
            "verseOrgIds": [
              "ECC.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungoti palibe munthu amene amadziwa kuti nthawi yake idzafika liti:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.12",
            "verseOrgIds": [
              "ECC.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 9:12"
      },
      "items": [
        {
          "text": "monga momwe nsomba zimagwidwira mu ukonde,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.12",
            "verseOrgIds": [
              "ECC.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 9:12"
      },
      "items": [
        {
          "text": "kapena mmene mbalame zimakodwera mu msampha,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.12",
            "verseOrgIds": [
              "ECC.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 9:12"
      },
      "items": [
        {
          "text": "chimodzimodzinso anthu amakodwa mu msampha pa nthawi yoyipa,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.12",
            "verseOrgIds": [
              "ECC.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 9:12"
      },
      "items": [
        {
          "text": "pamene tsoka limawagwera mosayembekezera.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.12",
            "verseOrgIds": [
              "ECC.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nzeru Iposa Uchitsiru",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndinaonanso pansi pano chitsanzo ichi cha nzeru chimene chinandikhudza kwambiri:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.13",
            "verseOrgIds": [
              "ECC.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panali mzinda waungʼono umene unali ndi anthu owerengeka. Ndipo mfumu yamphamvu inabwera kudzawuthira nkhondo, inawuzungulira ndi kumanga mitumbira yankhondo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.14",
            "verseOrgIds": [
              "ECC.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono mu mzindamo munali munthu wosauka koma wanzeru, ndipo anapulumutsa mzindawo ndi nzeru zakezo. Koma palibe amene anakumbukira munthu wosaukayo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.15",
            "verseOrgIds": [
              "ECC.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho ine ndinati, \"Nzeru ndi yopambana mphamvu.\" Koma nzeru ya munthu wosauka imanyozedwa, ndipo palibe amene amalabadirako za mawu ake.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.16",
            "verseOrgIds": [
              "ECC.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawu oyankhula mofatsa a munthu wanzeru, anthu amawasamalira kwambiri",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.17",
            "verseOrgIds": [
              "ECC.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
