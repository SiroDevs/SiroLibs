  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "ECC 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Matsoka ndi Mavuto a Moyo Uno",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinayangʼananso ndi kuona chipsinjo chimene chimachitika pansi pano:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.1",
            "verseOrgIds": [
              "ECC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:1"
      },
      "items": [
        {
          "text": "ndinaona misozi ya anthu opsinjika,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.1",
            "verseOrgIds": [
              "ECC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:1"
      },
      "items": [
        {
          "text": "ndipo iwo alibe owatonthoza;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.1",
            "verseOrgIds": [
              "ECC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:1"
      },
      "items": [
        {
          "text": "mphamvu zinali ndi anthu owapsinjawo",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.1",
            "verseOrgIds": [
              "ECC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:1"
      },
      "items": [
        {
          "text": "ndipo iwonso analibe owatonthoza.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.1",
            "verseOrgIds": [
              "ECC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo ndinanena kuti akufa,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.2",
            "verseOrgIds": [
              "ECC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:2"
      },
      "items": [
        {
          "text": "amene anafa kale,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.2",
            "verseOrgIds": [
              "ECC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:2"
      },
      "items": [
        {
          "text": "ndi osangalala kuposa amoyo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.2",
            "verseOrgIds": [
              "ECC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:2"
      },
      "items": [
        {
          "text": "amene akanalibe ndi moyo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.2",
            "verseOrgIds": [
              "ECC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma wopambana onsewa",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.3",
            "verseOrgIds": [
              "ECC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:3"
      },
      "items": [
        {
          "text": "ndi amene sanabadwe,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.3",
            "verseOrgIds": [
              "ECC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:3"
      },
      "items": [
        {
          "text": "amene sanaone zoyipa",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.3",
            "verseOrgIds": [
              "ECC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:3"
      },
      "items": [
        {
          "text": "zimene chimachitika pansi pano.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.3",
            "verseOrgIds": [
              "ECC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo ndinazindikira kuti ntchito zonse zolemetsa ndiponso ntchito zonse zaluso zimachitika chifukwa choti wina akuchitira nsanje mnzake. Izinso ndi zopandapake, nʼkungodzivuta chabe.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.4",
            "verseOrgIds": [
              "ECC.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chitsiru chimangoti manja ake lobodo",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.5",
            "verseOrgIds": [
              "ECC.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:5"
      },
      "items": [
        {
          "text": "ndi kudzipha chokha ndi njala.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.5",
            "verseOrgIds": [
              "ECC.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼkwabwino kukhala ndi dzanja limodzi lodzaza uli pa mtendere,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.6",
            "verseOrgIds": [
              "ECC.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:6"
      },
      "items": [
        {
          "text": "kuposa kukhala ndi manja awiri odzaza uli pa mavuto,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.6",
            "verseOrgIds": [
              "ECC.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:6"
      },
      "items": [
        {
          "text": "ndipo uku nʼkungodzivuta chabe.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.6",
            "verseOrgIds": [
              "ECC.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinaonanso chinthu china chopanda phindu pansi pano:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.7",
            "verseOrgIds": [
              "ECC.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panali munthu amene anali yekhayekha;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:8"
      },
      "items": [
        {
          "text": "analibe mwana kapena mʼbale.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:8"
      },
      "items": [
        {
          "text": "Ntchito yake yolemetsa sinkatha,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:8"
      },
      "items": [
        {
          "text": "ndipo maso ake sankakhutitsidwa ndi chuma chake.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:8"
      },
      "items": [
        {
          "text": "Iye anadzifunsa kuti, \"Kodi ntchito yosautsayi ndikuyigwirira yani?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:8"
      },
      "items": [
        {
          "text": "Nanga nʼchifukwa chiyani ndikudzimana chisangalalo?\"",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:8"
      },
      "items": [
        {
          "text": "Izinso ndi zopandapake,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:8"
      },
      "items": [
        {
          "text": "zosasangalatsa!",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukhala awiri nʼkwabwino kuposa kukhala wekha,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.9",
            "verseOrgIds": [
              "ECC.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:9"
      },
      "items": [
        {
          "text": "chifukwa ntchito ya anthu awiri ili ndi phindu:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.9",
            "verseOrgIds": [
              "ECC.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati winayo agwa,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.10",
            "verseOrgIds": [
              "ECC.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:10"
      },
      "items": [
        {
          "text": "mnzakeyo adzamudzutsa.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.10",
            "verseOrgIds": [
              "ECC.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:10"
      },
      "items": [
        {
          "text": "Koma tsoka kwa munthu amene agwa",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.10",
            "verseOrgIds": [
              "ECC.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:10"
      },
      "items": [
        {
          "text": "ndipo alibe wina woti amudzutse!",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.10",
            "verseOrgIds": [
              "ECC.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komanso ngati anthu awiri agona malo amodzi, adzafunditsana.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.11",
            "verseOrgIds": [
              "ECC.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:11"
      },
      "items": [
        {
          "text": "Koma nanga mmodzi angadzifunditse yekha?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.11",
            "verseOrgIds": [
              "ECC.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthu mmodzi angathe kugonjetsedwa,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.12",
            "verseOrgIds": [
              "ECC.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:12"
      },
      "items": [
        {
          "text": "koma anthu awiri akhoza kudziteteza.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.12",
            "verseOrgIds": [
              "ECC.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:12"
      },
      "items": [
        {
          "text": "Chingwe cha maulusi atatu sichidukirapo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.12",
            "verseOrgIds": [
              "ECC.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kutukuka Nʼkopandapake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wachinyamata wosauka koma wanzeru aposa mfumu yokalamba koma yopusa imene simvanso malangizo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.13",
            "verseOrgIds": [
              "ECC.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wachinyamatayo angathe kuchokera ku ndende ndi kudzakhala mfumu, kapena angathe kubadwa wosauka mʼdziko la mfumuyo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.14",
            "verseOrgIds": [
              "ECC.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo ndinaona kuti iwo onse amene anakhala ndi moyo ndi kuyenda pansi pano anatsatira wachinyamatayo, amene anatenga malo a mfumu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.15",
            "verseOrgIds": [
              "ECC.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu ikhoza kulamulira anthu osawerengeka, komabe itamwalira, palibe amene adzayamikire zomwe mfumuyo inachita. Izinso ndi zopandapake, nʼkungozivuta chabe.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.16",
            "verseOrgIds": [
              "ECC.4.16"
            ]
          }
        }
