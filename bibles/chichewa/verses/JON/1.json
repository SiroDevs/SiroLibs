  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "JON 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yona Athawa Yehova",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JON 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anayankhula ndi Yona mwana wa Amitai kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.1",
            "verseOrgIds": [
              "JON.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JON 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nyamuka, pita ku mzinda waukulu wa Ninive ndipo ukalalikire motsutsana nawo, chifukwa zoyipa zawo zafika pamaso panga.\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.2",
            "verseOrgIds": [
              "JON.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JON 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Yona anathawa Yehova ndi kulowera ku Tarisisi. Anapita ku Yopa, kumene anapeza sitima yapamadzi yopita ku Tarisisi. Atagula chiphaso, anakwera sitimayo kupita ku Tarisisi kuthawa Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.3",
            "verseOrgIds": [
              "JON.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JON 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Yehova anatumiza chimphepo champhamvu pa nyanja, ndipo panauka namondwe wamphamvu amene anafuna kuphwanya sitimayo.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.4",
            "verseOrgIds": [
              "JON.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JON 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onse oyendetsa sitimayo anachita mantha ndipo aliyense anayamba kupemphera kwa mulungu wake. Ndipo anaponya katundu mʼnyanja kuti sitimayo ipepuke. Koma Yona pa nthawiyi nʼkuti atatsikira mʼkatikati mwa sitimayo kumene anagona tulo tofa nato.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.5",
            "verseOrgIds": [
              "JON.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JON 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkulu wa oyendetsa sitimayo anapita kwa iye ndipo anati, \"Kodi iwe, nʼchifukwa chiyani ukugona? Dzuka pemphera kwa mulungu wako! Mwina adzatithandiza, ndipo sitidzawonongeka.\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.6",
            "verseOrgIds": [
              "JON.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JON 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo oyendetsa sitimayo anayamba kuwuzana kuti, \"Bwerani, tichite maere kuti tipeze amene wabweretsa tsoka limeneli.\" Iwo anachita maerewo ndipo anagwera Yona.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.7",
            "verseOrgIds": [
              "JON.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JON 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono anamufunsa kuti, \"Tatiwuze, tsoka limeneli latigwera chifukwa chiyani? Umagwira ntchito yanji? Ukuchokera kuti? Kwanu nʼkuti? Ndiwe mtundu wanji wa anthu?\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.8",
            "verseOrgIds": [
              "JON.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JON 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anayankha kuti, \"Ndine Mhebri, ndipo ndimapembedza Yehova, Mulungu Wakumwamba, amene analenga nyanja ndi mtunda.\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.9",
            "verseOrgIds": [
              "JON.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JON 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izi zinawachititsa mantha kwambiri ndipo anafunsa kuti, \"Kodi wachita chiyani?\" (Iwo ankadziwa kuti iyeyo amathawa Yehova, chifukwa nʼkuti atawawuza kale).",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.10",
            "verseOrgIds": [
              "JON.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JON 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namondwe ananka nakulirakulirabe pa nyanjapo. Tsono anamufunsa iye kuti, \"Kodi tikuchite chiyani kuti nyanjayi ikhale bata?\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.11",
            "verseOrgIds": [
              "JON.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JON 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anayankha kuti, \"Nyamuleni ndi kundiponya mʼnyanjamu ndipo nyanjayi ikhala bata. Ndikudziwa kuti wolakwa ndine nʼchifukwa chake chimphepo champhamvuchi chabwera pa inu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.12",
            "verseOrgIds": [
              "JON.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JON 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komabe oyendetsa sitimayo anayesetsa kupalasa kwambiri kuti abwerere ku mtunda koma analephera ndithu poti nyanja inawinduka kwambiri kuposa poyamba paja",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.13",
            "verseOrgIds": [
              "JON.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JON 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo iwo anafuwulira kwa Yehova nati, \"Inu Yehova, musalole kuti ife tife chifukwa cha moyo wa munthu uyu. Musatizenge mlandu wa kupha munthu wosalakwa, pakuti ife tachita monga mwakufuna kwanu, Inu Yehova.\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.14",
            "verseOrgIds": [
              "JON.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JON 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo anatenga Yona namuponya mʼnyanja, ndipo nyanja yowindukayo inakhala bata.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.15",
            "verseOrgIds": [
              "JON.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JON 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthuwo ataona zimenezi anachita mantha akulu ndi Yehova, ndipo anapereka nsembe kwa Yehova nalumbira kuti adzatumikira Yehovayo.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.16",
            "verseOrgIds": [
              "JON.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JON 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Yehova anatuma nsomba yayikulu kuti imeze Yona. Motero Yona anakhala mʼmimba mwa nsombayo masiku atatu, usana ndi usiku.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.17",
            "verseOrgIds": [
              "JON.2.1"
            ]
          }
        }
      ]
    }
  ],
