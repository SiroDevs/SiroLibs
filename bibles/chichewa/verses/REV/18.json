      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:23"
      },
      "items": [
        {
          "text": "sikudzawunikanso mwa inu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.23",
            "verseOrgIds": [
              "REV.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:23"
      },
      "items": [
        {
          "text": "Mawu a mkwati ndi mkwatibwi",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.23",
            "verseOrgIds": [
              "REV.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:23"
      },
      "items": [
        {
          "text": "sadzamvekanso mwa iwe.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.23",
            "verseOrgIds": [
              "REV.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:23"
      },
      "items": [
        {
          "text": "Amalonda anu anali akuluakulu a dziko lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.23",
            "verseOrgIds": [
              "REV.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:23"
      },
      "items": [
        {
          "text": "Mitundu yonse inasokonezedwa ndi zamatsenga zako.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.23",
            "verseOrgIds": [
              "REV.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "REV 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwa iye munapezeka magazi a aneneri ndi a oyera mtima,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.24",
            "verseOrgIds": [
              "REV.18.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:24"
      },
      "items": [
        {
          "text": "ndi onse amene anaphedwa pa dziko lapansi.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.24",
            "verseOrgIds": [
              "REV.18.24"
            ]
          }
        }
