  "verseCount": 8,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "REV 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Angelo Asanu ndi Awiri Okhala ndi Miliri Isanu ndi Iwiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumwamba ndinaona chizindikiro china chachikulu ndi chodabwitsa: angelo asanu ndi awiri ali ndi miliri isanu ndi iwiri yomaliza chifukwa Mulungu anakwiya kotheratu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.1",
            "verseOrgIds": [
              "REV.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo ndinaona chimene chinaoneka ngati nyanja yonyezimira yosakaniza ndi moto, ndipo pambali pa nyanjayo panayima amene anagonjetsa chirombo chija ndi fano lake, ndi nambala yotanthauza dzina lake. Anthuwo ananyamula azeze amene Mulungu anawapatsa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.2",
            "verseOrgIds": [
              "REV.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo ankayimba nyimbo ya Mose, mtumiki wa Mulungu, ndi nyimbo ya Mwana Wankhosa. Nyimbo yake inkati,",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.3",
            "verseOrgIds": [
              "REV.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 15:3"
      },
      "items": [
        {
          "text": "\"Zochita zanu ndi zazikulu ndi zodabwitsa,",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.3",
            "verseOrgIds": [
              "REV.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 15:3"
      },
      "items": [
        {
          "text": "Ambuye Mulungu Wamphamvuzonse",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.3",
            "verseOrgIds": [
              "REV.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 15:3"
      },
      "items": [
        {
          "text": "Njira zanu ndi zachilungamo ndi zoona,",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.3",
            "verseOrgIds": [
              "REV.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 15:3"
      },
      "items": [
        {
          "text": "Mfumu ya mitundu yonse.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.3",
            "verseOrgIds": [
              "REV.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Ambuye, ndani angapande kukuopani,",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.4",
            "verseOrgIds": [
              "REV.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 15:4"
      },
      "items": [
        {
          "text": "ndi kulemekeza dzina lanu?",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.4",
            "verseOrgIds": [
              "REV.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 15:4"
      },
      "items": [
        {
          "text": "Pakuti Inu nokha ndiye woyera.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.4",
            "verseOrgIds": [
              "REV.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 15:4"
      },
      "items": [
        {
          "text": "Anthu a mitundu yonse adzabwera",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.4",
            "verseOrgIds": [
              "REV.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 15:4"
      },
      "items": [
        {
          "text": "kudzapembedza pamaso panu,",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.4",
            "verseOrgIds": [
              "REV.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 15:4"
      },
      "items": [
        {
          "text": "pakuti ntchito zanu zolungama zaonekera poyera.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.4",
            "verseOrgIds": [
              "REV.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zitatha izi, ndinaona kumwamba Nyumba ya Mulungu imene ndi Tenti ya Umboni, atatsekula.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.5",
            "verseOrgIds": [
              "REV.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼnyumbamo munatuluka angelo asanu ndi awiri ndi miliri isanu ndi iwiri. Angelowo anavala nsalu zoyera bwino zonyezimira ndi malamba agolide pa zifuwa zawo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.6",
            "verseOrgIds": [
              "REV.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo kenaka chimodzi cha zamoyo zinayi zija chinapereka kwa angelo asanu ndi awiri mbale zisanu ndi ziwiri zodzaza ndi ukali wa Mulungu amene ali ndi moyo mpaka muyaya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.7",
            "verseOrgIds": [
              "REV.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Nyumba ya Mulungu inadzaza ndi utsi wochokera ku ulemerero wa Mulungu ndi ku mphamvu zake, ndipo panalibe yemwe akanalowa mʼNyumbayo mpaka miliri isanu ndi iwiri ya angelo asanu ndi awiri aja itatha.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.8",
            "verseOrgIds": [
              "REV.15.8"
            ]
          }
        }
      ]
    }
  ],
