  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "DEU 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kukonda ndi Kumvera Yehova",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muzikonda Yehova Mulungu wanu ndipo nthawi zonse muzitsata zimene Iyeyo anakulamulani, malangizo, zikhazikitso ndi malamulo ake.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.1",
            "verseOrgIds": [
              "DEU.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lero kumbukirani kuti si ana anu amene anaona ndi kulawa chilango cha Yehova Mulungu wanu: ukulu wake, dzanja lake lamphamvu, mkono wake wotambasuka;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.2",
            "verseOrgIds": [
              "DEU.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "zizindikiro zozizwitsa zimene anazionetsa ndi zinthu zimene anazichita mʼkati mwa Igupto, Farao mfumu ya Igupto ndi kwa dziko lake lonse;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.3",
            "verseOrgIds": [
              "DEU.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "zimene Iye anachita kwa gulu lankhondo la Aigupto, kwa akavalo ndi magaleta awo, mmene Iye anawamizira ndi madzi a mu Nyanja Yofiira pamene amakuthamangitsani, ndi mmene Yehova anawagonjetsera kufikira lero.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.4",
            "verseOrgIds": [
              "DEU.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si ana anu amene anaona zimene Iye anakuchitirani mʼchipululu kufikira pamene munafika pa malo anu,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.5",
            "verseOrgIds": [
              "DEU.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndi zimene anachitira Datani ndi Abiramu, ana aamuna a Eliabu mwana wa Rubeni, pamene nthaka inatsekula pakamwa pake pakati pa Aisraeli onse ndi kuwameza pamodzi ndi katundu wawo, matenti awo ndi chilichonse chawo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.6",
            "verseOrgIds": [
              "DEU.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ndinuyo amene munaona ntchito zonse zikuluzikulu zimenezi Yehova anakuchitirani.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.7",
            "verseOrgIds": [
              "DEU.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono muzisunga malamulo onse amene ndikukupatsani lero kuti mukhale ndi mphamvu ndi kuti mupite kukalanda mʼdziko limene mwakhala pangʼono kulowamo mukawoloka Yorodani,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.8",
            "verseOrgIds": [
              "DEU.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndiponso kuti mukhalitse mʼdziko limene Yehova analumbira kupatsa makolo anu ndi zidzukulu zawo, lomwe ndi dziko loyenda mkaka ndi uchi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.9",
            "verseOrgIds": [
              "DEU.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dziko limene mukukalanda ndi kulowamo silokhala ngati dziko la ku Igupto kumene mukuchokera ayi, kuja mumadzala mbewu ndi kumathirira ndi mapazi anu ngati ku dimba.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.10",
            "verseOrgIds": [
              "DEU.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma dziko limene mukalande mukawoloka Yorodani ndi dziko la mapiri ndi zigwa, dziko limene limalandira mvula kuchokera kumwamba.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.11",
            "verseOrgIds": [
              "DEU.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ili ndi dziko limene Yehova Mulungu wanu amalisamalira. Maso a Yehova Mulungu wanu amaliyangʼanira nthawi zonse kuchokera ku mayambiriro a chaka mpaka kumapeto kwake.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.12",
            "verseOrgIds": [
              "DEU.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho mukasunga mokhulupirika malamulo amene ndikukupatsani lero lino, kukonda Yehova Mulungu wanu ndi kumutumikira Iyeyo ndi mtima wanu wonse ndi moyo wanu wonse,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.13",
            "verseOrgIds": [
              "DEU.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamenepo ndidzatumiza mvula mʼdziko mwanu pa nthawi yake mʼnyengo ya dzinja ndi chilimwe, kuti mudzakolole tirigu wambiri ndi kuti mudzakhale ndi vinyo watsopano ndi mafuta.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.14",
            "verseOrgIds": [
              "DEU.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzakupatsani udzu mʼminda mwanu woti muzidzadyetsera ngʼombe zanu ndipo inuyo mudzadya ndi kukhuta.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.15",
            "verseOrgIds": [
              "DEU.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzisamalireni nokha, kuopa kuti mungakopeke mtima ndi kubwerera mʼmbuyo kuyamba kutumikira milungu ina ndi kumayigwadira.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.16",
            "verseOrgIds": [
              "DEU.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukatero Yehova Mulungu wanu adzakukwiyirani kwambiri, nadzaletsa thambo kuti lisabweretsenso mvula ndipo dziko silidzapereka zokolola. Choncho mudzawonongeka msanga mʼdziko limene Yehova akukupatsani.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.17",
            "verseOrgIds": [
              "DEU.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sungani mawu amenewa mu mtima mwanu ndi mʼmaganizo mwanu, muwamangirire pa mikono yanu ndipo muwayike pamphumi panu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.18",
            "verseOrgIds": [
              "DEU.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawuwa muziphunzitsa ana anu, muzikamba za iwo pamene mukhala pansi mʼnyumba zanu, pamene mukuyenda mʼnjira, pamene mugona ndi pamene mukudzuka.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.19",
            "verseOrgIds": [
              "DEU.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muwalembe pa mphuthu za nyumba zanu ndi pa zipata zanu,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.20",
            "verseOrgIds": [
              "DEU.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti inu ndi ana anu mukhale mʼdziko limene Yehova analumbira kupatsa makolo anu mpaka kalekale monga umakhalira mlengalenga pamwamba pa dziko.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.21",
            "verseOrgIds": [
              "DEU.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukatsatira mosamalitsa malamulo amene ndikukupatsaniwa, kukonda Yehova Mulungu wanu, kuyenda mʼnjira zake zonse ndi kumugwiritsitsa Iye",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.22",
            "verseOrgIds": [
              "DEU.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova adzapirikitsa mitundu ina yonseyi inu musanafike ndipo mudzagonjetsa mitundu ikuluikulu ndi yamphamvu kuposa inu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.23",
            "verseOrgIds": [
              "DEU.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malo aliwonse amene mudzaponda adzakhala anu: dziko lanu lidzachokera ku chipululu mpaka ku Lebanoni, ndi ku Mtsinje wa Yufurate mpaka ku nyanja ya kumadzulo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.24",
            "verseOrgIds": [
              "DEU.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Palibe munthu amene adzalimbana nanu. Monga analonjezera, Yehova adzachititsa kuti anthu onse mʼdziko limene mukupitalo adzachite nanu mantha ndi kukuopani.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.25",
            "verseOrgIds": [
              "DEU.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taonani, lero ndikuyika dalitso ndi temberero pakati panu,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.26",
            "verseOrgIds": [
              "DEU.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "dalitso ngati mumvera malamulo a Yehova Mulungu wanu amene ndikukupatsani lero.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.27",
            "verseOrgIds": [
              "DEU.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Temberero ngati simumvera malamulo a Yehova Mulungu wanu ndi kupatuka pa njira imene ndikulamulirani lero potsata milungu ina imene simunayidziwe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.28",
            "verseOrgIds": [
              "DEU.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova Mulungu wanu akakakufikitsani mʼdziko mukukalandalo kuti mulowemo mukanene za madalitso pa Phiri la Gerizimu, ndi za matemberero pa Phiri la Ebala.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.29",
            "verseOrgIds": [
              "DEU.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monga mudziwa, mapiriwa ali kutsidya kwa Yorodani, kumadzulo kolowera dzuwa, kufupi ndi mitengo ya thundu ya More, mʼdziko la Akanaani aja okhala ku Araba moyangʼanana ndi Giligala.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.30",
            "verseOrgIds": [
              "DEU.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwatsala pangʼono kuwoloka Yorodani kuti mulowe ndi kutenga dziko limene Yehova Mulungu wanu akukupatsani. Mukadzalitenga dzikolo ndi kukhalamo,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.31",
            "verseOrgIds": [
              "DEU.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
