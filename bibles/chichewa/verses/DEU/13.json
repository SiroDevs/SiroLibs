        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kupembedza Milungu Ina",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati mneneri kapena wina aliyense amene amanena zamʼtsogolo mwa maloto atuluka pakati panu, nalengeza za chizindikiro chozizwitsa kapena chodabwitsa,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.1",
            "verseOrgIds": [
              "DEU.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "chinthu nʼkuchitikadi, tsono iyeyo nʼkunena kuti, \"Tiyeni titsatire milungu ina, tiyeni tiyipembedze,\" (kunena milungu imene simunayidziwe),",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.2",
            "verseOrgIds": [
              "DEU.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "musamumvere mneneriyo kapena wolotayo. Yehova Mulungu wanu afuna akuyeseni kuti aone ngati mumamukonda ndi mtima wanu wonse ndi moyo wanu wonse.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.3",
            "verseOrgIds": [
              "DEU.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muyenera kutsatira Yehova Mulungu wanu, ndipo ndi Iyeyo amene muyenera kumuopa. Muzisunga malamulo ake ndi kumamumvera, muzimutumikira ndipo kumukangamira Iyeyo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.4",
            "verseOrgIds": [
              "DEU.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mneneri kapena wolotayo ayenera kuphedwa, popeza analalikira zopandukira Yehova Mulungu wanu, amene anakutulutsani ku Igupto ndi kukupulumutsani ku dziko la ukapolo. Wolalikirayo anafuna kukupatutsani pa njira imene Yehova Mulungu wanu anakulamulirani kuti muyitsatire. Muzichotsa choyipa pakati panu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.5",
            "verseOrgIds": [
              "DEU.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati mʼbale wanu weniweni kapena mwana wanu wamwamuna kapena wamkazi, kapena mkazi wanu wokondedwa, kapena mnzanu wapamtima akukakamizani mwachinsinsi, nʼkumati, \"Tiyeni tipite tikapembedze milungu ina\" (milungu imene inuyo kapena makolo anu sanayidziwe,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.6",
            "verseOrgIds": [
              "DEU.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "milungu ya anthu okuzungulirani, kaya ndi apafupi kapena akutali, kuchokera kumapeto mpaka kumapeto kwina kwa dziko lapansi),",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.7",
            "verseOrgIds": [
              "DEU.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "musamugonjere kapena kumumvera. Musamumvere chisoni. Musamuleke kapena kumutchinjiriza.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.8",
            "verseOrgIds": [
              "DEU.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumuphe ndithu. Dzanja lanu likhale loyambirira kumupha, kenaka manja a anthu ena onse.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.9",
            "verseOrgIds": [
              "DEU.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumuponye miyala mpaka kumupha, chifukwa anafuna kukupatutsani pa njira ya Yehova Mulungu amene anakutulutsani ku Igupto, dziko la ukapolo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.10",
            "verseOrgIds": [
              "DEU.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Aisraeli onse adzamva nachita mantha, ndipo palibe mmodzi pakati panu amene adzachitenso choyipa chotere.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.11",
            "verseOrgIds": [
              "DEU.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati mumvetsedwa kuti ku umodzi mwa mizinda imene Yehova Mulungu wanu akukupatsani kuti mukhalemo,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.12",
            "verseOrgIds": [
              "DEU.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwapezeka anthu ena oyipa pakati panu ndipo asocheretsa anthu ambiri mʼmizinda yanu, pomanena kuti, \"Tiyeni tikapembedze milungu ina\" (milungu imene simunayidziwe),",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.13",
            "verseOrgIds": [
              "DEU.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "mukuyenera kufunsa, kulondola ndi kufufuza bwino nkhaniyo. Ndipo ngati zitatsimikizikadi kuti ndi zoona kuti chinthu chonyansa chotere chachitikadi pakati panu,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.14",
            "verseOrgIds": [
              "DEU.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "muyenera kuwapha onse okhala mu mzinda umenewo. Muwonongeretu kwathunthu mzindawo, anthu ake ndi ziweto zake zomwe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.15",
            "verseOrgIds": [
              "DEU.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katundu yense wa anthu mu mzindawo mumuwunjike pamodzi pakatikati pa bwalo losonkhanako ndipo mutenthe mzindawo pamodzi ndi katundu wake yense monga nsembe yathunthu yopsereza ya kwa Yehova Mulungu wanu. Mzinda umenewo ukhale bwinja mpaka muyaya, usadzamangidwenso.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.16",
            "verseOrgIds": [
              "DEU.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musapezeke ndi kanthu kalikonse koyenera kuwonongedwa kuti Yehova abweze mkwiyo wake wochititsa manthawu. Adzakuchitirani chifundo ndi kukumverani chisoni, ndipo adzakuchulukitsani monga analonjeza mwa lumbiro kwa makolo anu,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.17",
            "verseOrgIds": [
              "DEU.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "chifukwa mumamvera Yehova Mulungu wanu, kusunga malamulo ake onse amene ndikukupatsani lero lino ndi kuchita zoyenera pamaso pake.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.18",
            "verseOrgIds": [
              "DEU.13.19"
            ]
          }
        }
      ]
    }
  ],
