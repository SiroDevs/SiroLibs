  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "DEU 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yoswa Alowa Mʼmalo mwa Mose",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Mose anapita ndi kukayankhula mawu awa kwa Aisraeli onse:",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.1",
            "verseOrgIds": [
              "DEU.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tsopano ndili ndi zaka 120, ndipo sindingathenso kukutsogolerani. Yehova wandiwuza kuti, 'Iwe sudzawoloka Yorodani.'",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.2",
            "verseOrgIds": [
              "DEU.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwini wake Yehova Mulungu wanu ndiye amene adzakutsogolerani powoloka. Iye adzawononga mitundu ina yonse, ndipo inu mudzatenga dziko lawo. Yoswa adzakutsogoleraninso powoloka, monga momwe ananenera Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.3",
            "verseOrgIds": [
              "DEU.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yehova adzawawononga iwo monga momwe anawonongera Sihoni ndi Ogi, mafumu Aamori, amene Iye anawawononga pamodzi ndi dziko lawo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.4",
            "verseOrgIds": [
              "DEU.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambuye adzawapereka kwa inu, ndipo inu mukawachitire zonse zimene ndakulamulani.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.5",
            "verseOrgIds": [
              "DEU.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khalani amphamvu ndi olimba mtima. Musachite nawo mantha kapena kunjenjemera pamaso pawo, chifukwa Yehova Mulungu wanu apita nanu. Sadzakusiyani kapena kukutayani.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.6",
            "verseOrgIds": [
              "DEU.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Yehova anayitana Yoswa pamaso pa Aisraeli onse ndipo anamuwuza kuti, \"Khala wamphamvu ndi wolimba mtima, pakuti iwe udzatsogolera anthu awa ku dziko limene Yehova analumbira kulipereka kwa makolo awo, ndipo iwe ukaligawe pakati pawo kuti likakhale cholowa chawo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.7",
            "verseOrgIds": [
              "DEU.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova mwini ndiye akukutsogolerani ndipo adzakhala nanu. Sadzakusiyani kapena kukutayani. Usachite mantha ndiponso usataye mtima.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.8",
            "verseOrgIds": [
              "DEU.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuwerenga Malamulo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Mose analemba malamulo awa nawapereka kwa ansembe, ana Alevi, amene amanyamula Bokosi la Chipangano la Yehova, ndiponso kwa akuluakulu onse a Aisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.9",
            "verseOrgIds": [
              "DEU.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Mose anawalamula kuti, \"Pamapeto pa zaka zisanu ndi ziwiri zilizonse, chaka cha kukhululukidwa ngongole, pa nthawi ya Chikondwerero cha Misasa,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.10",
            "verseOrgIds": [
              "DEU.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamene Aisraeli onse abwera kudzaonekera pamaso pa Yehova Mulungu wanu pamalo pamene Iye adzasankhe, mudzawerenge malamulo onsewa iwo akumva.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.11",
            "verseOrgIds": [
              "DEU.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mudzasonkhanitse anthu onse pamodzi, amuna, akazi ndi ana pamodzi ndi alendo amene akukhala mʼmizinda yanu, kuti adzawamve ndi kuphunzira kuopa Yehova Mulungu wanu ndi kutsatira mosamala mawu onse a mʼmalamulowa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.12",
            "verseOrgIds": [
              "DEU.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana awo amene sadziwa malamulo awa, ayenera kuwamva ndi kuphunzira kuopa Yehova Mulungu wanu nthawi zonse pamene mukukhala mʼdziko limene mukuwoloka Yorodani kukalitenga.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.13",
            "verseOrgIds": [
              "DEU.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aneneratu za Kuwukira kwa Aisraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anawuza Mose kuti, \"Nthawi ya kufa kwako yafika. Itana Yoswa ndipo mubwere ku tenti ya msonkhano, kumene Ine ndidzamulangiza.\" Choncho Mose ndi Yoswa anabwera ku tenti ya msonkhano.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.14",
            "verseOrgIds": [
              "DEU.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Yehova anaonekera ku tenti mʼchipilala cha mtambo, ndipo mtambowo unayima pamwamba pa khomo lolowera mu tenti.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.15",
            "verseOrgIds": [
              "DEU.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yehova anawuza Mose kuti, \"Iwe ukupita kukapuma kumene kuli makolo ako, ndipo ukangomwalira, anthu awa adzayamba kupembedza milungu yachilendo ya mʼdziko limene akukalowamo. Adzanditaya ndi kuphwanya pangano lomwe ndinachita nawo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.16",
            "verseOrgIds": [
              "DEU.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku limenelo Ine ndidzawakwiyira ndi kuwataya. Ndidzawabisira nkhope yanga, ndipo adzawonongedwa. Masautso ambiri ndi zovuta zambiri zidzawagwera, ndipo tsiku limenelo adzafunsa kuti, 'Kodi masautso awa sanagwere ife chifukwa Yehova Mulungu wathu sali nafe?'",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.17",
            "verseOrgIds": [
              "DEU.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Ine ndidzabisa ndithu nkhope yanga pa tsiku limenelo chifukwa cha zoyipa zimene anachita potembenukira kwa milungu ina.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.18",
            "verseOrgIds": [
              "DEU.31.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tsopano ulembe mawu a nyimbo iyi ndipo uwaphunzitse Aisraeli, uwawuze kuti aziyimba, kuti ikhale mboni yanga yowatsutsa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.19",
            "verseOrgIds": [
              "DEU.31.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene ndawalowetsa mʼdziko loyenda mkaka ndi uchi, dziko limene ndinalonjeza mwalumbiro kwa makolo awo, ndipo pamene adzadya ndi kukhuta ndi kumasangalala, iwo adzatembenukira kwa milungu ina ndi kumayipembedza, kundikana Ine ndi kuphwanya pangano langa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.20",
            "verseOrgIds": [
              "DEU.31.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo pamene masautso ambiri ndi zovuta zambiri zidzawagwera, nyimbo iyi idzakhala mboni yanga yowatsutsa, chifukwa zidzukulu zawo sizidzayiwala nyimboyi. Ine ndikudziwa zimene iwo akulingalira kuchita, ngakhale kuti sindinawalowetse mʼdziko limene ndinalonjeza mwa lumbiro.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.21",
            "verseOrgIds": [
              "DEU.31.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 31:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Mose analemba nyimbo iyi tsiku limenelo ndi kuwaphunzitsa Aisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.22",
            "verseOrgIds": [
              "DEU.31.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 31:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova analamula Yoswa mwana wa Nuni kuti, \"Khala wamphamvu ndipo limba mtima, chifukwa udzalowetsa Aisraeli mʼdziko limene ndinawalonjeza mwa lumbiro, ndipo Ine mwini ndidzakhala nawe.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.23",
            "verseOrgIds": [
              "DEU.31.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 31:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose atatha kulemba malamulowa mʼbuku, osasiyako kanthu,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.24",
            "verseOrgIds": [
              "DEU.31.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 31:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "analamula Alevi amene ananyamula Bokosi la Chipangano la Yehova kuti,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.25",
            "verseOrgIds": [
              "DEU.31.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 31:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tengani Buku ili la Malamulo ndi kuliyika pambali pa Bokosi la Chipangano la Yehova Mulungu wanu. Likhale kumeneko ngati mboni yokutsutsani.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.26",
            "verseOrgIds": [
              "DEU.31.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 31:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti Ine ndikudziwa kuwukira kwanu ndi kuwuma mtima kwanu. Ngati inu mwakhala mukuwukira Yehova ine ndili moyo ndiponso ndili nanu pamodzi, nanga mudzawukira motani ine ndikamwalira!",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.27",
            "verseOrgIds": [
              "DEU.31.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 31:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundisonkhanitsire atsogoleri onse a mafuko anu pamodzi ndi akuluakulu onse, kuti ndiyankhule mawu awa iwo akumva ndipo kumwamba ndi dziko lapansi zikhale mboni yowatsutsa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.28",
            "verseOrgIds": [
              "DEU.31.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 31:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chifukwa ndikudziwa kuti ine ndikamwalira mudzayipa kwambiri ndi kutembenuka kuleka njira imene ndinakulamulani. Masiku amene akubwera, masautso adzakugwerani chifukwa mudzachita zoyipa pamaso pa Yehova ndi kuputa mkwiyo wake chifukwa cha zimene manja anu anapanga.\"",
          "type": "text",
