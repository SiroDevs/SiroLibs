              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono ntchito za Nadabu ndi zina zonse zimene anazichita, kodi sizinalembedwe mʼbuku la mbiri ya mafumu a Israeli?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.31",
