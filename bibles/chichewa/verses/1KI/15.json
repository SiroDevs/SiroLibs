          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panali nkhondo pakati pa Asa ndi Baasa mfumu ya Israeli pa nthawi yonse ya ulamuliro wawo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.32",
