  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "1KI 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nduna za Solomoni ndi Abwanamkubwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Mfumu Solomoni inakhala mfumu ya Aisraeli onse.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.1",
            "verseOrgIds": [
              "1KI.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nduna zake zikuluzikulu zinali izi:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.2",
            "verseOrgIds": [
              "1KI.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1KI 4:2"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 4:2"
      },
      "items": [
        {
          "text": "Azariya mwana wa Zadoki anali wansembe;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.2",
            "verseOrgIds": [
              "1KI.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elihorefe ndi Ahiya, ana a Sisa, anali alembi;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.3",
            "verseOrgIds": [
              "1KI.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 4:3"
      },
      "items": [
        {
          "text": "Yehosafati mwana wa Ahiludi, anali mlembi wa zochitika;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.3",
            "verseOrgIds": [
              "1KI.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaya mwana wa Yehoyada, anali mtsogoleri wa ankhondo;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.4",
            "verseOrgIds": [
              "1KI.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 4:4"
      },
      "items": [
        {
          "text": "Zadoki ndi Abiatara, anali ansembe;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.4",
            "verseOrgIds": [
              "1KI.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azariya mwana wa Natani, anali woyangʼanira nduna za mʼzigawo;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.5",
            "verseOrgIds": [
              "1KI.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 4:5"
      },
      "items": [
        {
          "text": "Zabudi mwana wa Natani, anali wansembe ndi bwenzi la mfumu;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.5",
            "verseOrgIds": [
              "1KI.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahisara, anali mkulu woyangʼanira nyumba ya mfumu;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.6",
            "verseOrgIds": [
              "1KI.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 4:6"
      },
      "items": [
        {
          "text": "Adoniramu mwana wa Abida, anali mkulu woyangʼanira ntchito za thangata.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.6",
            "verseOrgIds": [
              "1KI.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni analinso ndi abwanamkubwa khumi ndi awiri amene ankayangʼanira zigawo zonse za dziko la Israeli. Iwo ankapereka chakudya kwa mfumu ndiponso ku banja laufumu. Bwanamkubwa aliyense ankapereka chakudya mwezi umodzi pa chaka.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.7",
            "verseOrgIds": [
              "1KI.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayina awo ndi awa:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.8",
            "verseOrgIds": [
              "1KI.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1KI 4:8"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 4:8"
      },
      "items": [
        {
          "text": "Beni-Huri, wa ku dziko la mapiri la Efereimu;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.8",
            "verseOrgIds": [
              "1KI.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beni-Dekeri, woyangʼanira mizinda ya Makazi, Saalibimu, Beti-Semesi ndi Eloni Beti-Hanani;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.9",
            "verseOrgIds": [
              "1KI.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beni-Hesedi, woyangʼanira mizinda ya Aruboti (Soko ndi dziko lonse la Heferi);",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.10",
            "verseOrgIds": [
              "1KI.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beni-Abinadabu, woyangʼanira Nafoti Dori (iye anakwatira Tafati mwana wa Solomoni);",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.11",
            "verseOrgIds": [
              "1KI.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baana mwana wa Ahiludi, anali woyangʼanira Taanaki ndi Megido, ndi ku Beti Sani konse, kufupi ndi ku Zaretani kumunsi kwa Yezireeli, kuyambira ku Beti-Seani mpaka ku Abeli-Mehola kukafika mpaka ku Yokineamu;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.12",
            "verseOrgIds": [
              "1KI.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beni-Geberi, anali woyangʼanira Ramoti Giliyadi (midzi ya Yairi inali ya mwana wa Manase ku Giliyadi, pamodzinso ndi chigawo cha Arigobu ku Basani ndiponso mizinda yake yayikulu makumi asanu ndi umodzi yokhala ndi malinga ndi mipiringidzo yamkuwa).",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.13",
            "verseOrgIds": [
              "1KI.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahinadabu mwana wa Ido, anali woyangʼanira Mahanaimu;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.14",
            "verseOrgIds": [
              "1KI.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahimaazi anali woyangʼanira Nafutali (iyeyu anakwatira Basemati mwana wa Solomoni);",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.15",
            "verseOrgIds": [
              "1KI.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baana mwana wa Husai, anali woyangʼanira Aseri ndi Bealoti;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.16",
            "verseOrgIds": [
              "1KI.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehosafati mwana wa Paruwa, anali woyangʼanira Isakara;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.17",
            "verseOrgIds": [
              "1KI.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simei mwana wa Ela, anali woyangʼanira Benjamini;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.18",
            "verseOrgIds": [
              "1KI.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geberi mwana wa Uri, anali woyangʼanira Giliyadi (dziko la Sihoni mfumu ya Aamori ndi dziko la Ogi mfumu ya Basani). Iye ankayangʼanira chigawo chonsechi yekha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.19",
            "verseOrgIds": [
              "1KI.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chakudya cha Tsiku ndi Tsiku cha Solomoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu a ku Yuda ndi ku Israeli anali ochuluka ngati mchenga wa mʼmbali mwa nyanja. Ankadya ndi kumwa ndipo ankasangalala.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.20",
            "verseOrgIds": [
              "1KI.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Solomoni analamulira mayiko onse kuyambira ku mtsinje wa Yufurate mpaka ku dziko la Afilisti, kukafika mpaka ku malire a dziko la Igupto. Mayikowa ankabweretsa mphatso ndipo anali pansi pa ulamuliro wa Solomoni moyo wake wonse.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.21",
            "verseOrgIds": [
              "1KI.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chakudya cha tsiku ndi tsiku cha Solomoni chinali madengu 150 a ufa wosalala ndi madengu 300 a mgayiwa,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.22",
            "verseOrgIds": [
              "1KI.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngʼombe khumi zonenepa zodyetsera mʼkhola, ngʼombe za ku busa makumi awiri, ndiponso nkhosa ndi mbuzi 100, pamodzinso ndi mbawala, agwape, mphoyo ndi mbalame zoweta zonona.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.23",
            "verseOrgIds": [
              "1KI.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti ankalamulira dziko lonse la kumadzulo kwa mtsinje wa Yufurate kuyambira ku Tifisa mpaka ku Gaza, mafumu onse a kumadzulo kwa Mtsinje, ndipo anali pa mtendere ndi mayiko onse ozungulira.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.24",
            "verseOrgIds": [
              "1KI.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa nthawi ya Solomoni, Yuda ndi Israeli anali pa mtendere, kuyambira ku Dani mpaka ku Beeriseba. Munthu aliyense ankangodzikhalira pansi pa mpesa wake ndi mtengo wake wa mkuyu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.25",
            "verseOrgIds": [
              "1KI.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni anali ndi zipinda 4,000 zodyeramo akavalo okoka magaleta ake ndi anthu 12,000 oyendetsa magaleta.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.26",
            "verseOrgIds": [
              "1KI.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abwanamkubwa a zigawo aja, aliyense pa mwezi wake, ankapereka chakudya cha Mfumu Solomoni ndi cha anthu onse amene ankadya naye. Iwo ankaonetsetsa kuti pasasowe kalikonse.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.27",
            "verseOrgIds": [
              "1KI.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ankabweretsanso ku malo ake ofunikira muyeso wawo wa barele ndi udzu wa akavalo okoka magaleta ndiponso akavalo ena.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.28",
            "verseOrgIds": [
              "1KI.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nzeru za Solomoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu anamupatsa Solomoni nzeru ndi luntha losaneneka ndipo nzeru zake zinali zochuluka ngati mchenga wa mʼmbali mwa nyanja.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.29",
            "verseOrgIds": [
              "1KI.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzeru za Solomoni zinali zoposa nzeru za anthu onse a Kummawa ndiponso nzeru zonse za ku Igupto.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.30",
            "verseOrgIds": [
              "1KI.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anali wanzeru kuposa munthu wina aliyense, kuposa ngakhale Etani wa banja la Ezara, Hemani, Kalikoli ndi Darida, ana a Maholi. Ndipo mbiri yake inamveka kwa mitundu yonse ya anthu ozungulira.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.31",
            "verseOrgIds": [
              "1KI.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni anapeka miyambi 3,000 ndi kulemba nyimbo 1,005.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.32",
            "verseOrgIds": [
              "1KI.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye ankaphunzitsa za mitengo, kuyambira mtengo wa mkungudza wa ku Lebanoni mpaka kachitsamba ka hisope khomera pa khoma. Iye ankaphunzitsanso za nyama ndi mbalame, zinthu zokwawa pansi ndiponso za nsomba.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.33",
            "verseOrgIds": [
              "1KI.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu a mitundu yonse ankabwera kudzamva nzeru za Solomoni. Anthu amenewa ankatumizidwa ndi mafumu onse a dziko lapansi amene anamvapo za nzeru zakezo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.34",
            "verseOrgIds": [
              "1KI.5.14"
            ]
          }
        }
      ]
    }
  ],
