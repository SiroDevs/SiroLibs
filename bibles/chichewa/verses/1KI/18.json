  "verseCount": 46,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "1KI 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eliya ndi Obadiya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Patapita masiku ambiri, mʼchaka chachitatu cha chilala, Yehova anayankhula ndi Eliya kuti, \"Pita ukadzionetse kwa Ahabu ndipo ndidzagwetsa mvula pa dziko lapansi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.1",
            "verseOrgIds": [
              "1KI.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Eliya anapita kukadzionetsa kwa Ahabu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.2",
            "verseOrgIds": [
              "1KI.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 18:2"
      },
      "items": [
        {
          "text": "Tsono nthawi imeneyi njala inakula kwambiri mu Samariya,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.2",
            "verseOrgIds": [
              "1KI.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo Ahabu anayitana Obadiya amene ankayangʼanira nyumba yake yaufumu. (Obadiya ankaopa Yehova kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.3",
            "verseOrgIds": [
              "1KI.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene Yezebeli ankapha aneneri a Yehova, Obadiya anatenga aneneri 100 ndi kuwabisa mʼmapanga awiri, phanga lililonse aneneri makumi asanu, ndipo ankawapatsa chakudya ndi madzi).",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.4",
            "verseOrgIds": [
              "1KI.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabu anawuza Obadiya kuti, \"Pita mʼdziko kulikonse kumene kuli zitsime za madzi ndi ku zigwa zonse. Mwina mwake tingapeze udzu oti nʼkumadyetsa akavalo ndi abulu kuti akhale ndi moyo, kuti tisaphe chiweto chilichonse.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.5",
            "verseOrgIds": [
              "1KI.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho anagawana dziko loti apiteko, Ahabu anapita mbali ina, Obadiya nʼkupita ina.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.6",
            "verseOrgIds": [
              "1KI.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obadiya akuyenda mʼnjira anakumana ndi Eliya. Ndipo taonani, Obadiya anamuzindikira Eliyayo, naweramira pansi ndipo anati, \"Kodi ndinu, mbuye wanga Eliya?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.7",
            "verseOrgIds": [
              "1KI.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya anayankha kuti, \"Inde. Pita kawuze mbuye wako kuti, 'Eliya wabwera.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.8",
            "verseOrgIds": [
              "1KI.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obadiya anafunsa kuti, \"Kodi ndalakwa chiyani kuti inu mupereke mtumiki wanu kwa Ahabu kuti akaphedwe?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.9",
            "verseOrgIds": [
              "1KI.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pali Yehova Mulungu wanu wamoyo, kulibe mtundu wa anthu kapena ufumu uliwonse kumene mbuye wanga sanatumeko anthu okakufunafunani. Ndipo pamene mtundu wa anthu kapena ufumu unena kuti kuno kulibe, Ahabu ankawalumbiritsa kuti atsimikizedi kuti inuyo kulibe kumeneko.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.10",
            "verseOrgIds": [
              "1KI.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma tsopano mukundiwuza kuti ndipite kwa mbuye wanga ndi kukanena kuti, 'Eliya wabwera.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.11",
            "verseOrgIds": [
              "1KI.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine sindikudziwa kumene Mzimu wa Yehova udzakupititsani ine ndikachoka. Ngati ndipita kukamuwuza Ahabu ndipo iye wosadzakupezani, adzandipha. Komatu ine mtumiki wanu ndakhala ndi kupembedza Yehova kuyambira ubwana wanga.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.12",
            "verseOrgIds": [
              "1KI.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuye wanga, kodi simunamve zimene ndinachita pamene Yezebeli ankapha aneneri a Yehova? Ine ndinabisa aneneri 100 a Yehova mʼmapanga awiri, mʼphanga lililonse aneneri makumi asanu, ndipo ndinkawapatsa chakudya ndi madzi akumwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.13",
            "verseOrgIds": [
              "1KI.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiye inu tsopano mukundiwuza kuti ndipite kwa mbuye wanga ndi kukanena kuti, 'Eliya wabwera.' Iyeyo adzandipha ndithu!\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.14",
            "verseOrgIds": [
              "1KI.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya anati, \"Pali Yehova Wamphamvuzonse wamoyo, amene ndimamutumikira, ine lero ndidzaonekera ndithu pamaso pa Ahabu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.15",
            "verseOrgIds": [
              "1KI.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eliya pa Phiri la Karimeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Obadiya anapita kukakumana ndi Ahabu, namuwuza, ndipo Ahabu anapita kukakumana ndi Eliya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.16",
            "verseOrgIds": [
              "1KI.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene Ahabu anaona Eliya, anati kwa iye, \"Kodi ndiwedi, munthu wovutitsa Israeli uja?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.17",
            "verseOrgIds": [
              "1KI.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya anayankha kuti, \"Ine sindinavutitse Israeli, koma ndinuyo ndi banja lanu. Mwasiya malamulo a Yehova ndipo mwatsatira Abaala.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.18",
            "verseOrgIds": [
              "1KI.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsopano sonkhanitsani anthu a mʼdziko lonse la Israeli kuti akumane nane pa Phiri la Karimeli. Ndipo mubwere nawo aneneri a Baala 450 ndi aneneri a fano la Asera 400, amene amadya pa tebulo la Yezebeli.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.19",
            "verseOrgIds": [
              "1KI.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Ahabu anatumiza mawu mʼdziko lonse la Israeli, ndipo anasonkhanitsa aneneri a Baala ku Phiri la Karimeli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.20",
            "verseOrgIds": [
              "1KI.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya anapita patsogolo pa anthuwo ndipo anati, \"Kodi mudzakhala anthu a mitima iwiri mpaka liti? Ngati Yehova ndi Mulungu, mutsateni; koma ngati Baala ndi Mulungu, mutsateni.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.21",
            "verseOrgIds": [
              "1KI.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 18:21"
      },
      "items": [
        {
          "text": "Koma anthu aja sanayankhe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.21",
            "verseOrgIds": [
              "1KI.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Eliya ananena kwa iwo kuti, \"Ine ndilipo ndekha mneneri wa Yehova, koma Baala ali ndi aneneri 450.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.22",
            "verseOrgIds": [
              "1KI.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tibweretsereni ngʼombe zazimuna ziwiri. Iwo asankhepo okha ngʼombe imodzi, ndipo ayidule nthulinthuli ndi kuziyika pa nkhuni nthulizo, koma osakolezapo moto. Ndipo ine ndidzadula nthulinthuli ngʼombe inayo ndi kuyika pa nkhuni koma sindikolezapo moto.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.23",
            "verseOrgIds": [
              "1KI.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka inu muyitane dzina la mulungu wanu, ndipo ine ndidzayitana dzina la Yehova. Mulungu amene ati ayankhe potumiza moto, iyeyo ndiye Mulungu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.24",
            "verseOrgIds": [
              "1KI.18.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 18:24"
      },
      "items": [
        {
          "text": "Pamenepo anthu onse anati, \"Izi mwanena zamveka bwino.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.24",
            "verseOrgIds": [
              "1KI.18.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya anawuza aneneri a Baala kuti, \"Yambani ndinu. Sankhani ngʼombe yayimuna imodzi, muyikonze, popeza mulipo ambiri. Muyitane dzina la mulungu wanu, koma musakoleze moto.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.25",
            "verseOrgIds": [
              "1KI.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho iwo anatenga ngʼombe yayimunayo imene anawapatsa, nayikonza.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.26",
            "verseOrgIds": [
              "1KI.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 18:26"
      },
      "items": [
        {
          "text": "Kenaka anayitana dzina la Baala kuyambira mmawa mpaka masana. Iwo anafuwula kuti, \"Inu Baala, tiyankheni ife.\" Koma panalibe yankho; palibe amene anayankha. Ndipo anavinavina mozungulira guwa lansembe limene anapanga.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.26",
            "verseOrgIds": [
              "1KI.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthawi yamasana Eliya anayamba kuwanyogodola ndipo anati, \"Fuwulani kwambiri. Ndithudi, iye ndi mulungu! Mwinatu akulingalira kwambiri, kapena watanganidwa, kapena ali paulendo. Mwina wagona ndipo nʼkofunika kuti adzutsidwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.27",
            "verseOrgIds": [
              "1KI.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho iwo anafuwula kwambiri ndi kudzichekacheka ndi malupanga ndi mikondo, potsata miyambo yawo, mpaka kutuluka magazi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.28",
            "verseOrgIds": [
              "1KI.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthawi yamasana inadutsa, ndipo anapitiriza kunenera mwakhama mpaka nthawi yopereka nsembe ya madzulo. Koma panalibe yankho. Palibe amene anayankha, kapena kulabadira zimenezo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.29",
            "verseOrgIds": [
              "1KI.18.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Eliya anati kwa anthu onse, \"Senderani pafupi ndi ine.\" Ndipo anthu onsewo anasendera pafupi ndi iye, ndipo iye anakonza guwa lansembe la Yehova limene linali litawonongeka.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.30",
            "verseOrgIds": [
              "1KI.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya anatenga miyala 12, mwala uliwonse kuyimira fuko lililonse la Yakobo, amene Yehova anamuwuza kuti, \"Dzina lako lidzakhala Israeli.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.31",
            "verseOrgIds": [
              "1KI.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi miyala imeneyo anamanga guwa mʼdzina la Yehova, ndipo anakumba ngalande yayikulu yolowa malita 15 a madzi kuzungulira guwalo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.32",
            "verseOrgIds": [
              "1KI.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anayika nkhuni zija mʼmalo mwake nadula nthulinthuli ngʼombe yayimuna ija ndi kuyika nthulizo pa nkhunipo. Pamenepo Eliya anati, \"Dzazani mitsuko inayi ndi madzi ndipo muwathire pa nyama ya nsembeyo ndi nkhunizo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.33",
            "verseOrgIds": [
              "1KI.18.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya anati, \"Thiraninso kachiwiri.\" Anthu aja anathiranso madziwo kachiwiri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.34",
            "verseOrgIds": [
              "1KI.18.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 18:34"
      },
      "items": [
        {
          "text": "Iye analamula kuti, \"Thiraninso kachitatu.\" Ndipo iwo anathiranso kachitatu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.34",
            "verseOrgIds": [
              "1KI.18.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madziwo anayenderera pansi kuzungulira guwa lansembe, nadzaza ngalande yonse.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.35",
            "verseOrgIds": [
              "1KI.18.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 18:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa nthawi yopereka nsembe, mneneri Eliya anasendera pafupi ndi guwa lansembe, napemphera kuti, \"Inu Yehova, Mulungu wa Abrahamu, Isake ndi Yakobo, lero zidziwike kuti ndinu Mulungu mu Israeli ndipo kuti ine ndine mtumiki wanu, kuti ine ndachita zonsezi chifukwa mwalamula ndinu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.36",
            "verseOrgIds": [
              "1KI.18.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 18:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiyankheni, Inu Yehova, ndiyankheni, kuti anthu awa adziwe Inu Yehova, kuti ndinu Mulungu, ndipo kuti mutembenuziranso mitima yawo kwa Inu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.37",
            "verseOrgIds": [
              "1KI.18.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 18:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo moto wa Yehova unagwa, nunyeketsa nsembe yopserezayo, nkhuni, miyala ndi dothi lomwe. Unawumitsanso madzi amene anali mʼngalande.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.38",
            "verseOrgIds": [
              "1KI.18.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 18:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu onse ataona zimenezi, anaweramitsa nkhope zawo pansi, nafuwula kuti, \"Yehova ndiye Mulungu! Yehova ndiye Mulungu!\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.39",
            "verseOrgIds": [
              "1KI.18.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 18:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Eliya analamula anthuwo kuti, \"Gwirani aneneri a Baala. Musalole kuti wina aliyense athawe!\" Anagwira onsewo ndipo Eliya anabwera nawo ku Chigwa cha Kisoni, nawapha kumeneko.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.40",
            "verseOrgIds": [
              "1KI.18.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 18:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Eliya anati kwa Ahabu, \"Pitani, kadyeni ndi kumwa, pakuti kukumveka mkokomo wa mvula.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.41",
            "verseOrgIds": [
              "1KI.18.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 18:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Ahabu anapita kukadya ndi kumwa, koma Eliya anakwera pamwamba pa Phiri la Karimeli, ndipo anawerama mpaka pansi, nayika mutu wake pakati pa mawondo ake.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.42",
            "verseOrgIds": [
              "1KI.18.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 18:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya anawuza mtumiki wake kuti, \"Pita kayangʼane ku nyanja.\" Ndipo iye anapita nakayangʼana.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.43",
            "verseOrgIds": [
              "1KI.18.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 18:43"
      },
      "items": [
        {
          "text": "Mtumikiyo anati, \"Kulibe kanthu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.43",
            "verseOrgIds": [
              "1KI.18.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 18:43"
      },
      "items": [
        {
          "text": "Kasanu nʼkawiri Eliya anati, \"Pitanso.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.43",
            "verseOrgIds": [
              "1KI.18.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 18:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulendo wachisanu ndi chiwiri mtumikiyo anafotokoza kuti, \"Taonani, kamtambo kakangʼono kokhala ngati dzanja la munthu kakutuluka ku nyanja.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.44",
            "verseOrgIds": [
              "1KI.18.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 18:44"
      },
      "items": [
        {
          "text": "Pamenepo Eliya anati, \"Pita, kamuwuze Ahabu kuti, 'Konzani galeta lanu ndipo mutsike mvula isanakutsekerezeni.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.44",
            "verseOrgIds": [
              "1KI.18.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1KI 18:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthawi imeneyi nʼkuti kuthambo kutayamba kusonkhana mitambo yakuda, mphepo inawomba, mvula yamphamvu inagwa ndipo Ahabu anakwera galeta napita ku Yezireeli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.45",
            "verseOrgIds": [
              "1KI.18.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 18:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzanja la Yehova linali pa Eliya ndipo atamangira lamba chovala chake, anathamanga ndi kumupitirira Ahabu mpaka kukhala woyamba kukafika ku Yezireeli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.46",
            "verseOrgIds": [
              "1KI.18.46"
            ]
          }
        }
      ]
    }
  ],
