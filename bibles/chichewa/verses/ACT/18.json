  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "ACT 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ku Korinto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zitatha izi, Paulo anachoka ku Atene ndipo anapita ku Korinto.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.1",
            "verseOrgIds": [
              "ACT.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumeneko anakumana ndi Myuda wina dzina lake Akula, nzika ya ku Ponto amene anali atangofika kumene kuchokera ku Italiya pamodzi ndi mkazi wake Prisila, chifukwa Klaudiyo analamula Ayuda onse kuti achoke ku Roma. Paulo anapita kukawaona.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.2",
            "verseOrgIds": [
              "ACT.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Popeza Paulo anali mʼmisiri wosoka matenti monga iwo, iye anakhala nawo namagwirira ntchito pamodzi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.3",
            "verseOrgIds": [
              "ACT.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku la Sabata lililonse Paulo amakambirana ndi anthu mʼsunagoge, kufuna kukopa Ayuda ndi Agriki.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.4",
            "verseOrgIds": [
              "ACT.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sila ndi Timoteyo atafika kuchokera ku Makedoniya, Paulo ankangogwira ntchito yolalikira yokha basi, kuchitira umboni Ayuda kuti Yesu ndiye Khristu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.5",
            "verseOrgIds": [
              "ACT.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma pamene Ayuda anatsutsana naye ndi kumuchita chipongwe, iye anakutumula zovala zake nati, \"Magazi anu akhale pamitu yanu! Ine ndilibe mlandu. Kuyambira tsopano ndipita kwa anthu a mitundu ina.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.6",
            "verseOrgIds": [
              "ACT.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Paulo anatuluka mʼsunagoge napita ku nyumba yoyandikana ndi sunagoge ya Tito Yusto, munthu wopembedza Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.7",
            "verseOrgIds": [
              "ACT.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Krispo, mkulu wa sunagoge, pamodzi ndi a pa banja lake lonse anakhulupirira Ambuye; ndiponso Akorinto ambiri amene anamva Paulo akulalikira anakhulupiriranso nabatizidwa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.8",
            "verseOrgIds": [
              "ACT.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usiku wina Ambuye anaonekera kwa Paulo mʼmasomphenya namuwuza kuti,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.9",
            "verseOrgIds": [
              "ACT.18.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Usaope, pitiriza kuyankhula, usakhale chete.",
              "type": "text",
              "attrs": {
                "verseId": "ACT.18.9",
                "verseOrgIds": [
                  "ACT.18.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.9",
            "verseOrgIds": [
              "ACT.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pakuti Ine ndili nawe, palibe aliyense amene adzakukhudza ndi kukuchitira choyipa, chifukwa mu mzinda muno ndili ndi anthu ambiri.\"",
              "type": "text",
              "attrs": {
                "verseId": "ACT.18.10",
                "verseOrgIds": [
                  "ACT.18.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.10",
            "verseOrgIds": [
              "ACT.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Paulo anakhala kumeneko chaka ndi miyezi isanu ndi umodzi akuphunzitsa Mawu a Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.11",
            "verseOrgIds": [
              "ACT.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Galiyo ali mkulu wa boma wa ku Akaya, Ayuda mogwirizana anamugwira Paulo napita naye ku bwalo la milandu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.12",
            "verseOrgIds": [
              "ACT.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anati, \"Munthu uyu akukopa anthu kuti azipembedza Mulungu mwanjira zotsutsana ndi malamulo athu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.13",
            "verseOrgIds": [
              "ACT.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene Paulo ankati ayankhule, Galiyo anati kwa Ayuda, \"Ukanakhala mlandu wochita choyipa kapena wolakwira mnzake, bwenzi nditakumverani bwinobwino.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.14",
            "verseOrgIds": [
              "ACT.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma popeza ndi nkhani yokhudza mawu, mayina ndi malamulo anu, kambiranani nokhanokha. Ine sindidzaweruza zinthu zimenezi.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.15",
            "verseOrgIds": [
              "ACT.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotero iye anawapirikitsa mʼbwalo la milandu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.16",
            "verseOrgIds": [
              "ACT.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka iwo anagwira Sositene, mkulu wa sunagoge, ndipo anamumenya mʼbwalo la milandu momwemo. Koma Galiyo sanasamale zimenezi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.17",
            "verseOrgIds": [
              "ACT.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Prisila, Akula ndi Apolo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo anakhalabe ku Korinto masiku ambiri. Kenaka anawasiya abale nakwera sitima ya pamadzi kupita ku Siriya, pamodzi ndi Prisila ndi Akula. Asanakakwere sitima ya pamadzi, anameta tsitsi lake ku Kenkreya chifukwa anali atalumbira.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.18",
            "verseOrgIds": [
              "ACT.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anafika ku Efeso, kumene Paulo anasiyako Prisila ndi Akula. Iye yekha analowa mʼsunagoge nakambirana ndi Ayuda.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.19",
            "verseOrgIds": [
              "ACT.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo atapempha kuti akakhale nawo nthawi yayitali, iye anakana.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.20",
            "verseOrgIds": [
              "ACT.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma pamene amachoka anawalonjeza kuti, \"Ndidzabweranso Mulungu akalola.\" Ndipo anakwera sitima ya pamadzi kuchoka ku Efeso.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.21",
            "verseOrgIds": [
              "ACT.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene Paulo anafika ku Kaisareya, anakwera kukapereka moni ku mpingo kenaka anatsikira ku Antiokeya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.22",
            "verseOrgIds": [
              "ACT.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atakhala kwa kanthawi ku Antiokeya, Paulo anachokako nayendera madera onse a ku Galatiya ndi ku Frugiya kulimbikitsa ophunzira onse.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.23",
            "verseOrgIds": [
              "ACT.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Za Apolo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa nthawi yomweyi Myuda wina dzina lake Apolo, mbadwa ya ku Alekisandriya anafika ku Efeso. Anali munthu wophunzira ndi wodziwa bwino Malemba.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.24",
            "verseOrgIds": [
              "ACT.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apoloyu anaphunzitsidwa njira ya Ambuye, ndipo anayankhula ndi changu chachikulu naphunzitsa za Yesu molondola, ngakhale amadziwa ubatizo wa Yohane wokha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.25",
            "verseOrgIds": [
              "ACT.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anayamba kuyankhula mʼsunagoge molimba mtima. Pamene Prisila ndi Akula anamva, iwo anamuyitanira ku nyumba yawo ndipo anamufotokozera njira ya Mulungu molongosoka bwino.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.26",
            "verseOrgIds": [
              "ACT.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene Apolo anafuna kupita ku Akaya, abale anamulimbikitsa, nalemba kalata kwa ophunzira a kumeneko kuti amulandire. Atafika kumeneko, anathandiza kwambiri amene anakhulupirira mwachisomo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.27",
            "verseOrgIds": [
              "ACT.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti iye anatsutsa Ayuda mwamphamvu pamaso pa anthu, natsimikiza kuchokera mʼMalemba kuti Yesu ndiye Khristu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.28",
            "verseOrgIds": [
              "ACT.18.28"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "ACT.19",
