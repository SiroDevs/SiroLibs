          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndimachita zinthu zolungama.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.20",
            "verseOrgIds": [
              "PRO.8.20"
            ]
          }
        }
      ]
