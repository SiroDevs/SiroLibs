      "attrs": {
        "style": "q2",
        "vid": "PRO 8:20"
      },
      "items": [
        {
          "text": "Ine sindipatuka mʼnjira za chilungamo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.20",
            "verseOrgIds": [
              "PRO.8.20"
            ]
          }
        }
      ]
