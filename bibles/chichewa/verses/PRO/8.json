          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndimapereka chuma kwa amene amandikonda",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.21",
            "verseOrgIds": [
              "PRO.8.21"
            ]
          }
        }
