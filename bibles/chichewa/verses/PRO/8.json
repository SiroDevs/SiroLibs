      "attrs": {
        "style": "q2",
        "vid": "PRO 8:24"
      },
      "items": [
        {
          "text": "zonsezi kulibe pamene ine ndinkabadwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.24",
            "verseOrgIds": [
              "PRO.8.24"
