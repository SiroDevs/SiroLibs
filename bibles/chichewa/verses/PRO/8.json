          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyanja, akasupe odzaza ndi madzi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.24",
            "verseOrgIds": [
              "PRO.8.24"
            ]
