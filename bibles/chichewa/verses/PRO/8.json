      "attrs": {
        "style": "q2",
        "vid": "PRO 8:19"
      },
      "items": [
        {
          "text": "zimene ine ndimabereka zimaposa siliva wabwino kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.19",
            "verseOrgIds": [
              "PRO.8.19"
            ]
          }
