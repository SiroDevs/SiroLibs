      "attrs": {
        "style": "q2",
        "vid": "PRO 8:23"
      },
      "items": [
        {
          "text": "pachiyambi penipeni dziko lapansi lisanalengedwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.23",
            "verseOrgIds": [
              "PRO.8.23"
