      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:22"
      },
      "items": [
        {
          "text": "Mwa ntchito zake zakalekale yoyamba ndinali ine.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.22",
            "verseOrgIds": [
              "PRO.8.22"
            ]
          }
