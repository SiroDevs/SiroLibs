  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "PRO 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati ukhala pansi kuti udye pamodzi ndi wolamulira,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.1",
            "verseOrgIds": [
              "PRO.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:1"
      },
      "items": [
        {
          "text": "uyangʼane bwino zimene zili pamaso pako,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.1",
            "verseOrgIds": [
              "PRO.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngati ndiwe munthu wadyera",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.2",
            "verseOrgIds": [
              "PRO.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:2"
      },
      "items": [
        {
          "text": "udziletse kuti usaonetse dyera lakolo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.2",
            "verseOrgIds": [
              "PRO.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usasirire zakudya zake,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.3",
            "verseOrgIds": [
              "PRO.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:3"
      },
      "items": [
        {
          "text": "pakuti zimenezo ndi zakudya zachinyengo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.3",
            "verseOrgIds": [
              "PRO.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usadzitopetse wekha ndi kufuna chuma,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.4",
            "verseOrgIds": [
              "PRO.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:4"
      },
      "items": [
        {
          "text": "ukhale ndi nzeru ya kudziretsa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.4",
            "verseOrgIds": [
              "PRO.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukangoti wachipeza chumacho uwona posachedwa kuti palibepo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.5",
            "verseOrgIds": [
              "PRO.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:5"
      },
      "items": [
        {
          "text": "Chumacho chimachita ngati chamera mapiko mwadzidzidzi",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.5",
            "verseOrgIds": [
              "PRO.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:5"
      },
      "items": [
        {
          "text": "ndi kuwuluka kunka kumwamba ngati chiwombankhanga.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.5",
            "verseOrgIds": [
              "PRO.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usadye chakudya cha munthu waumbombo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.6",
            "verseOrgIds": [
              "PRO.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:6"
      },
      "items": [
        {
          "text": "usalakalake zakudya zake zokoma;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.6",
            "verseOrgIds": [
              "PRO.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "paja iye ndi munthu amene",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.7",
            "verseOrgIds": [
              "PRO.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:7"
      },
      "items": [
        {
          "text": "nthawi zonse amaganizira za mtengo wake",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.7",
            "verseOrgIds": [
              "PRO.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 23:7"
      },
      "items": [
        {
          "text": "ngakhale amati kwa iwe, \"Idya ndi kumwa,\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.7",
            "verseOrgIds": [
              "PRO.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:7"
      },
      "items": [
        {
          "text": "koma sakondweretsedwa nawe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.7",
            "verseOrgIds": [
              "PRO.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Udzasanza zimene wadyazo",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.8",
            "verseOrgIds": [
              "PRO.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:8"
      },
      "items": [
        {
          "text": "ndipo mawu ako woyamikira adzapita pachabe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.8",
            "verseOrgIds": [
              "PRO.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usayankhule munthu wopusa akumva,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.9",
            "verseOrgIds": [
              "PRO.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:9"
      },
      "items": [
        {
          "text": "pakuti adzanyoza mawu ako anzeru.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.9",
            "verseOrgIds": [
              "PRO.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usasunthe mwala wa mʼmalire akalekale",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.10",
            "verseOrgIds": [
              "PRO.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:10"
      },
      "items": [
        {
          "text": "kapena kulowerera mʼminda ya ana amasiye,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.10",
            "verseOrgIds": [
              "PRO.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "paja Mpulumutsi wawo ndi wamphamvu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.11",
            "verseOrgIds": [
              "PRO.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:11"
      },
      "items": [
        {
          "text": "iye adzawateteza pa milandu yawo kutsutsana nawe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.11",
            "verseOrgIds": [
              "PRO.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtima wako uzikhala pa malangizo",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.12",
            "verseOrgIds": [
              "PRO.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:12"
      },
      "items": [
        {
          "text": "ndipo makutu ako azimvetsera mawu a chidziwitso.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.12",
            "verseOrgIds": [
              "PRO.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usaleke kumulangiza mwana;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.13",
            "verseOrgIds": [
              "PRO.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:13"
      },
      "items": [
        {
          "text": "ngati umulanga ndi chikwapu sadzafa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.13",
            "verseOrgIds": [
              "PRO.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukamukwapula ndi tsatsa",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.14",
            "verseOrgIds": [
              "PRO.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:14"
      },
      "items": [
        {
          "text": "udzapulumutsa moyo wake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.14",
            "verseOrgIds": [
              "PRO.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana wanga, ngati mtima wako ukhala wanzeru,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.15",
            "verseOrgIds": [
              "PRO.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:15"
      },
      "items": [
        {
          "text": "inenso mtima wanga udzakondwera.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.15",
            "verseOrgIds": [
              "PRO.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtima wanga udzakondwera",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.16",
            "verseOrgIds": [
              "PRO.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:16"
      },
      "items": [
        {
          "text": "pamene ndidzakumva ukuyankhula zolungama.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.16",
            "verseOrgIds": [
              "PRO.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtima wako usachite nsanje ndi anthu ochimwa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.17",
            "verseOrgIds": [
              "PRO.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:17"
      },
      "items": [
        {
          "text": "koma uziopa Yehova tsiku ndi tsiku.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.17",
            "verseOrgIds": [
              "PRO.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndithu za mʼtsogolo zilipo",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.18",
            "verseOrgIds": [
              "PRO.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:18"
      },
      "items": [
        {
          "text": "ndipo chiyembekezo chakocho sichidzalephereka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.18",
            "verseOrgIds": [
              "PRO.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tamvera mwana wanga, ndipo ukhale wanzeru,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.19",
            "verseOrgIds": [
              "PRO.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:19"
      },
      "items": [
        {
          "text": "mtima wako uwuyendetse mʼnjira yabwino.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.19",
            "verseOrgIds": [
              "PRO.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usakhale pakati pa anthu amene amaledzera",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.20",
            "verseOrgIds": [
              "PRO.23.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:20"
      },
      "items": [
        {
          "text": "kapena pakati pa anthu amene amadya nyama mwadyera.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.20",
            "verseOrgIds": [
              "PRO.23.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paja anthu oledzera ndi adyera amadzakhala amphawi",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.21",
            "verseOrgIds": [
              "PRO.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:21"
      },
      "items": [
        {
          "text": "ndipo aulesi adzavala sanza.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.21",
            "verseOrgIds": [
              "PRO.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mvera abambo ako amene anakubala,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.22",
            "verseOrgIds": [
              "PRO.23.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:22"
      },
      "items": [
        {
          "text": "usanyoze amayi ako pamene akalamba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.22",
            "verseOrgIds": [
              "PRO.23.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gula choonadi ndipo usachigulitse;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.23",
            "verseOrgIds": [
              "PRO.23.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:23"
      },
      "items": [
        {
          "text": "ugulenso nzeru, mwambo ndiponso kumvetsa zinthu bwino.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.23",
            "verseOrgIds": [
              "PRO.23.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abambo a munthu wolungama ali ndi chimwemwe chachikulu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.24",
            "verseOrgIds": [
              "PRO.23.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:24"
      },
      "items": [
        {
          "text": "Wobala mwana wanzeru adzakondwera naye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.24",
            "verseOrgIds": [
              "PRO.23.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abambo ndi amayi ako asangalale;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.25",
            "verseOrgIds": [
              "PRO.23.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:25"
      },
      "items": [
        {
          "text": "amene anakubereka akondwere!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.25",
            "verseOrgIds": [
              "PRO.23.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana wanga, undikhulupirire",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.26",
            "verseOrgIds": [
              "PRO.23.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:26"
      },
      "items": [
        {
          "text": "ndipo maso ako apenyetsetse njira zanga.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.26",
            "verseOrgIds": [
              "PRO.23.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paja mkazi wachiwerewere ali ngati dzenje lozama;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.27",
            "verseOrgIds": [
              "PRO.23.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:27"
      },
      "items": [
        {
          "text": "ndipo mkazi woyendayenda ali ngati chitsime chopapatiza.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.27",
            "verseOrgIds": [
              "PRO.23.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amabisala ngati mbala yachifwamba,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.28",
            "verseOrgIds": [
              "PRO.23.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:28"
      },
      "items": [
        {
          "text": "ndipo amuna amakhala osakhulupirika chifukwa cha iyeyu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.28",
            "verseOrgIds": [
              "PRO.23.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PRO 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndani ali ndi tsoka? Ndani ali ndi chisoni?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.29",
            "verseOrgIds": [
              "PRO.23.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:29"
      },
      "items": [
        {
          "text": "Ndani ali pa mkangano? Ndani ali ndi madandawulo?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.29",
            "verseOrgIds": [
              "PRO.23.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:29"
      },
      "items": [
        {
          "text": "Ndani ali ndi zipsera zosadziwika uko zachokera? Ndani ali ndi maso ofiira?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.29",
            "verseOrgIds": [
              "PRO.23.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PRO 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi amene amakhalitsa pa mowa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.30",
            "verseOrgIds": [
              "PRO.23.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:30"
      },
      "items": [
        {
          "text": "amene amapita nalawa vinyo osakanizidwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.30",
            "verseOrgIds": [
              "PRO.23.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PRO 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usatengeke mtima ndi kufiira kwa vinyo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.31",
            "verseOrgIds": [
              "PRO.23.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:31"
      },
      "items": [
        {
          "text": "pamene akuwira mʼchikho",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.31",
            "verseOrgIds": [
              "PRO.23.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:31"
      },
      "items": [
        {
          "text": "pamene akumweka bwino!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.31",
            "verseOrgIds": [
              "PRO.23.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "PRO 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Potsiriza pake amaluma ngati njoka,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.32",
            "verseOrgIds": [
              "PRO.23.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:32"
      },
      "items": [
        {
          "text": "ndipo amajompha ngati mphiri.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.32",
            "verseOrgIds": [
              "PRO.23.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "PRO 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maso ako adzaona zinthu zachilendo",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.33",
            "verseOrgIds": [
              "PRO.23.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:33"
      },
      "items": [
        {
          "text": "ndipo maganizo ndi mawu ako adzakhala osokonekera.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.33",
            "verseOrgIds": [
              "PRO.23.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "PRO 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Udzakhala ngati munthu amene ali gone pakati pa nyanja,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.34",
            "verseOrgIds": [
              "PRO.23.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:34"
      },
      "items": [
        {
          "text": "kapena ngati munthu wogona pa msonga ya mlongoti ya ngalawa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.34",
            "verseOrgIds": [
              "PRO.23.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "PRO 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe udzanena kuti, \"Anandimenya, koma sindinapwetekedwe!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.35",
            "verseOrgIds": [
              "PRO.23.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:35"
      },
      "items": [
        {
          "text": "Andimenya koma sindinamve kanthu!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.35",
            "verseOrgIds": [
              "PRO.23.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 23:35"
      },
      "items": [
        {
          "text": "Kodi ndidzuka nthawi yanji?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.35",
            "verseOrgIds": [
              "PRO.23.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:35"
      },
      "items": [
        {
          "text": "Ndiye ndifunefunenso vinyo wina.\"",
