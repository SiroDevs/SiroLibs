      "attrs": {
        "style": "q2",
        "vid": "PRO 24:31"
      },
      "items": [
        {
          "text": "mʼnthaka imeneyo munali mutamera khwisa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.31",
            "verseOrgIds": [
              "PRO.24.31"
            ]
          }
