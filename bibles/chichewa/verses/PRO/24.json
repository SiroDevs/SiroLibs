  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "PRO 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usachitire nsanje anthu oyipa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.1",
            "verseOrgIds": [
              "PRO.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:1"
      },
      "items": [
        {
          "text": "usalakalake kuti uzikhala nawo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.1",
            "verseOrgIds": [
              "PRO.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "pakuti mitima yawo imalingalira chiwawa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.2",
            "verseOrgIds": [
              "PRO.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:2"
      },
      "items": [
        {
          "text": "ndipo pakamwa pawo pamayankhula zoyambitsa mavuto.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.2",
            "verseOrgIds": [
              "PRO.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyumba imamangidwa ndi anthu anzeru,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.3",
            "verseOrgIds": [
              "PRO.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:3"
      },
      "items": [
        {
          "text": "ndipo imakhazikika ndi anthu odziwa zinthu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.3",
            "verseOrgIds": [
              "PRO.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthu wodziwa zinthu angathe kudzaza zipinda zake",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.4",
            "verseOrgIds": [
              "PRO.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:4"
      },
      "items": [
        {
          "text": "ndi chuma chamtengowapatali ndiponso chabwino.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.4",
            "verseOrgIds": [
              "PRO.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthu wodziwa zinthu ali ndi mphamvu yayikulu kuposa munthu wanyonga zambiri,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.5",
            "verseOrgIds": [
              "PRO.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:5"
      },
      "items": [
        {
          "text": "ndipo munthu wachidziwitso amaposa munthu wamphamvu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.5",
            "verseOrgIds": [
              "PRO.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pafunika malangizo kuti ukamenye nkhondo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.6",
            "verseOrgIds": [
              "PRO.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:6"
      },
      "items": [
        {
          "text": "Pakakhala aphungu ambiri kupambana kumakhalapo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.6",
            "verseOrgIds": [
              "PRO.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzeru ndi chinthu chapatali kwambiri kwa chitsiru;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.7",
            "verseOrgIds": [
              "PRO.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:7"
      },
      "items": [
        {
          "text": "chilibe choti chiyankhule pabwalo la milandu pa chipata.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.7",
            "verseOrgIds": [
              "PRO.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amene amakonzekera kuchita zoyipa",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.8",
            "verseOrgIds": [
              "PRO.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:8"
      },
      "items": [
        {
          "text": "adzatchedwa mvundulamadzi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.8",
            "verseOrgIds": [
              "PRO.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukonzekera kuchita za uchitsiru ndi tchimo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.9",
            "verseOrgIds": [
              "PRO.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:9"
      },
      "items": [
        {
          "text": "ndipo munthu wonyoza amanyansa anthu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.9",
            "verseOrgIds": [
              "PRO.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati utaya mtima nthawi ya mavuto ndiye kuti",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.10",
            "verseOrgIds": [
              "PRO.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:10"
      },
      "items": [
        {
          "text": "mphamvu yako ndi yochepadi!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.10",
            "verseOrgIds": [
              "PRO.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwapulumutse amene akutengedwa kuti akaphedwe;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.11",
            "verseOrgIds": [
              "PRO.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:11"
      },
      "items": [
        {
          "text": "uwalanditse amene akuyenda movutika kupita kokaphedwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.11",
            "verseOrgIds": [
              "PRO.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukanena kuti, \"Koma ife sitinadziwe kanthu za izi,\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.12",
            "verseOrgIds": [
              "PRO.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:12"
      },
      "items": [
        {
          "text": "kodi Iye amene amasanthula mtima sazindikira zimenezi?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.12",
            "verseOrgIds": [
              "PRO.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 24:12"
      },
      "items": [
        {
          "text": "Kodi Iye amene amateteza moyo wako sazidziwa zimenezi?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.12",
            "verseOrgIds": [
              "PRO.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:12"
      },
      "items": [
        {
          "text": "Kodi Iye sadzalipira munthu malingana ndi ntchito zake?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.12",
            "verseOrgIds": [
              "PRO.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana wanga, uzidya uchi popeza ndi wabwino;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.13",
            "verseOrgIds": [
              "PRO.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:13"
      },
      "items": [
        {
          "text": "uchi wochokera mʼchisa cha njuchi ndi wokoma ukawulawa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.13",
            "verseOrgIds": [
              "PRO.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Udziwe kuti nzeru ndi yoteronso pa moyo wako;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.14",
            "verseOrgIds": [
              "PRO.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:14"
      },
      "items": [
        {
          "text": "ngati uyipeza nzeruyo, zinthu zidzakuyendera bwino mʼtsogolo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.14",
            "verseOrgIds": [
              "PRO.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:14"
      },
      "items": [
        {
          "text": "ndipo chiyembekezo chako sichidzapita pachabe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.14",
            "verseOrgIds": [
              "PRO.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usachite zachifwamba nyumba ya munthu wolungama ngati munthu woyipa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.15",
            "verseOrgIds": [
              "PRO.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:15"
      },
      "items": [
        {
          "text": "Usachite nayo nkhondo nyumba yake;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.15",
            "verseOrgIds": [
              "PRO.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "paja munthu wolungama akagwa kasanu nʼkawiri amadzukiriranso.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.16",
            "verseOrgIds": [
              "PRO.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 24:16"
      },
      "items": [
        {
          "text": "Koma woyipa adzathedwa tsoka likadzawafikira.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.16",
            "verseOrgIds": [
              "PRO.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usamakondwera ndi kugwa kwa mdani wako.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.17",
            "verseOrgIds": [
              "PRO.24.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
