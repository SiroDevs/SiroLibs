  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "PRO 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthu amene amawumitsabe khosi lake atadzudzulidwa kwambiri,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.1",
            "verseOrgIds": [
              "PRO.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:1"
      },
      "items": [
        {
          "text": "adzawonongeka mwadzidzidzi popanda chomuchiritsa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.1",
            "verseOrgIds": [
              "PRO.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu olungama akamalamulira mʼdziko anthu amakondwa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.2",
            "verseOrgIds": [
              "PRO.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:2"
      },
      "items": [
        {
          "text": "koma ngati dziko lilamulidwa ndi anthu oyipa mtima anthu amadandaula.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.2",
            "verseOrgIds": [
              "PRO.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthu amene amakonda nzeru amasangalatsa abambo ake,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.3",
            "verseOrgIds": [
              "PRO.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:3"
      },
      "items": [
        {
          "text": "koma woyenda ndi akazi achiwerewere amasakaza chuma chake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.3",
            "verseOrgIds": [
              "PRO.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu imalimbitsa dziko poweruza mwachilungamo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.4",
            "verseOrgIds": [
              "PRO.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:4"
      },
      "items": [
        {
          "text": "koma mfumu imene imawumiriza anthu kuti ayipatse mphatso imawononga dziko.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.4",
            "verseOrgIds": [
              "PRO.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthu woshashalika mnzake,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.5",
            "verseOrgIds": [
              "PRO.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:5"
      },
      "items": [
        {
          "text": "akudziyalira ukonde mapazi ake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.5",
            "verseOrgIds": [
              "PRO.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthu woyipa amakodwa ndi machimo ake,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.6",
            "verseOrgIds": [
              "PRO.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:6"
      },
      "items": [
        {
          "text": "koma wochita chilungamo amayimba lokoma.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.6",
            "verseOrgIds": [
              "PRO.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthu wolungama amasamalira anthu osauka,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.7",
            "verseOrgIds": [
              "PRO.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:7"
      },
      "items": [
        {
          "text": "koma woyipa salabadira zimenezi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.7",
            "verseOrgIds": [
              "PRO.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu onyoza atha kuwutsa ziwawa mu mzinda,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.8",
            "verseOrgIds": [
              "PRO.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:8"
      },
      "items": [
        {
          "text": "koma anthu anzeru amaletsa ukali.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.8",
            "verseOrgIds": [
              "PRO.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati munthu wanzeru atsutsana ndi chitsiru,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.9",
            "verseOrgIds": [
              "PRO.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:9"
      },
      "items": [
        {
          "text": "chitsirucho chimachita phokoso ndi kumangoseka ndipo sipakhala mtendere.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.9",
            "verseOrgIds": [
              "PRO.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu okhetsa magazi amadana ndi munthu wangwiro",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.10",
            "verseOrgIds": [
              "PRO.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:10"
      },
      "items": [
        {
          "text": "koma anthu olungama amasamalira moyo wake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.10",
            "verseOrgIds": [
              "PRO.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthu wopusa amaonetsa mkwiyo wake,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.11",
            "verseOrgIds": [
              "PRO.29.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:11"
      },
      "items": [
        {
          "text": "koma munthu wanzeru amadzigwira.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.11",
            "verseOrgIds": [
              "PRO.29.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati wolamulira amvera zabodza,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.12",
            "verseOrgIds": [
              "PRO.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:12"
      },
      "items": [
        {
          "text": "akuluakulu ake onse adzakhala oyipa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.12",
            "verseOrgIds": [
              "PRO.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthu wosauka ndi munthu wopondereza anzake amafanana pa kuti:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.13",
            "verseOrgIds": [
              "PRO.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:13"
      },
      "items": [
        {
          "text": "Yehova ndiye anawapatsa maso onsewa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.13",
            "verseOrgIds": [
              "PRO.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati mfumu iweruza osauka moyenera,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.14",
            "verseOrgIds": [
              "PRO.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:14"
      },
      "items": [
        {
          "text": "mpando wake waufumu udzakhazikika nthawi zonse.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.14",
            "verseOrgIds": [
              "PRO.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndodo ndi chidzudzulo zimapatsa nzeru",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.15",
            "verseOrgIds": [
              "PRO.29.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:15"
      },
      "items": [
        {
          "text": "koma mwana womulekerera amachititsa amayi ake manyazi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.15",
            "verseOrgIds": [
              "PRO.29.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyipa akamalamulira zoyipa zimachuluka,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.16",
            "verseOrgIds": [
              "PRO.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:16"
      },
      "items": [
        {
          "text": "koma anthu olungama adzaona kugwa kwa anthu oyipawo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.16",
            "verseOrgIds": [
              "PRO.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umulange mwana wako ndipo adzakupatsa mtendere",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.17",
            "verseOrgIds": [
              "PRO.29.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:17"
      },
      "items": [
        {
          "text": "ndi kusangalatsa mtima wako.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.17",
            "verseOrgIds": [
              "PRO.29.17"
            ]
