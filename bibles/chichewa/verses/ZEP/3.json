        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tsogolo la Yerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEP 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsoka kwa mzinda wa anthu opondereza,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.1",
            "verseOrgIds": [
              "ZEP.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:1"
      },
      "items": [
        {
          "text": "owukira ndi odetsedwa!",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.1",
            "verseOrgIds": [
              "ZEP.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEP 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sumvera aliyense,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.2",
            "verseOrgIds": [
              "ZEP.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:2"
      },
      "items": [
        {
          "text": "sulandira chidzudzulo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.2",
            "verseOrgIds": [
              "ZEP.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 3:2"
      },
      "items": [
        {
          "text": "Sumadalira Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.2",
            "verseOrgIds": [
              "ZEP.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:2"
      },
      "items": [
        {
          "text": "suyandikira pafupi ndi Mulungu wake.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.2",
            "verseOrgIds": [
              "ZEP.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEP 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuluakulu ake ali ngati mikango yobuma,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.3",
            "verseOrgIds": [
              "ZEP.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:3"
      },
      "items": [
        {
          "text": "olamulira ake ndi olusa ngati mimbulu ya nthawi ya madzulo,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.3",
            "verseOrgIds": [
              "ZEP.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:3"
      },
      "items": [
        {
          "text": "zimene pofika mmawa sizisiya chilichonse.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.3",
            "verseOrgIds": [
              "ZEP.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEP 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aneneri ake ndi odzikuza;",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.4",
            "verseOrgIds": [
              "ZEP.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:4"
      },
      "items": [
        {
          "text": "anthu achinyengo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.4",
            "verseOrgIds": [
              "ZEP.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 3:4"
      },
      "items": [
        {
          "text": "Ansembe ake amadetsa malo opatulika",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.4",
            "verseOrgIds": [
              "ZEP.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:4"
      },
      "items": [
        {
          "text": "ndipo amaphwanya lamulo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.4",
            "verseOrgIds": [
              "ZEP.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEP 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova amene ali pakati pawo ndi wolungama;",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.5",
            "verseOrgIds": [
              "ZEP.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:5"
      },
      "items": [
        {
          "text": "Iye salakwa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.5",
            "verseOrgIds": [
              "ZEP.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 3:5"
      },
      "items": [
        {
          "text": "Tsiku ndi tsiku amaweruza molungama,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.5",
            "verseOrgIds": [
              "ZEP.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:5"
      },
      "items": [
        {
          "text": "ndipo tsiku lililonse salephera,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.5",
            "verseOrgIds": [
              "ZEP.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:5"
      },
      "items": [
        {
          "text": "komabe ochita zoyipa sachita manyazi nʼkomwe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.5",
            "verseOrgIds": [
              "ZEP.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEP 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndachotseratu mitundu ya anthu;",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.6",
            "verseOrgIds": [
              "ZEP.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:6"
      },
      "items": [
        {
          "text": "ndagwetsa malinga awo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.6",
            "verseOrgIds": [
              "ZEP.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 3:6"
      },
      "items": [
        {
          "text": "Ndipo sindinasiye ndi mmodzi yemwe mʼmisewu mwawo,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.6",
            "verseOrgIds": [
              "ZEP.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:6"
      },
      "items": [
        {
          "text": "popanda aliyense wodutsa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.6",
            "verseOrgIds": [
              "ZEP.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 3:6"
      },
      "items": [
        {
          "text": "Mizinda yawo yawonongedwa;",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.6",
            "verseOrgIds": [
              "ZEP.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:6"
      },
      "items": [
        {
          "text": "palibe aliyense adzatsalemo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.6",
            "verseOrgIds": [
              "ZEP.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEP 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinati,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.7",
            "verseOrgIds": [
              "ZEP.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:7"
      },
      "items": [
        {
          "text": "'Ndithudi, anthu a mu mzindawu adzandiopa",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.7",
            "verseOrgIds": [
              "ZEP.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:7"
      },
      "items": [
        {
          "text": "ndi kumvera kudzudzula kwanga!'",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.7",
            "verseOrgIds": [
              "ZEP.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 3:7"
      },
      "items": [
        {
          "text": "Ndipo sindidzawononga nyumba zawo,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.7",
            "verseOrgIds": [
              "ZEP.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:7"
      },
      "items": [
        {
          "text": "kapena kuwalanganso.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.7",
            "verseOrgIds": [
              "ZEP.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 3:7"
      },
      "items": [
        {
          "text": "Koma iwo anali okonzeka",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.7",
            "verseOrgIds": [
              "ZEP.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:7"
      },
      "items": [
        {
          "text": "kuchita mwachinyengo zinthu zonse zimene amachita.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.7",
            "verseOrgIds": [
              "ZEP.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEP 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho mundidikire,\" akutero Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.8",
            "verseOrgIds": [
              "ZEP.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:8"
      },
      "items": [
        {
          "text": "\"chifukwa cha tsiku limene ndidzaperekera umboni.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.8",
            "verseOrgIds": [
              "ZEP.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 3:8"
      },
      "items": [
        {
          "text": "Ndatsimikiza kusonkhanitsa pamodzi mitundu ya anthu,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.8",
            "verseOrgIds": [
              "ZEP.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:8"
      },
      "items": [
        {
          "text": "kusonkhanitsa maufumu",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.8",
            "verseOrgIds": [
              "ZEP.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 3:8"
      },
      "items": [
        {
          "text": "ndi kutsanulira ukali wanga pa iwo;",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.8",
            "verseOrgIds": [
              "ZEP.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:8"
      },
      "items": [
        {
          "text": "mkwiyo wanga wonse woopsa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.8",
            "verseOrgIds": [
              "ZEP.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 3:8"
      },
      "items": [
        {
          "text": "Dziko lonse lidzatenthedwa",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.8",
            "verseOrgIds": [
              "ZEP.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:8"
      },
      "items": [
        {
          "text": "ndi moto wa mkwiyo wa nsanje yanga.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.8",
            "verseOrgIds": [
              "ZEP.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEP 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pamenepo ndidzayeretsa milomo ya anthu a mitundu yonse",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.9",
            "verseOrgIds": [
              "ZEP.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:9"
      },
      "items": [
        {
          "text": "kuti anthu onsewo ayitane dzina la Yehova",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.9",
            "verseOrgIds": [
              "ZEP.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:9"
      },
      "items": [
        {
          "text": "ndi kumutumikira Iye pamodzi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.9",
            "verseOrgIds": [
              "ZEP.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEP 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchokera kutsidya kwa mitsinje ya ku Kusi",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.10",
            "verseOrgIds": [
              "ZEP.3.10"
