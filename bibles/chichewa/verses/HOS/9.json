  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "HOS 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chilango cha Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe Israeli, usakondwere;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.1",
            "verseOrgIds": [
              "HOS.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:1"
      },
      "items": [
        {
          "text": "monga imachitira mitundu ina.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.1",
            "verseOrgIds": [
              "HOS.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:1"
      },
      "items": [
        {
          "text": "Pakuti wakhala wosakhulupirika kwa Mulungu wako;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.1",
            "verseOrgIds": [
              "HOS.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:1"
      },
      "items": [
        {
          "text": "umakonda malipiro a chiwerewere",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.1",
            "verseOrgIds": [
              "HOS.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:1"
      },
      "items": [
        {
          "text": "pa malo aliwonse opunthira tirigu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.1",
            "verseOrgIds": [
              "HOS.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malo opunthira tirigu ndi malo opsinyira mphesa sadzadyetsa anthu;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.2",
            "verseOrgIds": [
              "HOS.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:2"
      },
      "items": [
        {
          "text": "adzasowa vinyo watsopano.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.2",
            "verseOrgIds": [
              "HOS.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sadzakhalanso mʼdziko la Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.3",
            "verseOrgIds": [
              "HOS.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:3"
      },
      "items": [
        {
          "text": "Efereimu adzabwerera ku Igupto",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.3",
            "verseOrgIds": [
              "HOS.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:3"
      },
      "items": [
        {
          "text": "ndipo mudzadya chakudya chodetsedwa ku Asiriya.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.3",
            "verseOrgIds": [
              "HOS.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo sadzaperekanso chopereka cha chakumwa kwa Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.4",
            "verseOrgIds": [
              "HOS.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:4"
      },
      "items": [
        {
          "text": "kapena nsembe zawo kuti akondweretse Yehovayo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.4",
            "verseOrgIds": [
              "HOS.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:4"
      },
      "items": [
        {
          "text": "Nsembe zotere zidzakhala kwa iwo ngati chakudya cha anamfedwa;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.4",
            "verseOrgIds": [
              "HOS.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:4"
      },
      "items": [
        {
          "text": "onse akudya chakudya chimenechi adzakhala odetsedwa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.4",
            "verseOrgIds": [
              "HOS.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:4"
      },
      "items": [
        {
          "text": "Chakudya ichi chidzakhala chodya okha,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.4",
            "verseOrgIds": [
              "HOS.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:4"
      },
      "items": [
        {
          "text": "sichidzalowa mʼnyumba ya Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.4",
            "verseOrgIds": [
              "HOS.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi mudzachita chiyani pa tsiku la maphwando anu oyikika;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.5",
            "verseOrgIds": [
              "HOS.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:5"
      },
      "items": [
        {
          "text": "pa masiku a zikondwerero za Yehova?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.5",
            "verseOrgIds": [
              "HOS.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhale iwo atathawa chiwonongeko,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.6",
            "verseOrgIds": [
              "HOS.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:6"
      },
      "items": [
        {
          "text": "Igupto adzawasonkhanitsa,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.6",
            "verseOrgIds": [
              "HOS.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:6"
      },
      "items": [
        {
          "text": "ndipo Mefisi adzawayika mʼmanda.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.6",
            "verseOrgIds": [
              "HOS.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:6"
      },
      "items": [
        {
          "text": "Khwisa adzamera pa ziwiya zawo zasiliva,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.6",
            "verseOrgIds": [
              "HOS.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:6"
      },
      "items": [
        {
          "text": "ndipo minga idzamera mʼmatenti awo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.6",
            "verseOrgIds": [
              "HOS.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masiku achilango akubwera,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.7",
            "verseOrgIds": [
              "HOS.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:7"
      },
      "items": [
        {
          "text": "masiku obwezera ali pafupi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.7",
            "verseOrgIds": [
              "HOS.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:7"
      },
      "items": [
        {
          "text": "Israeli adziwe zimenezi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.7",
            "verseOrgIds": [
              "HOS.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:7"
      },
      "items": [
        {
          "text": "Chifukwa machimo anu ndi ochuluka kwambiri",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.7",
            "verseOrgIds": [
              "HOS.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:7"
      },
      "items": [
        {
          "text": "ndipo udani wanu pa Mulungu ndi waukulu kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.7",
            "verseOrgIds": [
              "HOS.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:7"
      },
      "items": [
        {
          "text": "Mneneri amamuyesa chitsiru,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.7",
            "verseOrgIds": [
              "HOS.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:7"
      },
      "items": [
        {
          "text": "munthu wanzeru za kwa Mulungu ngati wamisala.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.7",
            "verseOrgIds": [
              "HOS.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mneneri pamodzi ndi Mulungu wanga",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.8",
            "verseOrgIds": [
              "HOS.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:8"
      },
      "items": [
        {
          "text": "ndiwo alonda a Efereimu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.8",
            "verseOrgIds": [
              "HOS.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:8"
      },
      "items": [
        {
          "text": "koma mneneri amutchera misampha mʼnjira zake zonse,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.8",
            "verseOrgIds": [
              "HOS.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:8"
      },
      "items": [
        {
          "text": "ndipo udani ukumudikira mʼnyumba ya Mulungu wake.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.8",
            "verseOrgIds": [
              "HOS.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo azama mu zachinyengo",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.9",
            "verseOrgIds": [
              "HOS.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:9"
      },
      "items": [
        {
          "text": "monga masiku a Gibeya.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.9",
            "verseOrgIds": [
              "HOS.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:9"
      },
      "items": [
        {
          "text": "Mulungu adzakumbukira zolakwa zawo",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.9",
            "verseOrgIds": [
              "HOS.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:9"
      },
      "items": [
        {
          "text": "ndipo adzawalanga chifukwa cha machimo awo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.9",
            "verseOrgIds": [
              "HOS.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pamene ndinamupeza Israeli",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.10",
            "verseOrgIds": [
              "HOS.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:10"
      },
      "items": [
        {
          "text": "zinali ngati kupeza mphesa mʼchipululu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.10",
            "verseOrgIds": [
              "HOS.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:10"
      },
      "items": [
        {
          "text": "Nditaona makolo anu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.10",
            "verseOrgIds": [
              "HOS.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:10"
      },
      "items": [
        {
          "text": "zinali ngati ndikuona nkhuyu zoyambirira kupsa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.10",
            "verseOrgIds": [
              "HOS.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
