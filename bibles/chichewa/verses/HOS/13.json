  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "HOS 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mkwiyo wa Yehova pa Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale Efereimu ankati akayankhula, anthu ankanjenjemera;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.1",
            "verseOrgIds": [
              "HOS.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:1"
      },
      "items": [
        {
          "text": "anali wolemekezeka mu Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.1",
            "verseOrgIds": [
              "HOS.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:1"
      },
      "items": [
        {
          "text": "Koma analakwa popembedza Baala, motero anafa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.1",
            "verseOrgIds": [
              "HOS.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsopano akunka nachimwirachimwirabe;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.2",
            "verseOrgIds": [
              "HOS.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:2"
      },
      "items": [
        {
          "text": "akudzipangira mafano pogwiritsa ntchito siliva wawo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.2",
            "verseOrgIds": [
              "HOS.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 13:2"
      },
      "items": [
        {
          "text": "zifanizo zopangidwa mwaluso,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.2",
            "verseOrgIds": [
              "HOS.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:2"
      },
      "items": [
        {
          "text": "zonsezo zopangidwa ndi amisiri.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.2",
            "verseOrgIds": [
              "HOS.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 13:2"
      },
      "items": [
        {
          "text": "Amanena za anthu awa kuti,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.2",
            "verseOrgIds": [
              "HOS.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:2"
      },
      "items": [
        {
          "text": "\"Amatenga munthu ndi kumupereka nsembe",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.2",
            "verseOrgIds": [
              "HOS.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:2"
      },
      "items": [
        {
          "text": "ndipo amapsompsona fano la mwana wangʼombe.\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.2",
            "verseOrgIds": [
              "HOS.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho adzakhala ngati nkhungu yammawa,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.3",
            "verseOrgIds": [
              "HOS.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:3"
      },
      "items": [
        {
          "text": "ngati mame amene amakamuka msanga,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.3",
            "verseOrgIds": [
              "HOS.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:3"
      },
      "items": [
        {
          "text": "ngati mungu wowuluka kuchokera pa malo opunthira tirigu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.3",
            "verseOrgIds": [
              "HOS.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:3"
      },
      "items": [
        {
          "text": "ngati utsi umene ukutulukira pa zenera.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.3",
            "verseOrgIds": [
              "HOS.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Ine ndine Yehova Mulungu wanu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.4",
            "verseOrgIds": [
              "HOS.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:4"
      },
      "items": [
        {
          "text": "amene ndinakutulutsani mu Igupto.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.4",
            "verseOrgIds": [
              "HOS.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 13:4"
      },
      "items": [
        {
          "text": "Simuyenera kudziwa Mulungu wina, koma Ine ndekha,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.4",
            "verseOrgIds": [
              "HOS.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:4"
      },
      "items": [
        {
          "text": "palibe Mpulumutsi wina kupatula Ine.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.4",
            "verseOrgIds": [
              "HOS.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinakusamalira mʼchipululu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.5",
            "verseOrgIds": [
              "HOS.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:5"
      },
      "items": [
        {
          "text": "mʼdziko lotentha kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.5",
            "verseOrgIds": [
              "HOS.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene ndinawadyetsa, iwo anakhuta;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.6",
            "verseOrgIds": [
              "HOS.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:6"
      },
      "items": [
        {
          "text": "iwo atakhuta anayamba kunyada;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.6",
            "verseOrgIds": [
              "HOS.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:6"
      },
      "items": [
        {
          "text": "ndipo anandiyiwala Ine.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.6",
            "verseOrgIds": [
              "HOS.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motero ndidzawalumphira ngati mkango,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.7",
            "verseOrgIds": [
              "HOS.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:7"
      },
      "items": [
        {
          "text": "ndidzawabisalira mu msewu ngati kambuku.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.7",
            "verseOrgIds": [
              "HOS.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati chimbalangondo cholandidwa ana ake,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.8",
            "verseOrgIds": [
              "HOS.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:8"
      },
      "items": [
        {
          "text": "ndidzawambwandira ndi kuwathyolathyola.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.8",
            "verseOrgIds": [
              "HOS.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 13:8"
      },
      "items": [
        {
          "text": "Ndidzawapwepweta ngati mkango;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.8",
            "verseOrgIds": [
              "HOS.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:8"
      },
      "items": [
        {
          "text": "chirombo chakuthengo chidzawakhadzula.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.8",
            "verseOrgIds": [
              "HOS.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iwe Israeli, wawonongedwa,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.9",
            "verseOrgIds": [
              "HOS.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:9"
      },
      "items": [
        {
          "text": "chifukwa ukutsutsana ndi Ine, ukutsutsana ndi mthandizi wako.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.9",
            "verseOrgIds": [
              "HOS.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi mfumu yako ili kuti, kuti ikupulumutse?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.10",
            "verseOrgIds": [
              "HOS.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:10"
      },
      "items": [
        {
          "text": "Olamulira ako a mʼmizinda yonse ali kuti,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.10",
            "verseOrgIds": [
              "HOS.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 13:10"
      },
      "items": [
        {
          "text": "amene iwe unanena za iwo kuti,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.10",
            "verseOrgIds": [
              "HOS.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:10"
      },
      "items": [
        {
          "text": "'Patseni mfumu ndi akalonga?'",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.10",
            "verseOrgIds": [
              "HOS.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Ine ndinakupatsani mfumu mwachipseramtima,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.11",
            "verseOrgIds": [
              "HOS.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:11"
      },
      "items": [
        {
          "text": "ndipo ndinayichotsa mwaukali.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.11",
            "verseOrgIds": [
              "HOS.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulakwa kwa Efereimu kwasungidwa,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.12",
            "verseOrgIds": [
              "HOS.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 13:12"
      },
      "items": [
        {
          "text": "machimo ake alembedwa mʼbuku.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.12",
            "verseOrgIds": [
              "HOS.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HOS 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zowawa zonga za mayi pa nthawi yobala mwana zamugwera,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.13",
            "verseOrgIds": [
              "HOS.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
