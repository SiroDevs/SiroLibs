      "bookId": "TIT"
    }
  },
  "TIT.2": {
    "id": "TIT.2",
    "number": "2",
    "bookId": "TIT",
    "reference": "Tito 2",
    "copyright": "The Word of God in Contemporary Chichewa Copyright © 2002, 2016 by Biblica, Inc.® Used by permission of Biblica, Inc.® All rights reserved worldwide. Mawu a Mulungu mu Chichewa Chalero Mwini © 2002, 2016 ndi Biblica, Inc.® Kugwiritsa ntchito mwachilolezo. Umwini ndi otetezedwa pa dziko lonse.",
    "verseCount": 15,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "2",
          "style": "c",
          "sid": "TIT 2"
        },
        "items": [
          {
            "text": "2",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Malangizo Osiyanasiyana",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "TIT 2:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Koma iwe uziphunzitsa zogwirizana ndi chiphunzitso choona.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.1",
              "verseOrgIds": [
                "TIT.2.1"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "TIT 2:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "Phunzitsa amuna achikulire kuti akhale osaledzera, aulemu wawo, odziletsa, okhwima mʼchikhulupiriro, mʼchikondi ndi mʼkupirira.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.2",
              "verseOrgIds": [
                "TIT.2.2"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "TIT 2:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Chimodzimodzinso, phunzitsa amayi achikulire kuti akhale aulemu mʼmakhalidwe awo, asakhale osinjirira anzawo kapena zidakwa, koma akhale alangizi abwino.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.3",
              "verseOrgIds": [
                "TIT.2.3"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "TIT 2:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Tsono atha kulangiza amayi achichepere kukonda amuna awo ndi ana awo.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.4",
              "verseOrgIds": [
                "TIT.2.4"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "TIT 2:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "Kuwaphunzitsa kukhala odziletsa ndi oyera mtima, osamala bwino mabanja awo, okoma mtima, ndi ogonjera amuna awo. Choncho palibe amene adzanyoze mawu a Mulungu.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.5",
              "verseOrgIds": [
                "TIT.2.5"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "TIT 2:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Momwemonso, uwalimbikitse amuna achichepere kuti akhale odziletsa.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.6",
              "verseOrgIds": [
                "TIT.2.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "TIT 2:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Pa zonse iwe mwini ukhale chitsanzo pa ntchito zabwino. Pa chiphunzitso chako uwonetsa kuona mtima ndi kutsimikiza mtima kwako.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.7",
              "verseOrgIds": [
                "TIT.2.7"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "TIT 2:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "Phunzitsa choonadi kuti anthu asapeze chokutsutsa, motero wotsutsana nawe adzachita manyazi chifukwa adzasowa kanthu koyipa kuti atinenere.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.8",
              "verseOrgIds": [
                "TIT.2.8"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "TIT 2:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Phunzitsa akapolo kuti azigonjera ambuye awo mu zinthu zonse ndi kuwakondweretsa. Asamatsutsane nawo",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.9",
              "verseOrgIds": [
                "TIT.2.9"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "TIT 2:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "kapena kumawabera, koma adzionetse kuti ndi odalirika, motero pa zochita zawo zonse adzaonetsa ubwino wa chiphunzitso cha Mulungu, Mpulumutsi wathu.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.10",
              "verseOrgIds": [
                "TIT.2.10"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "TIT 2:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Pakuti chisomo cha Mulungu chimene chimapulumutsa chaonekera kwa anthu onse.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.11",
              "verseOrgIds": [
                "TIT.2.11"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "TIT 2:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "Chisomo chimatiphunzitsa kukana moyo osalemekeza Mulungu komanso zilakolako za dziko lapansi. Ndipo chimatiphunzitsa kukhala moyo odziletsa, olungama ndi opembedza Mulungu nthawi ino,",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.12",
              "verseOrgIds": [
                "TIT.2.12"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "13",
              "style": "v",
              "sid": "TIT 2:13"
            },
            "items": [
              {
                "text": "13",
                "type": "text"
              }
            ]
          },
          {
            "text": "pamene tikudikira chiyembekezo chodala; kuonekera kwa ulemerero wa Mulungu wathu wamkulu ndi Mpulumutsi, Yesu Khristu,",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.13",
              "verseOrgIds": [
                "TIT.2.13"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "14",
              "style": "v",
              "sid": "TIT 2:14"
            },
            "items": [
              {
                "text": "14",
                "type": "text"
              }
            ]
          },
          {
            "text": "amene anadzipereka yekha chifukwa cha ife kutiwombola ku zoyipa zonse ndi kudziyeretsera yekha anthu amene ndi akeake, achangu pa ntchito yabwino.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.14",
              "verseOrgIds": [
                "TIT.2.14"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "15",
              "style": "v",
              "sid": "TIT 2:15"
            },
            "items": [
              {
                "text": "15",
                "type": "text"
              }
            ]
          },
          {
            "text": "Tsono zimenezi ndi zinthu zomwe uyenera kuphunzitsa. Uziwalimbikitsa anthu ndi kuwatsutsa komwe. Uzichita zimenezi ndi ulamuliro wonse. Wina aliyense asakupeputse ayi.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.15",
              "verseOrgIds": [
                "TIT.2.15"
              ]
            }
          }
        ]
      }
    ],
    "next": {
