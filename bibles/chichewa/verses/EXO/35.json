          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Iye wapereka kwa Bezaleli pamodzi ndi Oholiabu mwana wa Ahisamaki, wa fuko la Dani luso lophunzitsa ena.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.34",
            "verseOrgIds": [
              "EXO.35.34"
