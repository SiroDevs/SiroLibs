  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "DAN 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pemphero la Danieli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼchaka choyamba cha Dariyo mwana wa Ahasiwero (wochokera kwa Amedi), amene anakhala mfumu ya ku Babuloni,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.1",
            "verseOrgIds": [
              "DAN.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ine Danieli ndinazindikira powerenga mawu a Yehova opatsidwa kwa mneneri Yeremiya, kuti Yerusalemu adzakhala bwinja kwa zaka 70.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.2",
            "verseOrgIds": [
              "DAN.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho ndinatembenukira kwa Ambuye Mulungu ndipo ndinamudandaulira ndi kupempha posala kudya, ndi kuvala chiguduli ndi kudzola phulusa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.3",
            "verseOrgIds": [
              "DAN.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinapemphera kwa Yehova Mulungu wanga ndi kuvomereza kuti tinachimwa:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.4",
            "verseOrgIds": [
              "DAN.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "DAN 9:4"
      },
      "items": [
        {
          "text": "Ndinati, \"Inu Ambuye, Mulungu wamkulu ndi woopsa, amene mumasunga pangano lanu la chikondi kwa onse amene amakukondani ndi kumvera malamulo anu,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.4",
            "verseOrgIds": [
              "DAN.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "tachimwa ndipo tachita zolakwa ndi zoyipa. Takuwukirani posiya malangizo ndi malamulo anu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.5",
            "verseOrgIds": [
              "DAN.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sitinamvere aneneri atumiki anu, amene anayankhula mʼdzina lanu kwa mafumu athu, kwa akalonga athu, makolo athu, ndi kwa anthu onse a mʼdziko.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.6",
            "verseOrgIds": [
              "DAN.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ambuye ndinu olungama, koma lero tili ndi manyazi, ife anthu a ku Yuda, a ku Yerusalemu ndi Israeli yense, apafupi ndi akutali omwe, ku mayiko onse kumene munatipirikitsira chifukwa cha kusakhulupirika kwathu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.7",
            "verseOrgIds": [
              "DAN.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Yehova, ife ndi mafumu athu, akalonga athu ndi makolo athu tili ndi manyazi chifukwa takuchimwirani.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.8",
            "verseOrgIds": [
              "DAN.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambuye Mulungu wathu ndi wachifundo ndi wokhululuka, ngakhale kuti tamuwukira:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.9",
            "verseOrgIds": [
              "DAN.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ife sitinamvere Yehova Mulungu wathu kapena kusunga malamulo ake amene anatipatsa kudzera mwa aneneri atumiki ake.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.10",
            "verseOrgIds": [
              "DAN.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aisraeli onse anachimwira lamulo lanu motero anapatuka, nakana kukumverani.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.11",
            "verseOrgIds": [
              "DAN.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "DAN 9:11"
      },
      "items": [
        {
          "text": "\"Choncho matemberero ndi olumbira amene alembedwa mʼmalamulo a Mose, mtumiki wa Mulungu, atigwera chifukwa takuchimwirani.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.11",
            "verseOrgIds": [
              "DAN.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu mwakwaniritsa mawu amene munayankhula otitsutsa ife ndi otsutsa otilamulira potibweretsera tsoka lalikulu. Pa dziko lapansi sipanachitikenso zinthu ngati zimene zaonekera Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.12",
            "verseOrgIds": [
              "DAN.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monga kunalembedwa mʼMalamulo a Mose, tsoka lililonse latifikira chikhalirecho sitinapemphe Yehova Mulungu wathu kuti atikomere mtima. Sitinasiye machimo athu, ndipo sitinasamale choonadi chanu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.13",
            "verseOrgIds": [
              "DAN.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Yehova anakonza kuti atigwetsere tsoka limeneli, ndipo wachitadi popeza Yehova Mulungu wathu ndi wolungama mu chilichonse amachita; chikhalirecho ife sitinamumvere.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.14",
            "verseOrgIds": [
              "DAN.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Inu Ambuye Mulungu wathu, munatulutsa anthu anu ku Igupto ndi dzanja lanu lamphamvu ndipo dzina lanu ndi lotchuka mpaka lero. Ife tachimwa, tachita zolakwa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.15",
            "verseOrgIds": [
              "DAN.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Ambuye, molingana ndi zochita zanu zolungama, tikukupemphani kuti muchotse mkwiyo ndi ukali wanu pa Yerusalemu mzinda wanu, phiri lanu loyera. Machimo athu ndi mphulupulu za makolo athu zachititsa kuti onse otizungulira atonze Yerusalemu ndi anthu anu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.16",
            "verseOrgIds": [
              "DAN.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tsopano Mulungu wathu, imvani mapemphero ndi zopempha za mtumiki wanu. Kuti anthu onse akudziweni kuti ndinu Ambuye, komerani mtima malo anu opatulika amene asanduka bwinja.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.17",
            "verseOrgIds": [
              "DAN.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tcherani khutu, Inu Mulungu, ndipo imvani; tsekulani maso anu ndipo onani mabwinja athu ndi mzinda umene umadziwika ndi dzina lanu. Sitikupempha chifukwa chakuti ndife olungama, koma chifukwa cha kukula kwa chifundo chanu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.18",
            "verseOrgIds": [
              "DAN.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Ambuye imvani mawu athu! Ambuye khululukani! Ambuye timvereni, ndipo muchitepo kanthu! Kuti anthu adziwe kuti Inu ndinu Mulungu wanga musachedwe chifukwa mzinda wanu ndi anthu anu amadziwika ndi dzina lanu.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.19",
            "verseOrgIds": [
              "DAN.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zaka 70",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikuyankhula ndi kupemphera, kuvomereza machimo anga ndi machimo a anthu anga Aisraeli ndi kupempherera phiri lake loyera kwa Yehova Mulungu wanga,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.20",
            "verseOrgIds": [
              "DAN.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gabrieli, munthu uja amene ndinamuona mʼmasomphenya poyambirira, anabwera kwa ine mowuluka. Iyi inali nthawi ya nsembe ya madzulo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.21",
            "verseOrgIds": [
              "DAN.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anandilangiza kuti, \"Danieli ndabwera tsopano kuti ndikupatse nzeru kuti uzitha kumvetsa zinthu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.22",
            "verseOrgIds": [
              "DAN.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utangoyamba kupemphera, Mulungu anayankha. Tsono ine ndabwera kudzakuwuza yankholo, popeza ndiwe wokondedwa kwambiri. Choncho mvetsetsa pamene ndikufotokoza za zinthu zimene unaziona mʼmasomphenya.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.23",
            "verseOrgIds": [
              "DAN.9.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zaka 490 zinayikidwa kuti anthu a mtundu wako ndi mzinda wanu woyera aleke zoyipa, asiye tchimo. Iwo adzapereka dipo kupepesera zolakwa zawo. Zikadzatero anthu adzaonetsa moyo wachilungamo nthawi zonse. Izi zidzatsimikiza zimene unaziona mʼmasomphenya zija ndi zimene ananenera aneneri. Malo opatulika adzakhazikitsidwa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.24",
            "verseOrgIds": [
              "DAN.9.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tsono udziwe ndipo uzindikire izi kuti kuyambira pamene lamulo linaperekedwa kuti Yerusalemu akonzedwenso mpaka pamene mfumu Yodzozedwa idzafike padzapita zaka 49. Pa zaka 434 mzinda wa Yerusalemu udzamangidwanso, ndipo mabwalo ndi ngalande zake zidzatetezedwa. Koma nthawiyi idzakhala ya masautso.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.25",
            "verseOrgIds": [
              "DAN.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Patatha zaka 434, Wodzozedwayo adzaphedwa ndipo sadzakhala ndi aliyense. Anthu a wolamulira amene adzabwere adzawononga mzinda ndi Nyumba ya Mulungu. Kutha kwake kudzafika ngati chigumula. Komabe nkhondo idzapitirira mpaka chiwonongeko chimene Mulungu ananeneratu chitachitika.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.26",
            "verseOrgIds": [
              "DAN.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adzachita pangano lolimba ndi anthu ambiri kwa zaka zisanu ndi ziwiri. Koma pakatinʼpakati pa sabata limodzilo iye adzaletsa kupereka nsembe ndi chopereka. Chonyansa chosakaza chija adzachiyika mʼNyumba ya Mulungu, ndipo chidzakhalapobe mpaka wochita zimenezi atalangidwa ndi chiwonongeko chimene Mulungu ananeneratu.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.27",
            "verseOrgIds": [
              "DAN.9.27"
            ]
          }
        }
      ]
    }
  ],
