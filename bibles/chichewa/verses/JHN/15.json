        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Iye amene amadana ndi Ine amadananso Atate anga.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.23",
                "verseOrgIds": [
                  "JHN.15.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.23",
            "verseOrgIds": [
              "JHN.15.23"
            ]
