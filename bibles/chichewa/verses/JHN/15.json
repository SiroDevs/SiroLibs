              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Koma zatere kuti zikwaniritse zimene zinalembedwa mʼmalamulo awo: 'Iwo anandida Ine popanda chifukwa.'",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.25",
                "verseOrgIds": [
