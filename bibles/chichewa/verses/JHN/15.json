        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ine ndikanapanda kubwera ndi kuyankhula nawo, sakanakhala ndi mlandu. Koma tsopano alibe choti nʼkukanira mlandu wawo.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.22",
                "verseOrgIds": [
                  "JHN.15.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.22",
            "verseOrgIds": [
              "JHN.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
