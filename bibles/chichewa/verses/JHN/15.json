              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ine ndikanapanda kuchita pakati pawo zinthu zimene wina aliyense sanachitepo, iwo sakanakhala ochimwa. Koma tsopano aona zodabwitsa izi, komabe akundida Ine pamodzi ndi Atate anga.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.24",
                "verseOrgIds": [
                  "JHN.15.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.24",
            "verseOrgIds": [
              "JHN.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
