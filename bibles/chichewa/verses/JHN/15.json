        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nkhoswe ikadzabwera imene Ine ndidzakutumizireni kuchokera kwa Atate, ndiye Mzimu Woyera wachoonadi amene achokera kwa Atate, Iyeyo adzandichitira umboni Ine.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.26",
