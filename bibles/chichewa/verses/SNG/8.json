  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "SNG 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "SNG 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukanakhala kuti ndiwe mlongo wanga,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.1",
            "verseOrgIds": [
              "SNG.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:1"
      },
      "items": [
        {
          "text": "amene anayamwa mawere a amayi anga!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.1",
            "verseOrgIds": [
              "SNG.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 8:1"
      },
      "items": [
        {
          "text": "Ndikanakumana nawe pa njira,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.1",
            "verseOrgIds": [
              "SNG.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:1"
      },
      "items": [
        {
          "text": "ndikanakupsompsona,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.1",
            "verseOrgIds": [
              "SNG.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:1"
      },
      "items": [
        {
          "text": "ndipo palibe wina aliyense akanandinyoza.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.1",
            "verseOrgIds": [
              "SNG.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikanakutenga",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.2",
            "verseOrgIds": [
              "SNG.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:2"
      },
      "items": [
        {
          "text": "ndi kukulowetsa mʼnyumba ya amayi anga,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.2",
            "verseOrgIds": [
              "SNG.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:2"
      },
      "items": [
        {
          "text": "amayi amene anandiphunzitsa,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.2",
            "verseOrgIds": [
              "SNG.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 8:2"
      },
      "items": [
        {
          "text": "ndikanakupatsa vinyo wotsekemera kuti umwe,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.2",
            "verseOrgIds": [
              "SNG.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:2"
      },
      "items": [
        {
          "text": "zotsekemera za makangadza.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.2",
            "verseOrgIds": [
              "SNG.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutu wanga watsamira dzanja lake lamanzere",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.3",
            "verseOrgIds": [
              "SNG.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:3"
      },
      "items": [
        {
          "text": "ndipo dzanja lake lamanja landikumbatira.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.3",
            "verseOrgIds": [
              "SNG.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu akazi a ku Yerusalemu, ndithu ndikukupemphani:",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.4",
            "verseOrgIds": [
              "SNG.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:4"
      },
      "items": [
        {
          "text": "musachigwedeze chikondi kapena kuchiutsa",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.4",
            "verseOrgIds": [
              "SNG.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:4"
      },
      "items": [
        {
          "text": "mpaka pamene chifunire ichocho.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.4",
            "verseOrgIds": [
              "SNG.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Abwenzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi ndani uyo akutuluka ku chipululuyo,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.5",
            "verseOrgIds": [
              "SNG.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:5"
      },
      "items": [
        {
          "text": "atatsamira wokondedwa wakeyo?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.5",
            "verseOrgIds": [
              "SNG.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp",
        "vid": "SNG 8:5"
      },
      "items": [
        {
          "text": "Mkazi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 8:5"
      },
      "items": [
        {
          "text": "Ndinakudzutsa pa tsinde pa mtengo wa apulosi,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.5",
            "verseOrgIds": [
              "SNG.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:5"
      },
      "items": [
        {
          "text": "pamenepo ndi pamene amayi anachirira,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.5",
            "verseOrgIds": [
              "SNG.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:5"
      },
      "items": [
        {
          "text": "pamenepo ndi pamene wokubereka anamva ululu pokubala iweyo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.5",
            "verseOrgIds": [
              "SNG.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Undiyike pamtima pako ngati chidindo,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.6",
            "verseOrgIds": [
              "SNG.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:6"
      },
      "items": [
        {
          "text": "ngati chidindo cha pa dzanja lako;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.6",
            "verseOrgIds": [
              "SNG.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 8:6"
      },
      "items": [
        {
          "text": "pakuti chikondi nʼchamphamvu ngati imfa,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.6",
            "verseOrgIds": [
              "SNG.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:6"
      },
      "items": [
        {
          "text": "nsanje ndiyaliwuma ngati manda.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.6",
            "verseOrgIds": [
              "SNG.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 8:6"
      },
      "items": [
        {
          "text": "Chikondi chimachita kuti lawilawi",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.6",
            "verseOrgIds": [
              "SNG.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:6"
      },
      "items": [
        {
          "text": "ngati malawi a moto wamphamvu.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.6",
            "verseOrgIds": [
              "SNG.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madzi ochuluka sangachizimitse chikondi,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.7",
            "verseOrgIds": [
              "SNG.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:7"
      },
      "items": [
        {
          "text": "mitsinje singachikokolole chikondicho.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.7",
            "verseOrgIds": [
              "SNG.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 8:7"
      },
      "items": [
        {
          "text": "Ngati wina apereka chuma chonse",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.7",
            "verseOrgIds": [
              "SNG.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:7"
      },
      "items": [
        {
          "text": "cha mʼnyumba mwake chifukwa cha chikondi,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.7",
            "verseOrgIds": [
              "SNG.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:7"
      },
      "items": [
        {
          "text": "adzangonyozeka nazo kotheratu.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.7",
            "verseOrgIds": [
              "SNG.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Abwenzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ife tili naye mlongo wathu wamngʼono,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.8",
            "verseOrgIds": [
              "SNG.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:8"
      },
      "items": [
        {
          "text": "koma alibe mawere,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.8",
            "verseOrgIds": [
              "SNG.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 8:8"
      },
      "items": [
        {
          "text": "kodi tidzamuchitira chiyani mlongo wathuyu",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.8",
            "verseOrgIds": [
              "SNG.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:8"
      },
      "items": [
        {
          "text": "pa tsiku limene adzamufunsire?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.8",
            "verseOrgIds": [
              "SNG.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati iye ndi khoma,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.9",
            "verseOrgIds": [
              "SNG.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:9"
      },
      "items": [
        {
          "text": "tidzamumangira nsanja ya siliva.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.9",
            "verseOrgIds": [
              "SNG.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 8:9"
      },
      "items": [
        {
          "text": "Ngati iye ndi chitseko,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.9",
            "verseOrgIds": [
              "SNG.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:9"
      },
      "items": [
        {
          "text": "tidzamutchinga ndi matabwa a mkungudza.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.9",
            "verseOrgIds": [
              "SNG.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Mkazi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "SNG 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndili ngati khoma,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.10",
            "verseOrgIds": [
              "SNG.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:10"
      },
      "items": [
        {
          "text": "ndipo mawere anga ndi nsanja zake.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.10",
            "verseOrgIds": [
              "SNG.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 8:10"
      },
      "items": [
        {
