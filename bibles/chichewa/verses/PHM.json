{
  "PHM.1": {
    "id": "PHM.1",
    "number": "1",
    "bookId": "PHM",
    "reference": "Filemoni 1",
    "copyright": "The Word of God in Contemporary Chichewa Copyright © 2002, 2016 by Biblica, Inc.® Used by permission of Biblica, Inc.® All rights reserved worldwide. Mawu a Mulungu mu Chichewa Chalero Mwini © 2002, 2016 ndi Biblica, Inc.® Kugwiritsa ntchito mwachilolezo. Umwini ndi otetezedwa pa dziko lonse.",
    "verseCount": 25,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "1",
          "style": "c",
          "sid": "PHM 1"
        },
        "items": [
          {
            "text": "1",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "PHM 1:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Kuchokera kwa Paulo, amene ndili mʼndende chifukwa cha Khristu Yesu ndi Timoteyo mʼbale wathu.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.1",
              "verseOrgIds": [
                "PHM.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p",
          "vid": "PHM 1:1"
        },
        "items": [
          {
            "text": "Kulembera Filemoni, bwenzi lathu lokondedwa ndi mtumiki mnzathu.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.1",
              "verseOrgIds": [
                "PHM.1.1"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "PHM 1:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "Kwa Apiya mlongo wathu, Arkipo msilikali mnzathu, ndiponso mpingo umene umasonkhana mʼnyumba mwanu.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.2",
              "verseOrgIds": [
                "PHM.1.2"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "PHM 1:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Chisomo ndi mtendere zochokera kwa Mulungu Atate athu ndi Ambuye Yesu Khristu zikhale ndi inu.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.3",
              "verseOrgIds": [
                "PHM.1.3"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Kuyamika ndi Pemphero",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "PHM 1:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ine ndimayamika Mulungu wanga nthawi zonse ndikakukumbukira iwe mʼmapemphero anga.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.4",
              "verseOrgIds": [
                "PHM.1.4"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "PHM 1:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "Pakuti ndamva za chikondi chako, za chikhulupiriro chako mwa Ambuye Yesu ndiponso za chikondi chako pa oyera mtima onse.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.5",
              "verseOrgIds": [
                "PHM.1.5"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "PHM 1:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ine ndikupemphera kuti mgwirizano wako ndi ife mʼchikhulupiriro ukhale opindulitsa pozamitsa nzeru zako zozindikira zinthu zilizonse zabwino zimene timagawana chifukwa cha Khristu.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.6",
              "verseOrgIds": [
                "PHM.1.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "PHM 1:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Mʼbale, chikondi chako chandipatsa chimwemwe chachikulu ndi chilimbikitso, chifukwa umatsitsimutsa mitima ya anthu a Ambuye.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.7",
              "verseOrgIds": [
                "PHM.1.7"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Paulo Apempha kuti Amuchitire Chifundo Onesimo",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "PHM 1:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "Tsopano ngakhale kuti mwa Khristu nditha kulimba mtima ndi kulamulira kuti uchite zimene uyenera kuchita,",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.8",
              "verseOrgIds": [
                "PHM.1.8"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "PHM 1:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "komabe ndikupempha mwachikondi. Ine Paulo, munthu wokalamba, ndipo tsopano ndili mʼndende chifukwa cha Khristu Yesu,",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.9",
              "verseOrgIds": [
                "PHM.1.9"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "PHM 1:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "ndikukupempha chifukwa cha mwana wanga Onesimo, amene ndamubala ndili mu unyolo.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.10",
              "verseOrgIds": [
                "PHM.1.10"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "PHM 1:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Anali wopanda phindu kwa iwe, koma tsopano wasanduka wa phindu kwa iwe ndi kwa inenso.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.11",
              "verseOrgIds": [
                "PHM.1.11"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "PHM 1:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ine ndikumutumizanso kwa iwe tsopano, koma potero ndikukhala ngati ndikutumiza mtima wanga weniweni.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.12",
              "verseOrgIds": [
                "PHM.1.12"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "13",
              "style": "v",
              "sid": "PHM 1:13"
            },
            "items": [
              {
                "text": "13",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ndikanakonda ndikanakhala naye kuno kuti iyeyo azinditumikira mʼmalo mwako pamene ndili mu unyolo chifukwa cha Uthenga Wabwino.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.13",
              "verseOrgIds": [
                "PHM.1.13"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "14",
              "style": "v",
              "sid": "PHM 1:14"
            },
            "items": [
              {
                "text": "14",
                "type": "text"
              }
            ]
          },
          {
            "text": "Koma sindikufuna kuchita kanthu osakufunsa, nʼcholinga chakuti chilichonse chabwino ungandichitire chikhale mwakufuna kwako osati mokakamiza.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.14",
              "verseOrgIds": [
                "PHM.1.14"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "15",
              "style": "v",
              "sid": "PHM 1:15"
            },
            "items": [
              {
                "text": "15",
                "type": "text"
              }
            ]
          },
          {
            "text": "Mwina chifukwa chimene unasiyana naye kwa kanthawi ndi chakuti ukhale nayenso nthawi zonse.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.15",
              "verseOrgIds": [
                "PHM.1.15"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "16",
              "style": "v",
              "sid": "PHM 1:16"
            },
            "items": [
              {
                "text": "16",
                "type": "text"
              }
            ]
          },
          {
            "text": "Osati ngati kapolo, koma woposa kapolo, ngati mʼbale wokondedwa. Iyeyu ndi wokondedwa kwambiri kwa ine koma kwa iweyo ndi wokondedwa koposa, ngati munthu komanso ngati mʼbale mwa Ambuye.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.16",
              "verseOrgIds": [
                "PHM.1.16"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "17",
              "style": "v",
              "sid": "PHM 1:17"
            },
            "items": [
              {
                "text": "17",
                "type": "text"
              }
            ]
          },
          {
            "text": "Tsono ngati umati ndine mnzako, umulandire iyeyu monga momwe ukanandilandirira ineyo.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.17",
              "verseOrgIds": [
                "PHM.1.17"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "18",
              "style": "v",
              "sid": "PHM 1:18"
            },
            "items": [
              {
                "text": "18",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ngati anakulakwira kapena kukongola kanthu kalikonse, ndidzalipira ineyo.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.18",
              "verseOrgIds": [
                "PHM.1.18"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "19",
              "style": "v",
              "sid": "PHM 1:19"
            },
            "items": [
              {
                "text": "19",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ine, Paulo ndikulemba zimenezi ndi dzanja langa. Ine ndidzalipira. Nʼkosafunika kukukumbutsa kuti iweyo ngongole yako kwa ine ndi moyo wakowo.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.19",
              "verseOrgIds": [
                "PHM.1.19"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "20",
              "style": "v",
              "sid": "PHM 1:20"
            },
            "items": [
              {
                "text": "20",
                "type": "text"
              }
            ]
          },
          {
            "text": "Mʼbale, ndikufuna kuti ndipindule nawe mwa Ambuye; tsono tsitsimutsa mtima wanga mwa Khristu.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.20",
              "verseOrgIds": [
                "PHM.1.20"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "21",
              "style": "v",
              "sid": "PHM 1:21"
            },
            "items": [
              {
                "text": "21",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ine ndili ndi chitsimikizo cha kumvera kwako pamene ndikukulembera kalatayi. Ndikulemba ndikudziwa kuti udzachita ngakhale kuposa zimene ndakupemphazi.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.21",
              "verseOrgIds": [
                "PHM.1.21"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "22",
              "style": "v",
              "sid": "PHM 1:22"
            },
            "items": [
              {
                "text": "22",
                "type": "text"
              }
            ]
          },
          {
            "text": "Chinthu chinanso ndi ichi: undikonzere malo, chifukwa ndikukhulupirira kuti Mulungu adzamvera mapemphero anu ndi kundibwezera kwa inu.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.22",
              "verseOrgIds": [
                "PHM.1.22"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Mawu Otsiriza",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "23",
              "style": "v",
              "sid": "PHM 1:23"
            },
            "items": [
              {
                "text": "23",
                "type": "text"
              }
            ]
          },
          {
            "text": "Epafra, wamʼndende mnzanga chifukwa cha Khristu Yesu akupereka moni.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.23",
              "verseOrgIds": [
                "PHM.1.23"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "24",
              "style": "v",
              "sid": "PHM 1:24"
            },
            "items": [
              {
                "text": "24",
                "type": "text"
              }
            ]
          },
          {
            "text": "Atumiki anzanga awa, Marko, Aristariko, Dema ndi Luka, akuperekanso moni.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.24",
              "verseOrgIds": [
                "PHM.1.24"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "25",
              "style": "v",
              "sid": "PHM 1:25"
            },
            "items": [
              {
                "text": "25",
                "type": "text"
              }
            ]
          },
          {
            "text": "Chisomo cha Ambuye Yesu Khristu chikhale ndi mzimu wako.",
            "type": "text",
            "attrs": {
              "verseId": "PHM.1.25",
              "verseOrgIds": [
                "PHM.1.25"
              ]
            }
          }
        ]
      }
    ],
