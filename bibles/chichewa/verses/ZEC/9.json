      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:14"
      },
      "items": [
        {
          "text": "ndipo adzayenda mu mkuntho wochokera kummwera,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.14",
            "verseOrgIds": [
              "ZEC.9.14"
            ]
          }
        }
      ]
    },
