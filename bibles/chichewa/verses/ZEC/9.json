      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:15"
      },
      "items": [
        {
          "text": "Iwo adzawononga",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.15",
            "verseOrgIds": [
              "ZEC.9.15"
            ]
          }
        }
      ]
    },
