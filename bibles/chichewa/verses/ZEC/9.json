          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Yehova adzaonekera kwa anthu ake;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.14",
            "verseOrgIds": [
              "ZEC.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:14"
      },
      "items": [
        {
          "text": "mivi yake idzangʼanima ngati chingʼaningʼani.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.14",
            "verseOrgIds": [
              "ZEC.9.14"
            ]
          }
        }
      ]
    },
    {
