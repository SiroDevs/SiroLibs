          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku limenelo Yehova Mulungu wawo adzawapulumutsa",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.16",
            "verseOrgIds": [
              "ZEC.9.16"
            ]
          }
