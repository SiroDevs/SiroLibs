      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:16"
      },
      "items": [
        {
          "text": "ngati miyala yokongola pa chipewa chaufumu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.16",
            "verseOrgIds": [
              "ZEC.9.16"
            ]
          }
