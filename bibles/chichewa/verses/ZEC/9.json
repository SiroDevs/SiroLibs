          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo Yehova Wamphamvuzonse adzawateteza.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.15",
            "verseOrgIds": [
              "ZEC.9.15"
            ]
          }
        }
      ]
