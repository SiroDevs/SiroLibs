      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:15"
      },
      "items": [
        {
          "text": "pa ngodya za guwa lansembe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.15",
            "verseOrgIds": [
              "ZEC.9.15"
            ]
