      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:14"
      },
      "items": [
        {
          "text": "Ambuye Yehova adzaliza lipenga;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.14",
            "verseOrgIds": [
              "ZEC.9.14"
            ]
          }
        }
      ]
