      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:15"
      },
      "items": [
        {
          "text": "ndipo adzagonjetsa ndi miyala ya legeni.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.15",
            "verseOrgIds": [
              "ZEC.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:15"
      },
      "items": [
        {
          "text": "Adzamwa magazi ndi kubangula ngati amwa vinyo;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.15",
            "verseOrgIds": [
              "ZEC.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:15"
      },
      "items": [
        {
          "text": "magazi adzayenderera ngati a mʼmbale yowazira magazi",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.15",
            "verseOrgIds": [
              "ZEC.9.15"
            ]
          }
        }
      ]
    },
    {
