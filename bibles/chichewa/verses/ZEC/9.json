      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:16"
      },
      "items": [
        {
          "text": "Adzanyezimira mʼdziko lake",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.16",
            "verseOrgIds": [
              "ZEC.9.16"
            ]
          }
        }
      ]
    },
