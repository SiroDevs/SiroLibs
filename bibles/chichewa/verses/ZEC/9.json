      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:16"
      },
      "items": [
        {
          "text": "pakuti anthu ake ali ngati nkhosa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.16",
            "verseOrgIds": [
              "ZEC.9.16"
            ]
          }
        }
      ]
    },
