  "verseCount": 10,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "JON 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jona anoenda kuNinevhe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JON 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo shoko raJehovha rakasvika kuna Jona kechipiri richiti,",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.1",
            "verseOrgIds": [
              "JON.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JON 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Enda kuguta reNinevhe undoriparidzira shoko randinokupa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.2",
            "verseOrgIds": [
              "JON.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JON 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jona akateerera shoko raJehovha akaenda kuNinevhe. Zvino Ninevhe raiva guta guru kwazvo, rwendo rwamazuva matatu.",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.3",
            "verseOrgIds": [
              "JON.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JON 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva rokutanga Jona akapinda muguta. Akaparidza achiti, \"Kwasara mazuva makumi mana, mushure maizvozvo Ninevhe richaparadzwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.4",
            "verseOrgIds": [
              "JON.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JON 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu veNinevhe vakatenda kuna Mwari. Vakatara nguva yokutsanya, uye vose zvavo, kubva kumukuru mukuru kusvikira kumuduku duku vakapfeka masaga.",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.5",
            "verseOrgIds": [
              "JON.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JON 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nhau idzi padzakasvika kuna mambo weNinevhe, akasimuka kubva pachigaro chake, akabvisa nguo dzake dzoumambo, akazvifukidza namasaga akagara mumadota.",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.6",
            "verseOrgIds": [
              "JON.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JON 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akazivisa chirevo muNinevhe, achiti:",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.7",
            "verseOrgIds": [
              "JON.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo",
        "vid": "JON 3:7"
      },
      "items": [
        {
          "text": "\"Chirevo chamambo namachinda ake:",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.7",
            "verseOrgIds": [
              "JON.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "JON 3:7"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "JON 3:7"
      },
      "items": [
        {
          "text": "\"Musarega munhu kana mhuka, chipfuwo kana gwai, zvichiravira chinhu; musazvirega zvichidya kana kunwa.",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.7",
            "verseOrgIds": [
              "JON.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JON 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vanhu nemhuka ngavafuke masaga. Munhu wose ngaadane kuna Mwari iye zvino. Ngavasiye nzira dzavo dzakaipa nokuita kwavo nechisimba.",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.8",
            "verseOrgIds": [
              "JON.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JON 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiani anoziva? Zvichida Mwari angazvidemba uye netsitsi dzake akazvidzora kubva pakutsamwa kwake kunotyisa kuti tirege kuparara.\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.9",
            "verseOrgIds": [
              "JON.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JON 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari akati aona zvavakaita uye kutendeuka kwavakaita kubva panzira dzavo dzakaipa, akavanzwira tsitsi akasauyisa kuparadzwa pamusoro pavo sezvaaida kuvaitira.",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.10",
            "verseOrgIds": [
              "JON.3.10"
            ]
          }
        }
      ]
    }
  ],
