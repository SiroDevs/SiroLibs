  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "JON 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kutsamwa kwaJona nokuda kwetsitsi dzaJehovha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JON 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Jona haana kufadzwa nazvo uye akatsamwa.",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.1",
            "verseOrgIds": [
              "JON.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JON 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanyengetera kuna Jehovha akati, \"Imi Jehovha, izvi hazvisizvo here zvandakataura ndiri kunyika yangu? Ndokusaka ndakakurumidza kutiza ndichienda kuTashishi? Ndaiziva kuti muri Mwari ane tsitsi nenyasha, anononoka kutsamwa uye azere norudo, Mwari anozvidzora pakutumira zvakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.2",
            "verseOrgIds": [
              "JON.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JON 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino, imi Jehovha, torai zvenyu upenyu hwangu, nokuti zviri nani kuti ndife zvangu pano kurarama.\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.3",
            "verseOrgIds": [
              "JON.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JON 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Jehovha akapindura akati, \"Zvakanaka here kuti utsamwe?\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.4",
            "verseOrgIds": [
              "JON.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JON 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jona akabuda akaenda akandogara pasi kunze kweguta nechokumabvazuva. Ikoko akazvivakira dumba, akagara mumumvuri waro ndokumirira kuti aone zvaizoitika kuguta.",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.5",
            "verseOrgIds": [
              "JON.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JON 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha Mwari akameresa muti womuzambiringa, akauita kuti ukure kumusoro kwaJona kuti uite mumvuri pamusoro pake, kuti shungu dzake dzidzikire, uye Jona akafara kwazvo nokuda kwomuzambiringa.",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.6",
            "verseOrgIds": [
              "JON.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JON 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi chifumi chezuva rakatevera Mwari akatuma gonye rikadya muzambiringa uyu zvokuti wakasvava.",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.7",
            "verseOrgIds": [
              "JON.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JON 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zuva rakati richibuda, Mwari akatuma mhepo yokumabvazuva yaipisa kwazvo, uye zuva rikabaya pamusoro paJona zvokuti akaziya. Akademba kufa, uye akati, \"Zvingava nani kuti ndife zvangu pano kurarama.\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.8",
            "verseOrgIds": [
              "JON.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JON 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Mwari akati kuna Jona, \"Zvakanaka here kuti utsamwe nokuda kwomuzambiringa uyu?\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.9",
            "verseOrgIds": [
              "JON.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JON 4:9"
      },
      "items": [
        {
          "text": "Iye akati, \"Hongu, ndakatsamwa zvokuti ndife.\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.9",
            "verseOrgIds": [
              "JON.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JON 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Jehovha akati, \"Iwe wanga une hanya nomuzambiringa uyu, kunyange zvazvo usina kuuchengeta kana kuukudza. Wakabuda nousiku humwe uye ukaparara nousiku humwe.",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.10",
            "verseOrgIds": [
              "JON.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JON 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Ninevhe rine vanhu vanopfuura zviuru zana namakumi maviri avanhu vasingazivi kuti ruoko rwavo rworudyi ndorupi kana rworuboshwe ndorupi, uye nemombe zhinjiwo. Handingavi nehanya here neguta iro guru?\"",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.11",
            "verseOrgIds": [
              "JON.4.11"
            ]
          }
        }
      ]
    }
  ],
