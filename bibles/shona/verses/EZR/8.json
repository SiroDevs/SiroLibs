      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZR 8:6"
      },
      "items": [
        {
          "text": "Ebhedhi mwanakomana waJonatani, uye pamwe chete naye varume makumi mashanu;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.6",
            "verseOrgIds": [
              "EZR.8.6"
            ]
