      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZR 8:3"
      },
      "items": [
        {
          "text": "Zekaria, uye pamwe chete naye kwakanyorwa varume zana namakumi mashanu;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.3",
            "verseOrgIds": [
              "EZR.8.3"
            ]
          }
        }
      ]
    },
    {
