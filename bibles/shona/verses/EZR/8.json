            "sid": "EZR 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ava ndivo vakuru vemhuri naavo vakanyorwa pamwe chete navo vakauya pamwe chete neni kubva kuBhabhironi panguva yokutonga kwaMambo Atazekisesi:",
          "type": "text"
        }
      ]
    },
    {
