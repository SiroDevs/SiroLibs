            "verseOrgIds": [
              "EZR.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZR 8:10"
      },
      "items": [
        {
