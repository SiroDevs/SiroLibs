      "attrs": {
        "style": "li2",
        "vid": "EZR 8:9"
      },
      "items": [
        {
          "text": "Obhadhia mwanakomana waJehieri, uye pamwe chete naye varume mazana maviri negumi navasere;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.9",
            "verseOrgIds": [
              "EZR.8.9"
            ]
          }
        }
      ]
    },
    {
