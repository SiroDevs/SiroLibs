  "verseCount": 9,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "47",
        "style": "c",
        "sid": "PSA 47"
      },
      "items": [
        {
          "text": "47",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 47",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kumutungamiri wokuimba waVanakomana vaKora. Pisarema.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 47:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uchirai maoko, imi vanhu vose;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.1",
            "verseOrgIds": [
              "PSA.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:1"
      },
      "items": [
        {
          "text": "pururudzai kuna Mwari nokudanidzira kwomufaro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.1",
            "verseOrgIds": [
              "PSA.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha Wokumusoro-soro anotyisa sei,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.2",
            "verseOrgIds": [
              "PSA.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:2"
      },
      "items": [
        {
          "text": "iye Mambo mukuru pamusoro penyika yose!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.2",
            "verseOrgIds": [
              "PSA.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 47:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaisa ndudzi dzavanhu pasi pedu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.3",
            "verseOrgIds": [
              "PSA.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:3"
      },
      "items": [
        {
          "text": "marudzi pasi petsoka dzedu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.3",
            "verseOrgIds": [
              "PSA.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 47:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatitsaurira nhaka yedu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.4",
            "verseOrgIds": [
              "PSA.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:4"
      },
      "items": [
        {
          "text": "iyo pfuma yaJakobho, waakada.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.4",
            "verseOrgIds": [
              "PSA.47.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sera",
              "type": "text",
              "attrs": {
                "verseId": "PSA.47.4",
                "verseOrgIds": [
                  "PSA.47.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari akwidza kumusoro pakati pokudanidzira kwomufaro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.5",
            "verseOrgIds": [
              "PSA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:5"
      },
      "items": [
        {
          "text": "Jehovha pakati pokurira kwehwamanda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.5",
            "verseOrgIds": [
              "PSA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbirai Mwari nziyo dzokurumbidza, murumbidzei nenziyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.6",
            "verseOrgIds": [
              "PSA.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:6"
      },
      "items": [
        {
          "text": "Imbirai Mambo wedu nziyo dzokurumbidza, murumbidzei nenziyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.6",
            "verseOrgIds": [
              "PSA.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 47:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti Mwari ndiye Mambo wenyika yose;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.7",
            "verseOrgIds": [
              "PSA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:7"
      },
      "items": [
        {
          "text": "muimbirei pisarema rokurumbidza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.7",
            "verseOrgIds": [
              "PSA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 47:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari anotonga pamusoro pendudzi dzose;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.8",
            "verseOrgIds": [
              "PSA.47.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:8"
      },
      "items": [
        {
          "text": "Mwari agere pamusoro pechigaro chake chitsvene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.8",
            "verseOrgIds": [
              "PSA.47.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 47:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makurukota amarudzi aungana",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.9",
            "verseOrgIds": [
              "PSA.47.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:9"
      },
      "items": [
        {
          "text": "savanhu vaMwari waAbhurahama,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.9",
            "verseOrgIds": [
              "PSA.47.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 47:9"
      },
      "items": [
        {
          "text": "nokuti madzimambo enyika ndeaMwari;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.9",
            "verseOrgIds": [
              "PSA.47.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 47:9"
      },
      "items": [
        {
          "text": "iye anokudzwa zvikuru kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.47.9",
            "verseOrgIds": [
              "PSA.47.10"
            ]
          }
        }
      ]
    }
  ],
