          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaipa havana kudaro!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.4",
            "verseOrgIds": [
              "PSA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 1:4"
      },
      "items": [
        {
          "text": "Vakafanana nehundi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.4",
            "verseOrgIds": [
              "PSA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 1:4"
      },
      "items": [
        {
          "text": "inopepereswa nemhepo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.4",
            "verseOrgIds": [
              "PSA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
