      "attrs": {
        "style": "q2",
        "vid": "PSA 74:18"
      },
      "items": [
        {
          "text": "uye kuti mapenzi akamhura sei zita renyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.18",
            "verseOrgIds": [
              "PSA.74.18"
            ]
