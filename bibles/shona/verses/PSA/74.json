          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivai nehanya nesungano yenyu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.20",
            "verseOrgIds": [
              "PSA.74.20"
            ]
