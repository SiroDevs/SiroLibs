            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rangarirai kuti muvengi akakushorai sei, imi Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.18",
            "verseOrgIds": [
