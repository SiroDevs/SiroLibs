  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "74",
        "style": "c",
        "sid": "PSA 74"
      },
      "items": [
        {
          "text": "74",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 74",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Masikiri raAsafi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 74:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Mwari, makatirambireiko nokusingaperi?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.1",
            "verseOrgIds": [
              "PSA.74.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:1"
      },
      "items": [
        {
          "text": "Kutsamwa kwenyu kwapfungairireiko pamusoro pamakwai anofudzwa nemi?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.1",
            "verseOrgIds": [
              "PSA.74.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 74:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rangarirai vanhu vamakatenga kare,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.2",
            "verseOrgIds": [
              "PSA.74.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:2"
      },
      "items": [
        {
          "text": "rudzi rwenhaka yenyu, ivo vamakadzikinura,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.2",
            "verseOrgIds": [
              "PSA.74.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:2"
      },
      "items": [
        {
          "text": "Gomo reZioni, pamaigara.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.2",
            "verseOrgIds": [
              "PSA.74.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 74:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzorai nhambwe dzenyu mutarise matongo asingaperi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.3",
            "verseOrgIds": [
              "PSA.74.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:3"
      },
      "items": [
        {
          "text": "kuparadza ikoku kwose kwakauya nomuvengi pamusoro penzvimbo yenyu tsvene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.3",
            "verseOrgIds": [
              "PSA.74.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 74:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vavengi venyu vakaomba panzvimbo yamakasangana nesu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.4",
            "verseOrgIds": [
              "PSA.74.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:4"
      },
      "items": [
        {
          "text": "vakamisa mireza yavo sechiratidzo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.4",
            "verseOrgIds": [
              "PSA.74.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 74:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaita savanhu vanosimudza matemo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.5",
            "verseOrgIds": [
              "PSA.74.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:5"
      },
      "items": [
        {
          "text": "kuti vateme dondo remiti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.5",
            "verseOrgIds": [
              "PSA.74.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 74:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaputsa zvose zvakavezwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.6",
            "verseOrgIds": [
              "PSA.74.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:6"
      },
      "items": [
        {
          "text": "namatemo avo nembezo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.6",
            "verseOrgIds": [
              "PSA.74.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 74:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakapisira pasi nzvimbo yenyu tsvene;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.7",
            "verseOrgIds": [
              "PSA.74.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:7"
      },
      "items": [
        {
          "text": "vakamhura ugaro hweZita renyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.7",
            "verseOrgIds": [
              "PSA.74.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 74:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati mumwoyo yavo, \"Tichavaputsa zvachose!\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.8",
            "verseOrgIds": [
              "PSA.74.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:8"
      },
      "items": [
        {
          "text": "Vakapisa nzvimbo dzose dzokunamatira Mwari munyika.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.8",
            "verseOrgIds": [
              "PSA.74.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 74:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatichaoni zviratidzo zvinoshamisa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.9",
            "verseOrgIds": [
              "PSA.74.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:9"
      },
      "items": [
        {
          "text": "hakuna muprofita akasara,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.9",
            "verseOrgIds": [
              "PSA.74.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:9"
      },
      "items": [
        {
          "text": "pakati pedu hapana munhu anoziva kuti zvicharamba zvakadaro kusvikira rini.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.9",
            "verseOrgIds": [
              "PSA.74.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 74:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Mwari, muvengi acharamba achikushorai kusvikira riniko?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.10",
            "verseOrgIds": [
              "PSA.74.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:10"
      },
      "items": [
        {
          "text": "Ko, muvengi acharamba achimhura zita renyu nokusingaperi here?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.10",
            "verseOrgIds": [
              "PSA.74.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 74:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munodzoserereiko ruoko rwenyu shure, irwo ruoko rwenyu rworudyi?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.11",
            "verseOrgIds": [
              "PSA.74.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:11"
      },
      "items": [
        {
          "text": "Rubvisei pamupendero wenguo yenyu muvaparadze!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.11",
            "verseOrgIds": [
              "PSA.74.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 74:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi imi, iyemi Mwari, ndimi mambo wangu kubva nakare;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.12",
            "verseOrgIds": [
              "PSA.74.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:12"
      },
      "items": [
        {
          "text": "imi munouyisa ruponeso panyika.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.12",
            "verseOrgIds": [
              "PSA.74.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 74:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndimi makaganhura gungwa napakati nesimba renyu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.13",
            "verseOrgIds": [
              "PSA.74.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:13"
      },
      "items": [
        {
          "text": "makaputsa misoro yechikara chomumvura.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.13",
            "verseOrgIds": [
              "PSA.74.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 74:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndimi makapwanya misoro yaRevhiatani,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.14",
            "verseOrgIds": [
              "PSA.74.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:14"
      },
      "items": [
        {
          "text": "mukamuita chokudya chezvisikwa zvomugwenga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.14",
            "verseOrgIds": [
              "PSA.74.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 74:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndimi makazarura zvitubu nehova;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.15",
            "verseOrgIds": [
              "PSA.74.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:15"
      },
      "items": [
        {
          "text": "mukapwisa nzizi dzaigara dzichierera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.15",
            "verseOrgIds": [
              "PSA.74.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 74:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zuva nderenyu, uye usiku ndohwenyuwo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.16",
            "verseOrgIds": [
              "PSA.74.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:16"
      },
      "items": [
        {
          "text": "makasimbisa zuva nomwedzi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.16",
            "verseOrgIds": [
              "PSA.74.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 74:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndimi makatara miganhu yose yenyika;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.17",
            "verseOrgIds": [
              "PSA.74.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:17"
      },
      "items": [
        {
          "text": "mukaita zvose zhizha nechando.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.17",
            "verseOrgIds": [
              "PSA.74.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
