      "attrs": {
        "style": "q2",
        "vid": "PSA 74:19"
      },
      "items": [
        {
          "text": "regai kukanganwa nokusingaperi upenyu hwavanhu venyu vanonetswa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.19",
            "verseOrgIds": [
