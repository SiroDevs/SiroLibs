          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinodanidzira kwamuri Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.1",
            "verseOrgIds": [
              "PSA.130.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 130:1"
      },
      "items": [
        {
          "text": "ndiri pakadzika;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.1",
            "verseOrgIds": [
              "PSA.130.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 130:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "haiwa Jehovha, inzwai inzwi rangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.2",
            "verseOrgIds": [
              "PSA.130.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 130:2"
      },
      "items": [
        {
          "text": "Nzeve dzenyu ngadzinzwe kuchemera kwangu ngoni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.2",
            "verseOrgIds": [
              "PSA.130.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 130:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dai imi, iyemi Jehovha, maironda zvakaipa zvomunhu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.3",
            "verseOrgIds": [
              "PSA.130.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 130:3"
      },
      "items": [
        {
          "text": "haiwa Jehovha, ndianiko aimira?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.3",
            "verseOrgIds": [
              "PSA.130.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 130:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kwamuri kune kukanganwira;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.4",
            "verseOrgIds": [
              "PSA.130.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 130:4"
      },
      "items": [
        {
          "text": "naizvozvo imi munotyiwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.4",
            "verseOrgIds": [
              "PSA.130.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 130:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinomirira Jehovha, mweya wangu unomirira,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.5",
            "verseOrgIds": [
              "PSA.130.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 130:5"
      },
      "items": [
        {
          "text": "uye tariro yangu iri mushoko rake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.5",
            "verseOrgIds": [
              "PSA.130.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 130:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mweya wangu unorindira Ishe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.6",
            "verseOrgIds": [
              "PSA.130.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 130:6"
      },
      "items": [
        {
          "text": "kupfuura varindi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.6",
            "verseOrgIds": [
              "PSA.130.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 130:6"
      },
      "items": [
        {
          "text": "vanomirira rungwanani.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.6",
            "verseOrgIds": [
              "PSA.130.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 130:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Israeri, isa tariro yako muna Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.7",
            "verseOrgIds": [
              "PSA.130.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 130:7"
      },
      "items": [
        {
          "text": "nokuti Jehovha ane rudo rusingaperi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.7",
            "verseOrgIds": [
              "PSA.130.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 130:7"
      },
      "items": [
        {
          "text": "uye kwaari kune dzikinuro izere.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.7",
            "verseOrgIds": [
              "PSA.130.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 130:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye pachake achadzikinura Israeri",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.8",
            "verseOrgIds": [
              "PSA.130.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 130:8"
      },
      "items": [
        {
          "text": "kubva pazvivi zvavo zvose.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.8",
            "verseOrgIds": [
              "PSA.130.8"
            ]
          }
        }
      ]
