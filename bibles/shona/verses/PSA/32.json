      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:5"
      },
      "items": [
        {
          "text": "uye makandiregerera mhosva yechivi changu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.5",
            "verseOrgIds": [
              "PSA.32.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sera",
              "type": "text",
              "attrs": {
                "verseId": "PSA.32.5",
                "verseOrgIds": [
                  "PSA.32.5"
                ]
              }
            }
          ]
        }
      ]
