          "text": "Ndimi nzvimbo yangu yokuvanda;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.7",
            "verseOrgIds": [
              "PSA.32.7"
            ]
          }
        }
      ]
    },
