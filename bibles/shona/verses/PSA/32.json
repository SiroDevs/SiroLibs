      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:6"
      },
      "items": [
        {
          "text": "muchiri kuwanikwa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.6",
            "verseOrgIds": [
              "PSA.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 32:6"
      },
      "items": [
        {
          "text": "zvirokwazvo mvura zhinji ine simba painokwira,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.6",
            "verseOrgIds": [
              "PSA.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:6"
      },
      "items": [
        {
          "text": "haingasviki kwavari.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.6",
            "verseOrgIds": [
              "PSA.32.6"
            ]
          }
        }
      ]
    },
    {
