          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaropafadzwa uyo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.1",
            "verseOrgIds": [
              "PSA.32.1"
            ]
          }
        }
