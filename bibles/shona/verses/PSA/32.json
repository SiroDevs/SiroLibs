          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti masikati nousiku",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.4",
            "verseOrgIds": [
              "PSA.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:4"
      },
      "items": [
        {
          "text": "ruoko rwenyu rwakanga ruchirema pamusoro pangu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.4",
            "verseOrgIds": [
              "PSA.32.4"
            ]
          }
        }
      ]
    },
