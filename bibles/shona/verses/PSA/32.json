      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 32:4"
      },
      "items": [
        {
          "text": "simba rangu rakasvetwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.4",
            "verseOrgIds": [
              "PSA.32.4"
            ]
          }
        }
      ]
    },
