          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farai muna Jehovha uye mufarisise, imi vakarurama;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.11",
            "verseOrgIds": [
              "PSA.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:11"
      },
      "items": [
        {
          "text": "imbai, imi mose makarurama pamwoyo!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.11",
            "verseOrgIds": [
              "PSA.32.11"
            ]
          }
        }
      ]
