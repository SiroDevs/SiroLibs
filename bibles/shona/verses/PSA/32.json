      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:3"
      },
      "items": [
        {
          "text": "mapfupa angu akarukutika nokuda",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.3",
            "verseOrgIds": [
              "PSA.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:3"
      },
      "items": [
        {
          "text": "kwokugomera kwangu zuva rose.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.3",
            "verseOrgIds": [
              "PSA.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
