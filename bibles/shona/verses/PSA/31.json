          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguva dzangu dziri mumaoko enyu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.15",
            "verseOrgIds": [
              "PSA.31.16"
            ]
