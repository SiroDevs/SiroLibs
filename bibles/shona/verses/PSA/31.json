      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:23"
      },
      "items": [
        {
          "text": "Jehovha anochengetedza vakatendeka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.23",
            "verseOrgIds": [
              "PSA.31.24"
            ]
          }
        }
