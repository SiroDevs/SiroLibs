  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "PSA 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kumutungamiri wokuimba. Pisarema raDhavhidhi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinovanda mamuri, imi Jehovha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.1",
            "verseOrgIds": [
              "PSA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:1"
      },
      "items": [
        {
          "text": "itai kuti ndisatombonyadziswa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.1",
            "verseOrgIds": [
              "PSA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:1"
      },
      "items": [
        {
          "text": "ndirwirei mukururama kwenyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.1",
            "verseOrgIds": [
              "PSA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rerekerai nzeve yenyu kwandiri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.2",
            "verseOrgIds": [
              "PSA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:2"
      },
      "items": [
        {
          "text": "kurumidzai kundinunura;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.2",
            "verseOrgIds": [
              "PSA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 31:2"
      },
      "items": [
        {
          "text": "ivai dombo rangu rokuvanda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.2",
            "verseOrgIds": [
              "PSA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:2"
      },
      "items": [
        {
          "text": "nhare yakasimba inondiponesa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.2",
            "verseOrgIds": [
              "PSA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezvo murimi dombo rangu nenhare yangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.3",
            "verseOrgIds": [
              "PSA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:3"
      },
      "items": [
        {
          "text": "nditungamirirei uye mundisesedze nokuda kwezita renyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.3",
            "verseOrgIds": [
              "PSA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndisunungurei pamusungo wandakadzikirwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.4",
            "verseOrgIds": [
              "PSA.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:4"
      },
      "items": [
        {
          "text": "nokuti imi muri utiziro hwangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.4",
            "verseOrgIds": [
              "PSA.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinoisa mweya wangu mumaoko enyu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.5",
            "verseOrgIds": [
              "PSA.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:5"
      },
      "items": [
        {
          "text": "ndidzikinurei, imi Jehovha, Mwari wechokwadi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.5",
            "verseOrgIds": [
              "PSA.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinovenga vanonamatira kuzvifananidzo zvisina maturo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.6",
            "verseOrgIds": [
              "PSA.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:6"
      },
      "items": [
        {
          "text": "ndinovimba naJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.6",
            "verseOrgIds": [
              "PSA.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichafara nokufarisisa murudo rwenyu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.7",
            "verseOrgIds": [
              "PSA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:7"
      },
      "items": [
        {
          "text": "nokuti makaona kutambudzika kwangu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.7",
            "verseOrgIds": [
              "PSA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:7"
      },
      "items": [
        {
          "text": "mukaziva kurwadziwa kwomwoyo wangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.7",
            "verseOrgIds": [
              "PSA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamuna kundiisa kumuvengi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.8",
            "verseOrgIds": [
              "PSA.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:8"
      },
      "items": [
        {
          "text": "asi makamisa tsoka dzangu panzvimbo yakafarikana.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.8",
            "verseOrgIds": [
              "PSA.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Jehovha, ndinzwirei ngoni nokuti ndine nhamo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.9",
            "verseOrgIds": [
              "PSA.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:9"
      },
      "items": [
        {
          "text": "meso angu aneta nokuchema,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.9",
            "verseOrgIds": [
              "PSA.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:9"
      },
      "items": [
        {
          "text": "mwoyo wangu nomuviri wangu zvarwadziwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.9",
            "verseOrgIds": [
              "PSA.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Upenyu hwangu hwopera nokurwadziwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.10",
            "verseOrgIds": [
              "PSA.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:10"
      },
      "items": [
        {
          "text": "uye namakore angu nokugomera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.10",
            "verseOrgIds": [
              "PSA.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 31:10"
      },
      "items": [
        {
          "text": "simba rangu rapera nokuda kwokutambudzika kwangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.10",
            "verseOrgIds": [
              "PSA.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:10"
      },
      "items": [
        {
          "text": "uye mapfupa angu arukutika.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.10",
            "verseOrgIds": [
              "PSA.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuda kwavavengi vangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.11",
            "verseOrgIds": [
              "PSA.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:11"
      },
      "items": [
        {
          "text": "ndava chinhu chinovengwa navavakidzani vangu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.11",
            "verseOrgIds": [
              "PSA.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 31:11"
      },
      "items": [
        {
          "text": "ndava chinhu chinotyisa kushamwari dzangu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.11",
            "verseOrgIds": [
              "PSA.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:11"
      },
      "items": [
        {
          "text": "vanondiona munzira dzomumisha vanonditiza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.11",
            "verseOrgIds": [
              "PSA.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakanganwikwa navo sendakafa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.12",
            "verseOrgIds": [
              "PSA.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:12"
      },
      "items": [
        {
          "text": "ndafanana nehari yakaputsika,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.12",
            "verseOrgIds": [
              "PSA.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti ndinonzwa guhwa ravazhinji;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.13",
            "verseOrgIds": [
              "PSA.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:13"
      },
      "items": [
        {
          "text": "kumativi ose kune zvinotyisa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.13",
            "verseOrgIds": [
              "PSA.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 31:13"
      },
      "items": [
        {
          "text": "vanorangana pamusoro pangu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.13",
            "verseOrgIds": [
              "PSA.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:13"
      },
      "items": [
        {
          "text": "uye vanoronga kundiuraya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.13",
            "verseOrgIds": [
              "PSA.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi ndinovimba nemi, imi Jehovha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.14",
            "verseOrgIds": [
              "PSA.31.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:14"
      },
      "items": [
        {
          "text": "ndinoti, \"Ndimi Mwari wangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.14",
            "verseOrgIds": [
              "PSA.31.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
