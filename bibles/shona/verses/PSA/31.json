      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:16"
      },
      "items": [
        {
          "text": "ndiponesei norudo rwenyu rusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.16",
            "verseOrgIds": [
              "PSA.31.17"
            ]
          }
