      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:22"
      },
      "items": [
        {
          "text": "pandakadanidzira kwamuri ndichida rubatsiro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.22",
            "verseOrgIds": [
              "PSA.31.23"
            ]
