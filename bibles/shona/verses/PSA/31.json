      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 31:22"
      },
      "items": [
        {
          "text": "Asi makanzwa kuchemera nyasha kwangu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.22",
            "verseOrgIds": [
              "PSA.31.23"
            ]
          }
        }
      ]
