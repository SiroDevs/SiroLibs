          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiso chenyu ngachipenye pamusoro pomuranda wenyu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.16",
            "verseOrgIds": [
              "PSA.31.17"
            ]
          }
        }
      ]
    },
