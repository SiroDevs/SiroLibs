      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:15"
      },
      "items": [
        {
          "text": "nokuna avo vanonditeverera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.15",
            "verseOrgIds": [
              "PSA.31.16"
            ]
          }
