  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "36",
        "style": "c",
        "sid": "PSA 36"
      },
      "items": [
        {
          "text": "36",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 36",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kumutungamiri wokuimba. Pisarema raDhavhidhi muranda waJehovha.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shoko riri mumwoyo mangu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.1",
            "verseOrgIds": [
              "PSA.36.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:1"
      },
      "items": [
        {
          "text": "pamusoro pokutadza kweakaipa rinoti:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.1",
            "verseOrgIds": [
              "PSA.36.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 36:1"
      },
      "items": [
        {
          "text": "Hakuna kutya Mwari",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.1",
            "verseOrgIds": [
              "PSA.36.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:1"
      },
      "items": [
        {
          "text": "pamberi pake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.1",
            "verseOrgIds": [
              "PSA.36.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamaonero ake anozvirumbidza, nokuti anozvibata kumeso kwazvo pakuona kwake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.2",
            "verseOrgIds": [
              "PSA.36.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:2"
      },
      "items": [
        {
          "text": "zvokuti anotadza kuona kana kuvenga chivi chake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.2",
            "verseOrgIds": [
              "PSA.36.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mashoko omuromo wake akaipa uye anonyengera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.3",
            "verseOrgIds": [
              "PSA.36.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:3"
      },
      "items": [
        {
          "text": "haachisiri munhu akachenjera kana anoita zvakanaka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.3",
            "verseOrgIds": [
              "PSA.36.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange panhoo yake anofunga zvakaipa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.4",
            "verseOrgIds": [
              "PSA.36.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:4"
      },
      "items": [
        {
          "text": "anozvifambisa panzira yezvakaipa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.4",
            "verseOrgIds": [
              "PSA.36.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:4"
      },
      "items": [
        {
          "text": "uye haarambi chakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.4",
            "verseOrgIds": [
              "PSA.36.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rudo rwenyu, imi Jehovha, runosvika kudenga denga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.5",
            "verseOrgIds": [
              "PSA.36.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:5"
      },
      "items": [
        {
          "text": "kutendeka kwenyu kunosvika kumakore.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.5",
            "verseOrgIds": [
              "PSA.36.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kururama kwenyu kwakaita segomo guru guru,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.6",
            "verseOrgIds": [
              "PSA.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:6"
      },
      "items": [
        {
          "text": "kururamisira kwenyu sepakadzika dzika.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.6",
            "verseOrgIds": [
              "PSA.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 36:6"
      },
      "items": [
        {
          "text": "Haiwa Jehovha, imi munochengetedza zvose munhu nemhuka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.6",
            "verseOrgIds": [
              "PSA.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa rudo rwenyu rusingatongoperi runokosha sei!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.7",
            "verseOrgIds": [
              "PSA.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 36:7"
      },
      "items": [
        {
          "text": "Vose vakuru navaduku pakati pavanhu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.7",
            "verseOrgIds": [
              "PSA.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:7"
      },
      "items": [
        {
          "text": "vanovanda mumumvuri wamapapiro enyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.7",
            "verseOrgIds": [
              "PSA.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanogutswa nezvakawanda zvomumba menyu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.8",
            "verseOrgIds": [
              "PSA.36.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:8"
      },
      "items": [
        {
          "text": "munovanwisa kubva parwizi rwenyu runofadza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.8",
            "verseOrgIds": [
              "PSA.36.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti kwamuri ndiko kune chitubu choupenyu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.9",
            "verseOrgIds": [
              "PSA.36.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:9"
      },
      "items": [
        {
          "text": "muchiedza chenyu tinoona chiedza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.9",
            "verseOrgIds": [
              "PSA.36.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rambai muchiitira rudo kuna avo vanokuzivai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.10",
            "verseOrgIds": [
              "PSA.36.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:10"
      },
      "items": [
        {
          "text": "uye kururama kwenyu kuna vane mwoyo yakarurama.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.10",
            "verseOrgIds": [
              "PSA.36.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rutsoka rwounozvikudza ngarurege kusvika kwandiri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.11",
            "verseOrgIds": [
              "PSA.36.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:11"
      },
      "items": [
        {
          "text": "kunyange ruoko rweakaipa ngarurege kundidzingira kure.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.11",
            "verseOrgIds": [
              "PSA.36.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tarirai vaiti vezvakaipa kuti vawa sei,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.12",
            "verseOrgIds": [
              "PSA.36.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:12"
      },
      "items": [
        {
          "text": "vakandwa pasi, havagoni kumuka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.12",
            "verseOrgIds": [
              "PSA.36.13"
            ]
          }
        }
      ]
    }
  ],
