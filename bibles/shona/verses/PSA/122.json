          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakafara pavakati kwandiri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.1",
            "verseOrgIds": [
              "PSA.122.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:1"
      },
      "items": [
        {
          "text": "\"Handei kumba yaJehovha.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.1",
            "verseOrgIds": [
              "PSA.122.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 122:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsoka dzedu dzimire",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.2",
            "verseOrgIds": [
              "PSA.122.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:2"
      },
      "items": [
        {
          "text": "mukati mamasuo ako, iwe Jerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.2",
            "verseOrgIds": [
              "PSA.122.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 122:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jerusarema rakavakwa seguta",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.3",
            "verseOrgIds": [
              "PSA.122.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:3"
      },
      "items": [
        {
          "text": "rakapakata kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.3",
            "verseOrgIds": [
              "PSA.122.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 122:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiko kunokwira marudzi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.4",
            "verseOrgIds": [
              "PSA.122.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:4"
      },
      "items": [
        {
          "text": "iwo marudzi aJehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.4",
            "verseOrgIds": [
              "PSA.122.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 122:4"
      },
      "items": [
        {
          "text": "kundorumbidza zita raJehovha",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.4",
            "verseOrgIds": [
              "PSA.122.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:4"
      },
      "items": [
        {
          "text": "maererano nezvakatemerwa Israeri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.4",
            "verseOrgIds": [
              "PSA.122.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 122:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvigaro zvokutonga zvimire ikoko,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.5",
            "verseOrgIds": [
              "PSA.122.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:5"
      },
      "items": [
        {
          "text": "zvigaro zvoushe zveimba yaDhavhidhi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.5",
            "verseOrgIds": [
              "PSA.122.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 122:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyengetererai rugare rweJerusarema:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.6",
            "verseOrgIds": [
              "PSA.122.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:6"
      },
      "items": [
        {
          "text": "\"Vanokuda dai vagara zvakanaka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.6",
            "verseOrgIds": [
              "PSA.122.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 122:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dai mukati mamasvingo ako maita rugare,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.7",
            "verseOrgIds": [
              "PSA.122.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:7"
      },
      "items": [
        {
          "text": "nokuchengetedzeka mukati menhare dzako.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.7",
            "verseOrgIds": [
              "PSA.122.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 122:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuda kwehama neshamwari dzangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.8",
            "verseOrgIds": [
              "PSA.122.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:8"
      },
      "items": [
        {
          "text": "ndichati, \"Rugare ngaruve mukati mako.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.8",
            "verseOrgIds": [
              "PSA.122.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 122:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuda kweimba yaJehovha Mwari wedu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.9",
            "verseOrgIds": [
              "PSA.122.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:9"
      },
      "items": [
        {
          "text": "ndichatsvaka kubudirira kwako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.9",
            "verseOrgIds": [
              "PSA.122.9"
            ]
          }
        }
      ]
    }
