    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Pisarema raDhavhidhi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha ndiye chiedza changu noruponeso rwangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.1",
            "verseOrgIds": [
              "PSA.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:1"
      },
      "items": [
        {
          "text": "ndichagotya aniko?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.1",
            "verseOrgIds": [
              "PSA.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 27:1"
      },
      "items": [
        {
          "text": "Jehovha ndiye nhare youpenyu hwangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.1",
            "verseOrgIds": [
              "PSA.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:1"
      },
      "items": [
        {
          "text": "ndianiko wandingatya?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.1",
            "verseOrgIds": [
              "PSA.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vakaipa pavakauya kwandiri",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.2",
            "verseOrgIds": [
              "PSA.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:2"
      },
      "items": [
        {
          "text": "kuzodya nyama yangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.2",
            "verseOrgIds": [
              "PSA.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 27:2"
      },
      "items": [
        {
          "text": "vavengi navadzivisi vangu pavanondirwisa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.2",
            "verseOrgIds": [
              "PSA.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:2"
      },
      "items": [
        {
          "text": "vanogumburwa ndokuwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.2",
            "verseOrgIds": [
              "PSA.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange hondo ikandikomba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.3",
            "verseOrgIds": [
              "PSA.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:3"
      },
      "items": [
        {
          "text": "mwoyo wangu haungazotyi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.3",
            "verseOrgIds": [
              "PSA.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 27:3"
      },
      "items": [
        {
          "text": "kunyange hondo ikamuka kuzondirwisa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.3",
            "verseOrgIds": [
              "PSA.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:3"
      },
      "items": [
        {
          "text": "ipapo ndichavimba naJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.3",
            "verseOrgIds": [
              "PSA.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinhu chimwe chete chandinokumbira kuna Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.4",
            "verseOrgIds": [
              "PSA.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:4"
      },
      "items": [
        {
          "text": "ndicho chandinotsvaka:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.4",
            "verseOrgIds": [
              "PSA.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 27:4"
      },
      "items": [
        {
          "text": "kuti ndigare mumba maJehovha",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.4",
            "verseOrgIds": [
              "PSA.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:4"
      },
      "items": [
        {
          "text": "mazuva ose oupenyu hwangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.4",
            "verseOrgIds": [
              "PSA.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 27:4"
      },
      "items": [
        {
          "text": "kuti nditarire kunaka kwaJehovha",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.4",
            "verseOrgIds": [
              "PSA.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:4"
      },
      "items": [
        {
          "text": "uye ndimutsvake mutemberi yake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.4",
            "verseOrgIds": [
              "PSA.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti zuva rokutambudzika",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.5",
            "verseOrgIds": [
              "PSA.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:5"
      },
      "items": [
        {
          "text": "achandichengeta zvakanaka munzvimbo yaanogara;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.5",
            "verseOrgIds": [
              "PSA.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 27:5"
      },
      "items": [
        {
          "text": "achandiviga mudumba retabhenakeri yake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.5",
            "verseOrgIds": [
              "PSA.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:5"
      },
      "items": [
        {
          "text": "agondikwidza pamusoro pedombo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.5",
            "verseOrgIds": [
              "PSA.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo musoro wangu uchasimudzirwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.6",
            "verseOrgIds": [
              "PSA.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:6"
      },
      "items": [
        {
          "text": "pamusoro pavavengi vakandipoteredza;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.6",
            "verseOrgIds": [
              "PSA.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 27:6"
      },
      "items": [
        {
          "text": "ndichamubayira zvibayiro patabhenakeri yake nomufaro mukuru;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.6",
            "verseOrgIds": [
              "PSA.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:6"
      },
      "items": [
        {
          "text": "ndichaimba ndigoimbira Jehovha nziyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.6",
            "verseOrgIds": [
              "PSA.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzwai inzwi rangu kana ndichidana, imi Jehovha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.7",
            "verseOrgIds": [
              "PSA.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:7"
      },
      "items": [
        {
          "text": "ndinzwirei ngoni mugondipindura.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.7",
            "verseOrgIds": [
              "PSA.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwoyo wangu unoti kwandiri, \"Tsvaka chiso chake!\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.8",
            "verseOrgIds": [
              "PSA.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:8"
      },
      "items": [
        {
          "text": "Chiso chenyu, Jehovha, ndichachitsvaka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.8",
            "verseOrgIds": [
              "PSA.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Regai kundivanzira chiso chenyu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.9",
            "verseOrgIds": [
              "PSA.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:9"
      },
      "items": [
        {
          "text": "musadzinga muranda wenyu mukutsamwa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.9",
            "verseOrgIds": [
              "PSA.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:9"
      },
      "items": [
        {
          "text": "makanga muri mubatsiri wangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.9",
            "verseOrgIds": [
              "PSA.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 27:9"
      },
      "items": [
        {
          "text": "Regai kundiramba kana kundisiya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.9",
            "verseOrgIds": [
              "PSA.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:9"
      },
      "items": [
        {
          "text": "imi Mwari Muponesi wangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.9",
            "verseOrgIds": [
              "PSA.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange baba vangu namai vangu vakandisiya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.10",
            "verseOrgIds": [
              "PSA.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:10"
      },
      "items": [
        {
          "text": "Jehovha achandigamuchira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.10",
            "verseOrgIds": [
              "PSA.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzidzisei nzira yenyu, imi Jehovha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.11",
            "verseOrgIds": [
              "PSA.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:11"
      },
      "items": [
        {
          "text": "ndisesedzei munzira yakarurama",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.11",
            "verseOrgIds": [
              "PSA.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:11"
      },
      "items": [
        {
          "text": "nokuda kwavamanikidzi vangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.11",
            "verseOrgIds": [
              "PSA.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
