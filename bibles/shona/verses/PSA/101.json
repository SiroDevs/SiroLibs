        "number": "101",
        "style": "c",
        "sid": "PSA 101"
      },
      "items": [
        {
          "text": "101",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 101",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Pisarema raDhavhidhi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 101:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichaimba nezvorudo rwenyu nokururamisira kwenyu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.1",
            "verseOrgIds": [
              "PSA.101.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:1"
      },
      "items": [
        {
          "text": "kwamuri, imi Jehovha, ndichaimba nziyo dzokurumbidza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.1",
            "verseOrgIds": [
              "PSA.101.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 101:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichangwarira kurarama upenyu husina chahungapomerwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.2",
            "verseOrgIds": [
              "PSA.101.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:2"
      },
      "items": [
        {
          "text": "Muchauya riniko kwandiri?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.2",
            "verseOrgIds": [
              "PSA.101.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 101:2"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 101:2"
      },
      "items": [
        {
          "text": "Ndichafamba mumba mangu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.2",
            "verseOrgIds": [
              "PSA.101.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:2"
      },
      "items": [
        {
          "text": "nomwoyo usina chaungapomerwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.2",
            "verseOrgIds": [
              "PSA.101.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 101:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Handingaisi chinhu chakaipa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.3",
            "verseOrgIds": [
              "PSA.101.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:3"
      },
      "items": [
        {
          "text": "pamberi pangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.3",
            "verseOrgIds": [
              "PSA.101.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 101:3"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 101:3"
      },
      "items": [
        {
          "text": "Ndinovenga mabasa avanhu vasingatendi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.3",
            "verseOrgIds": [
              "PSA.101.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:3"
      },
      "items": [
        {
          "text": "haanganamatiri kwandiri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.3",
            "verseOrgIds": [
              "PSA.101.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 101:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vane mwoyo yakatsauka vachava kure neni;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.4",
            "verseOrgIds": [
              "PSA.101.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:4"
      },
      "items": [
        {
          "text": "handichazovi nechokuita nechakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.4",
            "verseOrgIds": [
              "PSA.101.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 101:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani naani anoitira muvakidzani wake makuhwa pakavanda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.5",
            "verseOrgIds": [
              "PSA.101.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:5"
      },
      "items": [
        {
          "text": "iyeye ndiye wandichaita kuti anyarare;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.5",
            "verseOrgIds": [
              "PSA.101.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 101:5"
      },
      "items": [
        {
          "text": "ani naani ane meso anozvikudza nomwoyo unozvikudza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.5",
            "verseOrgIds": [
              "PSA.101.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:5"
      },
      "items": [
        {
          "text": "iyeye handingamuregi akadaro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.5",
            "verseOrgIds": [
              "PSA.101.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 101:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meso angu achava pamusoro pavakatendeka vari munyika,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.6",
            "verseOrgIds": [
              "PSA.101.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:6"
      },
      "items": [
        {
          "text": "kuti vagare neni;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.6",
            "verseOrgIds": [
              "PSA.101.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 101:6"
      },
      "items": [
        {
          "text": "iye ane mafambiro asina chaangapomerwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.6",
            "verseOrgIds": [
              "PSA.101.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:6"
      },
      "items": [
        {
          "text": "achandishumira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.6",
            "verseOrgIds": [
              "PSA.101.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 101:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuna munhu anonyengera",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.7",
            "verseOrgIds": [
              "PSA.101.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:7"
      },
      "items": [
        {
          "text": "achagara mumba mangu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.7",
            "verseOrgIds": [
              "PSA.101.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 101:7"
      },
      "items": [
        {
          "text": "hakuna munhu anotaura nhema",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.7",
            "verseOrgIds": [
              "PSA.101.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:7"
      },
      "items": [
        {
          "text": "achamira pamberi pangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.7",
            "verseOrgIds": [
              "PSA.101.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 101:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mangwanani oga oga ndichaita kuti",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.8",
            "verseOrgIds": [
              "PSA.101.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:8"
      },
      "items": [
        {
          "text": "vakaipa vose vari panyika vanyarare;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.8",
            "verseOrgIds": [
              "PSA.101.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 101:8"
      },
      "items": [
        {
          "text": "ndichauraya vaiti vezvakaipa vose,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.8",
            "verseOrgIds": [
              "PSA.101.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:8"
      },
      "items": [
        {
          "text": "vabve muguta raJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.8",
            "verseOrgIds": [
              "PSA.101.8"
            ]
          }
        }
      ]
    }
  ],
