      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 114:2"
      },
      "items": [
        {
          "text": "Israeri ushe hwake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.2",
            "verseOrgIds": [
              "PSA.114.2"
            ]
          }
        }
