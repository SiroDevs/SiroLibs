              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israeri akati abuda muIjipiti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.1",
            "verseOrgIds": [
              "PSA.114.1"
            ]
