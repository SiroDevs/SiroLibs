      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 114:1"
      },
      "items": [
        {
          "text": "imba yaJakobho ichibva kurudzi runo mutauro wokumwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.1",
            "verseOrgIds": [
              "PSA.114.1"
            ]
          }
