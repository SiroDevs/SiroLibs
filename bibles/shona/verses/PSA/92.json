          "text": "92",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 92",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Pisarema. Rwiyo rweSabata.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 92:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvakanaka kurumbidza Jehovha",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.1",
            "verseOrgIds": [
              "PSA.92.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:1"
      },
      "items": [
        {
          "text": "nokuimbira zita renyu nziyo, imi Wokumusoro-soro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.1",
            "verseOrgIds": [
              "PSA.92.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 92:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuparidza rudo rwenyu mangwanani",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.2",
            "verseOrgIds": [
              "PSA.92.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:2"
      },
      "items": [
        {
          "text": "nokutendeka kwenyu usiku,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.2",
            "verseOrgIds": [
              "PSA.92.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 92:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nechiridzwa chine hungiso",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.3",
            "verseOrgIds": [
              "PSA.92.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:3"
      },
      "items": [
        {
          "text": "gumi namaririro akanaka embira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.3",
            "verseOrgIds": [
              "PSA.92.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 92:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti munondifadza namabasa enyu, imi Jehovha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.4",
            "verseOrgIds": [
              "PSA.92.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:4"
      },
      "items": [
        {
          "text": "ndinoimba nomufaro nokuda kwamabasa amaoko enyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.4",
            "verseOrgIds": [
              "PSA.92.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 92:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Jehovha, mabasa enyu makuru seiko,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.5",
            "verseOrgIds": [
              "PSA.92.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:5"
      },
      "items": [
        {
          "text": "ndangariro dzenyu dzakadzika sei!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.5",
            "verseOrgIds": [
              "PSA.92.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 92:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munhu asina njere haazivi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.6",
            "verseOrgIds": [
              "PSA.92.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:6"
      },
      "items": [
        {
          "text": "mapenzi haanzwisisi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.6",
            "verseOrgIds": [
              "PSA.92.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 92:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti kunyange vakaipa vachimera souswa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.7",
            "verseOrgIds": [
              "PSA.92.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:7"
      },
      "items": [
        {
          "text": "uye vaiti vezvakaipa vose vachikura,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.7",
            "verseOrgIds": [
              "PSA.92.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 92:7"
      },
      "items": [
        {
          "text": "vachaparadzwa nokusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.7",
            "verseOrgIds": [
              "PSA.92.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 92:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi imi, iyemi Jehovha, munosimudzirwa nokusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.8",
            "verseOrgIds": [
              "PSA.92.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 92:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti zvirokwazvo vavengi venyu, imi Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.9",
            "verseOrgIds": [
              "PSA.92.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:9"
      },
      "items": [
        {
          "text": "zvirokwazvo vavengi venyu vachaparadzwa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.9",
            "verseOrgIds": [
              "PSA.92.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:9"
      },
      "items": [
        {
          "text": "vaiti vezvakaipa vose vachaparadzirwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.9",
            "verseOrgIds": [
              "PSA.92.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 92:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makasimudzira runyanga rwangu sorwenyati;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.10",
            "verseOrgIds": [
              "PSA.92.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:10"
      },
      "items": [
        {
          "text": "mafuta akaisvonaka akadururirwa pamusoro pangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.10",
            "verseOrgIds": [
              "PSA.92.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 92:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meso angu akaona kukundwa kwavadzivisi vangu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.11",
            "verseOrgIds": [
              "PSA.92.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:11"
      },
      "items": [
        {
          "text": "nzeve dzangu dzakanzwa kuparadzwa kwavavengi vangu vakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.11",
            "verseOrgIds": [
              "PSA.92.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 92:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakarurama vachakura kwazvo somuchindwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.12",
            "verseOrgIds": [
              "PSA.92.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:12"
      },
      "items": [
        {
          "text": "vachakura somusidhari weRebhanoni;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.12",
            "verseOrgIds": [
              "PSA.92.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 92:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakadyarwa muimba yaJehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.13",
            "verseOrgIds": [
              "PSA.92.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:13"
      },
      "items": [
        {
          "text": "vachakura kwazvo muvanze dzaMwari wedu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.13",
            "verseOrgIds": [
              "PSA.92.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 92:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vacharamba vachibereka zvibereko pakukwegura kwavo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.14",
            "verseOrgIds": [
              "PSA.92.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:14"
      },
      "items": [
        {
          "text": "vachagara vari vanyoro uye vari vatsva.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.14",
            "verseOrgIds": [
              "PSA.92.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 92:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vachaparidza kuti, \"Jehovha akarurama;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.15",
            "verseOrgIds": [
              "PSA.92.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:15"
      },
      "items": [
        {
          "text": "ndiye Dombo rangu, uye maari hamuna chakaipa.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.15",
            "verseOrgIds": [
              "PSA.92.16"
            ]
          }
        }
      ]
    }
  ],
