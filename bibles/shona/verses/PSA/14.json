      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kumutungamiri wokuimba. Pisarema raDhavhidhi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benzi rinoti mumwoyo maro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.1",
            "verseOrgIds": [
              "PSA.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:1"
      },
      "items": [
        {
          "text": "\"Hakuna Mwari.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.1",
            "verseOrgIds": [
              "PSA.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 14:1"
      },
      "items": [
        {
          "text": "Vakaora, mabasa avo akashata;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.1",
            "verseOrgIds": [
              "PSA.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:1"
      },
      "items": [
        {
          "text": "hakuna anoita zvakanaka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.1",
            "verseOrgIds": [
              "PSA.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha ari kudenga anotarira pasi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.2",
            "verseOrgIds": [
              "PSA.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:2"
      },
      "items": [
        {
          "text": "pamusoro pavanakomana vavanhu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.2",
            "verseOrgIds": [
              "PSA.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 14:2"
      },
      "items": [
        {
          "text": "kuti aone kana aripo anonzwisisa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.2",
            "verseOrgIds": [
              "PSA.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:2"
      },
      "items": [
        {
          "text": "naani zvake anotsvaka Mwari.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.2",
            "verseOrgIds": [
              "PSA.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vose vakatsauka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.3",
            "verseOrgIds": [
              "PSA.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:3"
      },
      "items": [
        {
          "text": "vose pamwe chete vakasvibiswa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.3",
            "verseOrgIds": [
              "PSA.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 14:3"
      },
      "items": [
        {
          "text": "hakuna anoita zvakanaka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.3",
            "verseOrgIds": [
              "PSA.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:3"
      },
      "items": [
        {
          "text": "kunyange nomumwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.3",
            "verseOrgIds": [
              "PSA.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, vaiti vezvakaipa havadzidziwo here,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.4",
            "verseOrgIds": [
              "PSA.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:4"
      },
      "items": [
        {
          "text": "ivo vanodya vanhu vangu savanhu vanodya chingwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.4",
            "verseOrgIds": [
              "PSA.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:4"
      },
      "items": [
        {
          "text": "uye vasingadani kuna Jehovha?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.4",
            "verseOrgIds": [
              "PSA.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pavari ipapo, vakazara nokutya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.5",
            "verseOrgIds": [
              "PSA.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:5"
      },
      "items": [
        {
          "text": "nokuti Mwari ari paungano yavakarurama.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.5",
            "verseOrgIds": [
              "PSA.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imi vaiti vezvakaipa, munokanganisa urongwa hwavarombo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.6",
            "verseOrgIds": [
              "PSA.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:6"
      },
      "items": [
        {
          "text": "asi Jehovha ndiye utiziro hwavo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.6",
            "verseOrgIds": [
              "PSA.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa, dai ruponeso rwaIsraeri rwaibuda muZioni!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.7",
            "verseOrgIds": [
              "PSA.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:7"
      },
      "items": [
        {
          "text": "Kana Jehovha achidzosazve nhaka yavanhu vake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.7",
            "verseOrgIds": [
              "PSA.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:7"
      },
      "items": [
        {
          "text": "Jakobho ngaapembere uye Israeri ngaafare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.7",
            "verseOrgIds": [
              "PSA.14.7"
            ]
          }
        }
      ]
    }
  ],
