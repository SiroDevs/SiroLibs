  "verseCount": 7,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "54",
        "style": "c",
        "sid": "PSA 54"
      },
      "items": [
        {
          "text": "54",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 54",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kumutungamiri wokuimba nemitengeranwa ine hungiso. Rwiyo rweMasikiri rwaDhavhidhi. VaZefati pavakaenda kuna Sauro kundoti, \"Ko, Dhavhidhi haana kuvanda pakati pedu here?\"",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 54:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiponesei, imi Mwari, nezita renyu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.1",
            "verseOrgIds": [
              "PSA.54.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:1"
      },
      "items": [
        {
          "text": "ndiruramisirei nesimba renyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.1",
            "verseOrgIds": [
              "PSA.54.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 54:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzwai munyengetero wangu, imi Mwari;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.2",
            "verseOrgIds": [
              "PSA.54.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:2"
      },
      "items": [
        {
          "text": "teererai kumashoko omuromo wangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.2",
            "verseOrgIds": [
              "PSA.54.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 54:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vatorwa vanondirwisa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.3",
            "verseOrgIds": [
              "PSA.54.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:3"
      },
      "items": [
        {
          "text": "vanhu vane utsinye vanotsvaka upenyu hwangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.3",
            "verseOrgIds": [
              "PSA.54.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:3"
      },
      "items": [
        {
          "text": "vanhu vasingazivi Mwari.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.3",
            "verseOrgIds": [
              "PSA.54.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sera",
              "type": "text",
              "attrs": {
                "verseId": "PSA.54.3",
                "verseOrgIds": [
                  "PSA.54.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 54:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvirokwazvo Mwari ndiye mubatsiri wangu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.4",
            "verseOrgIds": [
              "PSA.54.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:4"
      },
      "items": [
        {
          "text": "ishe ndiye anonditsigira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.4",
            "verseOrgIds": [
              "PSA.54.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 54:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvakaipa ngazvimonere pane avo vanondireva;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.5",
            "verseOrgIds": [
              "PSA.54.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:5"
      },
      "items": [
        {
          "text": "muvaparadze pakutendeka kwenyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.5",
            "verseOrgIds": [
              "PSA.54.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 54:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichakubayirai chipiriso chokungopa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.6",
            "verseOrgIds": [
              "PSA.54.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:6"
      },
      "items": [
        {
          "text": "ndicharumbidza zita renyu, imi Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.6",
            "verseOrgIds": [
              "PSA.54.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:6"
      },
      "items": [
        {
          "text": "nokuti rakanaka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.6",
            "verseOrgIds": [
              "PSA.54.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 54:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti akandirwira pamatambudziko angu ose,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.7",
            "verseOrgIds": [
              "PSA.54.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 54:7"
      },
      "items": [
        {
          "text": "uye mukukunda, meso angu akatarisa vavengi vangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.54.7",
            "verseOrgIds": [
              "PSA.54.9"
            ]
          }
        }
      ]
    }
  ],
