            "sid": "PSA 123:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinosimudzira meso angu kwamuri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.1",
            "verseOrgIds": [
              "PSA.123.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 123:1"
      },
      "items": [
        {
          "text": "kunemi mune chigaro choushe kudenga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.1",
            "verseOrgIds": [
              "PSA.123.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 123:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sokutarira kunoita meso evaranda kuna vatenzi vavo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.2",
            "verseOrgIds": [
              "PSA.123.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 123:2"
      },
      "items": [
        {
          "text": "sezvinoita meso omurandakadzi achitarira ruoko rwatenzikadzi wake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.2",
            "verseOrgIds": [
              "PSA.123.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 123:2"
      },
      "items": [
        {
          "text": "saizvozvo meso edu anotarira kuna Jehovha Mwari wedu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.2",
            "verseOrgIds": [
              "PSA.123.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 123:2"
      },
      "items": [
        {
          "text": "kusvikira atinzwira ngoni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.2",
            "verseOrgIds": [
              "PSA.123.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 123:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinzwirei ngoni, imi Jehovha, tinzwirei ngoni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.3",
            "verseOrgIds": [
              "PSA.123.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 123:3"
      },
      "items": [
        {
          "text": "nokuti takatsunga pakuzvidzwa kwakawanda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.3",
            "verseOrgIds": [
              "PSA.123.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 123:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Takatsunga zvikuru pakumhurwa kunobva kuna vanozvikudza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.4",
            "verseOrgIds": [
              "PSA.123.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 123:4"
      },
      "items": [
        {
          "text": "nokuzvidzwa kuzhinji kunobva kuna vanozvikudza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.4",
            "verseOrgIds": [
              "PSA.123.4"
            ]
          }
        }
      ]
