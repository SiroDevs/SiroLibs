          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vanakomana vedu pauduku",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.12",
            "verseOrgIds": [
              "PSA.144.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:12"
      },
      "items": [
        {
          "text": "hwavo vachava semiti yakakura zvakanaka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.12",
            "verseOrgIds": [
              "PSA.144.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 144:12"
      },
      "items": [
        {
          "text": "uye vanasikana vedu vachava sembiru dzakavezwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.12",
            "verseOrgIds": [
              "PSA.144.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:12"
      },
      "items": [
        {
          "text": "kuti dzishongedze muzinda wamambo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.12",
            "verseOrgIds": [
              "PSA.144.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 144:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matura edu achazadzwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.13",
            "verseOrgIds": [
              "PSA.144.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:13"
      },
      "items": [
        {
          "text": "nemhando dzose dzezviyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.13",
            "verseOrgIds": [
              "PSA.144.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 144:13"
      },
      "items": [
        {
          "text": "Makwai edu achawanda nezviuru,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.13",
            "verseOrgIds": [
              "PSA.144.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:13"
      },
      "items": [
        {
          "text": "nezviuru gumi mumafuro edu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.13",
            "verseOrgIds": [
              "PSA.144.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 144:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nzombe dzedu dzichatakura mitoro inorema.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.14",
            "verseOrgIds": [
              "PSA.144.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 144:14"
      },
      "items": [
        {
          "text": "Hapachazova nokuputswa kwamasvingo,",
          "type": "text",
