          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha, ndiani angagara munzvimbo yenyu tsvene?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.1",
            "verseOrgIds": [
              "PSA.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 15:1"
      },
      "items": [
        {
          "text": "Ndiani angagara pagomo renyu dzvene?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.1",
            "verseOrgIds": [
              "PSA.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
