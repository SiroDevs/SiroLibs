          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye asina makuhwa parurimi rwake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.15.3",
            "verseOrgIds": [
              "PSA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 15:3"
      },
      "items": [
