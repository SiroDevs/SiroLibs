  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "2TI 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2TI 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinokurayira pamberi paMwari naKristu Jesu, achatonga vapenyu navakafa uye pamusoro pokuonekwa kwake noushe hwake kuti:",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.1",
            "verseOrgIds": [
              "2TI.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TI 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paridza shoko; ugare wakagadzirira panguva yakafanira kunyange isakafanira; rayira, tsiura, uye ukurudzire nomwoyo murefu zvikuru uye nokudzidzisa zvakanaka.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.2",
            "verseOrgIds": [
              "2TI.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TI 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti nguva ichasvika vanhu pavacharamba kuteerera dzidziso yakarurama. Asi vachida zvinovafadza ivo, vachazviunganidzira vadzidzisi vazhinji kuti vadzidzise zvinodiwa nenzeve dzavo.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.3",
            "verseOrgIds": [
              "2TI.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TI 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vachafuratidza nzeve dzavo kuchokwadi uye vachatsaukira kungano.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.4",
            "verseOrgIds": [
              "2TI.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TI 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi iwe, usvinure pazvinhu zvose, tsungirira pamatambudziko, uite basa romuvhangeri, uite mabasa ose oushumiri hwako.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.5",
            "verseOrgIds": [
              "2TI.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TI 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti ini ndava kutodururwa sechipiriso chinonwiwa, uye nguva yangu yokuenda yasvika.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.6",
            "verseOrgIds": [
              "2TI.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TI 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndarwa kurwa kwakanaka, ndapedza nhangemutange yangu, ndachengeta kutenda kwangu.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.7",
            "verseOrgIds": [
              "2TI.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TI 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino ndakachengeterwa korona yangu yokururama, yandichapiwa, naIshe, mutongi akarurama pazuva iro, uye kwete ini ndoga, asiwo nokuna vose vanoshuva kuonekwa kwake.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.8",
            "verseOrgIds": [
              "2TI.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mashoko Okupedzisira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TI 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ita napaunogona napo pose kuti ukurumidze kuuya kwandiri,",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.9",
            "verseOrgIds": [
              "2TI.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TI 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti Dhemasi akada nyika yazvino, akandisiya akaenda kuTesaronika. Kiresenzi akaenda kuGaratia, uye Tito akaenda kuDharimatia.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.10",
            "verseOrgIds": [
              "2TI.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TI 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruka oga ndiye aneni. Tora Mako uuye naye, nokuti anondibatsira kwazvo paushumiri hwangu.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.11",
            "verseOrgIds": [
              "2TI.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TI 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakatuma Tikikasi kuEfeso.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.12",
            "verseOrgIds": [
              "2TI.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2TI 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paunouya, uuye nejasi randakasiya naKapasi paTiroasi, uye uuye nebhuku rangu, zvikuru magwaro amatehwe.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.13",
            "verseOrgIds": [
              "2TI.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2TI 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arekizanda, mupfuri wendarira, akandiitira zvakaipa zvizhinji. Ishe achamutsiva pane zvaakaita.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.14",
            "verseOrgIds": [
              "2TI.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TI 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Newewo umuchenjerere, nokuti akapikisa zvikuru mashoko edu.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.15",
            "verseOrgIds": [
              "2TI.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TI 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuzvidavirira kwangu kwokutanga, hapana munhu akandibatsira, asi vose vakandisiya. Ngavarege kupiwa mhosva nokuda kwaizvozvo.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.16",
            "verseOrgIds": [
              "2TI.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TI 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Ishe akamira neni uye akandipa simba, kuti kubudikidza neni shoko riparidzwe zvakakwana uye kuti veDzimwe Ndudzi vose varinzwe. Uye ndakarwirwa kubva pamuromo weshumba.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.17",
            "verseOrgIds": [
              "2TI.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2TI 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishe achandirwira kubva pakurwiswa kwose kwakaipa uye achandiuyisa murugare kuumambo hwake hwokudenga. Kubwinya ngakuve kwaari nokusingaperi-peri. Ameni.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.18",
            "verseOrgIds": [
              "2TI.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kwaziso Dzokupedzisira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2TI 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikwazisire Pirisira naAkwira neveimba yaOnesiferasi.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.19",
            "verseOrgIds": [
              "2TI.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2TI 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erastasi akasara kuKorinde, uye ndakasiya Tirofimasi paMiretasi achirwara.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.20",
            "verseOrgIds": [
              "2TI.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2TI 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ita napaunogona napo pose kuti uuye kuno chando chisati chasvika.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.21",
            "verseOrgIds": [
              "2TI.4.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "2TI 4:21"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2TI 4:21"
      },
      "items": [
        {
          "text": "Yubhurasi anokukwazisa, uyewo naPudhenzi, Rino, Kiraudhiyo nehama dzose.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.21",
            "verseOrgIds": [
              "2TI.4.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2TI 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishe ngaave nomweya wako. Nyasha ngadzive newe.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.22",
            "verseOrgIds": [
              "2TI.4.22"
            ]
          }
        }
      ]
    }
  ],
