  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "57",
        "style": "c",
        "sid": "ISA 57"
      },
      "items": [
        {
          "text": "57",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 57:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakarurama vanoparara,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.1",
            "verseOrgIds": [
              "ISA.57.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:1"
      },
      "items": [
        {
          "text": "uye hakuna anofunga izvi mumwoyo make;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.1",
            "verseOrgIds": [
              "ISA.57.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:1"
      },
      "items": [
        {
          "text": "vanhu vanoda Mwari vanobviswa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.1",
            "verseOrgIds": [
              "ISA.57.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:1"
      },
      "items": [
        {
          "text": "uye hakuna anonzwisisa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.1",
            "verseOrgIds": [
              "ISA.57.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:1"
      },
      "items": [
        {
          "text": "kuti vakarurama vanobviswa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.1",
            "verseOrgIds": [
              "ISA.57.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:1"
      },
      "items": [
        {
          "text": "kuti vanunurwe kubva pane zvakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.1",
            "verseOrgIds": [
              "ISA.57.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 57:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vose vanofamba mukururama",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.2",
            "verseOrgIds": [
              "ISA.57.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:2"
      },
      "items": [
        {
          "text": "vanopinda murugare,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.2",
            "verseOrgIds": [
              "ISA.57.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:2"
      },
      "items": [
        {
          "text": "vanowana zororo pavanovata murufu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.2",
            "verseOrgIds": [
              "ISA.57.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 57:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asi imi, uyai pano, imi vanakomana vomuroyi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.3",
            "verseOrgIds": [
              "ISA.57.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:3"
      },
      "items": [
        {
          "text": "imi chibereko chemhombwe nezvifeve!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.3",
            "verseOrgIds": [
              "ISA.57.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 57:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri kuseka aniko?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.4",
            "verseOrgIds": [
              "ISA.57.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:4"
      },
      "items": [
        {
          "text": "Ndiani wamunohomera",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.4",
            "verseOrgIds": [
              "ISA.57.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:4"
      },
      "items": [
        {
          "text": "uye wamunobudisira rurimi rwenyu?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.4",
            "verseOrgIds": [
              "ISA.57.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:4"
      },
      "items": [
        {
          "text": "Ko, hamusi chibereko chemhandu here,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.4",
            "verseOrgIds": [
              "ISA.57.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:4"
      },
      "items": [
        {
          "text": "nechizvarwa chavanoreva nhema?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.4",
            "verseOrgIds": [
              "ISA.57.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 57:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munotsva noruchiva pakati pemiti",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.5",
            "verseOrgIds": [
              "ISA.57.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:5"
      },
      "items": [
        {
          "text": "yemuouki napasi pomuti mumwe nomumwe wakapfumvutira;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.5",
            "verseOrgIds": [
              "ISA.57.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:5"
      },
      "items": [
        {
          "text": "munobayira vana venyu mumipata",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.5",
            "verseOrgIds": [
              "ISA.57.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:5"
      },
      "items": [
        {
          "text": "napasi pamapazi akarembera.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.5",
            "verseOrgIds": [
              "ISA.57.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 57:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvifananidzo zviri pakati pamatombo anotsvedzerera emipata ndiwo mugove wenyu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.6",
            "verseOrgIds": [
              "ISA.57.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:6"
      },
      "items": [
        {
          "text": "izvozvo, ndiwo mugove wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.6",
            "verseOrgIds": [
              "ISA.57.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:6"
      },
      "items": [
        {
          "text": "Hongu, wakadururira chipiriso chokunwa kwazviri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.6",
            "verseOrgIds": [
              "ISA.57.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:6"
      },
      "items": [
        {
          "text": "uye ukapa chipiriso chezviyo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.6",
            "verseOrgIds": [
              "ISA.57.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:6"
      },
      "items": [
        {
          "text": "Ko, ini muchagona kundiripira zvinhu izvi here?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.6",
            "verseOrgIds": [
              "ISA.57.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 57:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakawaridza nhoo pakakwirira napachikomo chirefu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.7",
            "verseOrgIds": [
              "ISA.57.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:7"
      },
      "items": [
        {
          "text": "ikoko wakakwira kundobayira zvibayiro.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.7",
            "verseOrgIds": [
              "ISA.57.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 57:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seri kwamakonhi ako nezvivivo zvako",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.8",
            "verseOrgIds": [
              "ISA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:8"
      },
      "items": [
        {
          "text": "wakaisa chirangaridzo chavamwari vako.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.8",
            "verseOrgIds": [
              "ISA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:8"
      },
      "items": [
        {
          "text": "Uchindisiya ini, wakafukura mubhedha wako,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.8",
            "verseOrgIds": [
              "ISA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:8"
      },
      "items": [
        {
          "text": "wakakwira pauri ukaushamisa kwazvo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.8",
            "verseOrgIds": [
              "ISA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:8"
      },
      "items": [
        {
          "text": "wakaita sungano naavo vane mibhedha yaunoda,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.8",
            "verseOrgIds": [
              "ISA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:8"
      },
      "items": [
        {
          "text": "uye wakatarisa kusasimira kwavo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.8",
            "verseOrgIds": [
              "ISA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 57:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakaenda kuna Moreki namafuta",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.9",
            "verseOrgIds": [
              "ISA.57.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:9"
      },
      "items": [
        {
          "text": "omuorivhi ukawedzera zvinonhuhwira zvako.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.9",
            "verseOrgIds": [
              "ISA.57.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:9"
      },
      "items": [
        {
          "text": "Wakatumira nhume dzako kure;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.9",
            "verseOrgIds": [
              "ISA.57.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:9"
      },
      "items": [
        {
          "text": "wakaburukira kuguva chaiko!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.9",
            "verseOrgIds": [
              "ISA.57.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 57:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakaneteswa nenzira dzako dzose,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.10",
            "verseOrgIds": [
              "ISA.57.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:10"
      },
      "items": [
        {
          "text": "asi hauna kumboti, 'Hazvina maturo.'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.10",
            "verseOrgIds": [
              "ISA.57.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:10"
      },
      "items": [
        {
          "text": "Wakawana kuvandudzwa kwesimba rako,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.10",
            "verseOrgIds": [
              "ISA.57.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:10"
      },
      "items": [
        {
          "text": "nokudaro hauna kuziya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.10",
            "verseOrgIds": [
              "ISA.57.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 57:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndianiko wawakatya uye ukavhunduka",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.11",
            "verseOrgIds": [
              "ISA.57.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:11"
      },
      "items": [
        {
          "text": "zvokuti wakazoreva nhema kwandiri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.11",
            "verseOrgIds": [
              "ISA.57.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:11"
      },
      "items": [
        {
          "text": "uye hauna kumbondirangarira",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.11",
