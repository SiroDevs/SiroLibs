  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "66",
        "style": "c",
        "sid": "ISA 66"
      },
      "items": [
        {
          "text": "66",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kutonga neTariro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 66:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvanzi naJehovha:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.1",
            "verseOrgIds": [
              "ISA.66.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:1"
      },
      "items": [
        {
          "text": "\"Denga ndicho chigaro changu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.1",
            "verseOrgIds": [
              "ISA.66.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:1"
      },
      "items": [
        {
          "text": "uye nyika chitsiko chetsoka dzangu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.1",
            "verseOrgIds": [
              "ISA.66.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:1"
      },
      "items": [
        {
          "text": "Ko, iripi imba yamungandivakira?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.1",
            "verseOrgIds": [
              "ISA.66.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:1"
      },
      "items": [
        {
          "text": "Nzvimbo yangu yokuzorora ichava kupiko?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.1",
            "verseOrgIds": [
              "ISA.66.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 66:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haruzi ruoko rwangu rwakaita izvozvi zvose here,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.2",
            "verseOrgIds": [
              "ISA.66.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:2"
      },
      "items": [
        {
          "text": "nokudaro zvikavapo?\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.2",
            "verseOrgIds": [
              "ISA.66.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "ISA 66:2"
      },
      "items": [
        {
          "text": "ndizvo zvinotaura Jehovha.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ISA 66:2"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:2"
      },
      "items": [
        {
          "text": "\"Munhu akadai ndiye wandichakudza:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.2",
            "verseOrgIds": [
              "ISA.66.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:2"
      },
      "items": [
        {
          "text": "iye anozvininipisa uye ane mweya wakapwanyika,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.2",
            "verseOrgIds": [
              "ISA.66.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:2"
      },
      "items": [
        {
          "text": "uye anodedera paanonzwa shoko rangu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.2",
            "verseOrgIds": [
              "ISA.66.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 66:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi ani naani anobayira hando",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.3",
            "verseOrgIds": [
              "ISA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:3"
      },
      "items": [
        {
          "text": "akafanana nouyo anouraya munhu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.3",
            "verseOrgIds": [
              "ISA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:3"
      },
      "items": [
        {
          "text": "uye anobayira gwayana,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.3",
            "verseOrgIds": [
              "ISA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:3"
      },
      "items": [
        {
          "text": "anofanana nouyo anovhuna mutsipa wembwa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.3",
            "verseOrgIds": [
              "ISA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:3"
      },
      "items": [
        {
          "text": "ani naani anoita chipiriso chezviyo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.3",
            "verseOrgIds": [
              "ISA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:3"
      },
      "items": [
        {
          "text": "anofanana nomunhu anopa ropa renguruve,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.3",
            "verseOrgIds": [
              "ISA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:3"
      },
      "items": [
        {
          "text": "uye ani naani anopisira zvinonhuhwira zvokurangaridza,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.3",
            "verseOrgIds": [
              "ISA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:3"
      },
      "items": [
        {
          "text": "anofanana nounonamata chifananidzo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.3",
            "verseOrgIds": [
              "ISA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:3"
      },
      "items": [
        {
          "text": "Vakasarudza nzira dzavo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.3",
            "verseOrgIds": [
              "ISA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:3"
      },
      "items": [
        {
          "text": "uye mweya yavo inofarira zvinonyangadza zvavo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.3",
            "verseOrgIds": [
              "ISA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 66:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "naizvozvo neniwo ndichavasarudzira kuranga kuchavaomera,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.4",
            "verseOrgIds": [
              "ISA.66.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:4"
      },
      "items": [
        {
          "text": "uye ndichauyisa pamusoro pavo izvo zvavanotya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.4",
            "verseOrgIds": [
              "ISA.66.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:4"
      },
      "items": [
        {
          "text": "Nokuti pandakadana, hapana akapindura,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.4",
            "verseOrgIds": [
              "ISA.66.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:4"
      },
      "items": [
        {
          "text": "pandakataura, hapana akateerera.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.4",
            "verseOrgIds": [
              "ISA.66.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:4"
      },
      "items": [
        {
          "text": "Vakaita zvakaipa pamberi pangu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.4",
            "verseOrgIds": [
              "ISA.66.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:4"
      },
      "items": [
        {
          "text": "vakasarudza zvisingandifadzi.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.4",
            "verseOrgIds": [
              "ISA.66.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 66:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzwai shoko raJehovha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.5",
            "verseOrgIds": [
              "ISA.66.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:5"
      },
      "items": [
        {
          "text": "imi munodedera pamunonzwa shoko rake:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.5",
            "verseOrgIds": [
              "ISA.66.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:5"
      },
      "items": [
        {
          "text": "\"Hama dzenyu dzinokuvengai,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.5",
            "verseOrgIds": [
              "ISA.66.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:5"
      },
      "items": [
        {
          "text": "uye dzinokutsaurai nokuda kwezita rangu, dzakati,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.5",
            "verseOrgIds": [
              "ISA.66.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:5"
      },
      "items": [
        {
          "text": "'Jehovha ngaaratidze kukudzwa kwake,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.5",
            "verseOrgIds": [
              "ISA.66.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:5"
      },
      "items": [
        {
          "text": "kuti tione mufaro wenyu!'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.5",
            "verseOrgIds": [
              "ISA.66.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:5"
      },
      "items": [
        {
          "text": "Asi ivo vachanyadziswa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.5",
            "verseOrgIds": [
              "ISA.66.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 66:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzwai maungira ebope anobva muguta,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.6",
            "verseOrgIds": [
              "ISA.66.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:6"
      },
      "items": [
        {
          "text": "inzwai mheremhere inobva mutemberi!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.6",
            "verseOrgIds": [
              "ISA.66.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:6"
      },
      "items": [
        {
          "text": "Ndiwo maungira aJehovha",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.6",
            "verseOrgIds": [
              "ISA.66.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:6"
      },
      "items": [
        {
          "text": "achiripira vavengi vake zvose zvakavakodzera.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.6",
            "verseOrgIds": [
              "ISA.66.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 66:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asati arwadziwa nemimba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.7",
            "verseOrgIds": [
              "ISA.66.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:7"
      },
      "items": [
        {
          "text": "anosununguka;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.7",
            "verseOrgIds": [
              "ISA.66.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:7"
      },
      "items": [
        {
          "text": "kurwadza kusati kwauya pamusoro pake,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.7",
            "verseOrgIds": [
              "ISA.66.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:7"
      },
      "items": [
        {
          "text": "anosununguka mwanakomana.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.7",
            "verseOrgIds": [
              "ISA.66.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 66:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiani akambonzwa chinhu chakadai?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.8",
            "verseOrgIds": [
              "ISA.66.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:8"
      },
      "items": [
        {
          "text": "Ndiani akamboona zvinhu zvakadai?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.8",
            "verseOrgIds": [
              "ISA.66.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:8"
      },
      "items": [
        {
          "text": "Ko, nyika ingazvarwa pazuva rimwe here",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.8",
            "verseOrgIds": [
              "ISA.66.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:8"
      },
      "items": [
        {
          "text": "kana rudzi rungazvarwa pakarepo here?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.8",
            "verseOrgIds": [
              "ISA.66.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:8"
      },
      "items": [
        {
          "text": "Kunyange zvakadaro, Zioni rakangoti kurwadziwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.8",
            "verseOrgIds": [
              "ISA.66.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:8"
      },
      "items": [
        {
          "text": "pakarepo ndokubereka vana varo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.8",
            "verseOrgIds": [
              "ISA.66.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 66:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndingasvitsa panguva yokubereka",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.9",
            "verseOrgIds": [
              "ISA.66.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:9"
      },
      "items": [
        {
          "text": "ndikasaberekesa here?\" ndizvo zvinotaura Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.9",
            "verseOrgIds": [
              "ISA.66.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:9"
      },
      "items": [
        {
          "text": "\"Ko, ndinozarira chizvaro",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.9",
            "verseOrgIds": [
              "ISA.66.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:9"
      },
      "items": [
        {
          "text": "pandinoberekesa here?\" ndizvo zvinotaura Mwari wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.9",
            "verseOrgIds": [
              "ISA.66.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 66:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pemberai pamwe chete neJerusarema uye mufarisise nokuda kwaro,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.10",
            "verseOrgIds": [
              "ISA.66.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:10"
      },
      "items": [
        {
          "text": "imi mose munorida;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.10",
            "verseOrgIds": [
              "ISA.66.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:10"
      },
      "items": [
        {
          "text": "farisisai pamwe chete naro,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.10",
            "verseOrgIds": [
              "ISA.66.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:10"
      },
      "items": [
        {
          "text": "imi mose munochema pamusoro paro.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.10",
            "verseOrgIds": [
              "ISA.66.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 66:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti muchanwa mukaguta",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.11",
            "verseOrgIds": [
              "ISA.66.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:11"
      },
      "items": [
        {
          "text": "pamazamu ake anonyaradza;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.11",
            "verseOrgIds": [
              "ISA.66.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:11"
      },
      "items": [
        {
          "text": "muchanwa zvikuru kwazvo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.11",
            "verseOrgIds": [
              "ISA.66.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:11"
      },
      "items": [
        {
          "text": "uye muchafadzwa nezvakawanda zvake zvinopfachukira.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.11",
            "verseOrgIds": [
              "ISA.66.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 66:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti zvanzi naJehovha:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.12",
            "verseOrgIds": [
              "ISA.66.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:12"
      },
      "items": [
        {
          "text": "\"Ndichawedzera rugare kwaari sorwizi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.12",
            "verseOrgIds": [
              "ISA.66.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:12"
      },
      "items": [
        {
          "text": "uye upfumi hwendudzi sokudira kworukova;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.12",
            "verseOrgIds": [
              "ISA.66.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:12"
      },
      "items": [
        {
          "text": "muchayamwa uye muchatakurwa paruoko rwake,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.12",
            "verseOrgIds": [
              "ISA.66.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:12"
      },
      "items": [
        {
          "text": "uye muchavaraidzwa pamabvi ake.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.12",
            "verseOrgIds": [
              "ISA.66.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 66:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samai vanonyaradza mwana wavo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.13",
            "verseOrgIds": [
              "ISA.66.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:13"
      },
      "items": [
        {
          "text": "saizvozvo ndichakunyaradzai;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.13",
            "verseOrgIds": [
              "ISA.66.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:13"
      },
      "items": [
        {
          "text": "uye muchanyaradzwa pamusoro peJerusarema.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.13",
            "verseOrgIds": [
              "ISA.66.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 66:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamuchaona izvozvo, mwoyo wenyu uchafara,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.14",
            "verseOrgIds": [
              "ISA.66.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:14"
      },
      "items": [
        {
          "text": "uye muchaita bumhudza sebundo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.14",
            "verseOrgIds": [
              "ISA.66.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:14"
      },
      "items": [
        {
          "text": "ruoko rwaJehovha rucharatidzwa kuvaranda vake,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.14",
            "verseOrgIds": [
              "ISA.66.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:14"
      },
      "items": [
        {
          "text": "asi hasha dzake dzicharatidzwa kuvavengi vake.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.14",
            "verseOrgIds": [
              "ISA.66.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 66:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tarirai, Jehovha ari kuuya nomoto,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.15",
            "verseOrgIds": [
              "ISA.66.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:15"
      },
      "items": [
        {
          "text": "uye ngoro dzake dzakaita sechamupupuri;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.15",
            "verseOrgIds": [
              "ISA.66.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 66:15"
      },
      "items": [
        {
          "text": "achaburutsa kutsamwa kwake nehasha huru,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.15",
            "verseOrgIds": [
              "ISA.66.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:15"
      },
      "items": [
        {
          "text": "uye kutuka kwake nomurazvo womoto.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.15",
            "verseOrgIds": [
              "ISA.66.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 66:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti nomoto uye nomunondo wake",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.16",
            "verseOrgIds": [
              "ISA.66.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:16"
      },
      "items": [
        {
          "text": "Jehovha achatonga vanhu vose,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.16",
            "verseOrgIds": [
              "ISA.66.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 66:16"
      },
      "items": [
        {
          "text": "uye vazhinji vachava vaya vanourayiwa naJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.16",
            "verseOrgIds": [
              "ISA.66.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 66:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Vaya vanozvinatsa nokuzvichenesa kuti vaende mumapindu, vachitevera munhu ari pakati paavo vanodya nyama yenguruve nembeva uye nezvimwe zvinhu zvinonyangadza, magumo avo achava mamwe chete,\" ndizvo zvinotaura Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.17",
            "verseOrgIds": [
              "ISA.66.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 66:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nokuti ini nokuda kwamabasa avo nepfungwa dzavo, ndiri kuuya kuzounganidza marudzi ose nendimi dzose; vachauya uye vachaona kubwinya kwangu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.18",
            "verseOrgIds": [
              "ISA.66.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 66:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndichaisa chiratidzo pakati pavo, uye ndichatumira vamwe vavakapunyuka kundudzi, kuTashishi, nokuvaRibhiya navaRidhia (vane mbiri yokuwembura uta), nokuTubhari nokuGirisi, nokuzviwi zviri kure zvisina kumbonzwa nezvembiri yangu kana kuona kubwinya kwangu. Vachaparidza kubwinya kwangu pakati pendudzi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.19",
            "verseOrgIds": [
              "ISA.66.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 66:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye vachauyisa hama dzenyu dzose, kubva kundudzi dzose, kugomo rangu dzvene muJerusarema, sechipo kuna Jehovha, pamusoro pamabhiza, nomungoro uye mungoro dzina matenga, napamanyurusi uye napangamera,\" ndizvo zvinotaura Jehovha. \"Vachazviuyisa, savaIsraeri vanouyisa zvipiriso zvavo zvezviyo, kutemberi yaJehovha mumidziyo yakacheneswa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.20",
            "verseOrgIds": [
              "ISA.66.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 66:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ndichasarudza vamwe vavo kuti vave vaprista navaRevhi,\" ndizvo zvinotaura Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.21",
            "verseOrgIds": [
              "ISA.66.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 66:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nokuti sezvakaita matenga matsva nenyika itsva zvandinoita zvichazogara pamberi pangu,\" ndizvo zvinotaura Jehovha, \"saizvozvo zita renyu nezvizvarwa zvenyu zvichagara.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.22",
            "verseOrgIds": [
              "ISA.66.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 66:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
