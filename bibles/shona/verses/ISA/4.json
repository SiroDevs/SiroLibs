            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva iro vakadzi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 4:1"
      },
      "items": [
        {
          "text": "vanomwe vachabata murume mumwe vagoti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 4:1"
      },
      "items": [
        {
          "text": "\"Tichadya zvokudya zvedu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 4:1"
      },
      "items": [
        {
          "text": "uye tichazvitsvakira zvokufuka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 4:1"
      },
      "items": [
        {
          "text": "Tinongoda kudanwa nezita rako bedzi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 4:1"
      },
      "items": [
        {
          "text": "Bvisa kunyadziswa kwedu!\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Davi raJehovha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva iro, davi raJehovha richava rakanaka uye richabwinya, uye zvibereko zvenyika zvichava chidadiso nokukudzwa kwavakapunyuka muIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.2",
            "verseOrgIds": [
              "ISA.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaya vakasara muZioni, navakasara muJerusarema, vachanzi vatsvene, navose vakanyorwa pakati pavapenyu muJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.3",
            "verseOrgIds": [
              "ISA.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha achashambidza tsvina yevakadzi veZioni; achanatsa makwapa eropa kubva muJerusarema nomweya wokutonga uye nomweya womoto.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.4",
            "verseOrgIds": [
              "ISA.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha achasika pamusoro pegomo rose reZioni napamusoro pavose vanoungana ikoko gore routsi masikati nezhenje romoto unopfuta usiku; pamusoro pokubwinya kwose pachava nechidzitiro.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.5",
            "verseOrgIds": [
              "ISA.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chichava chifukidzo nomumvuri kubva pakupisa kwezuva, noutiziro, nenzvimbo yokuvanda kubva padutu nemvura inonaya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.6",
            "verseOrgIds": [
              "ISA.4.6"
            ]
          }
        }
      ]
    }
  ],
