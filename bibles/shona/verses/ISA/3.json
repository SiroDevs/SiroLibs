          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masuo eZioni achachema uye achaungudza;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.26",
            "verseOrgIds": [
              "ISA.3.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:26"
      },
      "items": [
        {
          "text": "nokutambura kwaro, richagara pasi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.26",
            "verseOrgIds": [
              "ISA.3.26"
            ]
          }
        }
      ]
