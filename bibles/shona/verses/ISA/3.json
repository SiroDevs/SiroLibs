          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pachinzvimbo chezvinonhuhwira, pachava nokunhuhwa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.24",
            "verseOrgIds": [
              "ISA.3.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:24"
      },
      "items": [
        {
          "text": "pachinzvimbo chesikavha, pachava netambo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.24",
            "verseOrgIds": [
              "ISA.3.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:24"
      },
      "items": [
        {
          "text": "pachinzvimbo chebvudzi rakashongedzwa zvakanaka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.24",
            "verseOrgIds": [
              "ISA.3.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:24"
      },
      "items": [
        {
          "text": "pachava nemhanza; pachinzvimbo chembatya dzakaisvonaka, pachava nechipfeko chesaga;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.24",
            "verseOrgIds": [
              "ISA.3.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:24"
      },
      "items": [
        {
          "text": "pachinzvimbo chorunako, pachava nokupiswa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.24",
            "verseOrgIds": [
              "ISA.3.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume venyu vachafa nomunondo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.25",
            "verseOrgIds": [
              "ISA.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:25"
      },
      "items": [
        {
          "text": "varwi venyu vachafa muhondo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.25",
            "verseOrgIds": [
              "ISA.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
