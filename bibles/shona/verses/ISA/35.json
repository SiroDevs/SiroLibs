    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mufaro waVakadzikinurwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwenga nenyika yakaoma zvichafara;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.1",
            "verseOrgIds": [
              "ISA.35.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:1"
      },
      "items": [
        {
          "text": "sango richafara kwazvo uye richatumbuka;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.1",
            "verseOrgIds": [
              "ISA.35.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:1"
      },
      "items": [
        {
          "text": "seruva,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.1",
            "verseOrgIds": [
              "ISA.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "richatumbuka;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.2",
            "verseOrgIds": [
              "ISA.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:2"
      },
      "items": [
        {
          "text": "richafara zvikuru uye richapembera nomufaro.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.2",
            "verseOrgIds": [
              "ISA.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:2"
      },
      "items": [
        {
          "text": "Mbiri yeRebhanoni ichapiwa kwariri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.2",
            "verseOrgIds": [
              "ISA.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:2"
      },
      "items": [
        {
          "text": "kunaka kweKarimeri neSharoni;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.2",
            "verseOrgIds": [
              "ISA.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:2"
      },
      "items": [
        {
          "text": "vachaona kubwinya kwaJehovha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.2",
            "verseOrgIds": [
              "ISA.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:2"
      },
      "items": [
        {
          "text": "nokunaka kwaMwari wedu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.2",
            "verseOrgIds": [
              "ISA.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simbisai maoko asina simba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.3",
            "verseOrgIds": [
              "ISA.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:3"
      },
      "items": [
        {
          "text": "tsigirai mabvi anodedera;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.3",
            "verseOrgIds": [
              "ISA.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "muti kuna avo vane mwoyo inotya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.4",
            "verseOrgIds": [
              "ISA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:4"
      },
      "items": [
        {
          "text": "\"Simbai, musatya;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.4",
            "verseOrgIds": [
              "ISA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:4"
      },
      "items": [
        {
          "text": "Mwari wenyu achauya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.4",
            "verseOrgIds": [
              "ISA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:4"
      },
      "items": [
        {
          "text": "achauya nokutsiva,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.4",
            "verseOrgIds": [
              "ISA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:4"
      },
      "items": [
        {
          "text": "nokuripira kutsvene",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.4",
            "verseOrgIds": [
              "ISA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:4"
      },
      "items": [
        {
          "text": "achauya kuzokuponesai.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.4",
            "verseOrgIds": [
              "ISA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo meso amapofu achasvinudzwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.5",
            "verseOrgIds": [
              "ISA.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:5"
      },
      "items": [
        {
          "text": "uye nzeve dzematsi dzichazarurwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.5",
            "verseOrgIds": [
              "ISA.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akaremara achakwakuka senondo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.6",
            "verseOrgIds": [
              "ISA.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:6"
      },
      "items": [
        {
          "text": "uye rurimi rwechimumu ruchaimba nomufaro.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.6",
            "verseOrgIds": [
              "ISA.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:6"
      },
      "items": [
        {
          "text": "Mvura ichatubuka murenje,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.6",
            "verseOrgIds": [
              "ISA.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:6"
      },
      "items": [
        {
          "text": "uye nehova dzemvura mugwenga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.6",
            "verseOrgIds": [
              "ISA.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jecha rinopisa richashanduka rikava dziva,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.7",
            "verseOrgIds": [
              "ISA.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:7"
      },
      "items": [
        {
          "text": "ivhu rine nyota richava zvitubu zvemvura.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.7",
            "verseOrgIds": [
              "ISA.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:7"
      },
      "items": [
        {
          "text": "Maigara makava noumo maaimbovata,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.7",
            "verseOrgIds": [
              "ISA.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:7"
      },
      "items": [
        {
          "text": "muchamera uswa, netsanga nenhokwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.7",
            "verseOrgIds": [
              "ISA.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
