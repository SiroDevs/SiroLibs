              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panopera makore makumi manomwe, Jehovha achashanyira Tire. Richadzokerazve kubasa raro sechifeve rigofeva noushe hwose huri pamusoro penyika.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.17",
            "verseOrgIds": [
              "ISA.23.17"
            ]
