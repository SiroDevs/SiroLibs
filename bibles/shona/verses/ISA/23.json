          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tora rudimbwa, ufambe nomuguta,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.16",
            "verseOrgIds": [
              "ISA.23.16"
