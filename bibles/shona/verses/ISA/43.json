      "attrs": {
        "style": "q2",
        "vid": "ISA 43:14"
      },
      "items": [
        {
          "text": "uye ndichaburitsa vaBhabhironi vose vachitiza,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.14",
            "verseOrgIds": [
              "ISA.43.14"
            ]
          }
        }
      ]
