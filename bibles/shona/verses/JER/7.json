          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mitumbi yavanhu ava ichava zvokudya zveshiri dzedenga nemhuka dzenyika, uye hapazovi nomunhu angazvivhundutsira kuti zvibve.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.33",
