    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Shoko kuna Bharuki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 45:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi ndizvo zvakataurwa nomuprofita Jeremia kuna Bharuki mwanakomana waNeria, mugore rechina raJehoyakimi mwanakomana waJosia mambo weJudha, shure kwokunyora kwaBharuki rugwaro rwamashoko aJeremia aakanga achimudaidzira, achiti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.1",
            "verseOrgIds": [
              "JER.45.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 45:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvanzi naJehovha, Mwari waIsraeri, kunewe Bharuki:",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.2",
            "verseOrgIds": [
              "JER.45.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe wakati, 'Ndine nhamo! Jehovha apamhidzira kusuwa pakurwadziwa kwangu; ndaneta nokugomera uye ndashayiwa zororo.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.3",
            "verseOrgIds": [
              "JER.45.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 45:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati, \"Uti kwaari, 'Zvanzi naJehovha: Ndichakoromora zvandakavaka uye ndichadzura zvandakasima panyika yose.",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.4",
            "verseOrgIds": [
              "JER.45.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 45:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe ungazvitsvakira zvinhu zvikuru here? Usazvitsvaka. Nokuti ndichauyisa njodzi pamusoro pavanhu vose, ndizvo zvinotaura Jehovha, asi ndichaita kuti utize noupenyu hwako kwose kwaunoenda.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.5",
            "verseOrgIds": [
              "JER.45.5"
            ]
          }
        }
      ]
    }
  ],
