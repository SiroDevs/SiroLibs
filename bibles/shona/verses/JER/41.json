  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "41",
        "style": "c",
        "sid": "JER 41"
      },
      "items": [
        {
          "text": "41",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwedzi wechinomwe, Ishumaeri mwanakomana waNetania, mwanakomana waErishama, uyo akanga ari worudzi rwamambo, uye akanga ari mumwe wamachinda amambo, akauya ane varume gumi kuna Gedharia mwanakomana waAhikami, paMizipa. Vachiri kudya pamwe chete ipapo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.1",
            "verseOrgIds": [
              "JER.41.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishumaeri mwanakomana waNetania navarume gumi vakanga vanaye vakasimuka vakabaya Gedharia mwanakomana waAhikami, mwanakomana waShafani, nomunondo, vakamuuraya iye akanga agadzwa namambo weBhabhironi kuti ave mubati wenyika iyo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.2",
            "verseOrgIds": [
              "JER.41.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishumaeri akaurayawo vaJudha vose vaiva naGedharia paMizipa, pamwe chete navarwi veBhabhironi vaivapo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.3",
            "verseOrgIds": [
              "JER.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zuva rakatevera kuurayiwa kwaGedharia, pasati pava nomunhu aizviziva,",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.4",
            "verseOrgIds": [
              "JER.41.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "varume makumi masere vaibva kuShekemu, neShiro neSamaria vakasvikapo vakaveura ndebvu dzavo, vakabvarura nguo dzavo uye vakazvicheka-cheka, vachiuya nezvipiriso zvezviyo nezvinonhuhwira kuimba yaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.5",
            "verseOrgIds": [
              "JER.41.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishumaeri mwanakomana waNetania akabuda paMizipa kuti andovachingamidza, akafamba achichema. Paakasangana navo, akati kwavari, \"Uyai kuna Gedharia mwanakomana waAhikami.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.6",
            "verseOrgIds": [
              "JER.41.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vapinda muguta, Ishumaeri mwanakomana waNetania navarume vakanga vanaye vakavauraya ndokuvakanda mugomba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.7",
            "verseOrgIds": [
              "JER.41.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vamwe vavo gumi vakati kuna Ishumaeri, \"Musatiuraya! Isu tine gorosi nebhari, namafuta uye nouchi, zvakavigwa musango.\" Naizvozvo akavarega akasavauraya pamwe chete navamwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.8",
            "verseOrgIds": [
              "JER.41.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino gomba raakakandira mitumbi yose yavarume vaakanga auraya pamwe chete naGedharia ndiro rakanga racherwa naMambo Asa kuti azvidzivirire kubva kuna Bhaasha mambo weIsraeri. Ishumaeri mwanakomana waNetania akarizadza navakaurayiwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.9",
            "verseOrgIds": [
              "JER.41.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishumaeri akatapa vanhu vose vakanga vari paMizipa, vanasikana vamambo pamwe chete navamwe vose vakanga vasara ikoko, vaiswa naNebhuzaradhani mukuru wavarindi pasi paGedharia mwanakomana waAhikami. Ishumaeri mwanakomana waNetania akavatapa ndokubvapo achida kuti ayambukire kuvaAmoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.10",
            "verseOrgIds": [
              "JER.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Johanani mwanakomana waKarea namachinda ose ehondo vaiva naye vakati vanzwa pamusoro pemhaka dzose dzakanga dzaparwa naIshumaeri mwanakomana waNetania,",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.11",
            "verseOrgIds": [
              "JER.41.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "vakatora varume vose ndokuenda kundorwa naIshumaeri mwanakomana waNetania. Vakanomubatira pedyo nedziva guru reGibheoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.12",
            "verseOrgIds": [
              "JER.41.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vose vaiva naIshumaeri vakati vachiona Johanani mwanakomana waKarea navakuru vehondo vakanga vainaye, vakafara.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.13",
            "verseOrgIds": [
              "JER.41.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vose vakanga vatapwa naIshumaeri paMizipa vakadzoka vakaenda kuna Johanani mwanakomana waKarea.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.14",
            "verseOrgIds": [
              "JER.41.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Ishumaeri mwanakomana waNetania navarume vasere vakapunyuka kubva kuna Johanani vakatizira kuvaAmoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.15",
            "verseOrgIds": [
              "JER.41.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kutizira kuIjipiti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Johanani mwanakomana waKarea navakuru vose vehondo vaiva naye vakatungamirira vose vakasara kubva paMizipa avo vaakanga anunura kubva kuna Ishumaeri mwanakomana waNetania shure kwokunge auraya Gedharia mwanakomana waAhikami, vaiti: varwi, vakadzi, vana namachinda edare vaakanga abva navo kuGibheoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.16",
            "verseOrgIds": [
              "JER.41.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaenderera mberi ndokunomira vava paGeruti Kimihami pedyo neBheterehema parwendo rwavo rwokuenda kuIjipiti",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.17",
            "verseOrgIds": [
              "JER.41.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 41:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti vatize vaBhabhironi. Vakanga vachitya nokuti Ishumaeri mwanakomana waNetania akanga auraya Gedharia mwanakomana waAhikami, uyo akanga agadzwa kuti ave mubati wenyika iyo namambo weBhabhironi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.18",
            "verseOrgIds": [
              "JER.41.18"
            ]
          }
        }
      ]
    }
  ],
