      "attrs": {
        "style": "q2",
        "vid": "JER 3:25"
      },
      "items": [
        {
          "text": "uye kunyara kwedu ngakutifukidze.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.25",
            "verseOrgIds": [
              "JER.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:25"
      },
      "items": [
        {
          "text": "Takatadzira Jehovha Mwari wedu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.25",
            "verseOrgIds": [
              "JER.3.25"
            ]
          }
        }
      ]
    },
