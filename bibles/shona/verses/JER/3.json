          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngativatei pasi munyadzi dzedu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.25",
            "verseOrgIds": [
              "JER.3.25"
            ]
          }
