{
  "id": "JER.3",
  "number": "3",
  "bookId": "JER",
  "reference": "Jeremia 3",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "JER 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana murume akaramba mukadzi wake,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:1"
      },
      "items": [
        {
          "text": "iye akamusiya hake akandowanikwa nomumwe murume,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:1"
      },
      "items": [
        {
          "text": "murume uyu angadzokerazve kwaari here?",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:1"
      },
      "items": [
        {
          "text": "Ko, nyika haingasvibiswi here?",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:1"
      },
      "items": [
        {
          "text": "Asi iwe wakararama sechifeve navadiwa vazhinji,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:1"
      },
      "items": [
        {
          "text": "zvino ungadzokera kwandiri here?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "JER 3:1"
      },
      "items": [
        {
          "text": "ndizvo zvinotaura Jehovha.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tarira kunzvimbo dzakakwirira dzisina miti uone.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.2",
            "verseOrgIds": [
              "JER.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:2"
      },
      "items": [
        {
          "text": "Iripo here nzvimbo yausina kumboitira ufeve?",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.2",
            "verseOrgIds": [
              "JER.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:2"
      },
      "items": [
        {
          "text": "Mujinga menzira wakagaramo wakamirira zvikomba,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.2",
            "verseOrgIds": [
              "JER.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:2"
      },
      "items": [
        {
          "text": "wakagara kunge vanhu vouragu vari murenje.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.2",
            "verseOrgIds": [
              "JER.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:2"
      },
      "items": [
        {
          "text": "Wakasvibisa nyika noufeve hwako",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.2",
            "verseOrgIds": [
              "JER.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:2"
      },
      "items": [
        {
          "text": "uye nezvakaipa zvako.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.2",
            "verseOrgIds": [
              "JER.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo wakanyimwa mvura inopfunha,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.3",
            "verseOrgIds": [
              "JER.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:3"
      },
      "items": [
        {
          "text": "uye nemvura yomuchirimo haina kunaya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.3",
            "verseOrgIds": [
              "JER.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, handiti uchangobva pakundidana here uchiti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.4",
            "verseOrgIds": [
              "JER.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:4"
      },
      "items": [
        {
          "text": "'Baba vangu, shamwari yangu kubva pauduku hwangu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.4",
            "verseOrgIds": [
              "JER.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "muchagara makatsamwa here?",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.5",
            "verseOrgIds": [
              "JER.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:5"
      },
      "items": [
        {
          "text": "Kutsamwa kwenyu kucharamba kuripo nokusingaperi here?'",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.5",
            "verseOrgIds": [
              "JER.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:5"
      },
      "items": [
        {
          "text": "Aya ndiwo matauriro ako,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.5",
            "verseOrgIds": [
              "JER.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:5"
      },
      "items": [
        {
          "text": "asi unoita zvakaipa zvose zvaunogona kuita.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.5",
            "verseOrgIds": [
              "JER.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Israeri woKusatendeka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva yokutonga kwaMambo Josia, Jehovha akati kwandiri, \"Waona here zvaitwa naIsraeri wokusatendeka? Ari kuenda pamusoro pezvikomo zvose zvakakwirira nepasi pemiti yose yakapfumvutira achindoita ufevepo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.6",
            "verseOrgIds": [
              "JER.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakafunga kuti mushure mokuita kwake izvi zvose, achadzokera kwandiri asi iye haana, uye mununʼuna wake Judha wokusatendeka akazviona.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.7",
            "verseOrgIds": [
              "JER.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakapa Israeri wokusatendeka tsamba yokurambana ndikamudzinga nokuda kwoufeve hwake. Kunyange zvakadaro ndakaona kuti Judha mununʼuna wake wokusatenda haatyi; naiyewo akabuda akandoita ufeve.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.8",
            "verseOrgIds": [
              "JER.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti ufeve hwaIsraeri hahuna zvahwakareva kwaari, akasvibisa nyika nokufeva namabwe namatanda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.9",
            "verseOrgIds": [
              "JER.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange izvi zvakadaro, mununʼuna wake Judha wokusatendeka haana kudzokera kwandiri nomwoyo wake wose, asi kunyengera chete,\" ndizvo zvinotaura Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.10",
            "verseOrgIds": [
              "JER.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kwandiri, \"Israeri wokusatenda akarurama kukunda Judha wokusatendeka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.11",
            "verseOrgIds": [
              "JER.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enda undoparidza shoko iri kurutivi rwokumusoro uchiti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:12"
      },
      "items": [
        {
          "text": "\" 'Dzokai imi Israeri vokusatenda,' ndizvo zvinotaura Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:12"
      },
      "items": [
        {
          "text": "'Handichazorambi ndakafinyamisa chiso changu kwamuri,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:12"
      },
      "items": [
        {
          "text": "nokuti ndizere nengoni,' ndizvo zvinotaura Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:12"
      },
      "items": [
        {
          "text": "'handingarambi ndakatsamwa nokusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imi zivai mhosva yenyu chete,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.13",
            "verseOrgIds": [
              "JER.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:13"
      },
      "items": [
        {
          "text": "kuti makamukira Jehovha Mwari wenyu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.13",
            "verseOrgIds": [
              "JER.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:13"
      },
      "items": [
        {
          "text": "mukafadza vamwari",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.13",
            "verseOrgIds": [
              "JER.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:13"
      },
      "items": [
        {
          "text": "vavatorwa muri pasi pomuti mumwe nomumwe wakapfumvutira,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.13",
            "verseOrgIds": [
              "JER.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:13"
      },
      "items": [
        {
          "text": "uye hamuna kunditeerera,' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.13",
            "verseOrgIds": [
              "JER.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "JER 3:13"
      },
      "items": [
        {
          "text": "ndizvo zvinotaura Jehovha.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Dzokai, imi vanhu vokusatenda,\" ndizvo zvinotaura Jehovha, \"nokuti ndini murume wenyu. Ndichakusarudzai, ndichatora mumwe chete kubva kune rimwe guta, uye vaviri kubva kuno rumwe rudzi, ndigokuuyisai kuZioni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.14",
            "verseOrgIds": [
              "JER.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ndichakupai vafudzi vanofadza mwoyo wangu, ivo vachakutungamirirai noruzivo nokunzwisisa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.15",
            "verseOrgIds": [
              "JER.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumazuva iwayo, pamunenge mawanda zvikuru munyika,\" ndizvo zvinotaura Jehovha, \"vanhu havangazoti, 'Areka yesungano yaJehovha.' Hazvingazopindi mundangariro dzavo kana kurangarirwa; havazoishuvi, havangagadziri imwezve.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.16",
            "verseOrgIds": [
              "JER.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyoyo vachatumidza Jerusarema kuti Chigaro choUshe chaJehovha, uye ndudzi dzose dzichaungana muJerusarema kuzokudza zita raJehovha. Havachazoteverizve kusindimara kwemwoyo yavo yakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.17",
            "verseOrgIds": [
              "JER.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumazuva iwayo imba yaJudha ichabatana neimba yaIsraeri, uye vose pamwe chete vachauya vachibva kunyika yokumusoro vachienda kunyika yandakapa madzibaba enyu kuti ive nhaka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.18",
            "verseOrgIds": [
              "JER.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ini pachangu ndakati,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.19",
            "verseOrgIds": [
              "JER.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:19"
      },
      "items": [
        {
          "text": "\" 'Ndichafara sei pakukubatai savanakomana vangu",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.19",
            "verseOrgIds": [
              "JER.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:19"
      },
      "items": [
        {
          "text": "uye ndichikupai nyika inoyevedza,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.19",
            "verseOrgIds": [
              "JER.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:19"
      },
      "items": [
        {
          "text": "iyo nhaka yakaisvonaka yorudzi rupi zvarwo.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.19",
            "verseOrgIds": [
              "JER.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:19"
      },
      "items": [
        {
          "text": "Ndakafunga kuti muchanditi 'Baba'",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.19",
            "verseOrgIds": [
              "JER.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:19"
      },
      "items": [
        {
          "text": "mukasazotsauka pakunditevera.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.19",
            "verseOrgIds": [
              "JER.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi sezvinoita mukadzi asina kutendeka kumurume wake,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.20",
            "verseOrgIds": [
              "JER.3.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:20"
      },
      "items": [
        {
          "text": "saizvozvo makanga musina kutendeka kwandiri, imi imba yaIsraeri,\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.20",
            "verseOrgIds": [
              "JER.3.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "JER 3:20"
      },
      "items": [
        {
          "text": "ndizvo zvinotaura Jehovha.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchema kunonzwika panzvimbo dzakakwirira dzisina miti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.21",
            "verseOrgIds": [
              "JER.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:21"
      },
      "items": [
        {
          "text": "iko kuchema nokuteterera kwavanhu veIsraeri,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.21",
            "verseOrgIds": [
              "JER.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:21"
      },
      "items": [
        {
          "text": "nokuti vakaminamisa nzira dzavo",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.21",
            "verseOrgIds": [
              "JER.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:21"
      },
      "items": [
        {
          "text": "uye vakakanganwa Jehovha Mwari wavo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.21",
            "verseOrgIds": [
              "JER.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Dzokai, imi vanhu vokusatenda;",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.22",
            "verseOrgIds": [
              "JER.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:22"
      },
      "items": [
        {
          "text": "ndichakurapai pakudzokera kwenyu shure.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.22",
            "verseOrgIds": [
              "JER.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "JER 3:22"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:22"
      },
      "items": [
        {
          "text": "\"Hongu, tichauya kwamuri,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.22",
            "verseOrgIds": [
              "JER.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:22"
      },
      "items": [
        {
          "text": "nokuti imi muri Jehovha Mwari wedu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.22",
            "verseOrgIds": [
              "JER.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvirokwazvo mheremhere youfeve iri pazvikomo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.23",
            "verseOrgIds": [
              "JER.3.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:23"
      },
      "items": [
        {
          "text": "napamakomo unyengeri;",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.23",
            "verseOrgIds": [
              "JER.3.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:23"
      },
      "items": [
        {
          "text": "zvirokwazvo muna Jehovha Mwari wedu",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.23",
            "verseOrgIds": [
              "JER.3.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:23"
      },
      "items": [
        {
          "text": "ndimo mune ruponeso rwaIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.23",
            "verseOrgIds": [
              "JER.3.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubva pauduku hwedu nyadzi dzakadya",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.24",
            "verseOrgIds": [
              "JER.3.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:24"
      },
      "items": [
        {
          "text": "zvibereko zvamabasa amadzibaba edu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.24",
            "verseOrgIds": [
              "JER.3.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:24"
      },
      "items": [
        {
          "text": "makwai avo, nemombe dzavo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.24",
            "verseOrgIds": [
              "JER.3.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:24"
      },
      "items": [
        {
          "text": "vanakomana navanasikana vavo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.24",
            "verseOrgIds": [
              "JER.3.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
