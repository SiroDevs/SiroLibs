      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:25"
      },
      "items": [
        {
          "text": "isu tose namadzibaba edu;",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.25",
            "verseOrgIds": [
              "JER.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:25"
      },
      "items": [
        {
          "text": "kubva pauduku hwedu kusvikira nhasi",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.25",
            "verseOrgIds": [
              "JER.3.25"
            ]
          }
        }
