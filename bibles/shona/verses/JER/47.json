  "verseCount": 7,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "47",
        "style": "c",
        "sid": "JER 47"
      },
      "items": [
        {
          "text": "47",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chirevo pamusoro pavaFiristia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 47:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iri ndiro shoko raJehovha rakasvika kumuprofita Jeremia pamusoro pavaFiristia, Faro asati arwisa Gaza:",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.1",
            "verseOrgIds": [
              "JER.47.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvanzi naJehovha:",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.2",
            "verseOrgIds": [
              "JER.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 47:2"
      },
      "items": [
        {
          "text": "\"Onai kukwira kunoita mvura zhinji yokumusoro;",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.2",
            "verseOrgIds": [
              "JER.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:2"
      },
      "items": [
        {
          "text": "ivo vachava rwizi runofashukira nesimba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.2",
            "verseOrgIds": [
              "JER.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 47:2"
      },
      "items": [
        {
          "text": "Vachafukidza nyika nezvose zviri mairi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.2",
            "verseOrgIds": [
              "JER.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:2"
      },
      "items": [
        {
          "text": "maguta navose vanogaramo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.2",
            "verseOrgIds": [
              "JER.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 47:2"
      },
      "items": [
        {
          "text": "Vanhu vachachema;",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.2",
            "verseOrgIds": [
              "JER.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:2"
      },
      "items": [
        {
          "text": "vose vanogara munyika vachaungudza",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.2",
            "verseOrgIds": [
              "JER.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 47:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "pavachanzwa mutsindo wemahwanda emabhiza,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.3",
            "verseOrgIds": [
              "JER.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:3"
      },
      "items": [
        {
          "text": "kutinhira kwengoro dzavavengi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.3",
            "verseOrgIds": [
              "JER.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:3"
      },
      "items": [
        {
          "text": "nokurira kwemavhiri adzo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.3",
            "verseOrgIds": [
              "JER.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 47:3"
      },
      "items": [
        {
          "text": "Madzibaba haangadzoki kuzobatsira vana vavo;",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.3",
            "verseOrgIds": [
              "JER.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:3"
      },
      "items": [
        {
          "text": "maoko avo acharembera seakaremara.",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.3",
            "verseOrgIds": [
              "JER.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 47:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti zuva rasvika",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.4",
            "verseOrgIds": [
              "JER.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:4"
      },
      "items": [
        {
          "text": "rokuparadza vaFiristia vose,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.4",
            "verseOrgIds": [
              "JER.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 47:4"
      },
      "items": [
        {
          "text": "uye nokuuraya vose vakasara",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.4",
            "verseOrgIds": [
              "JER.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:4"
      },
      "items": [
        {
          "text": "vaigona kubatsira Tire neSidhoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.4",
            "verseOrgIds": [
              "JER.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 47:4"
      },
      "items": [
        {
          "text": "Jehovha ava pedyo nokuparadza vaFiristia,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.4",
            "verseOrgIds": [
              "JER.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:4"
      },
      "items": [
        {
          "text": "vaya vakasara vanobva kumahombekombe eKafitori.",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.4",
            "verseOrgIds": [
              "JER.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaza richaveura musoro waro mukuchema;",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.5",
            "verseOrgIds": [
              "JER.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:5"
      },
      "items": [
        {
          "text": "Ashikeroni richati mwiro.",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.5",
            "verseOrgIds": [
              "JER.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 47:5"
      },
      "items": [
        {
          "text": "Haiwa, imi vakasara vari pabani,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.5",
            "verseOrgIds": [
              "JER.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:5"
      },
      "items": [
        {
          "text": "muchapedza nguva yakadiiko muchizvicheka?",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.5",
            "verseOrgIds": [
              "JER.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Muchachema muchiti, 'Maiwe, munondo waJehovha,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.6",
            "verseOrgIds": [
              "JER.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:6"
      },
      "items": [
        {
          "text": "uchapedza nguva yakadiiko usati wazorora?",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.6",
            "verseOrgIds": [
              "JER.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 47:6"
      },
      "items": [
        {
          "text": "Dzokera mumuhara wako;",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.6",
            "verseOrgIds": [
              "JER.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:6"
      },
      "items": [
        {
          "text": "mira, unyarare.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.6",
            "verseOrgIds": [
              "JER.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 47:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi ungazorora sei,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.7",
            "verseOrgIds": [
              "JER.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:7"
      },
      "items": [
        {
          "text": "Jehovha akaurayira,",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.7",
            "verseOrgIds": [
              "JER.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 47:7"
      },
      "items": [
        {
          "text": "sezvo akaurayira",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.7",
            "verseOrgIds": [
              "JER.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 47:7"
      },
      "items": [
        {
          "text": "kuti urwise Ashikeroni namahombekombe?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.7",
            "verseOrgIds": [
              "JER.47.7"
            ]
          }
        }
      ]
    }
  ],
