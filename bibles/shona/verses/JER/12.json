  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "JER 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kugununʼuna kwaJeremia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imi munogara makarurama, iyemi Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.1",
            "verseOrgIds": [
              "JER.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:1"
      },
      "items": [
        {
          "text": "pandinouya pamberi penyu nemhaka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.1",
            "verseOrgIds": [
              "JER.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:1"
      },
      "items": [
        {
          "text": "Kunyange zvakadaro ndichataura nemi pamusoro pokururamisira kwenyu, ndichiti:",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.1",
            "verseOrgIds": [
              "JER.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:1"
      },
      "items": [
        {
          "text": "Nemhaka yeiko nzira yavakaipa ichibudirira?",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.1",
            "verseOrgIds": [
              "JER.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:1"
      },
      "items": [
        {
          "text": "Nemhaka yei vasingatendi vachirarama zvakanaka?",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.1",
            "verseOrgIds": [
              "JER.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makavasima, uye vava nemidzi;",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.2",
            "verseOrgIds": [
              "JER.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:2"
      },
      "items": [
        {
          "text": "vanokura uye vanobereka muchero.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.2",
            "verseOrgIds": [
              "JER.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:2"
      },
      "items": [
        {
          "text": "Imi munogara muri pamiromo yavo",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.2",
            "verseOrgIds": [
              "JER.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:2"
      },
      "items": [
        {
          "text": "asi muri kure nemwoyo yavo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.2",
            "verseOrgIds": [
              "JER.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi munondiziva, imi Jehovha;",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.3",
            "verseOrgIds": [
              "JER.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:3"
      },
      "items": [
        {
          "text": "munondiona uye munoedza ndangariro dzangu pamusoro penyu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.3",
            "verseOrgIds": [
              "JER.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:3"
      },
      "items": [
        {
          "text": "Vakwekweredzei samakwai anondobayiwa!",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.3",
            "verseOrgIds": [
              "JER.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:3"
      },
      "items": [
        {
          "text": "Muvagadzirire zuva rokubayiwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.3",
            "verseOrgIds": [
              "JER.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyika ichasvika riniko yakangooma,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.4",
            "verseOrgIds": [
              "JER.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:4"
      },
      "items": [
        {
          "text": "nebundo resango rakangosvava?",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.4",
            "verseOrgIds": [
              "JER.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:4"
      },
      "items": [
        {
          "text": "Nokuti vose vanogaramo vakaipa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.4",
            "verseOrgIds": [
              "JER.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:4"
      },
      "items": [
        {
          "text": "mhuka neshiri zvaparara.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.4",
            "verseOrgIds": [
              "JER.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:4"
      },
      "items": [
        {
          "text": "Pamusoro paizvozvo, vanhu vanoti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.4",
            "verseOrgIds": [
              "JER.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:4"
      },
      "items": [
        {
          "text": "\"Haasi kuzoona zvinoitika kwatiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.4",
            "verseOrgIds": [
              "JER.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mhinduro yaMwari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana wakaita nhangemutange navanhu netsoka,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.5",
            "verseOrgIds": [
              "JER.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:5"
      },
      "items": [
        {
          "text": "uye vakakunetesa",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.5",
            "verseOrgIds": [
              "JER.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:5"
      },
      "items": [
        {
          "text": "ungagokwikwidzana sei namabhiza?",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.5",
            "verseOrgIds": [
              "JER.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:5"
      },
      "items": [
        {
          "text": "Kana uchigumburwa panyika yakanaka,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.5",
            "verseOrgIds": [
              "JER.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:5"
      },
      "items": [
        {
          "text": "ungagara seiko mumatenhere eJorodhani?",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.5",
            "verseOrgIds": [
              "JER.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hama dzako, mhuri yako chaiyo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.6",
            "verseOrgIds": [
              "JER.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:6"
      },
      "items": [
        {
          "text": "kunyange naivowo vakakumukira;",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.6",
            "verseOrgIds": [
              "JER.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:6"
      },
      "items": [
        {
          "text": "vakadanidzira zvikuru kwazvo pamusoro pako.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.6",
            "verseOrgIds": [
              "JER.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:6"
      },
      "items": [
        {
          "text": "Usavimba navo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.6",
            "verseOrgIds": [
              "JER.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:6"
      },
      "items": [
        {
          "text": "kunyange vachitaura zvakanaka pamusoro pako.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.6",
            "verseOrgIds": [
              "JER.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndichasiya imba yangu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.7",
            "verseOrgIds": [
              "JER.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:7"
      },
      "items": [
        {
          "text": "ndigorasa nhaka yangu;",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.7",
            "verseOrgIds": [
              "JER.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:7"
      },
      "items": [
        {
          "text": "ndichapa mudikani wangu",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.7",
            "verseOrgIds": [
              "JER.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:7"
      },
      "items": [
        {
          "text": "mumaoko avavengi vake.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.7",
            "verseOrgIds": [
              "JER.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nhaka yangu yava kwandiri",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.8",
            "verseOrgIds": [
              "JER.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:8"
      },
      "items": [
        {
          "text": "seshumba iri musango.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.8",
            "verseOrgIds": [
              "JER.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:8"
      },
      "items": [
        {
          "text": "Anoomba pamberi pangu;",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.8",
            "verseOrgIds": [
              "JER.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:8"
      },
      "items": [
        {
          "text": "naizvozvo ndinomuvenga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.8",
            "verseOrgIds": [
              "JER.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, nhaka yangu haizova kwandiri segondo rina mavara here,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.9",
            "verseOrgIds": [
              "JER.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:9"
      },
      "items": [
        {
          "text": "iro rinokombwa",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.9",
            "verseOrgIds": [
              "JER.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:9"
      },
      "items": [
        {
          "text": "uye rinorwiswa namamwe makondo?",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.9",
            "verseOrgIds": [
              "JER.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:9"
      },
      "items": [
        {
          "text": "Endai munounganidza zvikara zvose;",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.9",
            "verseOrgIds": [
              "JER.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:9"
      },
      "items": [
        {
          "text": "muuye nazvo zvidye.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.9",
            "verseOrgIds": [
              "JER.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vafudzi vazhinji vachaparadza munda",
          "type": "text",
