            "verseOrgIds": [
              "JER.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:13"
      },
      "items": [
        {
          "text": "Saka zvitakurirei kunyadziswa kwegohwo renyu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.13",
            "verseOrgIds": [
              "JER.12.13"
            ]
          }
        }
