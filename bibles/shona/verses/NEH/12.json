            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "wokwaHirikia, aiva Hashabhia;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.21",
            "verseOrgIds": [
              "NEH.12.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NEH 12:21"
      },
      "items": [
        {
          "text": "wokwaJedhaya, aiva Netaneri.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.21",
            "verseOrgIds": [
              "NEH.12.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakuru vedzimba dzavaRevhi mumazuva aEriashibhi, Joyadha, Johanani naJadhua, pamwe chete neavo vaiva vevaprista, vakanyorwa mazita avo pamazuva okutonga kwaDhariasi muPezhia.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.22",
            "verseOrgIds": [
              "NEH.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakuru vedzimba pakati pezvizvarwa zvaRevhi kusvikira panguva yaJohanani mwanakomana waEriashibhi vakanyorwa mumabhuku enhoroondo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.23",
            "verseOrgIds": [
              "NEH.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino vatungamiri vavaRevhi vaiva Hashabhia, Sherebhia naJeshua, mwanakomana waKadhimieri, nehama dzavo avo vaimira vakatarisana vachipa rumbidzo nokuvonga, uye vachiita madzoro sezvazvakanga zvarayirwa naDhavhidhi munhu waMwari.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.24",
            "verseOrgIds": [
              "NEH.12.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matania Bhakibhukia, Dhadhia, Meshurami, Taramani, naAkubhi vakanga vari varindi vemikova namatura.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.25",
            "verseOrgIds": [
              "NEH.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakashumira pamazuva aJehoyakimi mwanakomana waJeshua, mwanakomana waJozadhaki, nomumazuva aNehemia mubati naEzira muprista nomunyori.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.26",
            "verseOrgIds": [
              "NEH.12.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kukumikidzwa kwoRusvingo rweJerusarema",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino pakukumikidzwa kworusvingo rweJerusarema, vaRevhi vakatsvakwa kwavaigara vakauyiswa kuJerusarema kuzopemberera kukumikidzwa uku nomufaro, nenziyo dzokuvonga, uye nokuimba, vachiridza makandira, mitengeranwa nembira.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.27",
            "verseOrgIds": [
              "NEH.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaimbi vakaunganidzwa pamwe chete kubva kumatunhu akapoteredza Jerusarema, nokumisha yavaNetofati;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.28",
            "verseOrgIds": [
              "NEH.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuBheti Girigari uye kubva munzvimbo yeGebha neAzimavheti, nokuti vaimbi vakanga vazvivakira misha vakapoteredza Jerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.29",
            "verseOrgIds": [
              "NEH.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino vaprista navaRevhi vakati vazvinatsa, vakanatsawo vanhu, mikova norusvingo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.30",
            "verseOrgIds": [
              "NEH.12.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ndakakwidza vatungamiri vavaJudha pamusoro porusvingo. Ndakarayirawo mapoka makuru maviri avaimbi kuti vavonge vachifamba mumudungwe. Rimwe boka rakafamba pamusoro porusvingo kurudyi, rakananga kuMukova weNdove.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.31",
            "verseOrgIds": [
              "NEH.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hoshaya nehafu yavatungamiri vaJudha vakavatevera,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.32",
            "verseOrgIds": [
              "NEH.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamwe chete naAzaria, Ezira, Mesharami,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.33",
            "verseOrgIds": [
              "NEH.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NEH 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Judha, Bhenjamini, Shemaya, naJeremia,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.34",
            "verseOrgIds": [
              "NEH.12.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NEH 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamwe chete navamwe vaprista vaiva nehwamanda, uyewo naZekaria mwanakomana waJonatani, mwanakomana waShemaya, mwanakomana waMatania, mwanakomana waMikaya, mwanakomana waZakuri, mwanakomana waAsafi,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.35",
            "verseOrgIds": [
              "NEH.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NEH 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "nehama dzake vanaShemaya, Azareri, Mirarai, Girarai, Maai, Nataneri, Judha naHanani nemidziyo yokuimbisa yakarayirwa naDhavhidhi munhu waMwari. Ezira munyori akavatungamirira ari pamberi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.36",
            "verseOrgIds": [
              "NEH.12.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NEH 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakafamba napaSuo reTsime vakarurama kumatanho eGuta raDhavhidhi napamukwidza wokurusvingo uye vakapfuura napamusoro peimba yaDhavhidhi vakananga kuSuo reMvura kumabvazuva.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.37",
            "verseOrgIds": [
              "NEH.12.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NEH 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rimwe boka ravaivonga rakaenda kuruboshwe. Ini ndakavatevera pamwe chete nehafu yavanhu ndiri pamusoro porusvingo, ndikapfuura napashongwe yechoto kusvikira kurusvingo rwakapamhama,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.38",
            "verseOrgIds": [
              "NEH.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NEH 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "napamusoro peSuo raEfuremu, Suo reKare, Suo reHove, Shongwe yaHananeri napaShongwe yeZana, kusvikira paSuo raMakwai. Vakamira paSuo raVarindi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.39",
            "verseOrgIds": [
              "NEH.12.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NEH 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo mapoka maviri avavongi akamira muimba yaMwari, neni ndikaita saizvozvo, pamwe chete nehafu yavabati,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.40",
            "verseOrgIds": [
              "NEH.12.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NEH 12:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "navapristawo, vanaEriakimi, Maaseya, Miniamini, Mikaya, Erioenai, Zekaria naHanania, nehwamanda dzavo,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.41",
            "verseOrgIds": [
              "NEH.12.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NEH 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "uyewo Maaseya, Shemaya, Ereazari, Uzi Jehonani, Marikiya, Eramu naEzeri. Vaimbi vakaimba vachitungamirirwa naJezirahia.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.42",
            "verseOrgIds": [
              "NEH.12.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NEH 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva iro vakabayira zvibayiro zvikuru, vachifara nokuti Mwari akanga avapa mufaro mukuru. Vakadzi navana vakafarawo. Maungira omufaro waiva muJerusarema akanzwika kure kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.43",
            "verseOrgIds": [
              "NEH.12.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "NEH 12:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyoyo varume vakagadzwa kuva vatariri vamatura okuvigira zvaiunganidzwa, uye zvibereko zvokutanga nezvegumi. Vaifanira kuuya nezvaibva muminda yakapoteredza maguta kumatura okuvigira migove yakatarirwa vaprista navaRevhi nomurayiro, nokuti Judha yakafadzwa navaprista navaRevhi vaishumira.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.44",
            "verseOrgIds": [
              "NEH.12.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NEH 12:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaita shumiro yaMwari wavo neshumiro yokunatswa, pamwe chete navaimbi navachengeti vamasuo, sezvazvakanga zvarayirwa naDhavhidhi nomwanakomana wake Soromoni.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.45",
            "verseOrgIds": [
              "NEH.12.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NEH 12:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti kare kare, mumazuva aDhavhidhi naAsafi, kwaiva navatungamiri vavaimbi nezvenziyo dzokurumbidza nokuvonga Mwari.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.46",
            "verseOrgIds": [
              "NEH.12.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NEH 12:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka mumazuva aZerubhabheri naNehemia, vaIsraeri vose vaipa migove yezuva nezuva kuvaimbi navachengeti vamasuo. Vakatsaurawo mugove wavamwe vaRevhi, uye vaRevhi vaitsaurawo mugove wezvizvarwa zvaAroni.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.47",
            "verseOrgIds": [
              "NEH.12.47"
            ]
          }
        }
      ]
    }
  ],
