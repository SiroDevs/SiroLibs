    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vaprista navaRevhi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino ava ndivo vaprista navaRevhi vakadzokera naZerubhabheri, mwanakomana waShearitieri naJeshua:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "NEH 12:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NEH 12:1"
      },
      "items": [
        {
          "text": "Seraya, Jeremia, naEzira,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.1",
            "verseOrgIds": [
              "NEH.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaria, Maruki, Hatushi,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.2",
            "verseOrgIds": [
              "NEH.12.2"
            ]
          }
        }
      ]
    },
    {
