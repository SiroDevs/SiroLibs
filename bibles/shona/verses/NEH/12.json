            "number": "3",
            "style": "v",
            "sid": "NEH 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shekania, Rehumi, Meremoti,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.3",
            "verseOrgIds": [
              "NEH.12.3"
            ]
          }
        }
      ]
    },
    {
