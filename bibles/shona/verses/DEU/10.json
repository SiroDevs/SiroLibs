  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "DEU 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mahwendefa akafanana neokutanga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyoyo Jehovha akati kwandiri, \"Veza mahwendefa maviri amabwe akaita saaya okutanga ugouya kwandiri pagomo. Ugadzirewo zvakare areka yomuti.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.1",
            "verseOrgIds": [
              "DEU.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichanyora pamahwendefa mashoko akanga ari pamahwendefa okutanga awakaputsa. Zvino unofanira kuaisa muareka.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.2",
            "verseOrgIds": [
              "DEU.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka ndakagadzira areka ndichishandisa muti womuunga uye ndikaveza mahwendefa maviri amabwe akanga akaita seokutanga, ndikakwira mugomo ndakabata mahwendefa maviri aya mumaoko angu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.3",
            "verseOrgIds": [
              "DEU.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akanyora pamahwendefa aya zvakafanana nezvaakanga anyora pakutanga, Mirayiro Gumi yaakanga akuudzai pagomo, ari mumoto, pazuva reungano. Uye Jehovha akaipa kwandiri.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.4",
            "verseOrgIds": [
              "DEU.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ndakadzoka ndikaburuka pagomo ndikaisa mahwendefa muareka yandakanga ndagadzira, sezvandakanga ndarayirwa naJehovha, uye ndimo maari nazvino.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.5",
            "verseOrgIds": [
              "DEU.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "(VaIsraeri vakasimuka vakabva pamatsime avaJaakani vakaenda kuMosera. Ipapo ndipo pakafira Aroni akavigwa, uye Ereazari mwanakomana wake akatora chinzvimbo chake somuprista.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.6",
            "verseOrgIds": [
              "DEU.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakasimukapo vakaenda kuGudhugodha vakapfuurira kuenda kuJotibhata, nyika ine hova dzemvura.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.7",
            "verseOrgIds": [
              "DEU.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyoyo Jehovha akatsaura rudzi rwavaRevhi kuti vatakure areka yesungano yaJehovha, kuti vamire pamberi paJehovha vachishumira, uye kuti varopafadze vanhu muzita raJehovha, sezvavanoita nanhasi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.8",
            "verseOrgIds": [
              "DEU.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndokusaka vaRevhi vasina mugove wenhaka pakati pehama dzavo; Jehovha ndiye nhaka yavo sezvavakaudzwa naJehovha Mwari wenyu.)",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.9",
            "verseOrgIds": [
              "DEU.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino ini ndakanga ndagara pagomo mazuva makumi mana nousiku huna makumi mana, sezvandakaita pakutanga, uye Jehovha akandinzwa panguva iyoyo zvakare. Kwakanga kusiri kuda kwake kuti akuparadzei.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.10",
            "verseOrgIds": [
              "DEU.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kwandiri, \"Enda, utungamirire vanhu panzira yavo, kuitira kuti vapinde uye vatore nyika yandakapikira madzibaba avo kuti ndichavapa.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.11",
            "verseOrgIds": [
              "DEU.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Itya Jehovha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino, iwe Israeri, Jehovha Mwari wako anodeiko kwauri kunze kwokuti utye Jehovha Mwari wako, ufambe munzira dzake dzose, umude, uye ushumire Jehovha Mwari wako nomwoyo wako wose nomweya wako wose,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.12",
            "verseOrgIds": [
              "DEU.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye uchengete mirayiro yaJehovha nemitemo yake yandinokupai nhasi kuti zvikunakire?",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.13",
            "verseOrgIds": [
              "DEU.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Denga, kunyange nedenga ramatenga, nenyika nezvose zviri mairi ndezvaJehovha Mwari wako.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.14",
            "verseOrgIds": [
              "DEU.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro Jehovha akafarira madzitateguru enyu akavada uye akakutsaurai, imi zvizvarwa zvavo, pamusoro pedzimwe ndudzi dzose sezvazviri nhasi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.15",
            "verseOrgIds": [
              "DEU.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo, dzingisai mwoyo yenyu, uye murege kuva nemitsipa mikukutu zvakare.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.16",
            "verseOrgIds": [
              "DEU.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti Jehovha Mwari wenyu ndiMwari wavamwari naIshe wamadzishe, Mwari mukuru, ane simba guru uye anotyisa, asingatsauri vanhu uye asingagamuchiri fufuro.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.17",
            "verseOrgIds": [
              "DEU.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anoruramisira nherera nechirikadzi, uye anoda mutorwa, agomupa zvokudya nezvokupfeka.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.18",
            "verseOrgIds": [
              "DEU.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye munofanira kuda vatorwa, nokuti imi maimbovawo vatorwa muIjipiti.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.19",
            "verseOrgIds": [
              "DEU.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ityai Jehovha Mwari wenyu mugomushumira. Batirirai paari uye muite mhiko dzenyu muzita rake.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.20",
            "verseOrgIds": [
              "DEU.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiye rumbidzo yenyu; ndiye Mwari wenyu, iye akakuitirai zvinhu zvikuru nezvishamiso zvinotyisa zviya zvamakaona nameso enyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.21",
            "verseOrgIds": [
              "DEU.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madzitateguru enyu akaenda kuIjipiti vari makumi manomwe pamwe chete, uye zvino Jehovha Mwari wenyu akaita kuti muwande senyeredzi dzokudenga.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.22",
            "verseOrgIds": [
              "DEU.10.22"
            ]
          }
        }
      ]
    }
  ],
