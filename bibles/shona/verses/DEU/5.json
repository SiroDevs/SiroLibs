              "type": "text"
            }
          ]
        },
        {
          "text": "Saka chenjerai kuti muite zvamakarayirwa naJehovha Mwari wenyu; musatsauka kurudyi kana kuruboshwe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.32",
            "verseOrgIds": [
