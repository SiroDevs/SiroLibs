              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi iwe mira pano pandiri kuti ndikupe zvandakarayira, mitemo nemirayiro yose yaunofanira kuvadzidzisa kuti vazviite panyika yandinovapa kuti ive yavo.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.31",
            "verseOrgIds": [
              "DEU.5.31"
            ]
          }
        }
