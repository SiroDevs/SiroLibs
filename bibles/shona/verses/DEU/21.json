{
  "id": "DEU.21",
  "number": "21",
  "bookId": "DEU",
  "reference": "Dhuteronomi 21",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "DEU 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuyananisira Munhu Asingazivikanwi akaurayiwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana munhu akawanikwa akafa, akatandavara musango munyika iyo Jehovha Mwari wako ari kukupai kuti ive yenyu, uye musingazivi kuti ndiani amuuraya,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.1",
            "verseOrgIds": [
              "DEU.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "vakuru venyu navatongi vachaenda kundoera chinhambwe kubva pachitunha kusvika kumaguta akakomberedza.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.2",
            "verseOrgIds": [
              "DEU.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakuru veguta riri pedyo nechitunha vanofanira kutora tsiru remombe risina kumboshandiswa uye risina kumbokweva pajoko,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.3",
            "verseOrgIds": [
              "DEU.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "vagoenda naro kumupata usina kumborimwa kana kudyarwa uye pane rwizi runoerera. Imomo mumupata vanofanira kuvhuna mutsipa wetsiru.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.4",
            "verseOrgIds": [
              "DEU.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaprista, vanakomana vaRevhi vanofanira kuuya pamberi, nokuti Jehovha Mwari wenyu akavasarudza kuti vashumire nokuropafadza muzita raJehovha uye vanofanira kutonga pamhaka dzose dzegakava nedzokurwa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.5",
            "verseOrgIds": [
              "DEU.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakuru vose veguta riri pedyo nechitunha vanofanira kushamba maoko avo pamusoro petsiru rakavhunwa mutsipa mumupata.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.6",
            "verseOrgIds": [
              "DEU.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vanofanira kuti, \"Maoko edu haana kudeura ropa iri, uye kana meso edu haana kuona zvichiitwa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.7",
            "verseOrgIds": [
              "DEU.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gamuchirai henyu yananiso yavanhu venyu vaIsraeri, vamakadzikinura, imi Jehovha, uye musabata vanhu venyu nemhosva yokuteura ropa romunhu asina mhaka.\" Zvino kuteurwa kweropa kuchayananisirwa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.8",
            "verseOrgIds": [
              "DEU.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka muchabvisa pakati penyu mhosva yokuteurwa kweropa risina mhaka sezvo maita chinhu chakanaka pamberi paJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.9",
            "verseOrgIds": [
              "DEU.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuwana Mukadzi Akatapwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana muchinge maenda kundorwa navavengi venyu uye kana Jehovha Mwari wenyu avaisa mumaoko enyu uye mavatapa,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.10",
            "verseOrgIds": [
              "DEU.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kana ukaona pakati pavakatapwa mukadzi akanaka ukamuda, unogona kumutora ave mukadzi wako.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.11",
            "verseOrgIds": [
              "DEU.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uya naye mumba mako ugomuveura musoro, ugogurira nzara dzake,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.12",
            "verseOrgIds": [
              "DEU.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye ugorasha nguo dzaakatapwa nadzo. Mushure mokunge agara mumba mako nokuchema baba namai vake kwomwedzi wose, ipapo ugopinda kwaari, uve murume wake naiye achava mukadzi wako.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.13",
            "verseOrgIds": [
              "DEU.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana usina kufadzwa naye, murege aende chero kwaanoda. Haufaniri kumutengesa kana kumubata somuranda, sezvo uriwe wamunyadzisa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.14",
            "verseOrgIds": [
              "DEU.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kodzero dzeDangwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana munhu aine vakadzi vaviri, uye achida mumwe asi asingadi mumwe, uye vose vakamuberekera vanakomana asi wedangwe ari mwanakomana womukadzi waasingadi,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.15",
            "verseOrgIds": [
              "DEU.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kana ogova pfuma yake kuvanakomana vake, haafaniri kupa kodzero yedangwe kumwanakomana womukadzi waanoda pachinzvimbo chomwana wake wedangwe chaiye, mwanakomana womukadzi waasingadi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.16",
            "verseOrgIds": [
              "DEU.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anofanira kugamuchira mwanakomana womukadzi wake waasingadi sedangwe nokumupa mugove wakapetwa kaviri wezvose zvaanazvo. Mwanakomana iyeye ndiye chiratidzo chokutanga chesimba rababa vake. Kodzero yomwana wedangwe ndeyake.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.17",
            "verseOrgIds": [
              "DEU.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwanakomana Asingateereri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana munhu aine mwanakomana akasindimara asingateereri baba vake namai vake uye asingavateereri kana vachimuranga,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.18",
            "verseOrgIds": [
              "DEU.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "baba vake namai vake vanofanira kumubata vagoenda naye kuvakuru pasuo reguta.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.19",
            "verseOrgIds": [
              "DEU.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vachati kuvakuru, \"Mwanakomana wedu uyu akasindimara uye anotimukira. Haatiteereri. Anoparadza pfuma uye chidhakwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.20",
            "verseOrgIds": [
              "DEU.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo varume vose vomuguta rake vachamutaka namabwe afe. Munofanira kubvisa chakaipa pakati penyu. Israeri yose ichazvinzwa igotya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.21",
            "verseOrgIds": [
              "DEU.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mitemo Yakasiyana-siyana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana munhu achinge aine mhosva yakafanira rufu, akaurayiwa uye chitunha chake chikasungirirwa pamuti,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.22",
            "verseOrgIds": [
              "DEU.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "hamufaniri kusiya chitunha chake chiri pamuti usiku hwose. Muone kuti mamuviga zuva rimwe chetero, nokuti ani naani akasungirirwa akatukwa naMwari. Hamufaniri kusvibisa nyika yamuri kupiwa naJehovha Mwari wenyu senhaka.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.23",
            "verseOrgIds": [
              "DEU.21.23"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "DEU.22",
    "number": "22",
    "bookId": "DEU"
  },
