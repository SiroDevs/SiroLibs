  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "DEU 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aritari paGomo reEbhari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Mozisi navakuru veIsraeri vakarayira vanhu vachiti, \"Chengetai mirayiro iyi yose yandinokupai nhasi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.1",
            "verseOrgIds": [
              "DEU.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana muchinge mayambuka Jorodhani muchipinda munyika yamuri kupiwa naJehovha Mwari wenyu, munofanira kumisa mabwe makuru mugoapenda nesuko.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.2",
            "verseOrgIds": [
              "DEU.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugonyora pamusoro pawo mashoko ose nomurayiro uyu kana muchinge mayambuka mhiri kuti mupinde munyika yamuri kupiwa naJehovha Mwari wenyu, nyika inoyerera mukaka nouchi, sezvamakavimbiswa naJehovha, iye Mwari wamadzibaba enyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.3",
            "verseOrgIds": [
              "DEU.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino kana muchinge mayambuka Jorodhani, misai mabwe aya paGomo reEbhari, sezvandakurayirai nhasi, mugoapenda nesuko.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.4",
            "verseOrgIds": [
              "DEU.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muvake aritari yaJehovha Mwari wenyu ipapo, aritari yamabwe. Musashandisa simbi pakumisa mabwe aya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.5",
            "verseOrgIds": [
              "DEU.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muvake aritari yaJehovha Mwari wenyu namabwe asina kuvezwa uye mugobayirapo kuna Jehovha Mwari wenyu zvipiriso zvinopiswa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.6",
            "verseOrgIds": [
              "DEU.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubayire zvipiriso zvokuwadzana ipapo, muzvidye muchipembera pamberi paJehovha Mwari wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.7",
            "verseOrgIds": [
              "DEU.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye munofanira kunyora mashoko aya ose omurayiro pamabwe amakamisa aya zvinonyatsoonekwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.8",
            "verseOrgIds": [
              "DEU.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kutukwa kuchadanidzirwa paGomo reEbhari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mozisi navaprista vanova vaRevhi, vakataura kuvaIsraeri vose vakati, \"Nyararai imi Israeri, uye muteerere! Iye zvino mava rudzi rwaJehovha Mwari wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.9",
            "verseOrgIds": [
              "DEU.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo teererai Jehovha Mwari wenyu uye mugotevera mirayiro nemitemo yandinokupai nhasi.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.10",
            "verseOrgIds": [
              "DEU.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva rimwe chetero Mozisi akarayira vanhu achiti:",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.11",
            "verseOrgIds": [
              "DEU.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana muchinge mayambuka Jorodhani, aya ndiwo marudzi anofanira kundomira pamusoro peGomo reGerizimu kuti varopafadze vanhu: Simeoni, Revhi, Judha, Isakari, Josefa naBhenjamini.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.12",
            "verseOrgIds": [
              "DEU.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye marudzi aya ndiwo achamira paGomo reEbhari kuti vadanidzire kutuka: Rubheni, Gadhi, Asheri, Zebhuruni, Dhani, naNafutari.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.13",
            "verseOrgIds": [
              "DEU.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaRevhi vachataura kuvanhu vose veIsraeri nenzwi guru vachiti:",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.14",
            "verseOrgIds": [
              "DEU.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ngaatukwe munhu anoita chifananidzo chakavezwa kana chakaumbwa, chinhu chinonyangadza Jehovha, basa ramaoko emhizha, uye agochimisa pakavanzwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.15",
            "verseOrgIds": [
              "DEU.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmr",
        "vid": "DEU 27:15"
      },
      "items": [
        {
          "text": "Ipapo vanhu vose vachati, \"Ameni!\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.15",
            "verseOrgIds": [
              "DEU.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ngaatukwe munhu anozvidza baba kana mai vake.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.16",
            "verseOrgIds": [
              "DEU.27.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmr",
        "vid": "DEU 27:16"
      },
      "items": [
        {
          "text": "Ipapo vanhu vose vachati, \"Ameni.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.16",
            "verseOrgIds": [
              "DEU.27.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ngaatukwe munhu anoshandura muganhu womuvakidzani wake.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.17",
            "verseOrgIds": [
              "DEU.27.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmr",
        "vid": "DEU 27:17"
      },
      "items": [
        {
          "text": "Ipapo vanhu vose vachati, \"Ameni!\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.17",
            "verseOrgIds": [
              "DEU.27.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ngaatukwe munhu anotsausa bofu panzira.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.18",
            "verseOrgIds": [
              "DEU.27.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmr",
        "vid": "DEU 27:18"
      },
      "items": [
        {
          "text": "Ipapo vanhu vose vachati, \"Ameni!\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.18",
            "verseOrgIds": [
              "DEU.27.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ngaatukwe munhu anorega kururamisira mutorwa, nherera kana chirikadzi.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.19",
            "verseOrgIds": [
              "DEU.27.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmr",
        "vid": "DEU 27:19"
      },
      "items": [
        {
          "text": "Ipapo vanhu vose vachati, \"Ameni!\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.19",
            "verseOrgIds": [
              "DEU.27.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ngaatukwe munhu anovata nomukadzi wababa vake, nokuti azvidza nhoo yababa vake.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.20",
            "verseOrgIds": [
              "DEU.27.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmr",
        "vid": "DEU 27:20"
      },
      "items": [
        {
          "text": "Ipapo vanhu vose vachati, \"Ameni!\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.20",
            "verseOrgIds": [
              "DEU.27.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ngaatukwe munhu anovata nemhuka ipi zvayo.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.21",
            "verseOrgIds": [
              "DEU.27.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmr",
        "vid": "DEU 27:21"
      },
      "items": [
        {
          "text": "Ipapo vanhu vose vachati, \"Ameni!\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.21",
            "verseOrgIds": [
              "DEU.27.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ngaatukwe munhu anovata nehanzvadzi yake, mwanasikana wababa vake, kana mwanasikana wamai vake.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.22",
            "verseOrgIds": [
              "DEU.27.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmr",
        "vid": "DEU 27:22"
      },
      "items": [
        {
          "text": "Ipapo vanhu vose vachati, \"Ameni!\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.22",
            "verseOrgIds": [
              "DEU.27.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ngaatukwe munhu anovata namai vomukadzi wake.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.23",
            "verseOrgIds": [
              "DEU.27.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmr",
        "vid": "DEU 27:23"
      },
      "items": [
        {
          "text": "Ipapo vanhu vose vachati, \"Ameni!\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.23",
            "verseOrgIds": [
              "DEU.27.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ngaatukwe munhu anouraya muvakidzani pakavanda.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.24",
            "verseOrgIds": [
              "DEU.27.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmr",
        "vid": "DEU 27:24"
      },
      "items": [
        {
          "text": "Ipapo vanhu vose vachati, \"Ameni!\"",
          "type": "text",
          "attrs": {
