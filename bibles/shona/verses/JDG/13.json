  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "JDG 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuberekwa kwaSamusoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaIsraeri vakaitazve zvakaipa pamberi paJehovha, saka Jehovha akavaisa mumaoko avaFiristia kwamakore makumi mana.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.1",
            "verseOrgIds": [
              "JDG.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe murumwe weZora ainzi Manoa, aibva muimba yavaDhani, akanga ane mukadzi akanga asingabereki, asina mwana.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.2",
            "verseOrgIds": [
              "JDG.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutumwa waJehovha akazviratidza kwaari uye akati, \"Iwe haubereki uye hauna mwana, asi uchava nemimba uye ugova nomwanakomana.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.3",
            "verseOrgIds": [
              "JDG.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino uone kuti warega kunwa waini kana zvimwe zvokunwa zvakaviriswa uye kuti urege kudya chinhu chipi zvacho chisina kuchena,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.4",
            "verseOrgIds": [
              "JDG.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti uchava nemimba uye uchabereka mwanakomana. Chisvo hachifaniri kuveura musoro wake, nokuti mukomana anofanira kuva muNaziri, akatsaurirwa kuna Mwari kubva pakuzvarwa kwake, uye ndiye achatanga kusunungura vaIsraeri kubva mumaoko avaFiristia.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.5",
            "verseOrgIds": [
              "JDG.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mukadzi akaenda kumurume wake akandomuudza akati, \"Munhu waMwari asvika kwandiri. Anga achiratidzika somutumwa waMwari, anotyisa kwazvo. Handina kumubvunza kuti abva kupi, uye haana kundiudza zita rake.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.6",
            "verseOrgIds": [
              "JDG.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi ati kwandiri, 'Uchava nemimba uye uchabereka mwanakomana. Zvino, chirega kunwa waini kana zvimwe zvokunwa zvakaviriswa uye usadya chinhu chipi zvacho chisina kuchena, nokuti mukomana achava muNaziri waMwari kubva pakuzvarwa kwake kusvikira pazuva raanofa.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.7",
            "verseOrgIds": [
              "JDG.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Manoa akanyengetera kuna Jehovha akati, \"Haiwa Jehovha, ndinokukumbirai, regai munhu waMwari wamakatuma kwatiri adzokezve kuti azotidzidzisa kurera kwatingaita mukomana achazozvarwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.8",
            "verseOrgIds": [
              "JDG.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari akanzwa Manoa, uye mutumwa waMwari akauyazve kumukadzi panguva yaakanga ari kumunda; asi murume wake Manoa akanga asipo paari.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.9",
            "verseOrgIds": [
              "JDG.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukadzi akakurumidza kundoudza murume wake kuti, \"Ari pano! Murume uya akazviratidza kwandiri zuva riya!\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.10",
            "verseOrgIds": [
              "JDG.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manoa akasimuka akatevera mukadzi wake. Akati asvika pamurume uya, akati, \"Ndimi here makataura kumukadzi wangu?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.11",
            "verseOrgIds": [
              "JDG.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 13:11"
      },
      "items": [
        {
          "text": "Iye akati, \"Ndini.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.11",
            "verseOrgIds": [
              "JDG.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Manoa akamubvunza akati, \"Mashoko enyu paachazadziswa, mutemo unofanira kutevedzwa paupenyu hwomukomana napabasa rake ndoupi?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.12",
            "verseOrgIds": [
              "JDG.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutumwa waJehovha akapindura akati, \"Mukadzi wako anofanira kuita zvose zvandakamuudza.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.13",
            "verseOrgIds": [
              "JDG.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haafaniri kudya chinhu chipi zvacho chinobva pamuzambiringa, uye kunwa waini ipi zvayo kana zvimwe zvokunwa zvakaviriswa kana kudya chinhu chipi zvacho chisina kuchena. Anofanira kuita zvose zvandakamurayira.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.14",
            "verseOrgIds": [
              "JDG.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manoa akati kumutumwa waJehovha, \"Tingada kuti mumbogara kusvikira takugadzirirai kambudzana.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.15",
            "verseOrgIds": [
              "JDG.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutumwa waJehovha akapindura akati, \"Kunyange dai mukandibata henyu, handingadyi chokudya chenyu chipi zvacho. Asi kana muchigadzira chipiriso chinopiswa, chipei kuna Jehovha.\" (Manoa haana kuziva kuti akanga ari mutumwa Jehovha.)",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.16",
            "verseOrgIds": [
              "JDG.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Manoa akabvunza mutumwa waJehovha akati, \"Zita renyu ndianiko, kuitira kuti tigokukudzai pachazadziswa shoko renyu?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.17",
            "verseOrgIds": [
              "JDG.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapindura akati, \"Unobvunzireiko zita rangu? Haringanzwisisiki.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.18",
            "verseOrgIds": [
              "JDG.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Manoa akatora kambudzana, pamwe chete nechipiriso chezviyo, akazvibayira kuna Jehovha paruware. Uye Jehovha akaita chinhu chinoshamisa, Manoa nomukadzi wake vakatarisa:",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.19",
            "verseOrgIds": [
              "JDG.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murazvo wemoto wakati uchikwira kubva paaritari wakananga kudenga, mutumwa waJehovha akakwira ari mumurazvo. Vakati vaona izvi, Manoa nomukadzi wake vakawira pasi nezviso zvavo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.20",
            "verseOrgIds": [
              "JDG.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi mutumwa waJehovha haana kuzozviratidzazve kuna Manoa nomukadzi wake, ipapo Manoa akaziva kuti akanga ari mutumwa waJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.21",
            "verseOrgIds": [
              "JDG.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati, \"Tichafa zvirokwazvo! Taona Mwari!\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.22",
            "verseOrgIds": [
              "JDG.13.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi mukadzi wake akati, \"Kana Jehovha anga achida kutiuraya, angadai asina kugamuchira chipiriso chinopiswa nechipiriso chezviyo kubva mumaoko edu, uye angadai asina kutiratidza zvinhu zvose izvi kana kutiudza izvi zvino.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.23",
            "verseOrgIds": [
              "JDG.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukadzi akasununguka mwanakomana uye akamutumidza zita rokuti Samusoni. Akakura uye Jehovha akamuropafadza,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.24",
            "verseOrgIds": [
              "JDG.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye Mweya waJehovha wakatanga kumumutsa paakanga ari paMahane Dhani, pakati peZora neEshitaori.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.25",
            "verseOrgIds": [
              "JDG.13.25"
            ]
          }
        }
      ]
    }
  ],
