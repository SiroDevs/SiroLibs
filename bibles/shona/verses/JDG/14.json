  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "JDG 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuwana kwaSamusoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samusoni akaburuka akaenda kuTimina akandoona ikoko mukadzi muduku wechiFiristia.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.1",
            "verseOrgIds": [
              "JDG.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati adzoka, akasvikoti kuna baba namai vake, \"Ndaona mukadzi wechiFiristia muTimina; zvino nditorerei kuti ave mukadzi wangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.2",
            "verseOrgIds": [
              "JDG.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baba namai vake vakapindura vakati, \"Hapana here mukadzi akakodzera pakati pehama dzako kana pakati pavanhu vokwedu vose? Ungaenda here kuvaFiristia vasina kudzingiswa kuti undotora mukadzi?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.3",
            "verseOrgIds": [
              "JDG.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 14:3"
      },
      "items": [
        {
          "text": "Asi Samusoni akati kuna baba vake, \"Nditorerei iye. Ndiye akanaka kwandiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.3",
            "verseOrgIds": [
              "JDG.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Vabereki vake vakanga vasingazivi kuti izvi zvakanga zvichibva kuna Jehovha, akanga achitsvaka mukana wokurwa navaFiristia; nokuti nenguva iyo ndivo vakanga vachitonga vaIsraeri.)",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.4",
            "verseOrgIds": [
              "JDG.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samusoni akaburuka akaenda kuTimina pamwe chete nababa vake namai vake. Vakati vasvika kuminda yemizambiringa yeTimina, pakarepo shumba yakauya yakananga kwaari ichiomba.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.5",
            "verseOrgIds": [
              "JDG.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mweya waJehovha wakauya pamusoro pake nesimba zvokuti akabvambura shumba napakati namaoko ake kunge anobvambura mbudzana.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.6",
            "verseOrgIds": [
              "JDG.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akaburuka akandotaura nomukadzi, uye aimuda.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.7",
            "verseOrgIds": [
              "JDG.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure menguva yakati kuti, paakadzokera kundomuroora, akatsauka kundoona mutumbi weshumba. Mukati macho makanga mava nebumha renyuchi nouchi,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.8",
            "verseOrgIds": [
              "JDG.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "akahubura namaoko ake akadya achifamba. Akati asvika kuvabereki vake akavapa humwe vakadyawo naivo. Asi haana kuvaudza kuti akanga atora uchi mumutumbi weshumba.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.9",
            "verseOrgIds": [
              "JDG.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino baba vake vakaburuka kundoona mukadzi uya. Uye Samusoni akaita mutambo ikoko, setsika yaiitwa nezvikomba.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.10",
            "verseOrgIds": [
              "JDG.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paakasvika, akapiwa shamwari makumi matatu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.11",
            "verseOrgIds": [
              "JDG.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samusoni akati kwavari, \"Regai ndikutaurirei chirahwe. Kana mukagona kuchidudzira mukati mamazuva manomwe omutambo, ini ndichakupai nguo dzomucheka dzinosvika makumi matatu nehanzu makumi matatu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.12",
            "verseOrgIds": [
              "JDG.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana musingagoni kudzidudzira, imi munofanira kundipa nguo dzomucheka makumi matatu namakumi matatu ehanzu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.13",
            "verseOrgIds": [
              "JDG.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 14:13"
      },
      "items": [
        {
          "text": "Ivo vakati, \"Tiudze chirahwe chako. Rega tichinzwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.13",
            "verseOrgIds": [
              "JDG.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapindura akati,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.14",
            "verseOrgIds": [
              "JDG.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JDG 14:14"
      },
      "items": [
        {
          "text": "\"Kumudyi kwakabuda chokudya;",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.14",
            "verseOrgIds": [
              "JDG.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JDG 14:14"
      },
      "items": [
        {
          "text": "kubva kune chine simba kwakabuda zvinotapira.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.14",
            "verseOrgIds": [
              "JDG.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "JDG 14:14"
      },
      "items": [
        {
          "text": "Havana kugona kupa mhinduro kwamazuva matatu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.14",
            "verseOrgIds": [
              "JDG.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva rechina, vakati kumukadzi waSamusoni, \"Nyengetedza murume wako kuti atsanangure chirahwe kuti tiregere kukupisai mukafa iwe neveimba yababa vako. Munotikoka pano kuzotibira nhai?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.15",
            "verseOrgIds": [
              "JDG.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mukadzi waSamusoni akazviwisira paari, achichema akati, \"Unondivenga iwe! Haundidi chaizvo izvo. Wakapa vanhu vokwangu chirahwe, asi hauna kundiudza dudziro yacho.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.16",
            "verseOrgIds": [
              "JDG.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 14:16"
      },
      "items": [
        {
          "text": "Akapindura akati, \"Handina kutongochitsanangurira baba vangu kana mai vangu, saka ndingachitsanangura seiko kwauri?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.16",
            "verseOrgIds": [
              "JDG.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akachema kwamazuva manomwe ose omutambo. Saka akapedzisira amuudza pazuva rechinomwe, nokuti akaramba achingomumanikidza. Iye akabva azotsanangurira vanhu vake chirahwe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.17",
            "verseOrgIds": [
              "JDG.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva rechinomwe, zuva risati radoka, varume vomuguta vakati kwaari,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.18",
            "verseOrgIds": [
              "JDG.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JDG 14:18"
      },
      "items": [
        {
          "text": "\"Chiiko chinotapira souchi?",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.18",
            "verseOrgIds": [
              "JDG.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JDG 14:18"
      },
      "items": [
        {
          "text": "Chiiko chine simba seshumba?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.18",
            "verseOrgIds": [
              "JDG.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 14:18"
      },
      "items": [
        {
          "text": "Samusoni akati kwavari,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.18",
            "verseOrgIds": [
              "JDG.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JDG 14:18"
      },
      "items": [
        {
          "text": "\"Dai manga musina kurima netsiru rangu,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.18",
            "verseOrgIds": [
              "JDG.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JDG 14:18"
      },
      "items": [
        {
          "text": "mungadai musina kugona kududzira chirahwe changu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.18",
            "verseOrgIds": [
              "JDG.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mweya waJehovha wakauya pamusoro pake nesimba. Akaburuka akaenda kuAshikeroni, akandouraya varume makumi matatu, akakutunura zvinhu zvavo akapa nguo dzavo kuna avo vakadudzira chirahwe. Akatsamwa kwazvo akaenda kumba kwababa vake.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.19",
            "verseOrgIds": [
              "JDG.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye mukadzi waSamusoni akapiwa kushamwari yakanga yamuperekedza pasvitsa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.20",
            "verseOrgIds": [
              "JDG.14.20"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "JDG.15",
    "number": "15",
