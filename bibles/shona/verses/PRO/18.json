      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyo ano usimbe pakubata kwake",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.9",
            "verseOrgIds": [
              "PRO.18.9"
            ]
          }
        }
      ]
    },
