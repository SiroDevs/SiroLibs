            "number": "10",
            "style": "v",
            "sid": "PRO 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zita raJehovha inhare yakasimba;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.10",
            "verseOrgIds": [
              "PRO.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:10"
      },
      "items": [
        {
          "text": "vakarurama vanomhanyira kwariri vagochengetedzwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.10",
            "verseOrgIds": [
              "PRO.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pfuma yavapfumi ndiro guta ravo rina masvingo;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.11",
            "verseOrgIds": [
              "PRO.18.11"
            ]
          }
        }
      ]
    },
