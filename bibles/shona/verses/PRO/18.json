            "sid": "PRO 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuparadzwa kusati kwasvika, mwoyo womunhu unozvikudza,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.12",
            "verseOrgIds": [
              "PRO.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:12"
      },
      "items": [
        {
          "text": "asi kuzvininipisa kunotangira kukudzwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.12",
            "verseOrgIds": [
              "PRO.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
