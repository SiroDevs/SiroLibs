  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "PRO 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waini museki uye doro mupopoti;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.1",
            "verseOrgIds": [
              "PRO.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:1"
      },
      "items": [
        {
          "text": "ani naani anotsauswa nazvo haana kuchenjera.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.1",
            "verseOrgIds": [
              "PRO.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutsamwa kwamambo kwakafanana nokuomba kweshumba;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.2",
            "verseOrgIds": [
              "PRO.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:2"
      },
      "items": [
        {
          "text": "uyo anomutsamwisa anotadzira upenyu hwake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.2",
            "verseOrgIds": [
              "PRO.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munhu achakudzwa kana akagara kure nokukakavara,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.3",
            "verseOrgIds": [
              "PRO.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:3"
      },
      "items": [
        {
          "text": "asi benzi rimwe nerimwe rinokurumidza kupopota.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.3",
            "verseOrgIds": [
              "PRO.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simbe hairimi mumwaka wokurima;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.4",
            "verseOrgIds": [
              "PRO.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:4"
      },
      "items": [
        {
          "text": "saka panguva yokukohwa anotsvaka asi hapana chaanowana.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.4",
            "verseOrgIds": [
              "PRO.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvinangwa zvomwoyo womunhu imvura yakadzika,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.5",
            "verseOrgIds": [
              "PRO.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:5"
      },
      "items": [
        {
          "text": "asi munhu akachenjera achaichera.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.5",
            "verseOrgIds": [
              "PRO.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vazhinji vanoti vane rudo rusingagumi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.6",
            "verseOrgIds": [
              "PRO.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:6"
      },
      "items": [
        {
          "text": "asi munhu akatendeka angawanikwa kupiko?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.6",
            "verseOrgIds": [
              "PRO.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munhu akarurama anorarama upenyu hwakanaka;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.7",
            "verseOrgIds": [
              "PRO.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:7"
      },
      "items": [
        {
          "text": "vana vake vanomutevera vakaropafadzwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.7",
            "verseOrgIds": [
              "PRO.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana mambo achinge agara pachigaro chake kuti atonge,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.8",
            "verseOrgIds": [
              "PRO.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:8"
      },
      "items": [
        {
          "text": "anopepeta zvakaipa zvose nameso ake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.8",
            "verseOrgIds": [
              "PRO.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiani angati, \"Ndakachengeta mwoyo wangu wakachena;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.9",
            "verseOrgIds": [
              "PRO.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:9"
      },
      "items": [
        {
          "text": "ndakachena uye handina zvivi\"?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.9",
            "verseOrgIds": [
              "PRO.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zviereso zvakasiyana nezvipimo zvakasiyana",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.10",
            "verseOrgIds": [
              "PRO.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:10"
      },
      "items": [
        {
          "text": "Jehovha anozvivenga zvose.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.10",
            "verseOrgIds": [
              "PRO.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange mwana anozivikanwa nezvaanoita,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.11",
            "verseOrgIds": [
              "PRO.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:11"
      },
      "items": [
        {
          "text": "kuti tsika dzake dzakanaka uye kuti dzakarurama here.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.11",
            "verseOrgIds": [
              "PRO.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzeve dzinonzwa nameso anoona,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.12",
            "verseOrgIds": [
              "PRO.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:12"
      },
      "items": [
        {
          "text": "Jehovha ndiye akazviita zvose zviri zviviri.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.12",
            "verseOrgIds": [
              "PRO.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usafarira kurara kana kuti uchava murombo;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.13",
            "verseOrgIds": [
              "PRO.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:13"
      },
      "items": [
        {
          "text": "svinudza meso ako ipapo uchava nezvokudya zvakawanda.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.13",
            "verseOrgIds": [
              "PRO.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hazvina kunaka, hazvina kunaka!\" ndizvo zvinotaura mutengi;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.14",
            "verseOrgIds": [
              "PRO.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:14"
      },
      "items": [
        {
          "text": "ipapo hoyo oenda achizvirumbidza pamusoro pezvaatenga.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.14",
            "verseOrgIds": [
              "PRO.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Goridhe riripo, uye matombo anokosha amarubhi azere,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.15",
            "verseOrgIds": [
              "PRO.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:15"
      },
      "items": [
        {
          "text": "asi miromo inotaura zivo ndicho chinhu chinokosha chisipo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.15",
            "verseOrgIds": [
              "PRO.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutorerei nguo yake, uyo anoitira mutorwa rubatso;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.16",
            "verseOrgIds": [
              "PRO.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:16"
      },
      "items": [
        {
          "text": "itorei sorubatso kana azviitira mukadzi asingazvibati.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.16",
            "verseOrgIds": [
              "PRO.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvokudya zvakawanikwa nokunyengera zvinonaka kumunhu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.17",
            "verseOrgIds": [
              "PRO.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:17"
      },
      "items": [
        {
          "text": "asi achapedzisira ava nomukanwa mazara jecha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.17",
            "verseOrgIds": [
              "PRO.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
