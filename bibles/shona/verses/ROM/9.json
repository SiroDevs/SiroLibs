  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "ROM 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kusarudza kwaMwari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinotaura chokwadi muna Kristu, handirevi nhema, hana yangu inondipupurira muMweya Mutsvene",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.1",
            "verseOrgIds": [
              "ROM.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndino kusuwa kukuru kwazvo neshungu dzisingaperi mumwoyo mangu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.2",
            "verseOrgIds": [
              "ROM.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti ndinoshuva kuti dai ini pachangu ndaiva munhu akatukwa uye ndakaparadzaniswa naKristu nokuda kwehama dzangu, ivo vorudzi rwangu,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.3",
            "verseOrgIds": [
              "ROM.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ivo vanhu veIsraeri. Kuva vana ndokwavo; nokubwinya ndokwavo, nesungano, nokupiwa kwomurayiro, nokunamata Mwari mutemberi uye zvipikirwa ndezvavo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.4",
            "verseOrgIds": [
              "ROM.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madzibaba ndeavo, uye naKristu akabva kwavari panyama, ari Mwari pamusoro pazvose, anokudzwa nokusingaperi! Ameni.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.5",
            "verseOrgIds": [
              "ROM.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazvirevi kuti shoko raMwari rakakundikana. Nokuti havasi vose vari zvizvarwa zvaIsraeri vanova vaIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.6",
            "verseOrgIds": [
              "ROM.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye nokuti zvavari vorudzi rwake, vose vana vaAbhurahama. Asi zvinonzi, \"Kuna Isaka ndiko kuchatumidzwa rudzi rwako.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.7",
            "verseOrgIds": [
              "ROM.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namamwe mashoko, havasi vana panyama vanova vana vaMwari, asi vana vechipikirwa ndivo vanonzi vana vaAbhurahama.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.8",
            "verseOrgIds": [
              "ROM.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti aya ndiwo mashoko echipikirwa: \"Panguva yakatarwa ndichauya, uye Sara achava nomwanakomana.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.9",
            "verseOrgIds": [
              "ROM.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwete izvozvo zvoga, asi kuti naRabhekawo akava navana vomunhu mumwe uye baba vamwe, baba vedu Isaka.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.10",
            "verseOrgIds": [
              "ROM.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi mapatya asati azvarwa, vasati vaita chakanaka kana chakaipa, kuitira kuti kuda kwaMwari pakusarudza kwake kusimbiswe,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.11",
            "verseOrgIds": [
              "ROM.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwete nokuda kwamabasa asi nokuda kwake iye anodana, akaudzwa kuti, \"Mukuru achava muranda womuduku.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.12",
            "verseOrgIds": [
              "ROM.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezvazvakanyorwa zvichinzi: \"Jakobho ndakamuda, asi Esau ndakamuvenga.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.13",
            "verseOrgIds": [
              "ROM.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino tichatiiko? Mwari haaruramisiri here? Kwete napaduku!",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.14",
            "verseOrgIds": [
              "ROM.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti anoti kuna Mozisi:",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.15",
            "verseOrgIds": [
              "ROM.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 9:15"
      },
      "items": [
        {
          "text": "\"Ndichanzwira ngoni wandichanzwira ngoni,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.15",
            "verseOrgIds": [
              "ROM.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 9:15"
      },
      "items": [
        {
          "text": "uye ndichaitira tsitsi wandichaitira tsitsi.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.15",
            "verseOrgIds": [
              "ROM.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo, hazvibvi pashungu kana pamabasa omunhu, asi patsitsi dzaMwari.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.16",
            "verseOrgIds": [
              "ROM.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti Rugwaro runoti kuna Faro, \"Ndakakumutsira chikonzero ichochi, kuti ndiratidze simba rangu mauri uye kuti zita rangu rigoparidzwa panyika yose.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.17",
            "verseOrgIds": [
              "ROM.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo Mwari anonzwira ngoni waanoda kunzwira ngoni, uye anoomesa mwoyo wouyo waanoda kuomesa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.18",
            "verseOrgIds": [
              "ROM.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe wenyu angati kwandiri, \"Zvino sei Mwari achiramba achitipa mhosva? Nokuti ndianiko acharamba kuda kwake?\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.19",
            "verseOrgIds": [
              "ROM.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino iwe munhu, ndiwe aniko, kuti upindure Mwari? \"Chakaumbwa chingati kune akachiumba, 'Wakandiitirei zvakadai?' \"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.20",
            "verseOrgIds": [
              "ROM.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muumbi wehari haana simba pamusoro pevhu here, kuti nebundu rimwe chetero aite mimwe midziyo inokudzwa nemimwe midziyo isingakudzwi?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.21",
            "verseOrgIds": [
              "ROM.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, kana Mwari akasarudza kuratidza kutsamwa kwake, uye kuti azivise simba rake, akaita nomwoyo murefu zvikuru pamusoro pemidziyo yokutsamwira kwake, yakagadzirirwa kuparadzwa?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.22",
            "verseOrgIds": [
              "ROM.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana akaita izvi kuti azivise kupfuma kwokubwinya kwake kumidziyo yengoni, avo vaakagadzirira kare kubwinya,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.23",
            "verseOrgIds": [
              "ROM.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunyange isu, vaya vaakadana, kwete kubva kuvaJudha chete asi nokubva kune veDzimwe Ndudziwo?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.24",
            "verseOrgIds": [
              "ROM.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezvaanotaura mubhuku raHosea achiti:",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.25",
            "verseOrgIds": [
              "ROM.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 9:25"
      },
      "items": [
        {
          "text": "\"Ndichavati 'vanhu vangu' vaya vakanga vasiri vanhu vangu;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.25",
            "verseOrgIds": [
              "ROM.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 9:25"
      },
      "items": [
        {
          "text": "uye ndichamuti, 'mudikanwi wangu' iye akanga asiri mudikanwi wangu,\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.25",
            "verseOrgIds": [
              "ROM.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.26",
            "verseOrgIds": [
              "ROM.9.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 9:26"
      },
      "items": [
        {
          "text": "Zvichaitika kuti paya painzi kwavari,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.26",
            "verseOrgIds": [
              "ROM.9.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 9:26"
      },
      "items": [
        {
          "text": "\"Hamusi vanhu vangu;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.26",
            "verseOrgIds": [
              "ROM.9.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 9:26"
      },
      "items": [
        {
          "text": "vachanzi 'vanakomana vaMwari mupenyu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.26",
            "verseOrgIds": [
              "ROM.9.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ROM 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Isaya anodanidzira pamusoro peIsraeri, achiti:",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.27",
            "verseOrgIds": [
              "ROM.9.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 9:27"
      },
      "items": [
        {
          "text": "\"Kunyange kuwanda kwavaIsraeri kwakaita sejecha regungwa,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.27",
            "verseOrgIds": [
              "ROM.9.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 9:27"
      },
      "items": [
        {
          "text": "vakasara chete ndivo vachaponeswa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.27",
            "verseOrgIds": [
              "ROM.9.27"
            ]
          }
