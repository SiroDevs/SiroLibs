              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti zvose zvinobva kwaari uye zviripo kubudikidza naye uye zvose ndezvake.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.36",
