          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ROM 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndianiko akaziva pfungwa dzaShe?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.34",
            "verseOrgIds": [
              "ROM.11.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 11:34"
      },
      "items": [
        {
          "text": "Kana akava mupi wake wamazano?\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.34",
            "verseOrgIds": [
              "ROM.11.34"
            ]
          }
        }
      ]
