  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "HOS 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Israeri achakohwa chamupupuri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Isa hwamanda pamuromo wako!",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.1",
            "verseOrgIds": [
              "HOS.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:1"
      },
      "items": [
        {
          "text": "Gondo riri pamusoro pemba yaJehovha",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.1",
            "verseOrgIds": [
              "HOS.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 8:1"
      },
      "items": [
        {
          "text": "nokuti vanhu vakaputsa sungano yangu",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.1",
            "verseOrgIds": [
              "HOS.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:1"
      },
      "items": [
        {
          "text": "uye vakapandukira murayiro wangu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.1",
            "verseOrgIds": [
              "HOS.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaIsraeri vanodana kwandiri vachiti,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.2",
            "verseOrgIds": [
              "HOS.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:2"
      },
      "items": [
        {
          "text": "'Haiwa, Mwari wedu, tinokuzivai!'",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.2",
            "verseOrgIds": [
              "HOS.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Israeri akaramba zvakanaka;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.3",
            "verseOrgIds": [
              "HOS.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:3"
      },
      "items": [
        {
          "text": "muvengi achamutevera.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.3",
            "verseOrgIds": [
              "HOS.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanogadza madzimambo vasina kutenderwa neni;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.4",
            "verseOrgIds": [
              "HOS.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:4"
      },
      "items": [
        {
          "text": "vanosarudza machinda pasina mvumo yangu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.4",
            "verseOrgIds": [
              "HOS.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 8:4"
      },
      "items": [
        {
          "text": "Vanozvigadzirira zvifananidzo nesirivha negoridhe ravo",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.4",
            "verseOrgIds": [
              "HOS.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:4"
      },
      "items": [
        {
          "text": "kuti vagoparadzwa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.4",
            "verseOrgIds": [
              "HOS.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rasira kunze chifananidzo chako chemhuru, iwe Samaria!",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.5",
            "verseOrgIds": [
              "HOS.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:5"
      },
      "items": [
        {
          "text": "Kutsamwa kwangu kunopisa somoto pamusoro pavo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.5",
            "verseOrgIds": [
              "HOS.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 8:5"
      },
      "items": [
        {
          "text": "Vachasvika kupiko vasingagoni kuzvichenesa?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.5",
            "verseOrgIds": [
              "HOS.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi zvinobva kuIsraeri!",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.6",
            "verseOrgIds": [
              "HOS.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 8:6"
      },
      "items": [
        {
          "text": "Chimhuru ichi, chakagadzirwa nomupfuri,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.6",
            "verseOrgIds": [
              "HOS.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:6"
      },
      "items": [
        {
          "text": "hachisi Mwari.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.6",
            "verseOrgIds": [
              "HOS.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 8:6"
      },
      "items": [
        {
          "text": "Chichaputsika kuita zvimedu zvimedu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.6",
            "verseOrgIds": [
              "HOS.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:6"
      },
      "items": [
        {
          "text": "icho chimhuru cheSamaria.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.6",
            "verseOrgIds": [
              "HOS.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Vanodyara mhepo",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.7",
            "verseOrgIds": [
              "HOS.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:7"
      },
      "items": [
        {
          "text": "vachikohwa chamupupuri.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.7",
            "verseOrgIds": [
              "HOS.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 8:7"
      },
      "items": [
        {
          "text": "Dzinde harina kubereka;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.7",
            "verseOrgIds": [
              "HOS.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:7"
      },
      "items": [
        {
          "text": "haringabudisi upfu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.7",
            "verseOrgIds": [
              "HOS.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 8:7"
      },
      "items": [
        {
          "text": "Dai raizobereka zviyo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.7",
            "verseOrgIds": [
              "HOS.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:7"
      },
      "items": [
        {
          "text": "vatorwa vaizvimedza.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.7",
            "verseOrgIds": [
              "HOS.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israeri yamedzwa;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.8",
            "verseOrgIds": [
              "HOS.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:8"
      },
      "items": [
        {
          "text": "zvino yava pakati pendudzi",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.8",
            "verseOrgIds": [
              "HOS.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:8"
      },
      "items": [
        {
          "text": "sechinhu chisina maturo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.8",
            "verseOrgIds": [
              "HOS.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti vakaenda kuAsiria",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.9",
            "verseOrgIds": [
              "HOS.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:9"
      },
      "items": [
        {
          "text": "sembizi inongombeya yoga.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.9",
            "verseOrgIds": [
              "HOS.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:9"
      },
      "items": [
        {
          "text": "Efuremu akazvitengesa kuvadiwa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.9",
            "verseOrgIds": [
              "HOS.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvavo vakazvitengesa pakati pendudzi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.10",
            "verseOrgIds": [
              "HOS.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:10"
      },
      "items": [
        {
          "text": "ndichavaunganidza zvino pamwe chete.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.10",
            "verseOrgIds": [
              "HOS.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 8:10"
      },
      "items": [
        {
          "text": "Vachatanga kuperezeka",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.10",
            "verseOrgIds": [
              "HOS.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:10"
      },
      "items": [
        {
          "text": "pasi poudzvinyiriri hwamambo ane simba guru.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.10",
            "verseOrgIds": [
              "HOS.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kunyange Efuremu akavaka aritari zhinji dzezvipiriso zvechivi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.11",
            "verseOrgIds": [
              "HOS.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:11"
      },
      "items": [
        {
          "text": "idzi dzava aritari dzokuitira zvivi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.11",
            "verseOrgIds": [
              "HOS.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakavanyorera zvinhu zvakawanda zvomurayiro wangu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.12",
            "verseOrgIds": [
              "HOS.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 8:12"
      },
      "items": [
        {
          "text": "asi vakazvitora sezvinhu zvisinei navo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.12",
            "verseOrgIds": [
              "HOS.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HOS 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanopa zvibayiro kwandiri",
          "type": "text",
          "attrs": {
            "verseId": "HOS.8.13",
            "verseOrgIds": [
              "HOS.8.13"
            ]
          }
        }
      ]
    },
