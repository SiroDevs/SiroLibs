      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pose pandinoda kuporesa Israeri,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.1",
            "verseOrgIds": [
              "HOS.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:1"
      },
      "items": [
        {
          "text": "zvivi zvaEfuremu zvinoiswa pachena",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.1",
            "verseOrgIds": [
              "HOS.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:1"
      },
      "items": [
        {
          "text": "uye mhosva dzeSamaria dzinobudiswa pachena.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.1",
            "verseOrgIds": [
              "HOS.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:1"
      },
      "items": [
        {
          "text": "Vanoita zvounyengeri,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.1",
            "verseOrgIds": [
              "HOS.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:1"
      },
      "items": [
        {
          "text": "mbavha dzinopaza dzimba,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.1",
            "verseOrgIds": [
              "HOS.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:1"
      },
      "items": [
        {
          "text": "uye makororo anotorera vanhu zvinhu munzira;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.1",
            "verseOrgIds": [
              "HOS.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi havazivi kuti",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.2",
            "verseOrgIds": [
              "HOS.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:2"
      },
      "items": [
        {
          "text": "ndinorangarira zvakaipa zvose zvavanoita.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.2",
            "verseOrgIds": [
              "HOS.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:2"
      },
      "items": [
        {
          "text": "Zvivi zvavo zvinovakomberedza;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.2",
            "verseOrgIds": [
              "HOS.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:2"
      },
      "items": [
        {
          "text": "zvinoramba zviri pamberi pangu nguva dzose.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.2",
            "verseOrgIds": [
              "HOS.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Vanofadza mambo nezvakaipa zvavo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.3",
            "verseOrgIds": [
              "HOS.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:3"
      },
      "items": [
        {
          "text": "machinda nenhema dzavo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.3",
            "verseOrgIds": [
              "HOS.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vose imhombwe,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.4",
            "verseOrgIds": [
              "HOS.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:4"
      },
      "items": [
        {
          "text": "vanopisa sechoto,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.4",
            "verseOrgIds": [
              "HOS.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:4"
      },
      "items": [
        {
          "text": "moto wacho usingadi mukanyi wechingwa kukuchidzira,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.4",
            "verseOrgIds": [
              "HOS.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:4"
      },
      "items": [
        {
          "text": "kubva pakukanywa kwebundu rechingwa kusvikira chafuta.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.4",
            "verseOrgIds": [
              "HOS.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva romutambo wamambo wedu",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.5",
            "verseOrgIds": [
              "HOS.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:5"
      },
      "items": [
        {
          "text": "machinda anorwara nokuda kwewaini,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.5",
            "verseOrgIds": [
              "HOS.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:5"
      },
      "items": [
        {
          "text": "uye iye akabatana navaseki.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.5",
            "verseOrgIds": [
              "HOS.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwoyo yavo yakafanana nechoto;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.6",
            "verseOrgIds": [
              "HOS.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:6"
      },
      "items": [
        {
          "text": "vanouya kwaari nounyengeri,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.6",
            "verseOrgIds": [
              "HOS.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:6"
      },
      "items": [
        {
          "text": "ruchiva rwavo runonyeketa somoto usiku hwose;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.6",
            "verseOrgIds": [
              "HOS.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:6"
      },
      "items": [
        {
          "text": "mangwanani ruchizopfuta serimi romoto.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.6",
            "verseOrgIds": [
              "HOS.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vose zvavo vanopisa sechoto;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.7",
            "verseOrgIds": [
              "HOS.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:7"
      },
      "items": [
        {
          "text": "vanoparadza vatongi vavo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.7",
            "verseOrgIds": [
              "HOS.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:7"
      },
      "items": [
        {
          "text": "Madzimambo avo ose anowira pasi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.7",
            "verseOrgIds": [
              "HOS.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:7"
      },
      "items": [
        {
          "text": "uye hapana kana mumwe wavo anodana kwandiri.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.7",
            "verseOrgIds": [
              "HOS.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Efuremu anovhengana namarudzi;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.8",
            "verseOrgIds": [
              "HOS.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:8"
      },
      "items": [
        {
          "text": "Efuremu chingwa chitete chisina kushandurwa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.8",
            "verseOrgIds": [
              "HOS.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vatorwa vakamusveta simba rake,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.9",
            "verseOrgIds": [
              "HOS.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:9"
      },
      "items": [
        {
          "text": "asi iye haazvizivi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.9",
            "verseOrgIds": [
              "HOS.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:9"
      },
      "items": [
        {
          "text": "Bvudzi rake rava kuchena,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.9",
            "verseOrgIds": [
              "HOS.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:9"
      },
      "items": [
        {
          "text": "asi iye haazvicherechedzi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.9",
            "verseOrgIds": [
              "HOS.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuzvikudza kwaIsraeri kunomupupurira zvakaipa,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.10",
            "verseOrgIds": [
              "HOS.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:10"
      },
      "items": [
        {
          "text": "asi kunyange zvakadaro",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.10",
            "verseOrgIds": [
              "HOS.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:10"
      },
      "items": [
        {
          "text": "haadzoki kuna Jehovha Mwari wake",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.10",
            "verseOrgIds": [
              "HOS.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:10"
      },
      "items": [
        {
          "text": "kana kumutsvaka.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.10",
            "verseOrgIds": [
              "HOS.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Efuremu akaita senjiva,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.11",
            "verseOrgIds": [
              "HOS.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:11"
      },
      "items": [
        {
          "text": "inonyengereka zviri nyore uye isina njere,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.11",
            "verseOrgIds": [
              "HOS.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:11"
      },
      "items": [
        {
          "text": "zvino anodana kuIjipiti,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.11",
            "verseOrgIds": [
              "HOS.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:11"
      },
      "items": [
        {
          "text": "mushure anoenda kuAsiria.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.11",
            "verseOrgIds": [
              "HOS.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pavachaenda, ndichakandira mumbure pamusoro pavo;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.12",
            "verseOrgIds": [
              "HOS.7.12"
