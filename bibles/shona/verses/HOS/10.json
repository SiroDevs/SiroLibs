  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "HOS 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israeri akanga ari muzambiringa unotanda;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.1",
            "verseOrgIds": [
              "HOS.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:1"
      },
      "items": [
        {
          "text": "akazviberekera zvibereko.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.1",
            "verseOrgIds": [
              "HOS.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:1"
      },
      "items": [
        {
          "text": "Zvibereko zvake pazvakawanda,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.1",
            "verseOrgIds": [
              "HOS.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:1"
      },
      "items": [
        {
          "text": "akavakawo aritari dzakawanda;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.1",
            "verseOrgIds": [
              "HOS.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:1"
      },
      "items": [
        {
          "text": "nyika yake payakabudirira,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.1",
            "verseOrgIds": [
              "HOS.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:1"
      },
      "items": [
        {
          "text": "akashongedzawo matombo ake anoera.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.1",
            "verseOrgIds": [
              "HOS.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwoyo wavo unonyengera,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.2",
            "verseOrgIds": [
              "HOS.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:2"
      },
      "items": [
        {
          "text": "uye zvino vanofanira kutakura mhosva yavo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.2",
            "verseOrgIds": [
              "HOS.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:2"
      },
      "items": [
        {
          "text": "Jehovha achaputsa aritari dzavo",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.2",
            "verseOrgIds": [
              "HOS.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:2"
      },
      "items": [
        {
          "text": "uye achaparadza matombo avo akaereswa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.2",
            "verseOrgIds": [
              "HOS.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vachati, \"Hatina mambo",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.3",
            "verseOrgIds": [
              "HOS.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:3"
      },
      "items": [
        {
          "text": "nokuti hatina kukudza Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.3",
            "verseOrgIds": [
              "HOS.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:3"
      },
      "items": [
        {
          "text": "Asi kunyange taiva namambo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.3",
            "verseOrgIds": [
              "HOS.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:3"
      },
      "items": [
        {
          "text": "angadai akatiitireiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.3",
            "verseOrgIds": [
              "HOS.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanovimbisa zvakawanda,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.4",
            "verseOrgIds": [
              "HOS.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:4"
      },
      "items": [
        {
          "text": "vanoita mhiko dzenhema",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.4",
            "verseOrgIds": [
              "HOS.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:4"
      },
      "items": [
        {
          "text": "uye vanoita zvibvumirano;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.4",
            "verseOrgIds": [
              "HOS.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:4"
      },
      "items": [
        {
          "text": "naizvozvo mhosva dzinoendeswa kudare",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.4",
            "verseOrgIds": [
              "HOS.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:4"
      },
      "items": [
        {
          "text": "dzinomera sebise rinouraya mumunda wakarimwa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.4",
            "verseOrgIds": [
              "HOS.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vanogara muSamaria vanotyira",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:5"
      },
      "items": [
        {
          "text": "chifananidzo chemhuru chaBheti Avheni.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:5"
      },
      "items": [
        {
          "text": "Vanhu vacho vachachichema,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:5"
      },
      "items": [
        {
          "text": "ndizvo zvichaitawo vaprista vanonamata chifananidzo chacho;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:5"
      },
      "items": [
        {
          "text": "ivavo vakafarira kukudzwa kwacho,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:5"
      },
      "items": [
        {
          "text": "nokuti vachachitorerwa chigoendeswa kuutapwa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.5",
            "verseOrgIds": [
              "HOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chichatakurwa chigoendeswa kuAsiria",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.6",
            "verseOrgIds": [
              "HOS.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:6"
      },
      "items": [
        {
          "text": "somutero kuna mambo mukuru.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.6",
            "verseOrgIds": [
              "HOS.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:6"
      },
      "items": [
        {
          "text": "Efuremu achanyadziswa;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.6",
            "verseOrgIds": [
              "HOS.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:6"
      },
      "items": [
        {
          "text": "Israeri achanyarawo nokuda kwezvifananidzo zvakavezwa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.6",
            "verseOrgIds": [
              "HOS.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samaria namambo wayo ichaeredzwa",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.7",
            "verseOrgIds": [
              "HOS.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:7"
      },
      "items": [
        {
          "text": "sechimuti pamusoro pemvura.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.7",
            "verseOrgIds": [
              "HOS.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzvimbo dzakakwirira dzouipi dzichaparadzwa,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:8"
      },
      "items": [
        {
          "text": "ichi ndicho chivi chaIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:8"
      },
      "items": [
        {
          "text": "Minzwa norukato zvichamera",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:8"
      },
      "items": [
        {
          "text": "zvigofukidza aritari dzavo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:8"
      },
      "items": [
        {
          "text": "Ipapo vachati kumakomo, \"Tifukidzei!\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:8"
      },
      "items": [
        {
          "text": "nokuzvikomo, \"Wirai pamusoro pedu!\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.8",
            "verseOrgIds": [
              "HOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kubva pamazuva eGibhea, wakatadza, iwe Israeri,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.9",
            "verseOrgIds": [
              "HOS.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:9"
      },
      "items": [
        {
          "text": "uye ukarambirapo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.9",
            "verseOrgIds": [
              "HOS.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:9"
      },
      "items": [
        {
          "text": "Hondo haina kukunda",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.9",
            "verseOrgIds": [
              "HOS.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:9"
      },
      "items": [
        {
          "text": "vaiti vezvakaipa paGibhea here?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.9",
            "verseOrgIds": [
              "HOS.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenguva yandinoda ndichavaranga;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.10",
            "verseOrgIds": [
              "HOS.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:10"
      },
      "items": [
        {
          "text": "ndudzi dzichaungana kuti dzivarwise",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.10",
            "verseOrgIds": [
              "HOS.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:10"
      },
      "items": [
        {
          "text": "dzivaise muusungwa nokuda kwezvivi zvavo zviviri.",
          "type": "text",
