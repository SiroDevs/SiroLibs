  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "EXO 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuberekwa kwaMozisi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino mumwe murume weimba yaRevhi akawana mukadzi,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.1",
            "verseOrgIds": [
              "EXO.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye mukadzi uyu akava nemimba akabereka mwanakomana. Paakaona kuti akanga ari mwana akanaka, akamuvanza kwemwedzi mitatu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.2",
            "verseOrgIds": [
              "EXO.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi akati asisagoni kumuvanza, akamutorera tswanda yenhokwe akainama netara nenamo. Ipapo akaisa mwana imomo ndokuiisa pakati petsanga dzaiva mumahombekombe aNairi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.3",
            "verseOrgIds": [
              "EXO.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanzvadzi yake yakamira iri chinhambwe kuti ione kuti chii chaizoitika kwaari.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.4",
            "verseOrgIds": [
              "EXO.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mwanasikana waFaro akaburuka akaenda kurwizi Nairi kuti andoshamba, uye varandakadzi vake vakanga vachifamba vachitevedza mahombekombe. Akaona tswanda pakati petsanga ndokubva atuma murandakadzi wake kuti andoitora.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.5",
            "verseOrgIds": [
              "EXO.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaizarura akaona mwana. Akanga achichema, uye akamunzwira tsitsi. Akati, \"Uyu ndomumwe wavana vavaHebheru.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.6",
            "verseOrgIds": [
              "EXO.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo hanzvadzi yake yakakumbira mwanasikana waFaro ikati, \"Ndingaenda here ndikandokutorerai mumwe wavakadzi vechiHebheru kuti azokurererai mwana?\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.7",
            "verseOrgIds": [
              "EXO.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye mwanasikana waFaro akapindura akati, \"Hongu.\" Uye musikana akaenda akandotora mai vomwana.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.8",
            "verseOrgIds": [
              "EXO.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanasikana waFaro akati kwavari, \"Tora mwana uyu unondirererawo, uye ini ndichakupa muripo wako.\" Saka mukadzi akatora mwana akamurera.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.9",
            "verseOrgIds": [
              "EXO.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana akati akura, akamutora akaenda naye kumwanasikana waFaro akava mwanakomana wake. Akamutumidza zita rokuti Mozisi, achiti, \"Ndakamutora mumvura.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.10",
            "verseOrgIds": [
              "EXO.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mozisi anotizira kuMidhiani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rimwe zuva Mozisi akura, akaenda kwakanga kuna vanhu vokwake uye akavatarira vari pabasa ravo rakaoma. Akaona muIjipita achirova muHebheru, mumwe wavanhu vokwake.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.11",
            "verseOrgIds": [
              "EXO.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaringa-ringa ndokuona kusina munhu achibva auraya muIjipita, ndokumuviga mujecha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.12",
            "verseOrgIds": [
              "EXO.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zuva rakatevera, akabuda akaona vaHebheru vaviri vachirwa. Akabvunza uya akanga akanganisa akati, \"Seiko uchirova mumwe wako muHebheru?\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.13",
            "verseOrgIds": [
              "EXO.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murume uya akati, \"Ndianiko akakuita mubati nomutongi pamusoro pedu? Uri kuda kundiuraya sokuuraya kwawakaita muIjipita nhai?\" Ipapo Mozisi akatya akafunga akati, \"Zvandakaita zvinofanira kuva zvava kuzivikanwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.14",
            "verseOrgIds": [
              "EXO.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faro akati anzwa izvi, akaedza kuuraya Mozisi, asi Mozisi akatiza Faro akaenda kundogara kuMidhiani, uye akagara patsime.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.15",
            "verseOrgIds": [
              "EXO.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino muprista weMidhiani akanga ana vanasikana vanomwe uye vakauya kuzochera mvura yokuti vazadze midziyo yainwira zvipfuwo zvababa vavo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.16",
            "verseOrgIds": [
              "EXO.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamwe vafudzi vakasvika vakavadzinga, asi Mozisi akasimuka akavanunura uye akanwisa zvipfuwo zvavo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.17",
            "verseOrgIds": [
              "EXO.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vasikana pavakadzokera kuna Reueri baba vavo, akavabvunza akati, \"Makurumidza seiko kudzoka nhasi?\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.18",
            "verseOrgIds": [
              "EXO.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakapindura vakati, \"Tanunurwa nomuIjipita kubva kuvafudzi. Abva aticherera mvura uye akanwisa zvipfuwo.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.19",
            "verseOrgIds": [
              "EXO.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabvunza vanasikana vake akati, \"Aripiko? Mamusiyirei? Mudanei, auye azodya.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.20",
            "verseOrgIds": [
              "EXO.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi akabvuma kugara nomurume uyu, uyo akazopa mwanasikana wake Zipora kuna Mozisi kuti ave mukadzi wake.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.21",
            "verseOrgIds": [
              "EXO.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zipora akabereka mwanakomana, uye Mozisi akamutumidza zita rokuti Gerishomi, achiti, \"Ndava mueni munyika yavatorwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.22",
            "verseOrgIds": [
              "EXO.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino makore mazhinji akati apfuura, mambo weIjipiti akafa. VaIsraeri vakagomera muutapwa hwavo uye vakachema, kuchemera rubatsiro rwavo nokuda kwoutapwa hwavo kukakwira kuna Mwari.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.23",
            "verseOrgIds": [
              "EXO.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari akanzwa kugomera kwavo uye akarangarira sungano yake naAbhurahama, naIsaka uye naJakobho.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.24",
            "verseOrgIds": [
              "EXO.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Mwari akatarisa pamusoro pavaIsraeri akava nehanya navo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.25",
            "verseOrgIds": [
              "EXO.2.25"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "EXO.3",
