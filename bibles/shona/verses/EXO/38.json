      },
      "items": [
        {
          "text": "38",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aritari yeZvipiriso Zvinopiswa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 38:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakavaka aritari yezvipiriso zvinopiswa yamatanda omuunga, yakakwirira makubhiti matatu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.1",
            "verseOrgIds": [
              "EXO.38.1"
            ]
          }
        },
        {
          "text": "; yakanga yakaenzana mativi ayo mana ina makubhiti mashanu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.1",
            "verseOrgIds": [
              "EXO.38.1"
            ]
          }
        },
        {
          "text": "pakureba uye namakubhiti mashanu paupamhi hwayo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.1",
            "verseOrgIds": [
              "EXO.38.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 38:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakagadzira runyanga pamakona mana ose zvokuti nyanga nearitari zvakanga zvava chinhu chimwe chete, uye vakafukidza aritari nendarira.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.2",
            "verseOrgIds": [
              "EXO.38.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaita midziyo yayo yose nendarira, hari dzayo, foshoro dzayo, midziyo yokusasa zvibayiso zvenyama uye namakango apamoto.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.3",
            "verseOrgIds": [
              "EXO.38.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaitira aritari chiparo, mumbure wendarira, kuti chive pasi pechitsiko chayo, pakati napakati pokukwirira kwearitari.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.4",
            "verseOrgIds": [
              "EXO.38.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaumba mhete dzendarira kuti dzibate mapango amakona mana echiparo chendarira.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.5",
            "verseOrgIds": [
              "EXO.38.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaita mapango omuti womuunga vakaafukidza nendarira.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.6",
            "verseOrgIds": [
              "EXO.38.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakapinza mapango mukati memhete kuitira kuti agova pamativi earitari, kuti vaitakure nawo. Vakaiita namapuranga, isina chinhu mukati.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.7",
            "verseOrgIds": [
              "EXO.38.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mudziyo woKushambira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakagadzira mudziyo wokushambira wendarira uye nezvigadziko zvawo zvendarira kubva pazvionioni zvamadzimai aishumira pamukova wokupinda muTende Rokusangana.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.8",
            "verseOrgIds": [
              "EXO.38.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ruvazhe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pashure vakaita ruvazhe. Rutivi rwezasi rwakanga rwakareba makubhiti zana",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.9",
            "verseOrgIds": [
              "EXO.38.9"
            ]
          }
        },
        {
          "text": "uye rwaiva nezvidzitiro zvomucheka wakarukwa zvakaisvonaka,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.9",
            "verseOrgIds": [
              "EXO.38.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "namatanda makumi maviri uye nezvigadziko zvendarira makumi maviri, nezvikorekedzo zvesirivha uye nezvisungo pamusoro pamatanda.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.10",
            "verseOrgIds": [
              "EXO.38.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rutivi rwokumusorowo rwakanga runa makubhiti zana pakureba uye rwakanga rune matanda makumi maviri nezvigadziko zvendarira, ine zvikorekedzo zvesirivha nezvisungo pamusoro pamatanda.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.11",
            "verseOrgIds": [
              "EXO.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 38:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mucheto wokumavirira wakanga una makubhiti makumi mashanu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.12",
            "verseOrgIds": [
              "EXO.38.12"
            ]
          }
        },
        {
          "text": "paupamhi, uye kwaiva nezvidzitiro, namatanda gumi uye nezvigadziko gumi, nezvikorekedzo zvesirivha nezvisungo pamusoro pamatanda.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.12",
            "verseOrgIds": [
              "EXO.38.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumucheto wokumabvazuva, wakananga kunobuda nezuva, kwaivawo noupamhi hwamakubhiti makumi mashanu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.13",
            "verseOrgIds": [
              "EXO.38.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 38:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvidzitiro zvakareba makubhiti gumi namashanu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.14",
            "verseOrgIds": [
              "EXO.38.14"
            ]
          }
        },
        {
          "text": "zvaiva kurutivi rumwe chete rwomukova, namatanda matatu ezvigadziko zvitatu,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.14",
            "verseOrgIds": [
              "EXO.38.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 38:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye zvidzitiro zvakareba makubhiti gumi namashanu zvaiva kuno rumwe rutivi rwokupinda muruvazhe, namatanda matatu uye nezvigadziko zvitatu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.15",
            "verseOrgIds": [
              "EXO.38.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 38:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvidzitiro zvose zvaipoteredza ruvazhe zvaiva zvomucheka wakarukwa zvakaisvonaka.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.16",
            "verseOrgIds": [
              "EXO.38.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 38:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvigadziko zvamatanda zvakanga zviri zvendarira. Zvikorekedzo nezvisungo zvaiva pamatanda zvaiva zvesirivha, uye misoro yawo yakanga yakafukidzwa nesirivha; saka matanda ose oruvazhe akanga ane zvisungo zvesirivha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.17",
            "verseOrgIds": [
              "EXO.38.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 38:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chidzitiro chomukova wokupinda muruvazhe chaiva chewuru yebhuruu, nepepuru netsvuku uye nomucheka wakarukwa zvakaisvonaka, basa romuruki. Chakanga chakareba makubhiti makumi maviri",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.18",
            "verseOrgIds": [
              "EXO.38.18"
            ]
          }
        },
        {
          "text": ", chakaita sechidzitiro chaparuvazhe, makubhiti mashanu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.18",
            "verseOrgIds": [
              "EXO.38.18"
            ]
          }
        },
        {
          "text": "kukwirira kwacho,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.18",
            "verseOrgIds": [
              "EXO.38.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 38:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "namatanda mana uye nezvigadziko zvendarira zvina. Zvikorekedzo zvazvo nezvisungo zvazvo zvaiva zvesirivha, uye misoro yacho yakanga yakafukidzwa nesirivha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.19",
            "verseOrgIds": [
              "EXO.38.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 38:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbambo dzose dzetende retabhenakeri nezvaipoteredza ruvazhe zvaiva zvendarira.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.20",
            "verseOrgIds": [
              "EXO.38.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zvinhu zvakashandiswa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 38:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ndiko kuwanda kwezvinhu zvakashandiswa patabhenakeri, iyo tabhenakeri yeChipupuriro, zvakanyorwa pakurayira kwaMozisi navaRevhi vari pasi paItamari mwanakomana waAroni, muprista.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.21",
            "verseOrgIds": [
              "EXO.38.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 38:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhezareri mwanakomana waUri, mwanakomana waHuri, worudzi rwaJudha, akagadzira zvose zvakarayirwa Mozisi naJehovha;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.22",
            "verseOrgIds": [
              "EXO.38.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 38:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "aiva naDhoriabhu mwanakomana waAhisamaki, worudzi rwaDhani, mhizha nomusoni, uye musoni wewuru yebhuruu, pepuru netsvuku nomucheka wakaisvonaka.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.23",
            "verseOrgIds": [
              "EXO.38.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 38:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwanda kwegoridhe rose rakabva kuzvipiriso zvokuninira rakashandiswa pabasa rose rapaimba tsvene kwaiva matarenda makumi maviri namapfumbamwe namashekeri mazana manomwe ana makumi matatu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.24",
            "verseOrgIds": [
              "EXO.38.24"
            ]
          }
        },
        {
          "text": ", zvichienderana neshekeri renzvimbo tsvene.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.24",
            "verseOrgIds": [
              "EXO.38.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 38:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sirivha yakawanikwa yakabva kuna avo veungano vakaverengwa pakunyorwa, yaiva matarenda zana, uye chiuru chimwe namazana manomwe namakumi manomwe namashanu amashekeri",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.25",
            "verseOrgIds": [
              "EXO.38.25"
            ]
          }
        },
        {
          "text": ", zvichienderana neshekeri renzvimbo tsvene,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.25",
            "verseOrgIds": [
              "EXO.38.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 38:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "bheka rimwe chete pamunhu, ndiyo hafu yeshekeri",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.26",
            "verseOrgIds": [
              "EXO.38.26"
            ]
          }
        },
        {
          "text": ", zvichienderana neshekeri renzvimbo tsvene, kubva kumunhu wose akanga ayambukira kuna avo vakanga vatoverengwa, vana makore makumi maviri kana kupfuura, varume vakanga vari zviuru mazana matanhatu navatatu namazana mashanu ana makumi mashanu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.26",
            "verseOrgIds": [
              "EXO.38.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 38:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matarenda zana",
