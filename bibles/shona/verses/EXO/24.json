  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "EXO 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sungano inosimbiswa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akati kuna Mozisi, \"Kwira kuna Jehovha, iwe naAroni, Nadhabhi naAbhihu, navakuru vavaIsraeri makumi manomwe. Munamate muri chinhambwe,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.1",
            "verseOrgIds": [
              "EXO.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi Mozisi oga ndiye anofanira kuswedera kuna Jehovha; vamwe havafaniri kuswedera pedyo. Uye vanhu havangakwiri naye.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.2",
            "verseOrgIds": [
              "EXO.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi akati aenda kundoudza vanhu mashoko ose nemirayiro yose yaJehovha, ivo vakati nenzwi rimwe chete, \"Tichaita zvinhu zvose zvakarehwa naJehovha.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.3",
            "verseOrgIds": [
              "EXO.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mozisi akanyora zvinhu zvose zvakanga zvarehwa naJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.4",
            "verseOrgIds": [
              "EXO.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 24:4"
      },
      "items": [
        {
          "text": "Akamuka mangwana acho mangwanani akavaka aritari mujinga megomo uye akamisa mbiru dzamabwe gumi nembiri dzichimirira marudzi gumi namaviri avaIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.4",
            "verseOrgIds": [
              "EXO.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akatuma majaya avaIsraeri, uye vakapa zvipiriso zvinopiswa uye vakabayira hando duku sezvipiriso zvokuwadzana kuna Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.5",
            "verseOrgIds": [
              "EXO.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi akatora hafu yeropa akariisa mumidziyo, uye imwe hafu akaisasa paaritari.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.6",
            "verseOrgIds": [
              "EXO.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akatora Bhuku reSungano akariverengera vanhu. Ivo vakati, \"Tichaita zvinhu zvose zvakarehwa naJehovha; tichazviteerera.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.7",
            "verseOrgIds": [
              "EXO.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mozisi akatora ropa, akarisasa pamusoro pavanhu uye akati, \"Iri iropa resungano yaitwa naJehovha nemi maererano namashoko aya ose.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.8",
            "verseOrgIds": [
              "EXO.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi naAroni, Nadhabhi naAbhihu uye navakuru makumi manomwe vavaIsraeri vakakwira",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.9",
            "verseOrgIds": [
              "EXO.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye vakaona Mwari waIsraeri. Pasi petsoka dzake pakanga pane chimwe chinhu chakaita sechivakwa chesafire, chakanga chichionekwa sedenga pacharo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.10",
            "verseOrgIds": [
              "EXO.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Mwari haana kusimudza ruoko rwake pamusoro pavatungamiri vavaIsraeri ava; vakaona Mwari, uye vakadya vakanwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.11",
            "verseOrgIds": [
              "EXO.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Mozisi, \"Kwira kuno kwandiri pamusoro pegomo ugare pano, ndigokupa mahwendefa amabwe, ane mirayiro nemitemo zvandanyora kuti varayirwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.12",
            "verseOrgIds": [
              "EXO.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mozisi akasimuka naJoshua mubatsiri wake, uye Mozisi akakwira mugomo raMwari.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.13",
            "verseOrgIds": [
              "EXO.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kuvakuru, \"Timirirei pano kusvikira tadzoka kwamuri. Aroni naHuri vanemi, uye ani naani zvake anopesana nomumwe anogona kuenda kwavari.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.14",
            "verseOrgIds": [
              "EXO.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi akati akwira mugomo, gore rakarifukidza,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.15",
            "verseOrgIds": [
              "EXO.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye kubwinya kwaJehovha kwakagara pamusoro peGomo reSinai. Gore rakafukidza gomo iro kwamazuva matanhatu, uye pazuva rechinomwe, Jehovha akadana Mozisi ari mukati megore.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.16",
            "verseOrgIds": [
              "EXO.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "KuvaIsraeri, kubwinya kwaJehovha kwairatidzika somoto unoparadza uri pamusoro pegomo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.17",
            "verseOrgIds": [
              "EXO.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akapinda mugore paakanga achikwira mugomo. Uye akagara mugomo kwamazuva makumi mana nousiku huna makumi mana.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.18",
            "verseOrgIds": [
              "EXO.24.18"
            ]
          }
        }
      ]
    }
  ],
