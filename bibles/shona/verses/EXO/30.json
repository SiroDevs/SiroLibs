  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "EXO 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aritari yeZvinonhuhwira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uite aritari yokupisira zvinonhuhwira namatanda omuunga.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.1",
            "verseOrgIds": [
              "EXO.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inofanira kuenzana mativi ayo ose ari mana, yakareba kubhiti rimwe chete",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.2",
            "verseOrgIds": [
              "EXO.30.2"
            ]
          }
        },
        {
          "text": "uye kubhiti rimwe chete paupamhi, uye kukwirira kwayo makubhiti maviri",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.2",
            "verseOrgIds": [
              "EXO.30.2"
            ]
          }
        },
        {
          "text": ", nyanga dzayo dzive chinhu chimwe chete nayo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.2",
            "verseOrgIds": [
              "EXO.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ufukidze pamusoro payo namativi ose uye nenyanga dzayo negoridhe rakaisvonaka,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.3",
            "verseOrgIds": [
              "EXO.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye uite hata mbiri kumativi akatarisana. Kuti dzibate mapango anoshandiswa kuitakura.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.4",
            "verseOrgIds": [
              "EXO.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uite mapango aya nomuti womuunga uye uafukidze negoridhe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.5",
            "verseOrgIds": [
              "EXO.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uise aritari mberi kwechidzitiro chiri pamberi peareka yeChipupuriro, pamberi pechifunhiro chokuyananisa chiri pamusoro peChipupuriro, pandichasangana newe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.6",
            "verseOrgIds": [
              "EXO.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Aroni anofanira kupisa zvinonhuhwira pamusoro pearitari mangwanani oga oga paanogadzira mwenje.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.7",
            "verseOrgIds": [
              "EXO.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anofanira kupisazve zvinonhuhwira paanenge achitungidza mwenje zuva richangovira saka zvinonhuhwira zvinofanira kupiswa nguva dzose pamberi paJehovha kusvikira kuzvizvarwa zvinotevera.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.8",
            "verseOrgIds": [
              "EXO.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musapisira pamusoro pearitari iyi zvimwewo zvazvo zvinonhuhwira kana zvipiriso zvipi zvazvo zvinopiswa kana zvipiriso zvezviyo, uye musadururire chipiriso chinonwiwa pamusoro payo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.9",
            "verseOrgIds": [
              "EXO.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni achaita yananiso panyanga idzi kamwe chete pagore. Yananiso yapagore iyi inofanira kuitwa neropa rokuyananisa rechipiriso chechivi kusvikira kuzvizvarwa zvinotevera. Chitsvene-tsvene kuna Jehovha.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.10",
            "verseOrgIds": [
              "EXO.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mari yeYananiso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akati kuna Mozisi,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.11",
            "verseOrgIds": [
              "EXO.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Paunoverenga vaIsraeri kuti uvanyore, mumwe nomumwe anofanira kupa Jehovha rudzikinuro rwoupenyu hwake panguva yaanoverengwa. Ipapo hapana denda richazouya pamusoro pavo paunovaverenga.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.12",
            "verseOrgIds": [
              "EXO.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe nomumwe anoyambukira kuna avo vatoverengwa anofanira kupa hafu yeshekeri",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.13",
            "verseOrgIds": [
              "EXO.30.13"
            ]
          }
        },
        {
          "text": ", zvichienderana neshekeri renzvimbo tsvene, rinorema magera makumi maviri. Hafu yeshekeri iyi chipiriso kuna Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.13",
            "verseOrgIds": [
              "EXO.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vose vanoyambuka, vaya vana makore makumi maviri kana anopfuura iwayo, vanofanira kupa chipiriso kuna Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.14",
            "verseOrgIds": [
              "EXO.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vapfumi havafaniri kupa zvinopfuura hafu yeshekeri uye varombo havafaniri kupa zvishoma pamunoita chipiriso kuna Jehovha kuti muyananiswe upenyu hwenyu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.15",
            "verseOrgIds": [
              "EXO.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugamuchire mari yeyananiso kubva kuvaIsraeri ugoishandisa paushumiri hweTende Rokusangana. Chichava chirangaridzo kuvaIsraeri pamberi paJehovha, muchiyananisira upenyu hwenyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.16",
            "verseOrgIds": [
              "EXO.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mudziyo woKushambira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akati kuna Mozisi,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.17",
            "verseOrgIds": [
              "EXO.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uite mudziyo wokushambira wendarira, nechigadziko chawo chendarira. Ugouisa pakati peTende Rokusangana nearitari uye ugoisa mvura mauri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.18",
            "verseOrgIds": [
              "EXO.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni navanakomana vake vanofanira kushamba maoko avo netsoka dzavo nemvura.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.19",
            "verseOrgIds": [
              "EXO.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pose pavachapinda muTende Rokusangana vachashamba kuitira kuti varege kufa. Uyezve, pavanoswedera paaritari kuti vazoshumira nokupa chipiriso chinoitirwa Jehovha nomoto,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.20",
            "verseOrgIds": [
              "EXO.30.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "vachashamba maoko avo netsoka dzavo kuitira kuti varege kufa. Uyu unofanira kuva mutemo usingaperi waAroni nezvizvarwa zvake kusvikira kuzvizvarwa zvinotevera.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.21",
            "verseOrgIds": [
              "EXO.30.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mafuta oKuzodza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akati kuna Mozisi,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.22",
            "verseOrgIds": [
              "EXO.30.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tora zvinonhuhwira zvinotevera izvi: mazana mashanu amashekeri",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.23",
            "verseOrgIds": [
              "EXO.30.23"
            ]
          }
        },
        {
          "text": "emura inoerera, hafu yakadaro (ndiwo mazana maviri namakumi mashanu amashekeri) ezvinonhuhwira zvesinamoni, mazana maviri namakumi mashanu enzimbe,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.23",
            "verseOrgIds": [
              "EXO.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "mashekeri omuunga mazana mashanu, zvose zvichienderana neshekeri renzvimbo tsvene, nehini",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.24",
            "verseOrgIds": [
              "EXO.30.24"
            ]
          }
        },
        {
          "text": "yamafuta omuorivhi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.24",
            "verseOrgIds": [
              "EXO.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vhenganisa izvi kuti zvive mafuta matsvene okuzodza, anonhuhwira akavhenganiswa, basa romuvhenganisi wezvinonhuhwira. Achava mafuta matsvene okuzodza.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.25",
            "verseOrgIds": [
              "EXO.30.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ugoashandisa kuzodza Tende Rokusangana, neareka yeChipupuriro,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.26",
            "verseOrgIds": [
              "EXO.30.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "tafura nemidziyo yayo yose, chigadziko chomwenje nenhumbi dzacho dzose, aritari yezvinonhuhwira,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.27",
            "verseOrgIds": [
              "EXO.30.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 30:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "aritari yezvipiriso zvinopiswa nemidziyo yayo, uye mudziyo wokushambira nechigadziko chawo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.28",
            "verseOrgIds": [
              "EXO.30.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 30:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unofanira kuzvitsaura kuti zvigova zvitsvene-tsvene, uye zvose zvichazvigunzva zvichava zvitsvene.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.29",
            "verseOrgIds": [
              "EXO.30.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 30:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uzodze Aroni navanakomana vake uye uvatsaure kuitira kuti vagondishandira savaprista.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.30",
            "verseOrgIds": [
              "EXO.30.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 30:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uti kuvaIsraeri, 'Aya achava mafuta angu matsvene okuzodza kuzvizvarwa zvinotevera.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.31",
            "verseOrgIds": [
              "EXO.30.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 30:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musaadira pamiviri yavanhu uye musaita mafuta api zvawo nenzira imwe cheteyo. Matsvene, uye munofanira kuaita matsvene.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.32",
            "verseOrgIds": [
              "EXO.30.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 30:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani naani anoita mafuta anonhuhwira akafanana nawo uye ani naani anoaisa pamunhu upi zvake kunze kwomuprista anofanira kubviswa pakati pavanhu vokwake.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.33",
            "verseOrgIds": [
              "EXO.30.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zvinonhuhwira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 30:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akati kuna Mozisi, \"Tora zvinonhuhwira zvinoti sitaketi, onika negaribhanamu, uye zvinonhuhwira zvakaisvonaka, zvose zvakaenzana,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.34",
            "verseOrgIds": [
              "EXO.30.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 30:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye ugoita zvinonhuhwira zvakavhenganiswa, basa romuvhenganisi wezvinonhuhwira. Zvinofanira kurungwa nomunyu, uye zvitsvene.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.35",
            "verseOrgIds": [
              "EXO.30.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 30:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukuye zvimwe zvacho zvive upfu ugozviisa pamberi peChipupuriro chiri muTende Rokusangana, umo mandichasangana newe. Zvichava zvitsvene-tsvene kwauri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.36",
            "verseOrgIds": [
              "EXO.30.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 30:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usazviitira zvinonhuhwira zvipi zvazvo nenzira imwe cheteyo; uzvicherechedze kuti zvitsvene kuna Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.37",
            "verseOrgIds": [
              "EXO.30.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 30:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani naani achaita chipi zvacho chakafanana nacho kuti afadzwe nokunhuhwira kwacho, anofanira kubviswa pakati pavanhu vokwake.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.38",
            "verseOrgIds": [
              "EXO.30.38"
            ]
          }
        }
      ]
    }
