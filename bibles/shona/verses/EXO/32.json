  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "32",
        "style": "c",
        "sid": "EXO 32"
      },
      "items": [
        {
          "text": "32",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mhuru yegoridhe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vakati vaona kuti Mozisi akanga anonoka kwazvo kuburuka kubva mugomo, vakaungana pana Aroni vakati, \"Uya, tiitire vamwari vachatitungamirira. Kana ari munhu uyu Mozisi akatibudisa muIjipiti, hatizivi zvakaitika kwaari.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.1",
            "verseOrgIds": [
              "EXO.32.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni akavapindura akati, \"Bvisai mhete dzegoridhe dzakapfekwa navakadzi venyu, vanakomana venyu navanasikana venyu mugouya nadzo kwandiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.2",
            "verseOrgIds": [
              "EXO.32.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vanhu vose vakabvisa mhete dzavo vakauya nadzo kuna Aroni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.3",
            "verseOrgIds": [
              "EXO.32.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatora zvavakamupa akaita nazvo chifananidzo chakaumbwa muchimiro chemhuru, achichiveza nembezo. Ipapo vakati, \"Ava ndivo vamwari venyu, imi Israeri, vakakubudisai kubva muIjipiti.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.4",
            "verseOrgIds": [
              "EXO.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni akati aona izvi, akavaka aritari pamberi pemhuru iya akazivisa vanhu kuti, \"Mangwana kuchava nomutambo kuna Jehovha.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.5",
            "verseOrgIds": [
              "EXO.32.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka zuva rakatevera vanhu vakamuka mangwanani vakabayira zvipiriso zvinopiswa uye vakapa zvipiriso zvokuwadzana. Shure kwaizvozvo vakagara pasi vakadya, vakanwa uye vakasimuka kuti vatambe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.6",
            "verseOrgIds": [
              "EXO.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akati kuna Mozisi, \"Buruka, nokuti vanhu vako, vawakabudisa muIjipiti, vaora.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.7",
            "verseOrgIds": [
              "EXO.32.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakurumidza kutsauka pane zvandakavarayira uye vakazviitira chifananidzo chakavezwa muchimiro chemhuru. Vapfugamira pachiri uye vakabayira kwachiri uye vakati, 'Ava ndivo vamwari venyu, imi vaIsraeri, vakakubudisai kubva muIjipiti.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.8",
            "verseOrgIds": [
              "EXO.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Mozisi, \"Ndaona vanhu ava, uye vanhu vane mitsipa mikukutu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.9",
            "verseOrgIds": [
              "EXO.32.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino ndirege hangu kuti kutsamwa kwangu kupfute pamusoro pavo ndivaparadze. Ipapo iwe ndichakuita rudzi rukuru.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.10",
            "verseOrgIds": [
              "EXO.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Mozisi akatsvaka nyasha dzaJehovha Mwari wake, akati, \"Haiwa Jehovha, kutsamwa kwenyu kungapfuta seiko pamusoro pavanhu venyu, vamakabudisa kubva muIjipiti nesimba guru uye noruoko rune simba?",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.11",
            "verseOrgIds": [
              "EXO.32.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaIjipita vachataurireiko vachiti, 'Akavabudisa muIjipiti nomurangariro wakaipa, kuti avauraye mumakomo uye nokuvaparadza panyika'? Dzokai henyu pakutsamwa kwenyu kunotyisa; dzokai murege kuuyisa njodzi pamusoro pavanhu venyu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.12",
            "verseOrgIds": [
              "EXO.32.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rangarirai varanda venyu vanaAbhurahama, Isaka naIsraeri, vamakapika kwavari nemi pachenyu muchiti, 'Ndichaita kuti zvizvarwa zvenyu zviwande senyeredzi dzokudenga, uye ndichapa zvizvarwa zvenyu nyika iyi yose yandakavavimbisa, uye ichava nhaka yavo nokusingaperi.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.13",
            "verseOrgIds": [
              "EXO.32.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akazvidemba uye akarega kuuyisa njodzi yaakanga oda kuisa pamusoro pavanhu vake.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.14",
            "verseOrgIds": [
              "EXO.32.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi akadzoka akaburuka mugomo ane mahwendefa maviri eChipupuriro mumaoko ake. Akanga akanyorwa kumativi ose ari maviri, mberi neshure.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.15",
            "verseOrgIds": [
              "EXO.32.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mahwendefa aya rakanga riri basa raMwari; runyoro rwakanga rwuri runyoro rwaMwari, rwakatemwa pamahwendefa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.16",
            "verseOrgIds": [
              "EXO.32.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 32:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua akati anzwa mheremhere yavanhu vaidanidzira, akati kuna Mozisi, \"Mune ruzha rwehondo mumusasa.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.17",
            "verseOrgIds": [
              "EXO.32.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 32:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi akapindura akati,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.18",
            "verseOrgIds": [
              "EXO.32.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EXO 32:18"
      },
      "items": [
        {
          "text": "\"Harusi ruzha rwokukunda,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.18",
            "verseOrgIds": [
              "EXO.32.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 32:18"
      },
      "items": [
        {
          "text": "harusi ruzha rwokukundwa;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.18",
            "verseOrgIds": [
              "EXO.32.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 32:18"
      },
      "items": [
        {
          "text": "ruzha rwokuimba rwandinonzwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.18",
            "verseOrgIds": [
              "EXO.32.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 32:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi akati aswedera pamusasa akaona mhuru uye nokutamba, kutsamwa kwake kukavira uye akakanda mahwendefa achibva mumaoko ake, akaaputsa kuita zvidimbu zvidimbu pajinga regomo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.19",
            "verseOrgIds": [
              "EXO.32.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 32:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye akatora mhuru yavakanga vagadzira ndokuipisa nomoto; ipapo akaikuya kuita upfu, akahuparadzira pamusoro pemvura uye akaita kuti vaIsraeri vainwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.20",
            "verseOrgIds": [
              "EXO.32.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kuna Aroni, \"Ko vanhu ava vakaiteiko kwauri, zvawakavatungamirira muchivi chikuru zvakadai?\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.21",
            "verseOrgIds": [
              "EXO.32.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 32:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni akapindura akati, \"Regai kutsamwa, ishe wangu. Munoziva kuti vanhu ava vanorerekera sei pakutadza.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.22",
            "verseOrgIds": [
              "EXO.32.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 32:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati kwandiri, 'Tiitire vamwari vachatitungamirira. Kana ari munhu uyu Mozisi akatibudisa kubva muIjipiti, hatizivi zvakaitika kwaari.'",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.23",
            "verseOrgIds": [
              "EXO.32.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 32:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka ndakati kwavari, 'Ani naani ane zvishongo zvegoridhe, ngaabvise.' Ipapo vakandipa goridhe ndikarikanda mumoto, uye ndipo pakabuda mhuru iyi!\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.24",
            "verseOrgIds": [
              "EXO.32.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi akaona kuti vanhu vakanga vatopenga zvavo uye kuti Aroni akanga avarega vasisazvidzori uye kuti vakanga vava chiseko kuvavengi vavo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.25",
            "verseOrgIds": [
              "EXO.32.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 32:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka akamira pamukova wokupinda nawo mumusasa akati, \"Ani naani ari kurutivi rwaJehovha, ngaauye kwandiri.\" Uye vaRevhi vose vakaenda kwaari.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.26",
            "verseOrgIds": [
              "EXO.32.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akati kwavari, \"Zvanzi naJehovha Mwari waIsraeri, 'Murume mumwe nomumwe ngaapakate munondo parutivi rwake. Mufambe mumusasa kubva kuno rumwe rutivi kusvika kuno rumwe, mumwe nomumwe achiuraya hama yake neshamwari yake nomuvakidzani wake.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.27",
            "verseOrgIds": [
              "EXO.32.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaRevhi vakaita sezvavakarayirwa naMozisi, uye nomusi uyo vanhu zviuru zvitatu vakafa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.28",
            "verseOrgIds": [
              "EXO.32.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mozisi akati, \"Imi matsaurirwa Jehovha nhasi, nokuti makanga muchirwa navanakomana venyu uye nehama dzenyu, uye akuropafadzai nhasi.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.29",
            "verseOrgIds": [
              "EXO.32.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fume mangwana Mozisi akati kuvanhu, \"Maita chitadzo chikuru. Asi zvino ndichaenda kuna Jehovha; zvimwe ndingagona kukuitirai yananiso nokuda kwechivi chenyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.30",
            "verseOrgIds": [
              "EXO.32.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Mozisi akadzokera kuna Jehovha akati, \"Haiwa vanhu ava vaita chivi chikuru sei! Vazviitira vamwari vegoridhe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.31",
            "verseOrgIds": [
              "EXO.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi zvino, ndapota hangu varegererei chivi chavo, asi kana zvisina kudaro, ipapo ndidzimei henyu mubhuku ramakanyora.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.32",
            "verseOrgIds": [
              "EXO.32.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 32:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akapindura Mozisi akati, \"Ani naani anenge atadzirana neni ndichamudzima mubhuku rangu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.33",
            "verseOrgIds": [
              "EXO.32.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 32:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino chienda, tungamirira vanhu kunzvimbo yandakataura nezvayo, uye mutumwa wangu achakutungamirirai. Kunyange zvakadaro, nguva yokuti ndirange painosvika, ndichavaranga nokuda kwechivi chavo.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.34",
            "verseOrgIds": [
              "EXO.32.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 32:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Jehovha akarova vanhu nedenda nokuda kwezvavakaita nemhuru yakaitwa naAroni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.35",
            "verseOrgIds": [
              "EXO.32.35"
            ]
          }
        }
      ]
    }
  ],
