  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "EXO 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aritari yeZvipiriso Zvinopiswa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uvake aritari yamatanda omuunga, makubhiti matatu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.1",
            "verseOrgIds": [
              "EXO.27.1"
            ]
          }
        },
        {
          "text": "pakukwirira kwayo; inofanira kuva namativi mana akaenzana, kureba kwayo makubhiti mashanu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.1",
            "verseOrgIds": [
              "EXO.27.1"
            ]
          }
        },
        {
          "text": "uye upamhi hwayo makubhiti mashanu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.1",
            "verseOrgIds": [
              "EXO.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uite runyanga pamakona ayo mana, kuti nyanga nearitari zvive chinhu chimwe, uye ufukidze aritari nendarira.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.2",
            "verseOrgIds": [
              "EXO.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uite midziyo yayo yose nendarira, hari dzayo dzokubvisisa madota, uye foshoro dzayo, mbiya dzokusasa nadzo, zvibayiso zvenyama nemakango apamoto.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.3",
            "verseOrgIds": [
              "EXO.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyiitire chiparo, sefa yendarira, uye ugoita mhete yendarira pakona imwe neimwe yesefa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.4",
            "verseOrgIds": [
              "EXO.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uchiise pasi pechitsiko chearitari kuitira kuti chive pakati nepakati pearitari.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.5",
            "verseOrgIds": [
              "EXO.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uitire aritari matanda omuunga uye ugoafukidza nendarira.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.6",
            "verseOrgIds": [
              "EXO.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matanda aya anofanira kupinzwa mukati memhete kuti agova kumativi maviri earitari painenge yotakurwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.7",
            "verseOrgIds": [
              "EXO.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uite aritari namapuranga, isina chinhu mukati mayo. Inofanira kugadzirwa sokuratidzwa kwawakaitwa pagomo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.8",
            "verseOrgIds": [
              "EXO.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ruvazhe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uitire tabhenakeri ruvazhe. Rutivi rwezasi runofanira kureba makubhiti zana",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.9",
            "verseOrgIds": [
              "EXO.27.9"
            ]
          }
        },
        {
          "text": "uye runofanira kuva nezvidzitiro zvakarembedzwa zvomucheka wakarukwa zvakaisvonaka,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.9",
            "verseOrgIds": [
              "EXO.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "namatanda makumi maviri uye zvigadziko zvendarira makumi maviri uye zvikorekedzo zvesirivha nezvisungo pamatanda.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.10",
            "verseOrgIds": [
              "EXO.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rutivi rwokumusoro rucharebawo makubhiti zana uye runofanira kuva nezvidzitiro zvakarembedzwa, namatanda makumi maviri, nezvigadziko zvendarira makumi maviri, uye zvikorekedzo zvesirivha nezvisungo pamatanda.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.11",
            "verseOrgIds": [
              "EXO.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kumucheto kworuvazhe, nechokumavirira, kunofanira kuva noupamhi hwamakubhiti makumi mashanu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.12",
            "verseOrgIds": [
              "EXO.27.12"
            ]
          }
        },
        {
          "text": "uye zvidzitiro zvakarembedzwa, namatanda gumi uye zvigadziko gumi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.12",
            "verseOrgIds": [
              "EXO.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumucheto nechokumabvazuva kwakatarisana nokunobuda nezuva, upamhi hworuvazhe hunofanira kuva makubhiti makumi mashanu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.13",
            "verseOrgIds": [
              "EXO.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvidzitiro zvakareba makubhiti gumi namashanu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.14",
            "verseOrgIds": [
              "EXO.27.14"
            ]
          }
        },
        {
          "text": "zvinofanira kuva kuno rumwe rutivi rwomukova, namatanda matatu nezvigadziko zvitatu,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.14",
            "verseOrgIds": [
              "EXO.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye zvimwe zvidzitiro zvakareba makubhiti gumi namashanu ngazvivewo kuno rumwe rutivi, namatanda matatu nezvigadziko zvitatuwo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.15",
            "verseOrgIds": [
              "EXO.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pamukova wokupinda muruvazhe, uise chidzitiro chakareba makubhiti makumi maviri",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.16",
            "verseOrgIds": [
              "EXO.27.16"
            ]
          }
        },
        {
          "text": ", chewuru yebhuruu, yepepuru netsvuku uye nomucheka wakarukwa zvakaisvonaka, basa romusoni anogona, namatanda mana uyewo zvigadziko zvina.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.16",
            "verseOrgIds": [
              "EXO.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matanda ose akapoteredza ruvazhe anofanira kuva nezvisungiso zvesirivha nezvikorekedzo, uye zvigadziko zvendarira.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.17",
            "verseOrgIds": [
              "EXO.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruvazhe ruchareba makubhiti zana",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.18",
            "verseOrgIds": [
              "EXO.27.18"
            ]
          }
        },
        {
          "text": "uye makubhiti makumi mashanu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.18",
            "verseOrgIds": [
              "EXO.27.18"
            ]
          }
        },
        {
          "text": "paupamhi, nezvidzitiro zvemicheka yakarukwa zvakaisvonaka yakareba makubhiti mashanu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.18",
            "verseOrgIds": [
              "EXO.27.18"
            ]
          }
        },
        {
          "text": ", uye nezvigadziko zvendarira.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.18",
            "verseOrgIds": [
              "EXO.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mimwe midziyo inoshandiswa paushumiri hwetabhenakeri, ringava basa ripi zvaro, kusanganisira mbambo dzose dzetende neiya yomuruvazhe, inofanira kuva yendarira.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.19",
            "verseOrgIds": [
              "EXO.27.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mafuta eChigadziko choMwenje",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Urayire vaIsraeri kuti vakuvigire mafuta omuorivhi akachena, akasvinwa omwenje, kuitira kuti mwenje irambe ichipfuta.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.20",
            "verseOrgIds": [
              "EXO.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "MuTende Rokusangana, kunze kwechidzitiro chiri pamberi peChipupuriro, Aroni navanakomana vake vanofanira kurega mwenje ichiramba ichipfuta pamberi paJehovha, kubva madekwana kusvikira mangwanani. Uyu unofanira kuva mutemo usingaperi pakati pavaIsraeri nokuzvizvarwa zvinotevera.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.21",
            "verseOrgIds": [
              "EXO.27.21"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "EXO.28",
    "number": "28",
