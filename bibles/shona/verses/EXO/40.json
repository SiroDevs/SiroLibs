          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukufamba kwose kwavaIsraeri, pose paisimuka gore kubva pamusoro petabhenakeri, ivo vaisimuka vachienda;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.36",
            "verseOrgIds": [
              "EXO.40.36"
            ]
