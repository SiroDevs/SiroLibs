          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi kana gore risina kubva, vakanga vasingafambi, kusvikira pazuva rarinosimuka.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.37",
