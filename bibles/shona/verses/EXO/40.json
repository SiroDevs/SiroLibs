        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kudzika Tabhenakeri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 40:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akati kuna Mozisi,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.1",
            "verseOrgIds": [
              "EXO.40.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 40:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Dzika tabhenakeri, Tende Rokusangana, pazuva rokutanga romwedzi wokutanga.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.2",
            "verseOrgIds": [
              "EXO.40.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 40:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uise areka yeChipupuriro mairi uye ugofukidza areka nechidzitiro.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.3",
            "verseOrgIds": [
              "EXO.40.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 40:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Upinze tafura ugoisa zvinhu zvayo pairi. Ipapo ugopinza chigadziko chomwenje ugomisa mwenje yacho.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.4",
            "verseOrgIds": [
              "EXO.40.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 40:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uise aritari yezvinonhuhwira yegoridhe pamberi peareka yechipupuriro uye ugoisa chidzitiro pamukova wokupinda mutabhenakeri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.5",
            "verseOrgIds": [
              "EXO.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 40:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uise aritari yezvipiriso zvinopiswa pamberi pomukova wokupinda kutabhenakeri, Tende Rokusangana;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.6",
            "verseOrgIds": [
              "EXO.40.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 40:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "uise dhishi pakati peTende Rokusangana nearitari ugoisa mvura mariri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.7",
            "verseOrgIds": [
              "EXO.40.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugadzire ruvazhe rwakaipoteredza uye ugoisa chidzitiro pamukova woruvazhe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.8",
            "verseOrgIds": [
              "EXO.40.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 40:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Utore mafuta okuzodza ugozodza tabhenakeri nezvinhu zvose zvirimo; uinatse nemidziyo yayo yose, uye ichava tsvene.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.9",
            "verseOrgIds": [
              "EXO.40.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ugozodza aritari yezvipiriso zvinopiswa nemidziyo yayo yose; unatse aritari, uye ichava tsvene-tsvene.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.10",
            "verseOrgIds": [
              "EXO.40.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 40:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzodze dhishi nechigadziko charo ugozvinatsa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.11",
            "verseOrgIds": [
              "EXO.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uuye naAroni navanakomana vake kumukova weTende Rokusangana ugovashambidza nemvura.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.12",
            "verseOrgIds": [
              "EXO.40.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ugopfekedza Aroni nguo tsvene, umuzodze uye ugomunatsa kuti agondishumira somuprista.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.13",
            "verseOrgIds": [
              "EXO.40.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uuyise vanakomana vake ugovapfekedza majasi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.14",
            "verseOrgIds": [
              "EXO.40.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uvazodze sokuzodza kwawaita baba vavo, kuti vagondishumira savaprista. Kuzodzwa kwavo kuchava kwouprista hucharamba huripo kuzvizvarwa zvinotevera.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.15",
            "verseOrgIds": [
              "EXO.40.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi akaita zvose sezvaakarayirwa naJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.16",
            "verseOrgIds": [
              "EXO.40.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 40:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka tabhenakeri yakamiswa pazuva rokutanga romwedzi wokutanga mugore rechipiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.17",
            "verseOrgIds": [
              "EXO.40.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 40:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi akati amisa tabhenakeri, akaisa zvigadziko panzvimbo yazvo, akadzika mapuranga, akapinza mbariro uye akamisa matanda.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.18",
            "verseOrgIds": [
              "EXO.40.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 40:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akatambanudza tende akariisa pamusoro petabhenakeri ndokuisa chifukidzo pamusoro petende, sokurayirwa kwaakaitwa naJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.19",
            "verseOrgIds": [
              "EXO.40.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 40:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatora Chipupuriro akachiisa muareka, akabatanidza mapango paareka uye akaisa chifunhiro chokuyananisa pamusoro payo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.20",
            "verseOrgIds": [
              "EXO.40.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 40:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akauyisa areka mutabhenakeri ndokuturika chidzitiro chokufukidzira akafukidza areka yeChipupuriro, sokurayira kwakaita Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.21",
            "verseOrgIds": [
              "EXO.40.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 40:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi akaisa tafura muTende Rokusangana nechokurutivi rwokumusoro kwetabhenakeri kunze kwechidzitiro",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.22",
            "verseOrgIds": [
              "EXO.40.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 40:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye akaisa chingwa pamusoro payo pamberi paJehovha, sokurayirwa kwaakaitwa naJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.23",
            "verseOrgIds": [
              "EXO.40.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 40:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaisa chigadziko chomwenje muTende Rokusangana chakatarisana netafura nechokurutivi rwezasi rwetabhenakeri",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.24",
            "verseOrgIds": [
              "EXO.40.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 40:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye akamisa mwenje pamberi paJehovha, sokurayirwa kwaakaitwa naJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.25",
            "verseOrgIds": [
              "EXO.40.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 40:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi akaisa aritari yegoridhe muTende Rokusangana pamberi pechidzitiro,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.26",
            "verseOrgIds": [
              "EXO.40.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 40:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye akapisa zvinonhuhwira pairi, sokurayirwa kwaakaitwa naJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.27",
            "verseOrgIds": [
              "EXO.40.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 40:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akaisa chidzitiro pamukova wetabhenakeri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.28",
            "verseOrgIds": [
              "EXO.40.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 40:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamisa aritari yezvipiriso zvinopiswa pedyo nomukova wetabhenakeri, Tende Rokusangana, akapa pairi zvipiriso zvinopiswa nezvipiriso zvezviyo, sokurayirwa kwaakaitwa naJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.29",
            "verseOrgIds": [
              "EXO.40.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 40:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaisa dhishi pakati peTende Rokusangana nearitari uye akaisa mvura yokushamba mariri,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.30",
            "verseOrgIds": [
              "EXO.40.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 40:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye Mozisi naAroni navanakomana vake vakaishandisa kushamba maoko avo netsoka dzavo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.31",
            "verseOrgIds": [
              "EXO.40.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 40:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaishamba pose pavaipinda muTende Rokusangana kana kuswedera paaritari, sokurayirwa kwakaitwa Mozisi naJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.32",
            "verseOrgIds": [
              "EXO.40.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 40:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mozisi akaita ruvazhe rwakapoteredza tabhenakeri nearitari uye akaturika chidzitiro pamukova wokupinda muruvazhe. Nokudaro Mozisi akapedza basa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.33",
            "verseOrgIds": [
