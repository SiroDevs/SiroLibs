              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo gore rakafukidza Tende Rokusangana, uye kubwinya kwaJehovha kwakazadza tabhenakeri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.34",
            "verseOrgIds": [
