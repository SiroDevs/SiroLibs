              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi haana kugona kupinda muTende Rokusangana nokuti gore rakanga ragara pariri, uye kubwinya kwaJehovha kwakazadza tabhenakeri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.35",
            "verseOrgIds": [
              "EXO.40.35"
