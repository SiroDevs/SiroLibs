      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ninevhe rine nhamo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NAM 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rine nhamo guta reropa,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.1",
            "verseOrgIds": [
              "NAM.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:1"
      },
      "items": [
        {
          "text": "rizere nenhema,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.1",
            "verseOrgIds": [
              "NAM.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 3:1"
      },
      "items": [
        {
          "text": "rizere nezvakapambwa,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.1",
            "verseOrgIds": [
              "NAM.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:1"
      },
      "items": [
        {
          "text": "harigari risina varinotambudza!",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.1",
            "verseOrgIds": [
              "NAM.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NAM 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurira kwetyava,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.2",
            "verseOrgIds": [
              "NAM.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:2"
      },
      "items": [
        {
          "text": "utsvikitsviki hwamavhiri,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.2",
            "verseOrgIds": [
              "NAM.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 3:2"
      },
      "items": [
        {
          "text": "mutsindo wamabhiza",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.2",
            "verseOrgIds": [
              "NAM.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:2"
      },
      "items": [
        {
          "text": "nomubvumo wokutinhira kwengoro!",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.2",
            "verseOrgIds": [
              "NAM.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NAM 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumhanya kwavatasvi vamabhiza,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.3",
            "verseOrgIds": [
              "NAM.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:3"
      },
      "items": [
        {
          "text": "kupenya kweminondo",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.3",
            "verseOrgIds": [
              "NAM.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:3"
      },
      "items": [
        {
          "text": "namapfumo anovaima!",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.3",
            "verseOrgIds": [
              "NAM.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 3:3"
      },
      "items": [
        {
          "text": "Vazhinji vakaurayiwa,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.3",
            "verseOrgIds": [
              "NAM.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:3"
      },
      "items": [
        {
          "text": "mirwi yevakafa,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.3",
            "verseOrgIds": [
              "NAM.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 3:3"
      },
      "items": [
        {
          "text": "mitumbi isingaverengeki,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.3",
            "verseOrgIds": [
              "NAM.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:3"
      },
      "items": [
        {
          "text": "vanhu vachigumburwa nezvitunha.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.3",
            "verseOrgIds": [
              "NAM.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NAM 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvose izvi nokuda kwokuchiva kuzhinji kwechifeve,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.4",
            "verseOrgIds": [
              "NAM.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:4"
      },
      "items": [
        {
          "text": "chinokwezvera, mukuru wouroyi,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.4",
            "verseOrgIds": [
              "NAM.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 3:4"
      },
      "items": [
        {
          "text": "akatapa ndudzi noufeve hwake",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.4",
            "verseOrgIds": [
              "NAM.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:4"
      },
      "items": [
        {
          "text": "namarudzi avanhu nouroyi hwake.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.4",
            "verseOrgIds": [
              "NAM.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NAM 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndine mhaka newe,\" ndizvo zvinotaura Jehovha Wamasimba Ose.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.5",
            "verseOrgIds": [
              "NAM.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:5"
      },
      "items": [
        {
          "text": "Ndichafukura nguo yako ifukidze chiso chako",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.5",
            "verseOrgIds": [
              "NAM.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 3:5"
      },
      "items": [
        {
          "text": "\"Ndicharatidza ndudzi kushama kwako",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.5",
            "verseOrgIds": [
              "NAM.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:5"
      },
      "items": [
        {
          "text": "namadzimambo kunyadziswa kwako.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.5",
            "verseOrgIds": [
              "NAM.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NAM 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichakukandidzira tsvina,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.6",
            "verseOrgIds": [
              "NAM.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:6"
      },
      "items": [
        {
          "text": "ndichakuita akazvidzika",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.6",
            "verseOrgIds": [
              "NAM.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:6"
      },
      "items": [
        {
          "text": "uye ndichakuita chiseko.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.6",
            "verseOrgIds": [
              "NAM.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NAM 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vose vachakuona vachakutiza uye vachati,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.7",
            "verseOrgIds": [
              "NAM.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:7"
      },
      "items": [
        {
          "text": "'Ninevhe raparara, ndiani acharichema?'",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.7",
            "verseOrgIds": [
              "NAM.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:7"
      },
      "items": [
        {
          "text": "Ndingawana kupi munhu angakunyaradza?\"",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.7",
            "verseOrgIds": [
              "NAM.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NAM 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uri nani kupfuura Tebhesi here,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.8",
            "verseOrgIds": [
              "NAM.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:8"
      },
      "items": [
        {
          "text": "rakavakwa paNairi,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.8",
            "verseOrgIds": [
              "NAM.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:8"
      },
      "items": [
        {
          "text": "rakakomberedzwa nemvura?",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.8",
            "verseOrgIds": [
              "NAM.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 3:8"
      },
      "items": [
        {
          "text": "Rwizi ndirwo rwairidzivirira,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.8",
            "verseOrgIds": [
              "NAM.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:8"
      },
      "items": [
        {
          "text": "mvura iri rusvingo rwaro.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.8",
            "verseOrgIds": [
              "NAM.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NAM 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etiopia neIjipiti ndizvo zvaiva simba rayo guru;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.9",
            "verseOrgIds": [
              "NAM.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:9"
      },
      "items": [
        {
          "text": "Puti neRibhiya dzaiva pakati pavabatsiri vayo.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.9",
            "verseOrgIds": [
              "NAM.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NAM 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro yakatapwa",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.10",
            "verseOrgIds": [
              "NAM.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:10"
      },
      "items": [
        {
          "text": "ikaendeswa kuutapwa.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.10",
            "verseOrgIds": [
              "NAM.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 3:10"
      },
      "items": [
        {
          "text": "Vacheche varo vakaputsanyiwa",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.10",
            "verseOrgIds": [
              "NAM.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:10"
      },
      "items": [
        {
          "text": "kumavambo kwemigwagwa yose.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.10",
            "verseOrgIds": [
              "NAM.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 3:10"
      },
      "items": [
        {
          "text": "Mijenya yakakandwa pamusoro pemachinda avo,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.10",
            "verseOrgIds": [
              "NAM.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:10"
      },
      "items": [
        {
          "text": "uye vakuru vavo vakasungwa nengetani.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.10",
            "verseOrgIds": [
              "NAM.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NAM 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Newewo uchadhakwa;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.11",
            "verseOrgIds": [
              "NAM.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:11"
      },
      "items": [
        {
          "text": "uchavanda",
