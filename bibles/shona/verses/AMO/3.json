  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "AMO 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zvapupu zvinodaidzwa kuti zvizopomera Israeri mhosva",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "AMO 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzwai shoko iri rakataurwa naJehovha pamusoro penyu, imi vanhu veIsraeri, pamusoro pemhuri yose yandakabudisa kubva muIjipiti:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.1",
            "verseOrgIds": [
              "AMO.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndimi moga vandakasarudza",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.2",
            "verseOrgIds": [
              "AMO.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:2"
      },
      "items": [
        {
          "text": "pamhuri dzose dzapanyika;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.2",
            "verseOrgIds": [
              "AMO.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 3:2"
      },
      "items": [
        {
          "text": "naizvozvo ndichakurangai",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.2",
            "verseOrgIds": [
              "AMO.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:2"
      },
      "items": [
        {
          "text": "nokuda kwezvivi zvenyu zvose.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.2",
            "verseOrgIds": [
              "AMO.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, vaviri vangafamba pamwe chete",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.3",
            "verseOrgIds": [
              "AMO.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:3"
      },
      "items": [
        {
          "text": "vasina kunge vatenderana here?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.3",
            "verseOrgIds": [
              "AMO.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, shumba ingaomba mudondo",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.4",
            "verseOrgIds": [
              "AMO.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:4"
      },
      "items": [
        {
          "text": "isina chayaruma here?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.4",
            "verseOrgIds": [
              "AMO.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 3:4"
      },
      "items": [
        {
          "text": "Ko, ingarira mubako rayo isina chayabata here?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.4",
            "verseOrgIds": [
              "AMO.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, shiri ingawira pasi mumusungo",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.5",
            "verseOrgIds": [
              "AMO.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:5"
      },
      "items": [
        {
          "text": "pasina kuteyiwa rugombe here?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.5",
            "verseOrgIds": [
              "AMO.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 3:5"
      },
      "items": [
        {
          "text": "Ko, musungo ungaurukira kumusoro",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.5",
            "verseOrgIds": [
              "AMO.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:5"
      },
      "items": [
        {
          "text": "pasina chawabata here?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.5",
            "verseOrgIds": [
              "AMO.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hwamanda ingarira muguta,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.6",
            "verseOrgIds": [
              "AMO.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:6"
      },
      "items": [
        {
          "text": "vanhu vakasatya here?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.6",
            "verseOrgIds": [
              "AMO.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 3:6"
      },
      "items": [
        {
          "text": "Njodzi painowira guta,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.6",
            "verseOrgIds": [
              "AMO.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:6"
      },
      "items": [
        {
          "text": "ko, haazi Jehovha anenge azviita here?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.6",
            "verseOrgIds": [
              "AMO.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvirokwazvo, Ishe Jehovha haaiti chinhu",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.7",
            "verseOrgIds": [
              "AMO.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:7"
      },
      "items": [
        {
          "text": "asina kuzivisa varanda vake,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.7",
            "verseOrgIds": [
              "AMO.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:7"
      },
      "items": [
        {
          "text": "vaprofita, zvakavanzika zvake.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.7",
            "verseOrgIds": [
              "AMO.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shumba yaomba,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.8",
            "verseOrgIds": [
              "AMO.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:8"
      },
      "items": [
        {
          "text": "ndiani angarega kutya?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.8",
            "verseOrgIds": [
              "AMO.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 3:8"
      },
      "items": [
        {
          "text": "Ishe Jehovha ataura,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.8",
            "verseOrgIds": [
              "AMO.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:8"
      },
      "items": [
        {
          "text": "ndiani angarega kuprofita?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.8",
            "verseOrgIds": [
              "AMO.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paridzirai nhare dzeAshidhodhi",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.9",
            "verseOrgIds": [
              "AMO.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:9"
      },
      "items": [
        {
          "text": "nenhare dzeIjipiti muchiti:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.9",
            "verseOrgIds": [
              "AMO.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 3:9"
      },
      "items": [
        {
          "text": "\"Unganai pamakomo eSamaria;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.9",
            "verseOrgIds": [
              "AMO.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:9"
      },
      "items": [
        {
          "text": "onai kusagadzikana kukuru kuri mukati maro,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.9",
            "verseOrgIds": [
              "AMO.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:9"
      },
      "items": [
        {
          "text": "noudzvinyiriri huri pakati pavanhu varo.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.9",
            "verseOrgIds": [
              "AMO.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Havazivi kuita zvakarurama,\" ndizvo zvinotaura Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.10",
            "verseOrgIds": [
              "AMO.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:10"
      },
      "items": [
        {
          "text": "\"ivo vanounganidza zvakapambwa nezvakabiwa munhare dzaro.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.10",
            "verseOrgIds": [
              "AMO.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo zvanzi naIshe Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.11",
            "verseOrgIds": [
              "AMO.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 3:11"
      },
      "items": [
        {
          "text": "\"Muvengi achatora nyika; achawisira pasi nzvimbo dzako",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.11",
            "verseOrgIds": [
              "AMO.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:11"
      },
      "items": [
        {
          "text": "uye achapamba nhare dzako.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.11",
            "verseOrgIds": [
              "AMO.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvanzi naJehovha:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.12",
            "verseOrgIds": [
              "AMO.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 3:12"
      },
      "items": [
        {
          "text": "\"Mufudzi sezvaanobvuta pamuromo",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.12",
            "verseOrgIds": [
              "AMO.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:12"
      },
      "items": [
        {
          "text": "weshumba mapfupa maviri amakumbo chete kana chipandi chenzeve,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.12",
            "verseOrgIds": [
              "AMO.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:12"
      },
      "items": [
        {
          "text": "vaIsraeri vachaponeswa saizvozvowo,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.12",
            "verseOrgIds": [
              "AMO.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 3:12"
      },
      "items": [
        {
          "text": "avo vanogara muSamaria",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.12",
            "verseOrgIds": [
              "AMO.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:12"
      },
      "items": [
