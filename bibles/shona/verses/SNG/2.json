          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seruva riri pakati peminzwa,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.2",
            "verseOrgIds": [
              "SNG.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:2"
      },
      "items": [
        {
          "text": "ndizvo zvakaita mudiwa wangu pakati pemhandara.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.2",
            "verseOrgIds": [
              "SNG.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Mukadzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Somuti womuapuro pakati pemiti yesango,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.3",
            "verseOrgIds": [
              "SNG.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:3"
      },
      "items": [
        {
          "text": "ndizvo zvawakaita mudiwa wangu pakati pamajaya.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.3",
            "verseOrgIds": [
              "SNG.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 2:3"
      },
      "items": [
        {
          "text": "Ndinofarira kugara mumumvuri wake,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.3",
            "verseOrgIds": [
              "SNG.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:3"
      },
      "items": [
        {
          "text": "uye muchero wake unondinakira kuudya.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.3",
            "verseOrgIds": [
              "SNG.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaenda neni kuimba yamabiko,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.4",
            "verseOrgIds": [
              "SNG.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:4"
      },
      "items": [
        {
          "text": "uye mureza wake pamusoro pangu ndirwo rudo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.4",
            "verseOrgIds": [
              "SNG.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndisimbise namazambiringa akaomeswa,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.5",
            "verseOrgIds": [
              "SNG.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:5"
      },
      "items": [
        {
          "text": "ndisimbise namaapuro;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.5",
            "verseOrgIds": [
              "SNG.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:5"
      },
      "items": [
        {
          "text": "nokuti ndoziya norudo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.5",
            "verseOrgIds": [
              "SNG.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruoko rwake rworuboshwe rwuri pasi pomusoro wangu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.6",
            "verseOrgIds": [
              "SNG.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:6"
      },
      "items": [
        {
          "text": "uye ruoko rwake rworudyi rwakandimbundikira.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.6",
            "verseOrgIds": [
              "SNG.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imi vanasikana veJerusarema ndinokupikirai",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.7",
            "verseOrgIds": [
              "SNG.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:7"
      },
      "items": [
        {
          "text": "nemhara uye nenondo dzesango:",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.7",
            "verseOrgIds": [
              "SNG.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 2:7"
      },
      "items": [
        {
          "text": "Musazunguza kana kumutsa rudo",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.7",
            "verseOrgIds": [
              "SNG.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:7"
      },
      "items": [
        {
          "text": "kusvikira irwo rwada rwoga.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.7",
            "verseOrgIds": [
              "SNG.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzwai! Inzwi romudiwa wangu!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.8",
            "verseOrgIds": [
              "SNG.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:8"
      },
      "items": [
        {
          "text": "Tarirai! Hoyo",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.8",
            "verseOrgIds": [
              "SNG.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 2:8"
      },
      "items": [
        {
          "text": "ouya achiuruka nomumakomo,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.8",
            "verseOrgIds": [
              "SNG.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:8"
      },
      "items": [
        {
          "text": "achikwakuka nomuzvikomo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.8",
            "verseOrgIds": [
              "SNG.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mudiwa wangu akafanana nemhara",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.9",
            "verseOrgIds": [
              "SNG.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:9"
      },
      "items": [
        {
          "text": "kana netsvana yenondo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.9",
            "verseOrgIds": [
              "SNG.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 2:9"
      },
      "items": [
        {
          "text": "Tarirai! Hoyo amira seri kworusvingo rwedu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.9",
            "verseOrgIds": [
              "SNG.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:9"
      },
      "items": [
        {
          "text": "akatarira napamawindo achidongorera napamaburi apamawindo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.9",
            "verseOrgIds": [
              "SNG.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "SNG 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mudiwa wangu akataura kwandiri akati,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.10",
            "verseOrgIds": [
              "SNG.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:10"
      },
      "items": [
        {
          "text": "\"Simuka, mudiwa wangu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.10",
            "verseOrgIds": [
              "SNG.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:10"
      },
      "items": [
        {
          "text": "iwe munakunaku wangu, uya tiende tose.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.10",
            "verseOrgIds": [
              "SNG.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "SNG 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tarira! Nguva yechando yapera;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.11",
            "verseOrgIds": [
              "SNG.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:11"
      },
      "items": [
        {
          "text": "mvura yapera; uye haichanayi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.11",
            "verseOrgIds": [
              "SNG.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "SNG 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maruva oonekwa panyika;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.12",
            "verseOrgIds": [
              "SNG.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:12"
      },
      "items": [
        {
          "text": "nguva yokuimba yasvika,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.12",
            "verseOrgIds": [
              "SNG.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 2:12"
      },
      "items": [
        {
          "text": "kurira kwenjiva",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.12",
            "verseOrgIds": [
              "SNG.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:12"
      },
      "items": [
        {
          "text": "kwonzwikwa munyika yedu.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.12",
            "verseOrgIds": [
              "SNG.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "SNG 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muonde wobereka michero yawo yokutanga;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.13",
            "verseOrgIds": [
              "SNG.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:13"
      },
      "items": [
        {
          "text": "uye mizambiringa yotunga maruva ayo anonhuhwira kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.13",
            "verseOrgIds": [
              "SNG.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 2:13"
      },
      "items": [
        {
          "text": "Simuka, uya, mudiwa wangu;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.13",
            "verseOrgIds": [
              "SNG.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:13"
      },
      "items": [
        {
          "text": "munakunaku wangu, uya tiende tose.\"",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.13",
            "verseOrgIds": [
              "SNG.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
