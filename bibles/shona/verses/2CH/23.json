  "reference": "2 Makoronike 23",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "2CH 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugore rechinomwe Jehoyadha akaratidza simba rake. Akaita sungano navatungamiri vamapoka amazana: Azaria mwanakomana waJerohamu, Ishumaeri mwanakomana waJehohanani, Azaria mwanakomana waObhedhi, Maaseya mwanakomana waAdhaya naErishafati mwanakomana waZikiri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.1",
            "verseOrgIds": [
              "2CH.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaenda muJudha yose vakandokokorodza vaRevhi navakuru vemhuri dzavaIsraeri kubva kumaguta ose. Pavakauya kuJerusarema,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.2",
            "verseOrgIds": [
              "2CH.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ungano yose yakaita sungano namambo patemberi yaMwari.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.3",
            "verseOrgIds": [
              "2CH.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 23:3"
      },
      "items": [
        {
          "text": "Jehoyadha akati kwavari, \"Mwanakomana wamambo achatonga sokuvimbisa kwakaita Jehovha maererano nezvizvarwa zvaDhavhidhi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.3",
            "verseOrgIds": [
              "2CH.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino izvi ndizvo zvamunofanira kuita: Chikamu chimwe chete muzvitatu chenyu vaprista navaRevhi vanoshanda neSabata vanofanira kurinda mikova,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.4",
            "verseOrgIds": [
              "2CH.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "chikamu chimwe chete muzvitatu pakati penyu kumuzinda wamambo, nechikamu chimwe chete kubva muzvitatu pakati penyu pasuo renheyo, uye vamwe varume vose vanofanira kuva muzvivanze zvetemberi yaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.5",
            "verseOrgIds": [
              "2CH.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hapana anofanira kupinda mutemberi yaJehovha kunze kwavaprista navaRevhi vanenge vari pabasa, vanokwanisa kupinda havo nokuti ivo vakanatswa. Asi vamwe varume vose vanofanira kuchengetedza basa ravakapiwa naJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.6",
            "verseOrgIds": [
              "2CH.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaRevhi vanofanira kumira vakakomba mambo, murume mumwe nomumwe aine zvombo zvake muruoko rwake. Ani naani zvake anopinda mutemberi anofanira kuurayiwa. Garai pedyo namambo kwose kwaanoenda.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.7",
            "verseOrgIds": [
              "2CH.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaRevhi navarume vose veJudha vakaita sezvavakanga varayirwa naJehoyadha muprista. Mumwe nomumwe akatora vanhu vake vaifanira kupinda pabasa nokuti Jehoyadha muprista akanga asina kusunungura boka ripi zvaro.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.8",
            "verseOrgIds": [
              "2CH.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akapa vakuru vamapoka amazana mapfumo nenhoo huru nediki dzaiva dzaMambo Dhavhidhi dzaiva mutemberi yaMwari.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.9",
            "verseOrgIds": [
              "2CH.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamisa varume vose panzvimbo, mumwe nomumwe aine chombo chake muruoko rwake, vakakomberedza mambo, pedyo nearitari netemberi, kubva kurutivi rwezasi kusvika kurutivi rwokumusoro kwetemberi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.10",
            "verseOrgIds": [
              "2CH.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoyadha navanakomana vake vakaburitsa mwanakomana wamambo vakaisa korona paari, vakamupa gwaro resungano vakamugadza samambo. Vakamuzodza vakadaidzira vachiti, \"Mambo ngaararame kwamakore akawanda!\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.11",
            "verseOrgIds": [
              "2CH.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ataria paakanzwa ruzha rwavanhu vaimhanya vachipemberera mambo, akaenda kwavari patemberi yaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.12",
            "verseOrgIds": [
              "2CH.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatarisa, akaona mambo akamira pambiru yake pavanopinda napo. Vakuru navaridzi vehwamanda vakanga vamire namambo. Uye vanhu vose venyika vakanga vachipembera vachiridza hwamanda uye vaimbi vaine zviridzwa vaitungamirira mukurumbidza. Ipapo Ataria akabvarura nguo dzake akadanidzira achiti, \"Ndamukirwa! Ndamukirwa!\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.13",
            "verseOrgIds": [
              "2CH.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoyadha muprista akatuma vakuru vamapoka ezana, vaitungamirira varwi akati kwavari, \"Muburitsei kunze pakati pavanhu, uye muuraye ani naani anenge amutevera.\" Nokuti muprista akanga ati, \"Musamuurayire patemberi yaJehovha.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.14",
            "verseOrgIds": [
              "2CH.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakamubata paakasvika pamukova weSuo Ramabhiza pachivanze chomuzinda uye ipapo vakamuuraya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.15",
            "verseOrgIds": [
              "2CH.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehoyadha akaita sungano yokuti iye navanhu namambo vachava vanhu vaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.16",
            "verseOrgIds": [
              "2CH.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vose vakaenda kutemberi yaBhaari vakandoiparadza, vakaputsa aritari nezvifananidzo vakauraya Matani muprista waBhaari pamberi pearitari.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.17",
            "verseOrgIds": [
              "2CH.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehoyadha akaisa temberi yaJehovha mumaoko avaprista, vaiva vaRevhi vakanga vapiwa mabasa naDhavhidhi, omutemberi, okupisira zvipiriso zvinopiswa zvaJehovha sezvazvakanyorwa muMurayiro waMozisi, vachifara uye vachiimba, sokurayira kwakanga kwaitwa naDhavhidhi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.18",
            "verseOrgIds": [
              "2CH.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamisazve vachengeti vamasuo pamasuo etemberi yaJehovha kuitira kuti pasawana uyo akanga asina kuchena nenzira ipi zvayo angapinda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.19",
            "verseOrgIds": [
              "2CH.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaenda navatungamiri vamazana, makurukota navatongi vavanhu navanhu vose venyika vakandotora mambo kubva kutemberi yaJehovha. Vakapinda mumuzinda neSuo Rokumusoro vakagarisa mambo pachigaro choumambo,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.20",
            "verseOrgIds": [
              "2CH.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "vanhu vose vomunyika vakapembera. Uye guta rakava norunyararo nokuti Ataria akanga aurayiwa nomunondo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.21",
            "verseOrgIds": [
              "2CH.23.21"
            ]
          }
        }
      ]
    }
  ],
