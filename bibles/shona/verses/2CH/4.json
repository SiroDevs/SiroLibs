        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Midziyo yomuTemberi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akavaka aritari yendarira yakanga yakareba makubhiti makumi maviri",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.1",
            "verseOrgIds": [
              "2CH.4.1"
            ]
          }
        },
        {
          "text": ", uye upamhi hwayo hwaiva makubhiti makumi maviri uye yakareba makubhiti gumi",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.1",
            "verseOrgIds": [
              "2CH.4.1"
            ]
          }
        },
        {
          "text": "kuenda mudenga.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.1",
            "verseOrgIds": [
              "2CH.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaita Gungwa resimbi, rakatenderera pakuvakwa kwaro, rakareba makubhiti gumi pamuromo waro kubva kune rumwe rutivi kusvika kune rumwe rutivi uye makubhiti mashanu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.2",
            "verseOrgIds": [
              "2CH.4.2"
            ]
          }
        },
        {
          "text": "kuenda mudenga. Zvaida tambo yakareba makubhiti makumi matatu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.2",
            "verseOrgIds": [
              "2CH.4.2"
            ]
          }
        },
        {
          "text": "kuti ikwanise kupoteredza gungwa iri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.2",
            "verseOrgIds": [
              "2CH.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazasi pomuromo, zvifananidzo zvehando zvairipoteredza, zviri gumi pakubhiti rimwe chete",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.3",
            "verseOrgIds": [
              "2CH.4.3"
            ]
          }
        },
        {
          "text": ". Hando idzi dzakanga dzakaiswa mumitsara miviri dziri chinhu chimwe chete neGungwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.3",
            "verseOrgIds": [
              "2CH.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gungwa rakanga rakamira pamusoro pehando gumi nembiri, nhatu dzakatarisa kumusoro, nhatu dzakatarisa kumavirira, nhatu dzakatarisa zasi, uye nhatu dzakatarisa kumabvazuva. Gungwa rakanga rakagara pamusoro padzo uye shure kwadzo kwakanga kwakatarisa pakati.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.4",
            "verseOrgIds": [
              "2CH.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukobvu hwaro hwakanga hwakaita sokufara kwechanza",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.5",
            "verseOrgIds": [
              "2CH.4.5"
            ]
          }
        },
        {
          "text": "uye muromo waro wakanga wakaita somuromo womukombe, seruva rehapa. Raizara namabhati zviuru zvitatu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.5",
            "verseOrgIds": [
              "2CH.4.5"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.5",
            "verseOrgIds": [
              "2CH.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akagadzirazve madhishi okusukira gumi akaisa mashanu kudivi rezasi, uye mashanu kudivi rokumusoro. Zvinhu zvose zvaizoshandiswa pazvipiriso zvinopiswa zvaisukirwamo, asi Gungwa raizoshandiswa navaprista pakushamba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.6",
            "verseOrgIds": [
              "2CH.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akagadzira zvigadziko zvemwenje gumi zvegoridhe, sokurayirwa kwazvakanga zvaitwa akazviisa mutemberi, zvishanu akaisa zasi zvishanu kumusoro.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.7",
            "verseOrgIds": [
              "2CH.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akagadzira tafura gumi akadziisa mutemberi, shanu zasi uye shanu kumusoro. Akagadzirawo mbiya dzegoridhe zana dzokusasa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.8",
            "verseOrgIds": [
              "2CH.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akagadzira chivanze chavaprista, nechivanze chikuru nemikova yechivanze uye akafukidza mikova nendarira.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.9",
            "verseOrgIds": [
              "2CH.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaisa Gungwa kudivi rezasi, pakona yezasi yakadziva kumabvazuva.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.10",
            "verseOrgIds": [
              "2CH.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akagadzirazve hari nefoshoro nembiya dzokusasa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.11",
            "verseOrgIds": [
              "2CH.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 4:11"
      },
      "items": [
        {
          "text": "Saka Hurami akapedza basa raakaitira mambo Soromoni mutemberi yaMwari sezvinotevera:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.11",
            "verseOrgIds": [
              "2CH.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbiru mbiri;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.12",
            "verseOrgIds": [
              "2CH.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2CH 4:12"
      },
      "items": [
        {
          "text": "misoro miviri yakanga yakaumbwa sembiya pamusoro pembiru;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.12",
            "verseOrgIds": [
              "2CH.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2CH 4:12"
      },
      "items": [
        {
          "text": "mimbure miviri yakanga yakashongedza misoro miviri yakanga yakaumbwa pamusoro pembiru;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.12",
            "verseOrgIds": [
              "2CH.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matamba mazana mana emimbure miviri nemimwe yakanga yakashongedza misoro yakanga yakaumbwa sembiya pamisoro yembiru;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.13",
            "verseOrgIds": [
              "2CH.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "zvigadziko namadhishi azvo;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.14",
            "verseOrgIds": [
              "2CH.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gungwa nehando gumi nembiri pasi paro;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.15",
            "verseOrgIds": [
              "2CH.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "hari, foshoro, forogo dzenyama, nemimwe midziyo yose.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.16",
            "verseOrgIds": [
              "2CH.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "2CH 4:16"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 4:16"
      },
      "items": [
        {
          "text": "Zvinhu zvose zvakagadzirwa naHurami-Abhi zvamambo Soromoni zvetemberi yaJehovha zvaiva zvendarira inobwinya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.16",
            "verseOrgIds": [
              "2CH.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akaita kuti zviumbwe nevhu mubani reJorodhani pakati peSukoti neZaretani.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.17",
            "verseOrgIds": [
              "2CH.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvinhu izvi zvose zvakagadzirwa naSoromoni zvakanga zvakawanda kwazvo zvokuti uremu hwendarira yakashandiswa hwakanga husingaverengeki.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.18",
            "verseOrgIds": [
              "2CH.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soromoni akagadzirazve midziyo yose yakanga iri mutemberi yaMwari yaiti:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.19",
            "verseOrgIds": [
              "2CH.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "2CH 4:19"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2CH 4:19"
      },
      "items": [
        {
          "text": "aritari yegoridhe;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.19",
            "verseOrgIds": [
              "2CH.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2CH 4:19"
      },
      "items": [
        {
          "text": "tafura dzaiva nechingwa choKuratidza;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.19",
            "verseOrgIds": [
              "2CH.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "zvigadziko zvemwenje zvegoridhe nemwenje yazvo kuti ipfute pamberi penzvimbo tsvene yomukati sezvakarayirwa;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.20",
            "verseOrgIds": [
              "2CH.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "maruva egoridhe nemwenje nembato (dzaiva dzegoridhe chairo);",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.21",
            "verseOrgIds": [
              "2CH.4.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "zvidzimiso zvemwenje, mbiya dzokusasa, madhishi nezvaenga zvomoto zvegoridhe yakaisvonaka namakonhi egoridhe, etemberi: makonhi omukati yapaNzvimbo Tsvene-tsvene namakonhi eimba huru.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.22",
            "verseOrgIds": [
              "2CH.4.22"
            ]
          }
        }
      ]
    }
  ],
