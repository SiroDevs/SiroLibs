{
  "id": "2CH.10",
  "number": "10",
  "bookId": "2CH",
  "reference": "2 Makoronike 10",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "2CH 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Israeri inopandukira Rehobhoamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehobhoamu akaenda kuShekemu, nokuti vaIsraeri vose vakanga vaenda ikoko kundomuita mambo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.1",
            "verseOrgIds": [
              "2CH.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jerobhoamu mwanakomana waNebhati paakanzwa izvi (aiva kuIjipiti, kwaakanga aenda achitiza Mambo Soromoni), akadzoka kubva kuIjipiti.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.2",
            "verseOrgIds": [
              "2CH.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakandodana Jerobhoamu, uye iye neIsraeri yose vakaenda kuna Rehobhoamu vakati kwaari,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.3",
            "verseOrgIds": [
              "2CH.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Baba vako vakatitakudza joko rinorema kwazvo, asi zvino chitapudzai kushanda kwakaomarara nejoko rinorema ravakaisa patiri, uye isu tichakushandirai.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.4",
            "verseOrgIds": [
              "2CH.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehobhoamu akapindura akati, \"Dzokai kwandiri mumazuva matatu.\" Saka vanhu vakaenda havo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.5",
            "verseOrgIds": [
              "2CH.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mambo Rehobhoamu akandobvunza vakuru vaisishandira baba vake Soromoni panguva yavakanga vari vapenyu. Akavabvunza achiti, \"Ko, izano ripi ramungandipa kuti ndipindure vanhu ava?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.6",
            "verseOrgIds": [
              "2CH.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakamupindura vakati, \"Kana mukaitira vanhu ava tsitsi mukavafadza mukavapa mhinduro yakanaka vacharamba vari varanda venyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.7",
            "verseOrgIds": [
              "2CH.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Rehobhoamu akaramba zano iri raakapiwa navakuru akandobvunza majaya aakanga akura nawo uye vaimushandira.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.8",
            "verseOrgIds": [
              "2CH.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akavabvunza akati, \"Mungandipa zano ripi? Tingapindura sei vanhu ava vanoti kwandiri, 'Tirerutsirei joko ratakatakudzwa nababa venyu?' \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.9",
            "verseOrgIds": [
              "2CH.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Majaya aakanga akura nawo akapindura akati, \"Taurirai vanhu vakati kwamuri, 'Baba venyu vakatitakudza joko rinorema asi itai kuti joko redu rireruke,' kuti, 'Munwe wangu mudiki mukobvu kupfuura chiuno chababa vangu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.10",
            "verseOrgIds": [
              "2CH.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baba vangu vakaisa joko rinorema pamusoro penyu; ini ndichariita kuti rinyanye kurema. Baba vangu vaikurovai neshamhu; ini ndichakurovai nezvinyavada.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.11",
            "verseOrgIds": [
              "2CH.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure mamazuva matatu Jerobhoamu navanhu vose vakadzokera kuna Rehobhoamu sezvakanga zvataurwa namambo kuti, \"Dzokai kwandiri mumazuva matatu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.12",
            "verseOrgIds": [
              "2CH.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akapindura nehasha. Achiramba zano raakanga apiwa navakuru,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.13",
            "verseOrgIds": [
              "2CH.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "akateerera zano ramajaya akati, \"Baba vangu vakakurovai neshamhu ini ndichakurovai nezvinyavada.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.14",
            "verseOrgIds": [
              "2CH.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka mambo haana kuteerera kuvanhu, nokuti kuitika kwezvinhu uku kwaibva kuna Mwari, kuti shoko rakanga rataurwa naJehovha kuna Jerobhoamu mwanakomana waNebhati nomuromo waAhija muShironi rizadziswe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.15",
            "verseOrgIds": [
              "2CH.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaIsraeri vose pavakaona kuti mambo aramba kuvateerera, vakapindura mambo vachiti,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.16",
            "verseOrgIds": [
              "2CH.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2CH 10:16"
      },
      "items": [
        {
          "text": "\"Ko, tine mugove upi muna Dhavhidhi,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.16",
            "verseOrgIds": [
              "2CH.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2CH 10:16"
      },
      "items": [
        {
          "text": "chikamu chipiko mumwanakomana waJese?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.16",
            "verseOrgIds": [
              "2CH.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2CH 10:16"
      },
      "items": [
        {
          "text": "Kumatende enyu, imi Israeri!",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.16",
            "verseOrgIds": [
              "2CH.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2CH 10:16"
      },
      "items": [
        {
          "text": "Zvichengetere imba yako, iwe Dhavhidhi!\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.16",
            "verseOrgIds": [
              "2CH.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "2CH 10:16"
      },
      "items": [
        {
          "text": "Saka vaIsraeri vose vakaenda kumisha yavo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.16",
            "verseOrgIds": [
              "2CH.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vaIsraeri vaigara mumaguta eJudha, Rehobhoamu akaramba achivatonga.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.17",
            "verseOrgIds": [
              "2CH.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo Rehobhoamu akatuma Adhoniramu, aiva mukuru wavashandi vechibharo, asi vaIsraeri vakamutema namabwe kusvikira afa. Mambo Rehobhoamu akakwanisa kupinda mungoro yake akatizira kuJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.18",
            "verseOrgIds": [
              "2CH.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Israeri yakapandukira imba yaDhavhidhi kusvikira nhasi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.19",
            "verseOrgIds": [
              "2CH.10.19"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "2CH.11",
    "number": "11",
    "bookId": "2CH"
  },
