  "verseCount": 42,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "2CH 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Soromoni akati, \"Jehovha akati achagara mugore dema.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.1",
            "verseOrgIds": [
              "2CH.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakuvakirai temberi yakanaka kwazvo, nzvimbo yokuti mugare nokusingaperi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.2",
            "verseOrgIds": [
              "2CH.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungano yose yaIsraeri ichakamirapo, mambo akatendeukira kwavari akavaropafadza.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.3",
            "verseOrgIds": [
              "2CH.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akati:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.4",
            "verseOrgIds": [
              "2CH.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2CH 6:4"
      },
      "items": [
        {
          "text": "\"Ngaarumbidzwe Jehovha, Mwari waIsraeri iye azadzisa namaoko ake zvaakavimbisa nomuromo wake kuna baba vangu Dhavhidhi. Nokuti akati,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.4",
            "verseOrgIds": [
              "2CH.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Kubva pazuva randakaburitsa vanhu vangu muIjipiti, handina kumbosarudza guta murudzi rupi norupi rwaIsraeri kuti Zita rangu rivakirwe temberi kuti rivepo, uye handina kumbosarudza mumwe munhu kuti ave mutungamiri wavanhu vangu vaIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.5",
            "verseOrgIds": [
              "2CH.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi zvino ndasarudza Jerusarema nokuda kweZita rangu kuti rivepo uye ndasarudza Dhavhidhi kuti atonge vanhu vangu vaIsraeri.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.6",
            "verseOrgIds": [
              "2CH.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Baba vangu Dhavhidhi vaiva nazvo mumwoyo mavo kuti vavakire Zita raJehovha Mwari waIsraeri temberi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.7",
            "verseOrgIds": [
              "2CH.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Jehovha akati kuna baba vangu Dhavhidhi, 'nokuti zvaiva mumwoyo mako kuti uvakire Zita rangu temberi wakaita zvakanaka ukava nazvo mumwoyo mako.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.8",
            "verseOrgIds": [
              "2CH.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kunyange zvakadaro, hausi iwe uchavaka temberi asi mwanakomana wako, anova nyama yako neropa rako, ndiye achavakira Zita rangu temberi.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.9",
            "verseOrgIds": [
              "2CH.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Jehovha akachengeta chivimbiso chavakaita. Ini ndakatevera Dhavhidhi baba vangu uye zvino ndava kugara pachigaro choushe chaIsraeri sokuvimbisa kwakaita Jehovha, uye ndakavakira zita raJehovha Mwari waIsraeri temberi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.10",
            "verseOrgIds": [
              "2CH.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imomo ndakaisa areka ine sungano yaJehovha yaakaita navanhu veIsraeri.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.11",
            "verseOrgIds": [
              "2CH.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Munamato waSoromoni woKukumikidza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Soromoni akamira pamberi pearitari yaJehovha pamberi peungano yose yaIsraeri akatambanudza maoko ake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.12",
            "verseOrgIds": [
              "2CH.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino akanga agadzira pokumira pakakwirira nendarira, pakanga pakareba makubhiti mashanu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.13",
            "verseOrgIds": [
              "2CH.6.13"
            ]
          }
        },
        {
          "text": ", pane upamhi hwamakubhiti mashanu uye pakakwirira makubhiti matatu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.13",
            "verseOrgIds": [
              "2CH.6.13"
            ]
          }
        },
        {
          "text": ", uye akanga apaisa pakati pechivanze chokunze. Akamira pokumira paya akapfugama pamberi peungano yose yaIsraeri akatambanudzira maoko ake kudenga.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.13",
            "verseOrgIds": [
              "2CH.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.14",
            "verseOrgIds": [
              "2CH.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2CH 6:14"
      },
      "items": [
        {
          "text": "\"Haiwa Jehovha, Mwari waIsraeri, hakuna mumwe Mwari akaita semi kudenga kana panyika. Imi munochengeta sungano yorudo navaranda venyu vanoramba vachifamba munzira yenyu nomwoyo wose.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.14",
            "verseOrgIds": [
              "2CH.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makachengeta chivimbiso chenyu kumuranda wenyu Dhavhidhi baba vangu; nomuromo wenyu makavimbisa uye noruoko rwenyu makazadzisa sezvazvakaita nhasi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.15",
            "verseOrgIds": [
              "2CH.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvino Jehovha, Mwari waIsraeri, chengeterai muranda wenyu Dhavhidhi baba vangu zvivimbiso zvamakaita kwaari pamakati, 'Haungatongokundikani kuti uve nomunhu achagara pamberi pangu pachigaro choushe chaIsraeri, kana chete vanakomana vako vakachenjerera mune zvose zvavanoita kuti vafambe pamberi pangu maererano nomurayiro, sezvawakaita iwe.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.16",
            "verseOrgIds": [
              "2CH.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye zvino, haiwa Jehovha Mwari waIsraeri, itai kuti shoko renyu ramakavambisa muranda wenyu Dhavhidhi rizadziswe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.17",
            "verseOrgIds": [
              "2CH.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asi zvechokwadi, Mwari angagare panyika navanhu here? Hamungakwani mumatenga kunyange matenga okumusoro-soro, ko, kuzoti temberi yandavaka!",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.18",
            "verseOrgIds": [
              "2CH.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro teererai munyengetero womuranda wenyu nokukumbira kwake kuti anzwirwe tsitsi, imi Jehovha Mwari wangu. Inzwai kuchema nomunyengetero uri kunyengeterwa nomuranda wenyu pamberi penyu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.19",
            "verseOrgIds": [
              "2CH.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meso enyu ngaatarire kutemberi iyi masikati nousiku, nzvimbo iyi yamakati muchaisa Zita renyumo. Inzwai munyengetero womuranda wenyu waanonyengetera akatarisa kunzvimbo ino.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.20",
            "verseOrgIds": [
              "2CH.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzwai mikumbiro yomuranda wenyu neyavanhu venyu Israeri pavanenge vachinyengetera vakatarisa kunzvimbo ino. Inzwai kubva kudenga kwamunogara uye kana manzwa muregerere.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.21",
            "verseOrgIds": [
              "2CH.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana munhu akatadzira muvakidzani wake uye kana akanzi aite mhiko uye kana akauya akazopika mhiko pamberi pearitari yenyu mutemberi ino,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.22",
            "verseOrgIds": [
              "2CH.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ipapo inzwai muri kudenga uye mugoita chimwe chinhu. Tongai pakati pavaranda venyu, muchimuripisa ane mhosva nokuburutsa pamusoro wake izvo zvaakaita. Ratidzai pachena uyo asina mhosva kuti haana zvaakatadza uye musimbise kusatadza kwake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.23",
            "verseOrgIds": [
              "2CH.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana vanhu venyu Israeri vakakundwa nomuvengi nokuti vakakutadzirai uye kana vakatendeuka vakapupura zita renyu, vachinyengetera uye vachikumbira pamberi penyu mutemberi muno,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.24",
            "verseOrgIds": [
              "2CH.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ipapo inzwai kubva kudenga uye muregerere chivi chavanhu venyu Israeri uye mugovadzosera kunyika yamakavapa ivo namadzibaba avo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.25",
            "verseOrgIds": [
              "2CH.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana matenga akazarirwa uye kukasanaya mvura nokuti vanhu venyu vakutadzirai uye kana vakanyengetera vakatarira kunzvimbo ino vakapupura zita renyu uye vakatendeuka kubva muchivi chavo nokuti imi mavarwadzisa,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.26",
            "verseOrgIds": [
              "2CH.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ipapo inzwai kubva kudenga muregerere chivi chavaranda venyu, vanhu venyu Israeri. Vadzidzisei nzira kwayo yokururama, uye tumirai mvura inaye panyika yamakapa vanhu venyu senhaka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.27",
            "verseOrgIds": [
              "2CH.6.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana nzara kana denda zvikauya panyika, kana nyunje, kana kuvhuvha kana mhashu kana magutaguta kana kuti vavengi vakavakomba mumaguta avo, ringava dambudziko ripi zvaro kana chirwere chorudzi rupi chingauya,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.28",
            "verseOrgIds": [
              "2CH.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye kana munyengetero kana chikumbiro chikaitwa noupi zvake wavanhu venyu Israeri, mumwe nomumwe achinyatsonzwisisa matambudziko namarwadzo ake, uye kana akatambanudzira maoko ake kunzvimbo ino,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.29",
            "verseOrgIds": [
              "2CH.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ipapo inzwai kubva kudenga kwamunogara. Regererai uye muitire mumwe nomumwe sezvaanoita, sezvo muchiziva mwoyo wake (nokuti imi moga ndimi munoziva mwoyo yavanhu),",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.30",
            "verseOrgIds": [
              "2CH.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuitira kuti vagokutyai uye vagofamba munzira dzenyu panguva dzose dzavachararama munyika yamakapa kumadzibaba edu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.31",
            "verseOrgIds": [
              "2CH.6.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana ari mutorwa asati ari mumwe wavanhu venyu Israeri asi akabva kunyika iri kure nokuda kwezita renyu guru noruoko rwenyu rune simba noruoko rwenyu rwakatambanudzwa kana akauya akanyengetera akatarisa kutemberi ino,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.32",
            "verseOrgIds": [
              "2CH.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ipapo inzwai kubva kudenga, kwamunogara uye muitire mutorwa chipi nechipi chaanokumbira kwamuri kuitira kuti vanhu vose vapanyika vazive zita renyu uye vakutyei sezvinoitwa navanhu venyu Israeri, uye kuti vagoziva kuti imba ino yandavaka ine Zita renyu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.33",
            "verseOrgIds": [
              "2CH.6.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana vanhu venyu vakaenda kundorwisana navavengi vavo, kwose kwose kwamunenge mavatuma, uye kana vakanyengetera kwamuri vakatarira kuguta rino ramakasarudza nokutemberi yandavakira Zita renyu,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.34",
            "verseOrgIds": [
              "2CH.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2CH 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "ipapo inzwai ikoko kudenga munamato wavo nechikumbiro chavo, mutsigire mhaka yavo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.35",
            "verseOrgIds": [
              "2CH.6.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2CH 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana vakakutadzirai, nokuti hapana munhu asingatadzi, uye kana mukavatsamwira mukavapa kumuvengi, anovatapa achivaendesa kunyika iri kure kana pedyo;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.36",
            "verseOrgIds": [
              "2CH.6.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2CH 6:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye kana vakashandura mwoyo vari kunyika yavanenge vari nhapwa, vakatendeuka vakakumbira kwamuri vari munyika youtapwa vakati, 'Takatadza, takakanganisa uye takaita zvakaipa,'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.37",
            "verseOrgIds": [
              "2CH.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2CH 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye kana vakadzokerazve kwamuri nomwoyo wavo wose, nomweya wose munyika youtapwa kwavakaendeswa, uye vakanyengetera vakatarisa kunyika yamakapa madzibaba avo, vakatarisa kuguta ramakasarudza uye vakatarisa kutemberi yandakavakira Zita renyu;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.38",
            "verseOrgIds": [
              "2CH.6.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2CH 6:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "ipapo kubva kudenga, kwamunogara, inzwai munyengetero wavo nemikumbiro yavo uye muvatsigire muvakundise pamhaka yavo. Uye muregerere vanhu venyu vanenge vakutadzirai.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.39",
            "verseOrgIds": [
              "2CH.6.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "2CH 6:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvino Mwari wangu, dai meso enyu aona uye nzeve dzenyu dzateerera minyengetero ichanyengeterwa panzvimbo iyi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.40",
            "verseOrgIds": [
              "2CH.6.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "2CH 6:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvino simukai imi Jehovha Mwari, muuye panzvimbo yenyu yokuzorora,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "2CH 6:41"
      },
      "items": [
        {
          "text": "imi neareka yesimba renyu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1",
        "vid": "2CH 6:41"
      },
      "items": [
        {
          "text": "Dai vaprista venyu imi Jehovha Mwari vashongedzwa noruponeso.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "2CH 6:41"
      },
      "items": [
        {
          "text": "Vatsvene venyu ngavafare mukunaka kwenyu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "2CH 6:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Jehovha Mwari, musaramba muzodziwa wenyu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "2CH 6:42"
      },
      "items": [
        {
          "text": "Rangarirai rudo rukuru rwakavimbiswa kuna Dhavhidhi muranda wenyu.\"",
          "type": "text"
        }
      ]
    }
  ],
