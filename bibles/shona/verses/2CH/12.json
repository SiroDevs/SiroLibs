  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "2CH 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Shishaki anorwisa Jerusarema",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure mokunge chinzvimbo chaRehobhoamu samambo chasimbiswa, uye paakanga asimba, iye neIsraeri yose pamwe chete vakasiya murayiro waJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.1",
            "verseOrgIds": [
              "2CH.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti vakanga vasina kutendeka kuna Jehovha, Shishaki mambo weIjipiti akarwisa Jerusarema mugore rechishanu ramambo Rehobhoamu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.2",
            "verseOrgIds": [
              "2CH.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nengoro chiuru namazana maviri navatasvi vamabhiza zviuru makumi matanhatu navarwi vokuRibhiya, Suki neEtiopia vakanga vasingaverengeki vaakauya navo kubva kuIjipiti,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.3",
            "verseOrgIds": [
              "2CH.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "akakunda maguta enhare eJudha kusvika kuJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.4",
            "verseOrgIds": [
              "2CH.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo muprofita Shemaya akauya kuna Rehobhoamu nokuvatungamiri veJudha vakanga vaungana muJerusarema vachitya Shishaki, akati kwavari, \"Zvanzi naJehovha: 'Makandirasa; naizvozvo zvino ndava kukurasirai kuna Shishaki.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.5",
            "verseOrgIds": [
              "2CH.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vatungamiri veIsraeri namambo vakazvininipisa vakati, \"Jehovha akarurama.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.6",
            "verseOrgIds": [
              "2CH.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha paakaona kuti vazvininipisa, shoko iri raJehovha rakauya kuna Shemaya richiti, \"Nokuda kwokuti vazvininipisa, handichavaparadzi asi munguva pfupi ndichavadzikinura. Kutsamwa kwangu hakuchadururirwa paJerusarema kubudikidza naShishaki.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.7",
            "verseOrgIds": [
              "2CH.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvisinei hazvo, vachava pasi pake kuti vadzidze mutsauko uri pakati pokundishumira nokushumira madzimambo edzimwe nyika.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.8",
            "verseOrgIds": [
              "2CH.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shishaki mambo weIjipiti paakarwisa Jerusarema akatakura pfuma yomutemberi yaJehovha nepfuma yomumuzinda wamambo. Akatora zvose kusanganisira nhoo dzegoridhe dzakanga dzagadzirwa naSoromoni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.9",
            "verseOrgIds": [
              "2CH.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Mambo Rehobhoamu akagadzira nhoo dzendarira kutsiva idzo dzakanga dzatorwa akadzipa vakuru vavarindi vaiva pabasa pamukova wokupinda mumuzinda woumambo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.10",
            "verseOrgIds": [
              "2CH.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pose paienda mambo kutemberi yaJehovha, varindi vaienda naye, vakabata nhoo idzi uye vapedza vaizodzidzorera kuimba yavarindi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.11",
            "verseOrgIds": [
              "2CH.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti Rehobhoamu akazvininipisa kutsamwa kwaJehovha kwakabva kwaari, uye haana kuparadzwa zvachose. Zvirokwazvo makava nezvimwe zvakanaka muJudha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.12",
            "verseOrgIds": [
              "2CH.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo Rehobhoamu akazvisimbisa kwazvo muJerusarema akaramba ari mambo. Akanga ane makore makumi mana nerimwe chete paakava mambo uye akatonga kwamakore gumi namanomwe muJerusarema, guta raJehovha raakanga azvisarudzira pamarudzi ose eIsraeri kuti aise Zita rake. Zita ramai vake rainzi Naama; vaiva muAmoni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.13",
            "verseOrgIds": [
              "2CH.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaita zvakaipa nokuti akanga asina kuisa mwoyo wake pakutsvaga Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.14",
            "verseOrgIds": [
              "2CH.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mabasa okutonga kwaRehobhoamu kubva kutanga kwake kusvikira kwokupedzisira, haana kunyorwa here mubhuku renhoroondo raShemaya muprofita neraIdho muoni? Paiva nokurwisana nguva dzose pakati paRehobhoamu naJerobhoamu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.15",
            "verseOrgIds": [
              "2CH.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehobhoamu akazorora namadzibaba ake akavigwa muguta raDhavhidhi. Uye Abhija mwanakomana wake akamutevera paumambo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.16",
            "verseOrgIds": [
              "2CH.12.16"
            ]
          }
        }
      ]
    }
  ],
