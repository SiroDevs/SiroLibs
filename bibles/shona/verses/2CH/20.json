  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "2CH 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jehoshafati anokunda vaMoabhu navaAmoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwaizvozvi vaMoabhu navaAmoni navamwe vaMeuni vakauya kuzorwa naJehoshafati.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.1",
            "verseOrgIds": [
              "2CH.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamwe varume vakauya vakaudza Jehoshafati kuti, \"Hondo huru kwazvo iri kuuya kuzokurwisai kubva kuEdhomu, vachibva mhiri kweGungwa. Yatova muHazazoni Tamari (zvichireva Eni Gedhi).\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.2",
            "verseOrgIds": [
              "2CH.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achitya, Jehoshafati akafunga kundobvunza Jehovha, akadaidzira kuti Judha yose itsanye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.3",
            "verseOrgIds": [
              "2CH.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu veJudha vakaungana pamwe chete kuti vatsvage rubatsiro kubva kuna Jehovha. Zvirokwazvo, vakabva mumaguta ose eJudha kuzomutsvaka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.4",
            "verseOrgIds": [
              "2CH.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehoshafati akamira muungano yeJudha neJerusarema patemberi yaJehovha pamberi pechivanze chitsva,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.5",
            "verseOrgIds": [
              "2CH.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye akati:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.6",
            "verseOrgIds": [
              "2CH.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2CH 20:6"
      },
      "items": [
        {
          "text": "\"Haiwa Jehovha, Mwari wamadzibaba edu, hamusimi here Mwari wokudenga? Munotonga umambo hwose huri panyika. Simba noukuru zviri muruoko rwenyu. Uye hapana angagona kukukundai.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.6",
            "verseOrgIds": [
              "2CH.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Mwari wedu, hamuna here kudzinga vagari venyika ino pamberi pavanhu venyu Israeri mukaipa zvachose kuvana vaAbhurahama, shamwari yenyu?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.7",
            "verseOrgIds": [
              "2CH.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakararama mairi, uye vakavakira mairi imba yeZita renyu vachiti,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.8",
            "verseOrgIds": [
              "2CH.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Kana dambudziko rikatiwira, ringava pfumo rokutonga kana denda, kana nzara, tichamira muuvepo hwenyu pamberi petemberi ine Zita renyu, uye tichachema kwamuri mukutambudzika kwedu uye imi muchatinzwa mugotinunura.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.9",
            "verseOrgIds": [
              "2CH.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asi zvino ava varume vabva kuAmoni, Moabhu neGomo reSeiri vane nyika yamusina kutendera Israeri kuti itore payakabva kuIjipiti. Saka vakavarega uye vakasavaparadza.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.10",
            "verseOrgIds": [
              "2CH.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onai kuti vava kutiripa sei nokuuya kwavo kuzotidzinga munyika yamakatipa senhaka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.11",
            "verseOrgIds": [
              "2CH.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Mwari wedu, hamungavatongi here? Nokuti isu hatina simba rokutonga hondo huru yakadai iri kuuya kuzotirwisa. Hatizivi kuti tingaita sei, asi meso edu akatarisa kwamuri.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.12",
            "verseOrgIds": [
              "2CH.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume vose veJudha, navakadzi vavo navana vadiki, vakamira pamberi paJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.13",
            "verseOrgIds": [
              "2CH.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mweya waMwari wakauya pana Jahazieri mwanakomana waZekaria, mwanakomana waBhenaya, mwanakomana waJeyeri, mwanakomana waMatania muRevhi uye chizvarwa chorudzi rwaAsafi, paakanga akamira muungano.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.14",
            "verseOrgIds": [
              "2CH.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati, \"Teererai, Mambo Jehoshafati navose vanogara muJudha neJerusarema! Zvanzi naJehovha kwamuri, 'Musatya kana kuora mwoyo nokuda kwehondo iyi huru, nokuti kurwa uku hakusi kwenyu, asi ndokwaMwari.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.15",
            "verseOrgIds": [
              "2CH.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mangwana dzikai mundovarwisa. Vachange vachikwidza nomuMupata weZizi uye muchavawana kumagumo omupata muGwenga reJerueri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.16",
            "verseOrgIds": [
              "2CH.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamusi kuzorwa hondo iyi. Torai nzvimbo dzenyu; mumire makasimba mugoona kununurwa kwamuchapiwa naJehovha, imi Judha neJerusarema. Musatya; musaora mwoyo, endai mundovarwisa mangwana, uye Jehovha achava nemi.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.17",
            "verseOrgIds": [
              "2CH.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoshafati akakotamisa chiso chake pasi uye vanhu vose veJudha neJerusarema vakawira pasi vachinamata pamberi paJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.18",
            "verseOrgIds": [
              "2CH.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vamwe vaRevhi kubva kuvaKohati navaKorahi vakasimuka vakarumbidza Jehovha, Mwari waIsraeri nenzwi guru kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.19",
            "verseOrgIds": [
              "2CH.20.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mangwanani-ngwanani vakaenda kuGwenga reTekoa. Vava kuenda, Jehoshafati akasimuka akati, \"Teererai kwandiri, Judha navanhu veJerusarema! Tendai Jehovha Mwari wenyu ipapo muchasimbiswa; tendai vaprofita vake ipapo muchabudirira.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.20",
            "verseOrgIds": [
              "2CH.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwokunge abvunzana navanhu, Jehoshafati akagadza varume kuti vaimbire Jehovha uye vamurumbidze nokuda kwokunaka kwoutsvene hwake pavaifamba vari mberi kwehondo, vachiti:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.21",
            "verseOrgIds": [
              "2CH.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2CH 20:21"
      },
      "items": [
        {
          "text": "\"Vongai Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.21",
            "verseOrgIds": [
              "2CH.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2CH 20:21"
      },
      "items": [
        {
          "text": "nokuti rudo rwake runogara nokusingaperi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.21",
            "verseOrgIds": [
              "2CH.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pavakatanga kuimba vachirumbidza, Jehovha akaisa vavandiri kuti varwise varume veAmoni neMoabhu neveGomo reSeiri vaiuya kuzorwisa Judha, uye vakakundwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.22",
            "verseOrgIds": [
              "2CH.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume veAmoni neMoabhu vakasimuka vakarwisa varume vaibva kuGomo reSeiri kuti vavaparadze zvachose. Vapedza kuuraya varume veSeiri vakaurayana pachavo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.23",
            "verseOrgIds": [
              "2CH.20.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume veJudha pavakasvika panzvimbo yakatarisana nerenje vakatarisa kwakanga kwaimbova nehondo huru vakangoona mitumbi yavanhu vakafa yakati rakata; hapana akapunyuka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.24",
            "verseOrgIds": [
              "2CH.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Jehoshafati navanhu vake vakaenda kundotakura pfuma yavakanga vapamba, uye vakawana pakati pezvinhu izvi nhumbi dzakawanda nezvipfeko nemidziyo inokosha, yakawanda kupfuura zvavaikwanisa kutakura. Paiva nezvakapambwa zvakawanda kwazvo zvokuti vakapedza mazuva matatu vachingotakura.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.25",
            "verseOrgIds": [
              "2CH.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva rechina vakaungana muMupata weBheraka pavakarumbidza Jehovha. Ndokusaka uchiri kunzi Mupata weBheraka kusvikira nhasi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.26",
            "verseOrgIds": [
              "2CH.20.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vachitungamirirwa naJehoshafati, varume vose veJudha neJerusarema vakadzoka nomufaro kuJerusarema, nokuti Jehovha akanga avapa chikonzero chokufara pamusoro pavavengi vavo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.27",
            "verseOrgIds": [
              "2CH.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakapinda muJerusarema vakaenda kutemberi yaJehovha nembira nemitengeranwa nehwamanda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.28",
            "verseOrgIds": [
              "2CH.20.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutya Mwari kwakauya pamadzimambo ose nenyika pavakanzwa kuti Jehovha akanga arwisa sei vavengi veIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.29",
            "verseOrgIds": [
              "2CH.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye nyika yaJehoshafati yakava norunyararo, nokuti Mwari wake akanga amupa zororo kumativi ose.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.30",
            "verseOrgIds": [
              "2CH.20.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Magumo oKutonga kwaJehoshafati",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Jehoshafati akatonga Judha. Akanga ana makore makumi matatu namashanu paakava mambo weJudha, uye akatonga muJerusarema kwamakore makumi maviri namashanu. Mai vake vainzi Azubha mwanasikana waShiri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.31",
            "verseOrgIds": [
              "2CH.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akafamba nomunzira dzababa vake Asa uye haana kutsauka kubva madziri; akaita zvakanga zvakarurama pamberi paJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.32",
            "verseOrgIds": [
              "2CH.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi nzvimbo dzakakwirira hadzina kubviswa uye vanhu havana kunge vaisa mwoyo yavo kuna Mwari wamadzibaba avo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.33",
            "verseOrgIds": [
              "2CH.20.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mamwe mabasa okutonga kwaJehoshafati kubva pakutanga kusvikira pakupedzisira, akanyorwa mumashoko enhoroondo yaJehu mwanakomana waHanani, akanyorwa mubhuku ramadzimambo eIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.34",
            "verseOrgIds": [
              "2CH.20.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2CH 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure maizvozvi, Jehoshafati mambo weJudha akaita chitenderano naAhazia mambo weIsraeri uyo akanga akaipa kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.35",
            "verseOrgIds": [
              "2CH.20.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2CH 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatenderana naye kuvaka zvikepe zvaizoenda kuTashishi. Mushure mokunge zvikepe izvi zvapera kuvakwa paEzioni Gebheri,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.36",
            "verseOrgIds": [
              "2CH.20.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2CH 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eriezeri mwanakomana waDhodhavhahu, wokuMaresha akaprofita zvakaipa pamusoro paJehoshafati achiti, \"Nokuti maita sungano naAhazia, Jehovha achaparadza zvamaita.\" Zvikepe zvakaparadzwa uye hazvina kukwanisa kufamba kuenda kuTashishi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.37",
            "verseOrgIds": [
              "2CH.20.37"
            ]
          }
        }
      ]
    }
  ],
