  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "2CH 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehobhoamu paakasvika muJerusarema, akakurudzira imba yaJudha naBhenjamini, varume zviuru zana namakumi masere zvavarwi, kuti varwisane neIsraeri vatorezve umambo hwaRehobhoamu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.1",
            "verseOrgIds": [
              "2CH.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi shoko iri raJehovha rakasvika kuna Shemaya munhu waMwari richiti,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.2",
            "verseOrgIds": [
              "2CH.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Udza Rehobhoamu mwanakomana waSoromoni mambo weJudha navaIsraeri vose vari muJudha neBhenjamini, uti,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.3",
            "verseOrgIds": [
              "2CH.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Zvanzi naJehovha: Musaenda kunorwisana nehama dzenyu; endai kumba, mumwe nomumwe wenyu, nokuti uku kuita kwangu.' \" Saka vakateerera mashoko aJehovha vakadzoka kubva mukuda kundorwisana naJerobhoamu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.4",
            "verseOrgIds": [
              "2CH.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rehobhoamu anovaka Nhare dzeJudha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehobhoamu akagara muJerusarema akavaka maguta okuzvidzivirira muJudha aiti:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.5",
            "verseOrgIds": [
              "2CH.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheterehema, Etami, Tekoa,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.6",
            "verseOrgIds": [
              "2CH.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheti Zuri, Soko, Adhuramu,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.7",
            "verseOrgIds": [
              "2CH.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gati, Maresha, Zifi,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.8",
            "verseOrgIds": [
              "2CH.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adhoraimi, Rakishi, Azeka,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.9",
            "verseOrgIds": [
              "2CH.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zora, Aijaroni neHebhuroni. Aya ndiwo aiva maguta enhare muJudha neBhenjamini.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.10",
            "verseOrgIds": [
              "2CH.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasimbisa nhare dzawo akaisa vakuru vehondo maari, nezvokudya zvizhinji, mafuta omuorivhi newaini.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.11",
            "verseOrgIds": [
              "2CH.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaisa nhoo namapfumo mumaguta ose, akaaita kuti ave akasimba kwazvo. Saka Judha neBhenjamini vaiva vake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.12",
            "verseOrgIds": [
              "2CH.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaprista navaRevhi kubva kumatunhu ose muIsraeri yose vaiva kurutivi rwake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.13",
            "verseOrgIds": [
              "2CH.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaprista navaRevhi vakatosiya mafuro ezvipfuwo zvavo nemidziyo yavo vakauya kuJudha neJerusarema nokuti Jerobhoamu navanakomana vake vakanga vavaramba savaprista vaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.14",
            "verseOrgIds": [
              "2CH.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye iye akagadza vaprista vake pachake akavaisa panzvimbo dzakakwirira uye nezvifananidzo zvembudzi nezvemhuru zvaakanga agadzira.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.15",
            "verseOrgIds": [
              "2CH.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vose vaibva kumarudzi ose aIsraeri vakaisa mwoyo yavo pakutsvaga Jehovha, Mwari waIsraeri, vakatevera vaRevhi kuJerusarema kuti vandopa zvibayiro kuna Jehovha Mwari wamadzibaba avo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.16",
            "verseOrgIds": [
              "2CH.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakasimbisa umambo hwaJudha vakatsigira Rehobhoamu mwanakomana waSoromoni kwamakore matatu, vachifamba munzira dzaDhavhidhi naSoromoni panguva iyoyi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.17",
            "verseOrgIds": [
              "2CH.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mhuri yaRehobhoamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehobhoamu akawana Maharati aiva mwanasikana womwanakomana waDhavhidhi ainzi Jerimoti uye waAbhihairi mwanasikana womwanakomana waJese ainzi Eriabhi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.18",
            "verseOrgIds": [
              "2CH.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamuberekera vanakomana vaiti, Jeushi, Shemaria naZahamu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.19",
            "verseOrgIds": [
              "2CH.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akawana Maaka mwanasikana waAbhusaromu akamuberekera Abhija, Atai, Ziza naSheromiti.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.20",
            "verseOrgIds": [
              "2CH.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehobhoamu aida Maaka mwanasikana waAbhusaromu kupfuura vamwe vakadzi vake navarongo vake vose. Pamwe chete aiva navakadzi gumi navasere, navarongo makumi matanhatu, vanakomana makumi maviri navasere, navanasikana makumi matanhatu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.21",
            "verseOrgIds": [
              "2CH.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehobhoamu akagadza Abhija mwanakomana waMaaka kuti ave muchinda mukuru pakati pavana vababa vake kuitira kuti azova mambo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.22",
            "verseOrgIds": [
              "2CH.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaita zvakachenjera akaparadzira vamwe vavanakomana vake mumatunhu ose eJudha neBhenjamini nokumaguta ose enhare. Akavapa zvinhu zvizhinji akavawanira vakadzi vakawanda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.11.23",
            "verseOrgIds": [
              "2CH.11.23"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "2CH.12",
    "number": "12",
    "bookId": "2CH"
  },
