  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "2CH 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hezekia anonatsa Temberi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia aiva namakore makumi maviri namashanu paakava mambo, akatonga muJerusarema kwamakore makumi maviri namapfumbamwe. Zita ramai vake rainzi Abhija mwanasikana waZekaria.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.1",
            "verseOrgIds": [
              "2CH.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaita zvakanaka pamberi paJehovha, sezvakanga zvangoitwa naDhavhidhi baba vake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.2",
            "verseOrgIds": [
              "2CH.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwedzi wokutanga wegore rokutanga kutonga kwake akazarura masuo etemberi akaagadziridza.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.3",
            "verseOrgIds": [
              "2CH.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akauyisa vaprista navaRevhi akavaunganidza muchivara chokudivi rokumabvazuva.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.4",
            "verseOrgIds": [
              "2CH.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye akati, \"Teererai kwandiri, vaRevhi! Zvinatsei zvino uye munatse temberi yaJehovha, Mwari wamadzibaba enyu. Mubvise kusvibiswa kwose munzvimbo tsvene.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.5",
            "verseOrgIds": [
              "2CH.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madzibaba edu akanga asina kutendeka; vakaita zvakaipa pamberi paJehovha Mwari uye vakamusiya. Vakabvisa zviso zvavo panzvimbo inogara Jehovha, vakamufuratira.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.6",
            "verseOrgIds": [
              "2CH.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakapfigawo mikova yebiravira uye vakadzima mwenje. Havana kupisira zvinonhuhwira kana kupa zvipiriso zvinopiswa panzvimbo tsvene kuna Mwari waIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.7",
            "verseOrgIds": [
              "2CH.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo, kutsamwa kwaJehovha kwakawira pamusoro peJudha neJerusarema, akavaita chinhu chinotyisa, chinovhundutsa nechinosekwa, sezvamunoona nameso enyu chaiwo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.8",
            "verseOrgIds": [
              "2CH.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndokusaka madzibaba edu akaurayiwa nomunondo uye vanakomana navanasikana vedu navakadzi vedu vava muutapwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.9",
            "verseOrgIds": [
              "2CH.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino ndinoda kuita mhiko naJehovha, Mwari waIsraeri; kuitira kuti kutsamwa kwake kunotyisa kubve kwatiri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.10",
            "verseOrgIds": [
              "2CH.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vangu, musava vanhu vasina hanya zvino, nokuti Jehovha akakusarudzai kuti mumire pamberi pake, uye mumushandire, kuti mushumire pamberi pake uye mupise zvinonhuhwira.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.11",
            "verseOrgIds": [
              "2CH.29.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vaRevhi ava vakasimuka vakashanda:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "2CH 29:12"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2CH 29:12"
      },
      "items": [
        {
          "text": "kubva kuvaKohati,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.12",
            "verseOrgIds": [
              "2CH.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "2CH 29:12"
      },
      "items": [
        {
          "text": "Mahati mwanakomana waAmasai naJoere mwanakomana waAzaria;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.12",
            "verseOrgIds": [
              "2CH.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2CH 29:12"
      },
      "items": [
        {
          "text": "kubva kuvaMerari,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.12",
            "verseOrgIds": [
              "2CH.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "2CH 29:12"
      },
      "items": [
        {
          "text": "Kishi mwanakomana waAbhidhi naAzaria mwanakomana waJeharereri;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.12",
            "verseOrgIds": [
              "2CH.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2CH 29:12"
      },
      "items": [
        {
          "text": "kubva kuvaGerishoni,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.12",
            "verseOrgIds": [
              "2CH.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "2CH 29:12"
      },
      "items": [
        {
          "text": "Joa mwanakomana waZima naEdheni mwanakomana waJoa;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.12",
            "verseOrgIds": [
              "2CH.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubva kuzvizvarwa zvaErizafani,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.13",
            "verseOrgIds": [
              "2CH.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "2CH 29:13"
      },
      "items": [
        {
          "text": "Shimiri naJeyeri;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.13",
            "verseOrgIds": [
              "2CH.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2CH 29:13"
      },
      "items": [
        {
          "text": "kubva kuzvizvarwa zvaAsafi,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.13",
            "verseOrgIds": [
              "2CH.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "2CH 29:13"
      },
      "items": [
        {
          "text": "Zekaria naMatania;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.13",
            "verseOrgIds": [
              "2CH.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubva kuzvizvarwa zvaHemani,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.14",
            "verseOrgIds": [
              "2CH.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "2CH 29:14"
      },
      "items": [
        {
          "text": "Jehieri naShimei;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.14",
            "verseOrgIds": [
              "2CH.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2CH 29:14"
      },
      "items": [
        {
          "text": "kubva kuzvizvarwa zvaJedhutuni,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.14",
            "verseOrgIds": [
              "2CH.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "2CH 29:14"
      },
      "items": [
        {
          "text": "Shemaya naUzieri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.14",
            "verseOrgIds": [
              "2CH.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pavakaunganidza hama dzavo vakazvinatsa, vakapinda mukati kuti vachenese temberi yaJehovha sokurayira kwakanga kwaitwa namambo, vachitevera shoko raJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.15",
            "verseOrgIds": [
              "2CH.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaprista vakaenda munzvimbo tsvene yaJehovha kuti vandoichenesa. Vakabudisa kuchivanze chetemberi yaJehovha zvose zvakanga zvisina kuchena zvavakaona mutemberi yaJehovha. VaRevhi vakazvitora vakaenda nazvo kuMupata weKidhironi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.16",
            "verseOrgIds": [
              "2CH.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakatanga kunatsa pazuva rokutanga romwedzi wokutanga uye pazuva rorusere romwedzi vakasvika pabiravira raJehovha. Kwamamwezve mazuva masere vakanatsa temberi yaJehovha pachayo, vakapedza nezuva regumi namatanhatu romwedzi wokutanga.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.17",
            "verseOrgIds": [
              "2CH.29.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakaenda kuna mambo Hezekia vakandomuzivisa kuti: \"Tachenesa temberi yaJehovha yose, aritari yezvipiriso zvinopiswa nemidziyo yayo yose, netafura yekuisira chingwa chakatsaurwa, nemidziyo yayo yose.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.18",
            "verseOrgIds": [
              "2CH.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tagadzira uye tanatsa midziyo yose yakabviswa naMambo Ahazi mukusatendeka kwake paakanga ari mambo. Zvino yava pamberi pearitari yaJehovha.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.19",
            "verseOrgIds": [
              "2CH.29.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mangwanani ezuva raitevera Mambo Hezekia akaunganidza vakuru veguta pamwe chete vakakwira kutemberi yaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.20",
            "verseOrgIds": [
              "2CH.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakauya nehando nomwe, makondobwe manomwe, namakwai makono manomwe nembudzi hono nomwe sechibayiro chezvivi choushe, chenzvimbo tsvene necheJudha. Mambo akarayira vaprista, zvizvarwa zvaAroni kuti vapisire zvibayiro izvi paaritari yaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.21",
            "verseOrgIds": [
              "2CH.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakauraya hando dziya, uye vaprista vakatora ropa vakarisasa paaritari mushure mezvo vakauraya makondobwe vakasasa ropa rawo paaritari; uye vakauraya makwayana vakasasa ropa rawo paaritari.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.22",
            "verseOrgIds": [
              "2CH.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbudzi dzechipiriso chechivi dzakauyiswa pamberi pamambo neungano, uye vakaisa maoko avo pamusoro padzo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.23",
            "verseOrgIds": [
              "2CH.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vaprista vakadziuraya vakaisa ropa radzo paaritari sechipiriso chechivi kuti vayananisire Israeri yose, nokuti mambo akanga arayira kuti kuitwe chipiriso chinopiswa nechipiriso chechivi zvichiitirwa Israeri yose.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.24",
            "verseOrgIds": [
              "2CH.29.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaisa vaRevhi mutemberi yaJehovha vane makandira, nemitengeranwa nembira sezvaakanga arayirwa naDhavhidhi naGadhi muoni wamambo naNatani muprofita. Izvi ndizvo zvakarayirwa naJehovha kubudikidza navaprofita vake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.25",
            "verseOrgIds": [
              "2CH.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vaRevhi vakamira vakagadzirira vaine zviridzwa zvaDhavhidhi uye vaprista vaine hwamanda dzavo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.26",
            "verseOrgIds": [
              "2CH.29.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia akarayira vanhu kuti vabayire chipiriso chinopiswa paaritari. Chipiriso pachakatanga, kuimbira Jehovha kwakatangawo, kuchiteverwa nehwamanda nezviridzwa zvaDhavhidhi mambo weIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.27",
            "verseOrgIds": [
              "2CH.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungano yose yakakotama ichinamata, vaimbi pavaiimba uye varidzi vehwamanda vachiridza. Zvose izvi zvakaenderera mberi kusvikira chibayiro chechipiriso chinopiswa chapera.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.28",
            "verseOrgIds": [
              "2CH.29.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pavakapedza kupa zvipiriso, mambo navose vaakanga anavo vakapfugama pasi vakanamata.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.29",
            "verseOrgIds": [
              "2CH.29.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo Hezekia namachinda ake vakarayira vaRevhi kuti varumbidze Jehovha namashoko aDhavhidhi neaAsafi muoni. Saka vakaimba nziyo dzokurumbidza nomufaro uye vakakotama vakanamata.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.30",
            "verseOrgIds": [
              "2CH.29.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 29:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Hezekia akati, \"Imi iye zvino mazvikumikidza kuna Jehovha. Uyai nezvipiriso zvokuvonga kutemberi yaJehovha.\" Saka ungano yose yakauyisa zvipiriso nezvipo zvokuvonga, uye vose vaiva nemwoyo inoda vakauyisa zvipiriso zvinopiswa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.31",
            "verseOrgIds": [
              "2CH.29.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 29:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvipiriso zvinopiswa zvakauyiswa neungano zvaiti hando makumi manomwe, namakondobwe zana, namakwayana makono mazana maviri, zvose izvi zvaiva zvokupisira kuna Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.32",
            "verseOrgIds": [
              "2CH.29.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 29:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mhuka dzose dzakanga dzatsaurwa sezvipiriso dzaisvika hando mazana matanhatu namakwai nembudzi zviuru zvitatu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.33",
            "verseOrgIds": [
              "2CH.29.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 29:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro, vaprista vakanga vari vashoma kwazvo kuti vakwanise kuvhiya zvipiriso zvose izvi; saka hama dzavo vaRevhi vakavabatsira kusvikira basa iri rapera uye kusvikira vamwe vaprista vatsaurwa nokuti vaRevhi vakanga vakangwarira kwazvo kuzvigadza kupfuura zvaiita vaprista.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.34",
            "verseOrgIds": [
              "2CH.29.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2CH 29:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paiva nezvipiriso zvinopiswa zvakawanda kwazvo, pamwe chete namafuta ezvipiriso zvokuyanana, nezvipiriso zvokunwa zvaipiwa pamwe chete nezvipiriso zvinopiswa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.35",
            "verseOrgIds": [
              "2CH.29.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 29:35"
      },
      "items": [
        {
          "text": "Saka temberi yaJehovha yakatanga kushanda zvakare.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.35",
            "verseOrgIds": [
              "2CH.29.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2CH 29:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia navanhu vose vakapemberera zvakanga zvauyiswa naMwari kuvanhu vake nokuti zvakanga zvaitwa nokukurumbidza.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.36",
            "verseOrgIds": [
              "2CH.29.36"
            ]
          }
        }
      ]
    }
  ],
