        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uzia Mambo weJudha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vanhu vose veJudha vakatora Uzia akanga ane makore gumi namatanhatu, vakamuita mambo panzvimbo yababa vake Amazia.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.1",
            "verseOrgIds": [
              "2CH.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiye akazovakazve Erati akaridzorera kuJudha mushure mokunge Amazia azorora namadzibaba ake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.2",
            "verseOrgIds": [
              "2CH.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzia aiva namakore gumi namatanhatu paakava mambo uye akatonga muJerusarema kwamakore makumi mashanu namaviri. Mai vake vainzi Jekoria uye vaibva kuJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.3",
            "verseOrgIds": [
              "2CH.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaita zvakanaka pamberi paJehovha sezvakanga zvaitwa nababa vake Amazia.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.4",
            "verseOrgIds": [
              "2CH.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatsvaka Mwari pamazuva aZekaria, uyo aimurayira mukutya Mwari. Pose paaitsvaka Jehovha, Mwari akaita kuti abudirire.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.5",
            "verseOrgIds": [
              "2CH.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akandorwisa vaFiristia akaputsa masvingo eGati, Jabhine neAshidhodhi. Akavakazve maguta aiva pedyo neAshidhodhi nokumwewo pakati pavaFiristia.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.6",
            "verseOrgIds": [
              "2CH.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari akamubatsira mukurwisa vaFiristia navaArabhu vaigara muGuri Bhaari uye paakarwa navaMeuni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.7",
            "verseOrgIds": [
              "2CH.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaAmoni vakavigira Uzia mitero, uye mbiri yake yakandosvika kumucheto kweIjipiti nokuti akanga asimba kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.8",
            "verseOrgIds": [
              "2CH.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzia akavaka shongwe muJerusarema paSuo Repakona, paSuo Rokumupata, napakona yorusvingo, akadzisimbisa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.9",
            "verseOrgIds": [
              "2CH.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akavakazve shongwe murenje uye akachera matsime mazhinji, nokuti akanga ane zvipfuwo zvakawanda mujinga mezvikomo nomumapani. Aiva navanhu vaishanda muminda yake nomuminda yemizambiringa mumakomo nomunyika yakaorera, nokuti aida ivhu kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.10",
            "verseOrgIds": [
              "2CH.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzia aiva navarwi vakadzidzira kwazvo kurwa, vakanga vakagadzirira kubuda vari mumapoka avo maererano nouwandu hwavo sokuunganidzwa kwavakanga vaitwa naJeyeri munyori naMaaseya jinda rakanga riri pasi paHanania mumwe wavakuru pamuzinda wamambo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.11",
            "verseOrgIds": [
              "2CH.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwandu hwavatungamiri vemhuri vaiva pamusoro pavarwi hwaisvika zviuru zviviri namazana matanhatu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.12",
            "verseOrgIds": [
              "2CH.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pasi pavo paiva nehondo yaiva navarume zviuru mazana matatu nezvinomwe namazana mashanu, vakadzidziswa kurwa, hondo yakanga yakasimba kwazvo kuti itsigire mambo pakurwisana navavengi vake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.13",
            "verseOrgIds": [
              "2CH.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzia akavapa nhoo, mapfumo nguwani, nenguo dzamatare, uye uta namabwe okupfura nawo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.14",
            "verseOrgIds": [
              "2CH.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "MuJerusarema akagadzira michina yakagadzirwa navarume vane umhizha kuti ishandiswe pamusoro peshongwe napamakona pakukanda miseve nokukanda matombo makuru. Mbiri yake yakapararira kunzvimbo dziri kure, nokuti akabatsirwa zvikuru kusvikira ava nesimba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.15",
            "verseOrgIds": [
              "2CH.26.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Uzia paakava nesimba, kuzvikudza kwake kwakamutungamirira mukuwa kwake. Haana kutendeka kuna Jehovha Mwari wake, uye akapinda mutemberi yaJehovha kundopisira zvinonhuhwira paaritari yezvinonhuhwira.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.16",
            "verseOrgIds": [
              "2CH.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azaria muprista navamwe vaprista vaJehovha makumi masere vakanga vasingatyi vakamutevera mukati.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.17",
            "verseOrgIds": [
              "2CH.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakamutongesa vakati, \"Hazvina kufanira kwamuri imi, Uzia, kuti mupisire zvinonhuhwira kuna Jehovha. Izvozvo ndezvavaprista, vanakomana vaAroni, vakatsaurirwa kuti vapise zvinonhuhwira. Budai munzvimbo tsvene, nokuti hamuna kutendeka, uye hamungazokudzwa naJehovha Mwari.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.18",
            "verseOrgIds": [
              "2CH.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzia uyo akanga aine mbiya yokupisira zvinonhuhwira muruoko rwake, akatsamwa kwazvo. Paakanga achakatsamwira vaprista pamberi pavo, pamberi pearitari yezvinonhuhwira mutemberi yaJehovha, maperembudzi akamera pahuma yake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.19",
            "verseOrgIds": [
              "2CH.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azaria mukuru wavaprista, navaprista vose pavakatarisa kwaari, vakaona kuti akanga ava namaperembudzi pahuma yake, saka vakakurumidza kumuburitsamo. Zvirokwazvo iyewo pachake akanga ava kuda kubuda nokuti Jehovha akanga amurova nechirwere.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.20",
            "verseOrgIds": [
              "2CH.26.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo Uzia akava namaperembudzi kusvikira musi waakafa. Aigara muimba yake oga asingabvumirwi kupinda mutemberi yaJehovha. Jotamu mwanakomana wake ndiye aitonga mumuzinda uye nokutonga vanhu venyika.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.21",
            "verseOrgIds": [
              "2CH.26.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvimwe zvakaitwa mukutonga kwaUzia kubva pakutanga kusvika pakupedzisira zvakanyorwa nomuprofita Isaya mwanakomana waAmozi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.22",
            "verseOrgIds": [
              "2CH.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzia akazorora namadzibaba ake akavigwa pedyo navo mumunda wemakuva waiva wamadzimambo, nokuti vanhu vakati, \"Aiva namaperembudzi.\" Jotamu mwanakomana wake akamutevera paumambo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.23",
            "verseOrgIds": [
              "2CH.26.23"
            ]
          }
        }
      ]
    }
  ],
