{
  "TIT.1": {
    "id": "TIT.1",
    "number": "1",
    "bookId": "TIT",
    "reference": "Tito 1",
    "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
    "verseCount": 16,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "1",
          "style": "c",
          "sid": "TIT 1"
        },
        "items": [
          {
            "text": "1",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "TIT 1:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Pauro, muranda waMwari nomupostori waJesu Kristu nokuda kwokutenda kwavasanangurwa vaMwari nokuziva chokwadi chinotungamirira kuumwari,",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.1",
              "verseOrgIds": [
                "TIT.1.1"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "TIT 1:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "kutenda nokuziva kunobva patariro youpenyu husingaperi, hwakapikirwa naMwari, iye asingatongonyepi, akavimbisa idzo nguva dzisati dzavapo,",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.2",
              "verseOrgIds": [
                "TIT.1.2"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "TIT 1:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "panguva yake yakatarwa akazivisa shoko rake nokuparidza kwandakapiwa nokurayira kwaMwari Muponesi wedu,",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.3",
              "verseOrgIds": [
                "TIT.1.3"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "TIT 1:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "kuna Tito, mwanakomana wangu chaiye pakutenda kwedu tose:",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.4",
              "verseOrgIds": [
                "TIT.1.4"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b",
          "vid": "TIT 1:4"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p",
          "vid": "TIT 1:4"
        },
        "items": [
          {
            "text": "Nyasha norugare zvinobva kuna Mwari Baba naKristu Jesu Muponesi wedu.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.4",
              "verseOrgIds": [
                "TIT.1.4"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Basa raTito paKirete",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "TIT 1:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ndakakusiya paKirete kuti upedzise zvakasara zvisina kupera uye kuti ugadze vakuru mumaguta ose, sezvandakakurayira.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.5",
              "verseOrgIds": [
                "TIT.1.5"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "TIT 1:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Mukuru anofanira kuva munhu asina chaangapomerwa, murume womukadzi mumwe chete, munhu ane vana vanotenda uye vasingapiwi mhosva yokuti havazvidzori kana kuti havateereri.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.6",
              "verseOrgIds": [
                "TIT.1.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "TIT 1:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Sezvo mutariri akapiwa basa raMwari, anofanira kuva munhu asina chaangapomerwa, asingakurumidzi kutsamwa, asingadhakwi, asingarwi, asingafariri pfuma yakaipa.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.7",
              "verseOrgIds": [
                "TIT.1.7"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "TIT 1:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "Asi anoitira vaeni rudo, munhu anoda zvakanaka, anozvidzora, akarurama, mutsvene uye anozvibata.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.8",
              "verseOrgIds": [
                "TIT.1.8"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "TIT 1:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Anofanira kubatisisa shoko rechokwadi sezvarakadzidziswa, kuitira kuti agokurudzira vamwe nedzidziso yakarurama uye agodzivisa vaya vanoipikisa.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.9",
              "verseOrgIds": [
                "TIT.1.9"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "TIT 1:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nokuti kune vazhinji vasingateereri vanongotaura zvisina maturo uye vanyengeri, zvikuru sei vaya veboka rokudzingiswa.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.10",
              "verseOrgIds": [
                "TIT.1.10"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "TIT 1:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Vanofanira kunyaradzwa miromo yavo, nokuti vari kuparadza mhuri dzizere vachidzidzisa zvinhu zvavasingafaniri kudzidzisa, uye vachizviita kuti vawane pfuma yakaipa.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.11",
              "verseOrgIds": [
                "TIT.1.11"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "TIT 1:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "Kunyange mumwe wavaprofita wavo akati, \"VaKirete vanogara vachireva nhema, zvikara zvakaipa, simbe dzinokara.\"",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.12",
              "verseOrgIds": [
                "TIT.1.12"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "13",
              "style": "v",
              "sid": "TIT 1:13"
            },
            "items": [
              {
                "text": "13",
                "type": "text"
              }
            ]
          },
          {
            "text": "Uchapupu uhu ndohwechokwadi. Naizvozvo vatsiure zvikuru, kuti varurame pakutenda",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.13",
              "verseOrgIds": [
                "TIT.1.13"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "14",
              "style": "v",
              "sid": "TIT 1:14"
            },
            "items": [
              {
                "text": "14",
                "type": "text"
              }
            ]
          },
          {
            "text": "uye kuti varege kuteerera ngano dzavaJudha, kana kurayira kwavanhu vakaramba chokwadi.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.14",
              "verseOrgIds": [
                "TIT.1.14"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "15",
              "style": "v",
              "sid": "TIT 1:15"
            },
            "items": [
              {
                "text": "15",
                "type": "text"
              }
            ]
          },
          {
            "text": "Kune vakachena, zvinhu zvose zvakachena, asi kuna avo vakaora uye vasingatendi, hakuna chinhu chakachena. Asi kutoti zvose pfungwa dzavo nehana dzavo zvakaora.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.15",
              "verseOrgIds": [
                "TIT.1.15"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "16",
              "style": "v",
              "sid": "TIT 1:16"
            },
            "items": [
              {
                "text": "16",
                "type": "text"
              }
            ]
          },
          {
            "text": "Vanoti vanoziva Mwari, asi vanomuramba namabasa avo. Vanonyangadza, havateereri uye havana kufanirwa nokuita chinhu chakanaka.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.16",
              "verseOrgIds": [
                "TIT.1.16"
              ]
            }
          }
        ]
      }
    ],
    "next": {
      "id": "TIT.2",
      "number": "2",
      "bookId": "TIT"
    },
    "previous": {
      "id": "TIT.intro",
