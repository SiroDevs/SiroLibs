      "bookId": "TIT"
    }
  },
  "TIT.2": {
    "id": "TIT.2",
    "number": "2",
    "bookId": "TIT",
    "reference": "Tito 2",
    "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
    "verseCount": 15,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "2",
          "style": "c",
          "sid": "TIT 2"
        },
        "items": [
          {
            "text": "2",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Zvinofanira kudzidziswa Vatendi",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "TIT 2:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Unofanira kudzidzisa zviri maererano nedzidziso yakarurama.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.1",
              "verseOrgIds": [
                "TIT.2.1"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "TIT 2:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "Dzidzisa varume vakuru kuti vave vanozvibata, vakafanira kukudzwa, vanozvidzora, uye vakarurama mukutenda, murudo nomukutsungirira.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.2",
              "verseOrgIds": [
                "TIT.2.2"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "TIT 2:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Saizvozvowo, dzidzisa vakadzi vakuru kuti vave nomufambiro wakafanira, vasingacheri, kana kuda waini zhinji, asi kuti vadzidzise zvakanaka.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.3",
              "verseOrgIds": [
                "TIT.2.3"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "TIT 2:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Uye kuti vadzidzise vakadzi vaduku kuti vade varume vavo navana vavo,",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.4",
              "verseOrgIds": [
                "TIT.2.4"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "TIT 2:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "kuti vave vanozvidzora uye vakachena, vanoshanda kumba, vave vanyoro uye kuti vazviise pasi pavarume vavo, kuitira kuti pashayikwe angazvidza shoko raMwari.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.5",
              "verseOrgIds": [
                "TIT.2.5"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "TIT 2:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Zvimwe chetezvo, kurudzira majaya kuti azvidzore.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.6",
              "verseOrgIds": [
                "TIT.2.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "TIT 2:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Pazvinhu zvose iwe uvaratidze somuenzaniso nokuita zvakanaka. Pakudzidzisa kwako udzidzise zvakakwana, uchirevesa",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.7",
              "verseOrgIds": [
                "TIT.2.7"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "TIT 2:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "uye nokutaura kwakarurama kusingagoni kushorwa, kuitira kuti vaya vanokupikisa vanyadziswe nokuti havana chinhu chavangareva pamusoro pedu.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.8",
              "verseOrgIds": [
                "TIT.2.8"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "TIT 2:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Udzidzise varanda kuti vazviise pasi pavanavatenzi vavo pazvinhu zvose kuti vavafadze, varege kupindurana navo,",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.9",
              "verseOrgIds": [
                "TIT.2.9"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "TIT 2:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "uye kuti varege kuvabira, asi kuti varatidze kuti vakatendeka zvikuru kwazvo, kuitira kuti vashongedze dzidziso yaMwari Muponesi wedu pazvinhu zvose.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.10",
              "verseOrgIds": [
                "TIT.2.10"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "TIT 2:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nokuti nyasha dzaMwari dzinouyisa ruponeso dzakaratidzwa kuvanhu vose.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.11",
              "verseOrgIds": [
                "TIT.2.11"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "TIT 2:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "Dzinotidzidzisa kuti tirambe zvinhu zvisina umwari nokuchiva kwenyika, uye tirarame upenyu hwokuzvidzora, hwokururama uye hwoumwari munguva ino,",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.12",
              "verseOrgIds": [
                "TIT.2.12"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "13",
              "style": "v",
              "sid": "TIT 2:13"
            },
            "items": [
              {
                "text": "13",
                "type": "text"
              }
            ]
          },
          {
            "text": "takamirira tariro yakaropafadzwa, kuonekwa kwokubwinya kwaMwari wedu mukuru noMuponesi, Jesu Kristu,",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.13",
              "verseOrgIds": [
                "TIT.2.13"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "14",
              "style": "v",
              "sid": "TIT 2:14"
            },
            "items": [
              {
                "text": "14",
                "type": "text"
              }
            ]
          },
          {
            "text": "akazvipa nokuda kwedu kuti atidzikinure kubva pakuipa kwose, nokuzvinatsira vanhu vari vake chaivo, vanoshingaira kuita zvinhu zvakanaka.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.14",
              "verseOrgIds": [
                "TIT.2.14"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "15",
              "style": "v",
              "sid": "TIT 2:15"
            },
            "items": [
              {
                "text": "15",
                "type": "text"
              }
            ]
          },
          {
            "text": "Zvino, izvi ndizvo zvinhu zvaunofanira kudzidzisa. Kurudzira uye utsiure nesimba rose. Ngakurege kuva nomunhu anokuzvidza.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.15",
              "verseOrgIds": [
                "TIT.2.15"
              ]
            }
          }
        ]
      }
    ],
