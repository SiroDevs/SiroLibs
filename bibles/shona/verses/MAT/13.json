  "verseCount": 58,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "MAT 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mufananidzo woMukushi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musi mumwe chetewo, Jesu akabuda mumba akandogara nechokugungwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.1",
            "verseOrgIds": [
              "MAT.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vazhinji vakamuunganira zvokuti akapinda mugwa akagaramo, vanhu vose vakamira kumahombekombe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.2",
            "verseOrgIds": [
              "MAT.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akavaudza zvinhu zvizhinji nemifananidzo, achiti, \"Murimi akabuda kundokusha mbeu dzake.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.3",
            "verseOrgIds": [
              "MAT.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paakanga achikusha mbeu, dzimwe dzakawira munzira, shiri dzikauya dzikadzidya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.4",
            "verseOrgIds": [
              "MAT.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzimwe dzakawira parukangarahwe, padzakashaya ivhu rakakwana. Dzakamera nokukurumidza nokuti ivhu rakanga risina kudzika.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.5",
            "verseOrgIds": [
              "MAT.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi zuva rakati rabuda, mbeu dzakatsva dzikaoma nokuti dzakanga dzisina midzi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.6",
            "verseOrgIds": [
              "MAT.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzimwe mbeu dzakawira muminzwa, minzwa ikakura ikadzivhunga.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.7",
            "verseOrgIds": [
              "MAT.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzimwewo mbeu dzakawira pavhu rakanaka, dzikabereka zvakapetwa kazana, kana zvakapetwa makumi matanhatu kana makumi matatu pane dzainge dzakushwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.8",
            "verseOrgIds": [
              "MAT.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyo ane nzeve dzokunzwa ngaanzwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.9",
            "verseOrgIds": [
              "MAT.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vadzidzi vakauya kwaari vakasvikomubvunza vachiti, \"Ko, munotaurirei kuvanhu nemifananidzo?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.10",
            "verseOrgIds": [
              "MAT.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapindura achiti, \"Ruzivo rwezvakavanzika zvoumambo hwokudenga rwakapiwa kwamuri imi, asi kwete kwavari.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.11",
            "verseOrgIds": [
              "MAT.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kune anazvo achapiwazve zvimwe, uye achava nezvakawanda. Asi ani naani asina kunyange nezvishoma zvaanazvo achazvitorerwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.12",
            "verseOrgIds": [
              "MAT.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndokusaka ndichitaura kwavari nemifananidzo:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.13",
            "verseOrgIds": [
              "MAT.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 13:13"
      },
      "items": [
        {
          "text": "\"Kunyange vachiona asi havaoni,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.13",
            "verseOrgIds": [
              "MAT.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 13:13"
      },
      "items": [
        {
          "text": "kunyange vachinzwa asi havanzwi kana kunzwisisa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.13",
            "verseOrgIds": [
              "MAT.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mavari munozadzisa chiprofita chaIsaya chinoti:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.14",
            "verseOrgIds": [
              "MAT.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 13:14"
      },
      "items": [
        {
          "text": "\" 'Muchangoramba muchinzwa asi musinganzwisisi;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.14",
            "verseOrgIds": [
              "MAT.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 13:14"
      },
      "items": [
        {
          "text": "muchangoramba muchiona asi musingaonesesi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.14",
            "verseOrgIds": [
              "MAT.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti mwoyo yavanhu ava mikukutu,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.15",
            "verseOrgIds": [
              "MAT.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 13:15"
      },
      "items": [
        {
          "text": "havatombonzwi nenzeve dzavo,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.15",
            "verseOrgIds": [
              "MAT.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 13:15"
      },
      "items": [
        {
          "text": "uye vakatsinzina meso avo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.15",
            "verseOrgIds": [
              "MAT.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 13:15"
      },
      "items": [
        {
          "text": "Zvichida vangaona nameso avo,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.15",
            "verseOrgIds": [
              "MAT.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 13:15"
      },
      "items": [
        {
          "text": "vakanzwa nenzeve dzavo,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.15",
            "verseOrgIds": [
              "MAT.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 13:15"
      },
      "items": [
        {
          "text": "vakanzwisisa nemwoyo yavo,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.15",
            "verseOrgIds": [
              "MAT.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 13:15"
      },
      "items": [
        {
          "text": "vakapinduka, uye ndikavaporesa.'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.15",
            "verseOrgIds": [
              "MAT.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi akaropafadzwa meso enyu nokuti anoona nenzeve dzenyu nokuti dzinonzwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.16",
            "verseOrgIds": [
              "MAT.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti, ndinokuudzai chokwadi kuti vaprofita vazhinji navanhu vakarurama vaida kuona zvinhu zvamuri kuona asi havana kuzviona, nokunzwa zvamuri kunzwa asi havana kuzvinzwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.17",
            "verseOrgIds": [
              "MAT.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Teererai zvino munzwe zvinorehwa nomufananidzo womukushi:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.18",
            "verseOrgIds": [
              "MAT.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana munhu akanzwa shoko roumambo, akasarinzwisisa, akaipa anouya osvikobvuta zviya zvanga zvadyarwa mumwoyo make. Iyi ndiyo mbeu yakakushwa munzira.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.19",
            "verseOrgIds": [
              "MAT.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyo akagamuchira mbeu yakawira parukangarahwe, ndiye munhu anonzwa shoko, pakarepo origamuchira norufaro.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.20",
            "verseOrgIds": [
              "MAT.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi nokuti haana mudzi, anongorarama naro kwechinguva chipfupi. Kana nhamo kana kutambudzwa zvauya nokuda kweshoko, anokurumidza kugumburwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.21",
            "verseOrgIds": [
              "MAT.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyo akagamuchira mbeu yakawira muminzwa, munhu anonzwa shoko asi kufunganya kwenyika nokunyengera kwepfuma zvinorivhunga robva rashaya zvibereko.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.22",
            "verseOrgIds": [
              "MAT.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi uyo anogamuchira shoko rakawira muvhu rakanaka ndiye munhu anonzwa shoko orinzwisisa. Ndiye anobereka mbeu inoburitsa zana, kana makumi matanhatu kana makumi matatu ezvakakushwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.23",
            "verseOrgIds": [
              "MAT.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mufananidzo waMasawi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akavaudza mumwe mufananidzo achiti, \"Umambo hwokudenga hunofananidzwa nomunhu akakusha mbeu yakanaka mumunda make.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.24",
            "verseOrgIds": [
              "MAT.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi munhu wose avete, muvengi wake akauya akakusha sawi pakati pegorosi, ndokubva aenda.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.25",
            "verseOrgIds": [
              "MAT.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kuzoti gorosi ramera rikatumbuka, ipapo sawi rakaonekwawo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.26",
            "verseOrgIds": [
              "MAT.13.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Varanda vomuridzi womunda vakauya kwaari vakasvikoti, 'Ishe, hamuna kukusha mbeu yakanaka mumunda menyu here? Ko, zvino sawi rakazobvepi?'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.27",
            "verseOrgIds": [
              "MAT.13.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Akavapindura achiti, 'Muvengi ndiye akaita izvi.'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.28",
            "verseOrgIds": [
              "MAT.13.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 13:28"
      },
      "items": [
        {
          "text": "\"Varanda vakamubvunza vakati, 'Munoda kuti tiende kunoridzura here?'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.28",
            "verseOrgIds": [
              "MAT.13.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Akapindura akati, 'Kwete, nokuti paya pamunodzura sawi, mungazodzura pamwe chete nezviyo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.29",
            "verseOrgIds": [
              "MAT.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Regai zvikurirane pamwe chete, tozozviona pakukohwa. Panguva iyoyo ndinozoudza vakohwi kuti: Tangai kuunganidza sawi murisunge muzvisote zvichazopiswa. Mushure mozounganidza gorosi mugoriisa mudura rangu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.30",
            "verseOrgIds": [
              "MAT.13.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mufananidzo weMbeu yeMasitadhi noweMbiriso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akavaudzazve mumwe mufananidzo achiti, \"Umambo hwokudenga hwakafanana nembeu yemasitadhi iyo yakatorwa nomunhu akaidyara mumunda make.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.31",
            "verseOrgIds": [
              "MAT.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvazvo iri iyo mbeu dukusa pambeu dzenyu, asi painokura ndiyo huru kwazvo pambeu dzose dzomubindu uye inova muti wokuti shiri dzedenga dzinouya dzichimhara pamapazi awo.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.32",
            "verseOrgIds": [
              "MAT.13.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akavaudzazve mumwe mufananidzo achiti, \"Umambo hwokudenga hwakafanana nembiriso, iyo inotorwa nomunhukadzi oisanganisa nefurawa yakawanda, kusvikira yapinda muchikanyiwa chose.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.33",
            "verseOrgIds": [
              "MAT.13.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akataura zvinhu izvi zvose kuvanhu nemifananidzo. Haana chaakataura kwavari asingashandisi mifananidzo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.34",
            "verseOrgIds": [
              "MAT.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saizvozvo zvakazadziswa zvakanga zvataurwa kubudikidza nomuprofita zvichinzi:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.35",
            "verseOrgIds": [
              "MAT.13.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 13:35"
      },
      "items": [
        {
          "text": "\"Ndichataura nemifananidzo,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.35",
            "verseOrgIds": [
              "MAT.13.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 13:35"
      },
      "items": [
        {
          "text": "ndichataura zvinhu zvakavanzika kubva pakusikwa kwenyika.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.35",
            "verseOrgIds": [
              "MAT.13.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kududzirwa kwoMufananidzo waMasawi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akasiya vanhu vazhinji akapinda mumba. Vadzidzi vake vakauya kwaari vakasvikoti, \"Titsanangurirei zvinorehwa nomufananidzo wamasawi mumunda.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.36",
            "verseOrgIds": [
              "MAT.13.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapindura akati, \"Uyo akadyara mbeu yakanaka ndiye Mwanakomana woMunhu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.37",
            "verseOrgIds": [
              "MAT.13.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 13:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munda ndiyo nyika, uye mbeu yakanaka inomirira vanakomana voumambo. Masawi ndiwo vanakomana vowakaipa,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.38",
            "verseOrgIds": [
              "MAT.13.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 13:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "muvengi anoadyara ndiye dhiabhori. Kukohwa ndiko kuguma kwenyika, uye vakohwi ndivo vatumwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.39",
            "verseOrgIds": [
              "MAT.13.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 13:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sokudzurwa kunoitwa masawi achipiswa mumoto, ndizvo zvazvichaita pakuguma kwenyika.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.40",
            "verseOrgIds": [
              "MAT.13.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 13:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanakomana woMunhu achatuma vatumwa vake uye vachadzura kubva muumambo hwake zvose zvinokonzera chivi navose vanoita zvakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.41",
            "verseOrgIds": [
              "MAT.13.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 13:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vachavakanda muvira romoto umo muchava nokuchema nokurumanya kwameno.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.42",
            "verseOrgIds": [
              "MAT.13.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 13:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakarurama vachapenya sezuva vari muumambo hwaBaba vavo. Uyo ane nzeve dzokunzwa ngaanzwe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.43",
            "verseOrgIds": [
              "MAT.13.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mufananidzo wePfuma Yakavigwa noweParera",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 13:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Umambo hwokudenga hwakafanana nepfuma yakavigwa mumunda. Mumwe murume akati aiwana, akaivigazve, uye ipapo mukufara kwake, akaenda akandotengesa zvose zvaaiva nazvo ndokutenga munda iwoyo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.44",
            "verseOrgIds": [
              "MAT.13.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 13:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Umambo hwokudenga hwakafananazve nomutengesi wezvinhu anotsvaka maparera akaisvonaka.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.45",
            "verseOrgIds": [
              "MAT.13.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 13:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati awana rimwe rawo rinokosha akaenda akandotengesa zvose zvaakanga anazvo uye akaritenga.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.46",
            "verseOrgIds": [
              "MAT.13.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mufananidzo woUsvasvi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "MAT 13:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvakare umambo hwokudenga hwakafanana nousvasvi hwakakandwa mugungwa uye hukabata marudzi ose ehove.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.47",
            "verseOrgIds": [
              "MAT.13.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "MAT 13:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pahwakanga hwazara vabati vehove vakahukwevera kunze kumahombekombe. Ipapo vakagara pasi vakasarudza hove dzakanaka vakadziisa mumidziyo, asi dzakaipa vakadzirasa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.48",
            "verseOrgIds": [
              "MAT.13.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "MAT 13:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi ndizvo zvazvichaita pakuguma kwenyika. Vatumwa vachauya vagotsaura vakaipa kubva kune vakarurama,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.49",
            "verseOrgIds": [
              "MAT.13.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "MAT 13:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye vagovakanda muvira romoto, kuchava nokuchema nokurumanya kwameno.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.50",
            "verseOrgIds": [
              "MAT.13.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "MAT 13:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akabvunza akati, \"Manzwisisa zvinhu izvi zvose here?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.51",
            "verseOrgIds": [
              "MAT.13.51"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 13:51"
      },
      "items": [
        {
          "text": "Vakapindura vakati, \"Hongu.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.51",
            "verseOrgIds": [
              "MAT.13.51"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "MAT 13:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kwavari, \"Naizvozvo mudzidzisi mumwe nomumwe womurayiro akadzidziswa nezvoumambo hwokudenga akafanana nomuridzi weimba anoburitsa pfuma itsva netsaru muimba yake yokuchengetera zvinhu.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.52",
            "verseOrgIds": [
              "MAT.13.52"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Muprofita Haakudzwi muNyika Yake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "MAT 13:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati apedza mifananidzo iyi, akabvapo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.53",
            "verseOrgIds": [
              "MAT.13.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "MAT 13:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapinda muguta rokwake akatanga kudzidzisa vanhu musinagoge ravo, uye vakashamiswa nazvo. Vakabvunza vachiti, \"Murume uyu akawanepi uchenjeri uhu namasimba ezvishamiso aya?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.54",
            "verseOrgIds": [
              "MAT.13.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "MAT 13:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, haasi mwanakomana womuvezi here? Mai vake havasi Maria here, navanunʼuna vake havasi Jakobho, Josefa, Simoni naJudhasi?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.55",
            "verseOrgIds": [
              "MAT.13.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "MAT 13:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye hanzvadzi dzake hadzisi pakati pedu dzose here? Ko, zvino murume uyu akawanepi zvinhu zvose izvi?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.56",
            "verseOrgIds": [
              "MAT.13.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "MAT 13:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakagumburwa naye.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.57",
            "verseOrgIds": [
              "MAT.13.57"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 13:57"
      },
      "items": [
        {
          "text": "Asi Jesu akati kwavari, \"Muprofita haashayiwi kukudzwa asi munyika yake nomumba make.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.57",
            "verseOrgIds": [
              "MAT.13.57"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "MAT 13:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye haana kuzoita zvishamiso zvizhinji imomo nokuda kwokusatenda kwavo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.58",
            "verseOrgIds": [
              "MAT.13.58"
            ]
          }
        }
      ]
    }
