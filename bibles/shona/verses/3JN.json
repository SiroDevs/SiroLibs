        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "3JN 1:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Mukuru, kushamwari yangu inodikanwa Gayo, wandinoda muchokwadi.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.1",
              "verseOrgIds": [
                "3JN.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "3JN 1:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "Mudikani, ndinonyengetera kuti uve noutano hwakanaka uye kuti zvose zvikunakire kunyange sokufara kwomweya wako.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.2",
              "verseOrgIds": [
                "3JN.1.2"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "3JN 1:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ndakafara kwazvo dzimwe hama padzakauya dzikandiudza nezvokutendeka kwako pachokwadi uye kuti unoramba uchifamba sei muchokwadi.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.3",
              "verseOrgIds": [
                "3JN.1.3"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "3JN 1:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Hapana chimwe chinhu chinondifadza kupfuura kunzwa kuti vana vangu vari kufamba muchokwadi.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.4",
              "verseOrgIds": [
                "3JN.1.4"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "3JN 1:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "Mudikani, wakatendeka pane zvaunoita kuhama, kunyange vasiri vanhu vaunoziva.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.5",
              "verseOrgIds": [
                "3JN.1.5"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "3JN 1:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Vakataurira kereke nezvorudo rwako. Uchaita zvakanaka kana ukavadzosazve nenzira yakafanira pamberi paMwari.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.6",
              "verseOrgIds": [
                "3JN.1.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "3JN 1:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nokuda kweZita iri vakabuda, vasingagamuchiri rubatsiro kubva kuvahedheni.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.7",
              "verseOrgIds": [
                "3JN.1.7"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "3JN 1:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "Naizvozvo tinofanira kugamuchira vanhu vakadai kuti tishande pamwe chete muchokwadi.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.8",
              "verseOrgIds": [
                "3JN.1.8"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "3JN 1:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ndakanyorera kukereke, asi Dhiotirefesi, iye anoda kuva mukuru, akati haagamuchiri zvatinotaura.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.9",
              "verseOrgIds": [
                "3JN.1.9"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "3JN 1:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "Saka kana ndauya, ndichamuyeuchidza mabasa ake aanoita, okunyeya, nokuitira godo. Kwete izvozvo zvoga, anorambawo kugamuchira hama. Anodzivisawo vaya vanoda havo kuita izvozvo uye achivabudisa mukereke.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.10",
              "verseOrgIds": [
                "3JN.1.10"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "3JN 1:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Mudikani, usatevedzera zvakaipa asi zvakanaka. Ani naani anoita zvakanaka ndiye anobva kuna Mwari. Ani naani anoita zvakaipa haana kuona Mwari.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.11",
              "verseOrgIds": [
                "3JN.1.11"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "3JN 1:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "Dhemetriasi anopupurirwa zvakanaka navose, uye kunyange nechokwadi chaicho. Nesuwo tinotaura zvakanaka nezvake, uye munoziva kuti uchapupu hwedu ndohwechokwadi.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.12",
              "verseOrgIds": [
                "3JN.1.12"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "13",
              "style": "v",
              "sid": "3JN 1:13"
            },
            "items": [
              {
                "text": "13",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ndine zvizhinji zvokukunyorera, asi handidi kuita izvozvi nechinyoreso neingi.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.13",
              "verseOrgIds": [
                "3JN.1.13"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "14",
              "style": "v",
              "sid": "3JN 1:14"
            },
            "items": [
              {
                "text": "14",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ndinovimba kuti ndichakuonai nokukurumidza, uye tichazotaurirana chiso nechiso.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.14",
              "verseOrgIds": [
                "3JN.1.14"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "15",
              "style": "v",
              "sid": "3JN 1:15"
            },
            "items": [
              {
                "text": "15",
                "type": "text"
              }
            ]
          },
          {
            "text": "Rugare kwamuri.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.15",
              "verseOrgIds": [
                "3JN.1.15"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b",
          "vid": "3JN 1:15"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p",
          "vid": "3JN 1:15"
        },
        "items": [
          {
            "text": "Shamwari dziri kuno dzinokukwazisai. Kwazisai shamwari dziri ikoko namazita avo.",
            "type": "text",
            "attrs": {
              "verseId": "3JN.1.15",
              "verseOrgIds": [
                "3JN.1.15"
              ]
            }
          }
        ]
      }
    ],
