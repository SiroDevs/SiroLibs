  "verseCount": 52,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "1SA 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jonatani anorwisa vaFiristia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rimwe zuva Jonatani mwanakomana waSauro akati kujaya raitakura zvombo zvake zvokurwa, \"Uya tiende kumusasa wavarwi vevaFiristia kudivi rimwe iro.\" Asi haana kuudza baba vake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.1",
            "verseOrgIds": [
              "1SA.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauro aigara nechokumucheto kweGibhea pasi pomuti womutamba muMigironi. Aiva navarume vanokarosvika mazana matanhatu,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.2",
            "verseOrgIds": [
              "1SA.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "pakati pavo pana Ahiya, akanga akapfeka efodhi. Akanga ari mwanakomana womukoma waIkabhodhi, Ahitubhi, mwanakomana waFinehasi, mwanakomana waEri, muprista waJehovha muShiro. Hapana akaziva kuti Jonatani akanga aenda.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.3",
            "verseOrgIds": [
              "1SA.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumativi ose omupata waida kuyambukwa naJonatani kuti asvike pamusasa wavaFiristia, kwaiva namawere; mamwe ainzi Bhozezi, mamwe achinzi Sene.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.4",
            "verseOrgIds": [
              "1SA.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mamwe mawere aiva nechokumusoro kwakadziva kuMikimashi, mamwe ari zasi kwakadziva kuGebha.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.5",
            "verseOrgIds": [
              "1SA.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonatani akati kujaya raitakura zvombo zvake zvokurwa, \"Uya tiyambuke tiende kumusasa wavasina kudzingiswa avo. Zvichida Jehovha achatirwira. Hapana chinodzivisa Jehovha kuti aponese, navakawanda kana navashoma.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.6",
            "verseOrgIds": [
              "1SA.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutakuri wezvombo akati, \"Itai zvose zvamafunga. Endai mberi; ndinemi pamweya napamwoyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.7",
            "verseOrgIds": [
              "1SA.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonatani akati, \"Uya tiyambuke zvino tinange kuvarume ava uye tigorega vatione.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.8",
            "verseOrgIds": [
              "1SA.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana vakati kwatiri, 'Mirai ipapo kusvikira tauya kwamuri,' ticharamba tiri patiri ipapo uye hatizokwiri kwavari.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.9",
            "verseOrgIds": [
              "1SA.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana vakati, 'Uyai kuno kwatiri,' tichakwidza, nokuti ndicho chichava chiratidzo chedu chokuti Jehovha avaisa mumaoko edu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.10",
            "verseOrgIds": [
              "1SA.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vose vari vaviri vakazviratidza kuboka ravarwi ravaFiristia. VaFiristia vakati, \"Tarirai! VaHebheru vari kukambaira vachibuda mumakomba avanga vakavanda.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.11",
            "verseOrgIds": [
              "1SA.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume veboka ravarwi vakadanidzira kuna Jonatani nomubati wake nenhumbi dzokurwa vakati, \"Kwirai kuno kwatiri tigokudzidzisai chidzidzo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.12",
            "verseOrgIds": [
              "1SA.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 14:12"
      },
      "items": [
        {
          "text": "Saka Jonatani akati kumubati wake wenhumbi dzokurwa nadzo, \"Kwira unditevere; Jehovha avaisa mumaoko avaIsraeri.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.12",
            "verseOrgIds": [
              "1SA.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonatani akakwira achikambaira namaoko namakumbo ake, mubati wenhumbi dzake dzokurwa ari mumashure make. VaFiristia vakati rakata rakata kuwa pamberi paJonatani, uye mubati wenhumbi dzake dzokurwa akatevera achiuraya mumashure make.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.13",
            "verseOrgIds": [
              "1SA.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakurwisa kwokutanga, Jonatani nomubati wake wenhumbi dzokurwa nadzo vakauraya varume vanenge makumi maviri panzvimbo inenge hafu yeeka.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.14",
            "verseOrgIds": [
              "1SA.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "VaIsraeri vanokunda vaFiristia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo kutya kwakabata varwi vose vakanga vari mumusasa nomuminda, navose vakanga vari mumapoka avarwi navapambi, uye pasi pakadengenyeka. Kwakanga kuri kuvhundutswa kwakanga kwatumwa naMwari.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.15",
            "verseOrgIds": [
              "1SA.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nharirire dzaSauro paGibhea muBhenjamini dzakaona varwi vachinyungudika kumativi ose.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.16",
            "verseOrgIds": [
              "1SA.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Sauro akati kuvarume vakanga vanaye, \"Verengai varwi muone kuti ndivanaani vasipo pakati pedu.\" Vakati vadaro vakaona kuti Jonatani nomubati wake wenhumbi dzokurwa vakanga vasipo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.17",
            "verseOrgIds": [
              "1SA.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauro akati kuna Ahiya, \"Uya neareka yaMwari.\" (Panguva iyoyo vaIsraeri ndivo vakanga vanayo.)",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.18",
            "verseOrgIds": [
              "1SA.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauro achiri kutaura nomuprista, mhirizhonga yakanyanyisa mumusasa wavaFiristia. Saka Sauro akati kumuprista, \"Dzosa ruoko rwako.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.19",
            "verseOrgIds": [
              "1SA.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Sauro navanhu vake vose vakaungana vakaenda kundorwa. Vakawana vaFiristia vari mumhirizhonga huru, vachibayana mumwe nomumwe neminondo yavo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.20",
            "verseOrgIds": [
              "1SA.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaHebheru vaya vakanga vari kuvaFiristia kare uye vakanga vaenda navo kumusasa wavo vakayambuka vakaenda kuvaIsraeri vakanga vana Sauro naJonatani.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.21",
            "verseOrgIds": [
              "1SA.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaIsraeri vaya vose vakanga vavanda munyika yezvikomo yeEfuremu pavakanzwa kuti vaFiristia vakanga votiza, vakateverawo muhondo vakavadzingirira zvikuru.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.22",
            "verseOrgIds": [
              "1SA.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Jehovha akarwira vaIsraeri pazuva iro, uye hondo yakaenderera mberi ikandopfuura Bheti Avheni.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.23",
            "verseOrgIds": [
              "1SA.14.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jonatani anodya Uchi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino varume veIsraeri vakaziya pazuva iro, nokuti Sauro akanga asunga vanhu nemhiko achiti, \"Ngaatukwe munhu anodya zvokudya kusati kwadoka, ndisati ndazvitsivira vavengi vangu!\" Saka hakuna munhu pavarwi akaravira chokudya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.24",
            "verseOrgIds": [
              "1SA.14.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hondo yose yakapinda musango, uye imomo maiva nouchi hwapasi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.25",
            "verseOrgIds": [
              "1SA.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vapinda musango, vakaona uchi huchiyerera, asi hakuna akaisa ruoko rwake kumuromo wake, nokuti vakanga vachitya mhiko.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.26",
            "verseOrgIds": [
              "1SA.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Jonatani akanga asina kunzwa kuti baba vake vakanga vasunga vanhu nemhiko, saka akatambanudza muromo wetsvimbo yakanga iri muruoko rwake akainyika muzinga rouchi. Akasimudzira ruoko rwake kumuromo wake, meso ake akabengenuka.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.27",
            "verseOrgIds": [
              "1SA.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mumwe wavarwi akati kwaari, \"Baba vako vasunga varwi nemhiko vachiti, 'Ngaatukwe munhu upi zvake anodya zvokudya nhasi!' Ndokusaka vanhu voziya.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.28",
            "verseOrgIds": [
              "1SA.14.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonatani akati, \"Baba vangu vanetsa nyika. Tarirai muone kuzaruka kwaita meso angu pandaravira chidimbu chouchi uhu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.29",
            "verseOrgIds": [
              "1SA.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvaiva nani sei dai vanhu vanga vadya nhasi zvimwe zvezvakapambwa zvavakatora kuvavengi vavo. Kuurayiwa kwavaFiristia hakwaizova kukuru here?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.30",
            "verseOrgIds": [
              "1SA.14.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musi iwoyo, shure kwokunge vaIsraeri vauraya vaFiristia kubva paMikimashi kusvika kuAijaroni, vakaneta kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.31",
            "verseOrgIds": [
              "1SA.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1SA 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakamhanyira zvakapambwa, uye vakatora makwai, mombe nemhuru, vakazviuraya pasi ipapo uye vakazvidya, pamwe chete neropa razvo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.32",
            "verseOrgIds": [
              "1SA.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1SA 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mumwe akati kuna Sauro, \"Tarirai vanhu vari kutadzira Jehovha nokudya nyama ine ropa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.33",
            "verseOrgIds": [
              "1SA.14.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 14:33"
      },
      "items": [
        {
          "text": "Iye akati, \"Maputsa kutenda. Kungurutsirai dombo guru kuno uku izvozvi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.33",
            "verseOrgIds": [
              "1SA.14.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1SA 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akati, \"Endai pakati pavanhu mugovataurira kuti, 'Mumwe nomumwe wenyu ngaauye nemombe yake, namakwai uye muzviurayire pano muzvidye. Musatadzira Jehovha muchidya nyama ichine ropa rayo.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.34",
            "verseOrgIds": [
              "1SA.14.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 14:34"
      },
      "items": [
        {
          "text": "Saka munhu wose akauya nenzombe yake usiku ihwohwo akaiuraya ipapo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.34",
            "verseOrgIds": [
              "1SA.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1SA 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Sauro akavakira Jehovha aritari; yakanga iri nguva yake yokutanga kuita izvi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.35",
            "verseOrgIds": [
              "1SA.14.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1SA 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauro akati, \"Ngatiburukei zasi titevere vaFiristia usiku tindovaparadza kusvikira mambakwedza, uye tirege kusiya kana mumwe wavo ari mupenyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.36",
            "verseOrgIds": [
              "1SA.14.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 14:36"
      },
      "items": [
        {
          "text": "Ivo vakapindura vakati, \"Itai zvamunoona kuti zvakanakisisa kwamuri.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.36",
            "verseOrgIds": [
              "1SA.14.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 14:36"
      },
      "items": [
        {
          "text": "Asi muprista akati, \"Ngatibvunzei Mwari pano.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.36",
            "verseOrgIds": [
              "1SA.14.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1SA 14:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Sauro akabvunza Mwari akati, \"Ndoburuka nditevere vaFiristia here? Muchavaisa mumaoko avaIsraeri here?\" Asi Mwari haana kumupindura musi iwoyo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.37",
            "verseOrgIds": [
              "1SA.14.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1SA 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo Sauro akati, \"Uyai pano, imi mose vatungamiri vehondo, Ngatitsvakei chivi chaitwa nhasi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.38",
            "verseOrgIds": [
              "1SA.14.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1SA 14:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvirokwazvo naJehovha, iye akanunura upenyu hwavaIsraeri, kunyange dai ari Jonatani mwanakomana wangu, anofanira kufa.\" Asi hapana kana mumwe wavarume akataura shoko.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.39",
            "verseOrgIds": [
              "1SA.14.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1SA 14:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Sauro akati kuvaIsraeri vose, \"Imi mirai uko; ini naJonatani mwanakomana wangu tichamira kuno uku.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.40",
            "verseOrgIds": [
              "1SA.14.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 14:40"
      },
      "items": [
        {
          "text": "Vanhu vakapindura vakati, \"Itai zvamunoona kuti zvakanakisisa kwamuri.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.40",
            "verseOrgIds": [
              "1SA.14.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1SA 14:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Sauro akanyengetera kuna Jehovha, Mwari waIsraeri akati, \"Ndipeiwo mhinduro yakarurama.\" Ipapo Jonatani naSauro vakabatwa nomujenya, vanhu vakawanikwa vasina mhosva.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.41",
            "verseOrgIds": [
              "1SA.14.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1SA 14:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauro akati, \"Kandai mujenya pakati pangu nomwanakomana wangu Jonatani.\" Ipapo Jonatani akabatwa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.42",
            "verseOrgIds": [
              "1SA.14.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1SA 14:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Sauro akati kuna Jonatani, \"Ndiudze zvawaita.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.43",
            "verseOrgIds": [
              "1SA.14.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 14:43"
      },
      "items": [
        {
          "text": "Saka Jonatani akati kwaari, \"Ndangoravira uchi ushoma nomuromo wetsvimbo yangu. Zvino ndinofanira kufa here?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.43",
            "verseOrgIds": [
              "1SA.14.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1SA 14:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauro akati, \"Mwari ngaandirove, ngaandirove kwazvo, kana iwe Jonatani ukasafa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.44",
            "verseOrgIds": [
              "1SA.14.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1SA 14:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vanhu vakati kuna Sauro, \"Jonatani angafanira kufa, iye akaponesa vaIsraeri nokuponesa kukuru kuya? Kwete! Zvirokwazvo naJehovha mupenyu, hakuna kana bvudzi romusoro wake richawira pasi, nokuti aita izvi nhasi achibatsirwa naMwari.\" Saka vanhu vakanunura Jonatani, uye haana kuurayiwa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.45",
            "verseOrgIds": [
              "1SA.14.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1SA 14:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Sauro akarega kutevera vaFiristia, uye vakadzokera kunyika yavo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.46",
            "verseOrgIds": [
              "1SA.14.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1SA 14:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwokugadzwa kwaSauro ushe pamusoro pavaIsraeri, akarwa navavengi vavo kumativi ose, vaiti: Moabhu, vaAmoni, Edhomu, madzimambo eZobha, navaFiristia. Kwose kwaakatendeukira, akavatambudza.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.47",
            "verseOrgIds": [
              "1SA.14.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1SA 14:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akarwa noumhare akakunda vaAmereki, akadzikinura vaIsraeri kubva mumaoko avaya vakanga vavapamba.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.48",
            "verseOrgIds": [
              "1SA.14.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mhuri yaSauro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1SA 14:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaSauro vaiva Jonatani, Ishivhi naMarikishua. Zita romwanasikana wake wedangwe rainzi Merabhi, uye romuduku rainzi Mikari.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.49",
            "verseOrgIds": [
              "1SA.14.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1SA 14:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zita romukadzi wake rainzi Ahinoami, mwanasikana waAhimaazi. Zita romutungamiri wehondo yaSauro rainzi Abhineri, mwanakomana waNeri, uye Neri akanga ari babamunini vaSauro.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.50",
            "verseOrgIds": [
              "1SA.14.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1SA 14:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kishi baba vaSauro naNeri baba vaAbhineri vakanga vari vanakomana vaAbhieri.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.51",
            "verseOrgIds": [
              "1SA.14.51"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1SA 14:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamazuva ose aSauro pakanga pane hondo huru kwazvo navaFiristia, uye Sauro aiti kana akaona munhu ane simba uye akashinga, aimutora omuita murwi wake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.52",
            "verseOrgIds": [
              "1SA.14.52"
            ]
          }
        }
      ]
    }
  ],
