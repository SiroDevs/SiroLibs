  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "1SA 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Samueri anotsiura Sauro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauro akanga ava namakore makumi matatu paakava mambo, uye akatonga Israeri kwamakore makumi mana namaviri.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.1",
            "verseOrgIds": [
              "1SA.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauro akasarudza varume vaIsraeri zviuru zvitatu; zviuru zviviri zvavo zvaiva naye paMikimashi nomunyika yamakomo yeBheteri, uye chiuru chimwe chete chaiva naJonatani paGibhea muBhenjamini. Vamwe vose akavadzosa kumisha yavo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.2",
            "verseOrgIds": [
              "1SA.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonatani akarwisa boka ravarwi vavaFiristia vakanga vari paGebha, vaFiristia vakazvinzwa. Uye Sauro akaridza hwamanda munyika yose akati, \"VaHebheru, inzwai!\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.3",
            "verseOrgIds": [
              "1SA.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Israeri yose yakanzwa nhau idzi dzokuti, \"Sauro arwisa boka ravaFiristia, Israeri yava chinhu chinonyangadza pamberi pavaFiristia.\" Zvino vanhu vakadanwa kuti vandobatana pamwe chete naSauro paGirigari.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.4",
            "verseOrgIds": [
              "1SA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaFiristia vakaungana kuti varwise Israeri, vane zviuru zvitatu zvengoro, nezviuru zvitatu zvavachairi vengoro, navarwi vakawanda sejecha remhenderekedzo dzegungwa. Vakaenda vakandodzika misasa paMikimashi, kumabvazuva kweBhetiavheni.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.5",
            "verseOrgIds": [
              "1SA.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume veIsraeri vakati vaona kuti zvinhu zvaipa uye kuti hondo yavo yakanga yamanikidzwa zvikuru, vakavanda mumapako nomumatenhere, pakati pamatombo, nomumakomba nomumigodhi yemvura.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.6",
            "verseOrgIds": [
              "1SA.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamwe vaHebheru vakatoyambuka Jorodhani vakaenda kunyika yeGadhi neGireadhi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.7",
            "verseOrgIds": [
              "1SA.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 13:7"
      },
      "items": [
        {
          "text": "Sauro akasara paGireadhi uye varwi vose vaaiva navo vakadedera nokutya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.7",
            "verseOrgIds": [
              "1SA.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamira kwamazuva manomwe, nguva yakanga yatarwa naSamueri; asi Samueri haana kuuya kuGirigari, uye varwi vaSauro vakatanga kupararira.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.8",
            "verseOrgIds": [
              "1SA.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka akati, \"Ndiunzirei chipiriso chinopiswa nezvipiriso zvokuyananisa.\" Ipapo Sauro akapa chipiriso chinopiswa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.9",
            "verseOrgIds": [
              "1SA.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achingopedza kupa chipiriso, Samueri akasvika, Sauro akaenda kundomukwazisa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.10",
            "verseOrgIds": [
              "1SA.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samueri akati, \"Waiteiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.11",
            "verseOrgIds": [
              "1SA.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 13:11"
      },
      "items": [
        {
          "text": "Sauro akapindura achiti, \"Pandaona kuti varume vava kupararira, uye kuti hamuna kusvika nenguva yakataurwa, uye kuti vaFiristia vava kuungana paMikimashi,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.11",
            "verseOrgIds": [
              "1SA.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndafunga kuti, 'Zvino vaFiristia vachauya kuzondirwisa paGirigari, uye handisati ndatsvaka nyasha dzaJehovha.' Naizvozvo ndazvimanikidza kuti ndipe chipiriso chinopiswa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.12",
            "verseOrgIds": [
              "1SA.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samueri akati, \"Waita zvoupenzi. Hauna kuchengeta murayiro wawakapiwa naJehovha Mwari wako; dai wanga wadaro, Jehovha angadai asimbisa umambo hwako pamusoro peIsraeri kwenguva yose.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.13",
            "verseOrgIds": [
              "1SA.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi iye zvino umambo hwako hahuchagari; Jehovha azvitsvakira munhu anofadza mwoyo wake, akamugadza kuti ave mutungamiri wavanhu vake, nokuti hauna kuchengeta murayiro waJehovha.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.14",
            "verseOrgIds": [
              "1SA.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Samueri akabva paGirigari akakwidza akaenda kuGibhea muBhenjamini, uye Sauro akaverenga varume vaakanga anavo. Vaikarosvika mazana matanhatu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.15",
            "verseOrgIds": [
              "1SA.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "VaIsraeri vanoshaya zvombo zvokurwa nazvo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauro nomwanakomana wake Jonatani navarume vaakanga anavo, vaigara muGibhea muBhenjamini, asi vaFiristia vakanga vakadzika misasa paMikimashi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.16",
            "verseOrgIds": [
              "1SA.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vapambi vakabuda mumisasa yavaFiristia vari mumapoka matatu. Rimwe boka rakananga kuOfira munharaunda yeShuari,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.17",
            "verseOrgIds": [
              "1SA.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "rimwe boka rakananga kuBhetihoroni, uye rechitatu rakananga kumuganhu wakatarisana noMupata weZebhoimi kurutivi rwerenje.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.18",
            "verseOrgIds": [
              "1SA.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino kwakanga kusina mupfuri munyika yeIsraeri nokuti vaFiristia vakanga vati, \"Zvichida vaHebheru vangagadzira minondo kana mapfumo!\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.19",
            "verseOrgIds": [
              "1SA.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo vaIsraeri vose vaidzika kuvaFiristia kuti vandorodzerwa miromo yamagejo, mapiki, matemo namajeko.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.20",
            "verseOrgIds": [
              "1SA.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muripo wokurodzesa miromo yamagejo, namapiki, waiva zvikamu zviviri kubva muzvitatu zveshekeri",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.21",
            "verseOrgIds": [
              "1SA.13.21"
            ]
          }
        },
        {
          "text": ", uye muripo wokurodzesa forogo namatemo, nezvibayiso zvemombe waiva chikamu chimwe chete kubva muzvitatu cheshekeri",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.21",
            "verseOrgIds": [
              "1SA.13.21"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.21",
            "verseOrgIds": [
              "1SA.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka pazuva rokurwa hapana murwi waSauro naJonatani aiva nomunondo kana pfumo muruoko rwake; Sauro chete nomwanakomana wake Jonatani ndivo vaiva nazvo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.22",
            "verseOrgIds": [
              "1SA.13.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino boka ravarwi ravaFiristia rakanga rabuda richienda kumupata weMikimashi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.23",
            "verseOrgIds": [
              "1SA.13.23"
            ]
          }
        }
      ]
    }
  ],
