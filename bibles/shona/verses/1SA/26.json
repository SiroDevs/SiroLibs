  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "1SA 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhavhidhi anoregazve kuuraya Sauro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaZifi vakaenda kuna Sauro paGibhea vakati, \"Ko, Dhavhidhi haana kuvanda pachikomo cheHakira, chakatarisana neJeshimoni here?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.1",
            "verseOrgIds": [
              "1SA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Sauro akaburuka akaenda kuRenje reZifi, ana varume zviuru zvitatu vakanga vasarudzwa pakati pavaIsraeri, kuti vandotsvaka Dhavhidhi ikoko.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.2",
            "verseOrgIds": [
              "1SA.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauro akaita musasa wake parutivi pomugwagwa uri pachikomo cheHakira chakatarisana neJeshimoni, asi Dhavhidhi akanga achigara murenje. Akati achiona kuti Sauro akanga amutevera imomo,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.3",
            "verseOrgIds": [
              "1SA.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "akatuma vasori akanzwa kuti Sauro akanga asvika, zvirokwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.4",
            "verseOrgIds": [
              "1SA.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Dhavhidhi akasimuka akaenda kunzvimbo kwakanga kwadzikwa musasa naSauro. Akaona pakanga pakavata Sauro naAbhineri mwanakomana waNeri mukuru wehondo. Sauro akanga akavata mukati momusasa, uye varwi vakavaka misasa yavo vakamupoteredza.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.5",
            "verseOrgIds": [
              "1SA.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Dhavhidhi akabvunza Ahimereki muHeti naAbhishai mwanakomana waZeruya, mununʼuna waJoabhu akati, \"Ndianiko achapinda neni mumusasa kuna Sauro?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.6",
            "verseOrgIds": [
              "1SA.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 26:6"
      },
      "items": [
        {
          "text": "Abhishai akati, \"Ndichaenda nemi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.6",
            "verseOrgIds": [
              "1SA.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Dhavhidhi naAbhishai vakaenda kuvarwi usiku, uye vakawana Sauro avete mukati momusasa, pfumo rake rakabayirwa pasi pedyo nomusoro wake. Abhineri navarwi vakanga vavete vakamupoteredza.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.7",
            "verseOrgIds": [
              "1SA.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhishai akati kuna Dhavhidhi, \"Nhasi Mwari aisa muvengi wenyu mumaoko enyu. Zvino regai ndimubayire pasi kamwe chete nepfumo rangu; handimbomubayi kaviri.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.8",
            "verseOrgIds": [
              "1SA.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Dhavhidhi akati kuna Abhishai, \"Usamuparadza! Ndianiko angagona kutambanudza ruoko rwake pamuzodziwa waJehovha akashaya mhosva?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.9",
            "verseOrgIds": [
              "1SA.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvirokwazvo naJehovha mupenyu, Jehovha pachake ndiye achamuuraya; zvimwe nguva yake ichasvika uye achafa, kana kuti achaenda kuhondo agofa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.10",
            "verseOrgIds": [
              "1SA.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Jehovha ngaandidzivise kuti ndirege kutambanudzira ruoko rwangu kumuzodziwa waJehovha. Zvino chitora pfumo nechirongo chemvura zviri pedyo nomusoro wake tiende.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.11",
            "verseOrgIds": [
              "1SA.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Dhavhidhi akatora pfumo nechirongo chemvura pedyo nomusoro waSauro, ivo ndokubvapo. Hakuna akaona kana kuziva nezvazvo, uye hakuna kana akamuka. Vose vakanga vavete, nokuti Jehovha akanga avapa hope huru.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.12",
            "verseOrgIds": [
              "1SA.26.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Dhavhidhi akayambuka akaenda kuno rumwe rutivi akandomira pamusoro pechikomo, chinhambwe chiri kure; pakanga pane nzvimbo yakafara pakati pavo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.13",
            "verseOrgIds": [
              "1SA.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akadanidzira kuvarwi nokuna Abhineri mwanakomana waNeri akati, \"Abhineri haundidaviri here?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.14",
            "verseOrgIds": [
              "1SA.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 26:14"
      },
      "items": [
        {
          "text": "Abhineri akapindura akati, \"Ndiwe aniko unodanidzira kuna mambo?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.14",
            "verseOrgIds": [
              "1SA.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akati, \"Uri murume, handizvo here? Uye ndianiko akaita sewe muIsraeri? Ko, wakaregererei kurinda ishe wako iye mambo? Mumwe akasvika kuzoparadza ishe wako iye mambo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.15",
            "verseOrgIds": [
              "1SA.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvawaita hazvina kunaka. Zvirokwazvo naJehovha mupenyu, iwe navanhu vako munofanira kufa, nokuti hamuna kurinda tenzi wenyu, iye muzodziwa waJehovha. Chitarira pauri. Ko, pfumo ramambo nechirongo chavo zvakanga zviri pedyo nomusoro wavo zviripi?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.16",
            "verseOrgIds": [
              "1SA.26.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauro akaziva inzwi raDhavhidhi akati, \"Ko, inzwi rako here Dhavhidhi mwanakomana wangu?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.17",
            "verseOrgIds": [
              "1SA.26.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 26:17"
      },
      "items": [
        {
          "text": "Dhavhidhi akapindura akati, \"Hongu ndiro, ishe wangu mambo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.17",
            "verseOrgIds": [
              "1SA.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatizve, \"Seiko ishe wangu achidzinganisa muranda wake? Ndakaiteiko, uye mhosva yandakapara ndeipiko?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.18",
            "verseOrgIds": [
              "1SA.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino ishe wangu mambo ngaateerere mashoko omuranda wake. Kana Jehovha akakukurudzirai kuti muzorwa neni, zvino ngaagamuchire chipiriso. Kana, zvakadaro hazvo, vari vanhu vakazviita, ngavatukwe pamberi paJehovha! Vakandidzinga zvino pamugove wangu panhaka yaJehovha vakati, 'Enda undoshumira vamwe vamwari.'",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.19",
            "verseOrgIds": [
              "1SA.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino ropa rangu ngarirege kuteukira pasi kure naJehovha. Mambo waIsraeri akabuda kuti azotsvaka nhata, somunhu anovhima chikwari mumakomo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.20",
            "verseOrgIds": [
              "1SA.26.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Sauro akati, \"Ndakatadza. Dzoka, Dhavhidhi mwanakomana wangu. Nokuti waona kukosha kwoupenyu hwangu nhasi, handichaedzi kukuuraya zvakare. Zvirokwazvo ndakaita sebenzi uye ndakatadza zvikuru.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.21",
            "verseOrgIds": [
              "1SA.26.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akati, \"Heri pfumo ramambo. Regai mumwe wamajaya enyu auye kuno azoritora.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.22",
            "verseOrgIds": [
              "1SA.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha anoripira munhu mumwe nomumwe nokuda kwokururama kwake uye nokutendeka kwake. Jehovha akuisai mumaoko angu nhasi, asi handina kuda kutambanudzira ruoko rwangu pamuzodziwa waJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.23",
            "verseOrgIds": [
              "1SA.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvirokwazvo sezvandakoshesa upenyu hwenyu nhasi, saizvozvo Jehovha ngaakoshese upenyu hwangu agondiponesa pamatambudziko ose.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.24",
            "verseOrgIds": [
              "1SA.26.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Sauro akati kuna Dhavhidhi, \"Iwe uropafadzwe, mwanakomana wangu Dhavhidhi; iwe uchaita zvinhu zvikuru uye zvirokwazvo uchakunda.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.25",
            "verseOrgIds": [
              "1SA.26.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 26:25"
      },
      "items": [
        {
          "text": "Saka Dhavhidhi akaenda hake, uye Sauro akadzokera kumusha.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.25",
            "verseOrgIds": [
              "1SA.26.25"
            ]
          }
        }
      ]
    }
  ],
