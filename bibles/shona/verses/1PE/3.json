  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "1PE 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vakadzi naVarume",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1PE 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saizvozvo nemiwo vakadzi, muzviise pasi pavarume venyu kuitira kuti, kana vamwe vavo vasingatendi shoko, vangadzorwa namafambiro avakadzi vavo pasina shoko rarehwa,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.1",
            "verseOrgIds": [
              "1PE.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "pavanoona kuchena nokuremekedzwa kwoupenyu hwenyu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.2",
            "verseOrgIds": [
              "1PE.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Runako rwenyu ngarurege kubva pakushonga kwokunze, kwakadai sebvudzi rakarukwa uye nokushonga zvishongo zvegoridhe nenguo dzakaisvonaka.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.3",
            "verseOrgIds": [
              "1PE.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi, runofanira kuva rwomunhu womukati, iko kunaka kusingaori kwounyoro nekwomweya wakapfava, kunova ndiko kunokosha pamberi paMwari.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.4",
            "verseOrgIds": [
              "1PE.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti vaizvishongedza saizvozvi vakadzi vatsvene vakare avo vaiisa tariro yavo muna Mwari. Vakanga vachizviisa pasi pavarume vavo chaivo,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.5",
            "verseOrgIds": [
              "1PE.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "saSara, akateerera Abhurahama akamuti ishe wake. Muri vanasikana vake kana muchiita zvakanaka uye musingapi kutya nzvimbo.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.6",
            "verseOrgIds": [
              "1PE.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saizvozvo, varume, garai zvakanaka navakadzi venyu, uye muvabate norukudzo somudziyo usina simba uye savadyi venhaka pamwe chete nemi, yechipo chinokosha choupenyu, kuti parege kuva nechinodzivisa minyengetero yenyu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.7",
            "verseOrgIds": [
              "1PE.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kutambudzika nokuda kwoKuita Zvakanaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1PE 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakupedzisira, imi mose, mugare norugare mumwe nomumwe wenyu; munzwirane ngoni, mudanane sehama, munzwirane tsitsi uye muzvininipise.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.8",
            "verseOrgIds": [
              "1PE.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Regai kudzorera chakaipa nechakaipa kana kutuka nokutuka, asi namaropafadzo, nokuti ndizvo zvamakadanirwa izvozvo kuitira kuti mugare nhaka yokuropafadzwa.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.9",
            "verseOrgIds": [
              "1PE.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.10",
            "verseOrgIds": [
              "1PE.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1PE 3:10"
      },
      "items": [
        {
          "text": "\"Uyo anoda upenyu",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.10",
            "verseOrgIds": [
              "1PE.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1PE 3:10"
      },
      "items": [
        {
          "text": "kuti agoona mazuva akanaka",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.10",
            "verseOrgIds": [
              "1PE.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1PE 3:10"
      },
      "items": [
        {
          "text": "anofanira kudzora rurimi rwake pane zvakaipa,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.10",
            "verseOrgIds": [
              "1PE.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1PE 3:10"
      },
      "items": [
        {
          "text": "nemiromo yake pakutaura zvinonyengera.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.10",
            "verseOrgIds": [
              "1PE.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anofanira kudzoka pane zvakaipa agoita zvakanaka;",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.11",
            "verseOrgIds": [
              "1PE.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1PE 3:11"
      },
      "items": [
        {
          "text": "anofanira kutsvaka rugare agorutevera.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.11",
            "verseOrgIds": [
              "1PE.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti meso aShe ari pamusoro pavakarurama,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.12",
            "verseOrgIds": [
              "1PE.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1PE 3:12"
      },
      "items": [
        {
          "text": "uye nzeve dzake dzakateerera kumunyengetero wavo,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.12",
            "verseOrgIds": [
              "1PE.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1PE 3:12"
      },
      "items": [
        {
          "text": "asi chiso chaShe chakanangana navaya vanoita zvakaipa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.12",
            "verseOrgIds": [
              "1PE.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1PE 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndianiko achakuitirai zvakaipa kana muchishingairira kuita zvakanaka?",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.13",
            "verseOrgIds": [
              "1PE.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kunyange dai mungatambudzika nokuda kwezvakanaka, makaropafadzwa imi. \"Murege kutya zvavanotya ivo; musavhundutswa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.14",
            "verseOrgIds": [
              "1PE.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1PE 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi mumwoyo menyu tsaurai Kristu saIshe. Mugare makazvigadzirira nguva dzose kupindura vose vanokubvunzai pamusoro petariro yamunayo. Asi muite izvozvo nounyoro uye nokukudza,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.15",
            "verseOrgIds": [
              "1PE.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1PE 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "muchichengeta hana yakachena, kuitira kuti vaya vanotaura zvakaipa pamusoro pamafambiro enyu akanaka muna Kristu vanyadziswe pakureva kwavo.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.16",
            "verseOrgIds": [
              "1PE.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zviri nani, kana kuri kuda kwaMwari, kuti mutambudzike nokuda kwokuita zvakanaka pano kuti mutambudzike nokuda kwokuita zvakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.17",
            "verseOrgIds": [
              "1PE.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1PE 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti Kristu akafira zvivi zvavose kamwe chete; akarurama nokuda kwavasakarurama, kuti akuuyisei kuna Mwari. Akaurayiwa mumuviri asi akararamiswa noMweya,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.18",
            "verseOrgIds": [
              "1PE.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1PE 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nawo akaendawo akandoparidza kumweya yakanga iri mutorongo",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.19",
            "verseOrgIds": [
              "1PE.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1PE 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "yakaramba kuteerera kare Mwari paakanga akamirira nomwoyo murefu mumazuva aNoa, areka payakanga ichiri kuvakwa. Mairi, vanhu vashoma bedzi, ivo vasere, vakaponeswa nemvura,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.20",
            "verseOrgIds": [
              "1PE.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1PE 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye mvura iyi inofananidzira rubhabhatidzo runokuponesaiwo zvino, rusingarevi kubviswa kwetsvina yomuviri asi rubatso rwehana yakanaka kuna Mwari. Inokuponesai nokumuka kwaJesu Kristu,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.21",
            "verseOrgIds": [
              "1PE.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1PE 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "iye akapinda mudenga uye ari kuruoko rworudyi rwaMwari, vatumwa namasimba noushe zviri pasi pake.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.22",
            "verseOrgIds": [
              "1PE.3.22"
            ]
          }
        }
      ]
    }
  ],
