    "verseCount": 21,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "1",
          "style": "c",
          "sid": "OBA 1"
        },
        "items": [
          {
            "text": "1",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "OBA 1:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Zvakaratidzwa Obhadhia.",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.1",
              "verseOrgIds": [
                "OBA.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p",
          "vid": "OBA 1:1"
        },
        "items": [
          {
            "text": "Zvanzi naIshe Jehovha pamusoro peEdhomu:",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.1",
              "verseOrgIds": [
                "OBA.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1",
          "vid": "OBA 1:1"
        },
        "items": [
          {
            "text": "Takanzwa shoko rakabva kuna Jehovha richiti:",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.1",
              "verseOrgIds": [
                "OBA.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:1"
        },
        "items": [
          {
            "text": "Nhume yakatumwa kundudzi kuti indotaura ichiti,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.1",
              "verseOrgIds": [
                "OBA.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1",
          "vid": "OBA 1:1"
        },
        "items": [
          {
            "text": "\"Simukai, tiende tindorwa hondo naye.\"",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.1",
              "verseOrgIds": [
                "OBA.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "OBA 1:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "\"Tarirai, ndichakudukupisai pakati pendudzi;",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.2",
              "verseOrgIds": [
                "OBA.1.2"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:2"
        },
        "items": [
          {
            "text": "muchamhurwa zvachose.",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.2",
              "verseOrgIds": [
                "OBA.1.2"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "OBA 1:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Kuzvikudza kwemwoyo yenyu kwakakunyengerai,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.3",
              "verseOrgIds": [
                "OBA.1.3"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:3"
        },
        "items": [
          {
            "text": "iyemi mugere mumikaha yamatombo",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.3",
              "verseOrgIds": [
                "OBA.1.3"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:3"
        },
        "items": [
          {
            "text": "muchiita kwakakwirira misha yenyu,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.3",
              "verseOrgIds": [
                "OBA.1.3"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1",
          "vid": "OBA 1:3"
        },
        "items": [
          {
            "text": "imi munoti mumwoyo yenyu,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.3",
              "verseOrgIds": [
                "OBA.1.3"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:3"
        },
        "items": [
          {
            "text": "'Ndianiko angandiburutsira pasi?'",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.3",
              "verseOrgIds": [
                "OBA.1.3"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "OBA 1:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Kunyange mukabhururuka segondo",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.4",
              "verseOrgIds": [
                "OBA.1.4"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:4"
        },
        "items": [
          {
            "text": "mukaruka dendere renyu pakati penyeredzi,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.4",
              "verseOrgIds": [
                "OBA.1.4"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:4"
        },
        "items": [
          {
            "text": "kubva ipapo ndichakukandai pasi,\"",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.4",
              "verseOrgIds": [
                "OBA.1.4"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q4",
          "vid": "OBA 1:4"
        },
        "items": [
          {
            "text": "ndizvo zvinotaura Jehovha.",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "OBA 1:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "\"Kana mbavha dzikauya kwamuri,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.5",
              "verseOrgIds": [
                "OBA.1.5"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:5"
        },
        "items": [
          {
            "text": "kana makororo usiku,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.5",
              "verseOrgIds": [
                "OBA.1.5"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1",
          "vid": "OBA 1:5"
        },
        "items": [
          {
            "text": "haiwa, muchaparadzwa zvakadiniko?",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.5",
              "verseOrgIds": [
                "OBA.1.5"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:5"
        },
        "items": [
          {
            "text": "Havazoba kusvikira pavanoda here?",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.5",
              "verseOrgIds": [
                "OBA.1.5"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1",
          "vid": "OBA 1:5"
        },
        "items": [
          {
            "text": "Dai vatanhi vamazambiringa vaiuya kwamuri,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.5",
              "verseOrgIds": [
                "OBA.1.5"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:5"
        },
        "items": [
          {
            "text": "ko, havaizosiya mazambiringa mashoma here?",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.5",
              "verseOrgIds": [
                "OBA.1.5"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "OBA 1:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Asi Esau achasiyiwa seiko asina chinhu,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.6",
              "verseOrgIds": [
                "OBA.1.6"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:6"
        },
        "items": [
          {
            "text": "pfuma yake yakavigwa ichatorwa!",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.6",
              "verseOrgIds": [
                "OBA.1.6"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "OBA 1:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Vose vaiva nesungano newe vachakumanikidza kusvikira kumuganhu;",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.7",
              "verseOrgIds": [
                "OBA.1.7"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:7"
        },
        "items": [
          {
            "text": "shamwari dzako dzichakunyengera dzigokukunda;",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.7",
              "verseOrgIds": [
                "OBA.1.7"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1",
          "vid": "OBA 1:7"
        },
        "items": [
          {
            "text": "vanodya zvokudya zvako vachakuisira musungo,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.7",
              "verseOrgIds": [
                "OBA.1.7"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:7"
        },
        "items": [
          {
            "text": "asi haungazvizivi.",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.7",
              "verseOrgIds": [
                "OBA.1.7"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "OBA 1:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "\"Pazuva iro,\" ndizvo zvinotaura Jehovha,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.8",
              "verseOrgIds": [
                "OBA.1.8"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:8"
        },
        "items": [
          {
            "text": "\"handingazoparadzi vachenjeri veEdhomu,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.8",
              "verseOrgIds": [
                "OBA.1.8"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:8"
        },
        "items": [
          {
            "text": "varume vazere nokunzwisisa pakati pamakomo eEdhomu here?",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.8",
              "verseOrgIds": [
                "OBA.1.8"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "OBA 1:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Mhare dzako, iwe Temani,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.9",
              "verseOrgIds": [
                "OBA.1.9"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:9"
        },
        "items": [
          {
            "text": "dzichavhunduka,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.9",
              "verseOrgIds": [
                "OBA.1.9"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:9"
        },
        "items": [
          {
            "text": "uye vose vari mumakomo aEsau vachaparara pakuurayiwa ikoko.",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.9",
              "verseOrgIds": [
                "OBA.1.9"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "OBA 1:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nokuda kwokuti wakarwisa mununʼuna wako Jakobho,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.10",
              "verseOrgIds": [
                "OBA.1.10"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:10"
        },
        "items": [
          {
            "text": "uchafukidzwa nenyadzi;",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.10",
              "verseOrgIds": [
                "OBA.1.10"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:10"
        },
        "items": [
          {
            "text": "uchaparadzwa nokusingaperi.",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.10",
              "verseOrgIds": [
                "OBA.1.10"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "OBA 1:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Zuva iro rawakamira kure,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.11",
              "verseOrgIds": [
                "OBA.1.11"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:11"
        },
        "items": [
          {
            "text": "vatorwa pavakatakura pfuma yake vakaenda nayo,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.11",
              "verseOrgIds": [
                "OBA.1.11"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1",
          "vid": "OBA 1:11"
        },
        "items": [
          {
            "text": "uye vabvakure vakapinda mumasuo ake,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.11",
              "verseOrgIds": [
                "OBA.1.11"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:11"
        },
        "items": [
          {
            "text": "vakakanda mijenya pamusoro peJerusarema,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.11",
              "verseOrgIds": [
                "OBA.1.11"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:11"
        },
        "items": [
          {
            "text": "iwe wakaita somumwe wavo.",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.11",
              "verseOrgIds": [
                "OBA.1.11"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
