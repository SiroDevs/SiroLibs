        "sid": "1CH 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mapoka eHondo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya ndiwo mazita avaIsraeri, vakuru vemhuri, vatungamiri vezviuru navatungamiri vamazana, namachinda avo, vaishandira mambo mune zvose pamusoro pamapoka avarwi ainge ari pabasa mwedzi nomwedzi mugore rose. Boka rimwe nerimwe raiva navarume zviuru makumi maviri nezvina.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aitungamirira boka rokutanga mwedzi wokutanga, aiva Jashobheami mwanakomana waZabhidhieri. Muboka rake maiva navarume zviuru makumi maviri nezvina.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.2",
            "verseOrgIds": [
              "1CH.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aiva chizvarwa chaPerezi uyewo ari mukuru wavakuru vavavarwi vose mumwedzi wokutanga.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.3",
            "verseOrgIds": [
              "1CH.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aitungamirira boka remwedzi wechipiri ainzi Dhodhai muAhohi; Mikiroti ndiye aiva mutungamiri weboka rake. Muboka rake maiva nezviuru makumi maviri nezvina.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.4",
            "verseOrgIds": [
              "1CH.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukuru wavarwi wechitatu mumwedzi wechitatu ainzi Bhenaya mwanakomana waJehoyadha muprista. Ndiye aiva mukuru uye muboka rake maiva navarume zviuru makumi maviri nezvina.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.5",
            "verseOrgIds": [
              "1CH.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyu ndiye Bhenaya uya aiva mumwe woumhare pakati paMakumi Matatu uye aiva pamusoro paMakumi Matatu vacho. Mwanakomana wake Amizabhadhi ndiye aitungamirira boka rake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.6",
            "verseOrgIds": [
              "1CH.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wechina pamwedzi wechina, aiva Asaheri mununʼuna waJoabhu; mwanakomana wake Zebhadhia ndiye akamutevera pakutungamirira boka iri. Muboka rake maiva navarume zviuru makumi maviri nezvina.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.7",
            "verseOrgIds": [
              "1CH.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wechishanu pamwedzi wechishanu, aiva mutungamiri Shamihuti muIzirahi. Muboka rake maiva navarume zviuru makumi maviri nezvina.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.8",
            "verseOrgIds": [
              "1CH.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wechitanhatu pamwedzi wechitanhatu, aiva Ira mwanakomana waIkeshi muTeko. Muboka rake maiva navarume zviuru makumi maviri nezvina.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.9",
            "verseOrgIds": [
              "1CH.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wechinomwe pamwedzi wechinomwe, aiva Herezi muPeroni, muEfuremu. Muboka rake maiva navarume zviuru makumi maviri nezvina.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.10",
            "verseOrgIds": [
              "1CH.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worusere, pamwedzi worusere, aiva Sibhekai muHushati muZerahi. Muboka rake maiva navarume zviuru makumi maviri nezvina.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.11",
            "verseOrgIds": [
              "1CH.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wechipfumbamwe, mumwedzi wechipfumbamwe, aiva Abhiezeri muAnatoti, muBhenjamini. Muboka rake maiva navarume zviuru makumi maviri nezvina.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.12",
            "verseOrgIds": [
              "1CH.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wegumi, mumwedzi wegumi, aiva Maharai muNetofati, muZerahi. Muboka rake maiva navarume zviuru makumi maviri nezvina.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.13",
            "verseOrgIds": [
              "1CH.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wegumi nomumwe, mumwedzi wegumi nomumwe, aiva Bhenaya muPiratoni, muEfuremu. Muboka rake maiva navarume zviuru makumi maviri nezvina.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.14",
            "verseOrgIds": [
              "1CH.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wegumi navaviri, mumwedzi wegumi nemiviri, aiva Heridhai muNetofati, aibva mumhuri yaOtinieri. Muboka rake maiva navarume zviuru makumi maviri nezvina.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.15",
            "verseOrgIds": [
              "1CH.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Machinda aMarudzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Machinda pamusoro pamarudzi aIsraeri aiti:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1CH 27:16"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 27:16"
      },
      "items": [
        {
          "text": "pamusoro pavaRubheni: Eriezeri mwanakomana waZikiri;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.16",
            "verseOrgIds": [
              "1CH.27.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 27:16"
      },
      "items": [
        {
          "text": "pamusoro pavaSimeoni: Shefatia mwanakomana waMaaka;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.16",
            "verseOrgIds": [
              "1CH.27.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamusoro paRevhi: Hashabhia mwanakomana waKemueri;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.17",
            "verseOrgIds": [
              "1CH.27.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 27:17"
      },
      "items": [
        {
          "text": "pamusoro paAroni: Zadhoki;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.17",
            "verseOrgIds": [
              "1CH.27.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamusoro paJudha: Erihu, mununʼuna waDhavhidhi;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.18",
            "verseOrgIds": [
              "1CH.27.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 27:18"
      },
      "items": [
        {
          "text": "pamusoro paIsakari: Omiri mwanakomana waMikaeri;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.18",
            "verseOrgIds": [
              "1CH.27.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamusoro paZebhuruni: Ishimaya mwanakomana waObhadhia;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.19",
            "verseOrgIds": [
              "1CH.27.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 27:19"
      },
      "items": [
        {
          "text": "pamusoro paNafutari: Jerimoti mwanakomana waAzirieri;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.19",
            "verseOrgIds": [
              "1CH.27.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamusoro pavaEfuremu: Hoshea mwanakomana waAzazia;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.20",
            "verseOrgIds": [
              "1CH.27.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 27:20"
      },
      "items": [
        {
          "text": "pamusoro pehafu yorudzi rwaManase: Joere mwanakomana waPedhaya;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.20",
            "verseOrgIds": [
              "1CH.27.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamusoro pehafu yorudzi rwaManase muGireadhi: Idho mwanakomana waZekaria;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.21",
            "verseOrgIds": [
              "1CH.27.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 27:21"
      },
      "items": [
        {
          "text": "pamusoro paBhenjamini: Jaasieri mwanakomana waAbhineri;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.21",
            "verseOrgIds": [
              "1CH.27.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamusoro paDhani: Azareri mwanakomana waJerohamu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.22",
            "verseOrgIds": [
              "1CH.27.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1CH 27:22"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "1CH 27:22"
      },
      "items": [
        {
          "text": "Ava ndivo vaiva machinda pamusoro pamarudzi avaIsraeri.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi haana kuverenga varume vaiva namakore makumi maviri zvichidzika, nokuti Jehovha akanga avimbisa kuti vaIsraeri vaizowanda senyeredzi dziri mudenga.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.23",
            "verseOrgIds": [
              "1CH.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabhu mwanakomana waZeruya akatanga kuverenga varume ava asi haana kuzopedza. Kutsamwa kwakauya pamusoro peIsraeri nokuda kwokuverengwa uku, saka uwandu uhu hahuna kuiswa mubhuku renhoroondo dzegore negore raMambo Dhavhidhi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.24",
            "verseOrgIds": [
              "1CH.27.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vatariri vaMambo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azimavheti mwanakomana waAdhieri aiva muchengeti wamatura amambo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.25",
            "verseOrgIds": [
              "1CH.27.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 27:25"
      },
      "items": [
        {
          "text": "Jonatani mwanakomana waUzia aiva muchengeti wamatura kumaruwa okure, mumaguta, mumisha neshongwe dzavarindi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.25",
            "verseOrgIds": [
              "1CH.27.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eziri mwanakomana waKerubhi aiva mutariri pamusoro wavashandi vairima minda.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.26",
            "verseOrgIds": [
              "1CH.27.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimei muRamati aiva mutariri weminda yemizambiringa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.27",
            "verseOrgIds": [
              "1CH.27.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 27:27"
      },
      "items": [
        {
          "text": "Zabhidhi muShifimi aiva mutariri wezvibereko zveminda yemizambiringa zvokuzoisa muzvirongo zvewaini.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.27",
            "verseOrgIds": [
              "1CH.27.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 27:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhaari-Hanani muGedheri aiva mutariri wemiorivhi nemionde yakanga iri mujinga mezvikomo zvokumadokero.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.28",
            "verseOrgIds": [
              "1CH.27.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 27:28"
      },
      "items": [
        {
          "text": "Joashi aiva mutariri wamafuta omuorivhi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.28",
            "verseOrgIds": [
              "1CH.27.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shitirai muSharoni, aiva mutariri wemombe dzaifura muSharoni.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.29",
            "verseOrgIds": [
              "1CH.27.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 27:29"
      },
      "items": [
        {
          "text": "Shafati mwanakomana waAdhirai ndiye aiva mutariri wemombe dzaiva mumipata.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.29",
            "verseOrgIds": [
              "1CH.27.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 27:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obhiri muIshumaeri aiva mutariri wengamera.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.30",
            "verseOrgIds": [
              "1CH.27.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 27:30"
      },
      "items": [
        {
          "text": "Jedheya muMeronoti aiva mutariri wembongoro.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.30",
            "verseOrgIds": [
              "1CH.27.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jazizi muHagiri aiva mutariri wamakwai.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.31",
            "verseOrgIds": [
              "1CH.27.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "1CH 27:31"
      },
      "items": [
        {
          "text": "Ava ndivo vaiva vabati vaichengeta pfuma yaMambo Dhavhidhi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonatani, babamunini vaDhavhidhi vaiva mupi wamazano, murume woruzivo nomunyori.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.32",
            "verseOrgIds": [
              "1CH.27.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 27:32"
      },
      "items": [
        {
          "text": "Jehieri mwanakomana waHakimoni aiva muchengeti wavanakomana vamambo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.32",
            "verseOrgIds": [
              "1CH.27.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahitoferi aiva mupi wamazano kuna mambo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.33",
            "verseOrgIds": [
              "1CH.27.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 27:33"
      },
      "items": [
        {
          "text": "Hushai muAriki aiva shamwari yamambo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.33",
            "verseOrgIds": [
              "1CH.27.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 27:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Ahitoferi akazoteverwa pachinzvimbo naJehoyadha mwanakomana waBhenaya uye naAbhiatari.)",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 27:34"
      },
      "items": [
        {
          "text": "Joabhu ndiye aiva mutungamiri wehondo yamambo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.34",
            "verseOrgIds": [
              "1CH.27.34"
            ]
          }
        }
      ]
    }
  ],
