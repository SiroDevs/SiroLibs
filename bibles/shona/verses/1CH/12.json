{
  "id": "1CH.12",
  "number": "12",
  "bookId": "1CH",
  "reference": "1 Makoronike 12",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "1CH 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Varwi vanobatana naDhavhidhi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ava ndivo varume vakauya kuna Dhavhidhi paZikiragi achakavanda nokuda kwaSauro mwanakomana waKishi; uye ndivo vamwe vavarwi vakamubatsira muhondo.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakanga vapakata uta uye vaigona kupfura miseve nezvimviriri noruoko rworudyi kana rworuboshwe; vaiva hama dzaSauro dzokurudzi rwaBhenjamini.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahiezeri, mukuru wavo, naJoashi, vanakomana vaShemaya muGibheati;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.3",
            "verseOrgIds": [
              "1CH.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 12:3"
      },
      "items": [
        {
          "text": "Jezieri naPereti vanakomana vaAzimavheti;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.3",
            "verseOrgIds": [
              "1CH.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 12:3"
      },
      "items": [
        {
          "text": "Bheraka, Jehu muAnatoti,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.3",
            "verseOrgIds": [
              "1CH.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "naIshimaya muGibheoni, aiva mhare pakati paMakumi Matatu; aiva mutungamiri waMakumi Matatu;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.4",
            "verseOrgIds": [
              "1CH.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 12:4"
      },
      "items": [
        {
          "text": "Jeremia, Jahazieri, Johanani; Jozabadhi muGedherati,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.4",
            "verseOrgIds": [
              "1CH.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eruzai, Jerimoti, Bhearia, Shemaria naShafatia muHarufi;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.5",
            "verseOrgIds": [
              "1CH.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erikana, Ishiya, Azareri, Joezeri naJashobheami vaKorahi;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.6",
            "verseOrgIds": [
              "1CH.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "naJoera naZebhadhia vanakomana vaJehoramu vaibva kuGedhori.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.7",
            "verseOrgIds": [
              "1CH.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamwe vaGadhi vakazvitsaurawo vakaenda kwaiva naDhavhidhi kunhare yake kurenje. Vaiva varwi vakashinga, vakagadzirira kurwa uye vaigona kubata nhoo nepfumo. Zviso zvavo zvaiva zviso zveshumba, uye vaimhanya semharapara mumakomo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.8",
            "verseOrgIds": [
              "1CH.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezeri ndiye aiva mukuru,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.9",
            "verseOrgIds": [
              "1CH.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 12:9"
      },
      "items": [
        {
          "text": "Obhadhia ari wechipiri, Eriabhi ari wechitatu,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.9",
            "verseOrgIds": [
              "1CH.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mishimana wechina, Jeremia wechishanu,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.10",
            "verseOrgIds": [
              "1CH.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atai wechitanhatu, Erieri wechinomwe,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.11",
            "verseOrgIds": [
              "1CH.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Johanani worusere, Erizabhadhi wechipfumbamwe,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.12",
            "verseOrgIds": [
              "1CH.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeremia wegumi naMakibhanai wegumi nomumwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.13",
            "verseOrgIds": [
              "1CH.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaGadhi ava ndivo vaiva vatungamiriri vamauto, mudiki ainge akaenzana nezana, uye mukuru ainge akaenzana nechiuru.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.14",
            "verseOrgIds": [
              "1CH.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivava ndivo vaya vakayambuka Jorodhani mumwedzi wokutanga parwainge rwakazara nokumahombekombe uye vakaita kuti vanhu vose vaigara mumipata, kumabvazuva nokumavirira, vatize.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.15",
            "verseOrgIds": [
              "1CH.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamwe vaBhenjamini navamwe varume vaibva kuJudha vakauyawo kuna Dhavhidhi munhare yake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.16",
            "verseOrgIds": [
              "1CH.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akaenda kundosangana navo akati kwavari, \"Kana mauya kwandiri norugare, kuzondibatsira, ndakagadzirira kuti mubatane neni. Asi kana mauya kuzonditengesa kuvavengi vangu iwo maoko angu asina kuita zvechisimba, Mwari wamadzibaba edu ngaazvione uye akutongei.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.17",
            "verseOrgIds": [
              "1CH.12.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mweya wakauya pana Amasi mukuru waMakumi Matatu akati,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.18",
            "verseOrgIds": [
              "1CH.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1CH 12:18"
      },
      "items": [
        {
          "text": "\"Haiwa Dhavhidhi, tiri vako!",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.18",
            "verseOrgIds": [
              "1CH.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 12:18"
      },
      "items": [
        {
          "text": "Haiwa mwanakomana waJese, tinewe!",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.18",
            "verseOrgIds": [
              "1CH.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1CH 12:18"
      },
      "items": [
        {
          "text": "Kubudirira, kubudirira ngakuve kwauri,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.18",
            "verseOrgIds": [
              "1CH.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 12:18"
      },
      "items": [
        {
          "text": "uye kubudirira ngakuve kuna vanokubatsira",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.18",
            "verseOrgIds": [
              "1CH.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q3",
        "vid": "1CH 12:18"
      },
      "items": [
        {
          "text": "nokuti Mwari wako achakubatsira.\"",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 12:18"
      },
      "items": [
        {
          "text": "Saka Dhavhidhi akavagamuchira akavaita vatungamiri veboka ravarwi vake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.18",
            "verseOrgIds": [
              "1CH.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamwe varume vokwaManase vakabatana naDhavhidhi paakaenda navaFiristia kundorwisa Sauro. Iye navanhu vake havana kubatsira vaFiristia nokuti, vapedza kubvunzana, vatongi vavo vakamudzosa vakati, \"Zvichatiurayisa kana akazotitiza akandobatana namambo wake Sauro.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.19",
            "verseOrgIds": [
              "1CH.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi paakaenda kuZikiragi, ava ndivo vaiva varume vokwaManase vakabatana naye: Adhina, Jozabhadhi, Jedhieri, Mikaeri, Jozabhadhi, Erihu naZiretai, vatungamiri vemapoka echiuru muna Manase.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.20",
            "verseOrgIds": [
              "1CH.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakabatsira Dhavhidhi paairwisana namapoka amakororo, nokuti vose vakanga vari varwi vakashinga uye vaiva vatungamiri muhondo yake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.21",
            "verseOrgIds": [
              "1CH.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zuva nezuva varume vakauya kuzobatsira Dhavhidhi kusvikira ava nehondo huru kwazvo, sehondo yaMwari.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.22",
            "verseOrgIds": [
              "1CH.12.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vamwe vanobatana naDhavhidhi paHebhuroni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ndiko kuwanda kwavarume vakanga vakapakata zvombo kuti vandorwa, vakauya kuna Dhavhidhi paHebhuroni kuti vatore umambo hwaSauro vahupe kwaari, sezvazvakanga zvarehwa naJehovha:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume vokwaJudha vakanga vakapakata nhoo namapfumo vaiva zviuru zvitanhatu namazana masere uye akapakata zvombo kuti vandorwa;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.24",
            "verseOrgIds": [
              "1CH.12.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "varume vokwaSimeoni, varwi vakanga vakagadzirira kundorwa vaiva zviuru zvinomwe nezana;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.25",
            "verseOrgIds": [
              "1CH.12.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "varume vokwaRevhi zviuru zvina namazana matanhatu,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.26",
            "verseOrgIds": [
              "1CH.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamwe chete naJehoyadha, mutungamiri wemhuri yaAroni aiva navarume zviuru zvitatu namazana manomwe,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.27",
            "verseOrgIds": [
              "1CH.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "naZadhoki, murwi wechidiki aiva akashinga, navakuru vamapoka makumi maviri navaviri kubva kumhuri yake;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.28",
            "verseOrgIds": [
              "1CH.12.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "varume vokwaBhenjamini, hama dzaSauro vaiva zviuru zvitatu vazhinji vavo vakanga vamboramba vachitevera Sauro kusvikira musi uyu;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.29",
            "verseOrgIds": [
              "1CH.12.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "varume vokwaEfuremu varwi vakashinga vaiva nomukurumbira kwazvo kumhuri dzavo vaiva zviuru makumi maviri namazana masere;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.30",
            "verseOrgIds": [
              "1CH.12.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "varume vokuhafu yorudzi rwaManase vakadanwa namazita avo kuti vauye vazogadza Dhavhidhi umambo vaiva zviuru gumi nezvisere;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.31",
            "verseOrgIds": [
              "1CH.12.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "varume vokwaIsakari vainzwisisa nguva uye vaiziva kuti Israeri yaifanira kuitei, vaiva vakuru mazana maviri nehama dzavo dzose dzaiva pasi pavo;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.32",
            "verseOrgIds": [
              "1CH.12.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "varume vokwaZebhuruni, varwi vaiziva, vakanga vakagadzirira kurwa nezvombo zvemhando dzose, vakauya kuzobatsira Dhavhidhi nomwoyo wakaperera, vaiva zviuru makumi mashanu;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.33",
            "verseOrgIds": [
              "1CH.12.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "varume vokwaNafutari vaiva chiuru chavakuru vamapoka, pamwe chete nezviuru makumi matatu nezvinomwe zvavarume vakanga vakatakura nhoo namapfumo;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.34",
            "verseOrgIds": [
              "1CH.12.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "varume vokwaDhani, vakanga vakagadzirira kurwa, zviuru makumi maviri nezvisere namazana matanhatu;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.35",
            "verseOrgIds": [
              "1CH.12.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "varume vokwaAsheri, vakanga vane unyanzvi hwokurwa uye vakagadzirira kurwa, vaiva zviuru makumi mana;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.36",
            "verseOrgIds": [
              "1CH.12.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye kubva kumabvazuva aJorodhani, varume vokwaRubheni, Gadhi nehafu yorudzi rwaManase vakanga vakapakata zvombo zvemhando dzose, vaiva zviuru zana namakumi maviri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.37",
            "verseOrgIds": [
              "1CH.12.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ava vose vaiva varume vokurwa vakazvipira kundorwa.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1CH 12:38"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 12:38"
      },
      "items": [
        {
          "text": "Vakauya paHebhuroni vakagadzirira zvizere kuzogadza Dhavhidhi kuti ave mambo weIsraeri. Vamwe vaIsraeri vose vaiva nomwoyo mumwe chete wokuti vaite Dhavhidhi mambo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.38",
            "verseOrgIds": [
              "1CH.12.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume vakagara mazuva matatu ipapo vaina Dhavhidhi vachidya uye vachinwa nokuti mhuri dzavo dzainge dzavavigira zvokudya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.39",
            "verseOrgIds": [
              "1CH.12.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyewo, vavakidzani vavo vokure kwazvo kunyange kwaIsakari, kwaZebhuruni nokwaNafutari vakauya nezvokudya zviri pambongoro, ngamera, manyurusi nenzombe. Pakanga paine zvokudya zvizhinji kwazvo zvaiti upfu, makeke amaonde, makeke amazambiringa akaoma, waini, mafuta, nzombe, namakwai nokuti mufaro wakanga uripo pakati peIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.40",
            "verseOrgIds": [
              "1CH.12.41"
            ]
          }
        }
      ]
    }
  ],
