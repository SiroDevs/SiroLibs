  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "1CH 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kukunda kwaDhavhidhi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokufamba kwenguva, Dhavhidhi akakunda vaFiristia akavaisa pasi pake, uye akavatorera Gati nemisha yakaripoteredza kuti ribve pasi poruoko rwavaFiristia.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.1",
            "verseOrgIds": [
              "1CH.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akakundawo vaMoabhu, uye vakava pasi pake, vakamuvigira mutero.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.2",
            "verseOrgIds": [
              "1CH.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamusoro pezvo Dhavhidhi akarwisa Hadhadhezeri mambo weZobha kusvikira kuHamati, paakaenda kundosimbisa kutonga kwake achitevedza Rwizi Yufuratesi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.3",
            "verseOrgIds": [
              "1CH.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akapamba chiuru chengoro dzake, vachairi vengoro zviuru zvinomwe navarwi vetsoka zviuru makumi maviri. Akadimbura marunda amakumbo amabhiza ose kusara kwezana ramabhiza engoro.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.4",
            "verseOrgIds": [
              "1CH.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaAramu veDhamasiko pavakauya kuzobatsira Hadhadhezeri mambo weZobha, Dhavhidhi akauraya zviuru makumi maviri nezviviri zvavo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.5",
            "verseOrgIds": [
              "1CH.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaisa mapoka avarwi vake muumambo hwavaAramu veDhamasiko, uye vaAramu vakava pasi pake uye vakamuvigira mutero. Jehovha akapa Dhavhidhi kukunda kwose kwose kwaakaenda.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.6",
            "verseOrgIds": [
              "1CH.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akatora nhoo dzegoridhe dzaiva dzakatakurwa navatungamiri vehondo yaHadhadhezeri akaenda nadzo kuJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.7",
            "verseOrgIds": [
              "1CH.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubva kuTebha nokuKuni, maguta aHadhadhezeri, Dhavhidhi akatora ndarira zhinji, yakazoshandiswa naSoromoni kugadzira gungwa rendarira, nembiru uye nezvimwe zvinhu zvakasiyana-siyana zvakazogadzirwa nendarira.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.8",
            "verseOrgIds": [
              "1CH.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tou mambo weHamati paakanzwa kuti Dhavhidhi akanga akunda hondo yose yaHadhadhezeri mambo weZobha,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.9",
            "verseOrgIds": [
              "1CH.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "akatuma mwanakomana wake Hadhoramu akauya nezvinhu zvamarudzi ose zvegoridhe nesirivha nendarira.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.10",
            "verseOrgIds": [
              "1CH.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo Dhavhidhi akakumikidza zvipo izvi kuna Jehovha sezvaakanga aita nesirivha negoridhe, zvaakanga atora kubva kundudzi idzi dzose dzaiti: Edhomu, Moabhu, vaAmoni, vaFiristia neAmareki.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.11",
            "verseOrgIds": [
              "1CH.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhishai mwanakomana waZeruya akauraya vaEdhomu zviuru gumi nezvisere muMupata weMunyu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.12",
            "verseOrgIds": [
              "1CH.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaisa mapoka avarwi muEdhomu uye vaEdhomu vose vakava pasi poutongi hwaDhavhidhi. Jehovha akapa Dhavhidhi kukunda kwose kwose kwaakaenda.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.13",
            "verseOrgIds": [
              "1CH.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Machinda aDhavhidhi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akatonga Israeri achiita zvose zvakarurama uye zvakanaka kuvanhu vake vose.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.14",
            "verseOrgIds": [
              "1CH.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabhu mwanakomana waZeruya aitungamirira hondo;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.15",
            "verseOrgIds": [
              "1CH.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 18:15"
      },
      "items": [
        {
          "text": "Jehoshafati mwanakomana waAhirudhi aiva munyori wenhoroondo;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.15",
            "verseOrgIds": [
              "1CH.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zadhoki mwanakomana waAhitubhi naAhimereki mwanakomana waAbhiatari vaiva vaprista;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.16",
            "verseOrgIds": [
              "1CH.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 18:16"
      },
      "items": [
        {
          "text": "Shavhisha akanga ari munyori;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.16",
            "verseOrgIds": [
              "1CH.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhenaya mwanakomana waJehoyadha aitungamirira vaKereti navaPereti;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.17",
            "verseOrgIds": [
              "1CH.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 18:17"
      },
      "items": [
        {
          "text": "uye vanakomana vaDhavhidhi vaiva machinda makuru parutivi pamambo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.17",
            "verseOrgIds": [
              "1CH.18.17"
            ]
          }
        }
      ]
    }
  ],
