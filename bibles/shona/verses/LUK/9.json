  "verseCount": 62,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "LUK 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu Anotuma Vane Gumi naVaviri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati aunganidza vane Gumi naVaviri vake pamwe chete, akavapa simba nechikuriri kuti vadzinge madhimoni uye vaporese vakanga vane zvirwere,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.1",
            "verseOrgIds": [
              "LUK.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "akavatuma kuti vandoparidza umambo hwaMwari uye vandoporesa vairwara.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.2",
            "verseOrgIds": [
              "LUK.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akavarayira achiti, \"Musatakura chinhu parwendo, mudonzvo, kana hombodo, kana chingwa, kana mari, kana imwe nguo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.3",
            "verseOrgIds": [
              "LUK.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muimba ipi neipi yamunopinda, mugaremo kusvikira mabva muguta imomo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.4",
            "verseOrgIds": [
              "LUK.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana vanhu vasingakugamuchiriyi, muzunze guruva retsoka dzenyu pamunenge mabuda muguta ravo, chive chapupu pamusoro pavo.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.5",
            "verseOrgIds": [
              "LUK.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakasimuka vakabuda vakaenda kumusha nomusha, vachiparidza vhangeri nokuporesa vanhu kwose kwose.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.6",
            "verseOrgIds": [
              "LUK.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Herodhi mubati akanzwa pamusoro pezvose zvakanga zvichiitika. Akakanganisika, nokuti vamwe vakanga vachiti Johani akanga amutswa kubva kuvakafa,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.7",
            "verseOrgIds": [
              "LUK.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "vamwe vachiti Eria akanga aonekwa, uyezve vamwe vachiti mumwe wavaprofita vakare akanga amuka.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.8",
            "verseOrgIds": [
              "LUK.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Herodhi akati, \"Johani ndakamugura musoro. Zvino, ndianiko uyu wandinonzwa zvinhu zvakadai pamusoro pake?\" Akaedza kuti amuone.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.9",
            "verseOrgIds": [
              "LUK.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vanhu Zviuru Zvishanu Vanopiwa Zvokudya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vapostori vakati vadzoka, vakarondedzera kuna Jesu zvavakanga vaita. Ipapo akavatora vakabva muchivande vakaenda kuguta rainzi Bhetisaidha,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.10",
            "verseOrgIds": [
              "LUK.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi vazhinji vakazviziva vakamutevera. Akavagamuchira akataura kwavari nezvoumambo hwaMwari, akaporesa avo vakanga vachida kuporeswa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.11",
            "verseOrgIds": [
              "LUK.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zuva rovira, vane Gumi Navaviri vakauya kwaari vakati, \"Endesai vanhu vazhinji ava kuitira kuti vaende kumisha nokumaruwa akapoteredza kuti vandozvitsvakira zvokudya nepokurara, nokuti tiri musango muno.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.12",
            "verseOrgIds": [
              "LUK.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akavapindura akati, \"Vapei imi zvokudya.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.13",
            "verseOrgIds": [
              "LUK.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 9:13"
      },
      "items": [
        {
          "text": "Ivo vakati, \"Tinongova nezvingwa zvishanu nehove mbiri, kunze kwokunge tandotenga zvokudya zvavanhu vazhinji vose ava.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.13",
            "verseOrgIds": [
              "LUK.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakanga pane varume vangasvika zviuru zvishanu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.14",
            "verseOrgIds": [
              "LUK.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 9:14"
      },
      "items": [
        {
          "text": "Asi iye akati kuvadzidzi vake, \"Vagarisei pasi vari mumapoka avanhu vangasvika makumi mashanu paboka rimwe nerimwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.14",
            "verseOrgIds": [
              "LUK.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vadzidzi vakaita saizvozvo, uye munhu wose akagara pasi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.15",
            "verseOrgIds": [
              "LUK.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati atora zvingwa zvishanu nehove mbiri akatarisa kudenga, akavonga ndokuzvimedura. Ipapo akazvipa kuvadzidzi kuti vaise pamberi pavanhu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.16",
            "verseOrgIds": [
              "LUK.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vose vakadya vakaguta, uye vadzidzi vakanonga matengu azere gumi namaviri ezvimedu zvakanga zvasara.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.17",
            "verseOrgIds": [
              "LUK.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Petro Anopupura kuti Jesu Ndiye Kristu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rimwe zuva Jesu akati achinyengetera ari oga uye vadzidzi vake vakanga vanaye, akavabvunza akati, \"Vanhu vazhinji vanoti ndini aniko?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.18",
            "verseOrgIds": [
              "LUK.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakapindura vakati, \"Vamwe vanoti Johani Mubhabhatidzi, vamwe vachiti Eria, uye vamwezve vachiti, mumwe wavaprofita vakare akamuka kubva kuvakafa.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.19",
            "verseOrgIds": [
              "LUK.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kwavari, \"Asi, ko, imi munoti ndini ani?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.20",
            "verseOrgIds": [
              "LUK.9.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 9:20"
      },
      "items": [
        {
          "text": "Petro akapindura akati, \"Ndimi Kristu waMwari.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.20",
            "verseOrgIds": [
              "LUK.9.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akavayambira zvikuru kuti varege kutaura izvi kuna ani zvake.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.21",
            "verseOrgIds": [
              "LUK.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatizve, \"Mwanakomana woMunhu anofanira kutambudzika pazvinhu zvizhinji agorambwa navakuru, vaprista vakuru navadzidzisi vomurayiro, uye anofanira kuurayiwa agomuka pazuva retatu.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.22",
            "verseOrgIds": [
              "LUK.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akati kwavari vose, \"Kana munhu achida kunditevera, anofanira kuzviramba atore muchinjikwa wake zuva rimwe nerimwe agonditevera.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.23",
            "verseOrgIds": [
              "LUK.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti ani naani anoda kuponesa upenyu hwake acharasikirwa nahwo, asi ani naani anorasikirwa noupenyu hwake nokuda kwangu achahuponesa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.24",
            "verseOrgIds": [
              "LUK.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, munhu achabatsirwei kana akawana nyika yose, asi agorasikirwa noupenyu hwake.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.25",
            "verseOrgIds": [
              "LUK.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana munhu akanyara pamusoro pangu namashoko angu, Mwanakomana woMunhu achanyarawo pamusoro pake paanouya mukubwinya nomukubwinya kwaBaba nokwavatumwa vatsvene.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.26",
            "verseOrgIds": [
              "LUK.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinokuudzai chokwadi, kuti vamwe vamire pano havazofi vasati vaona umambo hwaMwari.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.27",
            "verseOrgIds": [
              "LUK.9.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kubwinya kwaJesu paGomo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazuva angasvika masere akati apera, shure kwokunge Jesu ataura izvozvo, akatora Petro naJohani naJakobho pamwe chete naye akakwira mugomo kundonyengetera.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.28",
            "verseOrgIds": [
              "LUK.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati achinyengetera, kuonekwa kwechiso chake kwakashanduka, nguo dzake dzikachena dzikapenya sokupenya kwemheni.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.29",
            "verseOrgIds": [
              "LUK.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume vaviri, Mozisi naEria,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.30",
            "verseOrgIds": [
              "LUK.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "vakaonekwa vari mukubwinya, vachitaura naJesu. Vakataura pamusoro pokuzoenda kwake, kwaakanga ondozadzisa paJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.31",
            "verseOrgIds": [
              "LUK.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro navaaiva navo vakanga vava kubatwa nehope, asi vakati vanyatsomuka, vakaona kubwinya kwake uye varume vaviri vamire naye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.32",
            "verseOrgIds": [
              "LUK.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume ava vakati vobva pana Jesu, Petro akati kwaari, \"Tenzi, zvakanaka kuti isu tigare pano. Ngativakei matumba matatu, rimwe renyu, rimwe raMozisi uye rimwe raEria.\" Akanga asingazivi zvaaireva.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.33",
            "verseOrgIds": [
              "LUK.9.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati achiri kutaura izvi, gore rakasvika rikavafukidza, uye vakatya pavakapinda mugore.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.34",
            "verseOrgIds": [
              "LUK.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzwi rakabva mugore, rikati, \"Uyu ndiye Mwanakomana wangu, musanangurwa wangu; muteererei.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.35",
            "verseOrgIds": [
              "LUK.9.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzwi rakati rataura izvozvo, vakaona Jesu ava oga. Vadzidzi vakanyarara, vakasaudza munhu zvavakanga vaona panguva iyoyo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.36",
            "verseOrgIds": [
              "LUK.9.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuporeswa kwoMukomana Akanga Ano Mweya Wakaipa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fume mangwana, pavakaburuka mugomo, vazhinji zhinji vakasangana naye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.37",
            "verseOrgIds": [
              "LUK.9.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe murume akanga ari pakati pavanhu vazhinji akadanidzira achiti, \"Mudzidzisi, ndinokukumbirai kuti muonewo mwanakomana wangu, nokuti ndiye oga mwana wangu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.38",
            "verseOrgIds": [
              "LUK.9.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 9:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mweya wakaipa unomubata pakarepo oridza mhere; wobva womubvundisa achipupuma furo pamuromo. Haudi kumuregedza uye unomuparadza.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.39",
            "verseOrgIds": [
              "LUK.9.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 9:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakakumbira vadzidzi venyu kuti vaudzinge, asi vakasagona.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.40",
            "verseOrgIds": [
              "LUK.9.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 9:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura akati, \"Haiwa rudzi rusingatendi, rwakatsauka, ndichagara nemi kusvikira riniko ndichikuitirai mwoyo murefu? Uyai pano nomwanakomana wenyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.41",
            "verseOrgIds": [
              "LUK.9.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 9:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange pakanga pachiuya mukomana, dhimoni rakamuwisira pasi rikamubvundisa. Asi akarayira mweya wakaipa, akaporesa mukomana ndokubva amudzosera kuna baba vake.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.42",
            "verseOrgIds": [
              "LUK.9.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 9:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye vose vakashamiswa noukuru hwaMwari.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.43",
            "verseOrgIds": [
              "LUK.9.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 9:43"
      },
      "items": [
        {
          "text": "Vanhu vose pavakanga vachakashamiswa nezvose zvakanga zvaitwa naJesu, akati kuvadzidzi vake,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.43",
            "verseOrgIds": [
              "LUK.9.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 9:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Teereresai kune zvandiri kuda kukutaurirai: Mwanakomana woMunhu ava kuzopandukirwa agoiswa mumaoko avanhu.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.44",
            "verseOrgIds": [
              "LUK.9.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 9:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi havana kunzwisisa kuti zvairevei. Zvakanga zvakavanzika kwavari, naizvozvo havana kuzvibata, uye vakanga vachitya kumubvunza pamusoro pazvo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.45",
            "verseOrgIds": [
              "LUK.9.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndiani achava mukuru?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 9:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nharo dzakatanga pakati pavadzidzi dzokuti mukuru ndiani.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.46",
            "verseOrgIds": [
              "LUK.9.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 9:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu, achiziva kufunga kwavo, akatora mwana muduku ndokumumisa parutivi rwake.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.47",
            "verseOrgIds": [
              "LUK.9.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 9:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akati kwavari, \"Ani naani anogamuchira mwana muduku uyu muzita rangu anondigamuchira; uye ani naani anondigamuchira, anogamuchira uyo akandituma. Nokuti muduku pakati penyu mose ndiye mukuru.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.48",
            "verseOrgIds": [
              "LUK.9.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 9:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Johani akati, \"Tenzi, takaona mumwe murume achidzinga madhimoni muzita renyu uye tikaedza kumudzivisa, nokuti haazi mumwe wedu.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.49",
            "verseOrgIds": [
              "LUK.9.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LUK 9:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati, \"Musamudzivisa, nokuti ani naani asingapesani nemi ndowenyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.50",
            "verseOrgIds": [
              "LUK.9.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "VaSamaria vanoramba kugamuchira Jesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LUK 9:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguva yakati yasvika yokuti akwidzwe kudenga, Jesu akafunga zvokuenda kuJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.51",
            "verseOrgIds": [
              "LUK.9.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LUK 9:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye akatuma nhume pamberi pake, dzikapinda mumusha weSamaria kundofanomugadzirira zvinhu;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.52",
            "verseOrgIds": [
              "LUK.9.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LUK 9:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi vanhu voko havana kumugamuchira, nokuti akanga ava kuenda kuJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.53",
            "verseOrgIds": [
              "LUK.9.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LUK 9:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vadzidzi Jakobho naJohani vakati vaona izvi, vakabvunza vakati, \"Ishe, munoda here kuti tidane moto uburuke kubva kudenga kuti uvaparadze?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.54",
            "verseOrgIds": [
              "LUK.9.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LUK 9:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Jesu akatendeuka akavatsiura,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.55",
            "verseOrgIds": [
              "LUK.9.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LUK 9:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye akabva akaenda kuno mumwe musha.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.56",
            "verseOrgIds": [
              "LUK.9.56"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mutengo woKutevera Jesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "LUK 9:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vachifamba mumugwagwa, mumwe murume akati, \"Ndichakuteverai kwose kwamunoenda.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.57",
            "verseOrgIds": [
              "LUK.9.57"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "LUK 9:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura akati, \"Makava ane mwena yawo uye shiri dzedenga dzine matendere adzo, asi Mwanakomana woMunhu haana paangatsamidza musoro wake.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.58",
            "verseOrgIds": [
              "LUK.9.58"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "LUK 9:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kuno mumwe murume, \"Nditevere.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.59",
            "verseOrgIds": [
              "LUK.9.59"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 9:59"
      },
      "items": [
        {
          "text": "Asi murume uyu akapindura akati, \"Ishe, nditenderei kuti ndinoviga baba vangu.\"",
