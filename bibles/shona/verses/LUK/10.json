  "verseCount": 42,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "LUK 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu Anotuma vana Makumi Manomwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwaizvozvo Ishe akagadza vamwe makumi manomwe akavatuma achiita vaviri vaviri pamberi pake kumaguta nokunzvimbo dzose kwaakanga achizoenda.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.1",
            "verseOrgIds": [
              "LUK.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kwavari, \"Kukohwa kukuru, asi vashandi vashoma. Naizvozvo kumbirai kuna She wokukohwa, kuti atume vashandi mumunda wake wokukohwa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.2",
            "verseOrgIds": [
              "LUK.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endai! Ndiri kukutumai samakwayana pakati pamapere.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.3",
            "verseOrgIds": [
              "LUK.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musatora chikwama, kana hombodo, kana shangu; uye musakwazisa munhu panzira.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.4",
            "verseOrgIds": [
              "LUK.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pamunopinda mumba, mutange namashoko okuti, 'Rugare ngaruve muimba ino.'",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.5",
            "verseOrgIds": [
              "LUK.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana munhu worugare arimo, rugare rwenyu ruchazorora pamusoro pake; kana zvikasadaro, ruchadzokera kwamuri.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.6",
            "verseOrgIds": [
              "LUK.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garai muimba iyoyo muchidya nokunwa zvose zvavanokupai nokuti mubati akafanirwa nomubayiro wake. Musapota-pota nedzimba.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.7",
            "verseOrgIds": [
              "LUK.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pamunopinda muguta uye vakakugamuchirai, mudye zvose zvinoiswa pamberi penyu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.8",
            "verseOrgIds": [
              "LUK.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Poresai vanorwara varimo mugovaudza kuti, 'Umambo hwaMwari hwaswedera.'",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.9",
            "verseOrgIds": [
              "LUK.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi pamunopinda muguta uye mukasagamuchirwa, muende munzira dzaro mugoti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.10",
            "verseOrgIds": [
              "LUK.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Kunyange neguruva reguta renyu rakanamatira patsoka dzedu tinoripukuta nokuda kwenyu. Asi muzive izvi: Umambo hwaMwari hwaswedera.'",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.11",
            "verseOrgIds": [
              "LUK.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinokuudzai kuti pazuva iro, Sodhomu richarerukirwa kwazvo kupfuura guta iroro.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.12",
            "verseOrgIds": [
              "LUK.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Une nhamo iwe, Korazini! Une nhamo iwe, Bhetisaidha! Nokuti dai zvishamiso zvakaitwa mauri zvakanga zvaitwa muTire neSidhoni, vangadai vakatendeuka kare, vakagara mumadota vakafuka masaga.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.13",
            "verseOrgIds": [
              "LUK.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Tire neSidhoni zvicharerukirwa pakutongwa kupfuura imi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.14",
            "verseOrgIds": [
              "LUK.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye iwe, Kapenaume, uchasimudzirwa kudenga here? Kwete, uchaburuka kwakadzika.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.15",
            "verseOrgIds": [
              "LUK.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Anokunzwai imi, anondinzwa ini; uyo anokurambai imi, anondirambawo ini; asi uyo anondiramba, anoramba iye akandituma.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.16",
            "verseOrgIds": [
              "LUK.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vana makumi manomwe vakadzoka nomufaro vakati, \"Ishe, kunyange madhimoni anozviisa pasi pedu muzita renyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.17",
            "verseOrgIds": [
              "LUK.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kwavari, \"Ndakaona Satani achiwa kubva kudenga semheni.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.18",
            "verseOrgIds": [
              "LUK.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakupai simba rokuti mutsike pamusoro penyoka nezvinyavada uye kuti mukunde simba rose romuvengi; hakuna chichakukuvadzai.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.19",
            "verseOrgIds": [
              "LUK.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro hazvo, musafara nokuti mweya yakaipa inozviisa pasi penyu, asi farai kuti mazita enyu akanyorwa kudenga.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.20",
            "verseOrgIds": [
              "LUK.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyoyo Jesu azere nomufaro kubudikidza noMweya Mutsvene, akati, \"Ndinokuvongai, Baba, Ishe wokudenga nepasi, nokuti makavanzira vakachenjera navakadzidza zvinhu izvi, mukazvizarurira kuvacheche. Hongu, Baba nokuti zvakakufadzai.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.21",
            "verseOrgIds": [
              "LUK.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvinhu zvose ndakazvipiwa naBaba vangu. Hakuna munhu anoziva kuti Mwanakomana ndiani kunze kwaBaba, uye hakuna munhu anoziva kuti Baba ndiani kunze kwoMwanakomana naavo Mwanakomana vaanenge asarudza kuvazarurira.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.22",
            "verseOrgIds": [
              "LUK.10.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akatendeukira kuvadzidzi vake vari voga akati, \"Akaropafadzwa meso anoona zvamuoona,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.23",
            "verseOrgIds": [
              "LUK.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti ndinokuudzai kuti vaprofita vazhinji namadzimambo vaida kuona zvamunoona asi havana kuzviona, uye nokunzwa zvamunonzwa asi havana kuzvinzwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.24",
            "verseOrgIds": [
              "LUK.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mufananidzo woMuSamaria Akanaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe musi mududziri womurayiro akasimuka kuti aedze Jesu. Akati, \"Mudzidzisi ndinofanira kuiteiko kuti ndiwane nhaka youpenyu husingaperi?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.25",
            "verseOrgIds": [
              "LUK.10.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akapindura akati, \"Mumurayiro makanyorweiko? Unouverenga seiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.26",
            "verseOrgIds": [
              "LUK.10.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapindura akati, \" 'Ida Ishe Mwari wako nomwoyo wako wose, uye nomweya wako wose, uye nesimba rako rose nokufunga kwako kwose,' uye 'Ida muvakidzani wako sokuda kwaunozviita iwe.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.27",
            "verseOrgIds": [
              "LUK.10.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura akati, \"Wapindura zvakanaka. Ita izvozvo ugorarama.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.28",
            "verseOrgIds": [
              "LUK.10.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi iye akanga achida kuzviruramisa, saka akabvunza Jesu akati, \"Muvakidzani wangu ndianiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.29",
            "verseOrgIds": [
              "LUK.10.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura akati, \"Mumwe murume aiburuka achibva kuJerusarema achienda kuJeriko, paakawira mumaoko amakororo. Vakamubvisa nguo dzake, vakamurova ndokuenda zvavo, vachimusiya oda kufa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.30",
            "verseOrgIds": [
              "LUK.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvakaitika kuti mumwe muprista akafambawo nenzira iyoyo, uye akati achiona murume uyo, akamunyenyeredza.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.31",
            "verseOrgIds": [
              "LUK.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saizvozvowo, muRevhi akasvika panzvimbo iyoyo akamuona, akamunyenyeredzawo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.32",
            "verseOrgIds": [
              "LUK.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi muSamaria, aiva parwendo, akasvika pakanga pano murume uya; uye akati achimuona, akamunzwira tsitsi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.33",
            "verseOrgIds": [
              "LUK.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaenda paari akamusunga maronda ake, akaadira mafuta newaini. Ipapo akamutora akamukwidza pambongoro yake, akamuendesa kuimba yavaeni, akamuchengeta.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.34",
            "verseOrgIds": [
              "LUK.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fume mangwana akatora mari yesirivha akaipa kumuchengeti weimba yavaeni. Akati kwaari, 'Muchengetei uye pandinodzoka, ndichakuripirai zvose zvamunenge mawedzera pane zvandakupai.'",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.35",
            "verseOrgIds": [
              "LUK.10.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndianiko pavanhu vatatu ava waunofunga kuti akanga ari muvakidzani kuna iye akawira mumaoko amakororo?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.36",
            "verseOrgIds": [
              "LUK.10.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mududziri womurayiro akati, \"Uyo akamunzwira tsitsi.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.37",
            "verseOrgIds": [
              "LUK.10.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 10:37"
      },
      "items": [
        {
          "text": "Jesu akati kwaari, \"Enda unoita saizvozvo.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.37",
            "verseOrgIds": [
              "LUK.10.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu Anoshanyira Marita naMaria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu navadzidzi vake pavakanga vachifamba, vakasvika pano mumwe musha; mumwe mukadzi ainzi Marita akamugamuchira mumba make.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.38",
            "verseOrgIds": [
              "LUK.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanga ano mununʼuna wake ainzi Maria, uyo akagara patsoka dzaShe achiteerera kune zvaakanga achitaura.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.39",
            "verseOrgIds": [
              "LUK.10.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 10:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Marita akatadziswa kuteerera nokuda kwokugadzirira kwose kwaifanira kuitwa. Akauya kwaari akati, \"Ishe hamuna hanya here kuti mununʼuna wangu andisiya ndichingoshanda ndoga? Muudzei kuti andibatsirewo!\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.40",
            "verseOrgIds": [
              "LUK.10.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishe akapindura akati, \"Marita, Marita, uri kufunganya nokugumburwa pamusoro pezvinhu zvizhinji,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.41",
            "verseOrgIds": [
              "LUK.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi pane chinhu chimwe chete chinodikanwa. Maria asarudza chinhu chiri nani, uye haazochitorerwi.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.42",
            "verseOrgIds": [
              "LUK.10.42"
            ]
          }
        }
      ]
    }
  ],
