{
  "id": "LUK.20",
  "number": "20",
  "bookId": "LUK",
  "reference": "Ruka 20",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 47,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "LUK 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vakabvunza kuti simba raJesu raibvepi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nerimwe ramazuva paakanga achidzidzisa vanhu mutemberi uye achiparidza vhangeri, vaprista vakuru navadzidzisi vomurayiro, pamwe chete navakuru, vakasvika kwaari.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.1",
            "verseOrgIds": [
              "LUK.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati kwaari, \"Tiudzei kuti munoita zvinhu izvi nesimba ripi? Ndiani akakupai simba iri?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.2",
            "verseOrgIds": [
              "LUK.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapindura akati, \"Neniwo ndichakubvunzai mubvunzo. Ndiudzei,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.3",
            "verseOrgIds": [
              "LUK.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Rubhabhatidzo rwaJohani rwakabva kudenga here kana kuti kuvanhu?' \"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.4",
            "verseOrgIds": [
              "LUK.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakataurirana pakati pavo vakati, \"Kana tikati, 'Rwakabva kudenga,' iye achati, 'Seiko musina kumutenda?'",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.5",
            "verseOrgIds": [
              "LUK.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana tikati, 'Rwakabva kuvanhu,' vanhu vose vachatitaka namabwe, nokuti vanotenda kuti Johani akanga ari muprofita.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.6",
            "verseOrgIds": [
              "LUK.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka ivo vakazoti, \"Hatizivi kuti rwakabvepi.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.7",
            "verseOrgIds": [
              "LUK.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati, \"Neniwo handichakuudzai simba randinoita naro zvinhu izvi.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.8",
            "verseOrgIds": [
              "LUK.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mufananidzo waVarimi Vakaipa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaenderera mberi akaudza vanhu mufananidzo uyu akati, Mumwe murume akadyara munda wake wemizambiringa, akaupa kuna vamwe varimi kwechinguva achibva aenda kure kune imwe nyika kwenguva refu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.9",
            "verseOrgIds": [
              "LUK.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva yokukohwa, akatuma muranda kuvarimi kuti vamupe zvimwe zvezvibereko zvemizambiringa. Asi varimi vakamurova vakamuendesa asina chinhu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.10",
            "verseOrgIds": [
              "LUK.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatumazve mumwe muranda, asi naiyewo vakamurova uye vakamuitira zvinonyadzisa ndokumudzosazve asina chinhu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.11",
            "verseOrgIds": [
              "LUK.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatumazve mumwe wechitatu, uyu vakamukuvadza ndokumukanda kunze.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.12",
            "verseOrgIds": [
              "LUK.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ipapo muridzi womunda wemizambiringa akati, 'Ndichaita seiko? Ndichatuma mwanakomana wangu, iye wandinoda; zvimwe vachamuremekedza.'",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.13",
            "verseOrgIds": [
              "LUK.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asi varimi vakati vachimuona, vakataurirana pachavo vakati, 'Uyu ndiye mudyi wenhaka. Ngatimuurayei nhaka igova yedu.'",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.14",
            "verseOrgIds": [
              "LUK.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakamubudisa mumunda wemizambiringa ndokubva vamuuraya.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.15",
            "verseOrgIds": [
              "LUK.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 20:15"
      },
      "items": [
        {
          "text": "\"Zvino muridzi womunda womuzambiringa achaitei kwavari?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.15",
            "verseOrgIds": [
              "LUK.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achauya agouraya varimi avo agopa vamwe varimi munda womuzambiringa.\" Vanhu vakati vanzwa izvozvo, vakati, \"Dai zvakadai zvikasatomboitika!\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.16",
            "verseOrgIds": [
              "LUK.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akavatarisisa uye akavabvunza akati, \"Zvino zvakanyorwa zvinoreveiko zvinoti:",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.17",
            "verseOrgIds": [
              "LUK.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LUK 20:17"
      },
      "items": [
        {
          "text": "\" 'Ibwe rakarambwa navavaki",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.17",
            "verseOrgIds": [
              "LUK.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LUK 20:17"
      },
      "items": [
        {
          "text": "ndiro razova musoro wekona'?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.17",
            "verseOrgIds": [
              "LUK.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe nomumwe anowira padombo iroro achavhunika-vhunika asi uyo warinowira achapwanyiwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.18",
            "verseOrgIds": [
              "LUK.20.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vadzidzisi vomurayiro navaprista vakuru vakatsvaka nzira yokumusunga pakarepo, nokuti vaiziva kuti akanga ataura mufananidzo uyu pamusoro pavo. Asi vakanga vachitya vanhu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.19",
            "verseOrgIds": [
              "LUK.20.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuripa Mitero kuna Kesari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaramba vachimucherechedza, vakatuma vasori, vakanga vachinyepedzera kuva vakatendeka. Vakanga vane tariro yokuti vamubate iye Jesu pachinhu chaanenge ataura kuitira kuti vagomuisa kusimba noutongi hwomubati.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.20",
            "verseOrgIds": [
              "LUK.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vasori vakamubvunza vachiti, \"Mudzidzisi, tinoziva kuti munotaura uye munodzidzisa zvakarurama, uye kuti hamusi mutsauri wavanhu asi munodzidzisa nzira yaMwari zviri maererano nezvokwadi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.21",
            "verseOrgIds": [
              "LUK.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, zvakanaka here kuti tiripe mutero kuna Kesari kana kuti kwete?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.22",
            "verseOrgIds": [
              "LUK.20.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaona kunyengera kwavo akati kwavari,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.23",
            "verseOrgIds": [
              "LUK.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndiratidzei dhenari. Ko, mufananidzo norunyoro zviripo ndezvani?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.24",
            "verseOrgIds": [
              "LUK.20.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakapindura vakati, \"NdezvaKesari.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.25",
            "verseOrgIds": [
              "LUK.20.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 20:25"
      },
      "items": [
        {
          "text": "Iye akati kwavari, \"Ipai Kesari zvaKesari uye mugopa Mwari zvaMwari.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.25",
            "verseOrgIds": [
              "LUK.20.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakanga vasingagoni kumuteya nezvaakanga ataura ipapo pane vanhu. Vakashamiswa nokupindura kwake, vakanyarara.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.26",
            "verseOrgIds": [
              "LUK.20.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kumuka kwaVakafa noKuwanana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamwe vaSadhusi, vanoti hakuna kumuka kwavakafa, vakauya nomubvunzo kuna Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.27",
            "verseOrgIds": [
              "LUK.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati, \"Mudzidzisi, Mozisi akatinyorera kuti kana mukoma womunhu akafa akasiya mukadzi asina vana, murume anofanira kuwana chirikadzi iyo amutsire mukoma wake vana.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.28",
            "verseOrgIds": [
              "LUK.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino pakanga pane vanakomana vanomwe. Wokutanga akawana mukadzi, akafa asina mwana.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.29",
            "verseOrgIds": [
              "LUK.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wechipiri akamuwana uye akafa asina mwana.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.30",
            "verseOrgIds": [
              "LUK.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye wechitatu akamuwana, uye nenzira imwe cheteyo, vose vari vanomwe vakafa, vachisiya pasina vana.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.31",
            "verseOrgIds": [
              "LUK.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakupedzisira, mukadzi akafawo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.32",
            "verseOrgIds": [
              "LUK.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino mukadzi uyu achava waaniko pakumuka kwavakafa sezvo akanga ari mukadzi kwavari vose vari vanomwe?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.33",
            "verseOrgIds": [
              "LUK.20.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura akati, \"Vanhu venyika ino vanowana nokuwanikwa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.34",
            "verseOrgIds": [
              "LUK.20.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vaya vanoonekwa kuti vakakodzera kurarama munyika iyo nomukumuka kwavakafa, havazowani kana kuwanikwa,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.35",
            "verseOrgIds": [
              "LUK.20.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye havazofizve; nokuti vafanana navatumwa. Vana vaMwari, sezvo vari vana vokumuka kwavakafa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.36",
            "verseOrgIds": [
              "LUK.20.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi panhoroondo yegwenzi, kunyange naMozisi akaratidza kuti vakafa vanomutswa, nokuti anoti, Ishe ndiye 'Mwari waAbhurahama, naMwari waIsaka, uye naMwari waJakobho.'",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.37",
            "verseOrgIds": [
              "LUK.20.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 20:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haasi Mwari wavakafa, asi wavapenyu, nokuti kwaari vose vapenyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.38",
            "verseOrgIds": [
              "LUK.20.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 20:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamwe vadzidzisi vomurayiro vakati, \"Mataura zvakanaka, mudzidzisi!\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.39",
            "verseOrgIds": [
              "LUK.20.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 20:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye hakuna akazoda kumubvunzazve mimwe mibvunzo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.40",
            "verseOrgIds": [
              "LUK.20.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kristu Mwanakomana waani?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 20:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jesu akati kwavari, \"Seiko vachiti Kristu Mwanakomana waDhavhidhi?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.41",
            "verseOrgIds": [
              "LUK.20.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 20:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi pachake anotaura mubhuku raMapisarema achiti:",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.42",
            "verseOrgIds": [
              "LUK.20.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LUK 20:42"
      },
      "items": [
        {
          "text": "\" 'Ishe akati kuna She wangu:",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.42",
            "verseOrgIds": [
              "LUK.20.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LUK 20:42"
      },
      "items": [
        {
          "text": "Gara kuruoko rwangu rworudyi",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.42",
            "verseOrgIds": [
              "LUK.20.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 20:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "kusvikira ndaita vavengi vako",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.43",
            "verseOrgIds": [
              "LUK.20.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LUK 20:43"
      },
      "items": [
        {
          "text": "chitsiko chetsoka dzako.'",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.43",
            "verseOrgIds": [
              "LUK.20.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 20:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi anomuti, 'Ishe.' Anogova mwanakomana wake seiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.44",
            "verseOrgIds": [
              "LUK.20.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 20:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vose vachakateerera, Jesu akati kuvadzidzi vake,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.45",
            "verseOrgIds": [
              "LUK.20.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 20:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Chenjererai vadzidzisi vomurayiro. Vanoda kufamba-famba vakapfeka nguo refu, uye vachifarira kukwaziswa pamisika, nokuva nezvigaro zvapamusoro-soro mumasinagoge uye nenzvimbo dzinokudzwa pamabiko.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.46",
            "verseOrgIds": [
              "LUK.20.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 20:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanoparadza dzimba dzechirikadzi uye vanoita minyengetero mirefu, kuti vaonekwe. Vanhu vakadai vacharangwa zvakaomarara kwazvo.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.47",
            "verseOrgIds": [
              "LUK.20.47"
            ]
          }
        }
      ]
    }
  ],
