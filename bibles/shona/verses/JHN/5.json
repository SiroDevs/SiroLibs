  "verseCount": 47,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "JHN 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuporeswa kwoMunhu paDziva reBhetesdha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwaizvozvo, Jesu akakwira kuJerusarema kumutambo wavaJudha.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.1",
            "verseOrgIds": [
              "JHN.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino muJerusarema mune dziva riri pedyo neSuo raMakwai, rinonzi Bhetesdha nechiHebheru, uye rakapoteredzwa namabiravira mashanu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.2",
            "verseOrgIds": [
              "JHN.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imomo vanhu vazhinji vakaremara vaisivatamo, mapofu, zvirema navakafa mitezo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.3",
            "verseOrgIds": [
              "JHN.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguva nenguva mutumwa waShe aiburukiramo achibvongodza mvura. Munhu aitanga kupinda mudziva shure kwenguva ipi zvayo yainge yabvongodzwa mvura aiporeswa pachirwere chipi zvacho chaainge anacho.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.4",
            "verseOrgIds": [
              "JHN.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe murume akanga arimo akanga arwara kwamakore makumi matatu namasere.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.5",
            "verseOrgIds": [
              "JHN.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati amuona avete imomo, uye aiziva kuti akanga aita mararamiro iwayo kwenguva refu, akamubvunza akati, \"Unoda kuporeswa here?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.6",
            "verseOrgIds": [
              "JHN.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murwere akati, \"Ishe, handina munhu anondibatsira kuti ndipinde mudziva mvura painenge yabvongodzwa. Ndichiri kuedza kupinda, mumwe anonditangira.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.7",
            "verseOrgIds": [
              "JHN.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jesu akati kwaari, \"Simuka! Tora rukukwe rwako ufambe.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.8",
            "verseOrgIds": [
              "JHN.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakarepo murume uyu akaporeswa; akatora rukukwe rwake akafamba.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.9",
            "verseOrgIds": [
              "JHN.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 5:9"
      },
      "items": [
        {
          "text": "Zuva rakaitika izvi raiva reSabata.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.9",
            "verseOrgIds": [
              "JHN.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo vaJudha vakati kumurume uya akanga aporeswa, \"Nhasi iSabata; murayiro unokurambidza kuti utakure rukukwe rwako.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.10",
            "verseOrgIds": [
              "JHN.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi iye akapindura akati, \"Murume andiporesa ati kwandiri, 'Takura rukukwe rwako ufambe.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.11",
            "verseOrgIds": [
              "JHN.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakamubvunza vakati, \"Ndianiko murume uyu akutaurira kuti urutakure ufambe?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.12",
            "verseOrgIds": [
              "JHN.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murume uya akanga aporeswa akanga asingazivi kuti ainge ari ani, nokuti Jesu akanga apinda mukati meungano yakanga iripo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.13",
            "verseOrgIds": [
              "JHN.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwaizvozvo, Jesu akamuwana ari mutemberi uye akati kwaari, \"Tarira, wapora. Usatadzazve kuti urege kuwirwa nechimwe chinhu chakaipisisa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.14",
            "verseOrgIds": [
              "JHN.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murume akabva akaenda akandoudza vaJudha kuti ndiJesu akanga amuporesa.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.15",
            "verseOrgIds": [
              "JHN.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Upenyu nokuMwanakomana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka nokuda kwokuti Jesu akanga achiita zvinhu izvi nomusi weSabata, vaJudha vakamutambudza.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.16",
            "verseOrgIds": [
              "JHN.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati kwavari, \"Baba vangu vanoramba vari pabasa ravo kusvikira nhasi chaiye, uye neniwo, ndiri kushanda.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.17",
            "verseOrgIds": [
              "JHN.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuda kwaizvozvi, vaJudha vakaedza zvakanyanya kwazvo kuti vamuuraye; nokuti akanga asingaputsi Sabata chete, asi akanga achitiwo Mwari ndiBaba vake, achizvienzanisa naMwari.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.18",
            "verseOrgIds": [
              "JHN.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura akati, \"Ndinokuudzai chokwadi, Mwanakomana haagoni kuita chinhu ari oga; anongogona kuita zvaanoona Baba vake vachiita, nokuti zvose zvinoitwa naBaba, Mwanakomana anozviitawo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.19",
            "verseOrgIds": [
              "JHN.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti Baba vanoda Mwanakomana uye vanomuratidza zvose zvavanoita ivo. Hongu, kuti imi mushamiswe, vachamuratidza kunyange zvinhu zvikuru kwazvo kupfuura izvi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.20",
            "verseOrgIds": [
              "JHN.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti sezvo Baba vachimutsa vakafa uye vachivapa upenyu, saizvozvo Mwanakomana anopa upenyu kuno uyo waanofarira kuti ape.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.21",
            "verseOrgIds": [
              "JHN.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamusoro paizvozvo, Baba havatongi munhu, asi vakapa Mwanakomana kutonga kwose,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.22",
            "verseOrgIds": [
              "JHN.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti vose vakudze Mwanakomana sokukudza kwavanoita Baba. Uyo asingakudzi Mwanakomana, haakudzi Baba vakamutuma.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.23",
            "verseOrgIds": [
              "JHN.5.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndinokuudzai chokwadi kuti, ani naani anonzwa shoko rangu uye achitenda uyo akandituma, ano upenyu husingaperi uye haachazotongwi, abva murufu uye aenda kuupenyu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.24",
            "verseOrgIds": [
              "JHN.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinokuudzai chokwadi kuti, nguva inouya uye yatosvika zvino yokuti vakafa vachanzwa inzwi roMwanakomana waMwari uye avo vanonzwa vachararama.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.25",
            "verseOrgIds": [
              "JHN.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti sezvo Baba vano upenyu mavari, saizvozvowo vakapa Mwanakomana kuti ave noupenyu maari.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.26",
            "verseOrgIds": [
              "JHN.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye vakamupa simba rokuti atonge nokuti ndiye Mwanakomana woMunhu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.27",
            "verseOrgIds": [
              "JHN.5.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Musashamiswa pane izvi, kuti nguva inouya yokuti vose vari mumakuva avo vachanzwa inzwi rake",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.28",
            "verseOrgIds": [
              "JHN.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye vachamuka; vose vakaita zvakanaka vachamuka vachienda kuupenyu, uye avo vakaita zvakaipa vachamuka vachienda kukutongwa.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.29",
            "verseOrgIds": [
              "JHN.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ini ndoga handigoni kuita chinhu; ndinongotonga sezvandinenge ndanzwa, uye kutonga kwangu kwakarurama, nokuti handitsvaki kuzvifadza asi iye akandituma.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.30",
            "verseOrgIds": [
              "JHN.5.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zvapupu pamusoro paJesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana ndichizvipupurira, uchapupu hwangu hahuna maturo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.31",
            "verseOrgIds": [
              "JHN.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pano mumwe anondipupurira, uye ndinoziva kuti uchapupu hwake pamusoro pangu ndohwechokwadi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.32",
            "verseOrgIds": [
              "JHN.5.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 5:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Makatuma nhume kuna Johani naiye akapupurira chokwadi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.33",
            "verseOrgIds": [
              "JHN.5.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 5:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazvirevi kuti ndinogamuchira kupupura kwavanhu; asi ndareva izvi kuti muponeswe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.34",
            "verseOrgIds": [
              "JHN.5.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 5:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Johani akanga ari mwenje waipfuta uye uchivhenekera, uye imi makasarudza kufara kwenguva duku muchiedza chake.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.35",
            "verseOrgIds": [
              "JHN.5.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 5:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndino uchapupu hukuru kupfuura hwaJohani. Nokuti iro basa chairo randakapiwa naBaba kuti ndiripedze, uye randiri kuita, rinondipupurira kuti Baba vakandituma.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.36",
            "verseOrgIds": [
              "JHN.5.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 5:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye ivo Baba vakandituma vakapupura pachavo pamusoro pangu. Hamuna kutombonzwa inzwi ravo kana kuona chimiro chavo,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.37",
            "verseOrgIds": [
              "JHN.5.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 5:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye shoko ravo harigari mukati menyu, nokuti hamutendi iye waakatuma.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.38",
            "verseOrgIds": [
              "JHN.5.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 5:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munoshingaira kunzvera magwaro nokuti munofunga kuti maari mune upenyu husingaperi. Magwaro iwaya anopupura pamusoro pangu,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.39",
            "verseOrgIds": [
              "JHN.5.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 5:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi imi munoramba kuuya kwandiri kuti muve noupenyu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.40",
            "verseOrgIds": [
              "JHN.5.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 5:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Handigamuchiri kurumbidzwa kunobva kuvanhu,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.41",
            "verseOrgIds": [
              "JHN.5.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 5:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi ndinokuzivai. Ndinoziva kuti hamuna rudo rwaMwari mumwoyo yenyu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.42",
            "verseOrgIds": [
              "JHN.5.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 5:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakauya muzita raBaba vangu, asi hamundigamuchiri; asi kana mumwewo zvake akauya muzita rake, muchamugamuchira.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.43",
            "verseOrgIds": [
              "JHN.5.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 5:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungatenda seiko kana muchikudzana pachenyu asi musingashingairiri kuwana kurumbidzwa kunobva kuna Mwari oga?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.44",
            "verseOrgIds": [
              "JHN.5.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 5:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asi musafunga kuti ndichakupomerai mhosva pamberi paBaba. Mupomeri wenyu ndiMozisi, wamunoisa tariro yenyu maari.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.45",
            "verseOrgIds": [
              "JHN.5.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 5:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dai maitenda Mozisi, mungadai maitendawo ini, nokuti akanyora nezvangu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.46",
            "verseOrgIds": [
              "JHN.5.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 5:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi sezvo musingatendi zvaakanyora, muchatenda seiko zvandinoreva?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.47",
            "verseOrgIds": [
              "JHN.5.47"
            ]
          }
        }
      ]
    }
  ],
