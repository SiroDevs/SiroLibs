  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "JHN 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu Anoshambidza Tsoka dzaVadzidzi Vake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutambo wePasika wakanga uchigere kusvika. Jesu akanga achiziva kuti nguva yakanga yasvika yokuti iye abve panyika uye kuti aende kuna Baba. Sezvo akanga achida vake avo vakanga vari munyika, akavaratidza zvino kuzara kworudo rwake.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.1",
            "verseOrgIds": [
              "JHN.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudya kwamadekwana kwakanga kwava kugoverwa, uye dhiabhori akanga aisa mumwoyo maJudhasi Iskarioti, mwanakomana waSimoni, pfungwa yokuti apandukire Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.2",
            "verseOrgIds": [
              "JHN.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akanga achiziva kuti Baba vakanga vaisa zvinhu zvose pasi pesimba rake, uye kuti akanga abva kuna Mwari uye kuti aidzokerazve kuna Mwari,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.3",
            "verseOrgIds": [
              "JHN.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "saka akasimuka pakudya, akabvisa nguo yake yokunze, uye akamonera tauro muchiuno chake.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.4",
            "verseOrgIds": [
              "JHN.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwaizvozvo, akadira mvura mudhishi akatanga kushambidza tsoka dzavadzidzi vake, achidziomesa netauro rakanga rakamonerwa muchiuno chake.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.5",
            "verseOrgIds": [
              "JHN.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasvika pana Simoni Petro, iye akati kwaari, \"Ishe muri kuda kushambidza tsoka dzangu here?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.6",
            "verseOrgIds": [
              "JHN.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura achiti, \"Iwe hausi kuziva zvandiri kuita iye zvino, asi uchazvinzwisisa pashure.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.7",
            "verseOrgIds": [
              "JHN.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni Petro akati, \"Kwete, imi hamungatongoshambidzi tsoka dzangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.8",
            "verseOrgIds": [
              "JHN.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 13:8"
      },
      "items": [
        {
          "text": "Jesu akapindura akati, \"Kana ndikasakushambidza, hauna mugove neni.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.8",
            "verseOrgIds": [
              "JHN.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Simoni Petro akati, \"Ishe, ngadzirege kuva tsoka dzangu bedzi asi maoko angu nomusoro wanguwo!\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.9",
            "verseOrgIds": [
              "JHN.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura akati, \"Munhu anenge amboshamba muviri wose, anongoda bedzi kushamba tsoka dzake, muviri wake wose wakachena. Imi makachena, kunyange zvazvo musiri mose vakachena.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.10",
            "verseOrgIds": [
              "JHN.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti aiziva kuti ndiani aizomupandukira, ndokusaka akati, havasi vose vakanga vakachena.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.11",
            "verseOrgIds": [
              "JHN.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati apedza kushambidza tsoka dzavo, akapfeka nguo dzake akadzokera panzvimbo yake. Akavabvunza akati, \"Munonzwisisa here zvandaita kwamuri?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.12",
            "verseOrgIds": [
              "JHN.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munondidaidza kuti 'Mudzidzisi' uye ndizvozvo chaizvo, nokuti ndizvo zvandiri.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.13",
            "verseOrgIds": [
              "JHN.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino kana ini, Ishe wenyu noMudzidzisi wenyu, ndashambidza tsoka dzenyu, nemiwo munofanira kushambidzana tsoka dzenyu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.14",
            "verseOrgIds": [
              "JHN.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakupai muenzaniso kuti muite sezvandakuitirai imi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.15",
            "verseOrgIds": [
              "JHN.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinokuudzai chokwadi kuti, muranda haasi mukuru kuna tenzi wake, uye atumwa haasi mukuru kupfuura amutuma.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.16",
            "verseOrgIds": [
              "JHN.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino zvamava kuziva zvinhu izvi, mucharopafadzwa kana mukazviita.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.17",
            "verseOrgIds": [
              "JHN.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu Anotaura pamusoro poKupandukirwa Kwake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Handirevi izvi kwamuri mose; ini ndinoziva avo vandakasarudza. Asi uku ndiko kuzadzisa Rugwaro runoti, 'Uyo anogovana neni chingwa andisimudzira chitsitsinho chake kuti azorwa neni.'",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.18",
            "verseOrgIds": [
              "JHN.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndiri kukuudzai iye zvino zvisati zvaitika, kuitira kuti pazvinoitika mugozotenda kuti ndini Iye.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.19",
            "verseOrgIds": [
              "JHN.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinokuudzai chokwadi kuti, ani naani anogamuchira ini anogamuchira iye akandituma.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.20",
            "verseOrgIds": [
              "JHN.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwokutaura izvozvo, Jesu akatambudzika mumweya uye akapupura achiti, \"Ndinokuudzai chokwadi, mumwe wenyu achandipandukira.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.21",
            "verseOrgIds": [
              "JHN.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vadzidzi vake vakatarisana vachida kuziva kuti ndiani airehwa pakati pavo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.22",
            "verseOrgIds": [
              "JHN.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe wavo, mudzidzi aidikanwa naJesu, akanga akasendamira paari.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.23",
            "verseOrgIds": [
              "JHN.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni Petro akaninira kumudzidzi uyu akati, \"Vabvunzei kuti vanoreva ani.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.24",
            "verseOrgIds": [
              "JHN.13.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasendamirazve pana Jesu, akamubvunza akati, \"Ishe, ndianiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.25",
            "verseOrgIds": [
              "JHN.13.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati, \"Ndiye wandichapa chimedu chechingwa kana ndachiseva mundiro.\" Ipapo, akaseva chimedu chechingwa, akachipa kuna Judhasi Iskarioti, mwanakomana waSimoni.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.26",
            "verseOrgIds": [
              "JHN.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Judhasi achangodya chingwa ichi, Satani akabva apinda maari.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.27",
            "verseOrgIds": [
              "JHN.13.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 13:27"
      },
      "items": [
        {
          "text": "Jesu akati kuna Judhasi, \"Zvaunoda kuita, ita nokukurumidza,\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.27",
            "verseOrgIds": [
              "JHN.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi hapana munhu akanga ari pakudya akanzwisisa kuti sei Jesu akanga ataura izvozvo kwaari.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.28",
            "verseOrgIds": [
              "JHN.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezvo Judhasi aiva mubati wemari, vamwe vakafunga kuti Jesu aimuudza kuti andotenga zvimwe zvaidikanwa pamutambo, kana kupa varombo chimwe chinhu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.29",
            "verseOrgIds": [
              "JHN.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Judhasi akati achangodya chingwa, akabuda panze. Uye hwaiva usiku.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.30",
            "verseOrgIds": [
              "JHN.13.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu Anozivisa nezvoKurambwa Kwake naPetro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati aenda, Jesu akati, \"Zvino Mwanakomana woMunhu akudzwa uye Mwari akudzwa maari.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.31",
            "verseOrgIds": [
              "JHN.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana Mwari akudzwa maari, Mwari achakudza Mwanakomana maari uye achamukudza pakarepo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.32",
            "verseOrgIds": [
              "JHN.13.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Vana vangu, ndichava nemi kwechinguva chiduku chete. Muchanditsvaka, uye sezvandaudza vaJudha, saizvozvo ndinokuudzai zvino kuti: Kwandinoenda, imi hamugoni kuuyako.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.33",
            "verseOrgIds": [
              "JHN.13.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndinokupai murayiro mutsva wokuti: Dananai. Sezvo ndakakudai, saizvozvo munofanira kudanana.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.34",
            "verseOrgIds": [
              "JHN.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuda kwaizvozvo, vanhu vose vachaziva kuti muri vadzidzi vangu kana mune rudo pakati penyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.35",
            "verseOrgIds": [
              "JHN.13.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni Petro akamubvunza akati, \"Ishe, muri kuendepiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.36",
            "verseOrgIds": [
              "JHN.13.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 13:36"
      },
      "items": [
        {
          "text": "Jesu akapindura akati, \"Kwandinoenda, imi hamugoni kutevera, asi muchazotevera pashure.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.36",
            "verseOrgIds": [
              "JHN.13.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro akati, \"Ishe seiko ndisingakwanisi kukuteverai iye zvino? Ndichakufirai ini.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.37",
            "verseOrgIds": [
              "JHN.13.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 13:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jesu akapindura akati, \"Uchandifira here? Ndinokuudza chokwadi kuti, jongwe risati rarira, uchandiramba katatu!\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.38",
            "verseOrgIds": [
              "JHN.13.38"
            ]
          }
        }
      ]
    }
  ],
