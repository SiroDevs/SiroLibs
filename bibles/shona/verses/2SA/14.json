{
  "id": "2SA.14",
  "number": "14",
  "bookId": "2SA",
  "reference": "2 Samueri 14",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "2SA 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhusaromu anodzokera kuJerusarema",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Joabhu mwanakomana waZeruya akaziva kuti mwoyo wamambo wakanga woshuva Abhusaromu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.1",
            "verseOrgIds": [
              "2SA.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Joabhu akatuma munhu kuTekoa kuti andouya nomukadzi akanga akachenjera kubva ikoko. Akati kwaari, \"Ita somunhu ari pakuchema. Upfeke nguo dzokuchema uye usazvizora mafuta. Uite somukadzi ava namazuva akawanda ari pakuchema vakafa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.2",
            "verseOrgIds": [
              "2SA.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ugoenda kuna mambo undotaura mashoko aya kwaari.\" Uye Joabhu akaisa mashoko mumuromo make.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.3",
            "verseOrgIds": [
              "2SA.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukadzi akabva kuTekoa akati asvika kuna mambo, akawira pasi nechiso chake, kuri kupa rukudzo, akati, \"Ndibatsireiwo, nhai mambo!\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.4",
            "verseOrgIds": [
              "2SA.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akamubvunza akati, \"Watambudzwa neiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.5",
            "verseOrgIds": [
              "2SA.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 14:5"
      },
      "items": [
        {
          "text": "Iye akati, \"Zvirokwazvo ndiri chirikadzi; murume wangu akafa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.5",
            "verseOrgIds": [
              "2SA.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino ini muranda wenyu ndakanga ndina vanakomana vaviri. Vakarwa vari vaviri musango, uye hapana aivapo kuti avarandutsire. Mumwe akarova mumwe uye akamuuraya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.6",
            "verseOrgIds": [
              "2SA.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino mhuri yose yamukira murandakadzi wenyu. Vari kuti, 'Tipei uyo akauraya mununʼuna wake, kuti timuuraye nokuda kwoupenyu hwomununʼuna wake waakauraya; kunyange tichizobvisa mudyi wenhaka zvakare.' Saka vachadzima zimbe rangu rimwe ranga rasara, vakasasiyira murume wangu zita kana rudzi panyika.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.7",
            "verseOrgIds": [
              "2SA.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akati kumukadzi, \"Enda hako kumba kwako, ini ndicharayira shoko pamusoro pako.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.8",
            "verseOrgIds": [
              "2SA.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi mukadzi weTekoa akati kwaari, \"Ishe wangu mambo, mhosva ngaive kwandiri nokuimba yababa vangu, uye mambo nechigaro chake choushe ngazvirege kuva nemhosva.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.9",
            "verseOrgIds": [
              "2SA.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akapindura akati, \"Kana munhu akataura chinhu kwauri, uya naye kwandiri, haangozokunetsizve.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.10",
            "verseOrgIds": [
              "2SA.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akati, \"Naizvozvo mambo ngaataure naIshe Mwari wake kuti mutsivi weropa arege kuramba achiparadza, kuti mwanakomana wangu arege kuparadzwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.11",
            "verseOrgIds": [
              "2SA.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 14:11"
      },
      "items": [
        {
          "text": "Mambo akati, \"NaJehovha mupenyu, hapana ruvhudzi rumwe rwomwanakomana wako ruchawira pasi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.11",
            "verseOrgIds": [
              "2SA.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mukadzi uya akati, \"Tenderai muranda wenyu kuti ataure shoko kuna ishe mambo wangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.12",
            "verseOrgIds": [
              "2SA.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 14:12"
      },
      "items": [
        {
          "text": "Iye akati, \"Taura hako.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.12",
            "verseOrgIds": [
              "2SA.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukadzi uya ndokuti, \"Zvino seiko makarongera vanhu vaMwari zvakadai? Kana mambo vachitaura zvakadai, havasi kuzvipa mhosva here, nokuti mambo havana kudzosa mwanakomana uya akambenge adzingwa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.13",
            "verseOrgIds": [
              "2SA.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Semvura yadeukira pasi, isingazogoni kudyorerwa, saizvozvo tinofanira kufa. Asi Mwari haaurayi munhu; pachinzvimbo chaizvozvo anotoronga zano rokuti akadzingwa arege kuraswa zvachose naye.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.14",
            "verseOrgIds": [
              "2SA.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvino ini ndauya kuzotaura izvi kuna ishe mambo wangu nokuti vanhu vandityisidzira. Murandakadzi wenyu akafunga akati, 'Rega ndinotaura namambo zvimwe vangaitira muranda wavo zvaanokumbira.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.15",
            "verseOrgIds": [
              "2SA.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvimwe mambo vangabvuma kurwira murandakadzi wavo kubva paruoko rwomunhu anotsvaka kuparadza zvose ini nomwanakomana wangu kuti tirege kugara nhaka yatakapiwa naMwari.'",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.16",
            "verseOrgIds": [
              "2SA.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvino murandakadzi wenyu anoti, 'Ndinokumbira kuti shoko rashe mambo wangu rindinyaradze, nokuti ishe wangu mambo akafanana nomutumwa waMwari pakuziva zvakanaka nezvakaipa. Jehovha Mwari wenyu ngaave nemi.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.17",
            "verseOrgIds": [
              "2SA.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mambo akati kumukadzi, \"Usandivanzira hako shoko randichakubvunza.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.18",
            "verseOrgIds": [
              "2SA.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 14:18"
      },
      "items": [
        {
          "text": "Mukadzi akati, \"Ishe mambo wangu ngavataure havo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.18",
            "verseOrgIds": [
              "2SA.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akabvunza akati, \"Ko, ruoko rwaJoabhu harusi kubatsirana newe pazvinhu zvose izvi here?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.19",
            "verseOrgIds": [
              "2SA.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 14:19"
      },
      "items": [
        {
          "text": "Mukadzi akapindura akati, \"Noupenyu hwenyu, ishe wangu mambo, hapana munhu angatendeukira kurudyi kana kuruboshwe kubva pane zvinenge zvataurwa nashe mambo wangu. Ichokwadi, muranda wenyu Joabhu ndiye andirayira kuti ndiite izvi uye ndiye aisa mashoko ose aya mumuromo womurandakadzi wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.19",
            "verseOrgIds": [
              "2SA.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muranda wenyu Joabhu akaita izvi kuti ashandure mamiriro ezvinhu. Ishe wangu ano uchenjeri sehwomutumwa waMwari, anoziva zvose zvinoitika panyika.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.20",
            "verseOrgIds": [
              "2SA.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akati kuna Joabhu, \"Zvakanaka chose, ndichaita saizvozvo. Chienda, unouya nejaya Abhusaromu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.21",
            "verseOrgIds": [
              "2SA.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabhu akawira pasi nechiso chake achipa rukudzo, uye akaropafadza mambo. Joabhu akati, \"Nhasi muranda wenyu aziva kuti awana nyasha pamberi penyu, ishe wangu mambo, nokuti mambo aita zvandakumbira ini muranda wake.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.22",
            "verseOrgIds": [
              "2SA.14.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Joabhu akaenda kuGeshuri akandouya naAbhusaromu kuJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.23",
            "verseOrgIds": [
              "2SA.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi mambo akati, \"Anofanira kuenda kuimba yake; haafaniri kuona chiso changu.\" Saka Abhusaromu akaenda kumba kwake akasaona chiso chamambo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.24",
            "verseOrgIds": [
              "2SA.14.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "MuIsraeri mose makanga musina murume airumbidzwa navanhu nokuda kworunako rwake saAbhusaromu. Kubva kumusoro wake kusvikira kutsoka dzake pakanga pasina panonzi apa pakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.25",
            "verseOrgIds": [
              "2SA.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pose paaigurira bvudzi rake, aigurira bvudzi rake nguva nenguva parainge rava kumuremera, airiyera, uye uremu hwaro hwaisvika mashekeri mazana maviri",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.26",
            "verseOrgIds": [
              "2SA.14.26"
            ]
          }
        },
        {
          "text": "kana zvichierwa nechiereso chamambo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.26",
            "verseOrgIds": [
              "2SA.14.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhusaromu akaberekerwa vanakomana vatatu nomwanasikana mumwe chete. Zita romwanasikana rainzi Tamari, uye akanga ari mukadzi akanaka pachiso.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.27",
            "verseOrgIds": [
              "2SA.14.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhusaromu akagara kwamakore maviri muJerusarema asina kumboona chiso chamambo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.28",
            "verseOrgIds": [
              "2SA.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Abhusaromu akadana Joabhu kuti amutume kuna mambo, asi akaramba kuenda kwaari. Saka akatumazve shoko kechipiri, asi akaramba kuuya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.29",
            "verseOrgIds": [
              "2SA.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akati kumuranda wake, \"Onaka, munda waJoabhu wakaganhurana nowangu, uye ane bhari imomo. Enda unoupisa.\" Naizvozvo varanda vaAbhusaromu vakapisa munda.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.30",
            "verseOrgIds": [
              "2SA.14.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Joabhu akaenda kumba kwaAbhusaromu akandoti kwaari, \"Ko, varanda vako vapisirei munda wangu?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.31",
            "verseOrgIds": [
              "2SA.14.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhusaromu akati kuna Joabhu, \"Tarira, ndakatuma shoko kwauri ndikati, 'Uya kuno kuti ndikutume kuna mambo unobvunza kuti, \"Ko, zvino ndakabvirei hangu kuGeshuri? Zvingadai zviri nani dai ndanga ndichiriko zvangu!\" ' Naizvozvo, ndinoda kuona chiso chamambo, uye kana ndine mhosva yechimwe chinhu, ngavandiuraye havo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.32",
            "verseOrgIds": [
              "2SA.14.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Joabhu akaenda kuna mambo akandotaura saizvozvo. Ipapo mambo akadana Abhusaromu, uye akauya akasvikokotamisa uso hwake pasi pamberi pamambo. Uye Mambo akatsvoda Abhusaromu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.33",
            "verseOrgIds": [
              "2SA.14.33"
            ]
          }
        }
      ]
    }
  ],
