  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "2SA 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "VaGibheoni vanotsivirwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva yokutonga kwaDhavhidhi, kwakava nenzara makore matatu achiteverana; saka Dhavhidhi akatsvaka chiso chaJehovha. Jehovha akati, \"Imhaka yaSauro neimba yake yeropa; imhaka yokuti akauraya vaGibheoni.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.1",
            "verseOrgIds": [
              "2SA.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akadana vaGibheoni akataura navo. (Zvino vaGibheoni vakanga vasiri vorudzi rwavaIsraeri asi vakanga vari vakasara vavaAmori; vakanga vapikirwa navaIsraeri kuti vasaurayiwe, asi Sauro mukushingaira kwake nokuda kwavaIsraeri navaJudha akaedza kuvaparadza.)",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.2",
            "verseOrgIds": [
              "2SA.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akabvunza vaGibheoni akati, \"Ndingakuitirai chiiko? Ndingayananisa neiko kuitira kuti mugoropafadza nhaka yaJehovha?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.3",
            "verseOrgIds": [
              "2SA.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaGibheoni vakamupindura vachiti, \"Hatina kodzero yokureva sirivha negoridhe kuna Sauro kana kumhuri yake, uye hatina kodzero yokuuraya munhu muIsraeri.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.4",
            "verseOrgIds": [
              "2SA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 21:4"
      },
      "items": [
        {
          "text": "Dhavhidhi akati, \"Munoda kuti ndikuitireiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.4",
            "verseOrgIds": [
              "2SA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakapindura mambo vakati, \"Kana ari munhu akatiparadza uye akaita rangano yokuti tipere uye tishayiwe nzvimbo kupi zvako muIsraeri,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.5",
            "verseOrgIds": [
              "2SA.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "zvizvarwa zvake zvechirume zvinomwe ngazvipiwe kwatiri kuti zviurayiwe uye zviiswe pachena pamberi paJehovha paGibhea raSauro musanangurwa waJehovha.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.6",
            "verseOrgIds": [
              "2SA.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 21:6"
      },
      "items": [
        {
          "text": "Saka mambo akati, \"Ndichavapa kwamuri.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.6",
            "verseOrgIds": [
              "2SA.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akararamisa Mefibhosheti mwanakomana waJonatani, mwanakomana waSauro, nokuda kwemhiko pamberi paJehovha pakati paDhavhidhi naJonatani mwanakomana waSauro.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.7",
            "verseOrgIds": [
              "2SA.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi mambo akatora Arimoni naMefibhosheti, vanakomana vaviri vaRizipa mwanasikana waAya, waakanga aberekera Sauro, pamwe chete navanakomana vashanu vaMerabhi mwanasikana waSauro, waakanga aberekera Adhirieri mwanakomana waBhazirai muMehorati.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.8",
            "verseOrgIds": [
              "2SA.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akavaisa mumaoko avaGibheoni, ivo vakavasungirira pachikomo pamberi paJehovha. Vose vari vanomwe vakafa pamwe chete; vakaurayiwa panguva yokutanga kukohwa, pakutanga kwokukohwewa kwebhari.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.9",
            "verseOrgIds": [
              "2SA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rizipa mwanasikana waAya akatora nguo yesaga akazviwaridzira pamusoro pedombo. Kubva pakutanga kwokukohwa kusvikira pakunaya kwemvura ichibva kudenga pamusoro pemitumbi yavo, haana kutendera shiri dzedenga kuti dzivabate masikati kana zvikara zvesango usiku.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.10",
            "verseOrgIds": [
              "2SA.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akati ataurirwa zvakaitwa naRizipa, mwanasikana waAya, murongo waSauro,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.11",
            "verseOrgIds": [
              "2SA.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "akaenda akandotora mapfupa aSauro naJonatani mwanakomana wake kubva kuvagari veJabheshi Gireadhi. Vakanga vaatora muchivande kubva pachivara chapaBheti Shani, uko kwavakanga vaturikwa navaFiristia shure kwokunge vauraya Sauro paGiribhoa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.12",
            "verseOrgIds": [
              "2SA.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akauya namapfupa aSauro naJonatani mwanakomana wake kubva ikoko, uye mapfupa aavo vakanga vaurayiwa vakaiswa pachena akaunganidzwa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.13",
            "verseOrgIds": [
              "2SA.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaviga mapfupa aSauro naJonatani mwanakomana wake muhwiro hwaKishi baba vaSauro, paZera muBhenjamini, uye vakaita zvose zvavakarayirwa namambo. Shure kwaizvozvo, Mwari akapindura munyengetero wokumiririra nyika.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.14",
            "verseOrgIds": [
              "2SA.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hondo navaFiristia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakavazve nehondo pakati pavaFiristia navaIsraeri. Dhavhidhi akaburuka navanhu vake kundorwa navaFiristia, uye akaneta kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.15",
            "verseOrgIds": [
              "2SA.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Ishibhi-Bhenoni, mumwe wezvizvarwa zvaRafa, aiva nomusoro wepfumo wairema mazana matatu amashekeri",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.16",
            "verseOrgIds": [
              "2SA.21.16"
            ]
          }
        },
        {
          "text": "uye akapakata munondo mutsva, akati achauraya Dhavhidhi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.16",
            "verseOrgIds": [
              "2SA.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Abhishai mwanakomana waZeruya akanunura Dhavhidhi; akabayira muFiristia pasi akamuuraya. Ipapo vanhu vaDhavhidhi vakapika kwaari vachiti, \"Hamuchazomboendizve nesu kuhondo, kuitira kuti mwenje weIsraeri urege kuzodzimwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.17",
            "verseOrgIds": [
              "2SA.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwaizvozvo, kwakavazve nokurwa navaFiristia, paGobhi. Panguva iyoyo Sibhekai muHushati akauraya Safi, mumwe wezvizvarwa zvaRafa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.18",
            "verseOrgIds": [
              "2SA.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pano kumwe kurwa navaFiristia paGobhi, Erihanani mwanakomana waJoare-Oregimi muBheterehema akauraya Goriati muGiti, akanga ane pfumo raiva nerwiriko rwakanga rwakaita setsvimbo yomuruki.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.19",
            "verseOrgIds": [
              "2SA.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pano kumwe kurwazve, kwakaitika paGati, pakanga pane hofori yomurume akanga ane minwe mitanhatu paruoko rumwe norumwe uye zvigunwe zvitanhatu parutsoka rumwe norumwe, zvose zviri makumi maviri nezvina. Naiyewo akanga ari chizvarwa chaRafa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.20",
            "verseOrgIds": [
              "2SA.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati achishora Israeri, Jonatani mwanakomana waShimea, mununʼuna waDhavhidhi, akamuuraya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.21",
            "verseOrgIds": [
              "2SA.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ava vari vana vakanga vari zvizvarwa zvaRafa muGati, uye vakafa pamaoko aDhavhidhi navanhu vake.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.22",
            "verseOrgIds": [
              "2SA.21.22"
            ]
          }
        }
      ]
    }
  ],
