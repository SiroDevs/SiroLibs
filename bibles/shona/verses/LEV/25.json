  "verseCount": 55,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "LEV 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gore reSabata",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Mozisi pagomo reSinai,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.1",
            "verseOrgIds": [
              "LEV.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Taura kuvaIsraeri uti kwavari: 'Kana mapinda munyika yandichakupai, nyika pachayo inofanira kucherechedza sabata kuna Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.2",
            "verseOrgIds": [
              "LEV.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwamakore matanhatu dyarai minda yenyu, uye kwamakore matanhatu, dimurirai mizambiringa yenyu mugounganidza michero yayo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.3",
            "verseOrgIds": [
              "LEV.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi mugore rechinomwe, nyika inofanira kuva nesabata rokuzorora, sabata kuna Jehovha. Musadyara minda yenyu kana kudimurira mizambiringa yenyu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.4",
            "verseOrgIds": [
              "LEV.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musakohwa zvinomera zvoga kana kukohwa mazambiringa amagoko. Nyika inofanira kuva negore rokuzorora.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.5",
            "verseOrgIds": [
              "LEV.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gohwo ripi neripi renyika resabata richava zvokudya zvenyu, zvako iwe, murandarume wako nomurandakadzi wako, uye mushandi nomueni agere pakati penyu,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.6",
            "verseOrgIds": [
              "LEV.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamwe chete nezvipfuwo zvenyu nemhuka dzesango dziri munyika yenyu. Zvibereko zvose zvomunyika zvingadyiwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.7",
            "verseOrgIds": [
              "LEV.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gore reJubhiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Verengai maSabata manomwe amakore, makore manomwe akapetwa kanomwe, kuitira kuti maSabata manomwe amakore akwane nguva inoita makore makumi mana namapfumbamwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.8",
            "verseOrgIds": [
              "LEV.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo urayire kuti hwamanda iridzwe kwose pazuva regumi romwedzi wechinomwe; paZuva Rokuyananisira ridzai hwamanda munyika yenyu yose.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.9",
            "verseOrgIds": [
              "LEV.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsaurai gore ramakumi mashanu mugoparidza rusununguko munyika yose kuvagari vayo vose. Richava Jubhiri kwamuri; mumwe nomumwe wenyu anofanira kudzokera kune zvake, uye mumwe nomumwe kumhuri yake.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.10",
            "verseOrgIds": [
              "LEV.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gore ramakumi mashanu richava gore reJubhiri kwamuri. Musadyara uye musakohwa mazambiringa amagoko.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.11",
            "verseOrgIds": [
              "LEV.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti iJubhiri uye rinofanira kuva dzvene kwamuri. Idyai chete zvinotorwa kubva muminda.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.12",
            "verseOrgIds": [
              "LEV.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Mugore iri reJubhiri munhu wose anofanira kudzokera kune zvake.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.13",
            "verseOrgIds": [
              "LEV.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kana mukatengesa munda kuno mumwe womunyika menyu kana kutenga kwaari, musabiridzirana.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.14",
            "verseOrgIds": [
              "LEV.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munofanira kutenga kubva kuvagari venyika yenyu zvichienderana nouwandu hwamakore kubva pagore reJubhiri. Uye iye anofanira kutengesa zvichienderana nouwandu hwamakore asara okukohwa zvirimwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.15",
            "verseOrgIds": [
              "LEV.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana makore awanda, munofanira kuwedzera mutengo, uye kana makore ari mashoma, munofanira kudzikisa mutengo, nokuti zvaari kukutengeserai ndizvo chaizvoizvo uwandu hwezvirimwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.16",
            "verseOrgIds": [
              "LEV.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musabiridzirana, asi ityai Mwari wenyu. Ndini Jehovha Mwari wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.17",
            "verseOrgIds": [
              "LEV.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Teverai mitemo yangu mugochenjerera kuti muteerere mirayiro yangu, ipapo muchagara makachengetedzeka munyika.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.18",
            "verseOrgIds": [
              "LEV.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo nyika ichabereka zvibereko zvayo uye imi muchadya kusvikira maguta, mugogara makachengetedzeka.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.19",
            "verseOrgIds": [
              "LEV.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungabvunza muchiti, \"Ko, tichadyei mugore rechinomwe kana tisingadyari kana kukohwa zvirimwa zvedu?\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.20",
            "verseOrgIds": [
              "LEV.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichakutumirai ropafadzo mugore rechitanhatu zvokuti nyika ichabereka zvinokwana makore matatu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.21",
            "verseOrgIds": [
              "LEV.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamunenge muchidyara mugore rorusere muchadya kubva kuzvirimwa zvakare, uye mucharamba muchidya kubva kwazviri kusvika gohwo regore rechipfumbamwe rasvika.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.22",
            "verseOrgIds": [
              "LEV.25.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Munda haufaniri kutengeswa nokusingaperi, nokuti nyika ndeyangu uye imi muri vatorwa navaeni kwandiri.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.23",
            "verseOrgIds": [
              "LEV.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyika yose yamuchatora, munofanira kutendera kudzikinurwa kwenyika.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.24",
            "verseOrgIds": [
              "LEV.25.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kana mumwe wavagari venyika yenyu akava murombo akatengesa zvimwe zvezvinhu zvake, hama yake yepedyo inofanira kuuya kuzodzikinura zvakatengeswa nehama yake.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.25",
            "verseOrgIds": [
              "LEV.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvisinei, kana munhu ashaya angamudzikinurira zvinhu izvi, asi iye akazobudirira akawana nzira dzakakwana dzokuzvidzikinura,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.26",
            "verseOrgIds": [
              "LEV.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "anofanira kupima kukosha kwomutengo wazvo kubva pagore raakazvitengesa, agodzosera zvasara pamuripo wazvo, kumurume waakazvitengesera; ipapo angadzokera kune zvake.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.27",
            "verseOrgIds": [
              "LEV.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana akashaya nzira dzokumudzorera nadzo, zvaakatengesa zvicharamba zviri mumaoko omutengi kusvikira gore reJubhiri. Zvichadzoserwa mugore reJubhiri uye iye achagona kudzokera kune zvake.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.28",
            "verseOrgIds": [
              "LEV.25.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kana munhu akatengesa imba muguta rino rusvingo, anoramba aine mvumo yokuidzikinura kwegore rose shure kwokutengeswa kwayo. Munguva iyoyo anogona kuidzikinura.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.29",
            "verseOrgIds": [
              "LEV.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana isina kudzikinurwa gore risati rapfuura, imba iri muguta rino rusvingo ichava yowakatenga nezvizvarwa zvake nokusingaperi. Haifaniri kudzorerwa paJubhiri.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.30",
            "verseOrgIds": [
              "LEV.25.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 25:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi dzimba dziri mumisha isina kukomberedzwa namasvingo dzinofanira kuonekwa sesango. Dzinogona kudzikinurwa uye dzinofanira kudzoserwa muJubhiri.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.31",
            "verseOrgIds": [
              "LEV.25.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'VaRevhi vane mvumo nguva dzose yokudzikinura dzimba dzavo mumaguta avaRevhi, anova avo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.32",
            "verseOrgIds": [
              "LEV.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo zvinhu zvavaRevhi zvinogona kudzikinurwa, zvichireva kuti imba inotengeswa muguta ravo ripi neripi inofanira kudzoserwa muJubhiri, nokuti dzimba dziri mumaguta avaRevhi zvinhu zvavo pakati pavaIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.33",
            "verseOrgIds": [
              "LEV.25.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi mafuro amaguta avo haafaniri kutengeswa; inhaka yavo inogara nokusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.34",
            "verseOrgIds": [
              "LEV.25.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kana mumwe wehama dzenyu akava murombo uye asisagoni kuzviriritira pakati penyu, mubatsirei sezvamunoita mutorwa kana mueni kuti arambe achigara pakati penyu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.35",
            "verseOrgIds": [
              "LEV.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musatora mhindu yemhando ipi zvayo kubva kwaari, asi ityai Mwari wenyu kuitira kuti hama yenyu irambe ichigara pakati penyu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.36",
            "verseOrgIds": [
              "LEV.25.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 25:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamufaniri kumukweretesa mari muchiti ichazobereka mhindu kana kumutengesera zvokudya zvine mhindu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.37",
            "verseOrgIds": [
              "LEV.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndini Jehovha Mwari wenyu akakubudisai kubva muIjipiti kuti ndikupei nyika yeKenani uye kuti ndive Mwari wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.38",
            "verseOrgIds": [
              "LEV.25.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 25:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kana mumwe wehama dzenyu akava murombo pakati penyu akazvitengesa kwamuri, musamuita kuti ashande somuranda.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.39",
            "verseOrgIds": [
              "LEV.25.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 25:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anofanira kubatwa somushandi wamaricho kana kuti mushanyi ari pakati penyu; anofanira kukushandirai kusvikira Gore reJubhiri.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.40",
            "verseOrgIds": [
              "LEV.25.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 25:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo iye navana vake vanofanira kusunungurwa, uye achadzokera kurudzi rwake nokuzvinhu zvamadzitateguru ake.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.41",
            "verseOrgIds": [
              "LEV.25.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 25:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti vaIsraeri varanda vangu vandakabudisa kubva muIjipiti, havafaniri kutengeswa senhapwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.42",
            "verseOrgIds": [
              "LEV.25.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 25:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musavatonga neutsinye, asi ityai Mwari wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.43",
            "verseOrgIds": [
              "LEV.25.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 25:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nhapwa dzenyu dzechirume nedzechikadzi dzinofanira kubva mundudzi dzakakukomberedzai; munogona kutenga nhapwa kubva kwavari.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.44",
            "verseOrgIds": [
              "LEV.25.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 25:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munogona kutengawo vatorwa vashanyi vagere pakati penyu nemhuri dzavo dzakaberekerwa munyika yenyu, uye vachava pfuma yenyu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.45",
            "verseOrgIds": [
              "LEV.25.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 25:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munogona kuvaita nhaka yavana venyu uye kuvaita nhapwa kweupenyu hwavo hwose, asi hamufaniri kutonga vamwe vaIsraeri zvakaomarara.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.46",
            "verseOrgIds": [
              "LEV.25.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 25:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Mutorwa kana mushanyi pakati penyu akava mupfumi, uye mumwe wavanhu venyika yenyu akava murombo akazvitengesa kumutorwa agere pakati penyu, kana kumhuri yomutorwa,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.47",
            "verseOrgIds": [
              "LEV.25.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LEV 25:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "anoramba ane mvumo yokudzikinurwa mushure mokunge azvitengesa. Mumwe wehama dzake anogona kumudzikinura:",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.48",
            "verseOrgIds": [
              "LEV.25.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LEV 25:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babamunini vake kana mwanakomana wababamunini vake, kana hama yake yapedyo worudzi rwake angamudzikinura.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.49",
            "verseOrgIds": [
              "LEV.25.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LEV 25:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye neanomutenga vanofanira kuverenga nguva kubva pagore raakazvitengesa kusvikira paGore reJubhiri. Mutengo wokusunungurwa kwake unofanira kuenzaniswa nemari inoripwa mushandi wemaricho kwamakore iwayo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.50",
            "verseOrgIds": [
              "LEV.25.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LEV 25:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana kuchine makore akawanda asara, anofanira kuripira rudzikinuro rwake, chikamu chikuru chemari yaakaripirwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.51",
            "verseOrgIds": [
              "LEV.25.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LEV 25:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana kwasara makore mashoma shoma Gore reJubhiri risati rasvika, anofanira kurangana naye agodzosera mari yorudzikinuro rwake zvichienzaniswa namakore ake.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.52",
            "verseOrgIds": [
              "LEV.25.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LEV 25:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anofanira kubatwa somushandi wemaricho gore rimwe nerimwe; munofanira kuona kuti tenzi wake haamutongi zvakaomarara.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.53",
            "verseOrgIds": [
              "LEV.25.53"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LEV 25:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kunyange zvake asina kudzikinurwa neimwe yenzira idzi, iye navana vake vanofanira kusunungurwa mugore reJubhiri,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.54",
            "verseOrgIds": [
              "LEV.25.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LEV 25:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti vaIsraeri ndevangu savaranda vangu. Varanda vangu vandakabudisa kubva muIjipiti. Ndini Jehovha Mwari wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.55",
            "verseOrgIds": [
              "LEV.25.55"
            ]
          }
        }
      ]
    }
  ],
