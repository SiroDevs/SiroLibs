  "verseCount": 59,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "LEV 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mirayiro pamusoro pezvirwere zveganda zvinotapukira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Mozisi naAroni,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.1",
            "verseOrgIds": [
              "LEV.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana ani naani ane pakazvimba kana kuti ane tumapundu kana chivara chichena paganda rake chinogona kunge chiri chirwere chinotapukira anofanira kuuyiswa kuna Aroni muprista kana kuno mumwe wavanakomana vake muprista.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.2",
            "verseOrgIds": [
              "LEV.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muprista achatarisa chironda chiri paganda rake, uye kana bvudzi riri pachironda rachena uye ronda roratidza kudzika kudarika paganda, chirwere cheganda chinotapukira. Kana muprista akamuongorora achamuzivisa kuvanhu somunhu asina kuchena.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.3",
            "verseOrgIds": [
              "LEV.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana gwapa riri paari riri jena asi risingaratidzi kudzika kudarika paganda uye bvudzi risina kuchena, muprista anofanira kugarisa munhu iyeye oga kwamazuva manomwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.4",
            "verseOrgIds": [
              "LEV.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva rechinomwe muprista anofanira kumuongorora uye akaona kuti chironda hachina kupinduka uye hachina kupararira muganda anofanira kumuchengeta pake oga kwamamwe mazuva manomwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.5",
            "verseOrgIds": [
              "LEV.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva rechinomwe muprista anofanira kumuongorora zvakare, uye kana chironda chaserera uye chisina kupararira neganda, muprista achamuzivisa somunhu akachena, tunongova tumapundu. Munhu anofanira kusuka nguo dzake uye achava akachena.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.6",
            "verseOrgIds": [
              "LEV.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana tumapundu tukapararira nomuviri wake shure kwokunge azviratidza kumuprista kuti zviziviswe kuti akachena, anofanira kuenda kumuprista zvakare.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.7",
            "verseOrgIds": [
              "LEV.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muprista anofanira kumuongorora, uye kana tumapundu twapararira neganda, achazivisa kuti haana kuchena; chirwere chinotapukira.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.8",
            "verseOrgIds": [
              "LEV.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana munhu upi zvake ane chirwere chinotapukira, anofanira kuuyiswa kumuprista.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.9",
            "verseOrgIds": [
              "LEV.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muprista anofanira kumuongorora, uye kana pane kuzvimba nokucheneruka paganda, uye zvapindura bvudzi kuti rive jena, uye kana pane nyama yakatsvuka, pakazvimba,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.10",
            "verseOrgIds": [
              "LEV.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "chirwere cheganda chava nenguva uye muprista achazivisa kuti haana kuchena. Haafaniri kumugarisa ari oga, nokuti atogara asina kuchena.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.11",
            "verseOrgIds": [
              "LEV.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana chirwere chikabuda paganda rake rose uye sokuona kwomuprista, chakafukidza ganda rose romunhu abatwa nehosha, kubva kumusoro kusvika kutsoka,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.12",
            "verseOrgIds": [
              "LEV.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "muprista anofanira kumuongorora uye kana chirwere chapararira nomuviri wake wose, achazivisa kuti munhu uyu akachena, sezvo zvose zvachenuruka, akachena.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.13",
            "verseOrgIds": [
              "LEV.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi pose panoonekwa ronda paari, achava asina kuchena.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.14",
            "verseOrgIds": [
              "LEV.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muprista paachaona ronda, achazivisa kuti haana kuchena. Ronda harina kuchena ane chirwere chinotapukira.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.15",
            "verseOrgIds": [
              "LEV.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvikaitika kuti ronda richeneruke, anofanira kuenda kumuprista.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.16",
            "verseOrgIds": [
              "LEV.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo muprista anofanira kumuongorora uye kana zvironda zvachenuruka, muprista achazivisa kuti munhu ane hosha uyu akachena, ipapo achava akachena.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.17",
            "verseOrgIds": [
              "LEV.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana munhu akava nemota paganda rake rikapora,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.18",
            "verseOrgIds": [
              "LEV.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye panzvimbo panga pane mota pakazvimba pakacheneruka kana kuti pakatsvuka, anofanira kuzviratidza kumuprista.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.19",
            "verseOrgIds": [
              "LEV.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muprista anofanira kumuongorora uye kana zvikaratidza kudzika kudarika paganda uye bvudzi riri pachiri rikapinduka rikava jena, muprista achazivisa kuti haana kuchena, chirwere chinotapukira cheganda chabuda panga pane mota.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.20",
            "verseOrgIds": [
              "LEV.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana muprista achiongorora, pasina bvudzi jena pachiri uye paserera, ipapo muprista anofanira kumugarisa oga kwamazuva manomwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.21",
            "verseOrgIds": [
              "LEV.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana zviri kupararira muganda, muprista achazivisa kuti haana kuchena, zvinotapukira.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.22",
            "verseOrgIds": [
              "LEV.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana gwapa risina kupinduka uye risina kupararira, rinongova vanga kubva pamota uye muprista achazivisa kuti akachena.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.23",
            "verseOrgIds": [
              "LEV.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana munhu akatsva paganda uye akabuda gwapa dzvuku kana rakacheneruka paronda rokutsva,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.24",
            "verseOrgIds": [
              "LEV.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "muprista anofanira kutarisa gwapa uye kana bvudzi riri pariri rapinduka rikava jena uye zvakadzika kudarika ganda, chirwere chinotapukira cheganda chabuda pakatsva.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.25",
            "verseOrgIds": [
              "LEV.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana muprista akachiongorora, pasina bvudzi jena pagwapa uye kana zvisina kudzika kudarika ganda uye zvaserera, ipapo muprista anofanira kumugarisa oga kwamazuva manomwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.26",
            "verseOrgIds": [
              "LEV.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva rechinomwe muprista anofanira kumuongorora uye kana zvichipararira neganda, muprista achazivisa kuti haana kuchena; chirwere chinotapukira cheganda.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.27",
            "verseOrgIds": [
              "LEV.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana gwapa rikasapinduka uye risina kupararira neganda, asi raserera, kuzvimba kunobva pakutsva uye muprista achazivisa kuti akachena, rinongova vanga rinobva pakutsva.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.28",
            "verseOrgIds": [
              "LEV.13.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana munhurume kana munhukadzi akava nechironda mumusoro kana pachirebvu,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.29",
            "verseOrgIds": [
              "LEV.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "muprista anofanira kuongorora chironda, uye kana chichiratidza kudzika kudarika ganda, uye bvudzi riri machiri riri renhundurwa uye riri dete, muprista achazivisa kuti munhu iyeye haana kuchena, kuvava, chirwere chinotapukira chomusoro kana chechirebvu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.30",
            "verseOrgIds": [
              "LEV.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana muprista akaongorora ronda iri uye kana risingaratidzi kudzika kudarika ganda uye pasina bvudzi dema pariri, zvino muprista anofanira kuchengeta munhu ane hosha ari oga kwamazuva manomwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.31",
            "verseOrgIds": [
              "LEV.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva rechinomwe muprista anofanira kuongorora ronda, uye kana kuvava kusina kupararira uye pasina bvudzi renhundurwa uye risingaratidzi kudzika kudarika ganda,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.32",
            "verseOrgIds": [
              "LEV.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "anofanira kuveurwa bvudzi pachisiyiwa nzvimbo ine hosha, uye muprista anofanira kumuchengeta ari oga kwamamwe mazuva manomwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.33",
            "verseOrgIds": [
              "LEV.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva rechinomwe muprista anofanira kuongorora panovava, uye kana pasina kupararira neganda zvichiratidza kuti hazvina kudzika kudarika ganda, muprista achazivisa kuti akachena. Anofanira kusuka nguo dzake agova akachena.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.34",
            "verseOrgIds": [
              "LEV.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana kuvava kukaparira neganda iye aziviswa kuti akachena,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.35",
            "verseOrgIds": [
              "LEV.13.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "muprista anofanira kumuongorora, uye kana kuvava kwapararira neganda, muprista haafaniri kutsvaga bvudzi renhundurwa, nokuti munhu iyeye haana kuchena.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.36",
            "verseOrgIds": [
              "LEV.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvisinei hazvo, kana zvikaitika kuti sokuona kwake hazvina kupinduka, uye bvudzi dema ramera mazviri, kuvava kwaporeswa, achena uye muprista achazivisa kuti akachena.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.37",
            "verseOrgIds": [
              "LEV.13.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 13:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana munhurume kana munhukadzi ane makwapa machena paganda",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.38",
            "verseOrgIds": [
              "LEV.13.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 13:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "muprista anofanira kuaongorora uye kana makwapa asina kunyanyochena, tumapundu tusingakuvadzi twabuda paganda, munhu iyeye akachena.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.39",
            "verseOrgIds": [
              "LEV.13.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 13:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana bvudzi romumwe rikabva akasara asisina bvudzi, ava nemhanza, akachena.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.40",
            "verseOrgIds": [
              "LEV.13.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 13:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana akabva bvudzi pahuma uye akasara ava nemhanza, akachena.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.41",
            "verseOrgIds": [
              "LEV.13.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 13:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana ane chironda chichena chakatsvukuruka pamhanza yake kana pahuma, chirwere chinotapukira chabuda pamusoro pake kana pahuma.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.42",
            "verseOrgIds": [
              "LEV.13.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 13:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muprista anofanira kumuongorora uye kana kuzvimba kuri pamusoro pake kana pamhanza kwakatsvukuruka nokuchena sechirwere chinotapukira cheganda,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.43",
            "verseOrgIds": [
              "LEV.13.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 13:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "murume iyeye arwara uye haana kuchena. Muprista anofanira kuzivisa kuti haana kuchena nokuda kwechironda chiri pamusoro wake.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.44",
            "verseOrgIds": [
              "LEV.13.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 13:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Munhu ane chirwere chinotapukira ichi anofanira kupfeka nguo dzakabvaruka, osiya bvudzi rake risina kukamwa, ofukidza chikamu chepasi cheuso hwake, odanidzira achiti, 'Handina kuchena! Handina kuchena!'",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.45",
            "verseOrgIds": [
              "LEV.13.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 13:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana aramba ane chirwere ichocho anongoramba asina kuchena. Anofanira kugara oga; anofanira kugara kunze kwomusasa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.46",
            "verseOrgIds": [
              "LEV.13.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mirayiro yaMaperembudzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 13:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana nguo ipi neipi yazadzwa maperembudzi, ingava nguo yeshinda, kana yewuru kana yomucheka,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.47",
            "verseOrgIds": [
              "LEV.13.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LEV 13:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "ungava mucheka wakarukwa kana mucheka wewuru kana wedehwe kana chinhu chakagadzirwa nedehwe,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.48",
            "verseOrgIds": [
              "LEV.13.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LEV 13:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye kana utachiona huri muchipfeko kana dehwe kana mucheka wakarukwa kana chinhu chedehwe, chiri choruvara rwezerere kana chakatsvukuruka, chirwere chinopararira chamaperembudzi uye chinofanira kuratidzwa kumuprista.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.49",
            "verseOrgIds": [
              "LEV.13.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LEV 13:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muprista anofanira kuchiongorora agochengeta chinhu chacho pacho choga kwamazuva manomwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.50",
            "verseOrgIds": [
              "LEV.13.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LEV 13:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva rechinomwe anofanira kuchiongorora uye kana maperembudzi apararira muchipfeko kana nguo yakarukwa, zvisinei kuti chinoshandiswei, chirwere chinoparadza chamaperembudzi; chinhu ichocho hachina kuchena.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.51",
            "verseOrgIds": [
              "LEV.13.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LEV 13:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anofanira kupisa nguo yacho, kana mucheka wakarukwa wewuru kana mucheka weshinda, kana wedehwe une utachiona mauri, nokuti maperembudzi anoparadza, chinhu ichocho chinofanira kupiswa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.52",
            "verseOrgIds": [
              "LEV.13.52"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LEV 13:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asi kana muprista akachiongorora, maperembudzi asina kupararira muchipfeko kana mucheka wakarukwa, kana chinhu chakagadzirwa nedehwe,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.53",
            "verseOrgIds": [
              "LEV.13.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LEV 13:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "acharayira kuti chinhu chine utachiona chisukwe. Ipapo anofanira kuchigarisa choga kwamamwe mazuva manomwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.54",
            "verseOrgIds": [
              "LEV.13.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LEV 13:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure mokunge chinhu chine utachiona chasukwa, muprista anofanira kuchiongorora uye kana maperembudzi asina kuratidza kupinduka maonekero awo, kunyange zvisina kupararira, hachina kuchena. Pisai chinhu ichocho nomoto kunyange maperembudzi akanganisa divi rimwe chete.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.55",
            "verseOrgIds": [
              "LEV.13.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LEV 13:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana muprista akachiongorora, maperembudzi akange aumbuka mushure mokunge chinhu chasukwa, anofanira kubvarura chidimbu chapinda utachiona kubva panguo, kana padehwe kana pamucheka wakarukwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.56",
            "verseOrgIds": [
              "LEV.13.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "LEV 13:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana zvikabuda zvakare pachipfeko, kana pamucheka wakarukwa, kana pachinhu chedehwe, zviri kupararira uye chose chine maperembudzi chinofanira kupiswa nomoto.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.57",
            "verseOrgIds": [
              "LEV.13.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "LEV 13:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguo iyi, kana mucheka wakarukwa, kana chinhu chedehwe chasukwa uye chabviswa maperembudzi, chinofanira kusukwa zvakare uye chichava chakachena.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.58",
            "verseOrgIds": [
              "LEV.13.58"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "LEV 13:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyi ndiyo mirayiro inoenderana nokuzadzwa namaperembudzi kwechipfeko chewuru kana chomucheka, mucheka wakarukwa kana chinhu chose chedehwe kuti zvigoziviswa kuti zvakachena kana kuti hazvina kuchena.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.59",
            "verseOrgIds": [
              "LEV.13.59"
            ]
          }
        }
      ]
    }
  ],
