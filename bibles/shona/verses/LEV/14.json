        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kucheneswa paChirwere chaMaperembudzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Mozisi:",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.1",
            "verseOrgIds": [
              "LEV.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iyi ndiyo mirayiro yomunhu ane chirwere panguva yake yokucheneswa kana auyiswa kumuprista:",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.2",
            "verseOrgIds": [
              "LEV.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muprista anofanira kuenda kunze kwomusasa agonomuongorora. Kana munhu aporeswa kubva kumaperembudzi,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.3",
            "verseOrgIds": [
              "LEV.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "muprista acharayira kuti shiri mbiri mhenyu dzakachena, nedanda romusidhari, nomucheka mutsvuku, nehisopi zviuyiswe kuti acheneswe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.4",
            "verseOrgIds": [
              "LEV.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo muprista acharayirwa kuti imwe yeshiri idzi iurayiwe pamusoro pemvura yakachena muhari yevhu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.5",
            "verseOrgIds": [
              "LEV.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anofanira zvino kutora shiri mhenyu oinyika pamwe chete nedanda romusidhari, mucheka mutsvuku nehisopi muropa reshiri yaurayiwa pamusoro pemvura yakachena.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.6",
            "verseOrgIds": [
              "LEV.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achasasa uyo anofanira kucheneswa kubva kuchirwere chamaperembudzi kanomwe, agozivisa kuti akachena. Ipapo anofanira kuregera shiri mhenyu ichienda musango.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.7",
            "verseOrgIds": [
              "LEV.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Munhu anofanira kucheneswa anofanira kusuka nguo dzake agoveura bvudzi rake rose agoshamba nemvura, ipapo achava akacheneswa. Mushure maizvozvi anogona kuuya mumusasa asi anofanira kugara kunze kwetende rake kwamazuva manomwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.8",
            "verseOrgIds": [
              "LEV.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva rechinomwe anofanira kuveura bvudzi rake rose. Anofanira kuveura musoro wake, ndebvu dzake, tsiye dzake, nerimwe bvudzi rake rose. Anofanira kusuka nguo dzake agozvishambidza nemvura uye achava akachena.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.9",
            "verseOrgIds": [
              "LEV.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pazuva rorusere anofanira kuuya namakwayana maviri amakondobwe nesheshe imwe chete, dzose dzine gore dzisina kuremara, pamwe chete nezvikamu zvitatu kubva mugumi zveefa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.10",
            "verseOrgIds": [
              "LEV.14.10"
            ]
          }
        },
        {
          "text": "zvoupfu hwakatsetseka hwakasanganiswa namafuta sechipiriso chezviyo nerogi",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.10",
            "verseOrgIds": [
              "LEV.14.10"
            ]
          }
        },
        {
          "text": "imwe chete yamafuta.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.10",
            "verseOrgIds": [
              "LEV.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muprista achazivisa kuti akachena, anofanira kuuya nouya anofanira kucheneswa nezvipiriso zvake pamberi paJehovha pamusuo weTende Rokusangana.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.11",
            "verseOrgIds": [
              "LEV.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ipapo muprista anofanira kutora gwayana rimwe chete gono agoripa sechipiriso chemhosva pamwe chete nerogi ramafuta; achazvininira pamberi paJehovha sechipiriso chokuninira.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.12",
            "verseOrgIds": [
              "LEV.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anofanira kubaya gwayana panzvimbo tsvene apo panobayirwa chipiriso chezvivi nechipiriso chinopiswa. Sezvakaita chipiriso chezvivi, chipiriso chemhosva ndechomuprista, chitsvene-tsvene.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.13",
            "verseOrgIds": [
              "LEV.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muprista anofanira kutora rimwe ropa rechipiriso chemhosva agoriisa pamucheto wenzeve yokurudyi yomunhu anocheneswa, pamunwe wake mukuru wokuruoko rwokurudyi uye napachigunwe chikuru chetsoka yake yokurudyi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.14",
            "verseOrgIds": [
              "LEV.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo muprista achatora imwe rogi yamafuta agodira muchanza choruoko rwake rworuboshwe,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.15",
            "verseOrgIds": [
              "LEV.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "agonyika munwe wake wokutendeka nawo wokurudyi mumafuta ari muchanza choruoko rwake agosasa mamwe acho nomunwe kanomwe pamberi paJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.16",
            "verseOrgIds": [
              "LEV.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muprista achaisa mamwe mafuta anosara muchanza panzeve yokurudyi youyo anofanira kucheneswa, pamunwe mukuru woruoko rwake rwokurudyi nepachigunwe chikuru chegumbo rake rokurudyi pamusoro peropa rechipiriso chemhosva.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.17",
            "verseOrgIds": [
              "LEV.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mamwe mafuta ose ari muchanza make muprista achaaisa pamusoro pouyo achada kucheneswa, agomuyananisira pamberi paJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.18",
            "verseOrgIds": [
              "LEV.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ipapo muprista achabayira chipiriso chechivi agoyananisira uyo anofanira kucheneswa kubva pakusachena kwake. Mushure maizvozvo muprista achabaya chipiriso chinopiswa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.19",
            "verseOrgIds": [
              "LEV.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "agochipa paaritari pamwe chete nechipiriso chezviyo, agomuyananisira, uye achava akachena.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.20",
            "verseOrgIds": [
              "LEV.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asi kana ari murombo asingakwanisi kuuya naizvozvi, anofanira kutora gwayana gono sechipiriso chemhosva kuti aninire agomuyananisira pamwe chete nechikamu chimwe chete kubva mugumi cheefa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.21",
            "verseOrgIds": [
              "LEV.14.21"
            ]
          }
        },
        {
          "text": "youpfu hwakatsetseka hwakasangana namafuta sechipiriso chezviyo, zvikamu zviviri kubva muzvitatu zverogi ramafuta,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.21",
            "verseOrgIds": [
              "LEV.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "njiva mbiri kana hangaiwa mbiri dzaanokwanisa kuuya nadzo, imwe yechipiriso chechivi neimwe yechipiriso chinopiswa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.22",
            "verseOrgIds": [
              "LEV.14.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pazuva rorusere anofanira kuzviuyisa kumuprista pamusuo weTende Rokusangana pamberi paJehovha, kuti acheneswe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.23",
            "verseOrgIds": [
              "LEV.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muprista anofanira kutora gwayana rechipiriso chemhosva nerogi ramafuta agozvininira pamberi paJehovha sechipiriso chokuninira.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.24",
            "verseOrgIds": [
              "LEV.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achabaya gwayana rechipiriso chemhosva agotora rimwe ropa raro agoriisa panzeve yokurudyi yomunhu anoda kucheneswa, pamunwe mukuru woruoko rwokurudyi napachigunwe chikuru chepagumbo rokurudyi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.25",
            "verseOrgIds": [
              "LEV.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muprista achadira mamwe mafuta muchanza choruoko rwake rworuboshwe",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.26",
            "verseOrgIds": [
              "LEV.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye nomunwe wake wokurudyi wokutendeka nawo agomwaya mamwe mafuta anobva muchanza chake kanomwe pamberi paJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.27",
            "verseOrgIds": [
              "LEV.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mamwe mafuta ari muchanza chake anofanira kuaisa munzvimbo dzimwe chetedzo dzaakaisa ropa rechipiriso chemhosva panzeve yokurudyi youyo anoda kucheneswa, pamunwe mukuru woruoko rwake rwokurudyi napachigunwe chikuru chegumbo rake rokurudyi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.28",
            "verseOrgIds": [
              "LEV.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mamwe mafuta ose achasara muchanza muprista achaaisa mumusoro mouyo anofanira kucheneswa, kuti ayananisirwe pamberi paJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.29",
            "verseOrgIds": [
              "LEV.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo achabayira njiva kana hangaiwa diki izvo zvaanogona kuwana,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.30",
            "verseOrgIds": [
              "LEV.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "imwe sechipiriso chechivi neimwe sechipiriso chinopiswa pamwe chete nechipiriso chezviyo. Nenzira iyi muprista achayananisira pamberi paJehovha, panzvimbo youya anofanira kucheneswa.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.31",
            "verseOrgIds": [
              "LEV.14.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyi ndiyo mirayiro pamusoro pouyo ane chirwere chamaperembudzi uye asingakwanisi kuuya nezvipiriso zvinofanira kupiwa kuti acheneswe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.32",
            "verseOrgIds": [
              "LEV.14.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kucheneswa kubva paMaperembudzi mudzimba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Mozisi naAroni,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.33",
            "verseOrgIds": [
              "LEV.14.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana mapinda munyika yeKenani iyo yandiri kukupai senhaka, ndikaita chirwere chinopararira chamaperembudzi muimba iri munyika iyoyo,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.34",
            "verseOrgIds": [
              "LEV.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "muridzi weimba anofanira kuenda kundoudza muprista kuti, 'Ndaona chimwe chinhu chinenge maperembudzi mumba mangu.'",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.35",
            "verseOrgIds": [
              "LEV.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo muprista anofanira kurayira kuti vabudise zvose zviri mumba muprista asati apinda kundotarira hosha, kuti kurege kuva nechinhu chiri mumba chichanzi hachina kuchena. Mushure maizvozvo muprista anofanira kupinda agoongorora imba.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.36",
            "verseOrgIds": [
              "LEV.14.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 14:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anofanira kuongorora chakwindi chiri mumadziro eimba uye kana pane makomba makomba ane ruvara rwezerere kana akatsvukuruka,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.37",
            "verseOrgIds": [
              "LEV.14.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "muprista anofanira kubuda napamusuo wemba agoipfiga kwamazuva manomwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.38",
            "verseOrgIds": [
              "LEV.14.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 14:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva rechinomwe muprista achadzoka kuzoongorora imba. Kana maperembudzi apararira pamadziro,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.39",
            "verseOrgIds": [
              "LEV.14.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 14:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "anofanira kurayira kuti matombo ane utachiona abviswe agorasirwa kunzvimbo isina kuchena kunze kweguta.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.40",
            "verseOrgIds": [
              "LEV.14.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 14:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ngaarayire kuti madziro ose omukati memba aparwe uye zvaparwa zvigoraswa kunzvimbo isina kuchena kunze kweguta.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.41",
            "verseOrgIds": [
              "LEV.14.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 14:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vanofanira kutora mamwe matombo vagotsiva aya vagotora ivhu idzva vakodzura imba.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.42",
            "verseOrgIds": [
              "LEV.14.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 14:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana chakwindi chikaonekwa zvakare mumba mushure mokunge matombo abviswa imba yaparwa uye yadzurwa,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.43",
            "verseOrgIds": [
              "LEV.14.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 14:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "muprista anofanira kuenda kunozvinanʼanidza. Kana maperembudzi apararira ihosha inoparadza, imba haina kuchena.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.44",
            "verseOrgIds": [
              "LEV.14.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 14:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inofanira kupazwa, matombo ayo, mapuranga nokudzura kwose, zvotorwa zvoendeswa kunze kweguta kunzvimbo isina kuchena.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.45",
            "verseOrgIds": [
              "LEV.14.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 14:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Munhu upi noupi achapinda muimba iyi painenge ichakapfigwa achava asina kuchena kusvika manheru.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.46",
            "verseOrgIds": [
              "LEV.14.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 14:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munhu wose achavata kana kuti achadya ari mumba iyoyo anofanira kusuka nguo dzake.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.47",
            "verseOrgIds": [
              "LEV.14.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LEV 14:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asi kana muprista akauya kuzoiongorora, akaona kuti maperembudzi haana kupararira mumba mushure mokunge yadzurwa, achati imba yakachena nokuti maperembudzi aenda.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.48",
            "verseOrgIds": [
              "LEV.14.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LEV 14:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuti anatse imba, anofanira kutora shiri mbiri nedanda romusidhari, mucheka mutsvuku nehisopi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.49",
            "verseOrgIds": [
              "LEV.14.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LEV 14:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achaurayira imwe shiri pamusoro pemvura yakachena iri muhari yevhu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.50",
            "verseOrgIds": [
              "LEV.14.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LEV 14:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo anofanira kutora puranga romusidhari, hisopi, mucheka mutsvuku, shinda neshiri mhenyu ozvinyika muropa reshiri yafa nemvura yakachena, uye agosasa mumba kanomwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.51",
            "verseOrgIds": [
              "LEV.14.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LEV 14:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achanatsa imba neropa reshiri, mvura yakachena, shiri mhenyu, danda romusidhari, hisopi uye nomucheka mutsvuku.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.52",
            "verseOrgIds": [
              "LEV.14.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LEV 14:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo anofanira kuregedza shiri mhenyu kuti iende hayo kunze kweguta kusango. Nenzira iyi achayananisira imba uye ichava yakachena.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.53",
            "verseOrgIds": [
              "LEV.14.53"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LEV 14:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyi ndiyo mirayiro yechirwere chamaperembudzi, kuvava,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.54",
            "verseOrgIds": [
              "LEV.14.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LEV 14:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "maperembudzi pamucheka kana mumba,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.55",
            "verseOrgIds": [
              "LEV.14.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LEV 14:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye kuzvimba, kufunuka, kana gwapa rakacheneruka,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.56",
            "verseOrgIds": [
              "LEV.14.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "LEV 14:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti mugoziva kuti chinhu chakachena kana kuti hachina kuchena.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.57",
            "verseOrgIds": [
              "LEV.14.57"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LEV 14:57"
      },
      "items": [
        {
          "text": "Iyi ndiyo mirayiro yezvirwere zvinotapuriranwa zvamaperembudzi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.57",
            "verseOrgIds": [
              "LEV.14.57"
            ]
          }
        }
      ]
    }
  ],
