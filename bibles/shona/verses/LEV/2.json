    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chipiriso cheZviyo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kana munhu achiuya kuna Jehovha nechipiriso chezviyo, chipiriso chake chinofanira kuva choupfu hwakatsetseka. Anofanira kudira mafuta pachiri agoisa zvinonhuhwira pamusoro pacho,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.1",
            "verseOrgIds": [
              "LEV.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "agoenda nacho kuvanakomana vaAroni vaprista. Muprista achatora tsama youpfu hwakatsetseka namafuta, pamwe chete nezvinonhuhwira, agozvipisa sechikamu chechirangaridzo paaritari. Chipiriso chakagadzirwa nomoto, chinonhuhwira zvinofadza kuna Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.2",
            "verseOrgIds": [
              "LEV.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvimwe zvose zvinosara pazvipiriso zvezviyo ndezvaAroni navanakomana vake, chikamu chitsvene-tsvene chezvipiriso zvinoitirwa Jehovha nomoto.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.3",
            "verseOrgIds": [
              "LEV.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kana ukauya nechipiriso chezviyo zvakabikwa muchitofu chinofanira kuva choupfu hwakatsetseka: makeke anenge aitwa asina mbiriso uye akasanganiswa namafuta kana kuti makeke matete asina mbiriso akazorwa mafuta.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.4",
            "verseOrgIds": [
              "LEV.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana chipiriso chako chezviyo chagadzirirwa mugango, chinofanira kugadzirwa noupfu hwakatsetseka hwakasanganiswa namafuta pasina mbiriso.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.5",
            "verseOrgIds": [
              "LEV.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unofanira kuchipfupfunyura ugodira mafuta pachiri; ichi chipiriso chezviyo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.6",
            "verseOrgIds": [
              "LEV.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana chipiriso chako chezviyo chakabikwa mugango chinofanira kuva choupfu hwakatsetseka namafuta.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.7",
            "verseOrgIds": [
              "LEV.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uuye nechipiriso chezviyo chakaitwa nezvinhu izvi kuna Jehovha, ugochipa kumuprista achachiendesa kuaritari.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.8",
            "verseOrgIds": [
              "LEV.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muprista achatora kubva muchipiriso chezviyo chikamu chechirangaridzo agochipisa paaritari sechipiriso chinogadzirwa nomoto, chinonhuhwira zvinofadza kuna Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.9",
            "verseOrgIds": [
              "LEV.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvinosara pazvipiriso zvezviyo ndezvaAroni navanakomana vake, chikamu chitsvene-tsvene chezvipiriso zvinoitirwa Jehovha nomoto.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.10",
            "verseOrgIds": [
              "LEV.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Zvipiriso zvose zvezviyo zvamunouya nazvo kuna Jehovha zvinofanira kugadzirwa pasina mbiriso nokuti hamufaniri kupisa chero mbiriso kana uchi muchipiriso chinoitirwa Jehovha nomoto.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.11",
            "verseOrgIds": [
              "LEV.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munokwanisa kuzviuyisa kuna Jehovha sechipiriso chezvirimwa zvamunotanga kukohwa asi hazvifaniri kuuyiswa paaritari somunhuwi unonhuhwira zvinofadza.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.12",
            "verseOrgIds": [
              "LEV.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rungai zvipiriso zvenyu zvose zvezviyo nomunyu. Musasiya munyu wesungano yaMwari wenyu pazvipiriso zvenyu zvose zvezviyo; muise munyu muzvipiriso zvenyu zvose zvezviyo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.13",
            "verseOrgIds": [
              "LEV.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kana uchiuyisa chipiriso chezviyo zvokutanga kuna Jehovha upe hura dzezviyo zvitsva zvakakangwa pamoto uye zvakakuyiwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.14",
            "verseOrgIds": [
              "LEV.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uise mafuta nezvinonhuhwira pazviri, chipiriso chezviyo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.15",
            "verseOrgIds": [
              "LEV.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muprista achapisa chikamu chechirangaridzo chezviyo zvakakuyiwa, namafuta, pamwe chete nezvose zvinonhuhwira, sechipiriso chinoitirwa Jehovha nomoto.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.16",
            "verseOrgIds": [
              "LEV.2.16"
            ]
          }
        }
      ]
    }
  ],
