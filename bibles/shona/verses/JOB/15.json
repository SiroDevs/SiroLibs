  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "JOB 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Erifazi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Erifazi muTemani akapindura akati:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.1",
            "verseOrgIds": [
              "JOB.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ko, munhu akachenjera angapindura zvisina njere here,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.2",
            "verseOrgIds": [
              "JOB.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:2"
      },
      "items": [
        {
          "text": "kana kuzadza dumbu rake nemhepo inopisa yokumabvazuva?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.2",
            "verseOrgIds": [
              "JOB.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, angakakavara namashoko asina maturo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.3",
            "verseOrgIds": [
              "JOB.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:3"
      },
      "items": [
        {
          "text": "kana namashoko asina basa here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.3",
            "verseOrgIds": [
              "JOB.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi unotorwisa umwari",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.4",
            "verseOrgIds": [
              "JOB.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:4"
      },
      "items": [
        {
          "text": "uye unodzivisa kunamata Mwari.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.4",
            "verseOrgIds": [
              "JOB.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chivi chako chinorunzira muromo wako;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.5",
            "verseOrgIds": [
              "JOB.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:5"
      },
      "items": [
        {
          "text": "uye unotevera rurimi rwavanyengeri.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.5",
            "verseOrgIds": [
              "JOB.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muromo wako pachako ndiwo unokupa mhosva, kwete wangu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.6",
            "verseOrgIds": [
              "JOB.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:6"
      },
      "items": [
        {
          "text": "miromo yako pachako inokupupurira zvakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.6",
            "verseOrgIds": [
              "JOB.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ko, ndiwe munhu wakatanga kuzvarwa here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.7",
            "verseOrgIds": [
              "JOB.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:7"
      },
      "items": [
        {
          "text": "Ko, iwe wakazvarwa makomo asati avapo here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.7",
            "verseOrgIds": [
              "JOB.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unoteererawo here panokurukurwa mazano aMwari?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.8",
            "verseOrgIds": [
              "JOB.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:8"
      },
      "items": [
        {
          "text": "Unoti uchenjeri ndohwako woga kanhi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.8",
            "verseOrgIds": [
              "JOB.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiiko chaunoziva chatisingazivi isu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.9",
            "verseOrgIds": [
              "JOB.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:9"
      },
      "items": [
        {
          "text": "Kunzwisisa kwaunako ndokweiko kwatisinawo isu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.9",
            "verseOrgIds": [
              "JOB.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vane bvudzi rakachena navatana vakwegura vari kudivi redu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.10",
            "verseOrgIds": [
              "JOB.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:10"
      },
      "items": [
        {
          "text": "varume vatochembera kupinda baba vako.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.10",
            "verseOrgIds": [
              "JOB.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, kunyaradza kwaMwari hakuna kukukwanira here,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.11",
            "verseOrgIds": [
              "JOB.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:11"
      },
      "items": [
        {
          "text": "iro shoko rakataurwa kwauri zvine unyoro?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.11",
            "verseOrgIds": [
              "JOB.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, mwoyo wako wakurasireiko,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.12",
            "verseOrgIds": [
              "JOB.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:12"
      },
      "items": [
        {
          "text": "uye meso ako anobwairireiko,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.12",
            "verseOrgIds": [
              "JOB.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "zvokuti unoitira Mwari hasha",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.13",
            "verseOrgIds": [
              "JOB.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:13"
      },
      "items": [
        {
          "text": "ugobudisa mashoko akadai kubva mumuromo mako?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.13",
            "verseOrgIds": [
              "JOB.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Munhu chiiko, zvokuti angava akanaka,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.14",
            "verseOrgIds": [
              "JOB.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:14"
      },
      "items": [
        {
          "text": "kana munhu akazvarwa nomukadzi, kuti angava akarurama?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.14",
            "verseOrgIds": [
              "JOB.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana Mwari akasavimba navatsvene vake,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.15",
            "verseOrgIds": [
              "JOB.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:15"
      },
      "items": [
        {
          "text": "kunyange dai matenga akasava akachena pamberi pake,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.15",
            "verseOrgIds": [
              "JOB.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ko, kuzoti munhu, ane uori",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.16",
            "verseOrgIds": [
              "JOB.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:16"
      },
      "items": [
        {
          "text": "uye akaora, anonwa zvakaipa semvura!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.16",
            "verseOrgIds": [
              "JOB.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nditeerere ndigokutsanangurira;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.17",
            "verseOrgIds": [
              "JOB.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:17"
      },
      "items": [
        {
          "text": "rega ndikuudze zvandakaona,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.17",
            "verseOrgIds": [
              "JOB.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "zvakataurwa navanhu vakachenjera,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.18",
            "verseOrgIds": [
              "JOB.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:18"
      },
      "items": [
        {
          "text": "vasingavanzi chinhu chavakagamuchira kubva kumadzibaba avo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.18",
            "verseOrgIds": [
              "JOB.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ivo voga vakapiwa nyika",
          "type": "text",
          "attrs": {
            "verseId": "JOB.15.19",
            "verseOrgIds": [
              "JOB.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 15:19"
      },
      "items": [
        {
          "text": "pasina mutorwa akapfuura napakati pavo:",
          "type": "text",
          "attrs": {
