  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "41",
        "style": "c",
        "sid": "JOB 41"
      },
      "items": [
        {
          "text": "41",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ungagona kukweva ngwena nechiredzo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.1",
            "verseOrgIds": [
              "JOB.40.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:1"
      },
      "items": [
        {
          "text": "kana kusunga rurimi rwayo netambo here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.1",
            "verseOrgIds": [
              "JOB.40.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungagona kupinza mukaro mumhino dzayo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.2",
            "verseOrgIds": [
              "JOB.40.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:2"
      },
      "items": [
        {
          "text": "kana kuboora rushaya rwayo nechiredzo here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.2",
            "verseOrgIds": [
              "JOB.40.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, ingaramba ichikumbira kunzwirwa ngoni newe here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.3",
            "verseOrgIds": [
              "JOB.40.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:3"
      },
      "items": [
        {
          "text": "Ko, ingataura kwauri mashoko manyoro here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.3",
            "verseOrgIds": [
              "JOB.40.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, ingaita chitenderano newe here",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.4",
            "verseOrgIds": [
              "JOB.40.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:4"
      },
      "items": [
        {
          "text": "kuti iwe uitore senhapwa kwoupenyu hwayo hwose?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.4",
            "verseOrgIds": [
              "JOB.40.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungagona kuipfuwa seshiri here",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.5",
            "verseOrgIds": [
              "JOB.40.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:5"
      },
      "items": [
        {
          "text": "kana kuisunga kuti vanasikana vako vatambe nayo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.5",
            "verseOrgIds": [
              "JOB.40.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, vatengesi vangaitsinhanisa here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.6",
            "verseOrgIds": [
              "JOB.40.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:6"
      },
      "items": [
        {
          "text": "Ko, vangaigoverana pakati pavashambadziri here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.6",
            "verseOrgIds": [
              "JOB.40.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungagona kuzadza dehwe rayo nemiseve ine nzeve here,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.7",
            "verseOrgIds": [
              "JOB.40.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:7"
      },
      "items": [
        {
          "text": "kana kuzadza musoro wayo namapfumo okuredzesa hove?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.7",
            "verseOrgIds": [
              "JOB.40.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana ukaisa ruoko rwako pairi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.8",
            "verseOrgIds": [
              "JOB.40.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:8"
      },
      "items": [
        {
          "text": "uchazorangarira kurwisana kwako nayo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.8",
            "verseOrgIds": [
              "JOB.40.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:8"
      },
      "items": [
        {
          "text": "uye haungazozvipamhizve!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.8",
            "verseOrgIds": [
              "JOB.40.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tariro ipi zvayo yokuitonga ndeyenhema;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.9",
            "verseOrgIds": [
              "JOB.41.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:9"
      },
      "items": [
        {
          "text": "kungoiona bedzi kunopedza simba.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.9",
            "verseOrgIds": [
              "JOB.41.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuna munhu anotyisa zvokuti angaidenha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.10",
            "verseOrgIds": [
              "JOB.41.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:10"
      },
      "items": [
        {
          "text": "Ndianiko zvino anogona kumisidzana neni?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.10",
            "verseOrgIds": [
              "JOB.41.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndianiko wandakatorera chinhu wandinofanira kuripira?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.11",
            "verseOrgIds": [
              "JOB.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:11"
      },
      "items": [
        {
          "text": "Zvinhu zvose zviri pasi pedenga ndezvangu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.11",
            "verseOrgIds": [
              "JOB.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Handingakonewi kutaura zvemitezo yayo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.12",
            "verseOrgIds": [
              "JOB.41.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:12"
      },
      "items": [
        {
          "text": "simba rayo uye chimiro chayo chakanaka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.12",
            "verseOrgIds": [
              "JOB.41.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndianiko angabvisa dehwe rayo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.13",
            "verseOrgIds": [
              "JOB.41.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:13"
      },
      "items": [
        {
          "text": "Ndianiko angasvika kwairi namatomu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.13",
            "verseOrgIds": [
              "JOB.41.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndianiko anotsunga kuzarura mikova yomuromo wayo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.14",
            "verseOrgIds": [
              "JOB.41.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:14"
      },
      "items": [
        {
          "text": "iwo wakakomberedzwa nameno ayo anotyisa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.14",
            "verseOrgIds": [
              "JOB.41.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musana wayo une mitsara yamakwande",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.15",
            "verseOrgIds": [
              "JOB.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:15"
      },
      "items": [
        {
          "text": "yakanyatsonamirwa pamwe chete;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.15",
            "verseOrgIds": [
              "JOB.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "rimwe nerimwe riri pedyo pedyo nerimwe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.16",
            "verseOrgIds": [
              "JOB.41.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:16"
      },
      "items": [
        {
          "text": "zvokuti hakuna mhepo inopinda napakati.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.16",
            "verseOrgIds": [
              "JOB.41.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanyatsobatanidzwa pane rimwe nerimwe;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.17",
            "verseOrgIds": [
              "JOB.41.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:17"
      },
      "items": [
        {
          "text": "akanamatirana pamwe chete uye haagoni kuparadzaniswa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.17",
            "verseOrgIds": [
              "JOB.41.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 41:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuhotsira kwayo kunoita mamvari omoto;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.18",
            "verseOrgIds": [
              "JOB.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:18"
      },
      "items": [
        {
          "text": "meso ayo akaita sehwerazuva hwamambakwedza.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.18",
            "verseOrgIds": [
              "JOB.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 41:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazhenje omoto anoyerera achibva mumuromo mayo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.19",
            "verseOrgIds": [
              "JOB.41.11"
