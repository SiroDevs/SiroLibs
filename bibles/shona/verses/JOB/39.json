  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "39",
        "style": "c",
        "sid": "JOB 39"
      },
      "items": [
        {
          "text": "39",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 39:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iwe unoziva nguva inobereka ngururu here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.1",
            "verseOrgIds": [
              "JOB.39.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:1"
      },
      "items": [
        {
          "text": "Unocherechedza kana nondo dzichibereka vana vadzo here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.1",
            "verseOrgIds": [
              "JOB.39.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unoverenga mwedzi kusvikira dzabereka here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.2",
            "verseOrgIds": [
              "JOB.39.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:2"
      },
      "items": [
        {
          "text": "Unoziva nguva yadzinobereka here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.2",
            "verseOrgIds": [
              "JOB.39.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzinotsivama pasi dzigobereka vana vadzo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.3",
            "verseOrgIds": [
              "JOB.39.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:3"
      },
      "items": [
        {
          "text": "kurwadziwa kwadzo kwapera.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.3",
            "verseOrgIds": [
              "JOB.39.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vana vadzo vanowanda vagokura vakasimba musango;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.4",
            "verseOrgIds": [
              "JOB.39.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:4"
      },
      "items": [
        {
          "text": "vanoenda uye havadzokizve.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.4",
            "verseOrgIds": [
              "JOB.39.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndianiko akaregedza mbizi ichienda?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.5",
            "verseOrgIds": [
              "JOB.39.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:5"
      },
      "items": [
        {
          "text": "Ndianiko akasunungura tambo dzayo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.5",
            "verseOrgIds": [
              "JOB.39.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakaipa renje kuti uve musha wayo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.6",
            "verseOrgIds": [
              "JOB.39.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:6"
      },
      "items": [
        {
          "text": "nyika yomunyu sougaro hwayo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.6",
            "verseOrgIds": [
              "JOB.39.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inoseka bope riri muguta;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.7",
            "verseOrgIds": [
              "JOB.39.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:7"
      },
      "items": [
        {
          "text": "hainzwi kudaidzira kwomuchairi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.7",
            "verseOrgIds": [
              "JOB.39.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inoita zvikomo mafuro ayo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.8",
            "verseOrgIds": [
              "JOB.39.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:8"
      },
      "items": [
        {
          "text": "uye inotsvaka zvinhu zvose zvinenge zvakapfumvudza.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.8",
            "verseOrgIds": [
              "JOB.39.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 39:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ko, nyati ingabvuma kukushandira here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.9",
            "verseOrgIds": [
              "JOB.39.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:9"
      },
      "items": [
        {
          "text": "Ko, ingagara mudanga rako usiku here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.9",
            "verseOrgIds": [
              "JOB.39.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, ungagona kuifambisa mumiforo namahanisi here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.10",
            "verseOrgIds": [
              "JOB.39.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:10"
      },
      "items": [
        {
          "text": "Ko, ingarima mipata mushure mako here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.10",
            "verseOrgIds": [
              "JOB.39.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 39:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungavimba nesimba rayo guru here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.11",
            "verseOrgIds": [
              "JOB.39.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:11"
      },
      "items": [
        {
          "text": "Ko, ungaisiyira basa rako rinorema here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.11",
            "verseOrgIds": [
              "JOB.39.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 39:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungavimba nayo kuti ikutakurire zviyo zvako",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.12",
            "verseOrgIds": [
              "JOB.39.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:12"
      },
      "items": [
        {
          "text": "uye igozviunza paburiro rako here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.12",
            "verseOrgIds": [
              "JOB.39.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 39:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mapapiro emhou anopapama nomufaro mukuru,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.13",
            "verseOrgIds": [
              "JOB.39.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:13"
      },
      "items": [
        {
          "text": "asi haangaenzaniswi namapapiro uye neminhenga yedambiramurove.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.13",
            "verseOrgIds": [
              "JOB.39.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 39:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvirokwazvo inokandira mazai ayo muvhu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.14",
            "verseOrgIds": [
              "JOB.39.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:14"
      },
      "items": [
        {
          "text": "igoarega achidziyirwa mujecha,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.14",
            "verseOrgIds": [
              "JOB.39.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 39:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "isina hanya kuti rutsoka rungaapwanya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.15",
            "verseOrgIds": [
              "JOB.39.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:15"
      },
      "items": [
        {
          "text": "kana kuti mhuka dzesango dzingaatsika.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.15",
            "verseOrgIds": [
              "JOB.39.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 39:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inobata vana vayo noukasha, kunge vasati vari vayo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.16",
            "verseOrgIds": [
              "JOB.39.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:16"
      },
      "items": [
        {
          "text": "haina hanya kuti yakatambudzika pasina,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.16",
            "verseOrgIds": [
              "JOB.39.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 39:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti Mwari haana kuisa njere mairi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.17",
            "verseOrgIds": [
              "JOB.39.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:17"
      },
      "items": [
        {
          "text": "kana kuipa mugove wepfungwa dzakanaka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.17",
            "verseOrgIds": [
              "JOB.39.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 39:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana ikatambanudza mapapiro ayo kuti imhanye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.18",
            "verseOrgIds": [
              "JOB.39.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:18"
      },
      "items": [
        {
          "text": "inoseka bhiza nomutasvi waro.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.18",
            "verseOrgIds": [
              "JOB.39.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 39:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iwe unopa bhiza simba raro",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.19",
            "verseOrgIds": [
              "JOB.39.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
