  "verseCount": 41,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "38",
        "style": "c",
        "sid": "JOB 38"
      },
      "items": [
        {
          "text": "38",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Jehovha anotaura",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 38:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akapindura Jobho ari mudutu akati:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.1",
            "verseOrgIds": [
              "JOB.38.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 38:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndianiko uyu anodzimaidza zano rangu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.2",
            "verseOrgIds": [
              "JOB.38.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:2"
      },
      "items": [
        {
          "text": "namashoko asina zivo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.2",
            "verseOrgIds": [
              "JOB.38.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chizvishingisa somurume;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.3",
            "verseOrgIds": [
              "JOB.38.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:3"
      },
      "items": [
        {
          "text": "ini ndichakubvunza,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.3",
            "verseOrgIds": [
              "JOB.38.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:3"
      },
      "items": [
        {
          "text": "uye iwe uchandipindura.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.3",
            "verseOrgIds": [
              "JOB.38.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iwe wakanga uripi pandakaisa nheyo dzenyika?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.4",
            "verseOrgIds": [
              "JOB.38.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:4"
      },
      "items": [
        {
          "text": "Ndiudze, kana uchinzwisisa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.4",
            "verseOrgIds": [
              "JOB.38.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndianiko akatara miganhu yacho?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.5",
            "verseOrgIds": [
              "JOB.38.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:5"
      },
      "items": [
        {
          "text": "Zvirokwazvo unozviziva!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.5",
            "verseOrgIds": [
              "JOB.38.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:5"
      },
      "items": [
        {
          "text": "Ndianiko akaiyera nerwodzi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.5",
            "verseOrgIds": [
              "JOB.38.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, nheyo dzayo dzakanga dzimire pai,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.6",
            "verseOrgIds": [
              "JOB.38.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:6"
      },
      "items": [
        {
          "text": "kana kuti ndianiko akaisa ibwe rapakona,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.6",
            "verseOrgIds": [
              "JOB.38.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "panguva yaiimba nyeredzi dzamangwanani pamwe chete,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.7",
            "verseOrgIds": [
              "JOB.38.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:7"
      },
      "items": [
        {
          "text": "uye vanakomana vaMwari vose vachipembera nomufaro?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.7",
            "verseOrgIds": [
              "JOB.38.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndianiko akapfigira gungwa mikova",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.8",
            "verseOrgIds": [
              "JOB.38.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:8"
      },
      "items": [
        {
          "text": "parakatsemuka richibva muchizvaro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.8",
            "verseOrgIds": [
              "JOB.38.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "pandakaita makore kuti ave nguo yaro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.9",
            "verseOrgIds": [
              "JOB.38.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:9"
      },
      "items": [
        {
          "text": "uye ndikariputira murima guru,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.9",
            "verseOrgIds": [
              "JOB.38.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "pandakariisira miganhu yaro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.10",
            "verseOrgIds": [
              "JOB.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:10"
      },
      "items": [
        {
          "text": "uye ndikaisa makonhi aro namazariro panzvimbo yawo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.10",
            "verseOrgIds": [
              "JOB.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "pandakati, 'Apa ndipo paunosvika uye haungapfuuri;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.11",
            "verseOrgIds": [
              "JOB.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:11"
      },
      "items": [
        {
          "text": "pano ndipo panoguma kuzvikudza kwamafungu ako'?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.11",
            "verseOrgIds": [
              "JOB.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 38:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wakambopa mutemo kumangwanani here,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.12",
            "verseOrgIds": [
              "JOB.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:12"
      },
      "items": [
        {
          "text": "kana kuratidza mambakwedza nzvimbo yawo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.12",
            "verseOrgIds": [
              "JOB.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti abate mipendero yenyika,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.13",
            "verseOrgIds": [
              "JOB.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:13"
      },
      "items": [
        {
          "text": "uye azungunuse vakaipa kuti vabve mairi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.13",
            "verseOrgIds": [
              "JOB.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 38:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyika inoumbika sevhu pasi pechisimbiso;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.14",
            "verseOrgIds": [
              "JOB.38.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:14"
      },
      "items": [
        {
          "text": "mamiriro ayo anoita senguo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.14",
            "verseOrgIds": [
              "JOB.38.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 38:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaipa vanonyimwa chiedza chavo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.15",
            "verseOrgIds": [
              "JOB.38.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:15"
      },
      "items": [
        {
          "text": "uye ruoko rwavo rwakasimudzwa rwavhunika.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.15",
            "verseOrgIds": [
              "JOB.38.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 38:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wakamboshanyira zvitubu zvegungwa here,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.16",
            "verseOrgIds": [
              "JOB.38.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:16"
      },
      "items": [
        {
          "text": "kana kufamba kwakanyarara kwokwakadzika?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.16",
            "verseOrgIds": [
              "JOB.38.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 38:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, masuo orufu wakamboaratidzwa here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.17",
            "verseOrgIds": [
              "JOB.38.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:17"
      },
      "items": [
        {
          "text": "Wakamboona masuo omumvuri worufu here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.17",
            "verseOrgIds": [
              "JOB.38.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 38:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wati wanzwisisa upamhi hwenzvimbo dzenyika here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.18",
            "verseOrgIds": [
              "JOB.38.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:18"
      },
      "items": [
        {
          "text": "Ndiudze kana uchiziva zvose izvi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.18",
            "verseOrgIds": [
              "JOB.38.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
