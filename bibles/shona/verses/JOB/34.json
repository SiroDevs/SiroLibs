      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Meso ake ari panzira dzavanhu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.21",
            "verseOrgIds": [
              "JOB.34.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:21"
      },
      "items": [
        {
          "text": "anoona nhambwe imwe neimwe yavo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.21",
            "verseOrgIds": [
              "JOB.34.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuna nzvimbo ine rima,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.22",
            "verseOrgIds": [
              "JOB.34.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:22"
      },
      "items": [
        {
          "text": "hakuna mumvuri wakadzama,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.22",
            "verseOrgIds": [
              "JOB.34.22"
            ]
          }
        }
      ]
    },
    {
