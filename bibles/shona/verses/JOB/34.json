  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "34",
        "style": "c",
        "sid": "JOB 34"
      },
      "items": [
        {
          "text": "34",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Erihu akati:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.1",
            "verseOrgIds": [
              "JOB.34.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Inzwai mashoko angu, imi vanhu vakachenjera;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.2",
            "verseOrgIds": [
              "JOB.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:2"
      },
      "items": [
        {
          "text": "nditeererei, imi vanhu vedzidzo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.2",
            "verseOrgIds": [
              "JOB.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti nzeve inoedza mazwi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.3",
            "verseOrgIds": [
              "JOB.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:3"
      },
      "items": [
        {
          "text": "sokuravira kunoita rurimi chokudya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.3",
            "verseOrgIds": [
              "JOB.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngatinzverei pachedu kuti chakarurama ndechipi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.4",
            "verseOrgIds": [
              "JOB.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:4"
      },
      "items": [
        {
          "text": "ngatidzidzei pamwe chete kuti chakanaka ndechipi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.4",
            "verseOrgIds": [
              "JOB.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Jobho anoti, 'Handina mhosva,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.5",
            "verseOrgIds": [
              "JOB.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:5"
      },
      "items": [
        {
          "text": "asi Mwari anoramba kundiruramisira.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.5",
            "verseOrgIds": [
              "JOB.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange ndakarurama,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.6",
            "verseOrgIds": [
              "JOB.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:6"
      },
      "items": [
        {
          "text": "ndinonzi ndiri murevi wenhema;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.6",
            "verseOrgIds": [
              "JOB.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:6"
      },
      "items": [
        {
          "text": "kunyange ndisina mhaka,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.6",
            "verseOrgIds": [
              "JOB.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:6"
      },
      "items": [
        {
          "text": "museve wake unobaya ronda risingarapiki.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.6",
            "verseOrgIds": [
              "JOB.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndianiko munhu akaita saJobho,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.7",
            "verseOrgIds": [
              "JOB.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:7"
      },
      "items": [
        {
          "text": "anonwa kushorwa semvura?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.7",
            "verseOrgIds": [
              "JOB.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anofambidzana navanoita zvakaipa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.8",
            "verseOrgIds": [
              "JOB.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:8"
      },
      "items": [
        {
          "text": "anowirirana navanhu vakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.8",
            "verseOrgIds": [
              "JOB.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti anoti, 'Munhu haana chaanobatsirwa nacho,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.9",
            "verseOrgIds": [
              "JOB.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:9"
      },
      "items": [
        {
          "text": "paanoedza kufadza Mwari.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.9",
            "verseOrgIds": [
              "JOB.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Saka nditeererei, imi vanhu vokunzwisisa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.10",
            "verseOrgIds": [
              "JOB.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:10"
      },
      "items": [
        {
          "text": "Mwari haangatongoiti zvakaipa, Wamasimba Ose haangatongokanganisi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.10",
            "verseOrgIds": [
              "JOB.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anoripira munhu pane zvaanenge aita;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.11",
            "verseOrgIds": [
              "JOB.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:11"
      },
      "items": [
        {
          "text": "anoisa pamusoro pake zvakakodzera mafambiro ake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.11",
            "verseOrgIds": [
              "JOB.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazvingatongogoni kuti Mwari angaita zvakaipa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.12",
            "verseOrgIds": [
              "JOB.34.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:12"
      },
      "items": [
        {
          "text": "kuti Wamasimba Ose angaminamisa kururamisira.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.12",
            "verseOrgIds": [
              "JOB.34.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndianiko akamugadza pamusoro penyika?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.13",
            "verseOrgIds": [
              "JOB.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:13"
      },
      "items": [
        {
          "text": "Ndianiko akamuita mutariri wepasi pose?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.13",
            "verseOrgIds": [
              "JOB.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana kwaiva kufunga kwake,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.14",
            "verseOrgIds": [
              "JOB.34.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:14"
      },
      "items": [
        {
          "text": "uye akatora mweya wake nokufema kwake,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.14",
            "verseOrgIds": [
              "JOB.34.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "marudzi ose avanhu aiparara pamwe chete,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.15",
            "verseOrgIds": [
              "JOB.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:15"
      },
      "items": [
        {
          "text": "uye munhu aizodzokerazve kuguruva.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.15",
            "verseOrgIds": [
              "JOB.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana uchinzwisisa teerera izvi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.16",
            "verseOrgIds": [
              "JOB.34.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:16"
      },
      "items": [
        {
          "text": "chinzwa zvandinoreva.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.16",
            "verseOrgIds": [
              "JOB.34.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, munhu anovenga kururamisira angatonga here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.17",
            "verseOrgIds": [
              "JOB.34.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:17"
      },
      "items": [
        {
          "text": "Ko, muchapomera akarurama uye ane simba here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.17",
            "verseOrgIds": [
              "JOB.34.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, haazi iye anoti kumadzimambo, 'Hamubatsiri imi,'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.18",
            "verseOrgIds": [
              "JOB.34.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:18"
      },
      "items": [
        {
          "text": "uye kumakurukota, 'Makaipa imi,'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.18",
            "verseOrgIds": [
              "JOB.34.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "asingaitiri machinda zvakanaka nokuti machinda,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.19",
            "verseOrgIds": [
              "JOB.34.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:19"
      },
      "items": [
        {
          "text": "uye asingaitiri zvakanaka vapfumi kupfuura varombo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.19",
            "verseOrgIds": [
              "JOB.34.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:19"
      },
      "items": [
        {
          "text": "nokuti vose ibasa ramaoko ake?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.19",
            "verseOrgIds": [
              "JOB.34.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanofa kamwe kamwe, pakati pousiku;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.20",
            "verseOrgIds": [
              "JOB.34.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:20"
      },
      "items": [
        {
          "text": "vanhu vanovhundutswa vagoparara;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.20",
            "verseOrgIds": [
              "JOB.34.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:20"
      },
      "items": [
        {
          "text": "vane simba vanobviswa zvisingaitwi noruoko rwomunhu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.20",
            "verseOrgIds": [
              "JOB.34.20"
            ]
          }
        }
      ]
    },
    {
