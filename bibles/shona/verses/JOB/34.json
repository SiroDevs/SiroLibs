      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:22"
      },
      "items": [
        {
          "text": "pangavanda vaiti vezvakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.22",
            "verseOrgIds": [
              "JOB.34.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari haanei nezvokuedzazve vanhu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.23",
            "verseOrgIds": [
              "JOB.34.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:23"
      },
      "items": [
        {
          "text": "kuti vauye vamire pamberi pake vagotongwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.23",
            "verseOrgIds": [
              "JOB.34.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anoparadza vane simba asina kumbobvunza,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.24",
            "verseOrgIds": [
              "JOB.34.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:24"
      },
      "items": [
        {
          "text": "agogadza vamwe panzvimbo yavo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.24",
            "verseOrgIds": [
              "JOB.34.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti anocherechedza mabasa avo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.25",
            "verseOrgIds": [
              "JOB.34.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:25"
      },
      "items": [
        {
          "text": "anovabvisa usiku uye vanopwanyiwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.25",
            "verseOrgIds": [
              "JOB.34.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anovaranga nokuda kwokuipa kwavo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.26",
            "verseOrgIds": [
              "JOB.34.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:26"
      },
      "items": [
        {
          "text": "pavanoonekwa nomunhu wose,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.26",
            "verseOrgIds": [
              "JOB.34.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti vakatsauka pakumutevera",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.27",
            "verseOrgIds": [
              "JOB.34.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:27"
      },
      "items": [
        {
          "text": "uye havana kuva nehanya kana neimwe yenzira dzake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.27",
            "verseOrgIds": [
              "JOB.34.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakakonzera kuchema kwavarombo kuti kusvike pamberi pake,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.28",
            "verseOrgIds": [
              "JOB.34.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:28"
      },
      "items": [
        {
          "text": "zvokuti akanzwa kuchema kwavanoshayiwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.28",
            "verseOrgIds": [
              "JOB.34.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana akaramba anyerere ndiani angamupa mhosva?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.29",
            "verseOrgIds": [
              "JOB.34.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:29"
      },
      "items": [
        {
          "text": "Kana akavanza chiso chake, ndianiko angamuona?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.29",
            "verseOrgIds": [
              "JOB.34.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:29"
      },
      "items": [
        {
          "text": "Zvakadaro iye ari pamusoro pazvose, munhu nendudzi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.29",
            "verseOrgIds": [
              "JOB.34.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOB 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti abvise munhu asina umwari pakutonga,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.30",
            "verseOrgIds": [
              "JOB.34.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:30"
      },
      "items": [
        {
          "text": "kuti asaisira vanhu misungo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.30",
            "verseOrgIds": [
              "JOB.34.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOB 34:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ngatiti munhu oti kuna Mwari,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.31",
            "verseOrgIds": [
              "JOB.34.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:31"
      },
      "items": [
        {
          "text": "'Ndine mhaka asi handichatadzazve.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.31",
            "verseOrgIds": [
              "JOB.34.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOB 34:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzidzisei zvandisingagoni kuona;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.32",
            "verseOrgIds": [
              "JOB.34.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:32"
      },
      "items": [
        {
          "text": "kana ndakaita zvakaipa, handichazviitizve.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.32",
            "verseOrgIds": [
              "JOB.34.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOB 34:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, Mwari angafanira kukupa mubayiro sezvaunoda iwe here,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.33",
            "verseOrgIds": [
              "JOB.34.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:33"
      },
      "items": [
        {
          "text": "zvaunoramba kutendeuka?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.33",
            "verseOrgIds": [
              "JOB.34.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 34:33"
      },
      "items": [
        {
          "text": "Unofanira kusarudza iwe, kwete ini;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.33",
            "verseOrgIds": [
              "JOB.34.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:33"
      },
      "items": [
        {
          "text": "saka nditaurire zvaunoziva.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.33",
            "verseOrgIds": [
              "JOB.34.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOB 34:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Imi vanhu vokunzwisisa taurai,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.34",
            "verseOrgIds": [
              "JOB.34.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:34"
      },
      "items": [
        {
          "text": "vanhu vakachenjera munondinzwa muti kwandiri,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.34",
            "verseOrgIds": [
              "JOB.34.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOB 34:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Jobho anotaura asina zivo; mashoko ake haana uchenjeri.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.35",
            "verseOrgIds": [
              "JOB.34.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JOB 34:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa, dai Jobho aedzwa kusvikira pakupedzisira,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.36",
            "verseOrgIds": [
              "JOB.34.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:36"
      },
      "items": [
