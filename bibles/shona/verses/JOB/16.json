        "sid": "JOB 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Jobho",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jobho akapindura akati:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.1",
            "verseOrgIds": [
              "JOB.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndakanzwa zvinhu zvakawanda sezvizvi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.2",
            "verseOrgIds": [
              "JOB.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:2"
      },
      "items": [
        {
          "text": "mose muri vanyaradzi pasina!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.2",
            "verseOrgIds": [
              "JOB.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, kutaura kwenyu kwamadzokorora kwenguva refu hakuperiwo here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.3",
            "verseOrgIds": [
              "JOB.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:3"
      },
      "items": [
        {
          "text": "Chii chinokurwadzai kuti murambe muchiita nharo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.3",
            "verseOrgIds": [
              "JOB.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neniwo ndaigona kutaura semi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.4",
            "verseOrgIds": [
              "JOB.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:4"
      },
      "items": [
        {
          "text": "dai imi manga muri pachinzvimbo changu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.4",
            "verseOrgIds": [
              "JOB.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 16:4"
      },
      "items": [
        {
          "text": "ndaigona kutaura mashoko okukupikisai",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.4",
            "verseOrgIds": [
              "JOB.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:4"
      },
      "items": [
        {
          "text": "uye ndigokudzungudzirai musoro wangu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.4",
            "verseOrgIds": [
              "JOB.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi muromo wangu waizokukurudzirai:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.5",
            "verseOrgIds": [
              "JOB.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:5"
      },
      "items": [
        {
          "text": "kunyaradza kunobva pamuromo wangu kwaizokuvigirai zororo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.5",
            "verseOrgIds": [
              "JOB.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asi kana ndikataura, kurwadziwa kwangu hakuperi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.6",
            "verseOrgIds": [
              "JOB.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:6"
      },
      "items": [
        {
          "text": "uye kana ndikanyarara, iko hakubvi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.6",
            "verseOrgIds": [
              "JOB.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvirokwazvo, imi Mwari, mandipedza simba;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.7",
            "verseOrgIds": [
              "JOB.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:7"
      },
      "items": [
        {
          "text": "maparadza imba yangu yose.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.7",
            "verseOrgIds": [
              "JOB.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makandisunga ini, uye chava chapupu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.8",
            "verseOrgIds": [
              "JOB.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:8"
      },
      "items": [
        {
          "text": "kuondoroka kunondiwira uye kunopupurira zvinondirwisa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.8",
            "verseOrgIds": [
              "JOB.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari anondirova uye anondibvambura mukutsamwa kwake,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.9",
            "verseOrgIds": [
              "JOB.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:9"
      },
      "items": [
        {
          "text": "uye anondirumanyira meno ake;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.9",
            "verseOrgIds": [
              "JOB.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:9"
      },
      "items": [
        {
          "text": "mudzivisi wangu anondidzvokorera meso ake anobaya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.9",
            "verseOrgIds": [
              "JOB.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vanoshamisa miromo yavo kuti vandiseke;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.10",
            "verseOrgIds": [
              "JOB.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:10"
      },
      "items": [
        {
          "text": "vanondirova padama pakundimhura kwavo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.10",
            "verseOrgIds": [
              "JOB.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:10"
      },
      "items": [
        {
          "text": "uye vanobatana pamwe chete kuzondirwisa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.10",
            "verseOrgIds": [
              "JOB.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari akandidzorera mumaoko avanhu vakaipa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.11",
            "verseOrgIds": [
              "JOB.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:11"
      },
      "items": [
        {
          "text": "uye akandikanda mumaoko avakashata.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.11",
            "verseOrgIds": [
              "JOB.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvose zvakanga zvakanaka hazvo kwandiri, asi iye akandivhuna;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.12",
            "verseOrgIds": [
              "JOB.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:12"
      },
      "items": [
        {
          "text": "akandibata napahuro akandipwanya-pwanya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.12",
            "verseOrgIds": [
              "JOB.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:12"
      },
      "items": [
        {
          "text": "Akandivavarira;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.12",
            "verseOrgIds": [
              "JOB.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "vapfuri vake vemiseve vakandikomba.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.13",
            "verseOrgIds": [
              "JOB.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:13"
      },
      "items": [
        {
          "text": "Anobaya itsvo dzangu asina tsitsi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.13",
            "verseOrgIds": [
              "JOB.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:13"
      },
      "items": [
        {
          "text": "uye anodururira nduru yangu pasi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.13",
            "verseOrgIds": [
              "JOB.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguva nenguva anondirwisa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.14",
            "verseOrgIds": [
              "JOB.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:14"
      },
      "items": [
        {
          "text": "anondidzingirira somurwi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.14",
            "verseOrgIds": [
              "JOB.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndakasona nguo dzamasaga kuti ndifukidze ganda rangu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.15",
            "verseOrgIds": [
              "JOB.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:15"
      },
      "items": [
        {
          "text": "uye ndaviga huma yangu muguruva.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.15",
            "verseOrgIds": [
              "JOB.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiso changu chatsvuka nokuchema,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.16",
            "verseOrgIds": [
              "JOB.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:16"
      },
      "items": [
        {
          "text": "rima guru rakomberedza meso angu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.16",
            "verseOrgIds": [
              "JOB.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi zvazvo maoko angu haana kuita chisimba,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.17",
            "verseOrgIds": [
              "JOB.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
