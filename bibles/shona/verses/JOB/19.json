      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:21"
      },
      "items": [
        {
          "text": "ndinzwirei urombo nokuti ruoko rwaMwari rwandirova.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.21",
            "verseOrgIds": [
              "JOB.19.21"
            ]
