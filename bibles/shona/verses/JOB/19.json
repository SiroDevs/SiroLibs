      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:22"
      },
      "items": [
        {
          "text": "Ko, hamungaguti nenyama yangu here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.22",
            "verseOrgIds": [
              "JOB.19.22"
            ]
          }
        }
