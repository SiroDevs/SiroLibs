          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seiko muchindidzingirira sezvinoita Mwari?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.22",
            "verseOrgIds": [
              "JOB.19.22"
            ]
          }
