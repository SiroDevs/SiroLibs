{
  "id": "RUT.4",
  "number": "4",
  "bookId": "RUT",
  "reference": "Rute 4",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "RUT 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bhoazi anowana Rute",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "RUT 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvichakadaro, Bhoazi akakwira akaenda pasuo reguta akandogarapo. Hama yapedyo mudzikinuri uya waaireva akati asvika, Bhoazi akati kwaari, \"Douya napano, shamwari yangu, ugogara pasi.\" Naizvozvo akaenda akandogara pasi.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.1",
            "verseOrgIds": [
              "RUT.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "RUT 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhoazi akatora vakuru veguta gumi akati kwavari, \"Garai pano apa,\" ivo vakaita saizvozvo.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.2",
            "verseOrgIds": [
              "RUT.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "RUT 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akati kuhama yapedyo, mudzikinuri, \"Naomi uya akadzoka kumusha kubva kuMoabhu, ari kutengesa munda waiva waErimereki hama yedu.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.3",
            "verseOrgIds": [
              "RUT.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "RUT 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndafunga kuti ndiise nyaya kwauri nokukupa zano rokuti utenge pamberi paavo vagere pano uye napamberi pavakuru vavanhu vangu. Kana uchida kuudzikinura, ita hako izvozvo. Asi kana usingadi, ndiudze, kuti ndigoziva. Nokuti hapana mumwe ane mvumo yokuzviita kunze kwako, uye ini ndini ndinokutevera.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.4",
            "verseOrgIds": [
              "RUT.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "RUT 4:4"
      },
      "items": [
        {
          "text": "Iye akati, \"Ndichautenga.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.4",
            "verseOrgIds": [
              "RUT.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "RUT 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Bhoazi akati, \"Pazuva raunotenga munda uyu kubva kuna Naomi naRute muMoabhu, unotorawo chirikadzi yomushakabvu, kuitira kuti mumutse zita romufi nenhaka yake.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.5",
            "verseOrgIds": [
              "RUT.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "RUT 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye hama yapedyo, mudzikinuri akati, \"Kana zvakadaro handingagoni kuudzikinura nokuti ndingazokanganisa nhaka yanguwo. Chiutenga iwe pachako. Ini handikwanisi kuzviita.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.6",
            "verseOrgIds": [
              "RUT.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "RUT 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Zvino pamazuva akare muIsraeri, pakutenga nokutsinhana midziyo uye kuti zvisimbiswe, mumwe aibvisa shangu yake oipa kuno mumwe. Iyi ndiyo yaiva nzira yokuita chibvumirano zviri pamutemo muIsraeri.)",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.7",
            "verseOrgIds": [
              "RUT.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "RUT 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo hama yapedyo, mudzikinuri akati kuna Bhoazi, \"Chiutenga iwe.\" Uye akabvisa shangu yake.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.8",
            "verseOrgIds": [
              "RUT.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "RUT 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Bhoazi akazivisa vakuru navanhu vose akati, \"Nhasi muri zvapupu zvokuti ndatenga kubva kuna Naomi zvake zvose nazvose zvaiva zvaErimereki, zvaKirioni nezvaMaroni.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.9",
            "verseOrgIds": [
              "RUT.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "RUT 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndatorawo Rute muMoabhu, chirikadzi yaMaroni, kuti ave mukadzi wangu kuti ndimutse zita romushakabvu pamwe chete nenhaka yake, kuitira kuti zita rake rirege kurova mumhuri yake kana mumabhuku eguta. Nhasi ndimi zvapupu!\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.10",
            "verseOrgIds": [
              "RUT.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "RUT 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakuru navose vaiva pasuo vakati, \"Tiri zvapupu isu. Jehovha ngaaite kuti mukadzi ari kuuya mumusha mako ave saRakeri naRea, avo vakavaka pamwe chete imba yaIsraeri. Iwe dai ukasimudzirwa muEfurata uye ukava nomukurumbira muBheterehema.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.11",
            "verseOrgIds": [
              "RUT.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "RUT 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubudikidza navana vaunopiwa naJehovha nomukadzi wechidiki uyu, mhuri yako ngaive seyaPerezi, uyo akaberekerwa Judha naTamari.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.12",
            "verseOrgIds": [
              "RUT.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Marudzi aDhavhidhi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "RUT 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo Bhoazi akatora Rute akava mukadzi wake. Zvino akapinda kwaari Jehovha akamuita kuti abate pamuviri, iye akabereka mwanakomana.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.13",
            "verseOrgIds": [
              "RUT.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "RUT 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakadzi vakati kuna Naomi, \"Jehovha ngaarumbidzwe, uyo asina kukusiya usina hama yapedyo, mudzikinuri. Ngaave nomukurumbira pakati peIsraeri yose!",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.14",
            "verseOrgIds": [
              "RUT.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "RUT 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achavandudza upenyu hwako nokukuchengeta pamazuva okuchembera kwako. Nokuti muroora wako, uyo anokuda uye anokunda vanakomana vanomwe, ndiye amubereka.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.15",
            "verseOrgIds": [
              "RUT.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "RUT 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Naomi akatora mwana, akamuisa pamakumbo ake akamurera.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.16",
            "verseOrgIds": [
              "RUT.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "RUT 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakadzi vaigarako vakati, \"Naomi ava nomwana womukomana.\" Zvino vakamutumidza kuti Obhedhi. Ndiye aiva baba vaJese, baba vaDhavhidhi.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.17",
            "verseOrgIds": [
              "RUT.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "RUT 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyi ndiyo imba yaPerezi:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "RUT 4:18"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "RUT 4:18"
      },
      "items": [
        {
          "text": "Perezi akabereka Hezironi,",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.18",
            "verseOrgIds": [
              "RUT.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "RUT 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezironi akabereka Ramu,",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.19",
            "verseOrgIds": [
              "RUT.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "RUT 4:19"
      },
      "items": [
        {
          "text": "Ramu akabereka Aminadhabhi,",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.19",
            "verseOrgIds": [
              "RUT.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "RUT 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aminadhabhi akabereka Nashoni,",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.20",
            "verseOrgIds": [
              "RUT.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "RUT 4:20"
      },
      "items": [
        {
          "text": "Nashoni akabereka Sarimoni,",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.20",
            "verseOrgIds": [
              "RUT.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "RUT 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sarimoni akabereka Bhoazi,",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.21",
            "verseOrgIds": [
              "RUT.4.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "RUT 4:21"
      },
      "items": [
        {
          "text": "Bhoazi akabereka Obhedhi,",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.21",
            "verseOrgIds": [
              "RUT.4.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "RUT 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obhedhi akabereka Jese,",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.22",
            "verseOrgIds": [
              "RUT.4.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "RUT 4:22"
      },
      "items": [
        {
          "text": "uye Jese akabereka Dhavhidhi.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.22",
            "verseOrgIds": [
              "RUT.4.22"
            ]
          }
        }
      ]
    }
  ],
