              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino ipapo, pamberi pavaIsraeri, Joshua akanyorazve pamabwe murayiro waMozisi, waakanga ambonyora.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.32",
            "verseOrgIds": [
              "JOS.8.32"
            ]
          }
        },
