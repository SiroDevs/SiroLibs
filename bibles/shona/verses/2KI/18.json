  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "2KI 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hezekia Mambo weJudha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugore rechitatu raHoshea mwanakomana waEra Mambo weIsraeri, Hezekia mwanakomana waAhazi mambo weJudha akatanga kutonga.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.1",
            "verseOrgIds": [
              "2KI.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanga ava namakore makumi maviri namashanu paakava mambo, uye akatonga muJerusarema kwamakore makumi maviri namapfumbamwe. Zita ramai vake rainzi Abhiya mwanasikana waZekaria.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.2",
            "verseOrgIds": [
              "2KI.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaita zvakanaka pamberi paJehovha, sezvakanga zvaita baba vake Dhavhidhi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.3",
            "verseOrgIds": [
              "2KI.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabvisa matunhu akakwirira, akaputsa matombo okunamata, uye akatema matanda aAshera. Akaputsa nyoka yendarira yakanga yaitwa naMozisi, nokuti kusvikira panguva iyoyo vaIsraeri vakanga vachipisira zvinonhuhwira kwairi. (Yakanga ichinzi Nehushitani.)",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.4",
            "verseOrgIds": [
              "2KI.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia akanga achivimba naJehovha, Mwari waIsraeri. Kwakanga kusina akafanana naye pakati pamadzimambo ose eJudha, vakamutangira kana vakamutevera.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.5",
            "verseOrgIds": [
              "2KI.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanamatira kuna Jehovha uye haana kurega kumutevera; akachengeta mirayiro yakapiwa Mozisi naJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.6",
            "verseOrgIds": [
              "2KI.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Jehovha aiva naye; akabudirira pane zvose zvaakaita. Akamukira mambo weAsiria akasazomushandira.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.7",
            "verseOrgIds": [
              "2KI.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akakunda vaFiristia, kubva pachirindo chavarindi kusvikira kuguta rakakomberedzwa, zvichienda kuGaza nenyika yayo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.8",
            "verseOrgIds": [
              "2KI.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugore rechina ramambo Hezekia, iro raiva gore rechinomwe raHoshea mwanakomana waEra mambo weIsraeri, Sharimaneseri mambo weAsiria akaenda kundorwa neSamaria akarikunda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.9",
            "verseOrgIds": [
              "2KI.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakupera kwamakore matatu vaAsiria vakaritora. Saka Samaria yakatorwa mugore rechitanhatu raMambo Hezekia, iro rakanga riri gore rechipfumbamwe raHoshea mambo weIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.10",
            "verseOrgIds": [
              "2KI.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo weAsiria akavatapa akavaendesa kuAsiria akandovagarisa muHara, muGozani paRwizi rweHabhori nomumaguta avaMedhesi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.11",
            "verseOrgIds": [
              "2KI.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi zvakaitika nokuti vakanga vasina kuteerera Jehovha Mwari wavo, asi vakanga vadarika sungano yake nezvose zvakanga zvarayirwa naMozisi muranda waJehovha. Vakaramba kunzwa mirayiro kana kuiita.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.12",
            "verseOrgIds": [
              "2KI.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugore regumi namana rokutonga kwamambo Hezekia, Senakeribhi mambo weAsiria akarwisa maguta ose eJudha akakomberedzwa namasvingo akaatora.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.13",
            "verseOrgIds": [
              "2KI.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Hezekia mambo weJudha akatuma shoko kuna mambo weAsiria paRakishi achiti, \"Ndakakanganisa hangu. Ibvai henyu kwandiri, uye ndicharipa zvose zvamuchareva kwandiri.\" Mambo weAsiria akaripisa Hezekia mambo weJudha mutero wamazana matatu amatarenda",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.14",
            "verseOrgIds": [
              "2KI.18.14"
            ]
          }
        },
        {
          "text": "esirivha namatarenda egoridhe makumi matatu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.14",
            "verseOrgIds": [
              "2KI.18.14"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.14",
            "verseOrgIds": [
              "2KI.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Hezekia akamupa sirivha yose yakawanikwa mutemberi yaJehovha nomumatura omumuzinda wamambo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.15",
            "verseOrgIds": [
              "2KI.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyoyo Hezekia mambo weJudha akabvisa goridhe raakanga afukidza naro makonhi nembiru dzamakonhi etemberi yaJehovha, akazvipa kuna mambo weAsiria.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.16",
            "verseOrgIds": [
              "2KI.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Senakeribhi anovhundutsira Jerusarema",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo weAsiria akatuma mukuru wehondo, nomukuru wavabati uye nomukuru wavatariri, nehondo huru, kubva kuRakishi kuti vaende kuna mambo Hezekia kuJerusarema. Vakakwira kuJerusarema vakamira pamugero weDziva roKumusoro, mumugwagwa unoenda kuMunda woMusuki.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.17",
            "verseOrgIds": [
              "2KI.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakadana mambo; uye Eriakimi mwanakomana waHirikia mutariri womuzinda wamambo, naShebhina munyori, naJoa mwanakomana waAsafi munyori wenhoroondo vakabuda vakaenda kwavari.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.18",
            "verseOrgIds": [
              "2KI.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukuru wavatariri akati kwavari, \"Udzai Hezekia kuti:",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.19",
            "verseOrgIds": [
              "2KI.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2KI 18:19"
      },
      "items": [
        {
          "text": "\" 'Zvanzi namambo mukuru, mambo weAsiria: Chaunovimba nacho chii?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.19",
            "verseOrgIds": [
              "2KI.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unoti unogona kuronga uye une simba rokurwa, asi uri kungotaura mashoko asingazari mukombe. Uri kuvimba naaniko, kuti undimukire?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.20",
            "verseOrgIds": [
              "2KI.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tarira zvino, wakasendamira paIjipiti, uya mudonzvo werutsanga rwakatsemuka runobaya ruoko rwomunhu ruchimupa ronda kana asendamira parwuri! Ndizvo zvakaita Faro mambo weIjipiti kuna vose vanosendamira paari.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.21",
            "verseOrgIds": [
              "2KI.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana ukati kwandiri, \"Tinovimba naJehovha Mwari wedu,\" ko, haazi iye ane matunhu akakwirira nearitari dzakabviswa naHezekia, achiti kuJudha neJerusarema, \"Munofanira kunamata pamberi pearitari iyi muJerusarema here?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.22",
            "verseOrgIds": [
              "2KI.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Chiuya zvino, uite chitsidzo natenzi wangu, mambo weAsiria. Ndichakupa zviuru zviviri zvamabhiza, kana uchigona kuisa vatasvi pamusoro pawo!",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.23",
            "verseOrgIds": [
              "2KI.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungagona seiko kukunda mumwe wamachinda madiki atenzi wangu kunyange dai uchivimba neIjipiti kuti uchapiwa ngoro navatasvi vamabhiza?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.24",
            "verseOrgIds": [
              "2KI.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamusoro pezvo, handina kuuya kuzorwa nokuparadza nzvimbo ino ndisina shoko rinobva kuna Jehovha here? Jehovha pachake akandiudza kuti ndiuye kuzorwisa nyika uye ndiiparadze.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.25",
            "verseOrgIds": [
              "2KI.18.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Eriakimu mwanakomana waHirikia, naShebhina naJoa vakati kumukuru wavatariri, \"Tapota, taurai kuvaranda venyu norurimi rwechiAramu sezvo tichirunzwa. Musataura nesu nechiHebheru vanhu vari parusvingo vachizvinzwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.26",
            "verseOrgIds": [
              "2KI.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi mukuru wehondo akapindura akati, \"Ko, ndakatumwa natenzi wangu kuna tenzi wako nokwauri chete here kuti nditaure mashoko aya ndisingatauri kuvarume vagere parusvingo, ivo pamwe chete newe vanofanira kudya tsvina yavo nokunwa mvura yemiviri yavo?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.27",
            "verseOrgIds": [
              "2KI.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mukuru wehondo akasimuka akadanidzira norurimi rwechiHebheru achiti, \"Inzwai shoko ramambo mukuru, mambo weAsiria!",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.28",
            "verseOrgIds": [
              "2KI.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvanzi namambo: Musarega Hezekia achikunyengerai. Haagoni kukudzikinurai kubva muruoko rwangu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.29",
            "verseOrgIds": [
              "2KI.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musarega Hezekia achikukurudzirai kuti muvimbe naJehovha paanoti, 'Zvirokwazvo Jehovha achatirwira; guta rino harizopiwi muruoko rwamambo weAsiria.'",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.30",
            "verseOrgIds": [
              "2KI.18.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Musateerera Hezekia. Zvanzi namambo weAsiria: Itai rugare neni mugouya kuno kwandiri. Ipapo mumwe nomumwe wenyu achadya zvinobva pamuzambiringa wake napamuonde wake, uye achanwa mvura inobva muchirongo chake,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.31",
            "verseOrgIds": [
              "2KI.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "kusvikira ndauya ndikakutorai ndigokuisai kunyika yakafanana neyenyu, nyika ine zvokudya newaini itsva, nyika yechingwa neminda yemizambiringa, nyika yemiti yemiorivhi nouchi. Sarudzai upenyu kwete rufu!",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.32",
            "verseOrgIds": [
              "2KI.18.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 18:32"
      },
      "items": [
        {
          "text": "\"Musateerera Hezekia, nokuti anokutsausai kana akati, 'Jehovha achatirwira.'",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.32",
            "verseOrgIds": [
              "2KI.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pana mwari wenyika ipi zvayo akamborwira nyika yake kubva muruoko rwamambo weAsiria?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.33",
            "verseOrgIds": [
              "2KI.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamwari veHamati neveAripadhi varipi? Vamwari veSefarivhaimi, neHena neIvha varipi? Vakanunura Samaria muruoko rwangu here?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.34",
            "verseOrgIds": [
              "2KI.18.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiani wavamwari vose venyika idzi akagona kuponesa nyika yake kubva kwandiri? Zvino Jehovha achanunura Jerusarema sei kubva muruoko rwangu?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.35",
            "verseOrgIds": [
              "2KI.18.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 18:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vanhu vakaramba vakanyarara vakasataura chinhu, nokuti mambo akanga arayira akati, \"Musamupindura.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.36",
            "verseOrgIds": [
              "2KI.18.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 18:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Eriakimi mwanakomana waHirikia mutariri womuzinda wamambo, naShebhina munyori naJoa mwanakomana waAsafi munyori wenhoroondo vakaenda kuna Hezekia, nenguo dzavo dzakabvaruka, vakamuudza zvakanga zvataurwa nomukuru wavarwi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.37",
            "verseOrgIds": [
              "2KI.18.37"
            ]
          }
        }
      ]
    }
  ],
