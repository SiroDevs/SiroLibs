{
  "id": "2KI.4",
  "number": "4",
  "bookId": "2KI",
  "reference": "2 Madzimambo 4",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 44,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "2KI 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mafuta eChirikadzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino mukadzi womumwe murume weboka ravaprofita akadanidzira kuna Erisha akati, \"Muranda wenyu, murume wangu afa, uye munoziva kuti aitya Jehovha. Asi zvino uyo waakanga atorera chikwereti ari kuuya kuzotora vanakomana vangu vaviri kuti vave nhapwa dzake.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.1",
            "verseOrgIds": [
              "2KI.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erisha akamupindura akati, \"Ndingakubatsira seiko? Nditaurire, chii chaunacho mumba mako?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.2",
            "verseOrgIds": [
              "2KI.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 4:2"
      },
      "items": [
        {
          "text": "Iye akati, \"Murandakadzi wenyu haana kana chinhu kunze kwamafuta mashoma shoma.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.2",
            "verseOrgIds": [
              "2KI.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erisha akati kwaari, \"Enda unokumbira vavakidzani vako vose vakupe midziyo isina chinhu. Usakumbira mishoma.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.3",
            "verseOrgIds": [
              "2KI.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ugopinda mumba uzvipfigire mukova iwe navana vako. Udire mafuta mumidziyo yose, ugoisa parutivi mudziyo unenge wazara.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.4",
            "verseOrgIds": [
              "2KI.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo akabva kwaari, akapfiga mukova iye navana vake vari mukati. Vakauya nemidziyo kwaari, iye akaramba achingodira.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.5",
            "verseOrgIds": [
              "2KI.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Midziyo yose yakati yazara, akati kumwanakomana wake, \"Ndivigire mumwe mudziyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.6",
            "verseOrgIds": [
              "2KI.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 4:6"
      },
      "items": [
        {
          "text": "Asi iye akapindura akati, \"Hapachina mumwe mudziyo wasara.\" Ipapo mafuta akabva aguma.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.6",
            "verseOrgIds": [
              "2KI.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaenda kundoudza munhu waMwari uye iye akati, \"Chienda unotengesa mafuta ugoripa zvikwereti zvako, iwe navanakomana vako mugorarama neanenge asara.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.7",
            "verseOrgIds": [
              "2KI.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwanakomana woMukadzi muShunemi anoraramiswa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rimwe zuva Erisha akaenda kuShunemi. Ikoko kwaiva nomukadzi akanga ari mupfumi, uye akamugombedzera kuti agare ambodya. Saka nguva dzose paaipfuura nepo, aimirapo odya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.8",
            "verseOrgIds": [
              "2KI.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukadzi akati kumurume wake, \"Ndinoziva kuti murume uyu anopfuura napano, mutsvene waMwari.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.9",
            "verseOrgIds": [
              "2KI.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngativakei kamuri padenga tigomuisira mubhedha netafura, nechigaro uye nerambi imomo. Ipapo achakwanisa kugaramo paanenge angotishanyira.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.10",
            "verseOrgIds": [
              "2KI.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rimwe zuva Erisha akati asvika, akakwira kukamuri rake ndokurara imomo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.11",
            "verseOrgIds": [
              "2KI.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kumuranda wake Gehazi, \"Dana mukadzi muShunami.\" Naizvozvo akamudana, uye akamira pamberi pake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.12",
            "verseOrgIds": [
              "2KI.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erisha akati kwaari, \"Muudze kuti, 'Makatitamburira imi pane zvose izvi, zvino mungaitirwewo chii? Tingakumiririrai kuna mambo here kana kumukuru wehondo?' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.13",
            "verseOrgIds": [
              "2KI.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 4:13"
      },
      "items": [
        {
          "text": "Iye akapindura akati, \"Ndine musha pakati pavanhu vokwangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.13",
            "verseOrgIds": [
              "2KI.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erisha akabvunza akati, \"Angaitirwe chiiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.14",
            "verseOrgIds": [
              "2KI.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 4:14"
      },
      "items": [
        {
          "text": "Gehazi akati, \"Zvirokwazvo, haana mwanakomana uye murume wake akwegura.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.14",
            "verseOrgIds": [
              "2KI.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Erisha akati, \"Mudane.\" Naizvozvo akamudana, mukadzi akamira pamukova.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.15",
            "verseOrgIds": [
              "2KI.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erisha akati, \"Nenguva inenge ino gore rinouya, uchafungatira mwanakomana mumaoko ako.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.16",
            "verseOrgIds": [
              "2KI.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 4:16"
      },
      "items": [
        {
          "text": "Iye akati, \"Kwete, ishe wangu. Haiwa munhu waMwari, musarevera nhema murandakadzi wenyu!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.16",
            "verseOrgIds": [
              "2KI.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi mukadzi akava nemimba, uye gore raitevera nenguva yakare iyoyo akapona mwanakomana, sezvaakanga audzwa naErisha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.17",
            "verseOrgIds": [
              "2KI.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana akati akura, nerimwe zuva akaenda kuna baba vake, kwavaiva navakohwi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.18",
            "verseOrgIds": [
              "2KI.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kuna baba vake, \"Musoro wangu! Musoro wangu!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.19",
            "verseOrgIds": [
              "2KI.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 4:19"
      },
      "items": [
        {
          "text": "Baba vake vakataurira muranda vakati, \"Mutakurei muende naye kuna mai vake.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.19",
            "verseOrgIds": [
              "2KI.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure mokunge muranda amusimudza, akaenda naye kuna mai vake, mukomana akagara pamakumbo amai vake kusvikira masikati, ndokubva afa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.20",
            "verseOrgIds": [
              "2KI.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakakwira pamusoro naye vakandomuradzika pamubhedha womunhu waMwari, ndokupfiga mukova ndokubuda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.21",
            "verseOrgIds": [
              "2KI.4.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukadzi akadana murume wake akati, \"Ndapota, ndidanire mumwe wavaranda nembongoro kuti ndiende kumunhu waMwari nokukurumidza ndigodzoka.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.22",
            "verseOrgIds": [
              "2KI.4.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akamubvunza akati, \"Uri kuendereiko kwaari nhasi? Hakusi Kugara kwoMwedzi kana Sabata.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.23",
            "verseOrgIds": [
              "2KI.4.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 4:23"
      },
      "items": [
        {
          "text": "Akapindura akati, \"Hazvina mhosva.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.23",
            "verseOrgIds": [
              "2KI.4.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaisa chigaro pamusoro pembongoro akati kumuranda wake, \"Tungamira; usafamba zvishoma uchiitira ini kunze kwokunge ndakuudza.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.24",
            "verseOrgIds": [
              "2KI.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo akaenda akasvika kumunhu waMwari paGomo reKarimeri.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.25",
            "verseOrgIds": [
              "2KI.4.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 4:25"
      },
      "items": [
        {
          "text": "Akati achimuona achiri kure, munhu waMwari akati kumuranda wake Gehazi, \"Tarisa! Hoyo mukadzi muShunami!",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.25",
            "verseOrgIds": [
              "2KI.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mhanya undosangana naye ugomubvunza kuti, 'Munofara mose here? Ko, murume wako anofara here? Ko, mwana wako anofara here?' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.26",
            "verseOrgIds": [
              "2KI.4.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 4:26"
      },
      "items": [
        {
          "text": "Mukadzi akati, \"Zvose zvakanaka.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.26",
            "verseOrgIds": [
              "2KI.4.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paakasvika kumunhu waMwari paGomo, akabata makumbo ake. Gehazi akauya achiti amusundire kure, asi munhu waMwari akati, \"Murege akadaro! Nokuti ane shungu dzinomutambudza, asi Jehovha akandivanzira chinhu ichi uye haana kundiudza kuti imhaka yei.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.27",
            "verseOrgIds": [
              "2KI.4.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukadzi akati, \"Ndakakukumbirai mwanakomana here, tenzi wangu? Ko, handina kukutaurirai kuti musandinyengedzera here?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.28",
            "verseOrgIds": [
              "2KI.4.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erisha akati kuna Gehazi, \"Zvisunge chiuno ubate tsvimbo yangu muruoko rwako umhanye. Kana ukasangana naani zvake, usamukwazisa, uye ani naani anokukwazisa, iwe usapindura. Uradzike tsvimbo yangu pauso hwomukomana.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.29",
            "verseOrgIds": [
              "2KI.4.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi mai vomwana vakati, \"Zvirokwazvo naJehovha mupenyu, uye noupenyu hwenyu, handisi kuzokusiyai.\" Naizvozvo akasimuka akamutevera.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.30",
            "verseOrgIds": [
              "2KI.4.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gehazi akatungamira mberi akandoisa tsvimbo pachiso chomwana, asi hapana chakanzwika kana chakapfakanyika. Naizvozvo Gehazi akadzokera kuti andosangana naErisha akamuudza kuti, \"Mukomana haana kumuka.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.31",
            "verseOrgIds": [
              "2KI.4.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erisha paakasvika pamba, akawana mukomana ari pamubhedha akafa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.32",
            "verseOrgIds": [
              "2KI.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapinda mukati, akapfiga mukova iye nomwana vari vaviri, akanyengetera kuna Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.33",
            "verseOrgIds": [
              "2KI.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akakwira pamubhedha akatsivama pamusoro pomwana, akaisa muromo wake pamuromo womwana, nameso ake pameso omwana, uye maoko pamaoko ake. Paakatsivamira pamusoro pake, muviri womukomana wakatanga kudziya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.34",
            "verseOrgIds": [
              "2KI.4.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erisha akafuratira, achifamba-famba mukati mekamuri akadzokerazve pamubhedha akatsivamazve pamusoro pake. Mukomana akahotsira kanomwe kose ndokusvinura meso ake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.35",
            "verseOrgIds": [
              "2KI.4.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erisha akadana Gehazi akati kwaari, \"Dana mukadzi muShunami.\" Iye akaita saizvozvo. Akati apinda, Erisha akati kwaari, \"Tora mwanakomana wako.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.36",
            "verseOrgIds": [
              "2KI.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akapinda, akazviwisira patsoka dzake akakotamira pasi, akasimuka akatora mwanakomana wake akabuda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.37",
            "verseOrgIds": [
              "2KI.4.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rufu muhari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2KI 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erisha akadzokera kuGirigari uye maiva nenzara mudunhu imomo. Boka ravanakomana vavaprofita parakanga rigere pamberi pake, akati kumuranda wake, \"Gadzai hari huru mubikire boka ravaprofita ava zvokudya.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.38",
            "verseOrgIds": [
              "2KI.4.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2KI 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe wavo akaenda kuminda kundotanha muriwo akawana magaka omusango. Akaunganidza mamwe acho akaazadza mujasi rake. Paakadzokera, akaatema-tema ndokuaisa muhari yomuriwo, kunyange zvazvo pakanga pasina aiziva kuti zvaiva zvii.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.39",
            "verseOrgIds": [
              "2KI.4.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "2KI 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvokudya zvakapakurirwa vanhu, asi pavakatanga kudya vakadanidzira vakati, \"Nhai munhu waMwari, mune rufu muhari!\" Uye vakatadza kuzvidya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.40",
            "verseOrgIds": [
              "2KI.4.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "2KI 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erisha akati, \"Uyai noupfu.\" Akahuisa muhari akati, \"Ipai vanhu vadye.\" Ipapo hapana kuzova nechinokuvadza muhari.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.41",
            "verseOrgIds": [
              "2KI.4.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vanhu zana vanopiwa zvokudya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "2KI 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe murume akauya achibva kuBhaari Sharisha achivigira munhu waMwari marofu makumi maviri echingwa chebhari chakanga chabikwa nezviyo zvakatanga kuibva, pamwe chete nehura dzezviyo zvitsva. Erisha akati, \"Ipai vanhu vadye.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.42",
            "verseOrgIds": [
              "2KI.4.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "2KI 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muranda wake akati, \"Ndingagovera izvi kuvanhu zana sei?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.43",
            "verseOrgIds": [
              "2KI.4.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 4:43"
      },
      "items": [
        {
          "text": "Asi Erisha akapindura akati, \"Ipai vanhu vadye. Nokuti zvanzi naJehovha, 'Vachadya vakasiya zvimwe.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.43",
            "verseOrgIds": [
              "2KI.4.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "2KI 4:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akavaisira pamberi pavo zvokudya, vakadya vakasiya zvimwe, sezvakanga zvataurwa neshoko raJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.44",
            "verseOrgIds": [
              "2KI.4.44"
            ]
          }
        }
      ]
    }
  ],
