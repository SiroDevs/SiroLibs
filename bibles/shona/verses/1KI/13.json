  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "1KI 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Munhu waMwari aibva kuJudha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuda kweshoko raJehovha munhu waMwari akabva kuJudha akauya kuBheteri, Jerobhoamu paakanga akamira pedyo nearitari ava kupirisa zvinonhuhwira.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.1",
            "verseOrgIds": [
              "1KI.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akadanidzira kuaritari akati, \"Iwe aritari, aritari! Zvanzi naJehovha: 'Mwanakomana anonzi Josia achaberekwa muimba yaDhavhidhi. Vaprista vamatunhu akakwirira vari kupisira zvinonhuhwira pano zvino, achavabayira pamusoro pako, uye mapfupa avanhu achapiswa pamusoro pako.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.2",
            "verseOrgIds": [
              "1KI.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musi mumwe chete iwoyo munhu waMwari akapa chiratidzo akati, \"Ichi ndicho chiratidzo chataurwa naJehovha: Aritari ichatsemuka uye madota ari pamusoro payo acharasirwa pasi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.3",
            "verseOrgIds": [
              "1KI.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Mambo Jerobhoamu paakanzwa zvakanga zvadanidzirwa nomunhu waMwari kuaritari paBheteri, akatambanudza ruoko rwake ruchibva kuaritari akati, \"Mubatei!\" Asi ruoko rwaakatambanudzira kumurume uyu rwakaoma, zvokuti akatadza kurudzosa zvakare.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.4",
            "verseOrgIds": [
              "1KI.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aritariwo yakatsemuka uye madota ayo akarasikira pasi zvichienderana nechiratidzo chakanga chapiwa nomunhu waMwari nokuda kweshoko raJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.5",
            "verseOrgIds": [
              "1KI.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mambo akati kumunhu waMwari, \"Ndinamatirewo kuna Jehovha Mwari wako uchindinamatira kuti ruoko rwangu ruporeswe.\" Naizvozvo munhu waMwari akamunamatira kuna Jehovha ruoko rwamambo rukaporeswa rukaita sezvarwakanga rwakaita pakutanga.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.6",
            "verseOrgIds": [
              "1KI.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akati kumunhu waMwari, \"Handei kumba kwangu undowana zvaungadya, uye ndichakupa chipo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.7",
            "verseOrgIds": [
              "1KI.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi munhu waMwari akapindura mambo akati, \"Kunyange maindipa hafu yezvose zvamunazvo, handaimboenda nemi, uye handaimbodya chingwa kana kunwa mvura kuno.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.8",
            "verseOrgIds": [
              "1KI.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti ndakarayirwa neshoko raJehovha kuti, 'Haufaniri kudya chingwa kana kunwa mvura kana kudzoka nenzira yawabva nayo.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.9",
            "verseOrgIds": [
              "1KI.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka akaenda neimwe nzira, haana kudzokera nenzira yaakanga auya nayo kuBheteri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.10",
            "verseOrgIds": [
              "1KI.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino paiva nomumwe muprofita akanga ava harahwa aigara muBheteri, vana vake vakauya vakamuudza zvose zvakanga zvaitwa nomunhu waMwari musi iwoyo muBheteri. Vakaudzawo baba vavo zvaakanga ataura kuna mambo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.11",
            "verseOrgIds": [
              "1KI.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baba vavo vakavabvunza kuti, \"Aenda nenzira ipiko?\" Zvino vana vake vakamuratidza nzira yakanga yaendwa nayo nomunhu waMwari aibva kuJudha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.12",
            "verseOrgIds": [
              "1KI.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka akati kuvana vake, \"Ndisungirirei chigaro pambongoro.\" Zvino vakati vamusungirira chigaro pambongoro, akaitasva.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.13",
            "verseOrgIds": [
              "1KI.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatevera munhu waMwari. Akamuwana agere pasi pomuti womuouki akamubvunza akati, \"Ndiwe here munhu waMwari akabva kuJudha?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.14",
            "verseOrgIds": [
              "1KI.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 13:14"
      },
      "items": [
        {
          "text": "Akapindura akati, \"Ndini.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.14",
            "verseOrgIds": [
              "1KI.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo muprofita akati kwaari, \"Handei kumba kwangu undodya.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.15",
            "verseOrgIds": [
              "1KI.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munhu waMwari akati, \"Handigoni kudzoka nemi, zvakare handigoni kudya chingwa kana kunwa mvura nemi panzvimbo ino.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.16",
            "verseOrgIds": [
              "1KI.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakaudzwa neshoko raJehovha kuti, 'Haufaniri kudya chingwa kana kunwa mvura ikoko kana kudzoka nenzira yaunenge wauya nayo.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.17",
            "verseOrgIds": [
              "1KI.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muprofita akanga ava harahwa akapindura akati, \"Neniwo ndiri muprofita sezvawakaita. Zvino mutumwa ati kwandiri neshoko raJehovha, 'Dzoka naye kumba kwako kuitira kuti adye chingwa uye anwe mvura.' \" Asi akanga achimunyepera.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.18",
            "verseOrgIds": [
              "1KI.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka munhu waMwari akadzokera naye akandodya uye akanwa mumba make.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.19",
            "verseOrgIds": [
              "1KI.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvavakanga vachakagara patafura, shoko raJehovha rakauya kumuprofita akanga ava harahwa, uyo akanga amudzosa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.20",
            "verseOrgIds": [
              "1KI.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akadanidzira kumunhu waMwari akanga abva kuJudha akati, \"Zvanzi naJehovha: 'Hauna kuteerera shoko raJehovha uye hauna kuchengeta murayiro wawakapiwa naJehovha Mwari wako.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.21",
            "verseOrgIds": [
              "1KI.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wadzoka ukadya chingwa uye ukanwa mvura munzvimbo yaakakuudza kuti usadya kana kunwa. Naizvozvo mutumbi wako hausi kuzovigwa muguva ramadzibaba ako.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.22",
            "verseOrgIds": [
              "1KI.13.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munhu waMwari paakapedza kudya nokunwa, muprofita akanga amudzosa akamusungirira chigaro pambongoro.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.23",
            "verseOrgIds": [
              "1KI.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati ava munzira, shumba yakasangana naye panzira, ikamuuraya, mutumbi wake ukakandwa munzira, mbongoro neshumba zvikamira pauri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.24",
            "verseOrgIds": [
              "1KI.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamwe vanhu vaipfuura nepo vakaona mutumbi uyu wakakandwa panzira, shumba yakamira parutivi pomutumbi, vakaenda vakandozvitaura muguta maigara muprofita uya akanga ava harahwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.25",
            "verseOrgIds": [
              "1KI.13.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muprofita akanga amudzosa parwendo rwake paakazvinzwa, akati, \"Ndiye munhu waMwari asina kuteerera shoko raJehovha. Jehovha amupa kushumba, iyo yamubvambura nokumuuraya, sokumuyambira kwakanga kwaita shoko raJehovha.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.26",
            "verseOrgIds": [
              "1KI.13.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muprofita akati kuvanakomana vake, \"Ndisungirirei chigaro pambongoro,\" ivo vakaita saizvozvo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.27",
            "verseOrgIds": [
              "1KI.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akaenda akandoona mutumbi wakakandwa panzira, mbongoro neshumba zvakamira parutivi pawo. Shumba yakanga isina kudya mutumbi kana kubvambura mbongoro.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.28",
            "verseOrgIds": [
              "1KI.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka muprofita akasimudza mutumbi womunhu waMwari, akauisa pamusoro pembongoro akadzoka nawo kuguta rake kuti andomuchema uye amuvige.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.29",
            "verseOrgIds": [
              "1KI.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaisa mutumbi wake muguva rake, vakamuchema vakati, \"Yowe-e, hama yangu!\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.30",
            "verseOrgIds": [
              "1KI.13.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure mokumuviga, akati kuvanakomana vake, \"Kana ndafa, mundivige muguva mataviga munhu waMwari; muise mapfupa angu parutivi peake.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.31",
            "verseOrgIds": [
              "1KI.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti zvaakataura neshoko raJehovha pamusoro pearitari iri muBheteri napamusoro pedzimba dzose dziri panzvimbo dzakakwirira mumaguta eSamaria zvichaitika saizvozvo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.32",
            "verseOrgIds": [
              "1KI.13.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange shure kwaizvozvi, Jerobhoamu haana kupinduka pamaitiro ake akaipa, asi akasarudzazve vaprista venzvimbo dzakakwirira kubva kuvanhu vakangosiyana-siyana. Munhu wose wose aida kuva muprista aigadzwa kuti ashande panzvimbo dzakakwirira.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.33",
            "verseOrgIds": [
              "1KI.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi ndicho chivi cheimba yaJerobhoamu chakaita kuti iwe uye iparare pamusoro penyika.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.34",
            "verseOrgIds": [
              "1KI.13.34"
            ]
          }
        }
      ]
    }
