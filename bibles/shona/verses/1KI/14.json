  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "1KI 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ahija anoprofita nezvokutongwa kwaJerobhoamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyoyo Abhija, mwanakomana waJerobhoamu, akarwara,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.1",
            "verseOrgIds": [
              "1KI.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jerobhoamu akati kumukadzi wake, \"Enda undozvivanza, kuti urege kuzivikanwa kuti ndiwe mukadzi waJerobhoamu. Ipapo ugoenda kuShiro. Ahija muprofita ariko ikoko, uya akandiudza kuti ndichava mambo wavanhu ava.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.2",
            "verseOrgIds": [
              "1KI.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tora zvingwa gumi, makeke negaba rouchi ugoenda nazvo kwaari. Achakuudza zvichaitika kumukomana.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.3",
            "verseOrgIds": [
              "1KI.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo mukadzi waJerobhoamu akaita sezvaakataura akaenda kumba kwaAhija muShiro.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.4",
            "verseOrgIds": [
              "1KI.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 14:4"
      },
      "items": [
        {
          "text": "Zvino Ahija akanga asisaoni; meso ake akanga asisaoni nokuti akanga akwegura.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.4",
            "verseOrgIds": [
              "1KI.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Jehovha akaudza Ahija kuti, \"Mukadzi waJerobhoamu ari kuuya kuzokubvunza nezvomwanakomana wake, nokuti ari kurwara. Zvino iwe uchamupa mhinduro yokuti neyokuti. Paachasvika achazviita somumwe munhu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.5",
            "verseOrgIds": [
              "1KI.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Ahija paakanzwa mutsindo wetsoka dzake pamusuo, akati, \"Pinda, mukadzi waJerobhoamu. Sei uchizviita somumwe munhu? Ndatumwa kwauri namashoko asina kunaka.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.6",
            "verseOrgIds": [
              "1KI.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enda undoudza Jerobhoamu kuti izvi ndizvo zvinotaura Jehovha, Mwari waIsraeri: 'Ndakakusimudza kubva pakati pavanhu ndikakuita mutungamiri wavanhu vangu Israeri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.7",
            "verseOrgIds": [
              "1KI.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakabvarura umambo kubva muimba yaDhavhidhi ndikahupa kwauri, asi hauna kuva somuranda wangu Dhavhidhi, akachengeta mirayiro yangu uye akanditevera nomwoyo wake wose, akaita zvakanaka chete pamberi pangu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.8",
            "verseOrgIds": [
              "1KI.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe wakaita zvakaipa kupfuura vose vakararama iwe usati wavapo. Wakazviitira vamwe vamwari, zviumbwa zvakaitwa nesimbi; waita kuti nditsamwe uye ukandirasira shure kwako.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.9",
            "verseOrgIds": [
              "1KI.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nokuda kwezvinhu izvi ndichauyisa dambudziko paimba yaJerobhoamu. Ndichauraya varume vose vaJerobhoamu nhapwa, neakasununguka. Ndichapisa imba yaJerobhoamu sezvinoita munhu anopisa ndove, kusvikira pasisina chinhu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.10",
            "verseOrgIds": [
              "1KI.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbwa dzichadya vose vachafira muguta, uye shiri dzedenga dzichadya avo vachafira kusango. Jehovha ataura!'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.11",
            "verseOrgIds": [
              "1KI.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana uriwe, dzokera kumba. Panotsika tsoka yako muguta rako, mwanakomana achafa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.12",
            "verseOrgIds": [
              "1KI.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israeri yose ichamuchema igomuviga. Ndiye oga waJerobhoamu achavigwa, nokuti ndiye oga mumba maJerobhoamu aonekwa naJehovha, Mwari waIsraeri, kuti ane chakanaka maari.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.13",
            "verseOrgIds": [
              "1KI.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Jehovha achazvimutsira mambo waIsraeri achaparadza mhuri yaJerobhoamu. Nhasi ndiro zuva racho! Hongu, kana iye zvino.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.14",
            "verseOrgIds": [
              "1KI.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Jehovha acharova Israeri, zvokuti ichaita setsanga iri kuzungunuswa mumvura. Achadzura Israeri kubva munyika yakanaka iyi yaakapa kumadzitateguru avo agovaparadzira mhiri kwoRwizi, nokuti vakaita kuti Jehovha atsamwe nehasha pavakaitira Ashera mapango.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.15",
            "verseOrgIds": [
              "1KI.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acharamwa Israeri nokuda kwezvivi zvakaitwa naJerobhoamu nezvaakaita kuti Israeri iite.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.16",
            "verseOrgIds": [
              "1KI.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mukadzi waJerobhoamu akasimuka akaenda, akasvika kuTiza. Achingoti tsikei pachikumbaridzo cheimba, mwanakomana akabva afa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.17",
            "verseOrgIds": [
              "1KI.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakamuviga, uye Israeri yose yakamuchema, sezvazvakanga zvarehwa naJehovha kubudikidza nomuranda wake muprofita Ahija.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.18",
            "verseOrgIds": [
              "1KI.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvimwe zvakaitika panguva yokutonga kwaJerobhoamu, hondo dzake namatongero ake, zvakanyorwa mubhuku renhoroondo dzegore negore dzamadzimambo eIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.19",
            "verseOrgIds": [
              "1KI.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatonga kwamakore makumi maviri namaviri akazorora namadzibaba ake. Nadhabhi mwanakomana wake akamutevera paumambo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.20",
            "verseOrgIds": [
              "1KI.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rehobhoamu Mambo weJudha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehobhoamu mwanakomana waSoromoni akanga ari mambo munyika yeJudha. Akanga ana makore makumi mana nerimwe chete paakava mambo, uye akatonga kwamakore gumi namanomwe muJerusarema, guta rakanga rasarudzwa naJehovha kubva pamarudzi ose aIsraeri kuti aise Zita rake mariri. Zita ramai vake raiva Naama; vaiva muAmoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.21",
            "verseOrgIds": [
              "1KI.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaJudha vakaita zvakaipa pamberi paJehovha. Vakamutsa godo rake, kupfuura zvakaitwa namadzibaba avo, nezvivi zvavakaita.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.22",
            "verseOrgIds": [
              "1KI.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakazvivakirawo nzvimbo dzakakwirira, matombo anoera namapango aAshera pazvikomo zvose zvakakwirira napasi pemiti yose mikuru.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.23",
            "verseOrgIds": [
              "1KI.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwaivawo navarume vaizviita vakadzi vavamwe varume munyika, vanhu vakaita zvose zvinonyangadza zvaiitwa nendudzi idzo dzakanga dzadzingwa naJehovha pamberi pavaIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.24",
            "verseOrgIds": [
              "1KI.14.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugore rechishanu raMambo Rehobhoamu, Shishaki, mambo weIjipiti, akarwisa Jerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.25",
            "verseOrgIds": [
              "1KI.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatora pfuma yose yetemberi yaJehovha nepfuma yose yomuzinda wamambo. Akatora zvinhu zvose, kusanganisira nenhoo dzose dzegoridhe dzakanga dzagadzirwa naSoromoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.26",
            "verseOrgIds": [
              "1KI.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo Mambo Rehobhoamu akagadzira nhoo dzendarira kuti dzitore nzvimbo yadzo uye akadzipa kuvatungamiri vavarindi vaichengeta suo romuzinda wamambo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.27",
            "verseOrgIds": [
              "1KI.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguva dzose paienda mambo kutemberi yaJehovha, varindi vaitakura nhoo, mushure mezvo vachizodzidzosera kuimba yavarindi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.28",
            "verseOrgIds": [
              "1KI.14.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
