  "verseCount": 53,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "1KI 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Adhoniya anozvigadza Umambo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo Dhavhidhi akanga akwegura, ava namakore mazhinji, asi akanga asingadziyirwi kunyange vaimufukidza namagumbeze.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.1",
            "verseOrgIds": [
              "1KI.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo, varanda vake vakati kwaari, \"Ngatitsvakirei mambo wedu mhandara kuti imushandire nokumuchengeta. Acharara padivi pake kuti ishe mambo wedu adziyirwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.2",
            "verseOrgIds": [
              "1KI.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo, vakatsvaka musikana akanaka munyika yose yeIsraeri, vakawana Abhishagi, muShunami, vakauya naye kuna mambo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.3",
            "verseOrgIds": [
              "1KI.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musikana uyu akanga akanaka kwazvo; uye akachengeta mambo akamushandira, asi mambo haana kurara naye somukadzi wake.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.4",
            "verseOrgIds": [
              "1KI.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Adhoniya, uyo aiva namai vainzi Hagiti, akazvisimudzira akati, \"Ini ndichava mambo.\" Naizvozvo, akazvigadzirira ngoro navatasvi vamabhiza navarume makumi mashanu kuti vamhanye pamberi pake.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.5",
            "verseOrgIds": [
              "1KI.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baba vake vakanga vasina kana kumbomutsiura paupenyu hwake hwose vachiti, \"Ko, izvi nezvizvi wazviitirei?\" Akanga ari murume akanaka pachiso chake uye ndiye aitevera Abhusaromu pakuberekwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.6",
            "verseOrgIds": [
              "1KI.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adhoniya akarangana naJoabhu, mwanakomana waZeruya, naAbhiatari muprista uye vakamutsigira.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.7",
            "verseOrgIds": [
              "1KI.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Zadhoki muprista, Bhenaya mwanakomana waJehoyadha, Natani muprofita, Shimei, naRei, namauto apamusoro aDhavhidhi, havana kutevera Adhoniya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.8",
            "verseOrgIds": [
              "1KI.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adhoniya akabayira makwai, mombe nemhuru dzakakodzwa paDombo reZohereti, pedyo nepaEnirogeri. Akakoka vakoma navanunʼuna vake vose, vanakomana vamambo, navarume vose veJudha vaiva vakuru vakuru,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.9",
            "verseOrgIds": [
              "1KI.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi haana kukoka Natani muprofita, kana Bhenaya, kana mauto apamusoro, kana Soromoni mununʼuna wake.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.10",
            "verseOrgIds": [
              "1KI.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Natani akabvunza Bhatishebha, mai vaSoromoni akati, \"Hauna kunzwa here kuti Adhoniya, mwanakomana waHagiti, atova mambo ishe wedu Dhavhidhi asingazvizivi?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.11",
            "verseOrgIds": [
              "1KI.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino chirega ndikubayire zanhi kuti uponese upenyu hwako noupenyu hwomwanakomana wako Soromoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.12",
            "verseOrgIds": [
              "1KI.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chitoenda izvozvi kuna mambo Dhavhidhi unoti kwaari, 'Ishe wangu mambo, hamuna kupikira ini murandakadzi wenyu here muchiti, \"Zvirokwazvo Soromoni mwanakomana wako ndiye achanditevera paumambo, uye ndiye achagara pachigaro changu choushe?\" Zvino Adhoniya ava mambo sei?'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.13",
            "verseOrgIds": [
              "1KI.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino iwe paunenge uchiri kutaura namambo, ini ndichapindawo ndichisimbisa zvaunenge wataura.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.14",
            "verseOrgIds": [
              "1KI.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo, Bhatishebha akaenda kundoona mambo mumba make. Mambo akanga akwegura kwazvo, uye Abhishagi muShunami akanga achimushandira.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.15",
            "verseOrgIds": [
              "1KI.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhatishebha akakotama, akapfugama pamberi pamambo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.16",
            "verseOrgIds": [
              "1KI.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 1:16"
      },
      "items": [
        {
          "text": "Mambo akati, \"Unodeiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.16",
            "verseOrgIds": [
              "1KI.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akati kwaari, \"Ishe wangu, makapikira muranda wenyu naJehovha Mwari wenyu mukati, 'Soromoni mwanakomana wako ndiye achatevera paumambo, ndiye achagara pachigaro changu choushe.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.17",
            "verseOrgIds": [
              "1KI.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi zvino Adhoniya ava mambo, kunyange imi musingazvizivi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.18",
            "verseOrgIds": [
              "1KI.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayira mombe dzakawanda, mhuru dzakakodzwa, namakwai, uye akoka vanakomana vose vamambo, Abhiatari muprista naJoabhu mutungamiri wamauto, asi haana kukoka Soromoni muranda wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.19",
            "verseOrgIds": [
              "1KI.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino ishe wangu mambo, meso eIsraeri yose akatarisa kwamuri, kuti muvaudze kuti ndiani achagara pachigaro choushe chaishe wangu mambo, mushure make.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.20",
            "verseOrgIds": [
              "1KI.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana musina kudaro, kana ishe wangu mambo aradzikwa namadzibaba ake, ini nomwanakomana wangu Soromoni tichanzi tine mhosva.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.21",
            "verseOrgIds": [
              "1KI.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achiri kutaura namambo, Natani muprofita akabva asvika.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.22",
            "verseOrgIds": [
              "1KI.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino vakaudza mambo kuti, \"Natani muprofita ari pano.\" Naizvozvo akaenda pamberi pamambo, akakotamisa uso hwake pasi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.23",
            "verseOrgIds": [
              "1KI.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natani akati, \"Ishe wangu, mambo wangu, mareva here kuti Adhoniya ndiye achava mambo mushure menyu, uye kuti ndiye achagara pachigaro chenyu choushe?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.24",
            "verseOrgIds": [
              "1KI.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nhasi aburuka akandobayira mombe dzakawanda, mhuru dzakakodzwa, namakwai. Akoka vanakomana vose vamambo, vatungamiri vamauto naAbhiatari muprista. Izvozvi vari kudya nokunwa naye vachiti, 'Mambo Adhoniya ngaararame makore akawanda!'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.25",
            "verseOrgIds": [
              "1KI.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi haana kukoka ini muranda wenyu naZadhoki muprista, naBhenaya mwanakomana waJehoyadha, nomuranda wenyu Soromoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.26",
            "verseOrgIds": [
              "1KI.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi ndizvo here zvaitwa naishe wangu mambo vasina kuudza varanda vavo kuti ndiani achagara pachigaro choushe chaishe mambo wangu mushure mavo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.27",
            "verseOrgIds": [
              "1KI.1.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhavhidhi anogadza Soromoni Umambo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mambo Dhavhidhi akati, \"Ndidanirei Bhatishebha.\" Naizvozvo iye akauya kuna mambo akamira pamberi pake.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.28",
            "verseOrgIds": [
              "1KI.1.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino mambo akapika akati, \"NaJehovha mupenyu, uyo akandinunura pamatambudziko ose,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.29",
            "verseOrgIds": [
              "1KI.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "zvirokwazvo, nhasi ndichazadzisa zvandakakupikira naJehovha, Mwari waIsraeri kuti, 'Mwanakomana wako Soromoni achanditevera paumambo, uye achagara pachigaro changu choushe panzvimbo pangu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.30",
            "verseOrgIds": [
              "1KI.1.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Bhatishebha akakotama pasi nechiso chake akapfugamira mambo akati, \"Ishe wangu, Mambo Dhavhidhi, ngaararame nokusingaperi!\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.31",
            "verseOrgIds": [
              "1KI.1.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo Dhavhidhi akati, \"Ndidanirei Zadhoki muprista, Natani muprofita naBhenaya mwanakomana waJehoyadha.\" Vakati vauya pamberi pamambo,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.32",
            "verseOrgIds": [
              "1KI.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "akati kwavari, \"Endai navaranda vaishe, mutasvise Soromoni mwanakomana wangu panyurusi rangu chairo mugoenda naye zasi kuGihoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.33",
            "verseOrgIds": [
              "1KI.1.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikoko, Zadhoki muprista naNatani muprofita ngavamuzodze kuti ave mambo weIsraeri. Muridze hwamanda mugodanidzira muchiti, 'Mambo Soromoni ngaararame makore akawanda!'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.34",
            "verseOrgIds": [
              "1KI.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino imi muchauya muchimutevera, kuti iye auye azogara pachigaro changu choushe, nokuti achava mambo panzvimbo pangu, uye ndamugadza kuti ave mutongi weIsraeri neJudha.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.35",
            "verseOrgIds": [
              "1KI.1.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhenaya mwanakomana waJehoyadha akapindura mambo akati, \"Ameni! Jehovha, Mwari waishe mambo wangu, ngaadarowo!",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.36",
            "verseOrgIds": [
              "1KI.1.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 1:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha sezvaaiva naishe wangu mambo, saizvozvowo ngaave naSoromoni, aite kuti chigaro chake choushe chive chikuru kupfuura chigaro choushe chaishe wangu Mambo Dhavhidhi!\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.37",
            "verseOrgIds": [
              "1KI.1.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo Zadhoki muprista, Natani muprofita, Bhenaya mwanakomana waJehoyadha, vaKereti navaPereti vakadzika, vakatasvisa Soromoni panyurusi raMambo Dhavhidhi, vakamutungamirira kuenda kuGihoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.38",
            "verseOrgIds": [
              "1KI.1.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 1:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zadhoki muprista akatora gonamombe ramafuta mutende akazodza Soromoni. Ipapo vakaridza hwamanda vanhu vose vakadanidzira vachiti, \"Mambo Soromoni ngaararame makore akawanda!\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.39",
            "verseOrgIds": [
              "1KI.1.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino vanhu vose vakamutevera vachiridza mabhosvo vachipembera zvikuru zvokuti pasi pakatinhira noruzha rwavo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.40",
            "verseOrgIds": [
              "1KI.1.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adhoniya navose vaakanga akoka, vaakanga anavo, vakazvinzwa pavakanga vopedza kudya, Joabhu akati achinzwa ruzha rwehwamanda, akabvunza, akati, \"Mheremhere yose iyi muguta ndeyeiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.41",
            "verseOrgIds": [
              "1KI.1.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achiri kutaura kudaro, Jonatani, mwanakomana waAbhiatari muprista, akasvika. Adhoniya akati, \"Pinda! Murume akatendeka sewe anofanira kunge achiuya namashoko akanaka.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.42",
            "verseOrgIds": [
              "1KI.1.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 1:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonatani akapindura akati, \"Kwete, kwete! Ishe wedu Mambo Dhavhidhi agadza Soromoni paumambo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.43",
            "verseOrgIds": [
              "1KI.1.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo amutuma naZadhoki muprista, Natani muprofita, Bhenaya mwanakomana waJehoyadha, vaKereti navaPereti, uye vamutasvisa nyurusi ramambo,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.44",
            "verseOrgIds": [
              "1KI.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1KI 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye Zadhoki muprista naNatani muprofita vamuzodza kuti ave mambo paGihoni. Vabva ikoko vachipembera, zvokuti guta rose rangova zhowezhowe. Ndiyo mheremhere yamuri kunzwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.45",
            "verseOrgIds": [
              "1KI.1.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 1:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamusoro paizvozvo, Soromoni agara pachigaro choushe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.46",
            "verseOrgIds": [
              "1KI.1.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1KI 1:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyezve, machinda amambo auya kuzokorokotedza ishe wedu Mambo Dhavhidhi achiti, 'Mwari wenyu ngaaite kuti zita raSoromoni rive nomukurumbira kupfuura renyu, uye chigaro chake choushe ngachive chakakura kupfuura chenyu!' Zvino mambo akotama pamubhedha pake akanamata,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.47",
            "verseOrgIds": [
              "1KI.1.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1KI 1:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "akati, 'Jehovha, Mwari waIsraeri, ngaarumbidzwe, iye anditendera kuti ndione mumwe wavana vangu achigara pachigaro changu choushe nhasi.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.48",
            "verseOrgIds": [
              "1KI.1.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1KI 1:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino vose vakanga vakokwa naAdhoniya vakabatwa nokutya vakasimuka vakati uyu ananga kwake, uyu ananga kwake.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.49",
            "verseOrgIds": [
              "1KI.1.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1KI 1:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Adhoniya akatya Soromoni, akasimuka akaenda kundobata nyanga dzearitari.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.50",
            "verseOrgIds": [
              "1KI.1.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1KI 1:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soromoni akaudzwa kuti, \"Tarirai, Adhoniya ari kutya Mambo uye atobata nyanga dzearitari achiti, 'Mambo Soromoni ngaandipikire nhasi kuti haasi kuzouraya muranda wake nomunondo.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.51",
            "verseOrgIds": [
              "1KI.1.51"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1KI 1:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Soromoni akati, \"Kana akazova munhu kwaye, hakuna rubvudzi rwomusoro wake ruchawira pasi; asi zvakaipa zvikawanikwa maari, achafa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.52",
            "verseOrgIds": [
              "1KI.1.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "1KI 1:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mambo Soromoni akatuma varume vakandouya naye kubva paaritari. Zvino Adhoniya akauya akakotamira Mambo Soromoni, Soromoni akati kwaari, \"Enda kumba kwako.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.53",
            "verseOrgIds": [
              "1KI.1.53"
            ]
          }
        }
      ]
    }
  ],
