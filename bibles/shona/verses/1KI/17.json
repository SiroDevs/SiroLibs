  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "1KI 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eria muTishibhi anopiwa kudya namakunguo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Eria muTishibhi aigara muGireadhi, akati kuna Ahabhu, \"NaJehovha, Mwari waIsraeri mupenyu, wandinoshumira, hakuchazova nedova kana mvura inonaya mumakore anotevera kunze kwokutenge ndareva ini.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.1",
            "verseOrgIds": [
              "1KI.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo shoko raJehovha rakasvika kuna Eria richiti,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.2",
            "verseOrgIds": [
              "1KI.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ibva pano, nanga kumabvazuva undovanda paRukova rweKeriti, kumabvazuva kweJorodhani.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.3",
            "verseOrgIds": [
              "1KI.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uchanwa mvura yorukova urwu, uye ndarayira makunguo kuti akupe zvokudya ikoko.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.4",
            "verseOrgIds": [
              "1KI.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka akaita zvaakanga audzwa naJehovha. Akaenda kuRukova rweKeriti, kumabvazuva kweJorodhani, akagarako.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.5",
            "verseOrgIds": [
              "1KI.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makunguo akamuvigira chingwa nenyama mangwanani, nechingwa nenyama manheru, uye akanwa mvura murukova.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.6",
            "verseOrgIds": [
              "1KI.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chirikadzi yaigara paZarefati",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure menguva yakati, rukova rwakapwa nokuti mvura yakanga isinganayi panyika.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.7",
            "verseOrgIds": [
              "1KI.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino shoko raJehovha rakauya kwaari richiti,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.8",
            "verseOrgIds": [
              "1KI.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Simuka izvozvi uende kuZarefati kunyika yeSidhoni undogarako. Ndarayira chirikadzi iri munzvimbo iyoyo kuti ikupe zvokudya.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.9",
            "verseOrgIds": [
              "1KI.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo akaenda kuZarefati. Paakasvika pasuo reguta, chirikadzi yakanga iripo ichitsvaga huni. Akamudana akamubvunza akati, \"Mungandivigirawo mvura shoma shoma mumukombe here kuti ndinwe?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.10",
            "verseOrgIds": [
              "1KI.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paakanga ava kuenda kundoitora, iye akadanidzira akati, \"Mundivigirewo chimedu chechingwa, ndapota.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.11",
            "verseOrgIds": [
              "1KI.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akapindura akati, \"Zvirokwazvo naJehovha Mwari wenyu mupenyu, handina chingwa. Ndinongova netufurawu tushoma shoma muhari namafuta mashoma shoma muhari. Ndiri kunhonga huni shoma shoma kuti ndiende nadzo kumba ndinozvibikira kudya ini nomwanakomana wangu, kuti tigodya, tife hedu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.12",
            "verseOrgIds": [
              "1KI.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eria akati kwaari, \"Usatya. Enda kumba undoita sezvawareva. Asi tanga wandibikira chingwa chiduku pane zvaunazvo ugouya nacho kwandiri, mushure ugozvigadzirira iwe nomwanakomana wako.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.13",
            "verseOrgIds": [
              "1KI.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti zvanzi naJehovha, Mwari waIsraeri, 'Furawu iri muhari imomo haizoperi uye mafuta ari muhari haazoperi kusvikira zuva iro richanayiswa mvura panyika naJehovha.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.14",
            "verseOrgIds": [
              "1KI.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaenda akandoita sezvaakanga audzwa naEria. Saka zvokudya zvaEria zvakavapo mazuva ose uyewo nezvomukadzi nemhuri yake.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.15",
            "verseOrgIds": [
              "1KI.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Furawu yaiva muhari haina kupera uye mafuta aiva muhari haana kupera, sezvazvakanga zvarehwa neshoko raJehovha rakataurwa naEria.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.16",
            "verseOrgIds": [
              "1KI.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwapera nguva yakati, mwanakomana womukadzi, muridzi weimba, akarwara. Kurwara kwake kwakanyanya kwazvo, pakupedzisira akamira kufema.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.17",
            "verseOrgIds": [
              "1KI.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukadzi akati kuna Eria, \"Ndakakutadzireiko, munhu waMwari? Wakauya here kuzondirangaridza chivi changu nokuuraya mwanakomana wangu?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.18",
            "verseOrgIds": [
              "1KI.17.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eria akapindura akati, \"Ndipe mwanakomana wako kuno.\" Akamutora kubva mumaoko ake, akamutakura akaenda naye kuimba yapamusoro yaaigara, akamuradzika pamubhedha wake.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.19",
            "verseOrgIds": [
              "1KI.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akadanidzira kuna Jehovha akati, \"Haiwa, Jehovha Mwari wangu, mauyisawo here dambudziko pachirikadzi iyi yandiri kugara nayo, nokuuraya mwanakomana wayo?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.20",
            "verseOrgIds": [
              "1KI.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akazvambarara pamusoro pomukomana katatu akadanidzira kuna Jehovha akati, \"Haiwa Jehovha Mwari wangu, itai kuti mweya womukomana uyu udzokere maari!\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.21",
            "verseOrgIds": [
              "1KI.17.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akanzwa kudanidzira kwaEria, mweya womukomana ukadzokera maari, akararama.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.22",
            "verseOrgIds": [
              "1KI.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eria akatora mwana akamutakura achibuda mumba maakanga ari akaenda naye mumba huru. Akamupa kuna mai vake akati, \"Tarirai, mwanakomana wenyu mupenyu!\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.23",
            "verseOrgIds": [
              "1KI.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mukadzi akati kuna Eria, \"Zvino ndazoziva kuti muri munhu waMwari uye kuti shoko raJehovha rinobuda mumuromo menyu nderechokwadi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.24",
            "verseOrgIds": [
              "1KI.17.24"
            ]
          }
        }
      ]
    }
  ],
