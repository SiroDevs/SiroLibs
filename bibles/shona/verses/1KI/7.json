  "verseCount": 51,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "1KI 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Soromoni anovaka Muzinda Wake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvisinei, zvakatorera Soromoni makore gumi namatatu kuti apedze kuvaka muzinda wake.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.1",
            "verseOrgIds": [
              "1KI.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akavaka Muzinda weSango reRebhanoni wakanga wakareba makubhiti zana",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.2",
            "verseOrgIds": [
              "1KI.7.2"
            ]
          }
        },
        {
          "text": ", upamhi hwawo huri makubhiti makumi mashanu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.2",
            "verseOrgIds": [
              "1KI.7.2"
            ]
          }
        },
        {
          "text": ", namakubhiti makumi matatu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.2",
            "verseOrgIds": [
              "1KI.7.2"
            ]
          }
        },
        {
          "text": "pakukwirira kwawo mudenga, akaivaka pamusoro pemitsara mina yembiru dzemisidhari namatanda emisidhari akavezwa pamusoro pembiru.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.2",
            "verseOrgIds": [
              "1KI.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakanga une denga remisidhari rakanga riri pamusoro pamatanda akanga akagadzikwa pamusoro pembiru yamatanda makumi mana namashanu, gumi namashanu mumutsara mumwe chete.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.3",
            "verseOrgIds": [
              "1KI.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawindo awo akanga ari pamusoro, ari matatu, akatarisana.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.4",
            "verseOrgIds": [
              "1KI.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makonhi ose namagwatidziro zvaiva namativi mana; akanga ari nechemberi ari matatu matatu, akatarisana.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.5",
            "verseOrgIds": [
              "1KI.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaita imba yembiru yakanga yakareba makubhiti makumi mashanu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.6",
            "verseOrgIds": [
              "1KI.7.6"
            ]
          }
        },
        {
          "text": "iine upamhi hwamakubhiti makumi matatu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.6",
            "verseOrgIds": [
              "1KI.7.6"
            ]
          }
        },
        {
          "text": ". Pamberi payo paiva nebiravira, pamberi parowo paine mbiru nedenga rakarembera.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.6",
            "verseOrgIds": [
              "1KI.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akavakawo imba yechigaro chokutonga, Imba Yokururamisira, umo maaizotongera nyaya, uye akaifukidza nemisidhari kubva pasi kusvikira kumusoro.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.7",
            "verseOrgIds": [
              "1KI.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muzinda wake waaizogara necheseri, wakanga wakavakwa zvimwe chetezvo. Soromoni akavakirawo mwanasikana waFaro, uyo waakanga awana, muzinda wakafanana nouyu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.8",
            "verseOrgIds": [
              "1KI.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzimba dzose idzi, kubva kunze kusvikira kuchivanze chikuru, nokubva pahwaro kusvikira paberevere, dzakanga dziri dzamatombo anokosha, akavezwa zvakaenzanirana, uye akachekwa nejeko kunze nomukati.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.9",
            "verseOrgIds": [
              "1KI.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hwaro hwakanga hwakavakwa namatombo makuru anokosha, mamwe akareba makubhiti gumi",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.10",
            "verseOrgIds": [
              "1KI.7.10"
            ]
          }
        },
        {
          "text": ", mamwe makubhiti masere",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.10",
            "verseOrgIds": [
              "1KI.7.10"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.10",
            "verseOrgIds": [
              "1KI.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamusoro paiva namatombo anokosha, akavezwa zvakaenzanirana, namatanda emisidhari.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.11",
            "verseOrgIds": [
              "1KI.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chivanze chikuru chaiva chakapoteredzwa norusvingo rwakanga rune mitsara mitatu yamatombo akavezwa nomutsara mumwe chete wamatanda omusidhari akanyatsovezwa, zvimwe chetezvo zvakanga zvakaita chivanze chomukati chetemberi yaJehovha nebiravira rayo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.12",
            "verseOrgIds": [
              "1KI.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Midziyo yomuTemberi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Mambo Soromoni akatuma vanhu kundotora Hiramu kuTire.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.13",
            "verseOrgIds": [
              "1KI.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiramu aiva mwanakomana wechirikadzi yorudzi rwaNafutari, baba vake vari veTire, mupfuri wendarira. Hiramu akanga azere nounyanzvi, uye aino ruzivo rwezvamabasa ose endarira. Akauya kuna Mambo Soromoni akaita basa rose raakapiwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.14",
            "verseOrgIds": [
              "1KI.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akavaka mbiru mbiri dzendarira, imwe neimwe yakanga yakareba makubhiti gumi namasere",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.15",
            "verseOrgIds": [
              "1KI.7.15"
            ]
          }
        },
        {
          "text": ", uye yaipoteredzwa netambo yakareba makubhiti gumi namaviri",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.15",
            "verseOrgIds": [
              "1KI.7.15"
            ]
          }
        },
        {
          "text": "pakuyera.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.15",
            "verseOrgIds": [
              "1KI.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaitawo misoro yembiru yendarira yakanyungurutswa miviri, yokugadzika pamusoro pembiru, musoro mumwe nomumwe wakanga wakareba makubhiti mashanu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.16",
            "verseOrgIds": [
              "1KI.7.16"
            ]
          }
        },
        {
          "text": "pakukwirira kwawo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.16",
            "verseOrgIds": [
              "1KI.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mimbure yengetani dzakarukwa yaiva yakashongedza misoro yaiva pamusoro pembiru, minomwe pamusoro pomumwe nomumwe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.17",
            "verseOrgIds": [
              "1KI.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaitawo matamba mumitsara miviri yakapoteredza mumbure mumwe nomumwe kuti ishongedze misoro yaiva pamusoro pembiru. Akaita zvimwe chetezvo pamusoro pomumwe nomumwe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.18",
            "verseOrgIds": [
              "1KI.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Misoro yaiva pamusoro pembiru pabiravira yakanga yakaumbwa samaruva amahapa, yakareba makubhiti mana",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.19",
            "verseOrgIds": [
              "1KI.7.19"
            ]
          }
        },
        {
          "text": "pakukwirira kwayo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.19",
            "verseOrgIds": [
              "1KI.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamusoro pemisoro yembiru mbiri idzi, nechapamusoro pedumbu rakanga riri parutivi pomumbure, paiva namatamba mazana maviri mumitsara yakapoteredza.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.20",
            "verseOrgIds": [
              "1KI.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamisa mbiru pabiravira retemberi. Mbiru yezasi akaitumidza zita rokuti Jakini uye yokumusoro akaitumidza kuti Bhoazi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.21",
            "verseOrgIds": [
              "1KI.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamusoro pembiru paiva nezvishongo zvakafanana namaruva amahapa. Saizvozvo basa rapambiru rakapera.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.22",
            "verseOrgIds": [
              "1KI.7.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaita Gungwa reNdarira yakanyauswa, redenderedzwa rakanga rine upamhi hwamakubhiti gumi",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.23",
            "verseOrgIds": [
              "1KI.7.23"
            ]
          }
        },
        {
          "text": "pamuromo, uye rakareba makubhiti mashanu pakukwirira kwaro. Zvaitora tambo yakareba makubhiti makumi matatu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.23",
            "verseOrgIds": [
              "1KI.7.23"
            ]
          }
        },
        {
          "text": "kuti iripoteredze pakuyera.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.23",
            "verseOrgIds": [
              "1KI.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pasi pomuromo waro pakanga pane mapfundo akapoteredza, ari gumi pakubhiti, achipoteredza gungwa. Mapfundo aya akaumbwa akanga ari mumitsara miviri, pamwe chete neGungwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.24",
            "verseOrgIds": [
              "1KI.7.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gungwa rakanga rimire pahando gumi nembiri, nhatu dzakatarisa kumusoro, nhatu kumadokero, nhatu zasi nenhatu kumabvazuva. Gungwa rakanga rigere pamusoro padzo, uye shure kwadzo kwakanga kwakatarisa pakati.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.25",
            "verseOrgIds": [
              "1KI.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukobvu hwaro hwaikwana upamhi hwechanza chomunhu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.26",
            "verseOrgIds": [
              "1KI.7.26"
            ]
          }
        },
        {
          "text": ", uye muromo waro wakanga wakafanana nomuromo wekapu, seruva ramahapa. Mukati maro maikwana mabhati zviuru zviviri",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.26",
            "verseOrgIds": [
              "1KI.7.26"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.26",
            "verseOrgIds": [
              "1KI.7.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaitawo zvigadziko gumi zvendarira zvaiva namavhiri endarira gumi; chimwe nechimwe chakanga chakareba makubhiti mana",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.27",
            "verseOrgIds": [
              "1KI.7.27"
            ]
          }
        },
        {
          "text": ", upamhi huri makubhiti mana nokukwirira kwacho kuri makubhiti matatu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.27",
            "verseOrgIds": [
              "1KI.7.27"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.27",
            "verseOrgIds": [
              "1KI.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvigadziko izvi zvakanga zvakaitwa seizvi: pakati pembiru dzezvigadziko paiva namagwatidziro mumativi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.28",
            "verseOrgIds": [
              "1KI.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamagwatidziro aya pakati pembiru paiva neshumba, hando namakerubhi, uyewo napambiru. Pamusoro napasi peshumba nehando paiva nezvishongo zvamaruva zvendarira.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.29",
            "verseOrgIds": [
              "1KI.7.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chigadziko chimwe nechimwe chaiva namavhiri mana endarira ane maekesero endarira, uye imwe neimwe yaiva nedhishi rakanga riri pamusoro pezvitsigiro zvina, zvakaumbwa zviine zvishongo zvamaruva kurutivi rumwe norumwe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.30",
            "verseOrgIds": [
              "1KI.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nechomukati mechigadziko maiva negomba rakanga riri redenderedzwa rakadzika zvinosvika kubhiti rimwe chete",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.31",
            "verseOrgIds": [
              "1KI.7.31"
            ]
          }
        },
        {
          "text": ". Gomba iri rakanga riri redenderedzwa, uye nechigadziko charo raikwana kubhiti nehafu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.31",
            "verseOrgIds": [
              "1KI.7.31"
            ]
          }
        },
        {
          "text": ". Pamuromo paro paiva nezvinyorwa. Magwatidziro akanga ane mativi akaenzana, asiri edenderedzwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.31",
            "verseOrgIds": [
              "1KI.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mavhiri mana aiva pasi pamagwatidziro, uye maekesero amavhiri aiva akabatana netafura. Vhiri rimwe nerimwe raiva noupamhi hwekubhiti rimwe chete nehafu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.32",
            "verseOrgIds": [
              "1KI.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mavhiri akanga akagadzirwa sokugadzirwa kwamavhiri engoro dzamabhiza; maekesero, marimu, zvipokisi namahabhu zvose zvaiva zvakagadzirwa nendarira.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.33",
            "verseOrgIds": [
              "1KI.7.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chigadziko chimwe nechimwe chaiva nemibato mina, pakona imwe neimwe, uye yaibudikira kubva pachigadziko.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.34",
            "verseOrgIds": [
              "1KI.7.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamusoro pechigadziko paiva nechitenderere chakanga chakadzika zvinosvika hafu yekubhiti",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.35",
            "verseOrgIds": [
              "1KI.7.35"
            ]
          }
        },
        {
          "text": ". Zvitsigiro namagwatidziro zvakanga zvakanamatidzwa pamusoro pechigadziko.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.35",
            "verseOrgIds": [
              "1KI.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaveza makerubhi, shumba nemiti yemichindwe pazvitsigiro namagwatidziro, napose paigona kuvezwa, nezvishongo zvamaruva kumativi ose.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.36",
            "verseOrgIds": [
              "1KI.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya ndiwo magadziriro aakaita zvigadziko gumi. Zvose zvakanga zvakafanana pakuumbwa kwazvo, zvakaenzana pakukura napamaumbirwo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.37",
            "verseOrgIds": [
              "1KI.7.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akaita madhishi endarira gumi, rimwe nerimwe richipinda mabhati makumi mana",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.38",
            "verseOrgIds": [
              "1KI.7.38"
            ]
          }
        },
        {
          "text": "uye rakafara makubhiti mana, dhishi rimwe chete richizoiswa pachigadziko chimwe nechimwe chezvigadziko gumi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.38",
            "verseOrgIds": [
              "1KI.7.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 7:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaisa zvigadziko zvishanu zasi kwetemberi, zvishanu kumusoro. Akaisa Gungwa kurutivi rwezasi, zasi kwakadziva kumabvazuva kwetemberi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.39",
            "verseOrgIds": [
              "1KI.7.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiramu akaitawo poto, foshoro namadhishi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.40",
            "verseOrgIds": [
              "1KI.7.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 7:40"
      },
      "items": [
        {
          "text": "Saka Hiramu akapedza basa rose raakaitira Mambo Soromoni mutemberi yaJehovha:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.40",
            "verseOrgIds": [
              "1KI.7.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 7:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbiru mbiri;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.41",
            "verseOrgIds": [
              "1KI.7.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 7:41"
      },
      "items": [
        {
          "text": "misoro miviri yedenderedzwa pamusoro pembiru;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.41",
            "verseOrgIds": [
              "1KI.7.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 7:41"
      },
      "items": [
        {
          "text": "mimbure miviri yakarukwa yaishongedza misoro miviri yedenderedzwa yaiva pamusoro pembiru;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.41",
            "verseOrgIds": [
              "1KI.7.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 7:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "matamba mazana mana emimbure miviri (mitsara miviri yamatamba pamumbure mumwe chete, kuti ishongedze misoro yedenderedzwa yaiva pamusoro pembiru);",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.42",
            "verseOrgIds": [
              "1KI.7.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 7:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "zvigadziko gumi namadhishi azvo gumi;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.43",
            "verseOrgIds": [
              "1KI.7.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 7:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gungwa nehando gumi nembiri pasi paro;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.44",
            "verseOrgIds": [
              "1KI.7.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1KI 7:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "poto, foshoro namadhishi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.45",
            "verseOrgIds": [
              "1KI.7.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1KI 7:45"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 7:45"
      },
      "items": [
        {
          "text": "Zvinhu zvose izvi zvakaitirwa Mambo Soromoni mutemberi maJehovha naHiramu zvaiva zvendarira yakabwinyiswa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.45",
            "verseOrgIds": [
              "1KI.7.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 7:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akaita kuti zviumbwe nevhu rokuumba pabani reJorodhani pakati peSukoti neZaretani.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.46",
            "verseOrgIds": [
              "1KI.7.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1KI 7:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soromoni haana kuyera zvinhu zvose izvi nokuti zvakanga zvakawanda kwazvo; uremu hwendarira hahuna kuzivikanwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.47",
            "verseOrgIds": [
              "1KI.7.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1KI 7:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soromoni akaitawo midziyo yose yaiva mutemberi maJehovha:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.48",
            "verseOrgIds": [
              "1KI.7.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1KI 7:48"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 7:48"
      },
      "items": [
        {
          "text": "aritari yegoridhe;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.48",
            "verseOrgIds": [
              "1KI.7.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 7:48"
      },
      "items": [
        {
          "text": "tafura yegoridhe yaiva nechingwa choKuratidza, pamusoro payo;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.48",
            "verseOrgIds": [
              "1KI.7.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1KI 7:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "zvigadziko zvemwenje zvegoridhe rakaisvonaka (zvishanu kurudyi nezvishanu kuruboshwe pamberi penzvimbo tsvene yomukati);",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.49",
            "verseOrgIds": [
              "1KI.7.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 7:49"
      },
      "items": [
        {
          "text": "maruva, mwenje nembato, zvegoridhe;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.49",
            "verseOrgIds": [
              "1KI.7.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1KI 7:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "makapu, zvidzimiso zvemwenje, madhishi, madhishi ezvinonhuhwira nezvaenga zvomoto, zvegoridhe rakaisvonaka;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.50",
            "verseOrgIds": [
              "1KI.7.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
