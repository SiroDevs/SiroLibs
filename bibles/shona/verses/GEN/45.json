  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "45",
        "style": "c",
        "sid": "GEN 45"
      },
      "items": [
        {
          "text": "45",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Josefa Anozvizivisa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 45:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Josefa akanga asisagoni kuzvidzora pamberi pavashandiri vake vose, uye akadanidzira akati, \"Munhu wose ngaabve pamberi pangu!\" Saka pakanga pasisina mumwe munhu pana Josefa paakazvizivisa kuhama dzake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.1",
            "verseOrgIds": [
              "GEN.45.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 45:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye akachema zvikuru kwazvo zvokuti vaIjipita vakamunzwa, uye veimba yaFaro vakanzwa nezvazvo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.2",
            "verseOrgIds": [
              "GEN.45.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josefa akati kuhama dzake, \"Ndini Josefa! Ko, baba vangu vachiri vapenyu here?\" Asi hama dzake hadzina kugona kumupindura, nokuti vakanga vachitya pamberi pake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.3",
            "verseOrgIds": [
              "GEN.45.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 45:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Josefa akati kuhama dzake, \"Swederai henyu kwandiri.\" Vakati vaita izvozvo, akati, \"Ndini Josefa hama yenyu, wamakatengesa kuIjipiti!",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.4",
            "verseOrgIds": [
              "GEN.45.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 45:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye zvino, musatambudzika uye musazvitsamwira nokuda kwokuti makanditengesa kuno, nokuti Mwari akandituma mberi kwenyu kuti ndigoponesa upenyu hwavanhu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.5",
            "verseOrgIds": [
              "GEN.45.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 45:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti pava namakore maviri zvino nzara yava munyika, uye makore mashanu ari kutevera kuchange kusingarimwi kana kukohwewa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.6",
            "verseOrgIds": [
              "GEN.45.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 45:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Mwari akandituma mberi kwenyu kuti ndikuchengeterei vanosara panyika uye kuti ndiponese upenyu hwenyu nokusunungurwa kukuru.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.7",
            "verseOrgIds": [
              "GEN.45.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 45:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Saka zvino, hamusimi makandituma kuno, asi Mwari. Akandiita baba kuna Faro, ishe weimba yake yose nomutongi weIjipiti yose.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.8",
            "verseOrgIds": [
              "GEN.45.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 45:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino kurumidzai mudzokere kuna baba vangu mundoti kwavari, 'Zvanzi nomwanakomana wenyu Josefa: Mwari akandiita ishe weIjipiti yose. Burukai muuye kwandiri; musanonoka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.9",
            "verseOrgIds": [
              "GEN.45.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 45:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muchandogara munyika yeGosheni muve pedyo neni, imi, vana venyu navazukuru venyu, zvipfuwo zvenyu nemombe dzenyu nezvose zvamunazvo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.10",
            "verseOrgIds": [
              "GEN.45.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 45:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichakuriritirai ikoko, nokuti mamwe makore mashanu enzara ari kuuya. Kana zvikasadaro imi neveimba yenyu navose vamunavo mungazova varombo.'",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.11",
            "verseOrgIds": [
              "GEN.45.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 45:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Muri kuzvionera pachenyu, uye kana mununʼuna wangu uyu Bhenjamini, kuti ndini chaiye ari kutaura nemi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.12",
            "verseOrgIds": [
              "GEN.45.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 45:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muudze baba vangu pamusoro pokukudzwa kwangu muIjipiti uye napamusoro pezvinhu zvose zvamaona. Uye muuye nababa vangu kuno nokukurumidza.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.13",
            "verseOrgIds": [
              "GEN.45.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 45:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akawira pamutsipa womununʼuna wake Bhenjamini akachema, uye Bhenjamini akamumbundikirawo achichema.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.14",
            "verseOrgIds": [
              "GEN.45.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 45:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye akatsvoda madzikoma ake ose uye akachema pamusoro pavo. Shure kwaizvozvo, madzikoma ake akataura naye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.15",
            "verseOrgIds": [
              "GEN.45.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 45:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shoko rakati rasvika kumuzinda waFaro kuti madzikoma aJosefa akanga auya, Faro namachinda ake ose vakafara.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.16",
            "verseOrgIds": [
              "GEN.45.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 45:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faro akati kuna Josefa, \"Taurira hama dzako uti, 'Itai izvi: Takudzai zvipfuwo zvenyu mudzokere kunyika yeKenani,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.17",
            "verseOrgIds": [
              "GEN.45.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 45:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "mundouya nababa venyu uye nemhuri kuno kwandiri. Ndichakupai nyika yakaisvonaka yeIjipiti uye mugofara nezvakakora zvenyika.'",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.18",
            "verseOrgIds": [
              "GEN.45.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 45:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iwe unorayirwawo kuti uvaudze kuti, 'Itai izvi: Torerai vana navakadzi venyu dzimwe ngoro dzinobva muIjipiti uye mundotora baba venyu mugodzoka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.19",
            "verseOrgIds": [
              "GEN.45.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 45:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musafunganya henyu nezvenhumbi dzenyu, nokuti zvakaisvonaka zvose zveIjipiti zvichava zvenyu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.20",
            "verseOrgIds": [
              "GEN.45.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 45:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vanakomana vaIsraeri vakaita saizvozvo. Josefa akavapa ngoro, sezvakanga zvarayirwa naFaro, uye akavapawo mbuva yorwendo rwavo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.21",
            "verseOrgIds": [
              "GEN.45.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 45:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapa mumwe nomumwe wavo nguo itsva, asi akapa Bhenjamini mazana matatu amashekeri",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.22",
            "verseOrgIds": [
              "GEN.45.22"
            ]
          }
        },
        {
          "text": "esirivha nenguo shanu dzokupfeka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.22",
            "verseOrgIds": [
              "GEN.45.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 45:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye izvi ndizvo zvaakatumira kuna baba vake: Mbongoro hono gumi dzakanga dzakatakura zvinhu zvakaisvonaka zveIjipiti, nembongoro hadzi gumi dzakanga dzakatakura zviyo nechingwa nezvimwe zvembuva yorwendo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.23",
            "verseOrgIds": [
              "GEN.45.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 45:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akaendesa hama dzake uye pavakanga voenda akati kwavari, \"Musakakavadzana munzira!\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.24",
            "verseOrgIds": [
              "GEN.45.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 45:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakabuda muIjipiti uye vakaenda vakandosvika kuna baba vavo Jakobho kunyika yeKenani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.25",
            "verseOrgIds": [
              "GEN.45.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 45:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye vakati kwavari, \"Josefa mupenyu! Uye ndiye mutongi weIjipiti yose.\" Jakobho akati rukutu; haana kuvatenda.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.26",
            "verseOrgIds": [
              "GEN.45.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 45:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi pavakavaudza zvose zvakanga zvarehwa naJosefa kwavari, uye paakaona ngoro dzakanga dzatumirwa kwavari naJosefa kuti dzizovatakura, mweya wababa wavo Jakobho wakamutsiridzwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.27",
            "verseOrgIds": [
              "GEN.45.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 45:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Israeri akati, \"Ndagutsikana! Mwana wangu Josefa achiri mupenyu. Ndichaenda kundomuona ndisati ndafa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.28",
            "verseOrgIds": [
              "GEN.45.28"
            ]
          }
        }
      ]
    }
  ],
