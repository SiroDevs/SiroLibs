          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jerusarema, muzambiringa usina maturo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shoko raJehovha rakasvika kwandiri richiti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.1",
            "verseOrgIds": [
              "EZK.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mwanakomana womunhu, muti womuzambiringa uri nani kupfuura davi romuti zvawo musango neiko?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.2",
            "verseOrgIds": [
              "EZK.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, pane danda rakambotorwa pauri here kuti rigadziriswe chimwe chinhu chine basa? Ko, vanhu vangaita hoko nawo kuti vanhu vaturike zvinhu ipapo here?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.3",
            "verseOrgIds": [
              "EZK.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye shure kwokunge wakandwa mumoto sehuni uye moto ndokuupisa mativi ose ari maviri uye ndokusviba pakati, zvino uchabatsira chinhu here?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.4",
            "verseOrgIds": [
              "EZK.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana wanga usingabatsiri chinhu uchiri wakakwana, uchagobatsireiko kana moto waupisa uye wasviba?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.5",
            "verseOrgIds": [
              "EZK.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naizvozvo zvanzi naIshe Jehovha: Sezvo ndakaisa miti yemizambiringa pakati pemiti yesango sehuni dzomoto, ndizvo zvandichaita kuvanhu vagere muJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.6",
            "verseOrgIds": [
              "EZK.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndicharinzira chiso changu kwavari kuti ndivarwise. Kunyange zvavo vakabuda mumoto, moto uchavaparadza. Uye pandinorinzira chiso changu kwavari kuti ndivarwise muchaziva kuti ndini Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.7",
            "verseOrgIds": [
              "EZK.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichaparadza nyika nokuti vakanga vasina kutendeka, ndizvo zvinotaura Ishe Jehovha.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.8",
            "verseOrgIds": [
              "EZK.15.8"
            ]
          }
        }
      ]
    }
  ],
