              "type": "text"
            }
          ]
        },
        {
          "text": "Zvakanakisisa, zvezvibereko zvenyu zvokutanga nezvipo zvenyu zvose zvakatsaurwa zvichava zvavaprista. Munofanira kuvapa mugove wokutanga woupfu hwakakuyiwa kuitira kuti makomborero agogara paimba yenyu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.30",
            "verseOrgIds": [
              "EZK.44.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
