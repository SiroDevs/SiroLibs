          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaprista havafaniri kungodya zvinhu zvose, ingava shiri kana chipfuwo, chawanikwa chakafa kana chaurayiwa nezvikara zvesango.",
          "type": "text",
          "attrs": {
