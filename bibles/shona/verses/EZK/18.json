  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "EZK 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mweya unotadza uchafa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shoko raJehovha rakasvika kwandiri richiti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.1",
            "verseOrgIds": [
              "EZK.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Munoreveiko vanhu imi zvamunodzokorora tsumo iyi pamusoro penyika yeIsraeri, muchiti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.2",
            "verseOrgIds": [
              "EZK.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:2"
      },
      "items": [
        {
          "text": "\" 'Madzibaba akadya mazambiringa anovava,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.2",
            "verseOrgIds": [
              "EZK.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:2"
      },
      "items": [
        {
          "text": "meno avana akaita ugugu'?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.2",
            "verseOrgIds": [
              "EZK.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvirokwazvo noupenyu hwangu, ndizvo zvinotaura Jehovha, hamuchazodzokororizve tsumo iyi muIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.3",
            "verseOrgIds": [
              "EZK.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti mweya mupenyu mumwe nomumwe ndowangu, baba pamwe chete nomwanakomana vose saizvozvo ndevangu. Mweya unotadza ndiwo uchafa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.4",
            "verseOrgIds": [
              "EZK.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ngatiti pane munhu akarurama",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.5",
            "verseOrgIds": [
              "EZK.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:5"
      },
      "items": [
        {
          "text": "anoita zvinhu nokururamisira uye nokururama.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.5",
            "verseOrgIds": [
              "EZK.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haadyiri pashongwe dzezvifananidzo mumakomo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.6",
            "verseOrgIds": [
              "EZK.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:6"
      },
      "items": [
        {
          "text": "kana kutarira kuzvifananidzo zveimba yaIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.6",
            "verseOrgIds": [
              "EZK.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:6"
      },
      "items": [
        {
          "text": "Haasvibisi mukadzi womuvakidzani wake,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.6",
            "verseOrgIds": [
              "EZK.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:6"
      },
      "items": [
        {
          "text": "kana kuvata nomukadzi ari kumwedzi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.6",
            "verseOrgIds": [
              "EZK.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haamanikidzi mumwe munhu,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.7",
            "verseOrgIds": [
              "EZK.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:7"
      },
      "items": [
        {
          "text": "asi anodzorera rubatso rwaakatora pachikwereti.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.7",
            "verseOrgIds": [
              "EZK.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:7"
      },
      "items": [
        {
          "text": "Haaiti zvougororo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.7",
            "verseOrgIds": [
              "EZK.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:7"
      },
      "items": [
        {
          "text": "asi anopa zvokudya zvake kune vane nzara",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.7",
            "verseOrgIds": [
              "EZK.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:7"
      },
      "items": [
        {
          "text": "uye anopfekedza vakashama.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.7",
            "verseOrgIds": [
              "EZK.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haarevi chimbadzo paanokweretesa",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.8",
            "verseOrgIds": [
              "EZK.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:8"
      },
      "items": [
        {
          "text": "kana kutora mhindu yakakurisa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.8",
            "verseOrgIds": [
              "EZK.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:8"
      },
      "items": [
        {
          "text": "Anodzivisa ruoko rwake kuita zvakaipa,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.8",
            "verseOrgIds": [
              "EZK.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:8"
      },
      "items": [
        {
          "text": "uye anotonga zvakarurama pakati pomunhu nomunhu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.8",
            "verseOrgIds": [
              "EZK.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anotevera mitemo yangu,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.9",
            "verseOrgIds": [
              "EZK.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:9"
      },
      "items": [
        {
          "text": "uye akatendeka pakuchengeta mirayiro yangu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.9",
            "verseOrgIds": [
              "EZK.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:9"
      },
      "items": [
        {
          "text": "Munhu uyo akarurama;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.9",
            "verseOrgIds": [
              "EZK.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:9"
      },
      "items": [
        {
          "text": "zvirokwazvo achararama,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.9",
            "verseOrgIds": [
              "EZK.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "EZK 18:9"
      },
      "items": [
        {
          "text": "ndizvo zvinotaura Ishe Jehovha.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ngatiti ane mwanakomana anoita zvechisimba, anoteura ropa kana chimwe chezvinhu izvi",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.10",
            "verseOrgIds": [
              "EZK.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "(kunyange baba vake vasina kumboita chimwe chazvo):",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.11",
            "verseOrgIds": [
              "EZK.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:11"
      },
      "items": [
        {
          "text": "\"Anodya pashongwe dzezvifananidzo mumakomo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.11",
            "verseOrgIds": [
              "EZK.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:11"
      },
      "items": [
        {
          "text": "Anochinya mukadzi womuvakidzani wake.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.11",
            "verseOrgIds": [
              "EZK.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anomanikidza varombo navanoshayiwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.12",
            "verseOrgIds": [
              "EZK.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:12"
      },
      "items": [
        {
          "text": "Anoita zvougororo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.12",
            "verseOrgIds": [
              "EZK.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:12"
      },
      "items": [
        {
          "text": "Haadzoreri zvaakakwereta.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.12",
            "verseOrgIds": [
              "EZK.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:12"
      },
      "items": [
        {
          "text": "Anotarisira kuzvifananidzo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.12",
            "verseOrgIds": [
              "EZK.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:12"
      },
      "items": [
        {
          "text": "Anoita zvinonyangadza.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.12",
            "verseOrgIds": [
              "EZK.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anokweretesa achireva chimbadzo uye anotora mhindu yakakura.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.13",
            "verseOrgIds": [
              "EZK.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "EZK 18:13"
      },
      "items": [
        {
          "text": "Munhu akadaro achararama here? Kwete, haangararami! Nokuda kwokuti akaita zvinhu izvi zvinonyangadza, achafa, zvirokwazvo, uye ropa rake richava pamusoro pake.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.13",
            "verseOrgIds": [
              "EZK.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asi ngatimboti, mwanakomana uyu ane mwanakomana anoona zvivi zvose zvinoitwa nababa vake, uye kunyange achivaona, haaiti zvinhu zvakadai:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.14",
            "verseOrgIds": [
              "EZK.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Haadyi pashongwe dzamakomo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.15",
            "verseOrgIds": [
              "EZK.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:15"
      },
      "items": [
        {
          "text": "kana kutarisira kuzvifananidzo zveimba yaIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.15",
            "verseOrgIds": [
              "EZK.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:15"
      },
      "items": [
        {
          "text": "Haachinyi mukadzi womuvakidzani wake.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.15",
            "verseOrgIds": [
              "EZK.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haamanikidzi munhu upi zvake",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.16",
            "verseOrgIds": [
              "EZK.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:16"
      },
      "items": [
        {
          "text": "kana kureva rubatso pachikwereti.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.16",
            "verseOrgIds": [
              "EZK.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:16"
      },
      "items": [
        {
          "text": "Haaiti ugororo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.16",
            "verseOrgIds": [
              "EZK.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:16"
      },
      "items": [
        {
          "text": "asi anopa zvokudya zvake kuna vaya vane nzara,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.16",
            "verseOrgIds": [
              "EZK.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:16"
      },
      "items": [
        {
          "text": "uye anopfekedza vanoshaya zvipfeko.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.16",
            "verseOrgIds": [
              "EZK.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anodzivisa ruoko rwake kutadza",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.17",
            "verseOrgIds": [
              "EZK.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 18:17"
      },
      "items": [
        {
          "text": "uye haarevi chimbadzo kana mhindu yakakura.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.17",
            "verseOrgIds": [
              "EZK.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 18:17"
      },
      "items": [
        {
          "text": "Anochengeta mirayiro yangu nokutevera mitemo yangu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.17",
            "verseOrgIds": [
              "EZK.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "EZK 18:17"
      },
      "items": [
        {
          "text": "Haangafi nokuda kwechivi chababa vake; zvirokwazvo achararama.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.17",
            "verseOrgIds": [
              "EZK.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi baba vake vachafa nokuda kwechivi chavo, nokuti vaiita zvinhu nokumanikidza, vakapamba mununʼuna wavo uye vakaita zvakaipa pakati pavanhu vavo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.18",
            "verseOrgIds": [
              "EZK.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kunyange zvakadaro munobvunza muchiti, 'Mwanakomana anoregereiko kuva nemhosva yezvakaipa zvababa vake?' Sezvo mwanakomana akaita nokururamisira uye nokururama uye kuti akanga akangwaririra kuchengeta mitemo yangu, iye achararama zvirokwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.19",
            "verseOrgIds": [
              "EZK.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mweya unotadza ndiwo uchafa. Mwanakomana haangagovani nababa vake pamhosva yavo, uye baba havangagovani mhosva yavo nomwanakomana. Kururama kwowakarurama kuchava pamusoro pake, uye kuipa kwowakaipa kuchava pamusoro powakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.20",
            "verseOrgIds": [
              "EZK.18.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asi kana akaipa akatendeuka kubva pazvivi zvaakaita uye akachengeta mitemo yangu, akaita nokururamisira uye nokururama, zvirokwazvo achararama; haangafi zvirokwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.21",
            "verseOrgIds": [
              "EZK.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudarika kwake kwose kwaakaita hakungarangarirwi. Nokuda kwezvinhu zvakarurama zvaakaita, iye achararama.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.22",
            "verseOrgIds": [
              "EZK.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, ndingafarira rufu rwowakaipa here? Ndizvo zvinotaura Ishe Jehovha. Asi handifari here pavanotendeuka kubva panzira dzavo kuti vararame?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.23",
            "verseOrgIds": [
              "EZK.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asi kana munhu akarurama akatsauka pakururama kwake akaita chivi uye akaitawo zvinonyangadza zvinoitwa nomunhu akaipa, angararama here? Zvakarurama zvaakaita hazvizorangarirwi. Nokuda kwemhosva yokusatendeuka kwaanako uye nokuda kwezvivi zvaakaita, iye achafa zvirokwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.24",
            "verseOrgIds": [
              "EZK.18.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asi munoti, 'Nzira yaJehovha haina kururama.' Haiwa imi imba yaIsraeri: Nzira yangu haina kururama here? Ko, hadzisi nzira dzenyu imi dzisakarurama here?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.25",
            "verseOrgIds": [
              "EZK.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana munhu akarurama akatsauka akaita chivi, achafa nokuda kwechivi chake; nokuda kwechivi chaakaita achafa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.26",
            "verseOrgIds": [
              "EZK.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana munhu akaipa akadzoka pane zvakaipa zvake zvaakaita akaita zvakarurama nokururamisira, achaponesa mweya wake.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.27",
            "verseOrgIds": [
              "EZK.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti anorangarira kudarika kwake kwose kwaakaita uye anotendeuka kubva panzira dzake, zvirokwazvo achararama; haangafi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.28",
            "verseOrgIds": [
              "EZK.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi imba yaIsraeri inoti, 'Nzira yaJehovha haina kururama.' Nzira dzangu hadzina kururama here, imi imba yaIsraeri? Ko, hadzisi nzira dzenyu dzisakarurama here?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.29",
            "verseOrgIds": [
              "EZK.18.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naizvozvo, imi imba yaIsraeri, ndichakutongai, mumwe nomumwe zvakafanira nzira dzake, ndizvo zvinotaura Ishe Jehovha. Tendeukai! Dzokai pakudarika kwenyu kwose; ipapo chivi hachingakuwisirei pasi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.30",
            "verseOrgIds": [
              "EZK.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rasai kudarika kwenyu kwamakaita, mufuke mwoyo mutsva nomweya mutsva. Ko, muchafirei, imi imba yaIsraeri?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.31",
            "verseOrgIds": [
              "EZK.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti handifariri rufu rwomunhu upi zvake, ndizvo zvinotaura Ishe Jehovha. Tendeukai murarame!",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.32",
            "verseOrgIds": [
              "EZK.18.32"
            ]
          }
        }
      ]
    }
  ],
