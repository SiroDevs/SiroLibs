  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "EZK 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vanonamata Zvifananidzo vanourayiwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ndakamunzwa achidanidzira nenzwi guru achiti, \"Uya navarindi veguta pano, mumwe nomumwe ano munondo muruoko rwake.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.1",
            "verseOrgIds": [
              "EZK.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ndakaona varume vatanhatu vachiuya vachibva nokurutivi rwesuo rokumusoro, rakatarisa kumusoro, mumwe nomumwe ano munondo unopinza kwazvo muruoko rwake. Pakati pavo pakanga pano murume akanga akapfeka mucheka wakaisvonaka ane zvinyoreso parutivi rwake. Ivo vakapinda vakamira parutivi rwearitari yendarira.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.2",
            "verseOrgIds": [
              "EZK.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino kubwinya kwaMwari waIsraeri kwakakwira kuchibva pamusoro pamakerubhi, pakwakanga kuri, ndokuswedera kuchikumbaridzo chetemberi. Ipapo Jehovha akadana murume akanga akapfeka mucheka uya akanga ane zvinyoreso parutivi rwake",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.3",
            "verseOrgIds": [
              "EZK.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "akati kwaari, \"Pfuura nomuguta rose reJerusarema uye uise munembo pahuma dzavaya vanotsutsumwa navanochema pamusoro pezvinhu zvinonyangadza zvinoitwa mariri.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.4",
            "verseOrgIds": [
              "EZK.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichakateerera, iye akati kuna vamwe, \"Muteverei nomukati meguta, muuraye, musingambonzwiri ngoni kana tsitsi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.5",
            "verseOrgIds": [
              "EZK.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urayai vatana, majaya navarandakadzi, madzimai navana, asi musabata ani zvake ano munembo. Mutangire paimba tsvene yangu.\" Saka vakatanga navakuru vakanga vari mberi kwetemberi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.6",
            "verseOrgIds": [
              "EZK.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akati kwavari, \"Svibisai temberi muzadze mavazhe navakaurayiwa. Endai!\" Naizvozvo vakaenda vakatanga kuuraya muguta rose.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.7",
            "verseOrgIds": [
              "EZK.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pavakanga vachiuraya, uye ini ndasara ndoga, ndakawira pasi nechiso, ndichidanidzira, ndichiti, \"Haiwa, Ishe Jehovha! Muchaparadza vakasara vose vaIsraeri pakudururwa kwehasha dzenyu pamusoro peJerusarema here?\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.8",
            "verseOrgIds": [
              "EZK.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akandipindura achiti, \"Chivi cheimba yaIsraeri neJudha chakura kwazvo; nyika yazara nokuteura ropa uye guta razara nokusaruramisira. Ivo vanoti, 'Jehovha akaramba nyika; Jehovha haaoni.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.9",
            "verseOrgIds": [
              "EZK.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka handingambovanzwira tsitsi kana kuvaponesa, asi ndichauyisa pamisoro yavo zvavakaita.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.10",
            "verseOrgIds": [
              "EZK.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo murume uya akanga akapfeka mucheka wakaisvonaka ane zvokunyoresa parutivi pake akadzoka neshoko, achiti, \"Ndaita sezvamakarayira.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.11",
            "verseOrgIds": [
              "EZK.9.11"
            ]
          }
        }
      ]
    }
  ],
