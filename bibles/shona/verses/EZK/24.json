  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "EZK 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hari yokubikira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugore rechipfumbamwe, nomwedzi wegumi pazuva regumi, shoko raJehovha rakasvika kwandiri richiti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.1",
            "verseOrgIds": [
              "EZK.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mwanakomana womunhu, nyora zita rezuva iri, zuva iro rino chairo, nokuti mambo weBhabhironi akomba Jerusarema pazuva irori.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.2",
            "verseOrgIds": [
              "EZK.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taurira imba yokumukira iyi mufananidzo, uti kwavari, 'Zvanzi naIshe Jehovha:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.3",
            "verseOrgIds": [
              "EZK.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 24:3"
      },
      "items": [
        {
          "text": "\" 'Gadza hadyana; igadze",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.3",
            "verseOrgIds": [
              "EZK.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:3"
      },
      "items": [
        {
          "text": "ugodira mvura mairi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.3",
            "verseOrgIds": [
              "EZK.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uise mairi nhindi dzenyama,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.4",
            "verseOrgIds": [
              "EZK.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:4"
      },
      "items": [
        {
          "text": "nhindi dzakanaka, gumbo nebandauko.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.4",
            "verseOrgIds": [
              "EZK.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 24:4"
      },
      "items": [
        {
          "text": "Uizadze namapfupa akaisvonaka aya;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.4",
            "verseOrgIds": [
              "EZK.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "utore gwai rakasanangurwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.5",
            "verseOrgIds": [
              "EZK.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 24:5"
      },
      "items": [
        {
          "text": "Uise huni pasi payo kuitira mapfupa;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.5",
            "verseOrgIds": [
              "EZK.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:5"
      },
      "items": [
        {
          "text": "uivirise",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.5",
            "verseOrgIds": [
              "EZK.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:5"
      },
      "items": [
        {
          "text": "ugobika mapfupa imomo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.5",
            "verseOrgIds": [
              "EZK.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nokuti zvanzi naIshe Jehovha:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.6",
            "verseOrgIds": [
              "EZK.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 24:6"
      },
      "items": [
        {
          "text": "\" 'Rine nhamo guta rinoteura ropa,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.6",
            "verseOrgIds": [
              "EZK.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:6"
      },
      "items": [
        {
          "text": "nehadyana ine ngura, mukati mayo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.6",
            "verseOrgIds": [
              "EZK.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:6"
      },
      "items": [
        {
          "text": "ine ngura isingabvi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.6",
            "verseOrgIds": [
              "EZK.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 24:6"
      },
      "items": [
        {
          "text": "Budisai nhindi imwe neimwe",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.6",
            "verseOrgIds": [
              "EZK.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:6"
      },
      "items": [
        {
          "text": "musingakandi mijenya nokuda kwadzo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.6",
            "verseOrgIds": [
              "EZK.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nokuti ropa rarakateura riri pakati paro:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.7",
            "verseOrgIds": [
              "EZK.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:7"
      },
      "items": [
        {
          "text": "Rakaridururira paruware pasina chinhu;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.7",
            "verseOrgIds": [
              "EZK.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 24:7"
      },
      "items": [
        {
          "text": "harina kuriteurira pavhu,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.7",
            "verseOrgIds": [
              "EZK.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:7"
      },
      "items": [
        {
          "text": "paringafukidzwa neguruva.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.7",
            "verseOrgIds": [
              "EZK.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuti ndimutse hasha dzangu ndigotsiva",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.8",
            "verseOrgIds": [
              "EZK.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:8"
      },
      "items": [
        {
          "text": "ndakaisa ropa raro paruware pasina chinhu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.8",
            "verseOrgIds": [
              "EZK.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:8"
      },
      "items": [
        {
          "text": "kuti rirege kufukidzwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.8",
            "verseOrgIds": [
              "EZK.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Naizvozvo zvanzi naIshe Jehovha:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.9",
            "verseOrgIds": [
              "EZK.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 24:9"
      },
      "items": [
        {
          "text": "\" 'Rine nhamo guta rinoteura ropa!",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.9",
            "verseOrgIds": [
              "EZK.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:9"
      },
      "items": [
        {
          "text": "Neniwo, ndichaunganidza huni dzakawanda.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.9",
            "verseOrgIds": [
              "EZK.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka tutira huni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.10",
            "verseOrgIds": [
              "EZK.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:10"
      },
      "items": [
        {
          "text": "ugobatidza moto.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.10",
            "verseOrgIds": [
              "EZK.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 24:10"
      },
      "items": [
        {
          "text": "Ubike nyama zvakanaka,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.10",
            "verseOrgIds": [
              "EZK.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:10"
      },
      "items": [
        {
          "text": "uchisanganisa nezvinonhuhwira;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.10",
            "verseOrgIds": [
              "EZK.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:10"
      },
      "items": [
        {
          "text": "uye urege mapfupa atsve.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.10",
            "verseOrgIds": [
              "EZK.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ugoisa hadyana isina chinhu pamazimbe",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.11",
            "verseOrgIds": [
              "EZK.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:11"
      },
      "items": [
        {
          "text": "kusvikira yapisa ndarira yayo yanʼaima",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.11",
            "verseOrgIds": [
              "EZK.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 24:11"
      },
      "items": [
        {
          "text": "kuti kusachena kwayo kunyauke",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.11",
            "verseOrgIds": [
              "EZK.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:11"
      },
      "items": [
        {
          "text": "uye tsvina yayo itsve yose.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.11",
            "verseOrgIds": [
              "EZK.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvakunda kushingaira kwangu kwose;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.12",
            "verseOrgIds": [
              "EZK.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:12"
      },
      "items": [
        {
          "text": "tsvina yayo zhinji haina kubviswa,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.12",
            "verseOrgIds": [
              "EZK.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 24:12"
      },
      "items": [
        {
          "text": "kunyange nomoto chaiwo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.12",
            "verseOrgIds": [
              "EZK.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Zvino kusachena kwako ndihwo unzenza hwako. Nokuti ndakaedza kukunatsa asi hauna kunatswa pakusachena kwako, hauchazonatswizve kusvikira hasha dzangu dzabva pamusoro pako.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.13",
            "verseOrgIds": [
              "EZK.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ini Jehovha ndakazvitaura. Nguva yangu yokuzviita yasvika. Handingaregi; handinganzwiri ngoni, uye handingazvidembi. Uchatongwa zvakafanira mabasa ako namafambiro ako, ndizvo zvinotaura Ishe Jehovha.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.14",
            "verseOrgIds": [
              "EZK.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kufa kwoMukadzi waEzekieri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shoko raJehovha rakasvika kwandiri richiti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.15",
            "verseOrgIds": [
              "EZK.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mwanakomana womunhu, ndava kuzokutorera uyo anofadza meso ako kamwe chete. Asi usachema kana kuungudza kana kubudisa misodzi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.16",
            "verseOrgIds": [
              "EZK.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gomera chinyararire; usachema akafa. Gara wakasunga nguwani yako zvakasimba uye neshangu dziri mumakumbo ako; urege kufumbira zasi kwouso hwako kana kudya zvokudya zvavanochema.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.17",
            "verseOrgIds": [
              "EZK.24.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka mangwanani ndakataura kuvanhu, uye mukadzi wangu akafa madekwana. Fume mangwana, ndakaita zvandakanga ndarayirwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.18",
            "verseOrgIds": [
              "EZK.24.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vanhu vakandibvunza vachiti, \"Haungatiudzi kuti zvinhu izvi zvinorevei kwatiri here?\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.19",
            "verseOrgIds": [
              "EZK.24.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka ndakati kwavari, \"Shoko raJehovha rakasvika kwandiri richiti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.20",
            "verseOrgIds": [
              "EZK.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uti kuimba yaIsraeri, 'Zvanzi naIshe Jehovha: Ndava pedyo nokusvibisa nzvimbo yangu tsvene, iyo nhare yamunozvirumbidza nayo, iwo mufaro wamaziso enyu, nechinhu chamunoda. Vanakomana navanasikana vamakasiya vachaurayiwa nomunondo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.21",
            "verseOrgIds": [
              "EZK.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye imi muchaita sezvandakaita. Hamungazofumbiri zasi kwezviso zvenyu kana kudya zvokudya zvavanochema.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.22",
            "verseOrgIds": [
              "EZK.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mucharega nguwani dzenyu dziri mumisoro yenyu neshangu dziri mumakumbo enyu. Hamungaungudzi kana kuchema asi muchaonda nokuda kwezvivi zvenyu uye muchagomera pakati penyu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.23",
            "verseOrgIds": [
              "EZK.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezekieri achava chiratidzo kwamuri; muchaita sezvaakaita. Panoitika izvi, imi muchaziva kuti ndini Ishe Jehovha.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.24",
            "verseOrgIds": [
              "EZK.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uye iwe, mwanakomana womunhu, pazuva randichavatorera nhare dzavo mufaro wavo nokukudzwa kwavo, mufaro wamaziso avo, chishuvo chemwoyo yavo, uye vanakomana navanasikana vavowo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.25",
            "verseOrgIds": [
              "EZK.24.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "pazuva iro mutizi achauya kuzokuudza zvinenge zvaitika.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.26",
            "verseOrgIds": [
              "EZK.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyoyo muromo wako uchazaruka; uchataura naye uye hauchazonyararizve. Saka iwe uchava chiratidzo kwavari, uye vachaziva kuti ndini Jehovha.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.27",
            "verseOrgIds": [
              "EZK.24.27"
            ]
          }
        }
      ]
    }
  ],
