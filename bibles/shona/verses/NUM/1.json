          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro, mhuri dzavaRevhi hadzina kuverengwa pamwe chete navamwe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.47",
            "verseOrgIds": [
              "NUM.1.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
