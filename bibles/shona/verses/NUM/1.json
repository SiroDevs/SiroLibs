              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ava ndivo varume vakaverengwa naMozisi naAroni navatungamiri veIsraeri gumi nevaviri, mumwe nomumwe achimiririra mhuri yake.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NUM 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaIsraeri vose vaiva namakore makumi maviri kana anodarika vaigona kurwa muhondo yeIsraeri vakaverengwa maererano nemhuri dzavo.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NUM 1:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vose vakaverengwa vakasvika zviuru mazana matanhatu nezvitatu, namazana mashanu ana makumi mashanu.",
          "type": "text"
        }
      ]
    },
    {
