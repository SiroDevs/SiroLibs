  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "NUM 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vanasikana vaZerofehadhi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanasikana vaZerofehadhi, mwanakomana waHeferi, mwanakomana waGireadhi, mwanakomana waMakiri, mwanakomana waManase, vakanga vari vemhuri dzaManase mwanakomana waJosefa. Mazita avanasikana akanga ari: Mara, Noa, Hogira, Mirika naTiza.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.1",
            "verseOrgIds": [
              "NUM.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakasvika pamukova weTende Rokusangana vakamira pamberi paMozisi, naEreazari muprista, vatungamiri, neungano yose, vakati,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.2",
            "verseOrgIds": [
              "NUM.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Baba vedu vakafira murenje. Vakanga vasiri pakati pavateveri vaKora, avo vakabatana pamwe chete kuti vamukire Jehovha, asi vakafira chivi chavowo vakasasiya vanakomana.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.3",
            "verseOrgIds": [
              "NUM.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, zita rababa vedu ragoshayikwa seiko pamhuri yavo, nokuti vakanga vasina mwanakomana here? Tipeiwo nhaka pakati pehama dzababa vedu.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.4",
            "verseOrgIds": [
              "NUM.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Mozisi akasvitsa nyaya yavo pamberi paJehovha",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.5",
            "verseOrgIds": [
              "NUM.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Jehovha akati kwaari,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.6",
            "verseOrgIds": [
              "NUM.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvinorehwa navanasikana vaZerofehadhi ndezvechokwadi. Zvirokwazvo unofanira kuvapa nhaka pakati pehama dzababa vavo ugodzorera nhaka yababa vavo kwavari.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.7",
            "verseOrgIds": [
              "NUM.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uti kuvaIsraeri, 'Kana murume akafa akasasiya mwanakomana, munofanira kudzorera nhaka yake kumwanasikana wake.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.8",
            "verseOrgIds": [
              "NUM.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana asina mwanasikana, mupe nhaka yake kumadzikoma ake kana vanunʼuna vake.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.9",
            "verseOrgIds": [
              "NUM.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana asina madzikoma kana vanunʼuna, mupe nhaka yake kuvanunʼuna kana madzikoma ababa vake.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.10",
            "verseOrgIds": [
              "NUM.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana baba vake vasina madzikoma kana vanunʼuna, mupe nhaka yake kuhama yepedyo yomumhuri yake, kuti ive yake. Uyu unofanira kuva mutemo kuvaIsraeri, sezvakarayirwa Mozisi naJehovha.' \"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.11",
            "verseOrgIds": [
              "NUM.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Joshua anotevera Mozisi pautungamiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akati kuna Mozisi, \"Kwira pamusoro pegomo iri romuAbharimi ugoona nyika yandakapa vaIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.12",
            "verseOrgIds": [
              "NUM.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure mokunge waona, newewo uchasanganiswa navanhu vokwako, sezvakaita Aroni mukoma wako,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.13",
            "verseOrgIds": [
              "NUM.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti ungano payakandimukira pamvura yomuRenje reZini, mose muri vaviri hamuna kuteerera murayiro wangu kuti mundiremekedze somutsvene pamberi pavo.\" (Iyi ndiyo mvura yapaMeribha Kadheshi, muRenje reZini.)",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.14",
            "verseOrgIds": [
              "NUM.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi akati kuna Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.15",
            "verseOrgIds": [
              "NUM.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Jehovha, Mwari wemweya yamarudzi ose avanhu, ngaagadze murume pamusoro peungano iyi",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.16",
            "verseOrgIds": [
              "NUM.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti abude nokupinda pamberi pavo, uyo achavabudisa nokuvapinza, kuti vanhu vaJehovha varege kuva samakwai asina mufudzi.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.17",
            "verseOrgIds": [
              "NUM.27.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Jehovha akati kuna Mozisi, \"Tora Joshua mwanakomana waNuni, murume ano mweya maari, ugoisa ruoko rwako pamusoro pake.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.18",
            "verseOrgIds": [
              "NUM.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unofanira kumumisa pamberi paEreazari muprista napamberi peungano yose ugomurayira pamberi pavo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.19",
            "verseOrgIds": [
              "NUM.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umupe rimwe simba rako kuti ungano yose yavaIsraeri igomuteerera.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.20",
            "verseOrgIds": [
              "NUM.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anofanira kumira pamberi paEreazari muprista, uyo achamubvunzira pamberi paJehovha nokutonga kweUrimi. Pakurayira kwake, vanofanira kubuda iye neungano yose yavaIsraeri uye pakurayira kwake ivo vachapinda.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.21",
            "verseOrgIds": [
              "NUM.27.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi akaita sezvaakarayirwa naJehovha. Akatora Joshua akamumisa pamberi paEreazari muprista napamberi peungano yose.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.22",
            "verseOrgIds": [
              "NUM.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akaisa maoko ake pamusoro pake akamurayira, sezvakanga zvarayirwa Mozisi naJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.23",
            "verseOrgIds": [
              "NUM.27.23"
            ]
          }
        }
      ]
    }
  ],
