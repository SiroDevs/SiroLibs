              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo machinda akanga ari vatariri vamapoka ehondo, vatungamiri vezviuru navatungamiri vamazana vakaenda kuna Mozisi",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.48",
            "verseOrgIds": [
              "NUM.31.48"
            ]
