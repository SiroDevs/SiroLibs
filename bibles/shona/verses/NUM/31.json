              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hafu yakanga iri yavaIsraeri, yakatsaurwa naMozisi kubva kuvarume vehondo,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.42",
