          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "vakati kwaari, \"Varanda venyu vaverenga varwi vari pasi pedu, hapana kana mumwe chete asipo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.49",
            "verseOrgIds": [
              "NUM.31.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "NUM 31:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka tauya nechipo kuna Jehovha chezvishongo zvegoridhe zvakawanikwa nomumwe nomumwe wedu, zvishongo zvegoridhe, mhete dzomumaoko, mhete dzomunzeve nouketani hwomumutsipa kuti tizviyananisire pamberi paJehovha.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.50",
            "verseOrgIds": [
              "NUM.31.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
