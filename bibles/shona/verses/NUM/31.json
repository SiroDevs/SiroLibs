          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi naEreazari muprista vakagamuchira kubva kwavari goridhe, zvinhu zvose zvakanga zvakaitwa noumhizha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.51",
            "verseOrgIds": [
              "NUM.31.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "NUM 31:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Goridhe rose rakabva kuvatungamiri vezviuru navatungamiri vamazana rakapiwa kuna Jehovha naMozisi naEreazari muprista rairema mashekeri zviuru gumi nezvitanhatu, namazana manomwe namakumi mashanu",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.52",
            "verseOrgIds": [
              "NUM.31.52"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.52",
            "verseOrgIds": [
              "NUM.31.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "NUM 31:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murwi mumwe nomumwe akanga azvitorera zvake zvakapambwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.53",
            "verseOrgIds": [
              "NUM.31.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "NUM 31:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi naEreazari muprista vakagamuchira goridhe rakabva kuvatungamiri vezviuru nokuvatungamiri vamazana vakariisa muTende Rokusangana kuti chive chirangaridzo chavaIsraeri pamberi paJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.54",
