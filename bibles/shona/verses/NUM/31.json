          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubva pahafu yaiva yavaIsraeri, Mozisi akatsaura munhu mumwe chete kubva pavanhu makumi mashanu, chipfuwo chimwe chete kubva pazvipfuwo makumi mashanu, sezvakarayirwa naJehovha, akazvipa kuvaRevhi, vakanga vane basa rokuchengeta tabhenakeri yaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.47",
            "verseOrgIds": [
              "NUM.31.47"
