  "verseCount": 48,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "ACT 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Koniriasi anodana Petro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "PaKesaria pakanga pano mumwe murume ainzi Koniriasi, mukuru wezana weHondo yavaItaria.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.1",
            "verseOrgIds": [
              "ACT.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye nemhuri yake vakanga vakazvipira uye vaitya Mwari; aipa kwazvo kuna vanoshayiwa uye ainyengetera kuna Mwari nguva dzose.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.2",
            "verseOrgIds": [
              "ACT.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe musi panguva inenge yechitatu masikati akaona chiratidzo. Akanyatsoona mutumwa waMwari, uyo akauya kwaari akati, \"Koniriasi!\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.3",
            "verseOrgIds": [
              "ACT.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koniriasi akatarisa kwaari achitya, akati, \"Chinyiko, Ishe?\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.4",
            "verseOrgIds": [
              "ACT.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ACT 10:4"
      },
      "items": [
        {
          "text": "Mutumwa akapindura akati, \"Minyengetero yako nezvipo zvako kuvarombo zvakwira kudenga sechipiriso chechirangaridzo pamberi paMwari.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.4",
            "verseOrgIds": [
              "ACT.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino tuma vanhu kuJopa vandodana murume anonzi Simoni, achinziwo Petro.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.5",
            "verseOrgIds": [
              "ACT.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ari kugara naSimoni musuki wamatehwe, ane imba iri pedyo negungwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.6",
            "verseOrgIds": [
              "ACT.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutumwa waakanga achitaura naye akati aenda, Koniriasi akadana varanda vake vaviri nomumwe murwi akatendeka uyo aiva mumwe wavachengeti vake.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.7",
            "verseOrgIds": [
              "ACT.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akavarondedzera zvose zvakanga zvaitika ndokuvatuma kuJopa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.8",
            "verseOrgIds": [
              "ACT.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chiratidzo chaPetro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenguva dzinenge dzamasikati dzezuva raitevera, vachiri parwendo rwavo, uye voswedera pedyo neguta, Petro akakwira pamusoro pedenga reimba kundonyengetera.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.9",
            "verseOrgIds": [
              "ACT.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanzwa nzara uye akada zvokudya, uye zvokudya zvakati zvichigadzirwa, akaona chiratidzo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.10",
            "verseOrgIds": [
              "ACT.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaona denga razarurwa uye chimwe chinhu chakanga chakaita sejira guru chichiburutswa pasi chakasungwa makona acho mana.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.11",
            "verseOrgIds": [
              "ACT.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chakanga chine mhando dzose dzemhuka dzina makumbo mana, pamwe chete nezvinokambaira zvenyika, neshiri dzedenga.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.12",
            "verseOrgIds": [
              "ACT.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo inzwi rakati kwaari, \"Simuka, Petro. Baya udye.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.13",
            "verseOrgIds": [
              "ACT.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro akapindura akati, \"Zvirokwazvo kwete, Ishe! Handina kutongodya chinhu chisina kunaka kana chine tsvina.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.14",
            "verseOrgIds": [
              "ACT.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzwi rakataurazve kwaari kechipiri richiti, \"Usati chinhu chipi zvacho chakanatswa naMwari chine tsvina.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.15",
            "verseOrgIds": [
              "ACT.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi zvakaitika katatu, pakarepo jira rikadzoserwa kudenga.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.16",
            "verseOrgIds": [
              "ACT.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro achiri kushamiswa nezvaireva chiratidzo, varume vakanga vatumwa naKoniriasi vakawana pakanga pane imba yaSimoni uye vakamira pasuo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.17",
            "verseOrgIds": [
              "ACT.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakadanidzira vachibvunza kana pakanga pari ipo paigara Simoni ainziwo Petro.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.18",
            "verseOrgIds": [
              "ACT.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro achiri kufunga pamusoro pechiratidzo, Mweya akati kwaari, \"Simoni, pane varume vatatu vari kukutsvaka.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.19",
            "verseOrgIds": [
              "ACT.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka simuka uburuke uende pasi. Usatya kuenda navo, nokuti ndini ndavatuma.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.20",
            "verseOrgIds": [
              "ACT.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro akaburuka akandoti kuvarume ava, \"Ndini wamuri kutsvaka. Mavingeiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.21",
            "verseOrgIds": [
              "ACT.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume vaya vakamupindura vakati, \"Tabva kuna Koniriasi mukuru wezana. Munhu akarurama uye anotya Mwari, anokudzwa navanhu vose vechiJudha. Mutumwa mutsvene akamuudza kuti akudanei kuti muuye kumba kwake kuti azonzwa zvamuchareva kwaari.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.22",
            "verseOrgIds": [
              "ACT.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Petro akakoka varume ava kuti vapinde mumba vave vaeni vake.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.23",
            "verseOrgIds": [
              "ACT.10.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1",
        "vid": "ACT 10:23"
      },
      "items": [
        {
          "text": "Petro mumba maKoniriasi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ACT 10:23"
      },
      "items": [
        {
          "text": "Fume mangwana Petro akasimuka pamwe chete navo, uye dzimwe hama dzokuJopa dzakaendawo naye.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.23",
            "verseOrgIds": [
              "ACT.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zuva rakatevera akasvika Kesaria. Koniriasi akanga akavamirira uye akanga akoka hama dzake neshamwari dzapedyo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.24",
            "verseOrgIds": [
              "ACT.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro akati apinda mumba, Koniriasi akamugamuchira uye akawira patsoka dzake achimuremekedza.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.25",
            "verseOrgIds": [
              "ACT.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Petro akaita kuti asimuke akati, \"Simuka, ndinongova munhuwo zvangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.26",
            "verseOrgIds": [
              "ACT.10.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro achitaura naye, akapinda mumba akawana vanhu vazhinji vakaungana.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.27",
            "verseOrgIds": [
              "ACT.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kwavari, \"Imi munozviziva kuti hazvibvumirwi nomurayiro wedu kuti muJudha adyidzane nomuhedheni kana kumushanyira. Asi Mwari andiratidza kuti handifaniri kuti nditi munhu haana kunaka kana kuti ane tsvina.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.28",
            "verseOrgIds": [
              "ACT.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokudaro pandakadanwa, ndakabva ndauya ndisingarambi. Regai ndichibvunza hangu kwamuri kuti mandidanirei?\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.29",
            "verseOrgIds": [
              "ACT.10.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koniriasi akapindura akati, \"Mazuva mana apfuura ndakanga ndiri mumba mangu ndichinyengetera senguva ino, nenguva yechitatu yamasikati. Pakarepo munhu akanga akapfeka nguo dzinopenya akamira pamberi pangu",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.30",
            "verseOrgIds": [
              "ACT.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "akati, 'Koniriasi, Mwari anzwa minyengetero yako uye arangarira zvipo zvako kuvarombo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.31",
            "verseOrgIds": [
              "ACT.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tumira vanhu kuJopa kuna Simoni anonzi Petro. Mueni mumba maSimoni musuki wamatehwe, anogara pedyo negungwa.'",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.32",
            "verseOrgIds": [
              "ACT.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka ndakabva ndatumira vanhu kwamuri pakarepo, uye maita zvakanaka zvamauya. Zvino isu tose tiri pano pamberi paMwari kuti tinzwe kwamuri zvose zvamarayirwa naShe kuti muzotitaurira.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.33",
            "verseOrgIds": [
              "ACT.10.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Petro akatanga kutaura achiti, \"Zvino ndava kuziva kuti zvirokwazvo Mwari haazi mutsauri wavanhu",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.34",
            "verseOrgIds": [
              "ACT.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi anogamuchira vanhu vanobva kundudzi dzose, ivo vanomutya uye vanoita zvakarurama.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.35",
            "verseOrgIds": [
              "ACT.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imi munoziva shoko rakatumwa naMwari kuvanhu veIsraeri, achivaudza mashoko akanaka orugare kubudikidza naJesu Kristu, anova Ishe wavose.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.36",
            "verseOrgIds": [
              "ACT.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munoziva zvakaitika muJudhea yose, kutanga kuGarirea shure kworubhabhatidzo rwakaparidzwa naJohani,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.37",
            "verseOrgIds": [
              "ACT.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "zvokuti Mwari akazodza sei Jesu Kristu weNazareta noMweya Mutsvene nesimba, uye kuti akapota sei nenyika achiita zvakanaka achiporesa vose vakanga vari pasi pesimba radhiabhori, nokuti Mwari aiva naye.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.38",
            "verseOrgIds": [
              "ACT.10.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Isu tiri zvapupu zvezvinhu zvose zvaakaita munyika yavaJudha nomuJerusarema. Vakamuuraya nokumuturika pamuti,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.39",
            "verseOrgIds": [
              "ACT.10.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 10:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi Mwari akamumutsa kubva kuvakafa nezuva retatu akaita kuti aonekwe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.40",
            "verseOrgIds": [
              "ACT.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haana kuonekwa navanhu vose, asi nezvapupu zvakanga zvagara zvasarudzwa naMwari nesu takadya uye tikanwa naye shure kwokumuka kwake kubva kuvakafa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.41",
            "verseOrgIds": [
              "ACT.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatirayira kuti tiparidze kuvanhu uye tipupure kuti ndiye akagadzwa naMwari kuti ave mutongi wavapenyu navakafa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.42",
            "verseOrgIds": [
              "ACT.10.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "ACT 10:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaprofita vose vanopupura nezvake kuti ani naani anotenda kwaari anogamuchira kanganwiro yezvivi kubudikidza nezita rake.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.43",
            "verseOrgIds": [
              "ACT.10.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "ACT 10:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro achiri kutaura mashoko aya, Mweya Mutsvene akauya pamusoro pavose vakanzwa shoko.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.44",
            "verseOrgIds": [
              "ACT.10.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "ACT 10:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vatendi vakadzingiswa vakanga vauya naPetro vakakatyamara nokuti chipo choMweya Mutsvene chakanga chadururirwa kunyange napamusoro pevedzimwe ndudziwo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.45",
            "verseOrgIds": [
              "ACT.10.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "ACT 10:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti vakavanzwa vachitaura nendimi vachirumbidza Mwari.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.46",
            "verseOrgIds": [
              "ACT.10.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ACT 10:46"
      },
      "items": [
        {
          "text": "Ipapo Petro akati,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.46",
            "verseOrgIds": [
              "ACT.10.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "ACT 10:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pano munhu angadzivisa vanhu ava kuti vabhabhatidzwe nemvura here? Vagamuchira Mweya Mutsvene sezvatakangoitawo isu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.47",
            "verseOrgIds": [
              "ACT.10.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "ACT 10:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo akarayira kuti vabhabhatidzwe muzita raJesu Kristu. Ipapo vakakumbira Petro kuti ambogara navo kwamazuva mashoma.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.48",
            "verseOrgIds": [
              "ACT.10.48"
            ]
          }
        }
      ]
    }
  ],
