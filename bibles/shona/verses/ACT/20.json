              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati ataura izvi, akapfugama pamwe chete navo vose uye vakanyengetera.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.36",
            "verseOrgIds": [
              "ACT.20.36"
            ]
          }
        },
        {
