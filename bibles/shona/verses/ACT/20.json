          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Handina kumbochiva sirivha yomunhu kana goridhe kana nguo yomunhu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.33",
            "verseOrgIds": [
              "ACT.20.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imi munoziva pachenyu kuti maoko angu aya akabatira kushayiwa kwangu nokushayiwa kwavandaiva navo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.34",
            "verseOrgIds": [
              "ACT.20.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mune zvose zvandakaita, ndakakuratidzai kuti namabatiro akaoma aya, tinofanira kubatsira vasina simba, tichirangarira mashoko aShe Jesu pachake paakati, 'Kupa kwakaropafadzwa kupfuura kugamuchira.' \"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.35",
            "verseOrgIds": [
              "ACT.20.35"
            ]
          }
        }
      ]
    },
