  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "ACT 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pauro paKorinde",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwaizvozvo, Pauro akabva paAtene akaenda kuKorinde.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.1",
            "verseOrgIds": [
              "ACT.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikoko akandosangana nomuJudha ainzi Akwira chizvarwa chePondasi, akanga achangobva kuItari nomukadzi wake Pirisira, nokuti Kiraudhiyo akanga arayira kuti vaJudha vose vabve muRoma. Pauro akaenda kundomuona,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.2",
            "verseOrgIds": [
              "ACT.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye sezvo akanga ari mugadziri wamatende saivo, akagara navo achishanda pamwe chete navo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.3",
            "verseOrgIds": [
              "ACT.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sabata rimwe nerimwe akanga achitaurirana navo musinagoge, achiedza kugombedzera vaJudha navaGiriki.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.4",
            "verseOrgIds": [
              "ACT.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sirasi naTimoti vakati vasvika vachibva kuMasedhonia, Pauro akazvipira kuti aparidze chete, achipupura kuvaJudha kuti Jesu ndiye Kristu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.5",
            "verseOrgIds": [
              "ACT.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vaJudha vakati vapikisana naPauro uye vachimutuka, akazunza nguo dzake asingafari akati kwavari, \"Ropa renyu ngarive pamisoro yenyu! Ini ndakachena pabasa rangu. Kubva zvino ndichaenda kune veDzimwe Ndudzi.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.6",
            "verseOrgIds": [
              "ACT.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Pauro akabuda musinagoge akaenda kumba kwaTitiasi Jastasi munhu ainamata Mwari.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.7",
            "verseOrgIds": [
              "ACT.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Krispasi mukuru wesinagoge, neimba yake yose vakatenda kuna She; uye vazhinji vavaKorinde vakamunzwa vakatenda uye vakabhabhatidzwa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.8",
            "verseOrgIds": [
              "ACT.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Humwe usiku Ishe akataura naPauro muchiratidzo akati, \"Usatya; ramba uchingotaura, usanyarara.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.9",
            "verseOrgIds": [
              "ACT.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti ndinewe, uye hakuna munhu achakurwisa akakukuvadza, nokuti ndina vanhu vazhinji muguta rino.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.10",
            "verseOrgIds": [
              "ACT.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Pauro akagaramo kwegore nemwedzi mitanhatu, achivadzidzisa shoko raMwari.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.11",
            "verseOrgIds": [
              "ACT.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyo Gario akanga ari mubati weAkaya, vaJudha vakabatana mukurwisa Pauro uye vakauya naye kudare redzimhosva.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.12",
            "verseOrgIds": [
              "ACT.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati, \"Munhu uyu, ari kugombedzera vanhu kuti vanamate Mwari nenzira inopesana nomurayiro.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.13",
            "verseOrgIds": [
              "ACT.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pauro akati oda kutaura, Gario akati kuvaJudha, \"Kana imi vaJudha manga muchinyunyuta pamusoro pemhosva yezvisakarurama kana kutadza kwakaipisisa, zvainge zviri nyore kwandiri kuti ndikuteererei.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.14",
            "verseOrgIds": [
              "ACT.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi sezvo ichingova mibvunzo pamusoro pamashoko namazita uye nezvomurayiro wenyu, gadzirisanai pachenyu. Ini handidi kutonga nyaya dzakadai.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.15",
            "verseOrgIds": [
              "ACT.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka akaita kuti vadzingwe kubva mudare remhosva.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.16",
            "verseOrgIds": [
              "ACT.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vose vakatendeukira kuna Sosteni mukuru wesinagoge vakamurova pamberi pedare. Asi Gario haana kumbova nehanya nazvo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.17",
            "verseOrgIds": [
              "ACT.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pirisira, Akwira naAporosi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pauro akaramba ari muKorinde kwamazuva mazhinji. Ipapo akabva pahama ndokuenda nechikepe kuSiria, achiperekedzwa naPirisira naAkwira. Asati akwira chikepe, akaveura bvudzi rake paKenikireya nokuda kwemhiko yaakanga aita.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.18",
            "verseOrgIds": [
              "ACT.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakasvika paEfeso, Pauro akasiya Pirisira naAkwira ipapo. Iye pachake akapinda musinagoge akataurirana navaJudha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.19",
            "verseOrgIds": [
              "ACT.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vamukumbira kuti agare navo nguva refu, iye akaramba.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.20",
            "verseOrgIds": [
              "ACT.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi paakabva, akavimbisa achiti, \"Ndichadzokazve kana Mwari achida.\" Ipapo akakwira chikepe kubva kuEfeso.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.21",
            "verseOrgIds": [
              "ACT.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati aburuka paKesaria, akakwidza akandokwazisa kereke ipapo ndokubva aburuka oenda kuAndioki.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.22",
            "verseOrgIds": [
              "ACT.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwokunge ambogara muAndioki kwechinguva, Pauro akabvapo akaenda achishanya munzvimbo nenzvimbo, akapinda nomumatunhu eGaratia neFirigia, achisimbisa vadzidzi vose.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.23",
            "verseOrgIds": [
              "ACT.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvichakadaro, mumwe muJudha ainzi Aporosi, chizvarwa cheArekizandiria, akasvika kuEfeso. Akanga ari murume akadzidza, aino ruzivo rwaMagwaro chaizvo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.24",
            "verseOrgIds": [
              "ACT.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanga akadzidziswa nzira yaShe, uye aitaura nesimba guru achinyatsodzidzisa nezvaJesu, kunyange zvake aingoziva nezvorubhabhatidzo rwaJohani.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.25",
            "verseOrgIds": [
              "ACT.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatanga kutaura musinagoge asingatyi. Pirisira naAkwira vakati vamunzwa, vakamukoka kumba kwavo vakamutsanangurira nzira yaMwari zvizere.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.26",
            "verseOrgIds": [
              "ACT.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aporosi akati oda kuenda kuAkaya, hama dzakamukurudzira ndokumunyorera tsamba yokuti vadzidzi vaikoko vamugamuchire. Paakasvika akabatsira kwazvo avo vakanga vatenda nenyasha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.27",
            "verseOrgIds": [
              "ACT.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti pakutaurirana, akapikisa vaJudha zvine simba pamberi pavanhu, achiratidza kubva muMagwaro kuti Jesu ndiye Kristu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.28",
            "verseOrgIds": [
              "ACT.18.28"
            ]
          }
        }
      ]
    }
  ],
