  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "ACT 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pauro naSirasi muTesaronika",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vapfuura nomuAmufipori neAporonia, vakasvika muTesaronika umo makanga mune sinagoge ravaJudha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.1",
            "verseOrgIds": [
              "ACT.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Setsika yake Pauro akapinda musinagoge, akataurirana navo zvaibva muMagwaro, kwamaSabata matatu,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.2",
            "verseOrgIds": [
              "ACT.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "achitsanangura nokuvaratidza kuti Kristu aifanira kutambudzika uye agomuka kubva kuvakafa. Akati, \"Jesu uyu wandinokuparidzirai ndiye Kristu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.3",
            "verseOrgIds": [
              "ACT.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamwe vaJudha vakatenda ndokubva vabatana naPauro naSirasi, sezvakaitwawo navazhinji zhinji vavaGiriki vaitya Mwari uye navakadzi vazhinji vaikudzwa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.4",
            "verseOrgIds": [
              "ACT.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vaJudha vakaita godo; saka vakakokorodza vanhu vakanga vakaipa kubva pamusika, vakaunganidza mhomho yavanhu kuti vandotanga bope muguta. Vakamhanyira kumba kwaJasoni kundotsvaka Pauro naSirasi vachida kuti vavabudise vavaendese kuvanhu vazhinji.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.5",
            "verseOrgIds": [
              "ACT.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vakati vavashayiwa, vakakakatira Jasoni nedzimwe hama pamberi pavabati veguta, vachidanidzira vachiti, \"Vanhu vaya vakauyisa kusagadzikana panyika yose vasvikawo kuno zvino,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.6",
            "verseOrgIds": [
              "ACT.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye Jasoni akavagamuchira mumba make. Vose vari kumhura zvirevo zvaKesari, vachiti pano mumwe mambo, anonzi Jesu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.7",
            "verseOrgIds": [
              "ACT.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vanzwa izvozvo, ungano uye navabati veguta vakashushikana.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.8",
            "verseOrgIds": [
              "ACT.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakaita kuti Jasoni navamwe varipe rubatso ndokubva vavaregedza.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.9",
            "verseOrgIds": [
              "ACT.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pauro naSirasi paBheria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchangosviba, hama dzakaendesa Pauro naSirasi kuBheria. Vakati vasvika ikoko, vakapinda musinagoge ravaJudha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.10",
            "verseOrgIds": [
              "ACT.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino vaBheria vakanga vane tsika dzakanaka kupfuura vaTesaronika, nokuti vakagamuchira shoko nemwoyo inodisisa uye vachinzvera Magwaro zuva rimwe nerimwe kuti vaone kana zvairehwa naPauro zvaiva izvo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.11",
            "verseOrgIds": [
              "ACT.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaJudha vazhinji vakatenda, sezvakaitwawo navakadzi vaikudzwa vechiGiriki navarume vazhinji vechiGiriki.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.12",
            "verseOrgIds": [
              "ACT.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaJudha vokuTesaronika vakati vanzwa kuti Pauro akanga achiparidza shoko raMwari paBheria, vakaendazve ikoko, vakakurudzira uye vakakuchidzira bope pakati pavanhu vazhinji.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.13",
            "verseOrgIds": [
              "ACT.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo hama dzakaendesa Pauro kugungwa, asi Sirasi naTimoti vakasara paBheria.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.14",
            "verseOrgIds": [
              "ACT.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume vakaperekedza Pauro, vakasvika naye paAtene vachibva vadzokera vaine shoko rokuti Sirasi naTimoti vamutevere nokukurumidza.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.15",
            "verseOrgIds": [
              "ACT.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pauro paAtene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pauro achakavamirira paAtene, akatambudzika zvikuru achiona kuti guta rakanga rizere nezvifananidzo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.16",
            "verseOrgIds": [
              "ACT.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka akataurirana navaJudha navaGiriki vaitya Mwari musinagoge, uyewo napamusika zuva rimwe nerimwe naavo vainge varipo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.17",
            "verseOrgIds": [
              "ACT.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boka ravakachenjera ravaEpikuro navaStoiki rakaita nharo naye. Vamwe vavo vakabvunza vakati, \"Ko, uyu mutauri wezvisina maturo ari kuedza kuti kudii?\" Vamwe vakati, \"Anenge ari kudzidzisa nezvavamwari vokumwe.\" Vakareva izvi nokuti Pauro akanga achiparidza mashoko akanaka ezvaJesu uye nezvokumuka kwavakafa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.18",
            "verseOrgIds": [
              "ACT.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakamutora vakaenda naye kumusangano weAreopagasi, vakati kwaari, \"Tinoda kuziva kuti dzidziso itsva iyi yauri kudzidzisa ndeyei?",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.19",
            "verseOrgIds": [
              "ACT.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uri kuunza pfungwa itsva kunzeve dzedu, uye tinoda kuziva kuti dzinorevei.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.20",
            "verseOrgIds": [
              "ACT.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "(VaAtene vose navatorwa vaigara ipapo vaipedza nguva yavo vasina chimwe chavanoita kunze kwokungotaura nokuteerera pfungwa itsva).",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.21",
            "verseOrgIds": [
              "ACT.17.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Pauro akasimuka mumusangano weAreopagasi akati, \"Varume veAtene! Ndinoona kuti panzira dzose muri vanhu vechitendero zvikuru.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.22",
            "verseOrgIds": [
              "ACT.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti ndakati ndichifamba-famba uye ndikanyatsotarisisa zvinhu zvamunonamata, ndakaonawo aritari yakanyorwa kunzi: KUNA MWARI ASINGAZIVIKANWI. Zvino chamunonamata sechinhu chisingazivikanwi ndicho chandinokuparidzirai.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.23",
            "verseOrgIds": [
              "ACT.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mwari akasika nyika nezvinhu zvose zviri mairi ndiye Ishe wedenga napasi uye haagari mutemberi dzakavakwa namaoko.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.24",
            "verseOrgIds": [
              "ACT.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye haashumirwi namaoko avanhu, sokunge anoshayiwa chinhu, nokuti iye amene anopa vanhu vose upenyu nokufema, nezvimwewo zvinhu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.25",
            "verseOrgIds": [
              "ACT.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubva pamunhu mumwe chete akaita ndudzi dzose dzavanhu, kuti vagare panyika yose; uye akavatarira nguva nenzvimbo dzavo chaidzo dzavangagara.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.26",
            "verseOrgIds": [
              "ACT.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari akaita izvi kuitira kuti vanhu vagomutsvaka kuti zvimwe vangamuwana, kunyange zvake asiri kure nomumwe nomumwe wedu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.27",
            "verseOrgIds": [
              "ACT.17.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Nokuti maari ndimo matinorarama nomatinofamba, uye ndimo matigere.' Sezvakarehwa navamwe vadetembi vokwenyu vachiti, 'Tiri chibereko chake.'",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.28",
            "verseOrgIds": [
              "ACT.17.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naizvozvo sezvo tiri chibereko chaMwari, hatifaniri kufunga kuti umwari hwakaita segoridhe kana sirivha kana ibwe, chifananidzo chakavezwa noumhizha hwomunhu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.29",
            "verseOrgIds": [
              "ACT.17.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 17:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari akarega hake kurangarira nguva dzakare dzokusaziva kwakadai, asi zvino anorayira vanhu vose kwose kwose kuti vatendeuke.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.30",
            "verseOrgIds": [
              "ACT.17.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 17:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti akatara zuva raachatonga nyika nokururamisira nomurume waakagadza. Akaratidza izvi kuvanhu vose nokumumutsa kubva kuvakafa.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.31",
            "verseOrgIds": [
