  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "ACT 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pauro paMarita",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Takati tasvika zvakanaka kumahombekombe, takazoziva kuti chitsuwa ichi chainzi Marita.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.1",
            "verseOrgIds": [
              "ACT.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vomuchitsuwa ichi vakatiitira tsitsi dzinoshamisa. Vakavesa moto vakatigamuchira tose nokuti kwakanga kuchinaya uye kuchitonhora.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.2",
            "verseOrgIds": [
              "ACT.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pauro akaunganidza svinga retutsotso. Paakanga ava kutuisa mumoto, nyoka, yanzwa kupisa kwomoto, yakanamatira paruoko rwake.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.3",
            "verseOrgIds": [
              "ACT.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vomuchitsuwa ichi pavakaona nyoka yakarembera paruoko rwake, vakataurirana pakati pavo vakati, \"Munhu uyu anofanira kuva mhondi; nokuti kunyange apunyuka hake mugungwa, kururamisira hakuna kumubvumira kuti ararame.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.4",
            "verseOrgIds": [
              "ACT.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Pauro akazunzira nyoka mumoto uye haana kurwara.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.5",
            "verseOrgIds": [
              "ACT.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vakanga vakatarisira kuti achazvimba kana kuwira pasi pakarepo ofa, asi vakati varindira kwenguva refu uye vakasaona chakaitika kwaari, vakashanduka vakati aiva mwari.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.6",
            "verseOrgIds": [
              "ACT.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakanga pano munda waiva pedyo ipapo wakanga uri waPabhuriosi, muchinda mukuru wechitsuwa icho. Akatigamuchira kumba kwake akatichengeta zvakanaka kwamazuva matatu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.7",
            "verseOrgIds": [
              "ACT.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baba vake vakanga vachirwara vavete pamubhedha, vachirwadziwa nefivha uye vane manyoka aibudisa ropa. Pauro akapinda kuti andovaona, uye shure kwokunyengetera, akaisa maoko ake pamusoro pavo akavaporesa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.8",
            "verseOrgIds": [
              "ACT.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi zvakati zvaitika, vairwara vose vomuchitsuwa vakauya vakaporeswa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.9",
            "verseOrgIds": [
              "ACT.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakatikudza nenzira zhinji uye patakanga tagadzirira kukwira chikepe, vakatipa zvinhu zvataida.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.10",
            "verseOrgIds": [
              "ACT.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pauro anosvika kuRoma",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwedzi mitatu yakati yapfuura, takaenda kugungwa tikakwira muchikepe chakanga chapedza mwaka wechando chiri pachitsuwa apa. Chakanga chiri chikepe chokuArekizandiria chakanga chine misoro miviri yavamwari mapatya, ivo Kasitori naPorukisi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.11",
            "verseOrgIds": [
              "ACT.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Takaenda paSirakuse tikandogarapo kwamazuva matatu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.12",
            "verseOrgIds": [
              "ACT.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Takabvapo tikakwira chikepe tikandosvika kuRegiamu. Zuva rakatevera, mhepo yaibva zasi yakatanga kuvhuvhuta, uye pazuva rechipiri takazosvika paPuteori.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.13",
            "verseOrgIds": [
              "ACT.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo takawana hama uye dzakatikoka kuti tipedze vhiki imwe tinavo. Tichibva ipapo takaenda kuRoma.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.14",
            "verseOrgIds": [
              "ACT.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hama dzaikoko dzakanga dzanzwa kuti takanga tichiuya, naizvozvo vakafamba kusvikira kuMusika weApio napaMahotera Matatu kuti vazosangana nesu. Pauro, paakaona varume ava, akavonga Mwari uye akakurudzirwa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.15",
            "verseOrgIds": [
              "ACT.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Takati tasvika kuRoma, Pauro akatenderwa kuti agare oga, ane murwi aimuchengeta.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.16",
            "verseOrgIds": [
              "ACT.28.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pauro anoparidza muRoma",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazuva matatu akati apfuura, akakoka vatungamiri vavaJudha. Vakati vaungana, Pauro akati kwavari, \"Hama dzangu, kunyange ndisina kuita chinhu chakaipa kuvanhu vokwedu kana pamusoro petsika dzamadzitateguru edu, ndakasungwa muJerusarema ndikaiswa mumaoko avaRoma.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.17",
            "verseOrgIds": [
              "ACT.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakandibvunzisisa uye vakada kundisunungura, nokuti ndakanga ndisina mhosva ipi zvayo yaikodzera rufu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.18",
            "verseOrgIds": [
              "ACT.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vaJudha vakati varamba ndakazvipira kuti ndizviise kuna Kesari, kwete kuti ndakanga ndine mhosva ipi zvayo nehama dzangu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.19",
            "verseOrgIds": [
              "ACT.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokudaro ndakumbira hangu kuti ndikuonei uye nditaure nemi. Nokuda kwetariro yaIsraeri ndakasungwa nengetani iyi.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.20",
            "verseOrgIds": [
              "ACT.28.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivo vakati, \"Hatina kumbogamuchira kana tsamba zvadzo dzichibva kuJudhea maererano newe, uye hakuna mumwe wehama dzakabvako akatizivisa kana kutaura chinhu chipi zvacho chakaipa pamusoro pako.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.21",
            "verseOrgIds": [
              "ACT.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi tinoda kunzwa kuti pfungwa dzako ndedzei, nokuti tinoziva kuti kwose kwose vanhu vanotaura zvakaipa pamusoro peboka iri.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.22",
            "verseOrgIds": [
              "ACT.28.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaronga kuzosanganazve naPauro pane rimwe zuva, uye vakauya kwaakanga ari vari vazhinji kwazvo. Kubvira mangwanani kusvikira madekwana akavatsanangurira uye akavapupurira zvoumambo hwaMwari, uye achiedza kwazvo kuti vatende nezvaJesu kutanga paMurayiro waMozisi kusvikira kuvaprofita.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.23",
            "verseOrgIds": [
              "ACT.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamwe vakatendeswa nezvaaireva, asi vamwe havana kutenda.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.24",
            "verseOrgIds": [
              "ACT.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Havana kutenderana pakati pavo ndokubva vatanga kuenda, shure kwokunge Pauro ataura mashoko okupedzisira okuti: \"Mweya Mutsvene akataura chokwadi kumadzitateguru enyu paakataura nomuromo waIsaya muprofita achiti:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.25",
            "verseOrgIds": [
              "ACT.28.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Enda kuvanhu ava uti,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.26",
            "verseOrgIds": [
              "ACT.28.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 28:26"
      },
      "items": [
        {
          "text": "\"Mucharamba muchinzwa asi musingatongonzwisisi;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.26",
            "verseOrgIds": [
              "ACT.28.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 28:26"
      },
      "items": [
        {
          "text": "mucharamba muchiona asi musingaonesesi.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.26",
            "verseOrgIds": [
              "ACT.28.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti mwoyo yavanhu ava yava mikukutu;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.27",
            "verseOrgIds": [
              "ACT.28.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 28:27"
      },
      "items": [
        {
          "text": "havanzwisisi nenzeve dzavo,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.27",
            "verseOrgIds": [
              "ACT.28.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 28:27"
      },
      "items": [
        {
          "text": "uye vakatsinzina meso avo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.27",
            "verseOrgIds": [
              "ACT.28.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ACT 28:27"
      },
      "items": [
        {
          "text": "Zvimwe vangaona nameso avo,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.27",
            "verseOrgIds": [
              "ACT.28.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 28:27"
      },
      "items": [
        {
          "text": "vanganzwa nenzeve dzavo,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.27",
            "verseOrgIds": [
              "ACT.28.27"
            ]
          }
        }
