  "verseCount": 41,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "ACT 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pauro paEfeso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aporosi paakanga achiri paKorinde, Pauro akafamba nomugwagwa wakanga uchipinda nomukati menyika akasvika paEfeso. Akawana vamwe vadzidzi ipapo",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.1",
            "verseOrgIds": [
              "ACT.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "akavabvunza akati, \"Makagamuchira Mweya Mutsvene here pamakatenda?\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.2",
            "verseOrgIds": [
              "ACT.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ACT 19:2"
      },
      "items": [
        {
          "text": "Vakapindura vakati, \"Kwete, hatina kutongonzwa kuti kune Mweya Mutsvene isu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.2",
            "verseOrgIds": [
              "ACT.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Pauro akavabvunza akati, \"Zvino makagamuchira rubhabhatidzo rupi?\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.3",
            "verseOrgIds": [
              "ACT.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ACT 19:3"
      },
      "items": [
        {
          "text": "Vakapindura vakati, \"Rubhabhatidzo rwaJohani.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.3",
            "verseOrgIds": [
              "ACT.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pauro akati, \"Rubhabhatidzo rwaJohani rwaiva rubhabhatidzo rwokutendeuka. Akaudza vanhu kuti vatende kuna iye aizouya mumashure make, iye Jesu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.4",
            "verseOrgIds": [
              "ACT.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vanzwa izvi, vakabhabhatidzwa muzita raIshe Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.5",
            "verseOrgIds": [
              "ACT.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pauro akati aisa maoko ake pamusoro pavo, Mweya Mutsvene wakauya pamusoro pavo, uye vakataura nendimi vakaprofita.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.6",
            "verseOrgIds": [
              "ACT.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakanga vari varume vanenge gumi navaviri vose.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.7",
            "verseOrgIds": [
              "ACT.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pauro akapinda musinagoge akataura asingatyi imomo kwemwedzi mitatu, achikakavadzana navo zvinyoronyoro pamusoro poumambo hwaMwari.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.8",
            "verseOrgIds": [
              "ACT.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vamwe vavo vakaomesa mwoyo yavo; vakaramba kutenda uye vakatsoropodza Nzira iyo pamberi pavanhu. Saka Pauro akabva pavari. Akatora vadzidzi akaenda navo akandoita hurukuro navo zuva nezuva pachikoro chaTirano.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.9",
            "verseOrgIds": [
              "ACT.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi zvakaramba zvichiitwa kwamakore maviri, zvokuti vaJudha vose navaGiriki vaigara munyika yeEzhia vakanzwa shoko raShe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.10",
            "verseOrgIds": [
              "ACT.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari akaita mabasa anoshamisa kubudikidza naPauro,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.11",
            "verseOrgIds": [
              "ACT.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "zvokuti kunyange nehangachepfu namaapuroni akanga ari pamuviri wake zvakaendeswa kuvarwere, zvirwere zvavo zvikaporeswa uye mweya yakaipa ikabva pavari.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.12",
            "verseOrgIds": [
              "ACT.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamwe vaJudha vaifamba vachidzinga mweya yakaipa vakaedza kudana zita raJesu pamusoro paavo vakanga vakabatwa namadhimoni vachiti, \"Muzita raJesu, anoparidzwa naPauro, ndinokurayira kuti ubude.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.13",
            "verseOrgIds": [
              "ACT.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vanomwe vaSikevha muprista mukuru wavaJudha, vakanga vachiita izvozvo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.14",
            "verseOrgIds": [
              "ACT.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rimwe zuva mweya wakaipa wakavapindura ukati, \"Jesu ndinomuziva, uye ndinoziva nezvaPauro, asi imi ndimi vanaaniko?\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.15",
            "verseOrgIds": [
              "ACT.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo murume akanga ane mweya wakaipa akasvetukira pavari akavakurira vose. Akavarova zvokuti vakamhanya vachibuda mumba vasina kupfeka uye vachibuda ropa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.16",
            "verseOrgIds": [
              "ACT.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi zvakati zvazivikanwa navaJudha navaGiriki vaigara muEfeso, vose vakabatwa nokutya, uye zita raIshe Jesu rakakudzwa nokukudzwa kukuru.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.17",
            "verseOrgIds": [
              "ACT.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino vazhinji vavakanga vatenda vakauya vakareurura pachena mabasa avo akanga akaipa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.18",
            "verseOrgIds": [
              "ACT.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vazhinji vakanga vachiita zvounʼanga vakaunganidza mabhuku avo pamwe chete vakaapisa pamberi pavanhu. Vakati vaverenga mutengo wamabhuku acho, mari ikasvika madhirakema zviuru makumi mashanu",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.19",
            "verseOrgIds": [
              "ACT.19.19"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.19",
            "verseOrgIds": [
              "ACT.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenzira iyi shoko raMwari rakapararira kwazvo uye rikakura musimba.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.20",
            "verseOrgIds": [
              "ACT.19.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwokunge zvose izvi zvaitika, Pauro akafunga zvokuenda kuJerusarema achipfuura nokuMasedhonia, nokuAkaya achiti, \"Kana ndambosvika ikoko, ndinofanira kushanyirawo Roma.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.21",
            "verseOrgIds": [
              "ACT.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatuma vabatsiri vake vaviri, Timoti naErastasi, kuMasedhonia, iye achimbosara munyika yeEzhia kwechinguva.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.22",
            "verseOrgIds": [
              "ACT.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bope muEfeso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenguva yakaita saiyoyo bope guru rakamuka pamusoro peNzira iyi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.23",
            "verseOrgIds": [
              "ACT.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe mupfuri wesirivha ainzi Dhemetiri akanga achigadzira zvitemberi zvesirivha zvaAritemisi, zvakanga zvichipfumisa zvikuru mhizha dzavo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.24",
            "verseOrgIds": [
              "ACT.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akavaunganidza vose, pamwe chete navabati vaishanda mabasa akadaro, akati kwavari, \"Varume, imi munoziva kuti takanga tichiwana pfuma yakanaka nebasa iri.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.25",
            "verseOrgIds": [
              "ACT.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino munozvionawo nokuzvinzwira kuti murume uyu Pauro akadzidzisa uye akatsausa vanhu vazhinji muno muEfeso, uye zviri pachena kuti nomunyika yose yeEzhia zvayo, anoti vamwari vakaitwa navanhu havasi vamwari chaivo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.26",
            "verseOrgIds": [
              "ACT.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino njodzi iripo ndeyokuti harizi basa redu bedzi richarasikirwa nembiri yaro, asiwo temberi yamwari wedu mukuru, Aritemisi, ichazvidzwa uye iye mwarikadzi pachake, anova ndiye ari kunamatwa munyika yose yeEzhia uye nenyika yose, achatorerwa ukuru hwake.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.27",
            "verseOrgIds": [
              "ACT.19.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vanzwa izvi, vakashatirwa vakatanga kudanidzira vachiti, \"Mukuru ndiAritemisi wavaEfeso!\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.28",
            "verseOrgIds": [
              "ACT.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakarepo guta rose rakanyonganiswa. Vanhu vakabata Gayo naAristakusi, shamwari dzaPauro dzaaifamba nadzo dzaibva kuMasedhonia, vakamhanya navo nomwoyo mumwe vakapinda navo munhandare.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.29",
            "verseOrgIds": [
              "ACT.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pauro akanga achida kuzviratidza pamberi pemhomho, asi vadzidzi vakamudzivisa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.30",
            "verseOrgIds": [
              "ACT.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange vamwe vakuru veEzhia, shamwari dzaPauro, vakamutumira shoko vachimukumbirisa kuti arege kuedza kupinda munhandare.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.31",
            "verseOrgIds": [
              "ACT.19.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungano yakanga yanyonganiswa: vamwe vaidaidzira chimwe chinhu, vamwe chimwe. Vazhinji vavanhu vakanga vasingatongozivi kuti sei vakanga varipo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.32",
            "verseOrgIds": [
              "ACT.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaJudha vakasundidzira Arekizanda mberi, uye vamwe vazhinji vaidanidzira vachimurayira zvokuita. Akaninira vanhu kuti vanyarare kuitira kuti agone kuzvidavirira pamberi pavanhu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.33",
            "verseOrgIds": [
              "ACT.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi pavakaona kuti iye aiva muJudha, vose vakadanidzira pamwe chete kwenguva dzinenge maawa maviri vachiti, \"Mukuru ndiAritemisi wavaEfeso!\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.34",
            "verseOrgIds": [
              "ACT.19.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyori weguta akanyaradza vanhu akati, \"Varume veEfeso, ko, nyika yose haizivi here kuti guta reEfeso ndiro rinochengeta temberi yaAritemisi mukuru nomufananidzo wake, uyo wakawa uchibva kudenga?",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.35",
            "verseOrgIds": [
              "ACT.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo, sezvo izvi zvisingagoni kurambika, munofanira kuti munyarare murege kumhanyira kuita chinhu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.36",
            "verseOrgIds": [
              "ACT.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mauya navarume ava pano, kunyange zvavo vasina kuba temberi dzedu kana kumhura mwarikadzi wedu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.37",
            "verseOrgIds": [
              "ACT.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino, kana Dhemetiri nedzimwe mhizha dzaanadzo vakange vane mhosva naani zvake, matare edzimhosva akazarurwa uye vatongi varimo. Vanogona kuvakwirira havo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.38",
            "verseOrgIds": [
              "ACT.19.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 19:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana pane chimwe chinhuzve chamungada kutaura, chinofanira kutaurwa paungano iri pamutemo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.39",
            "verseOrgIds": [
              "ACT.19.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 19:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi sezvazviri izvi, tiri panjodzi yokuti tingangopiwa mhosva yokumutsa bongozozo nokuda kwezvaitika nhasi. Kana pane chimwezve chamungada kutaura, chinofanira kutaurwa paungano iri pamutemo.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.40",
            "verseOrgIds": [
              "ACT.19.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati ataura izvi, akarayira kuti ungano iparare.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.41",
            "verseOrgIds": [
              "ACT.19.40"
            ]
          }
        }
      ]
    }
  ],
