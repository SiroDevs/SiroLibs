{
  "id": "ECC.8",
  "number": "8",
  "bookId": "ECC",
  "reference": "Muparidzi 8",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "ECC 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiani akafanana nomunhu akachenjera?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.1",
            "verseOrgIds": [
              "ECC.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 8:1"
      },
      "items": [
        {
          "text": "Ndiani anoziva tsananguro yezvinhu?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.1",
            "verseOrgIds": [
              "ECC.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 8:1"
      },
      "items": [
        {
          "text": "Uchenjeri hunobwinyisa chiso chomunhu",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.1",
            "verseOrgIds": [
              "ECC.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 8:1"
      },
      "items": [
        {
          "text": "uye hunoshandura kuomarara kwechiso.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.1",
            "verseOrgIds": [
              "ECC.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Teerera Mambo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinoti, teerera murayiro wamambo, nokuti wakaita mhiko pamberi paMwari.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.2",
            "verseOrgIds": [
              "ECC.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usakurumidza kubva pamberi pamambo. Usamiririra zvinhu zvakaipa, nokuti iye achaita chinhu chipi zvacho chinomufadza.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.3",
            "verseOrgIds": [
              "ECC.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezvo shoko ramambo riri pamusoro pamashoko ose, ndiani angati kwaari, \"Munoiteiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.4",
            "verseOrgIds": [
              "ECC.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani naani zvake achateerera murayiro wake haangawani chinomukuvadza,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.5",
            "verseOrgIds": [
              "ECC.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 8:5"
      },
      "items": [
        {
          "text": "uye mwoyo wakachenjera uchaziva nguva yakafanira namaitiro akafanira.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.5",
            "verseOrgIds": [
              "ECC.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti kune nguva yakafanira namaitiro akafanira pazvinhu zvose,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.6",
            "verseOrgIds": [
              "ECC.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 8:6"
      },
      "items": [
        {
          "text": "kunyange nhamo yomunhu ichimuremera zvikuru.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.6",
            "verseOrgIds": [
              "ECC.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezvo pasina munhu anoziva ramangwana,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.7",
            "verseOrgIds": [
              "ECC.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 8:7"
      },
      "items": [
        {
          "text": "ndiani angamuzivisa zvichauya?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.7",
            "verseOrgIds": [
              "ECC.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuna munhu ane simba pamusoro pemhepo kuti aitonge;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.8",
            "verseOrgIds": [
              "ECC.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 8:8"
      },
      "items": [
        {
          "text": "saizvozvowo hakuna munhu ane simba pamusoro pezuva rokufa kwake.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.8",
            "verseOrgIds": [
              "ECC.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 8:8"
      },
      "items": [
        {
          "text": "Sezvo kusinawo munhu anoregedzeswa kurwa panguva yehondo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.8",
            "verseOrgIds": [
              "ECC.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 8:8"
      },
      "items": [
        {
          "text": "saizvozvowo zvakaipa hazvingaregedzi uyo anozviita.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.8",
            "verseOrgIds": [
              "ECC.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvose izvi ndakazviona, pandakaisa pfungwa dzangu pane zvose zvinoitwa pasi pezuva. Pane nguva yokuti mumwe munhu anenge ane simba pamusoro pavamwe, asi achizvikuvadza pachake.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.9",
            "verseOrgIds": [
              "ECC.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino ndakaonazve vakaipa vachivigwa mumakuva, vose vaisiuya nokuenda kubva kunzvimbo tsvene uye vachirumbidzwa muguta mavaiitira izvi. Naizvozviwo hazvina maturo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.10",
            "verseOrgIds": [
              "ECC.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana mhosva ikarega kukurumidza kutongwa, mwoyo yavanhu ichazara nezvirongwa zvokuita zvakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.11",
            "verseOrgIds": [
              "ECC.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange munhu akaipa akapara mhosva dzinosvika zana agorarama nguva refu, ndinoziva kuti zvichava nani kuna vanhu vanotya Mwari, avo vanokudza Mwari.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.12",
            "verseOrgIds": [
              "ECC.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi nokuti vakaipa havatyi Mwari, hazvizovanakira, uye mazuva avo haangarebi somumvuri.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.13",
            "verseOrgIds": [
              "ECC.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pane chimwezve chinhu chisina maturo chinoitika panyika: Vanhu vakarurama vanoitirwa zvakafanira kuitirwa vakaipa, uye vanhu vakaipa vanowana zvakafanira kuwanikwa navakarurama. Naizvozviwo ndinoti hazvina maturo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.14",
            "verseOrgIds": [
              "ECC.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka ndinokurudzira vanhu kuti vafadzwe noupenyu, nokuti hapana chinhu chiri nani kumunhu pasi pezuva kupfuura kudya nokunwa nokufara. Ipapo mufaro uchamutevera mubasa rake mazuva ose oupenyu hwaakapiwa naMwari pasi pezuva.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.15",
            "verseOrgIds": [
              "ECC.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pandakaisa pfungwa dzangu kuti ndizive uchenjeri nokuongorora mabasa omunhu panyika, maziso ake asingawani hope usiku namasikati,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.16",
            "verseOrgIds": [
              "ECC.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ipapo ndakaona zvose zvakaitwa naMwari. Hapana munhu angazvinzwisisa zvinoitika pasi pezuva. Hazvinei kuti munhu anoedza sei kuzvitsvaka, munhu haangagoni kuziva zvazvinoreva. Kunyange munhu akachenjera akati anozviziva haangakwanisi kunyatsozvinzwisisa.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.17",
            "verseOrgIds": [
              "ECC.8.17"
            ]
          }
        }
      ]
    }
  ],
