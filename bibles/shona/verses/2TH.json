    "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
    "verseCount": 12,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "1",
          "style": "c",
          "sid": "2TH 1"
        },
        "items": [
          {
            "text": "1",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "2TH 1:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Pauro, Sirasi naTimoti, kukereke yavaTesaronika muna Mwari Baba vedu naIshe Jesu Kristu:",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.1",
              "verseOrgIds": [
                "2TH.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "2TH 1:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nyasha norugare zvinobva kuna Mwari ivo Baba nokuna Ishe wedu Jesu Kristu.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.2",
              "verseOrgIds": [
                "2TH.1.2"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Kuvonga noKunyengetera",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "2TH 1:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Tinofanira kuramba tichivonga Mwari nguva dzose nokuda kwenyu, hama, uye zvakanaka izvozvo, nokuti kutenda kwenyu kuri kukura zvakanyanya, uye rudo rwamunarwo kuno mumwe nomumwe wenyu rwuri kukura.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.3",
              "verseOrgIds": [
                "2TH.1.3"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "2TH 1:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Naizvozvo, pakati pekereke dzaMwari tinozvirumbidza pamusoro pokutsungirira kwenyu uye nokutenda kwenyu nomukutambudzika kwose nokuedzwa kwamunotsunga makuri.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.4",
              "verseOrgIds": [
                "2TH.1.4"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "2TH 1:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "Zvose izvi ndizvo zvinoratidza kuti kutonga kwaMwari kwakarurama, uye nokuda kwaizvozvi muchanzi makafanirwa noumambo hwaMwari, ihwo hwamunotamburira.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.5",
              "verseOrgIds": [
                "2TH.1.5"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "2TH 1:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Mwari anoruramisira: Achatsiva nokutambudza avo vanokutambudzai,",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.6",
              "verseOrgIds": [
                "2TH.1.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "2TH 1:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "uye agozorodza imi vari kutambudzika, uye nesuwo. Izvi zvichaitika Ishe Jesu paacharatidzwa kubva kudenga mumurazvo womoto unopfuta ane vatumwa vake vane simba.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.7",
              "verseOrgIds": [
                "2TH.1.7"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "2TH 1:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "Acharanga vaya vasingazivi Mwari uye vasingateereri vhangeri raIshe wedu Jesu.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.8",
              "verseOrgIds": [
                "2TH.1.8"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "2TH 1:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Vacharangwa nokuparadzwa kusingaperi, uye vachapfigirwa kunze pamberi paIshe, uye napaukuru hwesimba rake,",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.9",
              "verseOrgIds": [
                "2TH.1.9"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "2TH 1:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "pazuva raanouya kuzokudzwa muvanhu vake vatsvene uye sechishamiso pakati paavo vose vakatenda. Izvi zvinosanganisira imi, nokuti makatenda uchapupu hwedu kwamuri.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.10",
              "verseOrgIds": [
                "2TH.1.10"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "2TH 1:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nomurangariro uyu, isu tinoramba tichikunyengetererai, kuti Mwari wedu ati makafanira kudana kwake, uye kuti nesimba rake azadzise zvinangwa zvenyu zvose zvakanaka nebasa rose rakamutswa nokutenda kwenyu.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.11",
              "verseOrgIds": [
                "2TH.1.11"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "2TH 1:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "Tinonyengeterera izvi kuitira kuti zita raIshe wedu Jesu rikudzwe mamuri, uye imi maari, maererano nenyasha dzaMwari wedu naIshe Jesu Kristu.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.1.12",
              "verseOrgIds": [
                "2TH.1.12"
              ]
            }
          }
        ]
      }
    ],
    "next": {
      "id": "2TH.2",
      "number": "2",
      "bookId": "2TH"
    },
    "previous": {
      "id": "2TH.intro",
      "number": "intro",
      "bookId": "2TH"
    }
  },
  "2TH.2": {
    "id": "2TH.2",
    "number": "2",
    "bookId": "2TH",
    "reference": "2 VaTesaronika 2",
    "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
    "verseCount": 17,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "2",
          "style": "c",
          "sid": "2TH 2"
        },
        "items": [
          {
            "text": "2",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Munhu woKutsauka",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "2TH 2:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Pamusoro pezvokuuya kwaIshe wedu Jesu Kristu uye nokuungana kwedu kwaari, tinokukumbirai, hama,",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.1",
              "verseOrgIds": [
                "2TH.2.1"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "2TH 2:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "kuti murege kuzungunuswa kana kuvhundutswa nechimwe chiprofita, chiziviso kana tsamba inonzi yakabva kwatiri, ichiti zuva raShe ratosvika.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.2",
              "verseOrgIds": [
                "2TH.2.2"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "2TH 2:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Musarega munhu upi zvake achikunyengerai nenzira ipi zvayo, nokuti zuva iro harisviki kusvikira kumukira kwaitika uye munhu wokutsauka aratidzwa, iye munhu akatongerwa kuparadzwa.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.3",
              "verseOrgIds": [
                "2TH.2.3"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "2TH 2:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Achapikisa uye achazvisimudzira pamusoro pezvinhu zvinonzi Mwari kana zvinonamatwa, nokudaro anozvigadza mutemberi yaMwari achizviita Mwari.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.4",
              "verseOrgIds": [
                "2TH.2.4"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "2TH 2:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "Hamurangariri here kuti pandaiva nemi ndaisikuudzai zvinhu izvi?",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.5",
              "verseOrgIds": [
                "2TH.2.5"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "2TH 2:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Uye iye zvino munoziva chinomudzivisa, kuti aratidzwe nenguva yakafanira.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.6",
              "verseOrgIds": [
                "2TH.2.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "2TH 2:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nokuti chakavanzika chesimba rokutsauka chotoshanda basa; asi uyo anomudzivisa zvino acharamba achiita izvozvo kusvikira iye abviswa.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.7",
              "verseOrgIds": [
                "2TH.2.7"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "2TH 2:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "Uye ipapo munhu wokutsauka achazoratidzwa, uyo achaparadzwa naIshe Jesu nokufema kwomuromo wake, achimuparadza nokubwinya kwokuuya kwake.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.8",
              "verseOrgIds": [
                "2TH.2.8"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "2TH 2:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Kuuya kwomunhu wokutsauka kuchaitika sebasa raSatani kuchiratidza nemhando dzose dzezvishamiso zvenhema, zviratidzo neminana,",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.9",
              "verseOrgIds": [
                "2TH.2.9"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "2TH 2:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "uye nokuipa kwose kunonyengera avo vanoparara. Vanoparara nokuti vakaramba kuda chokwadi uti vagoponeswa.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.10",
              "verseOrgIds": [
                "2TH.2.10"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "2TH 2:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nokuda kwaizvozvi, Mwari anovatumira mweya une simba wokunyengera kuti vatende nhema",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.11",
              "verseOrgIds": [
                "2TH.2.11"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "2TH 2:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "uye kuti vose vagotongwa, avo vasina kutenda chokwadi, asi vakafarira zvakaipa.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.12",
              "verseOrgIds": [
                "2TH.2.12"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Mirai neSimba",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "13",
              "style": "v",
              "sid": "2TH 2:13"
            },
            "items": [
              {
                "text": "13",
                "type": "text"
              }
            ]
          },
          {
            "text": "Asi tinofanira kuvonga Mwari nguva dzose nokuda kwenyu, hama dzinodiwa naIshe, nokuti kubva pakutanga Mwari akakusarudzai kuti muponeswe nebasa rokuchenesa roMweya uye nokutenda chokwadi.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.13",
              "verseOrgIds": [
                "2TH.2.13"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "14",
              "style": "v",
              "sid": "2TH 2:14"
            },
            "items": [
              {
                "text": "14",
                "type": "text"
              }
            ]
          },
          {
            "text": "Akakudanirai izvi nevhangeri redu, kuti mugovane mukubwinya kwaIshe wedu Jesu Kristu.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.14",
              "verseOrgIds": [
                "2TH.2.14"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "15",
              "style": "v",
              "sid": "2TH 2:15"
            },
            "items": [
              {
                "text": "15",
                "type": "text"
              }
            ]
          },
          {
            "text": "Saka zvino, hama mirai nesimba uye mubatirire kudzidziso dzatakakudzidzisai, neshoko romuromo kana netsamba.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.15",
              "verseOrgIds": [
                "2TH.2.15"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "16",
              "style": "v",
              "sid": "2TH 2:16"
            },
            "items": [
              {
                "text": "16",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ishe wedu Jesu Kristu pachake uye Mwari Baba vedu, iye akatida uye nenyasha dzake akatipa upenyu husingaperi, kurudziro netariro yakanaka,",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.16",
              "verseOrgIds": [
                "2TH.2.16"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "17",
              "style": "v",
              "sid": "2TH 2:17"
            },
            "items": [
              {
                "text": "17",
                "type": "text"
              }
            ]
          },
          {
            "text": "ngaakurudzire mwoyo yenyu uye akusimbisei mumabasa nomumashoko ose akanaka.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.2.17",
