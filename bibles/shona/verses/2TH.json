  "2TH.3": {
    "id": "2TH.3",
    "number": "3",
    "bookId": "2TH",
    "reference": "2 VaTesaronika 3",
    "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
    "verseCount": 18,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "3",
          "style": "c",
          "sid": "2TH 3"
        },
        "items": [
          {
            "text": "3",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Chikumbiro choMunyengetero",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "2TH 3:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Pakupedzisira, hama, mutinyengetererewo kuti shoko raShe rikurumidze kuparadzirwa uye kuti rikudzwe, sezvazvakanga zvakaita kwamuri.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.1",
              "verseOrgIds": [
                "2TH.3.1"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "2TH 3:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "Uye munyengetere kuti tirwirwe kubva kune akaipa, nokuti havasi vose vanotenda.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.2",
              "verseOrgIds": [
                "2TH.3.2"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "2TH 3:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Asi Ishe akatendeka, uye achakusimbisai nokukudzivirirai kubva kune akaipa.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.3",
              "verseOrgIds": [
                "2TH.3.3"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "2TH 3:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Tinotenda muna She kuti muri kuita uye mucharamba muchiita zvinhu zvatinokurayirai.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.4",
              "verseOrgIds": [
                "2TH.3.4"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "2TH 3:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "Mwari ngaatungamirire mwoyo yenyu murudo rwaMwari uye nomukutsungirira kwaKristu.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.5",
              "verseOrgIds": [
                "2TH.3.5"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Yambiro pamusoro poUsimbe",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "2TH 3:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Muzita raIshe Jesu Kristu, tinokurayirai hama, kuti mubve pahama imwe neimwe inoita zvousimbe uye isingararami maererano nedzidziso yamakagamuchira kubva kwatiri.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.6",
              "verseOrgIds": [
                "2TH.3.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "2TH 3:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nokuti imi pachenyu munoziva kuti munofanira kutevera sei muenzaniso wedu. Takanga tisiri simbe patakanga tinemi,",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.7",
              "verseOrgIds": [
                "2TH.3.7"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "2TH 3:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "uye hatina kudya chokudya chomunhu tisingaripi. Asi, takashanda usiku namasikati, tichishanda zvikuru uye tichitambudzika kuitira kuti tirege kuva mutoro kwamuri.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.8",
              "verseOrgIds": [
                "2TH.3.8"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "2TH 3:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Takaita izvi, kwete nokuda kwokuti hatina kodzero yokuti tibatsirwe pakadaro, asi kuitira kuti tive muenzaniso kwamuri wokuti mutevere.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.9",
              "verseOrgIds": [
                "2TH.3.9"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "2TH 3:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nokuti kunyange pataiva nemi, takakupai murayiro uyu wokuti: \"Kana munhu asingashandi, ngaarege kudya.\"",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.10",
              "verseOrgIds": [
                "2TH.3.10"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "2TH 3:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Tinonzwa kuti vamwe pakati penyu vane usimbe. Havashandi; havaregi zvavamwe.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.11",
              "verseOrgIds": [
                "2TH.3.11"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "2TH 3:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "Vanhu vakadaro tinovarayira uye tinovakurudzira muna Ishe Jesu Kristu kuti vashande chinyararire vagodya chingwa chavanoshandira.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.12",
              "verseOrgIds": [
                "2TH.3.12"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "13",
              "style": "v",
              "sid": "2TH 3:13"
            },
            "items": [
              {
                "text": "13",
                "type": "text"
              }
            ]
          },
          {
            "text": "Uye kana murimi, hama, musaneta pakuita zvakanaka.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.13",
              "verseOrgIds": [
                "2TH.3.13"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "14",
              "style": "v",
              "sid": "2TH 3:14"
            },
            "items": [
              {
                "text": "14",
                "type": "text"
              }
            ]
          },
          {
            "text": "Kana pano munhu asingateereri kurayira kwedu mutsamba iyi, mumungwarire. Musafambidzana naye, kuitira kuti anyare.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.14",
              "verseOrgIds": [
                "2TH.3.14"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "15",
              "style": "v",
              "sid": "2TH 3:15"
            },
            "items": [
              {
                "text": "15",
                "type": "text"
              }
            ]
          },
          {
            "text": "Asi musamutora somuvengi, asi mumuyambire sehama.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.15",
              "verseOrgIds": [
                "2TH.3.15"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Mashoko Okupedzisira",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "16",
              "style": "v",
              "sid": "2TH 3:16"
            },
            "items": [
              {
                "text": "16",
                "type": "text"
              }
            ]
          },
          {
            "text": "Zvino Ishe worugare ngaakupei rugare nguva dzose nomunzira dzose.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.16",
              "verseOrgIds": [
                "2TH.3.16"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "17",
              "style": "v",
              "sid": "2TH 3:17"
            },
            "items": [
              {
                "text": "17",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ini Pauro, ndanyora kwaziso iyi noruoko rwangu, chinova ndicho chiratidzo mutsamba dzangu dzose.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.17",
              "verseOrgIds": [
                "2TH.3.17"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "18",
              "style": "v",
              "sid": "2TH 3:18"
            },
            "items": [
              {
                "text": "18",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nyasha dzaIshe wedu Jesu Kristu ngadzive nemi mose.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.18",
              "verseOrgIds": [
                "2TH.3.18"
              ]
            }
          }
        ]
      }
    ],
