  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "MRK 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kumuka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sabata rakati rapfuura, Maria Magadharena, Maria mai vaJakobho, naSarome vakatenga zvinonhuhwira kuti vagondozodza mutumbi waJesu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.1",
            "verseOrgIds": [
              "MRK.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mangwanani-ngwanani pazuva rokutanga revhiki, zuva risati rabuda, vakanga vapinda munzira,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.2",
            "verseOrgIds": [
              "MRK.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye vakabvunzana vachiti, \"Ndianiko achatikungurutsira ibwe pamukova weguva?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.3",
            "verseOrgIds": [
              "MRK.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vakati vatarira, vakaona kuti ibwe rakanga rakungurutswa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.4",
            "verseOrgIds": [
              "MRK.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pavakapinda muguva, vakaona jaya rakapfeka nguo chena rakagara kuruoko rworudyi, uye vakavhunduka.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.5",
            "verseOrgIds": [
              "MRK.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akati, \"Musavhunduka. Muri kutsvaka Jesu weNazareta, uya akarovererwa pamuchinjikwa. Amuka! Haapo pano. Tarisai pavakanga vamuisa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.6",
            "verseOrgIds": [
              "MRK.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi chiendai mundoudza vadzidzi vake naPetro, kuti, 'Afanotungamira kuGarirea. Muchandomuona ikoko sezvaakakuudzai.' \"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.7",
            "verseOrgIds": [
              "MRK.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vachibvunda uye vachishamiswa, vakabuda vakatiza kubva muguva. Havana chavakataura kuno munhu, nokuti vakanga vachitya.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.8",
            "verseOrgIds": [
              "MRK.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati amuka mangwanani nezuva rokutanga revhiki, akatanga kuzviratidza kuna Maria Magadharena, uya waakanga abudisa kubva maari mweya yakaipa minomwe.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.9",
            "verseOrgIds": [
              "MRK.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaenda akandoudza vaya vaimbova naye, vakanga vachiungudza uye vachichema.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.10",
            "verseOrgIds": [
              "MRK.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vanzwa kuti Jesu akanga ari mupenyu, uye kuti Maria akanga amuona, havana kuzvitenda.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.11",
            "verseOrgIds": [
              "MRK.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwaizvozvo Jesu akaonekwazve neimwe nzira navaviri vavo pavakanga vachifamba kuruwa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.12",
            "verseOrgIds": [
              "MRK.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ava vakadzoka vakandozivisa vakasara; asi naivowo havana kuvatenda.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.13",
            "verseOrgIds": [
              "MRK.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure maizvozvo Jesu akazviratidza kuna vane gumi nomumwe pavakanga vachidya; akavatsiura pamusoro pokusatenda kwavo uye nokusindimara kwemwoyo yavo pakuramba kutenda vaya vakanga vamuona mushure mokumuka kwake.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.14",
            "verseOrgIds": [
              "MRK.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kwavari, \"Endai munyika yose muparidze vhangeri kuzvisikwa zvose.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.15",
            "verseOrgIds": [
              "MRK.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani naani anotenda uye akabhabhatidzwa achaponeswa, asi asingatendi achatongwa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.16",
            "verseOrgIds": [
              "MRK.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye zviratidzo izvi zvichatevera vanotenda: Vachadzinga mweya yakaipa muzita rangu, vachataura nendimi itsva;",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.17",
            "verseOrgIds": [
              "MRK.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "vachabata nyoka namaoko avo, uye kunyange vakanwa muchetura unouraya haungavakuvadzi napaduku; vachaisa maoko avo pamusoro pavarwere, uye vachapora.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.18",
            "verseOrgIds": [
              "MRK.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure mokunge Ishe Jesu ataura kwavari, akatorwa akakwidzwa kudenga uye akandogara kuruoko rworudyi rwaMwari.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.19",
            "verseOrgIds": [
              "MRK.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vadzidzi vakabuda vakandoparidza kwose kwose, uye Ishe akashanda navo, akasimbisa shoko rake nezviratidzo zvakatevera.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.20",
            "verseOrgIds": [
              "MRK.16.20"
            ]
          }
        }
      ]
    }
  ],
