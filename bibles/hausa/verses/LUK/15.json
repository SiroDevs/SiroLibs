              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bawan ya ce, 'Ai, ɗan'uwanka ne ya dawo, shi ne mahaifinka ya yanka ɗan saniya mai ƙiba, gama ya yi murna ya karɓi ɗansa da ya dawo gida lafiyayye, ba abin da ya same shi.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.27",
                "verseOrgIds": [
                  "LUK.15.27"
                ]
              }
            }
          ]
        }
