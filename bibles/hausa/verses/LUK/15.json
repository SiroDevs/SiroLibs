        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Sai yayan ya yi fushi, ya ƙi shiga gida. Sai mahaifinsa ya fita ya roƙe shi.",
