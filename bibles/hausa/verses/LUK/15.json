              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Amma ya amsa wa mahaifinsa ya ce, 'Duba! Duk waɗannan shekaru, ina yin maka aiki kamar bawa, ban taɓa maka rashin biyayya ba. Duk da haka, ba ka taɓa ba ni ko ɗan akuya domin in yi shagali da abokaina ba.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.29",
                "verseOrgIds": [
                  "LUK.15.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.29",
            "verseOrgIds": [
              "LUK.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Amma da wannan ɗan naka, wanda ya ɓatar da dukiyarka a kan karuwai ya dawo, ka yanka masa ɗan saniya mai ƙiba!'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.30",
                "verseOrgIds": [
                  "LUK.15.30"
                ]
              }
            }
          ]
        }
      ]
