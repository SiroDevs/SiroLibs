        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Amma mahaifin ya ce wa bayinsa, 'Maza! Ku kawo riga mafi kyau ku sa masa. Ku sa zobe a yatsarsa, da takalma kuma a ƙafafunsa.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.22",
                "verseOrgIds": [
                  "LUK.15.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.22",
            "verseOrgIds": [
              "LUK.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
