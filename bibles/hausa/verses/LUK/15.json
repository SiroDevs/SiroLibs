        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Sai mahaifin ya ce masa, 'Ɗana, kullum kana nan tare da ni, kuma duk abin da nake da shi, naka ne.",
