          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "A dā Allah ya kawar da Allah ya kawar da kai ga zamanin jahilci, amma yanzu ya umarci dukan mutane a ko'ina su tuba.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.30",
            "verseOrgIds": [
              "ACT.17.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 17:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gama ya sa ranar da zai yi wa duniya shari'a da adalci ta wurin mutumin da ya naɗa. Ya riga ya ba da tabbacin wannan ga dukan mutane ta wurin tā da shi daga matattu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.31",
            "verseOrgIds": [
              "ACT.17.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
