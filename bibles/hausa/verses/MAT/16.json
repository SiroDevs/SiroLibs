              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Zan ba ka mabuɗan mulkin sama; kome ka daure a duniya zai zama a daure a sama, kome kuma ka kunce a duniya zai zama a kunce a sama.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.19",
                "verseOrgIds": [
                  "MAT.16.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.19",
            "verseOrgIds": [
              "MAT.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sa'an nan ya gargaɗe almajiransa cewa kada su faɗa wa kowa shi ne Kiristi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.20",
            "verseOrgIds": [
              "MAT.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu ya yi zancen mutuwarsa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(Markus 8.31–9.1;",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
