  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "MAT 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Neman alama",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.8.11-MRK.8.13"
          },
          "items": [
            {
              "text": "Markus 8.11-13",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.12.54-LUK.12.56"
          },
          "items": [
            {
              "text": "Luka 12.54-56",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farisiyawa da Sadukiyawa suka zo don su gwada Yesu ta wurin neman yă nuna musu wata alama daga sama.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.1",
            "verseOrgIds": [
              "MAT.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya amsa ya ce,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.2",
            "verseOrgIds": [
              "MAT.16.2"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.2",
            "verseOrgIds": [
              "MAT.16.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Sa'ad da yamma ta yi, kukan ce, 'Yanayi zai yi kyau, gama sararin sama ya yi ja,'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.2",
                "verseOrgIds": [
                  "MAT.16.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.2",
            "verseOrgIds": [
              "MAT.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "da safe kuma, ku ce, 'Yau kam za a yi hadari, gama sararin sama ya yi ja, ya kuma ɓata fuska.' Kun san yadda za ku fassara yanayin sararin sama, amma ba kwa iya fassarar alamun lokuta.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.3",
                "verseOrgIds": [
                  "MAT.16.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.3",
            "verseOrgIds": [
              "MAT.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Wannan mugu da mazinacin zamani yana neman wani abin banmamaki, amma ba wata alamar da za a nuna wa wannan zamani sai dai ta Yunana.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.4",
                "verseOrgIds": [
                  "MAT.16.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Sai Yesu ya bar su ya tafi abinsa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.4",
            "verseOrgIds": [
              "MAT.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yistin Farisiyawa da Sadukiyawa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.8.14-MRK.8.21"
          },
          "items": [
            {
              "text": "Markus 8.14-21",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Da suka ƙetare tafkin, almajiran sun manta su riƙe burodi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.5",
            "verseOrgIds": [
              "MAT.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ya ce musu,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.6",
            "verseOrgIds": [
              "MAT.16.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ku yi hankali, ku yi taka zallan da yistin Farisiyawa da Sadukiyawa.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.6",
                "verseOrgIds": [
                  "MAT.16.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sai suka fara tattaunawa da junansu suna cewa, \"Ko don ba mu kawo burodi ba ne.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.7",
            "verseOrgIds": [
              "MAT.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sane da abin da suke zance, sai Yesu ya ce,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.8",
            "verseOrgIds": [
              "MAT.16.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ku masu ƙarancin bangaskiya, don me kuke magana da junanku a kan ba ku zo da burodi ba?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.8",
                "verseOrgIds": [
                  "MAT.16.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.8",
            "verseOrgIds": [
              "MAT.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Har yanzu ba ku gane ba ne? Ba ku tuna da gurasa biyar ɗin nan na mutum dubu biyar ba? Kwando nawa kuka tattara cike?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.9",
                "verseOrgIds": [
                  "MAT.16.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.9",
            "verseOrgIds": [
              "MAT.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ko kuma burodi bakwai nan na mutum dubu huɗu, cikakku manyan kwanduna nawa kuka ɗauka?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.10",
                "verseOrgIds": [
                  "MAT.16.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.10",
            "verseOrgIds": [
              "MAT.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yaya kuka kāsa gane cewa ba zancen burodi nake yi ba? Sai dai ku yi hankali da yistin Farisiyawa da Sadukiyawa.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.11",
                "verseOrgIds": [
                  "MAT.16.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.11",
            "verseOrgIds": [
              "MAT.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sa'an nan suka gane ba cewa yake musu su yi hankali da yistin da ake amfani da shi a burodi ba ne, sai dai su yi hankali da koyarwar Farisiyawa da Sadukiyawa ne.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.12",
            "verseOrgIds": [
              "MAT.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Shaidar Bitrus a kan Kiristi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.8.27-MRK.8.30"
          },
          "items": [
            {
              "text": "Markus 8.27-30",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.9.18-LUK.9.21"
          },
          "items": [
            {
              "text": "Luka 9.18-21",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sa'ad da Yesu ya zo yankin Kaisariya Filibbi, sai ya tambayi almajiransa ya ce,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.13",
            "verseOrgIds": [
              "MAT.16.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Wa mutane suke ce da Ɗan Mutum?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.13",
                "verseOrgIds": [
                  "MAT.16.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suka amsa, \"Waɗansu suna ce Yohanna Mai Baftisma; waɗansu kuma suna ce annabi Iliya; har wa yau waɗansu suna ce Irmiya ne ko kuma ɗaya daga cikin annabawa.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.14",
            "verseOrgIds": [
              "MAT.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya tambaye su,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.15",
            "verseOrgIds": [
              "MAT.16.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Amma ku fa, wane ne ni a ganinku?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.15",
                "verseOrgIds": [
                  "MAT.16.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siman Bitrus ya amsa ya ce, \"Kai ne Kiristi,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.16",
            "verseOrgIds": [
              "MAT.16.16"
            ]
          }
        },
        {
          "text": "Ɗan Allah mai rai.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.16",
            "verseOrgIds": [
              "MAT.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ya amsa ya ce,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.17",
            "verseOrgIds": [
              "MAT.16.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mai albarka ne kai Siman ɗan Yunana, gama ba mutum ne ya bayyana maka wannan ba, sai dai Ubana da yake cikin sama.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.17",
                "verseOrgIds": [
                  "MAT.16.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.17",
            "verseOrgIds": [
              "MAT.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ina kuwa gaya maka, kai ne Bitrus,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.18",
                "verseOrgIds": [
                  "MAT.16.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.18",
            "verseOrgIds": [
              "MAT.16.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "a kan wannan dutse zan gina ikkilisiyata, kuma ƙofofin Hades",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.18",
                "verseOrgIds": [
                  "MAT.16.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.18",
