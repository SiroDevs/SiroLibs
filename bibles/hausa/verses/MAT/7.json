    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ɗora wa waɗansu laifi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.6.37"
          },
          "items": [
            {
              "text": "Luka 6.37",
              "type": "text"
            }
          ]
        },
        {
          "text": ",",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.6.38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": ",",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.6.41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": ",",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.6.42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kada ku ba wa kowa laifi, don kada a ba ku laifi ku ma.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.1",
                "verseOrgIds": [
                  "MAT.7.1"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.1",
            "verseOrgIds": [
              "MAT.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gama da irin shari'ar da kuka yi wa waɗansu, da ita za a shari'anta ku. Mudun da kuka yi awo da shi, da shi za a yi muku.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.2",
                "verseOrgIds": [
                  "MAT.7.2"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Don me kake duban ɗan tsinken da yake idon ɗan'uwanka, alhali kuwa ga gungume a naka ido?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.3",
                "verseOrgIds": [
                  "MAT.7.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.3",
            "verseOrgIds": [
              "MAT.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yaya za ka ce wa ɗan'uwanka, 'Bari in cire maka ɗan tsinken nan daga idonka,' alhali kuwa a kowane lokaci akwai gungume a naka ido?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.4",
                "verseOrgIds": [
                  "MAT.7.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.4",
            "verseOrgIds": [
              "MAT.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kai munafuki, fara cire gungumen da yake idonka, a sa'an nan ne za ka iya gani sosai yadda za ka cire ɗan tsinken da yake a idon ɗan'uwanka.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.5",
                "verseOrgIds": [
                  "MAT.7.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kada ku ba karnuka abin da yake mai tsarki; kada kuma ku jefa wa aladu lu'ulu'anku. In kuka yi haka za su tattake su, sa'an nan su juyo su jijji muku ciwo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.6",
                "verseOrgIds": [
                  "MAT.7.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Roƙa, nema, ƙwanƙwasa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.11.9-LUK.11.13"
          },
          "items": [
            {
              "text": "Luka 11.9-13",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ku roƙa za a ba ku; ku nema za ku samu; ku ƙwanƙwasa za a kuwa buɗe muku ƙofa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.7",
                "verseOrgIds": [
                  "MAT.7.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.7",
            "verseOrgIds": [
              "MAT.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gama duk wanda ya roƙa, akan ba shi; wanda ya nema kuwa, yakan samu, wanda kuma ya ƙwanƙwasa, za a buɗe masa ƙofa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.8",
                "verseOrgIds": [
                  "MAT.7.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Wane ne a cikinku in ɗansa ya roƙe shi burodi, sai yă ba shi dutse?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.9",
                "verseOrgIds": [
                  "MAT.7.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.9",
            "verseOrgIds": [
              "MAT.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ko kuwa in ya roƙe shi kifi, sai yă ba shi maciji?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.10",
                "verseOrgIds": [
                  "MAT.7.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.10",
            "verseOrgIds": [
              "MAT.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "In ku da kuke mugaye kun san yadda za ku ba da kyautai masu kyau ga 'ya'yanku, balle Ubanku na sama, ba zai fi ku iya ba da abubuwa masu kyau, ga su waɗanda suka roƙe shi ba!",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.11",
                "verseOrgIds": [
                  "MAT.7.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.11",
            "verseOrgIds": [
              "MAT.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Saboda haka, duk abin da kuke so mutane su yi muku, ku ma sai ku yi musu, domin wannan shi ne Doka da koyarwar Annabawa sun ƙunsa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.12",
                "verseOrgIds": [
                  "MAT.7.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Matsattsiya da faɗaɗɗiyar ƙofa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.13.24"
          },
          "items": [
            {
              "text": "Luka 13.24",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ku shiga ta matsattsiyar ƙofa. Gama ƙofar zuwa hallaka faɗaɗɗiya ce mai sauƙin bi kuma, masu shiga ta cikinta kuwa suna da yawa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.13",
                "verseOrgIds": [
                  "MAT.7.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.13",
            "verseOrgIds": [
              "MAT.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Amma ƙofar zuwa rai, ƙarama ce matsattsiya kuma, masu samunta kuwa kaɗan ne.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.14",
                "verseOrgIds": [
                  "MAT.7.14"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Itace da 'ya'yansa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.6.43-LUK.6.45"
          },
          "items": [
            {
              "text": "Luka 6.43-45",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ku yi hankali da annabawan ƙarya. Sukan zo muku da kamannin tumaki, amma daga ciki mugayen kyarketai ne.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.15",
                "verseOrgIds": [
                  "MAT.7.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.15",
            "verseOrgIds": [
              "MAT.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ta wurin aikinsu za ku gane su. Mutane suna iya tsinkan inabi a jikin ƙaya, ko kuwa ɓaure a jikin sarƙaƙƙiya?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.16",
                "verseOrgIds": [
                  "MAT.7.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.16",
            "verseOrgIds": [
              "MAT.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Haka ma kowane itace mai kyau yakan ba da 'ya'ya masu kyau, kuma mummunan itace ba ya ba da 'ya'ya masu kyau.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.17",
                "verseOrgIds": [
                  "MAT.7.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.17",
            "verseOrgIds": [
              "MAT.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Itace mai kyau ba ya ba da munanan 'ya'ya, haka kuma mummunan itace ba ya ba da 'ya'ya masu kyau.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.18",
                "verseOrgIds": [
                  "MAT.7.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
