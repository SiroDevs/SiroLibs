        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kada ku yi wa kanku ajiyar dukiya a duniya, inda asu da tsatsa suke ɓatawa, inda kuma ɓarayi sukan fasa, su yi sata.",
