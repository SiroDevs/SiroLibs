        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Amma in idanunka suna da lahani, dukan jikinka ma zai cika da duhu. To, in hasken da yake a cikinka duhu ne, duhun ya wuce misali ke nan!",
