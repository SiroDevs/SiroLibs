              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Saboda haka, ina gaya muku, kada ku damu game da rayuwarku, game da abin da za ku ci, ko abin da za ku sha; ko kuma game da jikinku, game da abin da za ku sa. Ashe, rai bai fi abinci ba, jiki kuma bai fi tufafi ba?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.25",
                "verseOrgIds": [
                  "MAT.6.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.25",
            "verseOrgIds": [
              "MAT.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ku dubi tsuntsayen sararin sama mana; ba sa shuki ko girbi ko ajiya a rumbuna, duk da haka, Ubanku na sama yana ciyar da su. Ashe, ba ku fi su daraja nesa ba?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.26",
                "verseOrgIds": [
                  "MAT.6.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.26",
            "verseOrgIds": [
              "MAT.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Wane ne a cikinku ta wurin damuwa zai iya ƙara wa rayuwarsa ko sa'a ɗaya",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.27",
                "verseOrgIds": [
