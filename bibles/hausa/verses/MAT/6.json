        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ba mai iya bauta wa iyayengiji biyu. Ko dai yă ƙi ɗaya, yă ƙaunaci ɗaya, ko kuwa yă yi aminci ga ɗaya, sa'an nan yă rena ɗayan. Ba dama ku bauta wa Allah, ku kuma bauta wa kuɗi gaba ɗaya.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.24",
