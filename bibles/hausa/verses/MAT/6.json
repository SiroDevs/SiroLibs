        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Amma ku yi wa kanku ajiyar dukiya a sama, inda ba tsatsa da asu da za su ɓata su, inda kuma ba ɓarayin da za su fasa, su yi sata.",
              "type": "text",
