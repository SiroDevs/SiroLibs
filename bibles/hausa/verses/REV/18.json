      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:20"
      },
      "items": [
        {
          "text": "Ku yi murna, ku tsarkaka!",
          "type": "text",
          "attrs": {
