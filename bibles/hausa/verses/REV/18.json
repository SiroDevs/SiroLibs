      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:19"
      },
      "items": [
        {
          "text": "Cikin sa'a ɗaya ta hallaka!'",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.19",
            "verseOrgIds": [
              "REV.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
