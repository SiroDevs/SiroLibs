      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:22"
      },
      "items": [
        {
          "text": "Ba za a ƙara jin ƙarar dutsen niƙa",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.22",
            "verseOrgIds": [
              "REV.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:22"
      },
      "items": [
        {
