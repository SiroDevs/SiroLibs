      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:23"
      },
      "items": [
        {
          "text": "Ba za a ƙara jin muryar ango da amarya",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.23",
            "verseOrgIds": [
              "REV.18.23"
            ]
