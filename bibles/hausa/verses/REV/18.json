          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "su ce,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.16",
            "verseOrgIds": [
              "REV.18.16"
            ]
          }
        }
