      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:21"
      },
      "items": [
        {
          "text": "ba za a ƙara ganin ta ba.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.21",
            "verseOrgIds": [
              "REV.18.21"
            ]
          }
        }
      ]
    },
    {
