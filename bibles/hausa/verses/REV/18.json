          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba za a ƙara jin",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.22",
            "verseOrgIds": [
              "REV.18.22"
            ]
          }
