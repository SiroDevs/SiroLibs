      "attrs": {
        "style": "q2",
        "vid": "REV 18:22"
      },
      "items": [
        {
          "text": "ƙarar kiɗin masu garaya da muryar mawaƙa, da na masu bushe-bushe, da na masu busan ƙaho",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.22",
            "verseOrgIds": [
              "REV.18.22"
            ]
