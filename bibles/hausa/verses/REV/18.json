      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:16"
      },
      "items": [
        {
          "text": "\" 'Kaito! Kaito, ya birni mai girma,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.16",
            "verseOrgIds": [
              "REV.18.16"
