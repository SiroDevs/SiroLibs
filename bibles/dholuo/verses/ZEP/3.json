{
  "id": "ZEP.3",
  "number": "3",
  "bookId": "ZEP",
  "reference": "Zefania 3",
  "copyright": "Biblica® Ochiw Thuolo Motingʼo Loko Manyien™ Weg Loko © 1980, 2002, 2003, 2020 otim gi Biblica, Inc. Biblica® Open New Luo Translation™ Copyright © 1980, 2002, 2003, 2020 by Biblica, Inc. \"Biblica\" en sai mondik mongorore e piny Amerika kendo en kido moyie malongʼo e ofis Biblica, Inc. Itiyo kode gi thuolo moa kuom Biblica, Inc. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "ZEP 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Chal mar Jerusalem e ndalo mabiro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEP 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mano kaka inine malit in dala maduongʼ ma jasand ji,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.1",
            "verseOrgIds": [
              "ZEP.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:1"
      },
      "items": [
        {
          "text": "ma toke tek kendo mogak.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.1",
            "verseOrgIds": [
              "ZEP.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEP 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dalani ok winj puonj ngʼato angʼata,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.2",
            "verseOrgIds": [
              "ZEP.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:2"
      },
      "items": [
        {
          "text": "kendo ok owinj kata puonj mora amora.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.2",
            "verseOrgIds": [
              "ZEP.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 3:2"
      },
      "items": [
        {
          "text": "Ok ogeno kuom Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.2",
            "verseOrgIds": [
              "ZEP.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:2"
      },
      "items": [
        {
          "text": "bende ok osud machiegni gi Nyasache.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.2",
            "verseOrgIds": [
              "ZEP.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEP 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jotende gin sibuoche maruto,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.3",
            "verseOrgIds": [
              "ZEP.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:3"
      },
      "items": [
        {
          "text": "to ruodhige chalo gi ondiegi mawuotho gotieno,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.3",
            "verseOrgIds": [
              "ZEP.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:3"
      },
      "items": [
        {
          "text": "ma ok we gimoro amora miyudi gokinyi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.3",
            "verseOrgIds": [
              "ZEP.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEP 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonabi mage gin josunga,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.4",
            "verseOrgIds": [
              "ZEP.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:4"
      },
      "items": [
        {
          "text": "kendo gin joma wuondore.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.4",
            "verseOrgIds": [
              "ZEP.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 3:4"
      },
      "items": [
        {
          "text": "Jodolo mage njawo kama ler mar lemo,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.4",
            "verseOrgIds": [
              "ZEP.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:4"
      },
      "items": [
        {
          "text": "kendo giketho chik.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.4",
            "verseOrgIds": [
              "ZEP.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEP 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Jehova Nyasaye mantie e diergi, to en ngʼat makare,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.5",
            "verseOrgIds": [
              "ZEP.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:5"
      },
      "items": [
        {
          "text": "ok otim gimoro amora marach.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.5",
            "verseOrgIds": [
              "ZEP.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 3:5"
      },
      "items": [
        {
          "text": "Okinyi ka okinyi to ongʼado bura gi adier,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.5",
            "verseOrgIds": [
              "ZEP.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:5"
      },
      "items": [
        {
          "text": "kendo odiechiengʼ ka odiechiengʼ ok rem,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.5",
            "verseOrgIds": [
              "ZEP.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:5"
      },
      "items": [
        {
          "text": "to kata kamano, jaricho to onge wichkuot.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.5",
            "verseOrgIds": [
              "ZEP.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Jerusalem otamore pwodhore kuom richo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEP 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asengʼado ogendini oko,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.6",
            "verseOrgIds": [
              "ZEP.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:6"
      },
      "items": [
        {
          "text": "kuondegi ma gigengʼorego bende asemuko.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.6",
            "verseOrgIds": [
              "ZEP.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 3:6"
      },
      "items": [
        {
          "text": "Yoregi osedongʼ nono,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.6",
            "verseOrgIds": [
              "ZEP.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:6"
      },
      "items": [
        {
          "text": "maonge ngʼama wuothoe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.6",
            "verseOrgIds": [
              "ZEP.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 3:6"
      },
      "items": [
        {
          "text": "Miechgi madongo osekethi;",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.6",
            "verseOrgIds": [
              "ZEP.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:6"
      },
      "items": [
        {
          "text": "maonge ngʼama nodongʼ kodakie kata achiel.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.6",
            "verseOrgIds": [
              "ZEP.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEP 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne awachone dala maduongʼ niya,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.7",
            "verseOrgIds": [
              "ZEP.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:7"
      },
      "items": [
        {
          "text": "'Adier ibiro luora,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.7",
            "verseOrgIds": [
              "ZEP.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:7"
      },
      "items": [
        {
          "text": "kendo ibiro yie gi puonjna!'",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.7",
            "verseOrgIds": [
              "ZEP.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 3:7"
      },
      "items": [
        {
          "text": "Ka itimo kamano, to kar dakni ok nongʼad oko,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.7",
            "verseOrgIds": [
              "ZEP.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:7"
      },
      "items": [
        {
          "text": "kendo ok anakume.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.7",
            "verseOrgIds": [
              "ZEP.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 3:7"
      },
      "items": [
        {
          "text": "Kata kamano, ne pod gi timo sinani",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.7",
            "verseOrgIds": [
              "ZEP.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:7"
      },
      "items": [
        {
          "text": "mar timo gik maricho.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.7",
            "verseOrgIds": [
              "ZEP.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEP 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano, Jehova Nyasaye wacho niya, \"Emomiyo koro rita,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.8",
            "verseOrgIds": [
              "ZEP.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:8"
      },
      "items": [
        {
          "text": "nyaka ndalo ma anangʼadnie bura.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.8",
            "verseOrgIds": [
              "ZEP.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 3:8"
      },
      "items": [
        {
          "text": "Asechano mondo achok ogendini",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.8",
            "verseOrgIds": [
              "ZEP.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:8"
      },
      "items": [
        {
          "text": "gi pinjeruodhi,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.8",
            "verseOrgIds": [
              "ZEP.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 3:8"
      },
      "items": [
        {
          "text": "mondo aol mirimba kuomgi,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.8",
            "verseOrgIds": [
              "ZEP.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:8"
      },
      "items": [
        {
          "text": "ma en mirimba mager.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.8",
            "verseOrgIds": [
              "ZEP.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 3:8"
      },
      "items": [
        {
          "text": "Piny ngima ibiro wangʼo",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.8",
            "verseOrgIds": [
              "ZEP.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:8"
      },
      "items": [
        {
          "text": "gi mach mar mirimba mager.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.8",
            "verseOrgIds": [
              "ZEP.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Israel biro keto genogi kuom Jehova Nyasaye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEP 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bangʼe anapwodh dho oganda",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.9",
            "verseOrgIds": [
              "ZEP.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:9"
      },
      "items": [
        {
          "text": "mondo giduto giluong nying Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.9",
            "verseOrgIds": [
              "ZEP.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:9"
      },
      "items": [
        {
          "text": "kendo gitine gi chuny achiel.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.9",
            "verseOrgIds": [
              "ZEP.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
