  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "PRO 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nying maber oloyo bedo gi mwandu mathoth;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.1",
            "verseOrgIds": [
              "PRO.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:1"
      },
      "items": [
        {
          "text": "bedo gi pwoch ber moloyo fedha gi dhahabu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.1",
            "verseOrgIds": [
              "PRO.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onge pogruok e kind jamoko kod jachan:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.2",
            "verseOrgIds": [
              "PRO.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:2"
      },
      "items": [
        {
          "text": "Nikech Jehova Nyasaye e Jachwechgi duto.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.2",
            "verseOrgIds": [
              "PRO.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼat mariek neno masira kabiro kendo opondo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.3",
            "verseOrgIds": [
              "PRO.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:3"
      },
      "items": [
        {
          "text": "to ngʼat mofuwo dhiyo adhiya nyime ma ohinyre.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.3",
            "verseOrgIds": [
              "PRO.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bolruok kod luoro Jehova Nyasaye",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.4",
            "verseOrgIds": [
              "PRO.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:4"
      },
      "items": [
        {
          "text": "kelo mwandu gi luor kod dak amingʼa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.4",
            "verseOrgIds": [
              "PRO.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yore joma timo richo opongʼ gi kudho kod obadho;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.5",
            "verseOrgIds": [
              "PRO.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:5"
      },
      "items": [
        {
          "text": "to ngʼat morito chunye obedo mabor kodgi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.5",
            "verseOrgIds": [
              "PRO.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Puonj nyathi e yo monego odhiye,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.6",
            "verseOrgIds": [
              "PRO.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:6"
      },
      "items": [
        {
          "text": "to ka obedo maduongʼ to ok obi baro oa kuome.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.6",
            "verseOrgIds": [
              "PRO.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jochan gin wasumb jo-mwandu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.7",
            "verseOrgIds": [
              "PRO.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:7"
      },
      "items": [
        {
          "text": "to ngʼat moholo gimoro bedo misumba ngʼat mohole.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.7",
            "verseOrgIds": [
              "PRO.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼatno mochwowo timbe richo kayo thagruok,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.8",
            "verseOrgIds": [
              "PRO.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:8"
      },
      "items": [
        {
          "text": "to ludhe mar mirima ibiro ketho.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.8",
            "verseOrgIds": [
              "PRO.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼat mangʼwon noyud gweth,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.9",
            "verseOrgIds": [
              "PRO.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:9"
      },
      "items": [
        {
          "text": "nimar opogo chiembe kod jochan.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.9",
            "verseOrgIds": [
              "PRO.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riemb ngʼat ma jaro ji, to lweny bende aa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.10",
            "verseOrgIds": [
              "PRO.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:10"
      },
      "items": [
        {
          "text": "dhawo kod kinyruok rumo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.10",
            "verseOrgIds": [
              "PRO.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼat ma chunye ler kendo ma wuoyo gi ngʼwono",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.11",
            "verseOrgIds": [
              "PRO.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:11"
      },
      "items": [
        {
          "text": "biro bedo osiep ruoth.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.11",
            "verseOrgIds": [
              "PRO.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wangʼ Jehova Nyasaye rito ngʼeyo;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.12",
            "verseOrgIds": [
              "PRO.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:12"
      },
      "items": [
        {
          "text": "to orundo weche mag jogo ma ok jo-adiera.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.12",
            "verseOrgIds": [
              "PRO.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jasamuoyo wacho niya, \"Sibuor ni oko!\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.13",
            "verseOrgIds": [
              "PRO.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:13"
      },
      "items": [
        {
          "text": "Kata, \"Ibiro nega e yore mag dala!\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.13",
            "verseOrgIds": [
              "PRO.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dho dhako ma jachode en bur matut;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.14",
            "verseOrgIds": [
              "PRO.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:14"
      },
      "items": [
        {
          "text": "ngʼatno manie bwo mirimb Jehova Nyasaye biro lingʼore e iye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.14",
            "verseOrgIds": [
              "PRO.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fuwo otwere e chuny nyathi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.15",
            "verseOrgIds": [
              "PRO.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:15"
      },
      "items": [
        {
          "text": "to ludh kum biro riembe mabor kode.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.15",
            "verseOrgIds": [
              "PRO.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼat mathiro jochan mondo mwandune omedre",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.16",
            "verseOrgIds": [
              "PRO.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:16"
      },
      "items": [
        {
          "text": "kod ngʼat machiwo mich ne jomoko biro bedo jochan.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.16",
            "verseOrgIds": [
              "PRO.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Weche piero adek mag jomariek",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Wach Mokwongo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chik iti kendo iwinj weche mag jomariek;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.17",
            "verseOrgIds": [
              "PRO.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
