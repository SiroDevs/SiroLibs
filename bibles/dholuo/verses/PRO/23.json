    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Wach mar abiriyo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ibedo mondo ichiem gi ruoth,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.1",
            "verseOrgIds": [
              "PRO.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:1"
      },
      "items": [
        {
          "text": "non maber gima ni e nyimi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.1",
            "verseOrgIds": [
              "PRO.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka in jawuoro to dimbri",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.2",
            "verseOrgIds": [
              "PRO.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:2"
      },
      "items": [
        {
          "text": "nono to onyalo keto pala e dwondi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.2",
            "verseOrgIds": [
              "PRO.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik igomb chiembe mamit,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.3",
            "verseOrgIds": [
              "PRO.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:3"
      },
      "items": [
        {
          "text": "nimar chiemono en mar wuondruok.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.3",
            "verseOrgIds": [
              "PRO.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Wach mar aboro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik iwe tich bari ndasi ni mondo ibed ja-mwandu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.4",
            "verseOrgIds": [
              "PRO.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:4"
      },
      "items": [
        {
          "text": "bed gi rieko mondo iritri.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.4",
            "verseOrgIds": [
              "PRO.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼi mwandu mana matin nono, to bangʼe gidhi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.5",
            "verseOrgIds": [
              "PRO.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:5"
      },
      "items": [
        {
          "text": "nimar adiera gibiro bedo gi bwombe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.5",
            "verseOrgIds": [
              "PRO.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:5"
      },
      "items": [
        {
          "text": "kendo gifu gidhi e kor polo ka ongo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.5",
            "verseOrgIds": [
              "PRO.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Wach mar ochiko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik icham chiemb jagwondo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.6",
            "verseOrgIds": [
              "PRO.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:6"
      },
      "items": [
        {
          "text": "kik igomb chiembe mamit,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.6",
            "verseOrgIds": [
              "PRO.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimar en ngʼat",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.7",
            "verseOrgIds": [
              "PRO.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:7"
      },
      "items": [
        {
          "text": "mosiko paro nengo mochul.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.7",
            "verseOrgIds": [
              "PRO.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 23:7"
      },
      "items": [
        {
          "text": "Owachoni niya, \"Chiem kendo methi,\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.7",
            "verseOrgIds": [
              "PRO.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:7"
      },
      "items": [
        {
          "text": "to chunye ok ni kodi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.7",
            "verseOrgIds": [
              "PRO.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibiro ngʼogo mano matin mane ichamo",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.8",
            "verseOrgIds": [
              "PRO.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:8"
      },
      "items": [
        {
          "text": "kendo ibiro bedo ni iketho kindeni kuom pwoch mipuoyego.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.8",
            "verseOrgIds": [
              "PRO.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Wach mar apar",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik iwuo ne ngʼat mofuwo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.9",
            "verseOrgIds": [
              "PRO.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:9"
      },
      "items": [
        {
          "text": "nikech obiro chayo rieko mag wechegi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.9",
            "verseOrgIds": [
              "PRO.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Wach mar apar gachiel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik igol kidi mar kiewo machon,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.10",
            "verseOrgIds": [
              "PRO.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:10"
      },
      "items": [
        {
          "text": "kata ima nyithindo maonge wuone puothegi;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.10",
            "verseOrgIds": [
              "PRO.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimar Jal moritogi en ratego;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.11",
            "verseOrgIds": [
              "PRO.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:11"
      },
      "items": [
        {
          "text": "obiro chwakogi e kindi kodgi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.11",
            "verseOrgIds": [
              "PRO.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Wach mar apar gariyo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ket chunyi ne puonj",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.12",
            "verseOrgIds": [
              "PRO.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:12"
      },
      "items": [
        {
          "text": "to iti ne weche mag ngʼeyo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.12",
            "verseOrgIds": [
              "PRO.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Wach mar apar gadek",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik itamri kumo nyathi;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.13",
            "verseOrgIds": [
              "PRO.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:13"
      },
      "items": [
        {
          "text": "nimar chwat ok nyal nege.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.13",
            "verseOrgIds": [
              "PRO.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikumo nyathi kod kede",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.14",
            "verseOrgIds": [
              "PRO.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:14"
      },
      "items": [
        {
          "text": "to obiro reso chunye aa e tho.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.14",
            "verseOrgIds": [
              "PRO.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Wach mar apar gangʼwen",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuoda, ka chunyi riek,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.15",
            "verseOrgIds": [
              "PRO.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:15"
      },
      "items": [
        {
          "text": "eka chunya biro bedo mamor,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.15",
            "verseOrgIds": [
              "PRO.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "chunya ma iye nobed mamor",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.16",
            "verseOrgIds": [
              "PRO.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:16"
      },
      "items": [
        {
          "text": "ka lewi wacho gima nikare.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.16",
            "verseOrgIds": [
              "PRO.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Wach mar apar gabich",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
