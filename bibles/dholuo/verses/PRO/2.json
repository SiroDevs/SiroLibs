      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ber mar dak mobidhore mar rieko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuoda, ka iyie rwako wechena",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.1",
            "verseOrgIds": [
              "PRO.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:1"
      },
      "items": [
        {
          "text": "kendo kano chikena e chunyi;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.1",
            "verseOrgIds": [
              "PRO.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka ichiko iti ni weche mag rieko",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.2",
            "verseOrgIds": [
              "PRO.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:2"
      },
      "items": [
        {
          "text": "kendo kiketo chunyi mondo iwinj tiend weche,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.2",
            "verseOrgIds": [
              "PRO.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "to ka imanyo ngʼeyo malingʼ-lingʼ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.3",
            "verseOrgIds": [
              "PRO.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:3"
      },
      "items": [
        {
          "text": "kendo ikwayo ngʼeyo tiend wach,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.3",
            "verseOrgIds": [
              "PRO.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "to ka idware ka fedha",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.4",
            "verseOrgIds": [
              "PRO.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:4"
      },
      "items": [
        {
          "text": "kendo imanye ka mwandu mopandi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.4",
            "verseOrgIds": [
              "PRO.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "eka iniwinj malongʼo tiend luoro Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.5",
            "verseOrgIds": [
              "PRO.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:5"
      },
      "items": [
        {
          "text": "kendo iniyud rieko mar ngʼeyo Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.5",
            "verseOrgIds": [
              "PRO.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye chiwo rieko",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.6",
            "verseOrgIds": [
              "PRO.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:6"
      },
      "items": [
        {
          "text": "kendo ngʼeyo gi winjo aa e dhoge.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.6",
            "verseOrgIds": [
              "PRO.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oiko loch ni joma kare,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.7",
            "verseOrgIds": [
              "PRO.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:7"
      },
      "items": [
        {
          "text": "en okumba ni jogo ma wuodhgi ler,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.7",
            "verseOrgIds": [
              "PRO.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimar en okumba mar joma kare",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.8",
            "verseOrgIds": [
              "PRO.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:8"
      },
      "items": [
        {
          "text": "kendo orito yor joge ma jo-adiera.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.8",
            "verseOrgIds": [
              "PRO.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka iwinjo wachna, eka iningʼe gima kare,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.9",
            "verseOrgIds": [
              "PRO.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:9"
      },
      "items": [
        {
          "text": "kendo mowinjore ma gin yore duto mabeyo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.9",
            "verseOrgIds": [
              "PRO.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar rieko nodonj e chunyi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.10",
            "verseOrgIds": [
              "PRO.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:10"
      },
      "items": [
        {
          "text": "kendo ngʼeyo nomi ngimani bedo mamor.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.10",
            "verseOrgIds": [
              "PRO.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rieko mar pogo tiend wach noriti,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.11",
            "verseOrgIds": [
              "PRO.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:11"
      },
      "items": [
        {
          "text": "kendo winjo tiend wach nobedni okumba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.11",
            "verseOrgIds": [
              "PRO.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rieko noresi kuom yore mag joma mono,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.12",
            "verseOrgIds": [
              "PRO.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:12"
      },
      "items": [
        {
          "text": "kuom jogo mawacho weche mochido,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.12",
            "verseOrgIds": [
              "PRO.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "jogo moweyo yore moriere mag bidhruok,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.13",
            "verseOrgIds": [
              "PRO.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:13"
      },
      "items": [
        {
          "text": "mondo giwuothi e yore mag mudho,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.13",
            "verseOrgIds": [
              "PRO.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "joma mor kuom timo maricho",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.14",
            "verseOrgIds": [
              "PRO.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:14"
      },
      "items": [
        {
          "text": "kendo giil e duwruok mar richo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.14",
            "verseOrgIds": [
              "PRO.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "jogo ma yoregi ogajore ogajore",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.15",
            "verseOrgIds": [
              "PRO.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:15"
      },
      "items": [
        {
          "text": "kendo gin jowuond e yoregi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.15",
            "verseOrgIds": [
              "PRO.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende enoresi kuom dhako ma jachode,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.16",
            "verseOrgIds": [
              "PRO.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:16"
      },
      "items": [
        {
          "text": "kuom dhako mabayo gi wechege maywayo ji,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.16",
            "verseOrgIds": [
              "PRO.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "moseweyo chwore mane okende konyako,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.17",
            "verseOrgIds": [
              "PRO.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:17"
      },
      "items": [
        {
          "text": "kendo oketho singruok mane otimo e nyim Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.17",
            "verseOrgIds": [
              "PRO.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech ode tero ji e tho",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.18",
            "verseOrgIds": [
              "PRO.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:18"
      },
      "items": [
        {
          "text": "to yorene tero ji e piny joma otho.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.18",
            "verseOrgIds": [
              "PRO.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onge ngʼato madhi ire maduogo",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.19",
            "verseOrgIds": [
              "PRO.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
