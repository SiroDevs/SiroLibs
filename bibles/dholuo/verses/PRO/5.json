  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "PRO 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Siem kuom terruok",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuoda, chik iti malongʼo ne riekona,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.1",
            "verseOrgIds": [
              "PRO.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:1"
      },
      "items": [
        {
          "text": "mondo iwinj maber puonj mago mopondo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.1",
            "verseOrgIds": [
              "PRO.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "eka isik kingʼeyo pogo tiend weche",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.2",
            "verseOrgIds": [
              "PRO.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:2"
      },
      "items": [
        {
          "text": "kendo dhogi norit rieko.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.2",
            "verseOrgIds": [
              "PRO.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar dho jachode wacho weche mamit ka mor kich,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.3",
            "verseOrgIds": [
              "PRO.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:3"
      },
      "items": [
        {
          "text": "kendo wuoyone yom maloyo moo;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.3",
            "verseOrgIds": [
              "PRO.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "to gikone okech ka kedhno",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.4",
            "verseOrgIds": [
              "PRO.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:4"
      },
      "items": [
        {
          "text": "kendo obith ka ligangla ma dhoge ariyo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.4",
            "verseOrgIds": [
              "PRO.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiendene ochomo kar tho,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.5",
            "verseOrgIds": [
              "PRO.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:5"
      },
      "items": [
        {
          "text": "to ondamo mage ochiko bur tir.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.5",
            "verseOrgIds": [
              "PRO.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ok opar ngangʼ yor ngima; yorene ogondore,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.6",
            "verseOrgIds": [
              "PRO.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:6"
      },
      "items": [
        {
          "text": "to ok ongʼeyo kamano.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.6",
            "verseOrgIds": [
              "PRO.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo koro un yawuota, winjauru,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.7",
            "verseOrgIds": [
              "PRO.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:7"
      },
      "items": [
        {
          "text": "kik uwe gima awachonu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.7",
            "verseOrgIds": [
              "PRO.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bed mabor gi dhako ma kamano,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.8",
            "verseOrgIds": [
              "PRO.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:8"
      },
      "items": [
        {
          "text": "kendo kik idhi machiegni gi dhoode,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.8",
            "verseOrgIds": [
              "PRO.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nono to jomoko nono ema inimi tekreni maber moloyo",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.9",
            "verseOrgIds": [
              "PRO.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:9"
      },
      "items": [
        {
          "text": "kendo higni magi norum e lwet joma ger,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.9",
            "verseOrgIds": [
              "PRO.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nono to jomoko nono, ema nocham mwanduni",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.10",
            "verseOrgIds": [
              "PRO.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:10"
      },
      "items": [
        {
          "text": "kendo tichni matek nokony od ngʼat moro nono.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.10",
            "verseOrgIds": [
              "PRO.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "To e giko mar ngimani inichur achura,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.11",
            "verseOrgIds": [
              "PRO.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:11"
      },
      "items": [
        {
          "text": "ka ringri gi dendi chamore rumo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.11",
            "verseOrgIds": [
              "PRO.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "To iniwachi niya, \"Mano kaka nasin gi puonj mar rieko!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.12",
            "verseOrgIds": [
              "PRO.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:12"
      },
      "items": [
        {
          "text": "Mano kaka chunya nokwedo siem mane omiya kuom gik mane atimo ma ok nikare!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.12",
            "verseOrgIds": [
              "PRO.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ok anyal winjo kendo timo weche jopuonjna,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.13",
            "verseOrgIds": [
              "PRO.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:13"
      },
      "items": [
        {
          "text": "kata chiko ita ni jopuonjna.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.13",
            "verseOrgIds": [
              "PRO.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asechopo e giko mar kethruok marach",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.14",
            "verseOrgIds": [
              "PRO.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:14"
      },
      "items": [
        {
          "text": "e dier chokruok mangima.\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.14",
            "verseOrgIds": [
              "PRO.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Modh pi moa e dapigi iwuon,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.15",
            "verseOrgIds": [
              "PRO.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:15"
      },
      "items": [
        {
          "text": "pi mamol moa e sokoni iwuon.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.15",
            "verseOrgIds": [
              "PRO.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende ber mondo soknigi omol ka oo oko e yore mag dala,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.16",
            "verseOrgIds": [
              "PRO.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:16"
      },
      "items": [
        {
          "text": "kata aoregi mag pi e kuonde chokruok manie dier dala?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.16",
            "verseOrgIds": [
              "PRO.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ni gibedo magi iwuon",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.17",
            "verseOrgIds": [
              "PRO.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:17"
      },
      "items": [
        {
          "text": "kendo kik iriwgi gi joma galagala.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.17",
            "verseOrgIds": [
              "PRO.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sokoni mondo ogwedhi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.18",
            "verseOrgIds": [
              "PRO.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:18"
      },
      "items": [
        {
          "text": "kendo ibed mamor gi chiegi mane ikendo ka in wuowi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.18",
            "verseOrgIds": [
              "PRO.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ojaber ka mwanda, kendo olongʼo ka nyakech,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.19",
            "verseOrgIds": [
              "PRO.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:19"
      },
      "items": [
        {
