  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "PHM 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PHM 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "An Paulo ngʼat motwe nikech Kristo Yesu kod owadwa Timotheo,",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.1",
            "verseOrgIds": [
              "PHM.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PHM 1:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "PHM 1:1"
      },
      "items": [
        {
          "text": "Wandikoni osiepwa mwageno kendo jatich wadwa Filemon,",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.1",
            "verseOrgIds": [
              "PHM.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PHM 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kaachiel gi nyaminwa Afia gi Arkipo jalweny wadwa, kod kanisa malemo e odi:",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.2",
            "verseOrgIds": [
              "PHM.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PHM 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼwono kod kwe moa kuom Nyasaye Wuonwa kod Ruoth Yesu Kristo obed kodu.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.3",
            "verseOrgIds": [
              "PHM.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lemo gi dwoko erokamano",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PHM 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adwokone Nyasacha erokamano pile ka aluongo nyingi e lemona,",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.4",
            "verseOrgIds": [
              "PHM.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PHM 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikech awinjo kuom yie ma in-go kuom Ruoth Yesu, kendo kuom hera miherogo jomaler duto.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.5",
            "verseOrgIds": [
              "PHM.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PHM 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alemoni ni mondo iland yie ma in-go motegno, mondo eka ibed gi ngʼeyo matut kuom gik mabeyo duto ma wan-go ei Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.6",
            "verseOrgIds": [
              "PHM.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PHM 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hera ma in-go osemiya mor maduongʼ kendo osejiwa, nikech in, owadwa mahero, isedwogo chunje jomaler.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.7",
            "verseOrgIds": [
              "PHM.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo kwayo ne Onesimo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PHM 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano, kata obedo ni kuom Kristo ne anyalo bedo gi chir mar chiki mondo itim gima onego itim,",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.8",
            "verseOrgIds": [
              "PHM.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PHM 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "to koro asayi mondo itim kamano nikech hera. Koro an Paulo awuon, ma jaduongʼ, kendo motwe nikech wach Kristo Yesu,",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.9",
            "verseOrgIds": [
              "PHM.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PHM 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "akwayi kuom wach wuoda Onesimo mane odoko wuoda ka an e twech.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.10",
            "verseOrgIds": [
              "PHM.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PHM 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne onge konyruok mane Onesimo keloni to sani koro okelo konyruok maduongʼ ne in kaachiel kod an bende.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.11",
            "verseOrgIds": [
              "PHM.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PHM 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aore mondo oduog iri, kata obedo ni chunya ogene ahinya.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.12",
            "verseOrgIds": [
              "PHM.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PHM 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dahero bedo kode ka mondo okonya kaeni kapod an e od twech nikech Injili.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.13",
            "verseOrgIds": [
              "PHM.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHM 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ne ok adwar timo gimoro amora ka ok in ema iyie, mondo tim ngʼwono moro amora mitimo kik bed gima ochun, to obed gima itimo nikech ihero.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.14",
            "verseOrgIds": [
              "PHM.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PHM 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyalo bet ni Onesimo nowuok iri kuom kinde manok mondo iyud thuolo mar kawe chuth bangʼe,",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.15",
            "verseOrgIds": [
              "PHM.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PHM 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ok kaka misumba to kaka owadu migeno ma en ngʼat moloyo misumba. En ohala ne an, to angʼeyo ni en ohala moloyo ne in bende, ok mana kaka ngʼato angʼata, to kaka owadu kuom Ruoth.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.16",
            "verseOrgIds": [
              "PHM.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PHM 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo ka ikwana kaka ngʼama ni kodi e achiel kuom yie to rwake mana kaka dirwaka.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.17",
            "verseOrgIds": [
              "PHM.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PHM 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaponi osetimoni marach, kata ka en-gi gopi moro to kwan-gi e wiya.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.18",
            "verseOrgIds": [
              "PHM.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PHM 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andikoni baruwani gi lweta awuon an Paulo, ka anyisi ni abiro chuli, kata ka ok aparoni ni in kod gopa ma en ngimani owuon.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.19",
            "verseOrgIds": [
              "PHM.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PHM 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gima agombo maduongʼ, owadwa, en ni mondo iyie itimna ngʼwono kuom Ruoth, kidwogo chunya kuom Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.20",
            "verseOrgIds": [
              "PHM.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PHM 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech angʼeyo maber ni iwinjo wach, andikoni ka an gi adiera ni ibiro timona maber moloyo kaka akwayi.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.21",
            "verseOrgIds": [
              "PHM.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PHM 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwayo machielo ma an-go en ni mondo ilosna kar nindo, nikech an-gi geno ni ibiro gonya mana kaka usebedo kulamo.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.22",
            "verseOrgIds": [
              "PHM.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PHM 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Epafra motwe koda kaachiel nikech wach Kristo Yesu ooronu mos.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.23",
            "verseOrgIds": [
              "PHM.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PHM 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mariko bende omosou kaachiel gi Aristarko gi Dema kod Luka, ma gin jotich wetena.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.24",
            "verseOrgIds": [
              "PHM.1.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PHM 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼwono mar Ruoth Yesu Kristo mondo obed kod chunyi.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.25",
            "verseOrgIds": [
              "PHM.1.25"
            ]
          }
        }
      ]
    }
  ],
