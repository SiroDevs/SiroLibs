  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "JOB 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Elifaz",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Elifaz ja-Teman nodwoke kama:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.1",
            "verseOrgIds": [
              "JOB.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bende chunyi nyalo doko malit ka ngʼato okeloni wach moro",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.2",
            "verseOrgIds": [
              "JOB.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:2"
      },
      "items": [
        {
          "text": "nimar ok anyal lingʼ mak awuoyo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.2",
            "verseOrgIds": [
              "JOB.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Parie kaka isepuonjo ji mangʼeny,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.3",
            "verseOrgIds": [
              "JOB.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:3"
      },
      "items": [
        {
          "text": "kendo isejiwo joma chunygi onyosore.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.3",
            "verseOrgIds": [
              "JOB.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wechegi osekonyo joma opodho;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.4",
            "verseOrgIds": [
              "JOB.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:4"
      },
      "items": [
        {
          "text": "kendo isejiwo joma tekogi orumo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.4",
            "verseOrgIds": [
              "JOB.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "To koro chandruok osechoponi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.5",
            "verseOrgIds": [
              "JOB.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:5"
      },
      "items": [
        {
          "text": "kendo chunyi onyosore omiyo ionge gi kwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.5",
            "verseOrgIds": [
              "JOB.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luor miluorogo Nyasaye dak koro miyi chir",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.6",
            "verseOrgIds": [
              "JOB.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:6"
      },
      "items": [
        {
          "text": "koso ngimani moriere dak koro miyi geno?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.6",
            "verseOrgIds": [
              "JOB.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Koro par ane: En ngʼa mosekum maonge ketho?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.7",
            "verseOrgIds": [
              "JOB.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:7"
      },
      "items": [
        {
          "text": "Koso joma kare mage minyalo tieki?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.7",
            "verseOrgIds": [
              "JOB.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gima aseneno en ni",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.8",
            "verseOrgIds": [
              "JOB.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:8"
      },
      "items": [
        {
          "text": "joma chwoyo richo gi chandruok kayo mana richo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.8",
            "verseOrgIds": [
              "JOB.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itiekogi apoya nono gi much Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.9",
            "verseOrgIds": [
              "JOB.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:9"
      },
      "items": [
        {
          "text": "kendo sa ma mirimbe obiro to gilal nono.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.9",
            "verseOrgIds": [
              "JOB.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibuoche nyalo ruto kendo sibuoche mager nyalo goyo asumbi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.10",
            "verseOrgIds": [
              "JOB.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:10"
      },
      "items": [
        {
          "text": "to kata kamano leke sibuoche maroteke osemuki.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.10",
            "verseOrgIds": [
              "JOB.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibuor koro tho nikech gima ocham onge,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.11",
            "verseOrgIds": [
              "JOB.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:11"
      },
      "items": [
        {
          "text": "kendo nyithi sibuor oringo ma oke.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.11",
            "verseOrgIds": [
              "JOB.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ne okuodhna wach moro mos,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.12",
            "verseOrgIds": [
              "JOB.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:12"
      },
      "items": [
        {
          "text": "to ne awinje mana marach rach.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.12",
            "verseOrgIds": [
              "JOB.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wachni nobirona gotieno e yor lek,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.13",
            "verseOrgIds": [
              "JOB.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:13"
      },
      "items": [
        {
          "text": "e sa ma nindo goye ji ngoga,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.13",
            "verseOrgIds": [
              "JOB.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo luoro gi kibaji nogoya",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.14",
            "verseOrgIds": [
              "JOB.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:14"
      },
      "items": [
        {
          "text": "momiyo denda duto onyosore.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.14",
            "verseOrgIds": [
              "JOB.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka muya nokudho wangʼa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.15",
            "verseOrgIds": [
              "JOB.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:15"
      },
      "items": [
        {
          "text": "mi yier denda duto nojuol.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.15",
            "verseOrgIds": [
              "JOB.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nochungʼ molingʼ thi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.16",
            "verseOrgIds": [
              "JOB.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:16"
      },
      "items": [
        {
          "text": "to ne ok anyal ngʼeyo ni en angʼo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.16",
            "verseOrgIds": [
              "JOB.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 4:16"
      },
      "items": [
        {
          "text": "Kido moro nobiro mochungʼ e nyim wangʼa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.16",
            "verseOrgIds": [
              "JOB.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:16"
      },
      "items": [
        {
          "text": "kendo nawinjo dwol moro machil, kawacho niya:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.16",
            "verseOrgIds": [
              "JOB.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Bende dhano mangima nyalo bedo makare moloyo Nyasaye?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.17",
            "verseOrgIds": [
              "JOB.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:17"
      },
      "items": [
        {
          "text": "Dhano bende dibed maler moloyo jachwechne?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.17",
            "verseOrgIds": [
              "JOB.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka Nyasaye ok nyal geno jotichne,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.18",
            "verseOrgIds": [
              "JOB.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:18"
      },
      "items": [
        {
          "text": "ma kata malaika bende joketho e nyime,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.18",
            "verseOrgIds": [
              "JOB.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
