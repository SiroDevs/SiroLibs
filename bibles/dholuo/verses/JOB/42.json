  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "42",
        "style": "c",
        "sid": "JOB 42"
      },
      "items": [
        {
          "text": "42",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ayub",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 42:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Ayub nodwoko Jehova Nyasaye kama:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.1",
            "verseOrgIds": [
              "JOB.42.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Angʼeyo ni inyalo gik moko duto;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.2",
            "verseOrgIds": [
              "JOB.42.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 42:2"
      },
      "items": [
        {
          "text": "onge chenroni ma ngʼato nyalo gengʼo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.2",
            "verseOrgIds": [
              "JOB.42.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ipenjo ni, 'En ngʼa ma umo riekona gi weche mofuwogi?'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.3",
            "verseOrgIds": [
              "JOB.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 42:3"
      },
      "items": [
        {
          "text": "Adier asewacho gik ma ok angʼeyo tiendgi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.3",
            "verseOrgIds": [
              "JOB.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 42:3"
      },
      "items": [
        {
          "text": "gik miwuoro modhiera ngʼeyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.3",
            "verseOrgIds": [
              "JOB.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ne iwachona ni, 'Koro chik iti mondo iwinj gima awacho;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.4",
            "verseOrgIds": [
              "JOB.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 42:4"
      },
      "items": [
        {
          "text": "abiro penji penjo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.4",
            "verseOrgIds": [
              "JOB.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 42:4"
      },
      "items": [
        {
          "text": "kendo ibiro dwoka.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.4",
            "verseOrgIds": [
              "JOB.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asewinjo mana gi ita gima joma moko osewacho kuomi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.5",
            "verseOrgIds": [
              "JOB.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 42:5"
      },
      "items": [
        {
          "text": "kende to sani koro aseneni gi wengena awuon.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.5",
            "verseOrgIds": [
              "JOB.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano, achayora ahinya",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.6",
            "verseOrgIds": [
              "JOB.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 42:6"
      },
      "items": [
        {
          "text": "kendo ahulo richona ka bet piny kendo abukora gi buru.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.6",
            "verseOrgIds": [
              "JOB.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Weche mogik",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane Jehova Nyasaye osewacho ne Ayub wechegi, nowachone Elifaz ja-Teman niya, \"Iya owangʼ kodi kaachiel gi osiepegi ariyo, nikech ok usewacho weche ma adieri kuoma, kaka jatichna Ayub osewacho.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.7",
            "verseOrgIds": [
              "JOB.42.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano, kaw rwedhi abiriyo gi imbe abiriyo mondo idhigo ir jatichna Ayub kendo utim misango miwangʼo pep ne un uwegi. Jatichna Ayub biro lamonu, kendo anawinj lemone ma ok anatimnu gima owinjore gi timbeu mofuwogi. Ok usewacho kuoma gik ma adier, kaka jatichna Ayub.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.8",
            "verseOrgIds": [
              "JOB.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano Elifaz ja-Teman, Bildad ja-Shua kod Zofar ja-Namath notimo gimane Jehova Nyasaye okonegi; kendo Jehova Nyasaye norwako lamb Ayub.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.9",
            "verseOrgIds": [
              "JOB.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane Ayub oselamo ne osiepene, Jehova Nyasaye nochako ogwedhe gi mwandu, kendo nomiye mwandu mathoth moloyo mane en-go mokwongo nyadiriyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.10",
            "verseOrgIds": [
              "JOB.42.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owetene gi nyiminene kod ji duto mane ongʼeye mokwongo nobiro mochiemo kode e ode. Ne gihoye kendo gidwogo chunye kuom chandruok duto mane Jehova Nyasaye osekelone, kendo moro ka moro kuomgi nomiye pesa moko kod tere mar dhahabu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.11",
            "verseOrgIds": [
              "JOB.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye nogwedho higni machien mag ngima Ayub moloyo kaka nogwedhe mokwongo. Ne en gi rombe alufu apar gangʼwen, ngamia alufu auchiel, rweth pur alufu achiel, kod punde alufu achiel.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.12",
            "verseOrgIds": [
              "JOB.42.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 42:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende ne en gi yawuowi abiriyo gi nyiri adek.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.13",
            "verseOrgIds": [
              "JOB.42.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyare mokwongo nochako ni Jemima, mar ariyo Kezia, to mar adek ne en Keren-Hapuk.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.14",
            "verseOrgIds": [
              "JOB.42.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onge nyiri mane ber e piny ngima ka nyi Ayub, kendo wuon-gi nopogonegi girkeni mage maromre gi owetegi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.15",
            "verseOrgIds": [
              "JOB.42.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 42:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ temni, Ayub nodak higni mia achiel gi piero angʼwen; noneno nyithinde gi nyikwaye nyaka tiengʼ mar angʼwen.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.16",
            "verseOrgIds": [
              "JOB.42.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼe Ayub notho, ka en jaduongʼ moti ma hike oniangʼ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.17",
            "verseOrgIds": [
              "JOB.42.17"
            ]
          }
        }
      ]
    }
  ],
