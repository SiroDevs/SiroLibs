  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "JOB 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Angʼo momiyo Jehova Nyasaye Maratego",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.1",
            "verseOrgIds": [
              "JOB.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:1"
      },
      "items": [
        {
          "text": "ok oketo odiechieng ngʼado bura mondo ongʼere?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.1",
            "verseOrgIds": [
              "JOB.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:1"
      },
      "items": [
        {
          "text": "Angʼo momiyo joma ongʼeyo geno odiechiengno to ok ginyal nene?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.1",
            "verseOrgIds": [
              "JOB.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji ma timbegi richo ketho kiewo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.2",
            "verseOrgIds": [
              "JOB.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:2"
      },
      "items": [
        {
          "text": "kendo gikwayo jamni ma gisekwalo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.2",
            "verseOrgIds": [
              "JOB.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikwalo punda nyathi kich kendo gikawo rwadh pur achiel",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.3",
            "verseOrgIds": [
              "JOB.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:3"
      },
      "items": [
        {
          "text": "kende mar dhako ma chwore otho ka gir singo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.3",
            "verseOrgIds": [
              "JOB.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gimono jochan yudo adiera",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.4",
            "verseOrgIds": [
              "JOB.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:4"
      },
      "items": [
        {
          "text": "kendo gimiyo jomodhier ringo pondo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.4",
            "verseOrgIds": [
              "JOB.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma odhier tiyo matek kamanyo chiemo e thim, mana ka punda;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.5",
            "verseOrgIds": [
              "JOB.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:5"
      },
      "items": [
        {
          "text": "nikech onge kama ginyalo yudoe chiemo ni nyithindgi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.5",
            "verseOrgIds": [
              "JOB.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gichoko chiemb jamni",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.6",
            "verseOrgIds": [
              "JOB.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:6"
      },
      "items": [
        {
          "text": "kendo gihulo mzabibu e puothe joricho.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.6",
            "verseOrgIds": [
              "JOB.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ginindo duk gotieno nikech gionge lewni;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.7",
            "verseOrgIds": [
              "JOB.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:7"
      },
      "items": [
        {
          "text": "gionge gimoro amora ma ginyalo umorego ka koyo ngʼich.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.7",
            "verseOrgIds": [
              "JOB.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodh ajiki mag gode olwoko dendgi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.8",
            "verseOrgIds": [
              "JOB.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:8"
      },
      "items": [
        {
          "text": "kendo gitwere e lwendni nikech gionge kuonde dak.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.8",
            "verseOrgIds": [
              "JOB.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyathi maonge gi wuon iyudho oko e thuno;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.9",
            "verseOrgIds": [
              "JOB.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:9"
      },
      "items": [
        {
          "text": "nyathi jadhier ma pod kwar imako kar gowi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.9",
            "verseOrgIds": [
              "JOB.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Giwuotho duk e gwengʼ nikech gionge lewni;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.10",
            "verseOrgIds": [
              "JOB.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:10"
      },
      "items": [
        {
          "text": "gitingʼo ne ji chiemo to gin to kech negogi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.10",
            "verseOrgIds": [
              "JOB.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji chunogi gitoyo zeituni kuonde ma gin ema gikunyo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.11",
            "verseOrgIds": [
              "JOB.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:11"
      },
      "items": [
        {
          "text": "kendo gibiyo olemb mzabibu to gin riyo negogi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.11",
            "verseOrgIds": [
              "JOB.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chur mar joma tho ochomo polo koa e dala maduongʼ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.12",
            "verseOrgIds": [
              "JOB.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:12"
      },
      "items": [
        {
          "text": "kendo chunje joma ohinyore ywagore ka dwaro kony,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.12",
            "verseOrgIds": [
              "JOB.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:12"
      },
      "items": [
        {
          "text": "to Nyasaye ok okum joma hinyogi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.12",
            "verseOrgIds": [
              "JOB.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nitie jomoko mangʼanyo ne ler,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.13",
            "verseOrgIds": [
              "JOB.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:13"
      },
      "items": [
        {
          "text": "ma ok ongʼeyo yore ler,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.13",
            "verseOrgIds": [
              "JOB.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:13"
      },
      "items": [
        {
          "text": "kata ma ok dwar ler.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.13",
            "verseOrgIds": [
              "JOB.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ler mar odiechiengʼ rumo aruma nii,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.14",
            "verseOrgIds": [
              "JOB.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:14"
      },
      "items": [
        {
          "text": "to janek aa malo kendo onego jochan gi jodhier;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.14",
            "verseOrgIds": [
              "JOB.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:14"
      },
      "items": [
        {
          "text": "otimo kamano gotieno kolidho ka jakuo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.14",
            "verseOrgIds": [
              "JOB.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wangʼ jachode bende rito mondo piny oimre;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.15",
            "verseOrgIds": [
              "JOB.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:15"
      },
      "items": [
        {
          "text": "oparo e chunye niya, 'Onge ngʼat ma biro nena,'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.15",
            "verseOrgIds": [
              "JOB.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:15"
      },
      "items": [
        {
          "text": "kendo opando wangʼe mondo kik ngʼeye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.15",
            "verseOrgIds": [
              "JOB.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jokuo turo udi gotieno,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.16",
            "verseOrgIds": [
              "JOB.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:16"
      },
      "items": [
        {
          "text": "to kochopo odiechiengʼ to gipondo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.16",
            "verseOrgIds": [
              "JOB.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:16"
      },
      "items": [
        {
          "text": "nimar ok gidwar neno ler.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.16",
            "verseOrgIds": [
              "JOB.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
