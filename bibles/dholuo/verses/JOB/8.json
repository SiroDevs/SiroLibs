  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "JOB 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bildad odwoko Ayub",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Bildad ja-Shua nodwoko kama:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.1",
            "verseOrgIds": [
              "JOB.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ibiro dhi nyime kiwacho gik ma kamago nyaka karangʼo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.2",
            "verseOrgIds": [
              "JOB.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:2"
      },
      "items": [
        {
          "text": "Wecheni chalo mana ka yamo makudho matek.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.2",
            "verseOrgIds": [
              "JOB.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende Nyasaye nyalo ngʼado bura ma ok nikare?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.3",
            "verseOrgIds": [
              "JOB.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:3"
      },
      "items": [
        {
          "text": "Bende Jehova Nyasaye Maratego nyalo weyo timo gima kare?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.3",
            "verseOrgIds": [
              "JOB.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane nyithindi otimo richo e nyime,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.4",
            "verseOrgIds": [
              "JOB.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:4"
      },
      "items": [
        {
          "text": "noweyogi mondo giyud kum mowinjore gi richogi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.4",
            "verseOrgIds": [
              "JOB.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ka inyalo dok ir Nyasaye",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.5",
            "verseOrgIds": [
              "JOB.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:5"
      },
      "items": [
        {
          "text": "mi iket kwayoni ne Jehova Nyasaye Maratego,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.5",
            "verseOrgIds": [
              "JOB.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata ka dine in ngʼama ler kendo ngimani oriere tir,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.6",
            "verseOrgIds": [
              "JOB.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:6"
      },
      "items": [
        {
          "text": "to dine oani malo mokonyi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.6",
            "verseOrgIds": [
              "JOB.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:6"
      },
      "items": [
        {
          "text": "kendo dine oduogi kari mowinjore kodi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.6",
            "verseOrgIds": [
              "JOB.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata obedo ni chakruok mari ne rachrach,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.7",
            "verseOrgIds": [
              "JOB.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:7"
      },
      "items": [
        {
          "text": "ndaloni mabiro nyime biro bedo malich miwuoro.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.7",
            "verseOrgIds": [
              "JOB.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Penj ane tiengʼ mosekalo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.8",
            "verseOrgIds": [
              "JOB.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:8"
      },
      "items": [
        {
          "text": "mondo ingʼe gik mane kweregi opuonjore,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.8",
            "verseOrgIds": [
              "JOB.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikech wan to nyoro eka nonywolwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.9",
            "verseOrgIds": [
              "JOB.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:9"
      },
      "items": [
        {
          "text": "kendo ok wangʼeyo gimoro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.9",
            "verseOrgIds": [
              "JOB.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:9"
      },
      "items": [
        {
          "text": "kendo ndalowa e pinyni chalo tipo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.9",
            "verseOrgIds": [
              "JOB.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "We ipuonjri rieko kuom joma chon",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.10",
            "verseOrgIds": [
              "JOB.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:10"
      },
      "items": [
        {
          "text": "mondo iyud rieko kod ngʼeyo mane gin-go?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.10",
            "verseOrgIds": [
              "JOB.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende togo nyalo dongo marabora kama thidhna ongee?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.11",
            "verseOrgIds": [
              "JOB.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:11"
      },
      "items": [
        {
          "text": "Koso odundu bende nyalo dongo maber kama pi onge?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.11",
            "verseOrgIds": [
              "JOB.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapod gidongo maber kendo pod ok ongʼolgi oko,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.12",
            "verseOrgIds": [
              "JOB.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:12"
      },
      "items": [
        {
          "text": "to gitwo piyo moloyo lum.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.12",
            "verseOrgIds": [
              "JOB.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mano e gima timore ne joma oweyo Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.13",
            "verseOrgIds": [
              "JOB.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:13"
      },
      "items": [
        {
          "text": "kamano e kaka geno mar joma okia Nyasaye rumo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.13",
            "verseOrgIds": [
              "JOB.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gima ogeno kuome en gima nono;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.14",
            "verseOrgIds": [
              "JOB.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:14"
      },
      "items": [
        {
          "text": "kendo gima oyiengoree chalo mbui mar otiengʼ-otiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.14",
            "verseOrgIds": [
              "JOB.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koro ka giyiengore e mbuyi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.15",
            "verseOrgIds": [
              "JOB.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:15"
      },
      "items": [
        {
          "text": "to mbuyi dikonygi adier, ma ok oyiech?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.15",
            "verseOrgIds": [
              "JOB.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 8:15"
      },
      "items": [
        {
          "text": "Koso ka gimako usi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.15",
            "verseOrgIds": [
              "JOB.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:15"
      },
      "items": [
        {
          "text": "to usi diresgi ma ok ochot.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.15",
            "verseOrgIds": [
              "JOB.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ochalo gi yien motwi kama otimo pi to chiengʼ goyo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.16",
            "verseOrgIds": [
              "JOB.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:16"
      },
      "items": [
        {
          "text": "ma bedene yarore piyo piyo e puodho;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.16",
            "verseOrgIds": [
              "JOB.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "tiendene olawore e lwendni,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.17",
            "verseOrgIds": [
              "JOB.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 8:17"
      },
      "items": [
        {
          "text": "kendo kere e dier kama otimo kite.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.8.17",
            "verseOrgIds": [
              "JOB.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
