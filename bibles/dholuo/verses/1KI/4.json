  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "1KI 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jodong Solomon gi jotelo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamano ruoth Solomon nobedo ruodh Israel duto.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.1",
            "verseOrgIds": [
              "1KI.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magi ema ne jodonge madongo:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1KI 4:2"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 4:2"
      },
      "items": [
        {
          "text": "Azaria wuod Zadok jadolo;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.2",
            "verseOrgIds": [
              "1KI.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elihoref kod Ahija yawuot Shisha jogoro;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.3",
            "verseOrgIds": [
              "1KI.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 4:3"
      },
      "items": [
        {
          "text": "Jehoshafat wuod Ahilud jachan weche.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.3",
            "verseOrgIds": [
              "1KI.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaya wuod Jehoyada jatend jolweny.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.4",
            "verseOrgIds": [
              "1KI.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 4:4"
      },
      "items": [
        {
          "text": "Zadok kod Abiathar ma jodolo;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.4",
            "verseOrgIds": [
              "1KI.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azaria wuod Nathan ma jatend jodong gwengʼ,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.5",
            "verseOrgIds": [
              "1KI.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 4:5"
      },
      "items": [
        {
          "text": "Zabud wuod Nathan jadolo kendo jangʼad ni ruoth rieko;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.5",
            "verseOrgIds": [
              "1KI.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahishar ma jatend od ruoth;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.6",
            "verseOrgIds": [
              "1KI.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 4:6"
      },
      "items": [
        {
          "text": "Adoniram wuod Abda ma jatend tij achune.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.6",
            "verseOrgIds": [
              "1KI.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomon bende ne nigi jotelo apar gariyo mane orito pinje manie Israel duto kendo ne choko gik moko ne ruoth kod joge. Moro ka moro kuomgi ne kelo chiemo kuom dwe achiel e higa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.7",
            "verseOrgIds": [
              "1KI.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magi e nying-gi:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1KI 4:8"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 4:8"
      },
      "items": [
        {
          "text": "Ben-Hur norito pinje mag gode mag Efraim:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.8",
            "verseOrgIds": [
              "1KI.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ben-Deker norito Makaz; Shalbim, Beth Shemesh kod Elon Bethhanan;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.9",
            "verseOrgIds": [
              "1KI.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ben-Hesed norito Aruboth (Soko kod pinje duto mag Hefer).",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.10",
            "verseOrgIds": [
              "1KI.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ben-Abinadab norito Nafoth Dor (kendo nokendo Tafath ma nyar Solomon).",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.11",
            "verseOrgIds": [
              "1KI.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baana wuod Ahilud norito Tanak, gi Megido nyaka Beth Shan duto machiegni gi Zarethan man mwalo mar Jezreel, koa Beth Shan nyaka Abel Mehola man loka mar Jokmeam.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.12",
            "verseOrgIds": [
              "1KI.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ben-Geber norito Ramoth Gilead (kod kuonde dak mag Jair wuod Manase man Gilead kaachiel gi piny mar Argob manie Bashan kod mieche madongo piero auchiel molwor gi ohinga motegno kendo nigi lodi mag rangeye mag mula);",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.13",
            "verseOrgIds": [
              "1KI.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahinadab wuod Ido norito Mahanaim;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.14",
            "verseOrgIds": [
              "1KI.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahimaz norito Naftali (kendo nokendo Basemath nyar Solomon);",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.15",
            "verseOrgIds": [
              "1KI.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baana wuod Hushai norito Asher kod Aloth.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.16",
            "verseOrgIds": [
              "1KI.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoshafat wuod Parua norito Isakar;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.17",
            "verseOrgIds": [
              "1KI.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimei wuod Ela norito Benjamin;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.18",
            "verseOrgIds": [
              "1KI.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geber wuod Uri norito Gilead (enie piny mane Sihon ruoth jo-Amor kod Og ruodh Bashan ne rito chon). En kende ema ne en jaduongʼ motelone gwengʼno.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.19",
            "verseOrgIds": [
              "1KI.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Konyruok mapile mag Solomon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oganda jo-Juda gi jo-Israel ne ngʼeny machalo ka kuoyo manie e dho nam; negichiemo, mi negimetho kendo negimor.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.20",
            "verseOrgIds": [
              "1KI.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo Solomon nobedo ruodh pinyno duto chakre Aora maduongʼ mar Yufrate nyaka e piny jo-Filistia mochweyo nyaka giko piny Misri. Pinjegi duto ne kelo osuru ni Solomon bende ne gin e bwo lochne ndalo duto.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.21",
            "verseOrgIds": [
              "1KI.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiemo mane Solomon nwangʼo odiechiengʼ kodiechiengʼ ne romo gunde piero auchiel mag mogo mayom kod gunde mia achiel gi piero ariyo ariyo mag mogo amoga;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.22",
            "verseOrgIds": [
              "1KI.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "rwedhi apar machwe mopongʼ, rwedhi piero ariyo machwe kod rombe gi diek mia achiel kaachiel gi mwanda; ogunde, ring ngawo kod awendo machwe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.23",
            "verseOrgIds": [
              "1KI.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar nobedo gi loch kuom pinjeruodhi duto man yo podho chiengʼ mar Aora maduongʼ chakre Tifsa nyaka Gaza kendo ne en gi kwe gi joma olwore duto.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.24",
            "verseOrgIds": [
              "1KI.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "E ndalo mag ngima mar Solomon Juda gi Israel chakre Dan nyaka Bersheba nodak gi kwe ka ngʼato ka ngʼato tiyo e puothe mar mzabibu kod ngʼope.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.25",
            "verseOrgIds": [
              "1KI.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomon ne nigi udi alufu piero angʼwen moger ni Farese kod Farese alufu apar gariyo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.26",
            "verseOrgIds": [
              "1KI.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jodong gwengʼno, moro ka moro e dweye ne chiwo ni ruoth Solomon gi welo duto mane oluongo, maonge gimoro amora morem.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.27",
            "verseOrgIds": [
              "1KI.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende ngʼato ka ngʼato nokelo Shairi gi lum e kuondegi mag keno ne farese maywa geche kod farese mamoko.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.28",
            "verseOrgIds": [
              "1KI.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rieko Solomon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye nomiyo Solomon rieko gi ngʼeyo matut moloyo kod winjo ma ok nyalo pimore mana ka kwoyo manie dho nam.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.29",
            "verseOrgIds": [
              "1KI.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rieko Solomon ne duongʼ moloyo jorieko duto manie yo wuok chiengʼ, bende noduongʼ moloyo rieko duto mag Misri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.30",
            "verseOrgIds": [
              "1KI.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noriek moloyo ngʼato angʼata moriwo kata mana Ethan ja-Ezra kendo riek moloyo Heman gi Kalkol kod Darda yawuot Mahol. Kendo humbe nolandore e pinje molwore duto.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.31",
            "verseOrgIds": [
              "1KI.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nogoyo ngeche alufu adek kendo wende mane owero noromo alufu achiel gi abich.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.32",
            "verseOrgIds": [
              "1KI.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nowuoyo kuom kit yien kochako gi yiende Sida mag Lebanon nyaka owino magawore e kor udi. Bende nopuonjo ji kuom le kod winy gi le mamol kod rech.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.33",
            "verseOrgIds": [
              "1KI.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji moa e pinje duto nobiro mondo owinji rieko Solomon koorgi gi ruodhi mag piny mane osewinjo humb riekone.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.34",
            "verseOrgIds": [
              "1KI.5.14"
            ]
          }
        }
      ]
    }
  ],
