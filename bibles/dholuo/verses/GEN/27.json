  "verseCount": 46,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "GEN 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Isaka ogwedho Jakobo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane Isaka oseti kendo wengene noseimore makoro ok nyal neno, noluongo Esau wuode makayo kendo owachone niya, \"Wuoda.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.1",
            "verseOrgIds": [
              "GEN.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 27:1"
      },
      "items": [
        {
          "text": "Eka Esau nodwoke niya, \"An ka.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.1",
            "verseOrgIds": [
              "GEN.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka nowacho niya, \"Koro asedoko moti kendo ok angʼeyo ndalo thona.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.2",
            "verseOrgIds": [
              "GEN.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo koro sani kaw gigi mag lweny kaka atungʼ kod asere kendo idhi e thim ikelna ring le.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.3",
            "verseOrgIds": [
              "GEN.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tedna ringʼo mamit mana kaka ahero cha kendo ikelna mondo acham mondo mi amiyi gwethna kapok atho.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.4",
            "verseOrgIds": [
              "GEN.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Rebeka nochiko ite ka Isaka wuoyo gi wuode Esau. Kane Esau osewuok odhi e thim mondo odhi oneg le kendo okel,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.5",
            "verseOrgIds": [
              "GEN.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rebeka nowacho ne Jakobo wuode niya, \"Nawinjo ka wuonu wacho ni owadu Esau niya,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.6",
            "verseOrgIds": [
              "GEN.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Kelna ring le kendo ilosna mamit mondo acham mondo agwedhi e nyim Jehova Nyasaye kapok atho.'",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.7",
            "verseOrgIds": [
              "GEN.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koro wuoda chik iti malongʼo kendo tim gima awachoni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.8",
            "verseOrgIds": [
              "GEN.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhiyo e kweth mag jamni kendo ikelna nyidiek ariyo mopugno, mondo mi atedne wuonu ringʼo mamit kaka ohero-cha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.9",
            "verseOrgIds": [
              "GEN.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ mano iterne wuonu mondo ocham bangʼe ogwedhi kapok otho.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.10",
            "verseOrgIds": [
              "GEN.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobo nowacho ne Rebeka min mare niya, \"Esau omera en ngʼat ma rayier an to an gi del mapoth",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.11",
            "verseOrgIds": [
              "GEN.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Datim nangʼo ka diponi wuora omula? Donge abiro nenora ngʼama wuonde kendo biro kelona kwongʼ kar gweth.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.12",
            "verseOrgIds": [
              "GEN.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Min Jakobo nonyise niya, \"Wuoda, we mondo kwongʼno omaka, in to tim mana gima awacho; dhiyo kendo ikelnagi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.13",
            "verseOrgIds": [
              "GEN.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Jakobo nodhi mokelo nyidiek mopugno ne min mare kendo noloso chiemo mamit mana kaka wuon-gi ohero.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.14",
            "verseOrgIds": [
              "GEN.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Rebeka nokawo lewni mabeyo mag Esau wuode maduongʼ mane oyudo en-go e ot kendo ne orwako ne Jakobo wuode matin.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.15",
            "verseOrgIds": [
              "GEN.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo Rebeka nokawo piende diego moumogo bede Jakobo kod ngʼute kuonde maonge yier.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.16",
            "verseOrgIds": [
              "GEN.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka nomiyo Jakobo wuode chiemo molos mamit kod kuon mane osetedo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.17",
            "verseOrgIds": [
              "GEN.27.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobo nodhi ir wuon mare kendo owachone niya, \"Wuora.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.18",
            "verseOrgIds": [
              "GEN.27.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 27:18"
      },
      "items": [
        {
          "text": "Eka Isaka nopenje niya, \"Wuoda, to in ngʼa?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.18",
            "verseOrgIds": [
              "GEN.27.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobo nodwoko wuon mare niya, \"An Esau wuodi makayo. Asetimo kaka ne inyisa. Yie ia malo ibed piny kendo icham ring le ma akeloni mondo mi igwedha.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.19",
            "verseOrgIds": [
              "GEN.27.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka nopenje niya, \"To ne iyude piyo nade wuoda?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.20",
            "verseOrgIds": [
              "GEN.27.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 27:20"
      },
      "items": [
        {
          "text": "Nodwoke niya, \"Jehova Nyasaye ma Nyasaye nogwedha.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.20",
            "verseOrgIds": [
              "GEN.27.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Isaka nowacho ne Jakobo niya, \"Sud machiegni mondo mi amuli, wuoda, mondo mi angʼe adier ka in wuoda Esau koso.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.21",
            "verseOrgIds": [
              "GEN.27.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobo nobedo machiegni gi wuon mare Isaka, mano mule kendo owachone niya, \"Dwol to mar Jakobo, to lwedo to gin lwet Esau.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.22",
            "verseOrgIds": [
              "GEN.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka ne ok nyal fwenye nikech lwetene ne rayier ka mag Esau owadgi, kuom mano nogwedhe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.23",
            "verseOrgIds": [
              "GEN.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bende in wuoda ma Esau adier?\" Isaka nopenje.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.24",
            "verseOrgIds": [
              "GEN.27.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 27:24"
      },
      "items": [
        {
          "text": "Eka Jakobo nodwoke ni, \"Ee en an.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.24",
            "verseOrgIds": [
              "GEN.27.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka nowacho niya, \"Wuoda, koro kelna ring le mondo acham, mondo mi agwedhi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.25",
            "verseOrgIds": [
              "GEN.27.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 27:25"
      },
      "items": [
        {
          "text": "Jakobo nokelone ringʼo mi ochamo bende nokelone divai mi omadho.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.25",
            "verseOrgIds": [
              "GEN.27.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Isaka wuon mare nowachone niya, \"Bi ka wuoda mondo inyodha.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.26",
            "verseOrgIds": [
              "GEN.27.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano nodhi ire ma onyodhe. Kane Isaka owinjo tik lepe, nogwedhe kendo owachone niya,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.27",
            "verseOrgIds": [
              "GEN.27.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 27:27"
      },
      "items": [
        {
          "text": "\"Ee, tik mar wuoda dungʼ mamit",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.27",
            "verseOrgIds": [
              "GEN.27.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 27:27"
      },
      "items": [
        {
          "text": "machalo gi tik mar puodho,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.27",
            "verseOrgIds": [
              "GEN.27.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 27:27"
      },
      "items": [
        {
          "text": "ma Jehova Nyasaye osegwedho.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.27",
            "verseOrgIds": [
              "GEN.27.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 27:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad Nyasaye miyi koth moa e polo",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.28",
            "verseOrgIds": [
              "GEN.27.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 27:28"
      },
      "items": [
        {
          "text": "kod piny ma omewo kod cham mogundho,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.28",
            "verseOrgIds": [
              "GEN.27.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 27:28"
      },
      "items": [
        {
          "text": "kod divai manyien.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.28",
            "verseOrgIds": [
              "GEN.27.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad oganda duto bed jotichni",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.29",
            "verseOrgIds": [
              "GEN.27.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 27:29"
      },
      "items": [
        {
          "text": "kendo ji duto omiyi duongʼ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.29",
            "verseOrgIds": [
              "GEN.27.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 27:29"
      },
      "items": [
        {
          "text": "Bed ruoth ewi oweteni duto",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.29",
            "verseOrgIds": [
              "GEN.27.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 27:29"
      },
      "items": [
        {
          "text": "kendo mad yawuot minu omiyi duongʼ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.29",
            "verseOrgIds": [
              "GEN.27.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 27:29"
      },
      "items": [
        {
          "text": "Ngʼato angʼata mokwedi mondo okwede",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.29",
            "verseOrgIds": [
              "GEN.27.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 27:29"
      },
      "items": [
        {
          "text": "kendo ngʼato angʼata mogwedhi nogwedhi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.29",
            "verseOrgIds": [
              "GEN.27.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 27:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ ka Isaka nosetieko gwedho Jakobo kendo Jakobo ne pok odhi mabor, to gikanyono Esau nochopo koa dwar.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.30",
            "verseOrgIds": [
              "GEN.27.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "En bende noloso chiemo mamit kendo nokelo ne wuon mare. Eka Esau nowacho ne wuon mare niya, \"Wuora, aa malo ibed piny mondo mi icham ringʼo malosoni kendo igwedha.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.31",
            "verseOrgIds": [
              "GEN.27.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka wuon-gi nopenjo niya, \"In ngʼa?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.32",
            "verseOrgIds": [
              "GEN.27.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 27:32"
      },
      "items": [
        {
          "text": "Nodwoke niya, \"An Esau, wuodi makayo.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.32",
            "verseOrgIds": [
              "GEN.27.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka nobwok matek ahinya kendo owacho niya, \"To kara macha ne en ngʼa, mane onego le kendo okelona? Nende achamo ringʼono kapok ibiro kendo agwedhe; kendo kuom adier asegwedhe.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.33",
            "verseOrgIds": [
              "GEN.27.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 27:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane Esau owinjo weche wuon mare, noywak malit ka en-gi mirima mager kowachone wuon mare niya, \"Wuora, gwedha an bende!\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.34",
            "verseOrgIds": [
              "GEN.27.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 27:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "To nowachone niya, \"Owadu nobiro mowuonda mi okawo gwethni.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.35",
            "verseOrgIds": [
              "GEN.27.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 27:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau nowacho niya, \"Kara ma emomiyo nochake ni Jakobo? Osewuonda koro nyadiriyo: Nokawo duongʼ mar nywolna kendo koro okawo gwethna!\" Eka Esau nopenjo wuon mare niya, \"Bende gweth moro didongʼna?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.36",
            "verseOrgIds": [
              "GEN.27.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 27:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka nodwoko Esau niya, \"Asekete ruodhi kendo wedene duto aseketo obed jotichne bende asegwedhe gi cham kod divai. Koro ere gima anyalo timoni wuoda?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.37",
            "verseOrgIds": [
              "GEN.27.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 27:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau nowacho ne wuon mare niya, \"In mana kod gweth achiel kende wuora? Yie igwedha an bende!\" Eka Esau noywak matek gi dwol maduongʼ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.38",
            "verseOrgIds": [
              "GEN.27.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "GEN 27:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuon mare Isaka nodwoke niya,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.39",
            "verseOrgIds": [
              "GEN.27.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 27:39"
      },
      "items": [
        {
          "text": "\"Inidag e piny",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.39",
            "verseOrgIds": [
              "GEN.27.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 27:39"
      },
      "items": [
        {
          "text": "maonge mwandu,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.39",
            "verseOrgIds": [
              "GEN.27.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 27:39"
      },
      "items": [
        {
          "text": "kendo motwo ma ok yud koth.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.39",
            "verseOrgIds": [
              "GEN.27.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "GEN 27:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ligangla ema nomiyi chiemo",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.40",
            "verseOrgIds": [
              "GEN.27.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 27:40"
      },
      "items": [
        {
          "text": "kendo inibed jatij owadu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.40",
            "verseOrgIds": [
              "GEN.27.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 27:40"
      },
      "items": [
        {
          "text": "To ka iyudo loch",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.40",
            "verseOrgIds": [
              "GEN.27.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 27:40"
      },
      "items": [
        {
          "text": "to iningʼanyne,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.40",
            "verseOrgIds": [
              "GEN.27.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 27:40"
      },
      "items": [
        {
          "text": "kendo nia e bwo lochne.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.40",
            "verseOrgIds": [
              "GEN.27.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jakobo oringo odhi ir Laban",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "GEN 27:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau nomako sadha gi Jakobo nikech gweth mane wuon-gi osemiyo Jakobo. Nowacho e chunye niya, \"ndalo mag tho wuora chiegni, bangʼe abiro nego Jakobo owadwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.41",
            "verseOrgIds": [
              "GEN.27.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "GEN 27:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane Rebeka onyisi gima Esau wuode makayo paro timo, noluongo Jakobo wuode ma chogo kendo owachone niya, \"Esau owadu nigi paro mar negi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.42",
            "verseOrgIds": [
              "GEN.27.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "GEN 27:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koro wuoda, tim gima awachoni: Ring idhi Haran ir Laban owadwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.43",
            "verseOrgIds": [
              "GEN.27.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "GEN 27:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dak kode kuno mondi nyaka mirimb owadu dog chien.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.44",
            "verseOrgIds": [
              "GEN.27.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "GEN 27:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka mirimb owadu oserumo kuomi kendo wiye osewil gi gima ne itimone, to abiro oroni wach mondo iduog ia kuno.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.45",
            "verseOrgIds": [
              "GEN.27.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 27:45"
      },
      "items": [
        {
          "text": "Ere gima omiyo yawuota ariyo ditho odiechiengʼ achiel?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.45",
            "verseOrgIds": [
              "GEN.27.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "GEN 27:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Rebeka nowacho ne Isaka niya, \"ajok gi ngima nikech nyi jo-Hiti-gi. Ka Jakobo bende nyalo kawo dhako mana kuom nyi jo-Hiti-gi, to owinjore atho.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.46",
            "verseOrgIds": [
              "GEN.27.46"
            ]
          }
        }
      ]
    }
  ],
