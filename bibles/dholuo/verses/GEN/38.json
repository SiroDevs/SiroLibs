              "type": "text"
            }
          ]
        },
        {
          "text": "Kane oyudo onywol, lwet nyathi achiel nowuok oko; kuom mano jacholo nokawo usi makwar kendo otweyo e ngʼut lwedono ka owacho niya, \"Ma ema ne okwongo owuok.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.28",
            "verseOrgIds": [
              "GEN.38.28"
            ]
          }
        },
        {
          "name": "verse",
