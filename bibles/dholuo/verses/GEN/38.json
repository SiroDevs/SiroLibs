          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "To kane nyathino odwoko lwete iye, owadgi machielo nowuok mi owacho niya, \"Kama e kaka ithinyori oko!\" Omiyo nochake ni Perez.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.29",
            "verseOrgIds": [
              "GEN.38.29"
            ]
          }
        },
        {
