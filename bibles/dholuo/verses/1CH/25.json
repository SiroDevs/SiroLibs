          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pok mar apar gabiriyo ne mar Joshbekasha gi yawuote kod wedene, giduto ji apar gariyo,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.24",
            "verseOrgIds": [
              "1CH.25.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pok mar apar gaboro ne mar Hanani gi yawuote kod wedene, giduto ji apar gariyo,",
          "type": "text",
          "attrs": {
