  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "1CH 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okel Sandug Muma mar Nyasaye Jerusalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane Daudi osegero ute e Dala Maduongʼ mar Daudi, ne oloso kama Sandug Muma mar Nyasaye nyalo betie ma ogurone hema.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.1",
            "verseOrgIds": [
              "1CH.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼe Daudi nowacho niya, \"Onge ngʼato machielo manyalo tingʼo Sandug Muma mar Nyasaye makmana jo-Lawi nikech Jehova Nyasaye noyierogi mondo gitingʼ Sandug Muma mar Jehova Nyasaye kendo mondo gitine nyaka chiengʼ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.2",
            "verseOrgIds": [
              "1CH.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi nochoko jo-Israel duto Jerusalem mondo gikel Sandug Muma mar Jehova Nyasaye kama ne oselosone.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.3",
            "verseOrgIds": [
              "1CH.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ochoko bende nyikwa Harun kod jo-Lawi kanyakla.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koa e nyikwa Kohath,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.5",
            "verseOrgIds": [
              "1CH.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 15:5"
      },
      "items": [
        {
          "text": "ne gin ji mia achiel gi piero ariyo kotelnegi gi Uriel,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.5",
            "verseOrgIds": [
              "1CH.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "koa e nyikwa Merari,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.6",
            "verseOrgIds": [
              "1CH.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 15:6"
      },
      "items": [
        {
          "text": "ne gin ji mia ariyo gi piero ariyo kotelnegi gi Asaya,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.6",
            "verseOrgIds": [
              "1CH.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "koa e nyikwa Gershon,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.7",
            "verseOrgIds": [
              "1CH.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 15:7"
      },
      "items": [
        {
          "text": "ne gin ji mia achiel gi piero adek kotelnegi gi Joel,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.7",
            "verseOrgIds": [
              "1CH.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "koa e nyikwa Elizafan,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.8",
            "verseOrgIds": [
              "1CH.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 15:8"
      },
      "items": [
        {
          "text": "ne gin ji mia ariyo kotelnegi gi Shemaya,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.8",
            "verseOrgIds": [
              "1CH.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "koa e nyikwa Hebron,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.9",
            "verseOrgIds": [
              "1CH.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 15:9"
      },
      "items": [
        {
          "text": "ne gin ji piero aboro kotelnegi gi Eliel",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.9",
            "verseOrgIds": [
              "1CH.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "koa e nyikwa Uziel,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.10",
            "verseOrgIds": [
              "1CH.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 15:10"
      },
      "items": [
        {
          "text": "ne gin ji mia achiel gi apar gariyo kotelnegi gi Aminadab.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.10",
            "verseOrgIds": [
              "1CH.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼe Daudi noluongo Zadok kod Abiathar ma jodolo kod Uriel, Asaya, Joel, Shemaya, Eliel kod Aminadab ma ja-Lawi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.11",
            "verseOrgIds": [
              "1CH.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nowachonegi niya, \"Un e jotend anywola mar jo-Lawi, un kaachiel gi joweteu ma jo-Lawi nyaka upwodhru mondo uom Sandug Muma mar Jehova Nyasaye, ma Nyasach Israel mondo ukele kama aseikone.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.12",
            "verseOrgIds": [
              "1CH.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye ma Nyasachwa ne iye owangʼ kodwa e kinde mokwongo nikech un jo-Lawi ne ok udhi ome bende ne ok wapenje kaka dine wakele e yo mowinjore.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.13",
            "verseOrgIds": [
              "1CH.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo jodolo kod jo-Lawi nopwodhore mondo mi gikel Sandug Muma mar Jehova Nyasaye ma Nyasach jo-Israel.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.14",
            "verseOrgIds": [
              "1CH.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo-Lawi noliero Sandug Muma mar Nyasaye e gokgi gi ludhe, mana kaka Musa nochiko kaluwore gi wach Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.15",
            "verseOrgIds": [
              "1CH.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi nowachone jotend jo-Lawi mondo oyier jowetegi kaka jower mondo ower wende mag mor ka gigoyo thumbe machalo orutu, nyatiti gi ongengʼo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.16",
            "verseOrgIds": [
              "1CH.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo jo-Lawi noyiero Heman wuod Joel kuom owetene, Asaf wuod Berekia, to kuom owetegi ma joka Merari, negiyiero Ethan wuod Kushaya",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.17",
            "verseOrgIds": [
              "1CH.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kaachiel gi jowetene ma jolupne e tich, mane gin: Zekaria, Jaziel, Shemiramoth, Jehiel, Uni, Eliab, Benaya, Maseya, Matithia, Elifelehu, Mikneya, Obed-Edom kod Jeyel ma jorit rangeye.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.18",
            "verseOrgIds": [
              "1CH.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "To jogo thum ma Heman, Asaf kod Ethan nonego go ongengʼo mar mula,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.19",
            "verseOrgIds": [
              "1CH.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zekaria, Aziel, Shemiramoth, Jehiel, Uni, Eliab, Maseya kod Benaya nonego go nyatiti kaluwore gi chenro wer miluongo ni",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.20",
            "verseOrgIds": [
              "1CH.15.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "alamoth",
              "type": "text",
              "attrs": {
                "verseId": "1CH.15.20",
                "verseOrgIds": [
                  "1CH.15.20"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.20",
            "verseOrgIds": [
              "1CH.15.20"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.20",
            "verseOrgIds": [
              "1CH.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "to Matithia, Elifelehu, Mikneya, Obed-Edom, Jeyel kod Azazia to nonego go nyatiti kaluwore gi chenro miluongo ni",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.21",
            "verseOrgIds": [
              "1CH.15.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "sheminith.",
              "type": "text",
              "attrs": {
                "verseId": "1CH.15.21",
                "verseOrgIds": [
                  "1CH.15.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.21",
            "verseOrgIds": [
              "1CH.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenania jatend jo-Lawi notelo ne wer, mano ne tije nikech nolony e wer ahinya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.22",
            "verseOrgIds": [
              "1CH.15.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Berekia kod Elkana to ne gin jorit dhout od Sandug Muma mar Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.23",
            "verseOrgIds": [
              "1CH.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shabania, Joshafat, Nethanel, Amasai, Zekaria, Benaya kod Eliezer ma jodolo, to nonego go turumbete e nyim Sandug Muma mar Nyasaye. Obed-Edom kod Jehia bende ne jorit od Sandug Muma mar Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.24",
            "verseOrgIds": [
              "1CH.15.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Daudi kod jodong Israel kaachiel gi jotend lweny mane orito jolweny alufu achiel ne odhi mondo okel Sandug Muma mar singruok mar Jehova Nyasaye koa e od Obed-Edom gi ilo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.25",
            "verseOrgIds": [
              "1CH.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negitimo misango gi rwedhi abiriyo kod rombe abiriyo nikech Nyasaye nokonyo jo-Lawi manotingʼo Sandug Muma mar singruok mar Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.26",
            "verseOrgIds": [
              "1CH.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi, jo-Lawi duto mane otingʼo Sandug Muma mar singruok mar Nyasaye, jower kaachiel gi Kenania mane otelo ne jower norwakore gi aroche mag bafta. Daudi bende norwako law mayom mar dolo miluongo ni efod.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.27",
            "verseOrgIds": [
              "1CH.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamano jo-Israel nokelo Sandug Muma mar singruok mar Jehova Nyasaye ka gigoyo sigalagala gi tunge im, gi turumbete kod ongengʼo kendo ka gigoyo orutu kod nyatiti.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.28",
            "verseOrgIds": [
              "1CH.15.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane Sandug Muma mar singruok mar Jehova Nyasaye ochopo e Dala Maduongʼ mar Daudi, ne oyudo ka Mikal nyar Saulo ne ngʼicho gie dirisa. To ka noneno Ruoth Daudi kamiel kendo tugo komor, nochaye gie chunye.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.29",
            "verseOrgIds": [
              "1CH.15.29"
            ]
          }
        }
      ]
    }
