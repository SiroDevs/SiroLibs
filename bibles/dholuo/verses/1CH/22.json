  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "1CH 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼe Daudi nowacho niya, \"Ma e kama od Jehova Nyasaye ma Nyasaye nobedie, kendo kae ema jo-Israel nogerie kendo mar misango miwangʼo pep.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.1",
            "verseOrgIds": [
              "1CH.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ikruok mar gero hekalu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Daudi nogolo chik mondo ochok jodak duto manie piny jo-Israel kendo koa kuomgi noyiero jangʼad kite mondo opa kite migerogo od Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.2",
            "verseOrgIds": [
              "1CH.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noiko nyinyo modhuro mondo olosgo musmande migedogo kendo mirwakogo dhoudi mag rangeye gi mula mathoth mokadho apima.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.3",
            "verseOrgIds": [
              "1CH.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende noiko yiend sida madongo ma ok kwan nikech jo-Sidon gi jo-Turo nokelone Daudi yiende mangʼeny mag sida.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.4",
            "verseOrgIds": [
              "1CH.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi nowacho niya, \"Wuoda Solomon pod rawera mayot kendo en gi ngʼeyo matin, to ot monego ogerne Jehova Nyasaye nyaka bed miwuoro kendo ma humbe gi berne onego onere e piny mangima. Omiyo nyaka aikne gige gedo.\" Kuom mano, Daudi noiko gik moko mangʼeny kapok otho.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.5",
            "verseOrgIds": [
              "1CH.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼe noluongo wuode Solomon mochike ni mondo oger ot ne Jehova Nyasaye, ma Nyasach Israel.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.6",
            "verseOrgIds": [
              "1CH.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi nowachone Solomon niya, \"Wuoda naparo e chunya mondo ager ot miluongo gi Nying Jehova Nyasaye, ma Nyasacha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.7",
            "verseOrgIds": [
              "1CH.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "To wach Jehova Nyasaye nobirona kawacho ni, 'Isechwero remo mangʼeny kendo isekedo lwenje mangʼeny. Ok iniger ot maluongo Nyinga nikech isechwero remo mangʼeny e nyima.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.8",
            "verseOrgIds": [
              "1CH.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ininywol wuowi manobed ngʼat mohero kwe maonge tungni, kendo anami obed gi kwe kuom jowasike molwore. Enochake ni Solomon, mi anakelni jo-Israel kwe e ndalo lochne.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.9",
            "verseOrgIds": [
              "1CH.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "En ema noger ot miluongo gi Nyinga. Enobed wuoda, to anabed wuon mare kendo anagur loch mar pinyruodhe mar Israel nyaka chiengʼ.'",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.10",
            "verseOrgIds": [
              "1CH.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Koro wuoda, Jehova Nyasaye obed kodi, kendo mad ogwedhi mondo mi iger od Jehova Nyasaye, ma Nyasachi kaka nosewacho ni initim.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.11",
            "verseOrgIds": [
              "1CH.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad Jehova Nyasaye omiyi rieko kod ngʼeyo e kinde moketi mondo irit jo-Israel kendo mondo mi irit chik Jehova Nyasaye, ma Nyasachi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.12",
            "verseOrgIds": [
              "1CH.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼe inine ber kimako chike kod buche ma Jehova Nyasaye nomiyo Musa ne jo-Israel. Bed motegno kendo gichir, kik iluor kata kik chunyi bed gi nyosruok.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.13",
            "verseOrgIds": [
              "1CH.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Aseneno lit malich mondo aikne od Jehova Nyasaye dhahabu ma pekne romo tan alufu adek mia abiriyo gi piero abich kaachiel gi fedha ma pekne romo tan alufu piero adek gabiriyo gi mia abich kaachiel gi mula kod nyinyo ma pekgi okadho apima kod yiende gi kite. In bende inyalo medo moko.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.14",
            "verseOrgIds": [
              "1CH.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "In gi jotich mangʼeny kaka jopa kite, jogedo gi jopa bao kaachiel gi ji molony e tije mopogore opogore,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.15",
            "verseOrgIds": [
              "1CH.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "mag dhahabu, kod fedha, mula kod nyinyo kaachiel gi jopecho mokadho akwana. Koro chak tich, mad Jehova Nyasaye obed kodi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.16",
            "verseOrgIds": [
              "1CH.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼe Daudi nochiko jotend Israel duto mondo okony wuode Solomon.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.17",
            "verseOrgIds": [
              "1CH.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nowachonegi niya, \"To donge Jehova Nyasaye ma Nyasachu ni kodu? To donge osemiyou kwe e alworau duto? Nimar osechiwo joma odak e pinyni e lweta ma pinyni koro nitie e bwo loch Jehova Nyasaye kaachiel gi joge.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.18",
            "verseOrgIds": [
              "1CH.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo koro keturu chunyu gi ngimau kuom dwaro Jehova Nyasaye ma Nyasachu. Koro chakuru gero kama ler mar lemo mar Jehova Nyasaye mondo omi ukel Sandug Muma mar Singruok mar Jehova Nyasaye kod gigo mopwodhi mag Nyasaye ei hekalu mibiro gero ne Nying Jehova Nyasaye.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.19",
            "verseOrgIds": [
              "1CH.22.19"
            ]
          }
        }
      ]
    }
  ],
