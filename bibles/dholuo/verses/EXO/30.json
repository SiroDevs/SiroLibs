  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "EXO 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kendo mar misango miwangʼoe ubani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Los kendo mar misango miwangʼoe ubani gi yiend siala.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.1",
            "verseOrgIds": [
              "EXO.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Borne gi lachne nyaka bed maromre ma gin nus mita moro ka moro, to borne madhi malo nyaka bed mita achiel, kendo tungene nyaka bed gimoro achiel kode.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.2",
            "verseOrgIds": [
              "EXO.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baw wiye kod bethene duto kod tungene gi dhahabu maler bende losne ndiri mar dhahabu molwore.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.3",
            "verseOrgIds": [
              "EXO.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los ratege ariyo mag dhahabu ne kendono mar misangono e bwo ndiri ka gimanyore ariyo koni gi koni mondo omak ludhe mitingʼego.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.4",
            "verseOrgIds": [
              "EXO.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los yiend siala kendo ibawgi gi dhahabu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.5",
            "verseOrgIds": [
              "EXO.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ket kendono mar misango e nyim pasia molier e nyim Sandug Muma man e nyim Sandug Raparno kama abiro romoe kodu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.6",
            "verseOrgIds": [
              "EXO.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Harun nyaka wangʼ ubani mangʼwe ngʼar e kendono mar misango okinyi kokinyi koiko teyni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.7",
            "verseOrgIds": [
              "EXO.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyaka owangʼ ubani kendo e seche momokoe teyni godhiambo mondo ubanigo owangʼ kinde duto e nyim Jehova Nyasaye nyaka ne tienge mabiro.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.8",
            "verseOrgIds": [
              "EXO.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik ichiw kit ubani moro amora e kendono mar misango kata misango miwangʼo pep kata chiwo mar cham kendo kik ichiw misango miolo piny.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.9",
            "verseOrgIds": [
              "EXO.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harun nochiw misango mar pwodho tunge kendono dichiel e higa. Chiwo mar higa ka higa mar pwodhruok nyaka tim gi remb misango mar golo richo ni tienge duto mabiro. Kendono nobed maler moloyo ni Jehova Nyasaye.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.10",
            "verseOrgIds": [
              "EXO.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chiwo mar pwodhruok",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Jehova Nyasaye nowacho ne Musa niya,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.11",
            "verseOrgIds": [
              "EXO.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ka ikwano jo-Israel, to ngʼato ka ngʼato nyaka chul nengo ne Jehova Nyasaye mowarogo ngimane e sa ma ikwane. Eka onge masira mane ogore kuomgi ka ikwanogi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.12",
            "verseOrgIds": [
              "EXO.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼato angʼata moriwore gi joma osekwan nyaka chiw nus shekel kaluwore gi kweno mar shekel manie kama ler mar lemo, ma pekne romo kilo auchiel. Nus shekel mochiwo nobed mar Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.13",
            "verseOrgIds": [
              "EXO.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jogo duto moriwore gi joma osekwan ma jo-higni piero ariyo kadhi nyime nyaka kel chiwono ne Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.14",
            "verseOrgIds": [
              "EXO.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka uchulo Jehova Nyasaye chiwo ma upwodhorugo, jo-mwandu kik kel mangʼeny moloyo midwaro, to jachan bende kik kel matin moremo kar midwaro.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.15",
            "verseOrgIds": [
              "EXO.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaw pesa mar pwodhruokno kuom jo-Israel kendo kete e tich mar Hemb Romo. Enobed Rapar ni jo-Israel e nyim Jehova Nyasaye ka utimogo pwodhruok ni ngimau.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.16",
            "verseOrgIds": [
              "EXO.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Karaya mar luok",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Jehova Nyasaye nowacho ne Musa niya,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.17",
            "verseOrgIds": [
              "EXO.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Los karaya mar luok molos gi mula to gi rachungi miketoe karayano bende olos gi mula. Kete e kind Hemb Romo kod kendo mar misango bangʼe iol pi e iye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.18",
            "verseOrgIds": [
              "EXO.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harun gi yawuote noluok tiendegi kod lwetegi gi pi mogol e iye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.19",
            "verseOrgIds": [
              "EXO.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinde ka kinde ka gidonjo e Hemb Romo, to nyaka giluokre gi pigno mondo kik githo. Bende kinde ka kinde ma gidhi kar kendo mar misango mondo gichiw misango miwangʼo pep ni Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.20",
            "verseOrgIds": [
              "EXO.30.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "to nyaka giluok lwetgi gi tiendgi mondo kik githo. Mano nobedi chik mochwere momako Harun gi nyikwaye nyaka ni tienge duto mabiro.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.21",
            "verseOrgIds": [
              "EXO.30.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mo mar pwodhruok",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Jehova Nyasaye nowacho ne Musa niya,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.22",
            "verseOrgIds": [
              "EXO.30.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gik mangʼwe ngʼar monego ikaw gin: kilo auchiel mar mane-mane, kilo adek mar dalasini, gi obala ndago maromo kilo adek,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.23",
            "verseOrgIds": [
              "EXO.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "kasia maromo kilo auchiel, kendo giduto nyaka pimgi gi rapim ma itiyogo e kama ler mar lemo, to bende ikel lita angʼwen mar mo zeituni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.24",
            "verseOrgIds": [
              "EXO.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riw gigi duto mondo ilos mor pwodhruok maler madungʼ tik mangʼwe ngʼar mana kaka ngʼat molony e loso gik mangʼwe ngʼar loso. Enobed mor pwodhruok maler.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.25",
            "verseOrgIds": [
              "EXO.30.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼe ti kode ka iwirogo Hemb Romo, Sandug Muma mar Singruok,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.26",
            "verseOrgIds": [
              "EXO.30.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "mesa gi gigene duto mag tije, rachungi taya gi gigene duto mag tich, kendo mar misango miwangʼoe ubani,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.27",
            "verseOrgIds": [
              "EXO.30.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 30:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo mar misango miwangʼo pep gi gik moko duto mitiyogo e kendono, gi karaya kod rachungi mare.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.28",
            "verseOrgIds": [
              "EXO.30.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 30:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyaka ipwodhgi mondo gibed maler moloyo kendo gimoro amora morere kuomgi nobed maler.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.29",
            "verseOrgIds": [
              "EXO.30.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 30:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wir Harun gi yawuote kendo pwodhgi mondo gitina kaka jodolo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.30",
            "verseOrgIds": [
              "EXO.30.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 30:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyis jo-Israel kama, 'Ma ema nobed mor pwodhruok maler ne tienge duto mabiro.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.31",
            "verseOrgIds": [
              "EXO.30.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 30:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik iole e dend ji bende kik ilos mo moro amora machal kaka olos mono. En gima owal kendo nyaka ikawe kaka gima owal.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.32",
            "verseOrgIds": [
              "EXO.30.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 30:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼato angʼata manolos mo machal kamano kata manowir ngʼato angʼata ma ok jadolo nongʼad kare oko.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.33",
            "verseOrgIds": [
              "EXO.30.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ubani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 30:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Jehova Nyasaye nowacho ne Musa niya, \"Kaw gik madum mangʼwe ngʼar kaka duogo, sare, mieny kod ubani maler, kendo pekgi nyaka bed maromre,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.34",
            "verseOrgIds": [
              "EXO.30.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 30:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo riwgi milosgo ubani mangʼwe ngʼar ma en tich jalos gik mangʼwe ngʼar. Ketie chumbi mondo obed gima ler mowal.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.35",
            "verseOrgIds": [
              "EXO.30.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 30:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kawe moko matin kuom gigo mondo ireg mayom kendo iketie Sandug Muma manie nyim Hemb Romo, kama abiro romoe kodu, kendo nobednu maler moloyo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.36",
            "verseOrgIds": [
              "EXO.30.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 30:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik ulos ubani moro amora e yo machal kama ne un uwegi, nikech en gima ler mowalne Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.37",
            "verseOrgIds": [
              "EXO.30.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 30:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼato angʼata manolos ubani e yo machal kamano mondo owinj tik mamit ma aa kuome nyaka ngʼad kare oko kuom ogandane.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.38",
            "verseOrgIds": [
              "EXO.30.38"
            ]
          }
        }
      ]
    }
