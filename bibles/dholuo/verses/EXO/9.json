              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Musa noweyo Farao mi gidhi oko mar dala. Noyaro bade ni Jehova Nyasaye, mi mor polo kod pe norumo kendo koth bende ne ok ochwe e piny.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.33",
            "verseOrgIds": [
