            "sid": "EXO 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane Farao oneno ka koth, pe gi mor polo orumo, to nomedo timo richo. Nomedo bedo gi chuny matek en kaachiel gi jodonge.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.34",
            "verseOrgIds": [
              "EXO.9.34"
            ]
          }
        },
        {
