{
  "id": "EXO.31",
  "number": "31",
  "bookId": "EXO",
  "reference": "Wuok 31",
  "copyright": "Biblica® Ochiw Thuolo Motingʼo Loko Manyien™ Weg Loko © 1980, 2002, 2003, 2020 otim gi Biblica, Inc. Biblica® Open New Luo Translation™ Copyright © 1980, 2002, 2003, 2020 by Biblica, Inc. \"Biblica\" en sai mondik mongorore e piny Amerika kendo en kido moyie malongʼo e ofis Biblica, Inc. Itiyo kode gi thuolo moa kuom Biblica, Inc. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "EXO 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bazalel gi Oholiab",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Jehova Nyasaye nowacho ne Musa niya,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.1",
            "verseOrgIds": [
              "EXO.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ngʼe ni aseyiero Bezalel wuod Uri, ma wuod Hur, maa e dhood Juda,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.2",
            "verseOrgIds": [
              "EXO.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo asepongʼe gi Roho mar Nyasaye mondo obed gi lony, gi rieko, gi nyalo kod ngʼeyo tije duto mag lwedo;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.3",
            "verseOrgIds": [
              "EXO.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "mondo omi ogor kido mabeyo mag dhahabu gi fedha kod mula,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.4",
            "verseOrgIds": [
              "EXO.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo ongʼad kite duto gi payo bao kendo mondo otim kit tije duto mag lwedo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.5",
            "verseOrgIds": [
              "EXO.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata kamano aseyiero Oholiab wuod Ahisamak bende, maa e dhood Dan mondo okonye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.6",
            "verseOrgIds": [
              "EXO.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EXO 31:6"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "EXO 31:6"
      },
      "items": [
        {
          "text": "\"Bende asechiwo rieko ni jotich lwedo duto molony mondo olos gik moko duto masechiki kaka:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hemb Romo,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.7",
            "verseOrgIds": [
              "EXO.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EXO 31:7"
      },
      "items": [
        {
          "text": "Sandug Rapar mar pwodhruok gi raumne,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.7",
            "verseOrgIds": [
              "EXO.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EXO 31:7"
      },
      "items": [
        {
          "text": "kod gik moko duto mag hema kaka:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.7",
            "verseOrgIds": [
              "EXO.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "mesa gi gigene mag tich,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.8",
            "verseOrgIds": [
              "EXO.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EXO 31:8"
      },
      "items": [
        {
          "text": "gi rachungi taya gi gigene mag tich,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.8",
            "verseOrgIds": [
              "EXO.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EXO 31:8"
      },
      "items": [
        {
          "text": "gi kendo mar misango miwangʼoe ubani,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.8",
            "verseOrgIds": [
              "EXO.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kod kendo mar misango miwangʼo pep gi gik moko duto mitiyogo e kendono,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.9",
            "verseOrgIds": [
              "EXO.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EXO 31:9"
      },
      "items": [
        {
          "text": "gi karaya kod rachungi mare,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.9",
            "verseOrgIds": [
              "EXO.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kaachiel gi lewni motwangʼ,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.10",
            "verseOrgIds": [
              "EXO.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EXO 31:10"
      },
      "items": [
        {
          "text": "ka lewni mopwodhi mag Harun jadolo",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.10",
            "verseOrgIds": [
              "EXO.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EXO 31:10"
      },
      "items": [
        {
          "text": "kod lep yawuote kane gitiyo kaka jodolo;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.10",
            "verseOrgIds": [
              "EXO.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kod mor pwodhruok gi ubani madungʼ tik mangʼwe ngʼar mar Kama Ler.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.11",
            "verseOrgIds": [
              "EXO.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EXO 31:11"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "EXO 31:11"
      },
      "items": [
        {
          "text": "\"Nyaka gilose mana kaka nachiki.\"",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chik Sabato",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Jehova Nyasaye nowacho ne Musa niya,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.12",
            "verseOrgIds": [
              "EXO.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nyis jo-Israel kama: 'Nyaka urit sabatona duto. Ma nobed ranyisi e kinda kodu nyaka ni tienge duto mabiro, mondo omi ungʼe ni An e Jehova Nyasaye mamiyo ubedo maler.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.13",
            "verseOrgIds": [
              "EXO.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Rituru Sabato nikech enobednu odiechiengʼ maler. Ngʼato angʼata ma ok orito odiechiengno nyaka negi bende ngʼato angʼata motiyo chiengʼ Sabato nyaka ngʼad kare oko kuom ogandane.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.14",
            "verseOrgIds": [
              "EXO.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom ndalo auchiel nyaka uti, to odiechiengʼ mar abiriyo en Sabato mar yweyo ma en chiengʼ maler ni Jehova Nyasaye. Ngʼato angʼata ma otimo tich moro amora chiengʼ Sabato nyaka negi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.15",
            "verseOrgIds": [
              "EXO.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo-Israel nyaka rit Sabato ka gitimoe nyasi kuom tienge duto mabiro kaka singruok mosiko.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.16",
            "verseOrgIds": [
              "EXO.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enobed ranyisi e kinda kod jo-Israel nyaka chiengʼ nimar kuom ndalo auchiel Jehova Nyasaye nochweyo polo gi piny kendo e odiechiengʼ mar abiriyo noweyo tich moyweyo.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.17",
            "verseOrgIds": [
              "EXO.31.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane Jehova Nyasaye otieko wuoyo gi Musa ewi Got Sinai nomiye kite ariyo mopa mag rapar mane gin kite mopa ariyo ma Nyasaye nondikoe gi lwete owuon.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.18",
            "verseOrgIds": [
              "EXO.31.18"
            ]
          }
        }
      ]
    }
  ],
