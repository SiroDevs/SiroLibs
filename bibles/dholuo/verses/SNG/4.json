      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Wuowi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "SNG 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mano kaka ijaber, jaherana!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.1",
            "verseOrgIds": [
              "SNG.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:1"
      },
      "items": [
        {
          "text": "Yaye, mano kaka ijaber!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.1",
            "verseOrgIds": [
              "SNG.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:1"
      },
      "items": [
        {
          "text": "Wengeni neno mamuol ka akuru.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.1",
            "verseOrgIds": [
              "SNG.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:1"
      },
      "items": [
        {
          "text": "Yie wiyi chalo gi kweth mag diek,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.1",
            "verseOrgIds": [
              "SNG.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:1"
      },
      "items": [
        {
          "text": "malor koa e Got Gilead.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.1",
            "verseOrgIds": [
              "SNG.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lekeni tar mana ka kweth mag rombe makoro eka oliel yiegi",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.2",
            "verseOrgIds": [
              "SNG.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:2"
      },
      "items": [
        {
          "text": "kendo mowuok kar luok.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.2",
            "verseOrgIds": [
              "SNG.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:2"
      },
      "items": [
        {
          "text": "Moro ka moro wuotho gi nyithinde ma rude,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.2",
            "verseOrgIds": [
              "SNG.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:2"
      },
      "items": [
        {
          "text": "kendo onge moro man kende.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.2",
            "verseOrgIds": [
              "SNG.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien dhogi chalo gi law marakwaro;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.3",
            "verseOrgIds": [
              "SNG.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:3"
      },
      "items": [
        {
          "text": "kendo dhogi ber ahinya.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.3",
            "verseOrgIds": [
              "SNG.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:3"
      },
      "items": [
        {
          "text": "Lembi moum gi law",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.3",
            "verseOrgIds": [
              "SNG.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:3"
      },
      "items": [
        {
          "text": "yom machalo mana gi olemo mongʼinore.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.3",
            "verseOrgIds": [
              "SNG.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼuti chalo gi osuch Daudi,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.4",
            "verseOrgIds": [
              "SNG.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:4"
      },
      "items": [
        {
          "text": "mochungʼ tir gi chia;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.4",
            "verseOrgIds": [
              "SNG.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:4"
      },
      "items": [
        {
          "text": "kuode alufu achiel oliero kuome,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.4",
            "verseOrgIds": [
              "SNG.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:4"
      },
      "items": [
        {
          "text": "ma kargi duto gin kuodi mag jokedo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.4",
            "verseOrgIds": [
              "SNG.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thundeni chalo gi nyithi mwanda ariyo maromre",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.5",
            "verseOrgIds": [
              "SNG.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:5"
      },
      "items": [
        {
          "text": "adier gichalo gi nyithind mwanda ma rude,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.5",
            "verseOrgIds": [
              "SNG.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:5"
      },
      "items": [
        {
          "text": "makwayo e kind ondanyo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.5",
            "verseOrgIds": [
              "SNG.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka piny oseyawore",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.6",
            "verseOrgIds": [
              "SNG.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:6"
      },
      "items": [
        {
          "text": "kendo rumbi oserumo,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.6",
            "verseOrgIds": [
              "SNG.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:6"
      },
      "items": [
        {
          "text": "eka abiro dhi ewi got kuma gik madungʼ tik mangʼwe ngʼar yudoree",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.6",
            "verseOrgIds": [
              "SNG.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:6"
      },
      "items": [
        {
          "text": "kendo nyaka ewi gode matindo miwangʼoe ubani.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.6",
            "verseOrgIds": [
              "SNG.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijaber e yore duto, jaherana;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.7",
            "verseOrgIds": [
              "SNG.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:7"
      },
      "items": [
        {
          "text": "onge mbala moro amora e dendi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.7",
            "verseOrgIds": [
              "SNG.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye jaherana, bi wadhi kodi ka waa e got Lebanon,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.8",
            "verseOrgIds": [
              "SNG.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:8"
      },
      "items": [
        {
          "text": "adier bi koda walor ka waa Lebanon.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.8",
            "verseOrgIds": [
              "SNG.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:8"
      },
      "items": [
        {
          "text": "Lor piny ia e chuny got Amana,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.8",
            "verseOrgIds": [
              "SNG.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:8"
      },
      "items": [
        {
          "text": "lor ia ewi got mar Senir gi Hermon,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.8",
            "verseOrgIds": [
              "SNG.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:8"
      },
      "items": [
        {
          "text": "wuog e bur sibuoche",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.8",
            "verseOrgIds": [
              "SNG.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:8"
      },
      "items": [
        {
          "text": "kendo wuog ewi got kama kwach oloko miechgi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.8",
            "verseOrgIds": [
              "SNG.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye jaherana,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.9",
            "verseOrgIds": [
              "SNG.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:9"
      },
      "items": [
        {
          "text": "ka aneno kaka ingʼiya,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.9",
            "verseOrgIds": [
              "SNG.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:9"
      },
      "items": [
        {
          "text": "kod tigo malich miliero",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.9",
            "verseOrgIds": [
              "SNG.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:9"
      },
      "items": [
        {
          "text": "e ngʼuti, to chunya rumo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.9",
            "verseOrgIds": [
              "SNG.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "SNG 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mano kaka herani miya mor, yaye osiepna, ma ahero;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.10",
            "verseOrgIds": [
              "SNG.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:10"
      },
      "items": [
        {
          "text": "mano kaka herani kelo mor mangʼeny moloyo divai,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.10",
            "verseOrgIds": [
              "SNG.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:10"
      },
      "items": [
        {
          "text": "kendo ngʼwe ngʼar moloyo modhi mamoko duto!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.10",
            "verseOrgIds": [
              "SNG.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "SNG 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye jaherana, pien dhogi mit ka mor kich;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.11",
            "verseOrgIds": [
              "SNG.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:11"
      },
      "items": [
        {
          "text": "lewi chalona chak kata mor kich.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.11",
            "verseOrgIds": [
              "SNG.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:11"
      },
      "items": [
        {
          "text": "Lewni mirwako dungʼ tik mamit mana ka tik mamit mar got Lebanon.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.11",
            "verseOrgIds": [
              "SNG.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
