              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye jaherana, ichalo gi puodho mochiel;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.12",
            "verseOrgIds": [
              "SNG.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:12"
      },
      "items": [
        {
          "text": "kendo ka soko molor dhoge modin motegno.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.12",
            "verseOrgIds": [
              "SNG.4.12"
            ]
          }
        }
      ]
    },
    {
