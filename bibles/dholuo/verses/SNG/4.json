          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin olembe mopogore opogore kaka nad kod safron,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.14",
            "verseOrgIds": [
              "SNG.4.14"
            ]
          }
        }
