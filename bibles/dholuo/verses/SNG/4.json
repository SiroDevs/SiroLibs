      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:14"
      },
      "items": [
        {
          "text": "gi kalmas kod sinamon,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.14",
            "verseOrgIds": [
              "SNG.4.14"
            ]
          }
        }
      ]
    },
