      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:15"
      },
      "items": [
        {
          "text": "bende ichalo gi soko mar pi mamol,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.15",
            "verseOrgIds": [
              "SNG.4.15"
            ]
          }
        }
      ]
