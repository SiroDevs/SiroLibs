          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yiende madongo e puothi gin olembe mongʼinore,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.13",
            "verseOrgIds": [
              "SNG.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:13"
      },
      "items": [
        {
          "text": "molembegi beyo,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.13",
            "verseOrgIds": [
              "SNG.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:13"
      },
      "items": [
        {
          "text": "kendo mit kaka olemb hena kod nad.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.13",
            "verseOrgIds": [
              "SNG.4.13"
            ]
          }
        }
