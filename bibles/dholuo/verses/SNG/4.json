      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:15"
      },
      "items": [
        {
          "text": "kendo ichalo gi aore mamol kawuok ewi gode mag Lebanon.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.15",
            "verseOrgIds": [
              "SNG.4.15"
            ]
          }
        }
      ]
    },
