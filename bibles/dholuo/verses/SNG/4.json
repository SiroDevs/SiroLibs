      "attrs": {
        "style": "q2",
        "vid": "SNG 4:16"
      },
      "items": [
        {
          "text": "bende in yamb milambo kudhi!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.16",
            "verseOrgIds": [
              "SNG.4.16"
            ]
          }
        }
      ]
    },
