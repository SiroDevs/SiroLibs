  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "ECC 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gik moko duto konon to onge tiendgi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magi e weche mane jayalo ma wuod Daudi, mane ruodh Jerusalem owacho.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.1",
            "verseOrgIds": [
              "ECC.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jayalo wacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.2",
            "verseOrgIds": [
              "ECC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:2"
      },
      "items": [
        {
          "text": "\"Ngima en gima nono!",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.2",
            "verseOrgIds": [
              "ECC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 1:2"
      },
      "items": [
        {
          "text": "Chutho en gima nono!",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.2",
            "verseOrgIds": [
              "ECC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:2"
      },
      "items": [
        {
          "text": "Gik moko duto onge tiendgi!\"",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.2",
            "verseOrgIds": [
              "ECC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "En ohala mane ma dhano yudo kuom tije duto motiyo",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.3",
            "verseOrgIds": [
              "ECC.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:3"
      },
      "items": [
        {
          "text": "kendo mochandore godo e bwo wangʼ chiengʼ?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.3",
            "verseOrgIds": [
              "ECC.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiengʼ ka tiengʼ biro kendo kadho,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.4",
            "verseOrgIds": [
              "ECC.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:4"
      },
      "items": [
        {
          "text": "to piny to osiko mana kaka en.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.4",
            "verseOrgIds": [
              "ECC.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiengʼ wuok kendo chiengʼ podho,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.5",
            "verseOrgIds": [
              "ECC.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:5"
      },
      "items": [
        {
          "text": "kendo oridore piyo piyo kodok kuma owuokie.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.5",
            "verseOrgIds": [
              "ECC.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamo futo kochiko yo milambo",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.6",
            "verseOrgIds": [
              "ECC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:6"
      },
      "items": [
        {
          "text": "kendo okudho kochiko yo nyandwat;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.6",
            "verseOrgIds": [
              "ECC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 1:6"
      },
      "items": [
        {
          "text": "odhi kolworore,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.6",
            "verseOrgIds": [
              "ECC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:6"
      },
      "items": [
        {
          "text": "ndalo duto koduogo kare mapile.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.6",
            "verseOrgIds": [
              "ECC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aore duto mol kadhi ei nam,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.7",
            "verseOrgIds": [
              "ECC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:7"
      },
      "items": [
        {
          "text": "to kata kamano nam ok pongʼ.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.7",
            "verseOrgIds": [
              "ECC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 1:7"
      },
      "items": [
        {
          "text": "To kuma aorego oaye,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.7",
            "verseOrgIds": [
              "ECC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:7"
      },
      "items": [
        {
          "text": "kanyo ema gidwogoe.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.7",
            "verseOrgIds": [
              "ECC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gik moko duto gin tingʼ mapek,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.8",
            "verseOrgIds": [
              "ECC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:8"
      },
      "items": [
        {
          "text": "moingo ngʼato wacho.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.8",
            "verseOrgIds": [
              "ECC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 1:8"
      },
      "items": [
        {
          "text": "Kata obedo ni wangʼ neno,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.8",
            "verseOrgIds": [
              "ECC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:8"
      },
      "items": [
        {
          "text": "to gik moneno ok rome,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.8",
            "verseOrgIds": [
              "ECC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 1:8"
      },
      "items": [
        {
          "text": "to it bende kata obedo ni owinjo gik moko,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.8",
            "verseOrgIds": [
              "ECC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:8"
      },
      "items": [
        {
          "text": "to gik mowinjo ok rome.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.8",
            "verseOrgIds": [
              "ECC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gima osebedo biro bedo kendo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.9",
            "verseOrgIds": [
              "ECC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:9"
      },
      "items": [
        {
          "text": "gima osetim ibiro tim kendo;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.9",
            "verseOrgIds": [
              "ECC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:9"
      },
      "items": [
        {
          "text": "kendo onge gino manyien e bwo wangʼ chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.9",
            "verseOrgIds": [
              "ECC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende nitiere gima ngʼato nyalo wacho ni",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.10",
            "verseOrgIds": [
              "ECC.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:10"
      },
      "items": [
        {
          "text": "ma en gima nyien?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.10",
            "verseOrgIds": [
              "ECC.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 1:10"
      },
      "items": [
        {
          "text": "Ooyo ok gima nyien, nimar nyalo bedo ni gino nosetimore chon",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.10",
            "verseOrgIds": [
              "ECC.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:10"
      },
      "items": [
        {
          "text": "kane pok onywolwa.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.10",
            "verseOrgIds": [
              "ECC.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma chon ok par ngangʼ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.11",
            "verseOrgIds": [
              "ECC.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:11"
      },
      "items": [
        {
          "text": "mana kaka tiengʼni bende,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.11",
            "verseOrgIds": [
              "ECC.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 1:11"
      },
      "items": [
        {
          "text": "ok nopar",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.11",
            "verseOrgIds": [
              "ECC.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 1:11"
      },
      "items": [
        {
          "text": "gi joma biro luwo bangʼ-gi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.11",
            "verseOrgIds": [
              "ECC.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rieko onge tiende",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "An, jayalo, asebedo ruodh Israel kadak Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.12",
            "verseOrgIds": [
              "ECC.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne achiwora mondo atiegra kendo anon matut kod rieko gigo duto mitimo e bwo polo. Mano doko tingʼ mapek ma Nyasaye oyieyo kuom ji!",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.13",
            "verseOrgIds": [
              "ECC.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aseneno gik moko mitimo e bwo wangʼ chiengʼ, giduto gionge tiendgi, kendo gichalo mana yamo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.14",
            "verseOrgIds": [
              "ECC.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gima odol ok nyal rie;",
          "type": "text",
          "attrs": {
