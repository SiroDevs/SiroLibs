    "verseCount": 21,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "1",
          "style": "c",
          "sid": "OBA 1"
        },
        "items": [
          {
            "text": "1",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "OBA 1:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Fweny mag Obadia.",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.1",
              "verseOrgIds": [
                "OBA.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b",
          "vid": "OBA 1:1"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b",
          "vid": "OBA 1:1"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p",
          "vid": "OBA 1:1"
        },
        "items": [
          {
            "text": "Magi e weche ma Jehova Nyasaye Manyalo Gik Moko Duto wacho kuom Edom.",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.1",
              "verseOrgIds": [
                "OBA.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1",
          "vid": "OBA 1:1"
        },
        "items": [
          {
            "text": "Wasewinjo wach; koa kuom Jehova Nyasaye.",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.1",
              "verseOrgIds": [
                "OBA.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:1"
        },
        "items": [
          {
            "text": "Jaote oseor ir ogendini mondo owach niya,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.1",
              "verseOrgIds": [
                "OBA.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1",
          "vid": "OBA 1:1"
        },
        "items": [
          {
            "text": "\"Chunguru, wadhi waked kode.\"",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.1",
              "verseOrgIds": [
                "OBA.1.1"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "OBA 1:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "\"To neuru, abiro miyo udok matin e kind ogendini,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.2",
              "verseOrgIds": [
                "OBA.1.2"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:2"
        },
        "items": [
          {
            "text": "bende ibiro chau ahinya.",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.2",
              "verseOrgIds": [
                "OBA.1.2"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "OBA 1:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Sunga manie chunyu osewuondou,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.3",
              "verseOrgIds": [
                "OBA.1.3"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:3"
        },
        "items": [
          {
            "text": "un mudak e kind lwendni,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.3",
              "verseOrgIds": [
                "OBA.1.3"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:3"
        },
        "items": [
          {
            "text": "kendo ugero miechu kuonde motingʼore,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.3",
              "verseOrgIds": [
                "OBA.1.3"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1",
          "vid": "OBA 1:3"
        },
        "items": [
          {
            "text": "un ma uwacho kendu niya,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.3",
              "verseOrgIds": [
                "OBA.1.3"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:3"
        },
        "items": [
          {
            "text": "'En ngʼa manyalo dwokowa piny?'",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.3",
              "verseOrgIds": [
                "OBA.1.3"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "OBA 1:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "To kata obedo ni unyalo fuyo malo mabor ka ongo,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.4",
              "verseOrgIds": [
                "OBA.1.4"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:4"
        },
        "items": [
          {
            "text": "kendo ugero kar daku maber e kind sulwe malo,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.4",
              "verseOrgIds": [
                "OBA.1.4"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1",
          "vid": "OBA 1:4"
        },
        "items": [
          {
            "text": "to koa kuno abiro dwokou piny,\"",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.4",
              "verseOrgIds": [
                "OBA.1.4"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:4"
        },
        "items": [
          {
            "text": "Jehova Nyasaye owacho.",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.4",
              "verseOrgIds": [
                "OBA.1.4"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "OBA 1:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "\"Ka jokwoge obironu,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.5",
              "verseOrgIds": [
                "OBA.1.5"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:5"
        },
        "items": [
          {
            "text": "jomecho mag otieno,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.5",
              "verseOrgIds": [
                "OBA.1.5"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1",
          "vid": "OBA 1:5"
        },
        "items": [
          {
            "text": "to mano kaka masira malich ritou,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.5",
              "verseOrgIds": [
                "OBA.1.5"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:5"
        },
        "items": [
          {
            "text": "donge gibiro kwalo mwandu magu kaka ginyalo?",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.5",
              "verseOrgIds": [
                "OBA.1.5"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1",
          "vid": "OBA 1:5"
        },
        "items": [
          {
            "text": "Ka jopon mzabibu obiro iru",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.5",
              "verseOrgIds": [
                "OBA.1.5"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:5"
        },
        "items": [
          {
            "text": "donge digiwe olemb mzabibu matin?",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.5",
              "verseOrgIds": [
                "OBA.1.5"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "OBA 1:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "To mano kaka Esau ibiro choko gigene",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.6",
              "verseOrgIds": [
                "OBA.1.6"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:6"
        },
        "items": [
          {
            "text": "kendo mwandune mopandi noyaki!",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.6",
              "verseOrgIds": [
                "OBA.1.6"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "OBA 1:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ogendini ma uriworugo biro sembou nyaka giko mar tongʼ;",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.7",
              "verseOrgIds": [
                "OBA.1.7"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:7"
        },
        "items": [
          {
            "text": "osiepeu biro wuondou ma lowu;",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.7",
              "verseOrgIds": [
                "OBA.1.7"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1",
          "vid": "OBA 1:7"
        },
        "items": [
          {
            "text": "kendo joma chamo chiembu biro ketonu obadho,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.7",
              "verseOrgIds": [
                "OBA.1.7"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:7"
        },
        "items": [
          {
            "text": "to ok unufweny.\"",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.7",
              "verseOrgIds": [
                "OBA.1.7"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "OBA 1:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "Jehova Nyasaye wacho niya,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.8",
              "verseOrgIds": [
                "OBA.1.8"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:8"
        },
        "items": [
          {
            "text": "\"Odiechiengʼno donge abiro tieko jorieko mag Edom,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.8",
              "verseOrgIds": [
                "OBA.1.8"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:8"
        },
        "items": [
          {
            "text": "jogo man-gi winjo e gode mag Esau?",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.8",
              "verseOrgIds": [
                "OBA.1.8"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "OBA 1:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Jolweny magi, yaye Teman,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.9",
              "verseOrgIds": [
                "OBA.1.9"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:9"
        },
        "items": [
          {
            "text": "biro bedo kod bwok kendo ji duto modak,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.9",
              "verseOrgIds": [
                "OBA.1.9"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:9"
        },
        "items": [
          {
            "text": "e gode mag Esau ibiro negi.",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.9",
              "verseOrgIds": [
                "OBA.1.9"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "OBA 1:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nikech lweny mane utimone owadu Jakobo",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.10",
              "verseOrgIds": [
                "OBA.1.10"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:10"
        },
        "items": [
          {
            "text": "unubed gi wichkuot;",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.10",
              "verseOrgIds": [
                "OBA.1.10"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:10"
        },
        "items": [
          {
            "text": "mi nokethu nyaka chiengʼ.",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.10",
              "verseOrgIds": [
                "OBA.1.10"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "OBA 1:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Chiengʼ mane ichungʼ tenge",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.11",
              "verseOrgIds": [
                "OBA.1.11"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:11"
        },
        "items": [
          {
            "text": "ka joma moko donjo e dhorangeyene,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.11",
              "verseOrgIds": [
                "OBA.1.11"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q1",
          "vid": "OBA 1:11"
        },
        "items": [
          {
            "text": "kendo gigoyo ombulu",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.11",
              "verseOrgIds": [
                "OBA.1.11"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:11"
        },
        "items": [
          {
            "text": "ne Jerusalem,",
            "type": "text",
            "attrs": {
              "verseId": "OBA.1.11",
              "verseOrgIds": [
                "OBA.1.11"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q2",
          "vid": "OBA 1:11"
        },
        "items": [
          {
