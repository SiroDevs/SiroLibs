          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mano kaka yawuot Sayun mabeyo,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.2",
            "verseOrgIds": [
              "LAM.4.2"
            ]
          }
        }
