    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:1"
      },
      "items": [
        {
          "text": "dhahabu maberie moloyo obedo marach!",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.1",
            "verseOrgIds": [
              "LAM.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:1"
      },
      "items": [
        {
          "text": "Kite maler okere",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.1",
            "verseOrgIds": [
              "LAM.4.1"
            ]
          }
        }
      ]
    },
    {
