          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyikwa Makir wuod Manase nodhi Gilead, moloyo dalano mi giriembo jo-Amor mane oyudo odak kanyo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.39",
            "verseOrgIds": [
              "NUM.32.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 32:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Musa nochiwo Gilead e lwet jo-Makir, ma nyikwa Manase, kendo negidak kanyo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.40",
            "verseOrgIds": [
              "NUM.32.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 32:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jair ma nyakwar Manase nodhi mokawo mier madongo mane ni kanyo, kendo nochako kanyo ni Havoth Jair.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.41",
            "verseOrgIds": [
              "NUM.32.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 32:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noba nomonjo Kenath kod mier molwore kendo nochake nyinge owuon miluongo ni Noba.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.42",
            "verseOrgIds": [
              "NUM.32.42"
            ]
          }
        }
      ]
    }
