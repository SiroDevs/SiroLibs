{
  "id": "NUM.32",
  "number": "32",
  "bookId": "NUM",
  "reference": "Kwan 32",
  "copyright": "Biblica® Ochiw Thuolo Motingʼo Loko Manyien™ Weg Loko © 1980, 2002, 2003, 2020 otim gi Biblica, Inc. Biblica® Open New Luo Translation™ Copyright © 1980, 2002, 2003, 2020 by Biblica, Inc. \"Biblica\" en sai mondik mongorore e piny Amerika kendo en kido moyie malongʼo e ofis Biblica, Inc. Itiyo kode gi thuolo moa kuom Biblica, Inc. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 42,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "32",
        "style": "c",
        "sid": "NUM 32"
      },
      "items": [
        {
          "text": "32",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhout Israel mane odongʼ loka Jordan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo-Reuben gi jo-Gad, mane nigi kweth mag rombe kod dhok, noneno ni piny Jazer kod piny Gilead ne nigi lek maber mar pidho jamni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.1",
            "verseOrgIds": [
              "NUM.32.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo negibiro ir Musa gi Eliazar jadolo kod jotend oganda mar jo-Israel, mi giwachonegi niya,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.2",
            "verseOrgIds": [
              "NUM.32.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piny motingʼo Ataroth, Dibon, Jazer, Nimra, Heshbon, Eleale, Sebam, Nebo kod Beon",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.3",
            "verseOrgIds": [
              "NUM.32.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma Jehova Nyasaye osekawo ka oganda mar jo-Israel neno en piny man-gi lek maber mar pidho jamni kendo ungʼeyo ni wan jotichu wan jopidh jamni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.4",
            "verseOrgIds": [
              "NUM.32.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negiwachonegi niya, \"Ka uyie kodwa, to miwauru pinyni wasumbiniu obed marwa mondo kik wakadh wadhi loka Jordan.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.5",
            "verseOrgIds": [
              "NUM.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa nowacho ne jo-Gad kod jo-Reuben niya, \"Bende jou nyalo dhi e lweny ka un to udongʼ ka?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.6",
            "verseOrgIds": [
              "NUM.32.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angʼo momiyo unego chuny jo-Israel mondo kik dhi e piny ma Jehova Nyasaye osemiyogi?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.7",
            "verseOrgIds": [
              "NUM.32.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma e gima kwereu notimo kane aorogi kane wan Kadesh Barnea mondo gidhi ginon pinyno.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.8",
            "verseOrgIds": [
              "NUM.32.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane gisechopo e Holo mar Eshkol mi giringo pinyno, negimiyo chuny jo-Israel onyosore mar dhi e piny mane Jehova Nyasaye osemiyogi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.9",
            "verseOrgIds": [
              "NUM.32.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negitugo mirimb Jehova Nyasaye chiengʼno mi nokwongʼore kama:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.10",
            "verseOrgIds": [
              "NUM.32.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Nikech ok giseluwa gi chunygi duto, onge kata ngʼato achiel ma ja-higa piero ariyo kadhi nyime mane oa Misri mabiro neno piny mane asingora ka akwongʼora ne Ibrahim, Isaka kod Jakobo;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.11",
            "verseOrgIds": [
              "NUM.32.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "onge ngʼato angʼata kuomgi manone pinyno makmana Kaleb wuod Jefune ma ja-Kenizi kod Joshua wuod Nun, nimar negiluwo bangʼ Jehova Nyasaye gi chunygi duto.'",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.12",
            "verseOrgIds": [
              "NUM.32.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye nokecho gi jo-Israel kendo nomiyo giwuotho alanda e thim kuom higni piero angʼwen, nyaka ogandani duto mane otimo marach e nyim Jehova Nyasaye notho.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.13",
            "verseOrgIds": [
              "NUM.32.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Un koth jorichogi, koro ubiro ira, kuchungʼ kar kwereu kendo umiyo mirimb Jehova Nyasaye medore kuom Israel.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.14",
            "verseOrgIds": [
              "NUM.32.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka uweyo luwo Jehova Nyasaye, to obiro jwangʼo ogandani duto e thim kendo un ema ubiro miyo jogi rum.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.15",
            "verseOrgIds": [
              "NUM.32.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ kinde matin negidwogo ir Musa mi giwachone niya, \"Dwaher gero dipo ne jambwa kod mier madongo mondo mondwa kod nyithindwa odagie.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.16",
            "verseOrgIds": [
              "NUM.32.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 32:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "To kata kamano waikore mar manore gi gige lweny kendo dhi gi jo-Israel wetewa e piny mane osingnegi. To mokwongo nyaka wager ne mondwa gi nyithindwa mier madongo mochiel motegno mondo ogengʼ-gi kuom wasigu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.17",
            "verseOrgIds": [
              "NUM.32.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 32:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ok wanaduogi e miechwa nyaka wane ni jo-Israel duto oseyudo pinyno kaka pok margi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.18",
            "verseOrgIds": [
              "NUM.32.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 32:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wan ok wanadwar mondo opognwa piny kodgi loka machielo mar aora Jordan nimar osepognwa lopwa yo wuok chiengʼ mar Jordan lokani.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.19",
            "verseOrgIds": [
              "NUM.32.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 32:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Musa nowachonegi niya, \"Ka utimo kamano ma umanoru gi gige lweny e nyim Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.20",
            "verseOrgIds": [
              "NUM.32.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo ka un duto unudhi ka utingʼo gige lweny loka Jordan e nyim Jehova Nyasaye mi ubed kuno nyaka chop Jehova Nyasaye riemb wasike duto e nyime,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.21",
            "verseOrgIds": [
              "NUM.32.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 32:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka uloyo pinyno e nyim Jehova Nyasaye, eka unuduogi kendo unubedi maonge ketho e nyim Jehova Nyasaye gi Israel. Kendo pinyni biro bedo pok maru e nyim Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.22",
            "verseOrgIds": [
              "NUM.32.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 32:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"To ka ok utimo kamano, to ubiro timo richo e nyim Jehova Nyasaye; kendo bed ka ungʼeyo ni richou nofwenyre e lela.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.23",
            "verseOrgIds": [
              "NUM.32.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 32:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geruru mier madongo ne mondu gi nyithindu, kod dipo ne jambu, kendo nyaka utim kaka usesingoru.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.24",
            "verseOrgIds": [
              "NUM.32.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo-Gad kod jo-Reuben nowacho ne Musa niya, \"Wan jotichni, wabiro timo gima ruodhwa osechikowa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.25",
            "verseOrgIds": [
              "NUM.32.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 32:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyithindwa kod mondewa, rombwa kod dhowa biro dongʼ e miech Gilead ka.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.26",
            "verseOrgIds": [
              "NUM.32.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "To wan jotichni, ngʼato ka ngʼata ma jalweny biro ngʼado loka Jordan mondo oked e nyim Jehova Nyasaye mana kaka ruodhwa osechiko.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.27",
            "verseOrgIds": [
              "NUM.32.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Musa nomiyogi chik ka oorogi ir Eliazar jadolo, kod Joshua wuod Nun kaachiel gi jotend dhout Israel.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.28",
            "verseOrgIds": [
              "NUM.32.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nowachonegi niya, \"Ka jo-Gad kod jo-Reuben noidh kaachiel kodu Jordan e nyim Jehova Nyasaye, ka ngʼato ka ngʼato omanore mar kedo, to bangʼ ka useloyo piny, to unumigi piny Gilead kaka pok margi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.29",
            "verseOrgIds": [
              "NUM.32.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ka ok giidho kaachiel kodu ka gimanore gi gige lweny, to nyaka gikaw pok mag-gi kaachiel kodu Kanaan.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.30",
            "verseOrgIds": [
              "NUM.32.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo-Gad kod jo-Reuben nodwoko niya, \"Jotichni biro timo kaka Jehova Nyasaye osewacho.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.31",
            "verseOrgIds": [
              "NUM.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabiro ngʼado ka wadhi loka Kanaan e nyim Jehova Nyasaye ka wamanore gi gige lweny, to pok ma wabiro yudo biro bedo loka koni mar Jordan.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.32",
            "verseOrgIds": [
              "NUM.32.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 32:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Musa nomiyo jo-Gad, jo-Reuben kod nus mar dhood Manase wuod Josef pinyruodh Sihon ma ruodh jo-Amor kod pinyruodh Og ma ruodh Bashan; pinyno duto kaachiel gi miechgi kod gwenge molworogi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.33",
            "verseOrgIds": [
              "NUM.32.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 32:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo-Gad nogero mier madongo motegno kaka Dibon, Ataroth, Aroer,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.34",
            "verseOrgIds": [
              "NUM.32.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 32:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atroth Shofan, Jazer, Jogbeha,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.35",
            "verseOrgIds": [
              "NUM.32.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 32:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beth Nimra kod Beth Haran, kendo negigero dipo ne jambgi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.36",
            "verseOrgIds": [
              "NUM.32.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 32:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joka Reuben nogero Heshbon, Eleale kod Kiriathaim,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.37",
            "verseOrgIds": [
              "NUM.32.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 32:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "kaachiel gi Nebo kod Baal Meon (nyingegi noduog oloki achien) kod Sibma. Mier madongo mane gigero negimiyo nying mamoko.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.38",
            "verseOrgIds": [
              "NUM.32.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
