        },
        {
          "text": "Musa, Harun kod jotend oganda mar jo-Israel nokwano jo-Kohath kaluwore gi dhoutgi kod anywolagi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.34",
