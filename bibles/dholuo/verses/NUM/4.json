          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "kaachiel gi sirni molworo laru man-gi mise, sigingi mag hema, tonde, gi gik moko duto mitiyogo kanyo kendo ngʼato ka ngʼato nyaka mi gik monego otingʼ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.32",
            "verseOrgIds": [
              "NUM.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma e tich ma dhood Merari onego ti e Hemb Romo kotelnegi gi Ithamar wuod Harun jadolo.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.33",
            "verseOrgIds": [
              "NUM.4.33"
            ]
          }
        }
      ]
    },
    {
