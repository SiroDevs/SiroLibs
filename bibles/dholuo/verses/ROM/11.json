          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar gik moko duto oa kuome, kendo gintie nikech en,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.36",
            "verseOrgIds": [
              "ROM.11.36"
            ]
          }
        }
