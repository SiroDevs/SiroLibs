      "attrs": {
        "style": "q2",
        "vid": "ROM 11:36"
      },
      "items": [
        {
          "text": "kendo gin mage duto.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.36",
            "verseOrgIds": [
              "ROM.11.36"
            ]
          }
        }
      ]
