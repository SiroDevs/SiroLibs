    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 11:26"
      },
      "items": [
        {
          "text": "\"Jawar nobi koa Sayun;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.26",
            "verseOrgIds": [
              "ROM.11.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 11:26"
      },
      "items": [
        {
          "text": "enoriemb richo oa kuom Jakobo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.26",
            "verseOrgIds": [
              "ROM.11.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
