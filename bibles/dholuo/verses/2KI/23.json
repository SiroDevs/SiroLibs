  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "2KI 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Josia otimo winjruok",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka ruoth noluongo jodongo duto mag Juda kod Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.1",
            "verseOrgIds": [
              "2KI.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nodhi nyaka e hekalu mar Jehova Nyasaye ka en gi jo-Juda, jo-Jerusalem, jodolo, jonabi kaachiel gi ji duto momewo kod ma jochan. Nosomonegi weche duto mane ondiki e Kitabu mar Singruok, mane osenwangʼ e hekalu mar Jehova Nyasaye ka giwinjo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.2",
            "verseOrgIds": [
              "2KI.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruoth nochungʼ e bath siro kendo noketo winjruok mane oselal obedo kare e nyim Jehova Nyasaye kosingore ni enoluw Jehova Nyasaye kendo norit chikene gi wechene kod buchene gi chunye duto, mondo omi oritgo weche mag singruok mondiki e kitabuni. Omiyo ji duto noyie gi singruogno.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.3",
            "verseOrgIds": [
              "2KI.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruoth nogolo chik ne Hilkia jadolo maduongʼ, gi jodolo maluwe kod jorit dhoot mondo ogol oko gik moko duto mopa milamogo Baal gi siro mar Ashera kod kit gik moko manie kor polo e hekalu mar Jehova Nyasaye. Ne owangʼogi e bath Jerusalem e paw aora Kidron mi otero buchgi Bethel.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.4",
            "verseOrgIds": [
              "2KI.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne oriembo jodolo mag nyiseche manono mane ruodhi mag Juda oketo mondo owangʼ ubani kuonde motingʼore gi malo mag miech Juda kod mago molworo Jerusalem kendo noriemb joma ne wangʼo ubani ne Baal, gi chiengʼ, dwe kod sulwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.5",
            "verseOrgIds": [
              "2KI.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ogolo siro mar Ashera e hekalu mar Jehova Nyasaye mi otere e bath Jerusalem e holo mar aora Kidron kendo nowangʼe kanyo. Norege molokore buru mi okiro burugo ewi liete joma odhier.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.6",
            "verseOrgIds": [
              "2KI.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende nomuko ut jochode machwo mane ni e hekalu mar Jehova Nyasaye kendo ma en kama mon ne chweyoe pasia mag Ashera.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.7",
            "verseOrgIds": [
              "2KI.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josia nokelo jodolo duto moa e miech Juda kendo noketho kuonde motingʼore gi malo mane jodologo wangʼoe ubani chakre Geba nyaka Bersheba. Ne omuko gik mochwe mag lemo e dhorangeye kaachiel gi mago mane ni e dhoranga Joshua, jatend dala maduongʼ, mane nitie e bat koracham kidonjo e dala.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.8",
            "verseOrgIds": [
              "2KI.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata obedo ni jodolo mag kuonde lemo motingʼore gi malo ne ok ti e kendo mar misango mar Jehova Nyasaye man Jerusalem, to ne oyienegi mana chamo makati ma ok oketie thowi gi jodolo wetegi mamoko.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.9",
            "verseOrgIds": [
              "2KI.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne oketho Tofeth mane ni e holo man Ben Hinom, mondo omi kik ngʼato ne ti kode kuom timo misango mar wuode kata nyare e mach ne Molek.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.10",
            "verseOrgIds": [
              "2KI.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nogolo kido mar farese mane ruodhi mag Juda oseketone wangʼ chiengʼ e dhoranga hekalu mar Jehova Nyasaye. Ne gin e laru mantie machiegni gi od jatelo ma nyinge Nathan-Melek. Bangʼ mano Josia nowangʼo geche mane itiyogo kuom lamo wangʼ chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.11",
            "verseOrgIds": [
              "2KI.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomuko kende mag misango mane ruodhi mag Juda ogero ewi tat od Ahaz, bende nomuko kende mag misango mane Manase ogero e laru ariyo mar hekalu mar Jehova Nyasaye. Nogologi kanyo, motoyogi matindo tindo kendo opuko ngʼinjogo e holo mar Kidron.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.12",
            "verseOrgIds": [
              "2KI.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruoth nomuko kuonde motingʼore gi malo mane ni yo wuok chiengʼ mar Jerusalem koma ochomo yo milambo mar Got Kethruok, mane Solomon ruodh Israel ogero ne Ashtoreth, nyasach makwero mar jo-Sidon, gi Kemosh nyasach jo-Moab kod Molek nyasaye manono mar jo-Amon.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.13",
            "verseOrgIds": [
              "2KI.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josia notoyo kite milamo kendo ongʼado siro mar Ashera mi oumo kuondego gi choke ji.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.14",
            "verseOrgIds": [
              "2KI.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata mana kendo mar misango man Bethel, ma en kar lemo motingʼore gi malo mane olosgi Jeroboam wuod Nebat, mane omiyo Israel otimo richo bende nomuko. Ne owangʼo kama otingʼore gi malono mi olokore buru bende nowangʼo siro mar Ashera.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.15",
            "verseOrgIds": [
              "2KI.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ mano Josia nongʼiyo koni gi koni kendo kane oneno liete mane ni e kor godno, nogolo chik mondo ogol choke e lietego kendo owangʼ-gi e kendo mar misango kikethego kaluwore gi wach Jehova Nyasaye mane ngʼat Nyasaye okoro chon.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.16",
            "verseOrgIds": [
              "2KI.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruoth nopenjo niya, \"En kidi mane manie dho liel maneno cha?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.17",
            "verseOrgIds": [
              "2KI.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 23:17"
      },
      "items": [
        {
          "text": "Jo-dala maduongʼno nodwoke niya, \"Onyiso kar liend ngʼat Nyasaye mane oa Juda mane okoro gik mane itimo e kendo mar misango man Bethel.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.17",
            "verseOrgIds": [
              "2KI.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne owacho niya, \"Weyeuru, kendo kik ngʼato mul chokene.\" Eka ne giweyo chokene to gi mag janabi mane oa Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.18",
            "verseOrgIds": [
              "2KI.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josia nomuko kendo oketho kuonde duto motingʼore gi malo mitimoe misengini mane ruodhi mag Israel ogero e miech Samaria mane omiyo Jehova Nyasaye mirima mana kaka notimo Bethel.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.19",
            "verseOrgIds": [
              "2KI.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josia nonego jodolo duto mag nyiseche milamo kuonde motingʼore gi malo mowangʼogi e kende mag misengini. Bangʼ mano nodok Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.20",
            "verseOrgIds": [
              "2KI.23.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruoth nogolo chik ni ji duto kama: \"Losuru chokruok mar Pasaka ne Jehova Nyasaye ma Nyasachu, mana kaka ondiki e Kitap Singruokni.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.21",
            "verseOrgIds": [
              "2KI.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koa e ndalo mag jongʼad bura mane otelo ne Israel, kata e ndalo duto mag ruodhi mag Israel gi Juda, pok ne otim chokruok mar Pasaka ma kama.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.22",
            "verseOrgIds": [
              "2KI.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "To e higa mar apar gaboro mar ruoth Josia, Pasaka machalo kama notimne Jehova Nyasaye e Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.23",
            "verseOrgIds": [
              "2KI.23.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende Josia notieko jomeny, jo-nyakalondo, nyiseche manono mag udi gi kido milamo kaachiel gi gik moko duto mamono mane oyud Juda kod Jerusalem. Ma ne otimo mondo ochop chik mondiki e kitabu mane Hilkia jadolo ofwenyo e hekalu mar Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.24",
            "verseOrgIds": [
              "2KI.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onge ruoth moro kata achiel mane odwogo ir Jehova Nyasaye kaluwore gi chike duto mag Musa gi chunye duto gi ngimane duto kod tekone duto machalo gi Josia.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.25",
            "verseOrgIds": [
              "2KI.23.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata Kamano, Jehova Nyasaye ne ok oweyo mirimbe mager, mane liel kochomo Juda nikech mago duto mane Manase otimo komiyo mirimbe jimbore.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.26",
            "verseOrgIds": [
              "2KI.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Jehova Nyasaye nowacho niya, \"Abiro riembo jo-Juda e nyima mana kaka ne ariembo jo-Israel kendo abiro kwedo Jerusalem dala maduongʼ mane ayiero kaachiel gi hekaluni, mane awuoyoe ni, 'Kanyo ema Nyinga nobedie.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.27",
            "verseOrgIds": [
              "2KI.23.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "To kuom gik mamoko duto mag loch Josia kod mago duto mane otimo, donge ondikgi e kitabu mag weche mag ruodhi Juda?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.28",
            "verseOrgIds": [
              "2KI.23.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "E ndalo loch Josia, Farao Neko ruodh Misri nodhi nyaka Aora Yufrate mondo okony ruodh Asuria kedo. Ruoth Josia nowuok mondo oked kode e paw lweny, to ruoth Neko norado kode monege e paw Megido.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.29",
            "verseOrgIds": [
              "2KI.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jotije Josia nokelo ringre gi geche lweny koa Megido nyaka Jerusalem mine giike e liende owuon kendo jopinyno nokawo Jehoahaz wuod Josia mi giwire kendo mokete obedo ruoth kar wuon mare.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.30",
            "verseOrgIds": [
              "2KI.23.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jehoahaz ruodh Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoahaz ne ja-higni piero ariyo gadek kane odoko ruoth kendo nobedo e loch kuom dweche adek kodak Jerusalem. Min mare nyinge ne Hamutal nyar Jeremia; mane aa Libna.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.31",
            "verseOrgIds": [
              "2KI.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne otimo richo e wangʼ Jehova Nyasaye mana kaka kwerene notimo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.32",
            "verseOrgIds": [
              "2KI.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao Neko noterogi e twech Ribla e piny Hamath mondo kik obed ruoth kodak Jerusalem kendo nochuno jo-Juda mondo ochiw osuru mar fedha ma pekne romo kilo alufu adek gi mia angʼwen kod dhahabu ma pekne romo kilo piero adek gangʼwen.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.33",
            "verseOrgIds": [
              "2KI.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao Neko noketo Eliakim wuod Josia ruoth kar wuon mare Josia kendo noloko nying Eliakim ni Jehoyakim. To nokawo Jehoahaz mi otero e twech Misri kuma nothoe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.34",
            "verseOrgIds": [
              "2KI.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoyakim nochulo Farao Neko fedha kod dhahabu mane odwaro. Notimo kamano kogolo osuru kuom jopinyno kuom fedha gi dhahabu kaluwore gi yuto mar ngʼato ka ngʼato.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.35",
            "verseOrgIds": [
              "2KI.23.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jehoyakim ruodh Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoyakim ne ja-higni piero ariyo gabich kane odoko ruoth kendo nobedo e loch kodak Jerusalem kuom higni apar gachiel. Min mare ne nyinge Zebida nyar Pedaya; mane aa Ruma.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.36",
            "verseOrgIds": [
              "2KI.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo notimo gik maricho e nyim wangʼ Jehova Nyasaye, mana kaka kwerene notimo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.37",
            "verseOrgIds": [
              "2KI.23.37"
            ]
          }
        }
      ]
    }
  ],
