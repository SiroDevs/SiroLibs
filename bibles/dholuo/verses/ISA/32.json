  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "32",
        "style": "c",
        "sid": "ISA 32"
      },
      "items": [
        {
          "text": "32",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pinyruoth makare",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Winjuru, Ruoth nobed gi loch makare",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.1",
            "verseOrgIds": [
              "ISA.32.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:1"
      },
      "items": [
        {
          "text": "kendo jotelo nobed gi telo mar adier.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.1",
            "verseOrgIds": [
              "ISA.32.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼato ka ngʼato nobed kar gengʼruok",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.2",
            "verseOrgIds": [
              "ISA.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:2"
      },
      "items": [
        {
          "text": "ne kalausi mana ka aore mamol e piny ongoro,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.2",
            "verseOrgIds": [
              "ISA.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 32:2"
      },
      "items": [
        {
          "text": "kendo mana ka tipo mar Lwanda maduongʼ e piny motwo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.2",
            "verseOrgIds": [
              "ISA.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka wenge joma neno ok nochak ogengʼ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.3",
            "verseOrgIds": [
              "ISA.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:3"
      },
      "items": [
        {
          "text": "kendo joma ochiko itgi nowinj wach.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.3",
            "verseOrgIds": [
              "ISA.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chuny ngʼat mamuomore nowinj wach gi tiende",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.4",
            "verseOrgIds": [
              "ISA.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:4"
      },
      "items": [
        {
          "text": "kendo ngʼat ma radwal nowuo maber kendo maliw.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.4",
            "verseOrgIds": [
              "ISA.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ok nochak oluong ngʼat mofuwo ni ngʼat malongʼo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.5",
            "verseOrgIds": [
              "ISA.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:5"
      },
      "items": [
        {
          "text": "kata ngʼat ma ja-miganga ni ngʼat ma ogen.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.5",
            "verseOrgIds": [
              "ISA.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar ngʼat mofuwo wacho weche mofuwo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.6",
            "verseOrgIds": [
              "ISA.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:6"
      },
      "items": [
        {
          "text": "kendo opongʼ gi richo:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.6",
            "verseOrgIds": [
              "ISA.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 32:6"
      },
      "items": [
        {
          "text": "Otimo timbe mag richo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.6",
            "verseOrgIds": [
              "ISA.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:6"
      },
      "items": [
        {
          "text": "kendo olando miriambo kuom Jehova Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.6",
            "verseOrgIds": [
              "ISA.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 32:6"
      },
      "items": [
        {
          "text": "mi omon joma odenyo chamo gik monego gicham",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.6",
            "verseOrgIds": [
              "ISA.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:6"
      },
      "items": [
        {
          "text": "kendo joma riyo oloyo otamoe pi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.6",
            "verseOrgIds": [
              "ISA.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼat ma achach yorene richo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.7",
            "verseOrgIds": [
              "ISA.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:7"
      },
      "items": [
        {
          "text": "osiko ka chunye chano mana timo richo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.7",
            "verseOrgIds": [
              "ISA.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 32:7"
      },
      "items": [
        {
          "text": "kotieko jodhier gi miriambo kata obedo ni",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.7",
            "verseOrgIds": [
              "ISA.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:7"
      },
      "items": [
        {
          "text": "ywak mar joma ni e chandruok nikare.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.7",
            "verseOrgIds": [
              "ISA.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ngʼat mogen loso weche mabeyo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.8",
            "verseOrgIds": [
              "ISA.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:8"
      },
      "items": [
        {
          "text": "kendo kuom timbe makare miyo ochungʼ motegno.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.8",
            "verseOrgIds": [
              "ISA.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mond Jerusalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Un mon maparo ni odak e ngima maber,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.9",
            "verseOrgIds": [
              "ISA.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:9"
      },
      "items": [
        {
          "text": "auru malo kendo uwinj wachna,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.9",
            "verseOrgIds": [
              "ISA.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 32:9"
      },
      "items": [
        {
          "text": "un nyiri modak gi kwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.9",
            "verseOrgIds": [
              "ISA.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:9"
      },
      "items": [
        {
          "text": "winjuru gima awacho!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.9",
            "verseOrgIds": [
              "ISA.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ higa achiel,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.10",
            "verseOrgIds": [
              "ISA.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:10"
      },
      "items": [
        {
          "text": "un ma uparo nudak mokwe, kibaji nogou;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.10",
            "verseOrgIds": [
              "ISA.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 32:10"
      },
      "items": [
        {
          "text": "cham ok nochiegi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.10",
            "verseOrgIds": [
              "ISA.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:10"
      },
      "items": [
        {
          "text": "kendo keyo mar mzabibu ok nobedie.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.10",
            "verseOrgIds": [
              "ISA.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beduru moluor un mon maparo nodak e ngima maber;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.11",
            "verseOrgIds": [
              "ISA.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:11"
      },
      "items": [
        {
          "text": "beduru mokuyo, un nyiri maparo nodak gi kwe!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.11",
            "verseOrgIds": [
              "ISA.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:11"
      },
      "items": [
        {
          "text": "Lonyreuru duge kendo utwe piende gugru enungou.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.11",
            "verseOrgIds": [
              "ISA.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ywaguru ka ugoyo agogu nikech puothe momewo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.12",
            "verseOrgIds": [
              "ISA.32.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:12"
      },
      "items": [
        {
          "text": "nikech olembe mag mzabibu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.12",
            "verseOrgIds": [
              "ISA.32.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo kuom piny joga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.13",
            "verseOrgIds": [
              "ISA.32.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:13"
      },
      "items": [
        {
          "text": "piny mopongʼ gi kuthe kod pedo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.13",
            "verseOrgIds": [
              "ISA.32.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 32:13"
      },
      "items": [
        {
          "text": "ee, ywaguru udi ma yande mor opongʼo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.13",
            "verseOrgIds": [
              "ISA.32.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:13"
      },
      "items": [
        {
          "text": "kendo kuom dala maduongʼ mar mor gi ilo masani odongʼ nono.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.13",
            "verseOrgIds": [
              "ISA.32.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 32:14"
          },
