  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "42",
        "style": "c",
        "sid": "ISA 42"
      },
      "items": [
        {
          "text": "42",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jatich Jehova Nyasaye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 42:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma e jatichna masemiyo teko,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.1",
            "verseOrgIds": [
              "ISA.42.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:1"
      },
      "items": [
        {
          "text": "en e ngʼat ma aseyiero, kendo ma chunya morgo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.1",
            "verseOrgIds": [
              "ISA.42.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:1"
      },
      "items": [
        {
          "text": "abiro keto Roho mara Maler",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.1",
            "verseOrgIds": [
              "ISA.42.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:1"
      },
      "items": [
        {
          "text": "kendo obiro kelo adiera ne ogendini.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.1",
            "verseOrgIds": [
              "ISA.42.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ok obi goyo koko kata nduru,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.2",
            "verseOrgIds": [
              "ISA.42.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:2"
      },
      "items": [
        {
          "text": "dwonde bende ok nowinji e wangʼ yore.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.2",
            "verseOrgIds": [
              "ISA.42.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata obedo ni onenore kaka odundu mayom yom ok notur",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.3",
            "verseOrgIds": [
              "ISA.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:3"
      },
      "items": [
        {
          "text": "kendo kata obedo ni oliel ka taya ma mirimiri to ok notho.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.3",
            "verseOrgIds": [
              "ISA.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:3"
      },
      "items": [
        {
          "text": "Enongʼad bura gadiera;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.3",
            "verseOrgIds": [
              "ISA.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ok nochwanyre kata chunye bende ok nonyosre,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.4",
            "verseOrgIds": [
              "ISA.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:4"
      },
      "items": [
        {
          "text": "nyaka okel adiera e piny duto.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.4",
            "verseOrgIds": [
              "ISA.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:4"
      },
      "items": [
        {
          "text": "Pinje duto manie chula mag dier nam biro keto genogi kuom chikene.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.4",
            "verseOrgIds": [
              "ISA.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye ma en Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.5",
            "verseOrgIds": [
              "ISA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:5"
      },
      "items": [
        {
          "text": "kendo ma Jachwech polo malach,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.5",
            "verseOrgIds": [
              "ISA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:5"
      },
      "items": [
        {
          "text": "gi piny kod gik moko duto manie iye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.5",
            "verseOrgIds": [
              "ISA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:5"
      },
      "items": [
        {
          "text": "En ema ochiwo muya ne dhano",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.5",
            "verseOrgIds": [
              "ISA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:5"
      },
      "items": [
        {
          "text": "kod ngima ne joma wuotho e piny.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.5",
            "verseOrgIds": [
              "ISA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:5"
      },
      "items": [
        {
          "text": "Owacho kama:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.5",
            "verseOrgIds": [
              "ISA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"An Jehova Nyasaye, aseluongi mondo anyisi adierana;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.6",
            "verseOrgIds": [
              "ISA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:6"
      },
      "items": [
        {
          "text": "abiro mako lweti.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.6",
            "verseOrgIds": [
              "ISA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:6"
      },
      "items": [
        {
          "text": "Abiro riti kendo ibiro keti gir singruok e kinda gi ji",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.6",
            "verseOrgIds": [
              "ISA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:6"
      },
      "items": [
        {
          "text": "kendo abiro keti ler mar ogendini duto,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.6",
            "verseOrgIds": [
              "ISA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "mondo iyaw wenge muofni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.7",
            "verseOrgIds": [
              "ISA.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:7"
      },
      "items": [
        {
          "text": "kendo igol joma oketi e od twech,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.7",
            "verseOrgIds": [
              "ISA.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:7"
      },
      "items": [
        {
          "text": "kendo igony joma otwe mobetie mudho.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.7",
            "verseOrgIds": [
              "ISA.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nyinga ma ongʼeyago en; Jehova Nyasaye!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.8",
            "verseOrgIds": [
              "ISA.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:8"
      },
      "items": [
        {
          "text": "Ok anawe duongʼ mara ne nyasaye moro,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.8",
            "verseOrgIds": [
              "ISA.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:8"
      },
      "items": [
        {
          "text": "bende pak ma ipakago ok nopakgo nyiseche mopa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.8",
            "verseOrgIds": [
              "ISA.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koro ne, gik machon osetimore",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.9",
            "verseOrgIds": [
              "ISA.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:9"
      },
      "items": [
        {
          "text": "bende anyisou gik manyien mabiro timore,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.9",
            "verseOrgIds": [
              "ISA.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:9"
      },
      "items": [
        {
          "text": "to kapok gitimore",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.9",
            "verseOrgIds": [
              "ISA.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:9"
      },
      "items": [
        {
          "text": "to ahulonugi.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.9",
            "verseOrgIds": [
              "ISA.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wend pak ne Jehova Nyasaye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Werneuru Jehova Nyasaye wer manyien,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.10",
            "verseOrgIds": [
              "ISA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:10"
      },
      "items": [
        {
          "text": "kupako nyinge e piny duto,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.10",
            "verseOrgIds": [
              "ISA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:10"
      },
      "items": [
        {
          "text": "un joma kwangʼ e nam kaachiel gi gik manie yie",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.10",
            "verseOrgIds": [
              "ISA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:10"
      },
      "items": [
        {
          "text": "gi pinje mag chula mar nam kod ji duto modak.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.10",
            "verseOrgIds": [
              "ISA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weuru kuonde motimo ongoro gi miechgi mondo ogo koko;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.11",
            "verseOrgIds": [
              "ISA.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:11"
      },
      "items": [
        {
          "text": "kendo weuru joma odak e gwenge mag Kedar obed mamor.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.11",
            "verseOrgIds": [
              "ISA.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:11"
      },
      "items": [
        {
          "text": "Weuru joma odak Sela ower gi mor,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.11",
            "verseOrgIds": [
              "ISA.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:11"
      },
      "items": [
        {
          "text": "ka gikok ewi got malo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.11",
            "verseOrgIds": [
              "ISA.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weuru gimi nying Jehova Nyasaye duongʼ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.12",
            "verseOrgIds": [
              "ISA.42.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
