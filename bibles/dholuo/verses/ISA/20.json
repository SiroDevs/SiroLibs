  "verseCount": 6,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "ISA 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wach mokor nibiro timore ne Misri kod Kush",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "E higano mane Sargon ruodh Asuria nooro jatend lweny maduongʼ, nodhi Ashdod mi omonje kendo okawe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.1",
            "verseOrgIds": [
              "ISA.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo e ndalono ema ne Jehova Nyasaye owuoyo kokalo kuom Isaya wuod Amoz. Nowachone niya, \"Gony pien gugru manie dendi kendo ilony wuocheni oko e tiendi.\" Kendo notimo kamano kowuotho duk gi tiende nono.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.2",
            "verseOrgIds": [
              "ISA.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Jehova Nyasaye nowacho niya, \"Mana kaka jatichna Isaya oselonyore duk mowuotho gi tiende nono kuom higni adek, kobedo ranyisi kuom gima timore ne Misri kod Kush,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.3",
            "verseOrgIds": [
              "ISA.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "omiyo ruodh Asuria biro sembo jo-Misri kod jo-Kush ma osemako duto, jomatindo kod jomadongo. Giniwuoth duge gi tiendegi nono, ka siandagi neno, mi mano nobed wichkuot ni jo-Misri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.4",
            "verseOrgIds": [
              "ISA.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji mane oketo genoni kuom jo-Kush, kendo tingʼore malo nikech jo-Misri nobed gi luoro kod wichkuot.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.5",
            "verseOrgIds": [
              "ISA.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "E kindeno jogo modak e dho namni nowach ni, 'Neuru gima osetimore ne joma waketo genowa kuomgi, joma ne waringo kuomgi mondo okonywa kendo oreswa e lwet ruodh Asuria! To koro, ere kaka wanatony?' \"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.6",
            "verseOrgIds": [
              "ISA.20.6"
            ]
          }
        }
      ]
    }
  ],
