          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "keluru pi ne joma riyo oloyo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.14",
            "verseOrgIds": [
              "ISA.21.14"
            ]
          }
        }
      ]
