      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:15"
      },
      "items": [
        {
          "text": "ne ligangla mowuodhi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.15",
            "verseOrgIds": [
              "ISA.21.15"
            ]
          }
        }
