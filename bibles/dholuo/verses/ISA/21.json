              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruoth Nyasaye wachona niya, \"Mana kaka ja-otongʼo kwano hike achiel ma tije rumogo e kaka duongʼ mar Kedar norum.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.16",
            "verseOrgIds": [
              "ISA.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma nok ma gin jolweny mag asere ma gin thuondi man Kedar ema notony. Jehova Nyasaye ma en Nyasach Israel osewacho.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.17",
            "verseOrgIds": [
              "ISA.21.17"
            ]
          }
