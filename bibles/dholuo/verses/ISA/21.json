      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:14"
      },
      "items": [
        {
          "text": "keluru chiemo ne joma oseringo ka pondone lweny.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.14",
            "verseOrgIds": [
              "ISA.21.14"
            ]
          }
