  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "ISA 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wend pak",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "E ndalono wendni nower e piny Juda ni:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.1",
            "verseOrgIds": [
              "ISA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:1"
      },
      "items": [
        {
          "text": "Wan gi dala maduongʼ man-gi teko;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.1",
            "verseOrgIds": [
              "ISA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:1"
      },
      "items": [
        {
          "text": "Nyasaye kelo resruok e ohingane gi kuonde molwore.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.1",
            "verseOrgIds": [
              "ISA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaw dhorangeye",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.2",
            "verseOrgIds": [
              "ISA.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:2"
      },
      "items": [
        {
          "text": "mondo oganda makare odonji,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.2",
            "verseOrgIds": [
              "ISA.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:2"
      },
      "items": [
        {
          "text": "oganda morito yie.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.2",
            "verseOrgIds": [
              "ISA.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inirit gi kwe ngʼatno ma parone oriere tir,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.3",
            "verseOrgIds": [
              "ISA.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:3"
      },
      "items": [
        {
          "text": "nikech ogeno kuomi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.3",
            "verseOrgIds": [
              "ISA.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gen kuom Jehova Nyasaye nyaka chiengʼ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.4",
            "verseOrgIds": [
              "ISA.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:4"
      },
      "items": [
        {
          "text": "nimar Jehova Nyasaye en Jehova Nyasaye ma Lwanda nyaka chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.4",
            "verseOrgIds": [
              "ISA.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odwoko piny joma otingʼore malo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.5",
            "verseOrgIds": [
              "ISA.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:5"
      },
      "items": [
        {
          "text": "odwoko dala maduongʼ mar ngʼayi piny,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.5",
            "verseOrgIds": [
              "ISA.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:5"
      },
      "items": [
        {
          "text": "mi otoye matindo tindo ma olokre buru.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.5",
            "verseOrgIds": [
              "ISA.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiende joma ithiro",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.6",
            "verseOrgIds": [
              "ISA.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:6"
      },
      "items": [
        {
          "text": "kod mag joma odhier nyone piny.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.6",
            "verseOrgIds": [
              "ISA.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yor joma kare opie,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.7",
            "verseOrgIds": [
              "ISA.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:7"
      },
      "items": [
        {
          "text": "yaye in Jal makare, iloso yor joma kare bedo maber.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.7",
            "verseOrgIds": [
              "ISA.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye Jehova Nyasaye, wuotho e yore mag chikeni ema warito,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.8",
            "verseOrgIds": [
              "ISA.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:8"
      },
      "items": [
        {
          "text": "nyingi kod duongʼ mari ema chunywa dwaro.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.8",
            "verseOrgIds": [
              "ISA.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chunya gombi gotieno",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.9",
            "verseOrgIds": [
              "ISA.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:9"
      },
      "items": [
        {
          "text": "kendo chunya dwari gokinyi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.9",
            "verseOrgIds": [
              "ISA.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 26:9"
      },
      "items": [
        {
          "text": "Ka buchi makare biro e piny,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.9",
            "verseOrgIds": [
              "ISA.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:9"
      },
      "items": [
        {
          "text": "ogendini mag piny puonjore yo makare.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.9",
            "verseOrgIds": [
              "ISA.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata obedo ni ngʼwono itimone joricho,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.10",
            "verseOrgIds": [
              "ISA.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:10"
      },
      "items": [
        {
          "text": "to ok gipuonjore tim makare;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.10",
            "verseOrgIds": [
              "ISA.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 26:10"
      },
      "items": [
        {
          "text": "kata mana e piny joma kare gidhi nyime mana ka gitimo richo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.10",
            "verseOrgIds": [
              "ISA.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:10"
      },
      "items": [
        {
          "text": "ka ok gichiwo luor ne duongʼ mar Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.10",
            "verseOrgIds": [
              "ISA.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye Jehova Nyasaye, isetingʼo badi malo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.11",
            "verseOrgIds": [
              "ISA.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:11"
      },
      "items": [
        {
          "text": "to ok gine.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.11",
            "verseOrgIds": [
              "ISA.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 26:11"
      },
      "items": [
        {
          "text": "We mondo gine geno ma in-go,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.11",
            "verseOrgIds": [
              "ISA.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:11"
      },
      "items": [
        {
          "text": "kuom jogi mi giyud wichkuot,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.11",
            "verseOrgIds": [
              "ISA.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 26:11"
      },
      "items": [
        {
          "text": "kendo mad mach mokan ne wasiki wangʼ-gi duto.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.11",
            "verseOrgIds": [
              "ISA.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye, isemiyowa kwe;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.12",
            "verseOrgIds": [
              "ISA.26.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:12"
      },
      "items": [
        {
          "text": "kendo gik moko duto ma wasetimo in ema isetimonwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.12",
            "verseOrgIds": [
              "ISA.26.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye Jehova Nyasaye ma Nyasachwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.13",
            "verseOrgIds": [
              "ISA.26.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:13"
      },
      "items": [
        {
          "text": "ruodhi mamoko ma ok in osetiyowa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.13",
            "verseOrgIds": [
              "ISA.26.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:13"
      },
      "items": [
        {
          "text": "makmana nyingi kende ema wamiyo luor.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.13",
            "verseOrgIds": [
              "ISA.26.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "To koro jogo osetho kendo koro gionge;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.14",
            "verseOrgIds": [
              "ISA.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:14"
      },
      "items": [
        {
          "text": "chunje moseago ok nochier.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.14",
            "verseOrgIds": [
              "ISA.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:14"
      },
      "items": [
        {
          "text": "Ne ikumogi mi itiekogi maonge ngʼama parogi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.14",
            "verseOrgIds": [
              "ISA.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
