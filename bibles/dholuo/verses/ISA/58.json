{
  "id": "ISA.58",
  "number": "58",
  "bookId": "ISA",
  "reference": "Isaya 58",
  "copyright": "Biblica® Ochiw Thuolo Motingʼo Loko Manyien™ Weg Loko © 1980, 2002, 2003, 2020 otim gi Biblica, Inc. Biblica® Open New Luo Translation™ Copyright © 1980, 2002, 2003, 2020 by Biblica, Inc. \"Biblica\" en sai mondik mongorore e piny Amerika kendo en kido moyie malongʼo e ofis Biblica, Inc. Itiyo kode gi thuolo moa kuom Biblica, Inc. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "58",
        "style": "c",
        "sid": "ISA 58"
      },
      "items": [
        {
          "text": "58",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kit tweyo chiemo mowinjore",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 58:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gouru koko matek, kendo kik udog chien.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.1",
            "verseOrgIds": [
              "ISA.58.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:1"
      },
      "items": [
        {
          "text": "Tingʼuru dwondi malo mana ka turumbete.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.1",
            "verseOrgIds": [
              "ISA.58.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:1"
      },
      "items": [
        {
          "text": "Nyisuru joga malongʼo ngʼanyo margi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.1",
            "verseOrgIds": [
              "ISA.58.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:1"
      },
      "items": [
        {
          "text": "kendo richo mar od joka Jakobo nyisgiuru.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.1",
            "verseOrgIds": [
              "ISA.58.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 58:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar pile ka pile gidwara,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.2",
            "verseOrgIds": [
              "ISA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:2"
      },
      "items": [
        {
          "text": "ginenore joma nigi chuny mar ngʼeyo yorena,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.2",
            "verseOrgIds": [
              "ISA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:2"
      },
      "items": [
        {
          "text": "mana ka gima gin oganda matimo gima kare,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.2",
            "verseOrgIds": [
              "ISA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:2"
      },
      "items": [
        {
          "text": "kendo mapok oweyo chike Nyasachgi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.2",
            "verseOrgIds": [
              "ISA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:2"
      },
      "items": [
        {
          "text": "Gikwaya ngʼado bura makare,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.2",
            "verseOrgIds": [
              "ISA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:2"
      },
      "items": [
        {
          "text": "kendo ginenore joma dwaro ni",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.2",
            "verseOrgIds": [
              "ISA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:2"
      },
      "items": [
        {
          "text": "Nyasaye osud machiegni kodgi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.2",
            "verseOrgIds": [
              "ISA.58.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 58:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Giwacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.3",
            "verseOrgIds": [
              "ISA.58.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:3"
      },
      "items": [
        {
          "text": "'Angʼo momiyo wasebedo ka waweyo chiemo to ok ine?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.3",
            "verseOrgIds": [
              "ISA.58.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:3"
      },
      "items": [
        {
          "text": "Bende angʼo momiyo wasebedo ka wahore malich",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.3",
            "verseOrgIds": [
              "ISA.58.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:3"
      },
      "items": [
        {
          "text": "to ok ikwan ma ka gimoro?'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.3",
            "verseOrgIds": [
              "ISA.58.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ISA 58:3"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:3"
      },
      "items": [
        {
          "text": "\"To kata kamano e kindeu mar tweyo chiemo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.3",
            "verseOrgIds": [
              "ISA.58.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:3"
      },
      "items": [
        {
          "text": "utimo mana kaka udwaro,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.3",
            "verseOrgIds": [
              "ISA.58.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:3"
      },
      "items": [
        {
          "text": "kendo ukonyoru gi jotichu e yo marach.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.3",
            "verseOrgIds": [
              "ISA.58.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 58:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tweyo chiemo maru rumo mana gi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.4",
            "verseOrgIds": [
              "ISA.58.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:4"
      },
      "items": [
        {
          "text": "dhawo kod chuny malit,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.4",
            "verseOrgIds": [
              "ISA.58.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:4"
      },
      "items": [
        {
          "text": "bende miyo ugoru e kindu uwegi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.4",
            "verseOrgIds": [
              "ISA.58.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:4"
      },
      "items": [
        {
          "text": "Ok unyal tweyo chiemo kaka utimo e ndalogi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.4",
            "verseOrgIds": [
              "ISA.58.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:4"
      },
      "items": [
        {
          "text": "kuparo ni lemou nowinj e polo malo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.4",
            "verseOrgIds": [
              "ISA.58.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 58:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende ma e kit tweyo chiemo ma aseyiero,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.5",
            "verseOrgIds": [
              "ISA.58.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:5"
      },
      "items": [
        {
          "text": "ma ngʼato hore mana odiechiengʼ achiel kende?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.5",
            "verseOrgIds": [
              "ISA.58.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:5"
      },
      "items": [
        {
          "text": "Koso en mana ka ngʼama okuyo kokulo wiye ka odundu mayamo yuko",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.5",
            "verseOrgIds": [
              "ISA.58.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:5"
      },
      "items": [
        {
          "text": "kata ngʼama onindo e pien gugru kotimo buru?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.5",
            "verseOrgIds": [
              "ISA.58.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:5"
      },
      "items": [
        {
          "text": "Bende mano e gima uluongo ni",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.5",
            "verseOrgIds": [
              "ISA.58.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:5"
      },
      "items": [
        {
          "text": "tweyo chiemo ma en odiechiengʼ mowal ne Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.5",
            "verseOrgIds": [
              "ISA.58.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 58:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Donge ma e kit tweyo chiemo ma aseyiero:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.6",
            "verseOrgIds": [
              "ISA.58.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:6"
      },
      "items": [
        {
          "text": "ni ugony tonde mag timbe maricho gi mag jok,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.6",
            "verseOrgIds": [
              "ISA.58.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:6"
      },
      "items": [
        {
          "text": "mondo uwe joma otwe obed thuolo kendo utur jok duto?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.6",
            "verseOrgIds": [
              "ISA.58.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 58:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Donge en ni mondo upog chiembu ne joma",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.7",
            "verseOrgIds": [
              "ISA.58.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:7"
      },
      "items": [
        {
          "text": "kech kayo kendo urwak joma odhier maonge kuonde dak,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.7",
            "verseOrgIds": [
              "ISA.58.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:7"
      },
      "items": [
        {
          "text": "bende ni mondo umi joma wuotho duk lewni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.7",
            "verseOrgIds": [
              "ISA.58.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:7"
      },
      "items": [
        {
          "text": "kendo kik upand wangʼu ne wedeu?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.7",
            "verseOrgIds": [
              "ISA.58.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 58:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutimo mago eka ler ma un-go nonen",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.8",
            "verseOrgIds": [
              "ISA.58.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:8"
      },
      "items": [
        {
          "text": "ka ler mar okinyi kendo chang maru nobi mapiyo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.8",
            "verseOrgIds": [
              "ISA.58.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:8"
      },
      "items": [
        {
          "text": "bende timu makare notel nyimu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.8",
            "verseOrgIds": [
              "ISA.58.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:8"
      },
      "items": [
        {
          "text": "kendo teko gi duongʼ mar Jehova Nyasaye nodongʼnu chien.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.8",
            "verseOrgIds": [
              "ISA.58.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 58:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo iniluong Jehova Nyasaye kendo nodwoki;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.9",
            "verseOrgIds": [
              "ISA.58.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 58:9"
      },
      "items": [
        {
          "text": "iniywagne mondo okonyi kendo nokoni ni: Eri antie.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.9",
            "verseOrgIds": [
              "ISA.58.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ISA 58:9"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 58:9"
      },
      "items": [
        {
          "text": "\"Ka uweyo sando ji",
          "type": "text",
