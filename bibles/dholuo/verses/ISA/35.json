    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mor mar joma oresi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuonde motimo ongoro",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.1",
            "verseOrgIds": [
              "ISA.35.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:1"
      },
      "items": [
        {
          "text": "kendo mobaro okak nobed mamor;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.1",
            "verseOrgIds": [
              "ISA.35.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:1"
      },
      "items": [
        {
          "text": "kuonde thimbe nobed moil",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.1",
            "verseOrgIds": [
              "ISA.35.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:1"
      },
      "items": [
        {
          "text": "kendo momiyo ka maua mathiewo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.1",
            "verseOrgIds": [
              "ISA.35.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:1"
      },
      "items": [
        {
          "text": "mana kaka ondanyo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.1",
            "verseOrgIds": [
              "ISA.35.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "enogol maua mabeyo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.2",
            "verseOrgIds": [
              "ISA.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:2"
      },
      "items": [
        {
          "text": "mi nobed gi mor ka ogoyo koko gi ilo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.2",
            "verseOrgIds": [
              "ISA.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:2"
      },
      "items": [
        {
          "text": "Enobed gi duongʼ mar Lebanon,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.2",
            "verseOrgIds": [
              "ISA.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:2"
      },
      "items": [
        {
          "text": "gi mor mar Karmel kod Sharon;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.2",
            "verseOrgIds": [
              "ISA.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:2"
      },
      "items": [
        {
          "text": "ginine duongʼ mar Jehova Nyasaye, ma Nyasachwa maber.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.2",
            "verseOrgIds": [
              "ISA.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teguru bede mayom yom,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.3",
            "verseOrgIds": [
              "ISA.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:3"
      },
      "items": [
        {
          "text": "rieuru chong monyosore;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.3",
            "verseOrgIds": [
              "ISA.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "koneuru joma nigi chuny mool ni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.4",
            "verseOrgIds": [
              "ISA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:4"
      },
      "items": [
        {
          "text": "\"Beduru motegno kendo kik uluor;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.4",
            "verseOrgIds": [
              "ISA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:4"
      },
      "items": [
        {
          "text": "nimar Nyasachu biro biro,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.4",
            "verseOrgIds": [
              "ISA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:4"
      },
      "items": [
        {
          "text": "mondo ochul kuor ne wasiku,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.4",
            "verseOrgIds": [
              "ISA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:4"
      },
      "items": [
        {
          "text": "kaka owinjore kendo oresu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.4",
            "verseOrgIds": [
              "ISA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka joma muofni nonen",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.5",
            "verseOrgIds": [
              "ISA.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:5"
      },
      "items": [
        {
          "text": "kendo joma itgi odino nowinj wach.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.5",
            "verseOrgIds": [
              "ISA.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka rongʼonde nolengʼre ka nyakech",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.6",
            "verseOrgIds": [
              "ISA.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:6"
      },
      "items": [
        {
          "text": "kendo momni nokog gi mor.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.6",
            "verseOrgIds": [
              "ISA.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:6"
      },
      "items": [
        {
          "text": "Pi nobubni kowuok e thim,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.6",
            "verseOrgIds": [
              "ISA.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:6"
      },
      "items": [
        {
          "text": "kendo oula nomol kar ongoro.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.6",
            "verseOrgIds": [
              "ISA.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piny ma yande otwo nolokre dago,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.7",
            "verseOrgIds": [
              "ISA.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:7"
      },
      "items": [
        {
          "text": "kendo achiya nowuog e lowo motwo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.7",
            "verseOrgIds": [
              "ISA.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:7"
      },
      "items": [
        {
          "text": "Lum, odundu kod togo nodongi kama ondiegi yande odakie.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.7",
            "verseOrgIds": [
              "ISA.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo wangʼ yo nobedi kanyo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.8",
            "verseOrgIds": [
              "ISA.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:8"
      },
      "items": [
        {
          "text": "mi noluonge ni Wangʼ Yo Maler.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.8",
            "verseOrgIds": [
              "ISA.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:8"
      },
      "items": [
        {
          "text": "Joma ok ler ok nowuothie,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.8",
            "verseOrgIds": [
              "ISA.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:8"
      },
      "items": [
        {
          "text": "to nobedi wangʼ yo ma joma kare ema luwo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.8",
            "verseOrgIds": [
              "ISA.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:8"
      },
      "items": [
        {
          "text": "joma ofuwo ma joricho ok nowuothie.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.8",
            "verseOrgIds": [
              "ISA.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onge sibuor manoyud kuno",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.9",
            "verseOrgIds": [
              "ISA.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:9"
      },
      "items": [
        {
          "text": "kata mana ondieg bungu mager manade,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.9",
            "verseOrgIds": [
              "ISA.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:9"
      },
      "items": [
        {
          "text": "ok nosud machiegni kanyo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.9",
            "verseOrgIds": [
              "ISA.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:9"
      },
      "items": [
        {
          "text": "To mana joma Nyasaye osewaro ema nowuothie,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.9",
            "verseOrgIds": [
              "ISA.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo joma Jehova Nyasaye osereso nodwogi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.10",
            "verseOrgIds": [
              "ISA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:10"
      },
      "items": [
        {
          "text": "Ginidonji Sayun ka giwer;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.10",
            "verseOrgIds": [
              "ISA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:10"
      },
      "items": [
        {
          "text": "kendo ka ilo mosiko opongʼo chunygi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.10",
            "verseOrgIds": [
              "ISA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:10"
      },
      "items": [
        {
          "text": "Ginibed gi mor gi ilo mosiko,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.10",
            "verseOrgIds": [
              "ISA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:10"
      },
      "items": [
        {
          "text": "kendo kuyo kod parruok norum chuth.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.10",
            "verseOrgIds": [
              "ISA.35.10"
            ]
          }
        }
      ]
    }
  ],
