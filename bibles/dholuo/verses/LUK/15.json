          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"E kindeno, noyudo ka wuowi maduongʼ ni e puodho. Kane obiro machiegni gi ot nowinjo wer gi miel.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.25",
                "verseOrgIds": [
                  "LUK.15.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.25",
            "verseOrgIds": [
              "LUK.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Omiyo noluongo achiel kuom jotich kendo nopenje ni en angʼo matimore.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.26",
                "verseOrgIds": [
                  "LUK.15.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.26",
            "verseOrgIds": [
              "LUK.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nodwoke ni, 'Owadu osedwogo, to wuonu osenego nyarwath machwe nikech osedwogo kongima kendo maber.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.27",
                "verseOrgIds": [
                  "LUK.15.27"
                ]
              }
            }
          ]
        }
