        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Wuon mare nowacho niya, 'Wuoda, in koda ndalo duto, kendo gik moko duto ma an-go gin magi.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.31",
                "verseOrgIds": [
                  "LUK.15.31"
                ]
