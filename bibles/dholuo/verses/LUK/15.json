        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Keluru nyarwath machwe uyangʼ. Wachamuru wabed mamor.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.23",
                "verseOrgIds": [
                  "LUK.15.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.23",
            "verseOrgIds": [
              "LUK.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nikech wuodani yande otho, to koro onwangʼe.' Kamano negichako timo nyasi ka gimor.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.24",
                "verseOrgIds": [
                  "LUK.15.24"
                ]
              }
            }
          ]
        }
