        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To nyaka ne wabed mamor kendo bed moil, nikech owaduni yande otho to koro ongima, kendo yande olal to koro oyude!' \"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.32",
