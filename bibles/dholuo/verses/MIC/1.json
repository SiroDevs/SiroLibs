  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "MIC 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MIC 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wach Jehova Nyasaye mane obiro ne Mika ja-Moresheth e ndalo loch Jotham, Ahaz kod Hezekia Ruodhi mag Juda e fweny mane oneno kuom Samaria kod Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.1",
            "verseOrgIds": [
              "MIC.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Winjuru, yaye un ogendini duto.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.2",
            "verseOrgIds": [
              "MIC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:2"
      },
      "items": [
        {
          "text": "Chik iti yaye piny gi ji duto modakie iye,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.2",
            "verseOrgIds": [
              "MIC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:2"
      },
      "items": [
        {
          "text": "mondo Jehova Nyasaye mar oganda lweny obed janeno kuomu,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.2",
            "verseOrgIds": [
              "MIC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:2"
      },
      "items": [
        {
          "text": "mondo Ruoth Nyasaye otim kamano gie hekalu mare maler.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.2",
            "verseOrgIds": [
              "MIC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bura mongʼadne Samaria gi Jerusalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neuru! Jehova Nyasaye biro kowuok e kar dakne;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.3",
            "verseOrgIds": [
              "MIC.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:3"
      },
      "items": [
        {
          "text": "olor piny kendo onyono kuonde ma otingʼore mag piny.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.3",
            "verseOrgIds": [
              "MIC.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gode noleny e bwoye",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.4",
            "verseOrgIds": [
              "MIC.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:4"
      },
      "items": [
        {
          "text": "kendo holni nobarore kapogore koni gi koni,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.4",
            "verseOrgIds": [
              "MIC.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:4"
      },
      "items": [
        {
          "text": "mana ka odok mobolie mach,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.4",
            "verseOrgIds": [
              "MIC.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:4"
      },
      "items": [
        {
          "text": "kendo mana ka pi maburore koa ewi thur.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.4",
            "verseOrgIds": [
              "MIC.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magi duto timore nikech bayo yo mar Jakobo,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.5",
            "verseOrgIds": [
              "MIC.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:5"
      },
      "items": [
        {
          "text": "nikech richo mar dhood Israel.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.5",
            "verseOrgIds": [
              "MIC.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:5"
      },
      "items": [
        {
          "text": "Bayo yo mar Jakobo to en angʼo?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.5",
            "verseOrgIds": [
              "MIC.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:5"
      },
      "items": [
        {
          "text": "Donge en Samaria?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.5",
            "verseOrgIds": [
              "MIC.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:5"
      },
      "items": [
        {
          "text": "Koso kama otingʼore mar Juda to kanye?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.5",
            "verseOrgIds": [
              "MIC.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:5"
      },
      "items": [
        {
          "text": "Donge en Jerusalem?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.5",
            "verseOrgIds": [
              "MIC.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kuom mano analok Samaria obed pith mar yugi,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.6",
            "verseOrgIds": [
              "MIC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:6"
      },
      "items": [
        {
          "text": "kama ipidhoe mzabibu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.6",
            "verseOrgIds": [
              "MIC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:6"
      },
      "items": [
        {
          "text": "Abiro olo kite mag dalano nyaka e holo",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.6",
            "verseOrgIds": [
              "MIC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:6"
      },
      "items": [
        {
          "text": "kendo abiro weyo mise mage nono li.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.6",
            "verseOrgIds": [
              "MIC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gige mopa molamo ibiro toyo matindo tindo;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.7",
            "verseOrgIds": [
              "MIC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:7"
      },
      "items": [
        {
          "text": "kendo mich mag hekalu mochiwo ibiro wangʼ gi mach;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.7",
            "verseOrgIds": [
              "MIC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:7"
      },
      "items": [
        {
          "text": "abiro ketho kido mage molos duto.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.7",
            "verseOrgIds": [
              "MIC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:7"
      },
      "items": [
        {
          "text": "Nikech michgo nochoko koa e chudo mar ochot,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.7",
            "verseOrgIds": [
              "MIC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:7"
      },
      "items": [
        {
          "text": "omiyo koro ibiro ti kodgi kaka chudo mar ochot.\"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.7",
            "verseOrgIds": [
              "MIC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ywak gi dengo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano, abiro ywak kendo dengo;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.8",
            "verseOrgIds": [
              "MIC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:8"
      },
      "items": [
        {
          "text": "abiro wuotho duk kod tienda nono.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.8",
            "verseOrgIds": [
              "MIC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:8"
      },
      "items": [
        {
          "text": "Anaywag ka ondiek manie thim",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.8",
            "verseOrgIds": [
              "MIC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:8"
      },
      "items": [
        {
          "text": "kendo nadengi ka tula.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.8",
            "verseOrgIds": [
              "MIC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech adhondene ok thiedhre;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.9",
            "verseOrgIds": [
              "MIC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:9"
      },
      "items": [
        {
          "text": "kata mana Juda adhondenego osemako.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.9",
            "verseOrgIds": [
              "MIC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:9"
      },
      "items": [
        {
          "text": "Masira osechopo nyaka e dhoranga joga,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.9",
            "verseOrgIds": [
              "MIC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:9"
      },
      "items": [
        {
          "text": "nyaka ei Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.9",
            "verseOrgIds": [
              "MIC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik unyis jo-Gath wachni",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.10",
            "verseOrgIds": [
              "MIC.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:10"
      },
      "items": [
        {
          "text": "bende kik uywagi kata matin.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.10",
            "verseOrgIds": [
              "MIC.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:10"
      },
      "items": [
        {
          "text": "E dala Beth Ofra",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.10",
            "verseOrgIds": [
              "MIC.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:10"
      },
      "items": [
        {
          "text": "ngʼielreuru e buru.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.10",
            "verseOrgIds": [
              "MIC.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MIC 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Un joma odak Shafir",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.11",
            "verseOrgIds": [
              "MIC.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:11"
      },
      "items": [
        {
          "text": "kadhuru ka un duge kod wichkuot.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.11",
            "verseOrgIds": [
              "MIC.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:11"
      },
      "items": [
        {
          "text": "Jogo modak Zanaan",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.11",
            "verseOrgIds": [
              "MIC.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:11"
      },
      "items": [
        {
