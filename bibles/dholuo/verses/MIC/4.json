  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "MIC 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Got mar Jehova Nyasaye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MIC 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "E ndalo giko",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.1",
            "verseOrgIds": [
              "MIC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:1"
      },
      "items": [
        {
          "text": "got mogerie hekalu mar Jehova Nyasaye nobed gi teko e kind gode duto molwore,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.1",
            "verseOrgIds": [
              "MIC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:1"
      },
      "items": [
        {
          "text": "kendo ibiro tingʼe malo moyombo gode duto",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.1",
            "verseOrgIds": [
              "MIC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:1"
      },
      "items": [
        {
          "text": "kendo ogendini duto nobi ma pongʼe.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.1",
            "verseOrgIds": [
              "MIC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogendini mangʼeny nobi kawacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:2"
      },
      "items": [
        {
          "text": "\"Biuru wadhi e got mar Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:2"
      },
      "items": [
        {
          "text": "e od Nyasach Jakobo.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:2"
      },
      "items": [
        {
          "text": "Enopuonjwa wechene",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:2"
      },
      "items": [
        {
          "text": "mondo wawuothie e yorene.\"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:2"
      },
      "items": [
        {
          "text": "Chik nowuog Sayun,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:2"
      },
      "items": [
        {
          "text": "kendo wach Jehova Nyasaye nowuog koa Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obiro ngʼado bura e kind ogendini",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.3",
            "verseOrgIds": [
              "MIC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:3"
      },
      "items": [
        {
          "text": "kendo nokel kwe e kind pinje marateke man machiegni kod mago man mabor.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.3",
            "verseOrgIds": [
              "MIC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:3"
      },
      "items": [
        {
          "text": "Ginithedh ligengligi olokre kwe mag pur",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.3",
            "verseOrgIds": [
              "MIC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:3"
      },
      "items": [
        {
          "text": "kendo tongegi ginithedhi olokre pende keyo.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.3",
            "verseOrgIds": [
              "MIC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:3"
      },
      "items": [
        {
          "text": "Onge piny mano kedi gi nyawadgi gi ligangla",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.3",
            "verseOrgIds": [
              "MIC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:3"
      },
      "items": [
        {
          "text": "bende ok ginichak gipuonjre ne lweny kendo.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.3",
            "verseOrgIds": [
              "MIC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼato ka ngʼato nobed e bwo yiende owuon mar mzabibu",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.4",
            "verseOrgIds": [
              "MIC.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:4"
      },
      "items": [
        {
          "text": "kendo e bwo yiende owuon mar ngʼowu,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.4",
            "verseOrgIds": [
              "MIC.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:4"
      },
      "items": [
        {
          "text": "kendo onge ngʼama nochak omigi luoro",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.4",
            "verseOrgIds": [
              "MIC.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:4"
      },
      "items": [
        {
          "text": "nikech Jehova Nyasaye Maratego osewacho.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.4",
            "verseOrgIds": [
              "MIC.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata obedo ni ogendini mamoko duto",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.5",
            "verseOrgIds": [
              "MIC.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:5"
      },
      "items": [
        {
          "text": "nyalo wuotho e nying nyisechegi,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.5",
            "verseOrgIds": [
              "MIC.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:5"
      },
      "items": [
        {
          "text": "wan to wabiro",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.5",
            "verseOrgIds": [
              "MIC.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:5"
      },
      "items": [
        {
          "text": "wuotho e nying Jehova Nyasaye ma Nyasachwa manyaka chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.5",
            "verseOrgIds": [
              "MIC.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chenro mar Jehova Nyasaye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye wacho kama,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.6",
            "verseOrgIds": [
              "MIC.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:6"
      },
      "items": [
        {
          "text": "\"E odiechiengno anachok rongʼonde,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.6",
            "verseOrgIds": [
              "MIC.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:6"
      },
      "items": [
        {
          "text": "gi joma oter e twech",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.6",
            "verseOrgIds": [
              "MIC.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:6"
      },
      "items": [
        {
          "text": "kod joma asekelo negi lit.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.6",
            "verseOrgIds": [
              "MIC.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro miyo rongʼode dongʼ kangima,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.7",
            "verseOrgIds": [
              "MIC.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:7"
      },
      "items": [
        {
          "text": "to joma odhi e twech nobed oganda motegno,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.7",
            "verseOrgIds": [
              "MIC.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:7"
      },
      "items": [
        {
          "text": "Jehova Nyasaye noritgi e got mar Sayun",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.7",
            "verseOrgIds": [
              "MIC.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:7"
      },
      "items": [
        {
          "text": "chakre odiechiengno nyaka chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.7",
            "verseOrgIds": [
              "MIC.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye, in kama oger motingʼore mar rito rombe,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.8",
            "verseOrgIds": [
              "MIC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:8"
      },
      "items": [
        {
          "text": "in ohinga mar Sayun,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.8",
            "verseOrgIds": [
              "MIC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:8"
      },
      "items": [
        {
          "text": "ibiro duogni duongʼ mari machon;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.8",
            "verseOrgIds": [
              "MIC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:8"
      },
      "items": [
        {
          "text": "nyar Jerusalem nobed jatelo.\"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.8",
            "verseOrgIds": [
              "MIC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angʼo momiyo koro iywak matek kamano,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.9",
            "verseOrgIds": [
              "MIC.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:9"
      },
      "items": [
        {
          "text": "ionge gi ruoth koso?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.9",
            "verseOrgIds": [
              "MIC.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:9"
      },
      "items": [
        {
          "text": "Dipo ka jangʼadni rieko osetho,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.9",
            "verseOrgIds": [
              "MIC.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:9"
      },
      "items": [
        {
          "text": "marem chami mana ka dhako mamuoch kayo?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.9",
            "verseOrgIds": [
              "MIC.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ywari gi rem, yaye Nyar Sayun,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.10",
            "verseOrgIds": [
              "MIC.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:10"
      },
      "items": [
        {
          "text": "mana ka dhako mamuoch kayo,",
