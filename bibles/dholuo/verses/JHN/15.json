        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ka Jakony ma abiro oronu koa ka Wuora, ma en Roho mar adier maa kuom Wuora nobi, enotim neno kuoma.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.26",
                "verseOrgIds": [
                  "JHN.15.26"
                ]
