        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To un bende nyaka utim nenda, nimar usebedo koda nyaka ne achak lando Injilini.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.27",
                "verseOrgIds": [
