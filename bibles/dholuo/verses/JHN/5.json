          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To ka dine bed ni uyie kuom Musa, to An bende dine uyie kuoma, nimar nondiko kuoma.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.46",
                "verseOrgIds": [
                  "JHN.5.46"
                ]
