          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To kaka ok uyie kuom gik mane ondiko, ere kaka ubiro yie kuom gik ma awacho?\"",
