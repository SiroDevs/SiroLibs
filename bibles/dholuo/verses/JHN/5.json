          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Uketo chunyu kuom nono Muma nikech uparo ni unyalo yudo ngima mochwere kuomgi. Muma ema timo neno kuoma,",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.39",
                "verseOrgIds": [
                  "JHN.5.39"
                ]
              }
            }
