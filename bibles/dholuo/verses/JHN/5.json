        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"To an gi neno maduongʼ moloyo mar Johana, nimar tich mane Wuora omiya mondo achopi, kendo makoro atimo sani-ni, nyiso ni Wuora ema noora.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.36",
