          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "An asebiro e nying Wuora, to utamoru rwaka; to ka ngʼato machielo nobi e nyinge owuon to ubiro rwake arwaka.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.43",
                "verseOrgIds": [
                  "JHN.5.43"
                ]
              }
            }
          ]
        },
