          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ne uoro joote ne Johana kendo osetimo neno kuom adiera.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.33",
                "verseOrgIds": [
                  "JHN.5.33"
