        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "An onge gima anyalo timo gi tekona awuon, to angʼado bura ne ji mana kaluwore gi gima awinjo, kendo bura ma angʼado nikare, nimar ok atim kamano mondo atim dwarona awuon, to mondo atim dwaro Jal mane oora.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.30",
                "verseOrgIds": [
                  "JHN.5.30"
                ]
              }
            }
          ]
