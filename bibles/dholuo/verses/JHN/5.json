          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "to kata kamano utamoru biro ira mondo uyud ngima.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.40",
                "verseOrgIds": [
                  "JHN.5.40"
