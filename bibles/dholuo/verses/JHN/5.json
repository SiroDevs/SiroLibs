        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Awachonu adier ni ndalo biro, kendo koro osechopo, ma joma otho biro winjo dwond Wuod Nyasaye, kendo joma owinjo dwolno biro doko mangima.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.25",
