              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ere kaka unyalo yie ka urwako pak ma joweteu pakougo, to ok utem matek mondo uyud pak moa kuom Nyasaye ma achiel kende?",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.44",
                "verseOrgIds": [
                  "JHN.5.44"
                ]
              }
            }
          ]
        }
