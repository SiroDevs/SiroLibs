        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kik upar ni abiro donjonu e nyim Wuoro. Ngʼat madonjonu en Musa, ma useketo genou kuome.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.45",
                "verseOrgIds": [
