        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Wuoro moseorano osetimo neno kuoma en owuon. Pok uwinjo dwonde nyaka nene kendo pok uneno kite.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.37",
                "verseOrgIds": [
                  "JHN.5.37"
                ]
