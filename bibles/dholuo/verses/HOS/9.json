  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "HOS 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kum ne jo-Israel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik umor, yaye Israel;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.1",
            "verseOrgIds": [
              "HOS.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:1"
      },
      "items": [
        {
          "text": "bende kik ubed gi ilo kaka ogendini mamoko.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.1",
            "verseOrgIds": [
              "HOS.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:1"
      },
      "items": [
        {
          "text": "Nimar ok usebedo jo-adiera ne Nyasachu;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.1",
            "verseOrgIds": [
              "HOS.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:1"
      },
      "items": [
        {
          "text": "usehero chudo mar ochot michulougo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.1",
            "verseOrgIds": [
              "HOS.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:1"
      },
      "items": [
        {
          "text": "e kuonde dino cham.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.1",
            "verseOrgIds": [
              "HOS.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuonde ma idinoe cham kod kuonde mibiyoe divai ok nopidh ji;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.2",
            "verseOrgIds": [
              "HOS.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:2"
      },
      "items": [
        {
          "text": "kendo divai manyien ok nokonygi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.2",
            "verseOrgIds": [
              "HOS.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ok ginidongʼ e piny Jehova Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.3",
            "verseOrgIds": [
              "HOS.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:3"
      },
      "items": [
        {
          "text": "Efraim nodog Misri,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.3",
            "verseOrgIds": [
              "HOS.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:3"
      },
      "items": [
        {
          "text": "kendo ginicham chiemo ma ok opwodhi e piny Asuria.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.3",
            "verseOrgIds": [
              "HOS.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ok gini olne Jehova Nyasaye misango mar divai,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.4",
            "verseOrgIds": [
              "HOS.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:4"
      },
      "items": [
        {
          "text": "bende misengini ma gichiwo ok nomor Jehova Nyasaye ngangʼ.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.4",
            "verseOrgIds": [
              "HOS.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:4"
      },
      "items": [
        {
          "text": "Misengini machalo kamano nochal negi mana kaka chiemb joma ywak;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.4",
            "verseOrgIds": [
              "HOS.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:4"
      },
      "items": [
        {
          "text": "kendo jogo mochamogi nobed mogak.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.4",
            "verseOrgIds": [
              "HOS.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:4"
      },
      "items": [
        {
          "text": "Chiemoni nobed margi giwegi;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.4",
            "verseOrgIds": [
              "HOS.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:4"
      },
      "items": [
        {
          "text": "omiyo ok nokele e hekalu mar Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.4",
            "verseOrgIds": [
              "HOS.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unutim angʼo e odiechiengu mowal mar nyasi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.5",
            "verseOrgIds": [
              "HOS.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:5"
      },
      "items": [
        {
          "text": "kata ka odiechienge nyasi mar Jehova Nyasaye ochopo?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.5",
            "verseOrgIds": [
              "HOS.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata ka gitony e kethruok,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.6",
            "verseOrgIds": [
              "HOS.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:6"
      },
      "items": [
        {
          "text": "Misri nochokgi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.6",
            "verseOrgIds": [
              "HOS.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:6"
      },
      "items": [
        {
          "text": "kendo Memfis noikgi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.6",
            "verseOrgIds": [
              "HOS.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:6"
      },
      "items": [
        {
          "text": "Mwandu mag fedha noum gi pedo",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.6",
            "verseOrgIds": [
              "HOS.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:6"
      },
      "items": [
        {
          "text": "kendo kuthe noum hembegi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.6",
            "verseOrgIds": [
              "HOS.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinde mag kum biro",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.7",
            "verseOrgIds": [
              "HOS.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:7"
      },
      "items": [
        {
          "text": "kendo kinde mag ngʼado bura osechopo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.7",
            "verseOrgIds": [
              "HOS.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:7"
      },
      "items": [
        {
          "text": "Omiyo jo-Israel nyaka ngʼe wachni.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.7",
            "verseOrgIds": [
              "HOS.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:7"
      },
      "items": [
        {
          "text": "Nikech richou ngʼeny",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.7",
            "verseOrgIds": [
              "HOS.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:7"
      },
      "items": [
        {
          "text": "kendo kinyou lich miwuoro,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.7",
            "verseOrgIds": [
              "HOS.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:7"
      },
      "items": [
        {
          "text": "janabi ikwano ka ngʼama ofuwo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.7",
            "verseOrgIds": [
              "HOS.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:7"
      },
      "items": [
        {
          "text": "to ngʼat matiyo gi much Nyasaye ka janeko.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.7",
            "verseOrgIds": [
              "HOS.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Janabi, kaachiel gi Nyasacha",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.8",
            "verseOrgIds": [
              "HOS.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:8"
      },
      "items": [
        {
          "text": "e jarit mar Efraim,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.8",
            "verseOrgIds": [
              "HOS.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:8"
      },
      "items": [
        {
          "text": "kata kamano obadho rite e yorene duto,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.8",
            "verseOrgIds": [
              "HOS.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:8"
      },
      "items": [
        {
          "text": "kendo akweda bende rite e od Nyasache.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.8",
            "verseOrgIds": [
              "HOS.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gisedonjo matut e timbe mag miganga",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.9",
            "verseOrgIds": [
              "HOS.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:9"
      },
      "items": [
        {
          "text": "mana ka ndalo mag Gibea.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.9",
            "verseOrgIds": [
              "HOS.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:9"
      },
      "items": [
        {
          "text": "Nyasaye nopar timbegi mamono",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.9",
            "verseOrgIds": [
              "HOS.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:9"
      },
      "items": [
        {
          "text": "kendo enokumgi e richogi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.9",
            "verseOrgIds": [
              "HOS.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kane ayudo Israel",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.10",
            "verseOrgIds": [
              "HOS.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:10"
      },
      "items": [
        {
          "text": "ne ochalo mana kayudo olemb mzabibu e piny motwo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.10",
            "verseOrgIds": [
              "HOS.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:10"
      },
      "items": [
        {
          "text": "kane aneno kwereu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.10",
            "verseOrgIds": [
              "HOS.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:10"
      },
      "items": [
        {
          "text": "ne chalo mana ka gima aneno olemo monyak mokwongo mar ngʼowu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.10",
            "verseOrgIds": [
              "HOS.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
