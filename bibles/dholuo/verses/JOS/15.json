          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekron gi mier molworo bende ne margi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.45",
            "verseOrgIds": [
              "JOS.15.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JOS 15:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashdod gi mier molwore bende ne margi kochakore yo podho chiengʼ mar Ekron.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.46",
            "verseOrgIds": [
              "JOS.15.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JOS 15:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashdod gi Gaza kod miechgi mochopo nyaka Wadi manie tongʼ-gi gi Misri, kendo koluwo nyaka dho Nam Maduongʼ bende ne margi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.47",
            "verseOrgIds": [
              "JOS.15.47"
            ]
          }
        }
      ]
    },
