          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mier mamoko ne gin: Libna, Ether, Ashan,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.42",
            "verseOrgIds": [
              "JOS.15.42"
            ]
          }
        },
