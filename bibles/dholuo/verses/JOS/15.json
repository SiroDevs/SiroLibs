          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dilean, Mizpa, Jokthel,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.38",
            "verseOrgIds": [
              "JOS.15.38"
            ]
          }
        },
