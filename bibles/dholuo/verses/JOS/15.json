      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JOS 15:48"
      },
      "items": [
        {
          "text": "Shamir, Jatir, Soko,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.48",
            "verseOrgIds": [
              "JOS.15.48"
            ]
          }
        },
