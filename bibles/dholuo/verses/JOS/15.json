          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mier mamoko mane ni e got ne gin:",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.48",
            "verseOrgIds": [
              "JOS.15.48"
            ]
          }
        }
      ]
    },
