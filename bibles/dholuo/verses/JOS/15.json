          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "To mier mane nitiere e tiend gode ma yo podho chiengʼ ne gin:",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.33",
            "verseOrgIds": [
              "JOS.15.33"
            ]
          }
        }
      ]
    },
    {
