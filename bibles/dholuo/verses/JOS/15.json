          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JOS 15:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Goshen, Holon, kod Gilo. Giduto ne gin mier kod gwenge maromo apar gachiel.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.51",
            "verseOrgIds": [
              "JOS.15.51"
            ]
          }
        }
      ]
    },
    {
