          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "JOS 15:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kain, Gibea, kod Timna. Giduto ne gin mier kod gwenge maromo apar.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.57",
            "verseOrgIds": [
              "JOS.15.57"
            ]
          }
        }
      ]
    },
    {
