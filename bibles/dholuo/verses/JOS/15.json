          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mier mamoko ne gin: Maon, Karmel, Zif, Juta,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.55",
            "verseOrgIds": [
              "JOS.15.55"
            ]
          }
        },
