      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JOS 15:33"
      },
      "items": [
        {
          "text": "Eshtaol, Zora, Ashna,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.33",
            "verseOrgIds": [
              "JOS.15.33"
            ]
          }
        },
