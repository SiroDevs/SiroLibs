          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "61",
            "style": "v",
            "sid": "JOS 15:61"
          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mier mane giyudo e thim ne gin:",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.61",
            "verseOrgIds": [
              "JOS.15.61"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JOS 15:61"
      },
      "items": [
        {
          "text": "Beth Araba, Midin, Sekaka,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.61",
            "verseOrgIds": [
              "JOS.15.61"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "JOS 15:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibshan, Dala Maduongʼ mar Chumbi, kod En Gedi. Giduto ne gin mier kod gwenge maromo auchiel.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.62",
            "verseOrgIds": [
              "JOS.15.62"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "63",
            "style": "v",
            "sid": "JOS 15:63"
          },
          "items": [
            {
              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo-Juda ne ok nyal daro jo-Jebus, mane odak Jerusalem; jo-Jebus gi jo-Juda pod odak kanyo nyaka chil kawuono.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.63",
            "verseOrgIds": [
              "JOS.15.63"
            ]
          }
        }
      ]
