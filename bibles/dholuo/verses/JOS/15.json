          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zanoa, En Ganim, Tapua, Enam,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.34",
            "verseOrgIds": [
              "JOS.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jarmuth, Adulam, Soko, Azeka,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.35",
            "verseOrgIds": [
              "JOS.15.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JOS 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sharaim, Adithaim, kod Gedera (kata Gederothaim). Giduto ne gin mier gi gwenge maromo apar gangʼwen.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.36",
            "verseOrgIds": [
              "JOS.15.36"
            ]
          }
        }
      ]
    },
