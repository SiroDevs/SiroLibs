          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifta, Ashna, Nezib,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.43",
            "verseOrgIds": [
              "JOS.15.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
