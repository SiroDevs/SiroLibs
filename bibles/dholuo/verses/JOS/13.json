          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Girkeni mane Musa omiyo nus mar dhood Manase, tiende ni, nus mar nyikwa Manase, kaluwore gi anywola ka anywola.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pinygi nochakore Mahanaim, mokwako piny Og ruodh Bashan duto kod kuonde dak duto mag Jair man Bashan, to gi mier matindo piero auchiel,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.30",
            "verseOrgIds": [
              "JOS.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "bende nokawo nus mar jo-Gilead, gi Ashtaroth kod Edrei (ma gin mier madongo mag Og ruodh Bashan).",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.31",
            "verseOrgIds": [
              "JOS.13.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "JOS 13:31"
      },
      "items": [
        {
          "text": "Magi e pok mane omi nyikwa Makir wuod Manase, tiende ni nus mar dhood Makir konchiel.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
