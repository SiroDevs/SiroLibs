            "number": "32",
            "style": "v",
            "sid": "JOS 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma e girkeni mane Musa ochiwo kane en e paw Moab nyaka loka aora Jordan, yo wuok chiengʼ mar Jeriko.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ni dhood Lawi, Musa ne ok opogonigi girkeni, nikech Jehova Nyasaye, ma Nyasach Israel, e girkeni margi, mana kaka nosesingonegi.",
          "type": "text"
        }
      ]
    }
