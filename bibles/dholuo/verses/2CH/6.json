  "verseCount": 42,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "2CH 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Solomon nowacho niya, \"Jehova Nyasaye osewacho ni enodag ei bor polo motimo mudho.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.1",
            "verseOrgIds": [
              "2CH.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asegeroni hekalu marahuma, kama inidagie nyaka chiengʼ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.2",
            "verseOrgIds": [
              "2CH.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane oganda jo-Israel duto ochungʼ kanyo, ruoth nolokore mogwedhogi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.3",
            "verseOrgIds": [
              "2CH.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka nowacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.4",
            "verseOrgIds": [
              "2CH.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2CH 6:4"
      },
      "items": [
        {
          "text": "\"Pak obed ne Jehova Nyasaye, ma Nyasach Israel, mosetimo gi lwete gima ne osingo gi dhoge ni Daudi wuonwa. Nikech nowacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.4",
            "verseOrgIds": [
              "2CH.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Chakre ndalo mane agolo joga koa Misri pok ayiero dala maduongʼ e dhoot moro amora mar Israel mondo oger hekalu kanyo ni Nyinga, to aseyiero Daudi mondo otel ni joga Israel.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.5",
            "verseOrgIds": [
              "2CH.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "To koro aseyiero Jerusalem mondo obed kama Nyinga betie kendo aseyiero Daudi mondo otel ni joga Israel.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.6",
            "verseOrgIds": [
              "2CH.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Daudi wuora noketo e chunye mondo oger hekalu moluongo nying Jehova Nyasaye ma Nyasach Israel.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.7",
            "verseOrgIds": [
              "2CH.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Jehova Nyasaye nowacho ni Daudi wuora niya, 'Nitimo maber mondo ibed gi wach gero hekalu ni nyinga e chunyi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.8",
            "verseOrgIds": [
              "2CH.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata kamano in ok niger hekalu, to wuodi, ma en ringri gi rembi iwuon; en ema noger hekalu ni Nyinga.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.9",
            "verseOrgIds": [
              "2CH.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Jehova Nyasaye oserito singruok mane otimo. Asekawo loch wuora Daudi kendo asebet e kom loch mar Israel mana kaka Nyasaye nosingo kendo asegero hekalu ni Nying Jehova Nyasaye ma Nyasach Israel.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.10",
            "verseOrgIds": [
              "2CH.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aseketo Sandug Muma ma moketie singruok mane Jehova Nyasaye otimo e kinde gi jo-Israel.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.11",
            "verseOrgIds": [
              "2CH.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lemb Solomon mar Walo hekalu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Solomon nochungʼ e nyim kendo mar misango mar Jehova Nyasaye e nyim oganda duto mar jo-Israel kendo norieyo bedene kochomo malo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.12",
            "verseOrgIds": [
              "2CH.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noseloso raidhi mar mula ma borne gi lachne romo fut aboro to borne kadhi malo en fut abich mokete e dier laru ma oko. Ne ochungʼ e raidhino mi ogoyo chonge piny e nyim oganda duto mar jo-Israel kendo norieyo bedene kochomo polo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.13",
            "verseOrgIds": [
              "2CH.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kowacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.14",
            "verseOrgIds": [
              "2CH.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2CH 6:14"
      },
      "items": [
        {
          "text": "\"Yaye Jehova Nyasaye ma Nyasach Israel, onge Nyasaye moro e polo kata e piny machal kodi. In e Nyasaye marito singruok mar herane ni jotichne maluwo yoreni gi chunygi duto.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.14",
            "verseOrgIds": [
              "2CH.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iserito singruokni mane itimo gi jatichni Daudi wuora, ne isingori gi dhogi kendo isechopo singruokno gi lweti, mana kaka en kawuononi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.15",
            "verseOrgIds": [
              "2CH.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"To koro Jehova Nyasaye ma Nyasach Israel rit singruok mane itimo gi jatichni Daudi wuora kiwachone niya, 'Ok inibed maonge ngʼama bet e nyima e kom loch Israel ka nyikwayi onono kaka giwuotho e nyima kaka chikna dwaro mana kaka isetimo.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.16",
            "verseOrgIds": [
              "2CH.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "To koro, yaye Jehova Nyasaye ma Nyasach Israel yie mondo wach mane isingo ni jatichni Daudi wuora otimre mana kaka ne isingo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.17",
            "verseOrgIds": [
              "2CH.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"To bende Nyasaye nyalo dak e piny kod ji? Kata polo malo kata polo mabor ok nyal romi, to koro hekalu mageroni to diromi nade!",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.18",
            "verseOrgIds": [
              "2CH.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata kamano chik iti ni lamo jatichni gi kwayone mar ngʼwono yaye Jehova Nyasaye Nyasacha. Winji ywak gi lemo ma jatichni lamo e nyimi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.19",
            "verseOrgIds": [
              "2CH.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad wangʼi rang hekaluni odiechiengʼ kod otieno, kama niwacho ni Nyingi nobedie. Yie iwinji lemo ma jatichni lamo kochomo odni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.20",
            "verseOrgIds": [
              "2CH.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Winji lamo mar jatichni kaachiel gi jogi Israel ka gilamo ka gichomo odni. Winji gi e polo kar dakni kendo kiwinjo to iwenwa richowa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.21",
            "verseOrgIds": [
              "2CH.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ka ngʼato oketho ni wadgi kendo dwarore ni mondo okwongʼre kendo obiro mokwongʼore e nyim kendo mar misango manie hekaluni,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.22",
            "verseOrgIds": [
              "2CH.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "to iwinji gi e polo kendo itim kaka owinjore. Ngʼad bura e kind jotichni kikumo joketho kendo iket richogi e wigi bende joma onge ketho iket kare kaluwore gi timgi makare.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.23",
            "verseOrgIds": [
              "2CH.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ka jogi Israel olo e lweny gi jowasikgi nikech gisekethoni to bangʼe gilokore mi gipako nyingi, ka gilamo kendo gikwayo e hekaluni,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.24",
            "verseOrgIds": [
              "2CH.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "to iwinjgi gi e polo kendo iwe richo jogi Israel kendo iduog-gi e piny mane imiyogi kod kweregi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.25",
            "verseOrgIds": [
              "2CH.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ka polo olor kendo koth onge nikech jogi osekethoni to ka gilemo kaeni ka gipako nyingi kendo ka gilokore giweyo richogi nikech isekelonegi chandruok,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.26",
            "verseOrgIds": [
              "2CH.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "to yie mondo iwinjgi gie polo kendo iwene jotichni ma jo-Israel richogi. Puonjgi yo makare mar dak kendo iornegi koth e piny mane imiyo jogi kaka girkeni margi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.27",
            "verseOrgIds": [
              "2CH.6.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ka kech kata dera omako piny kata ka abach omako cham kata tuo ewi dongo, kata ka bonyo kata kungu, kata ka jowasigu olworo miechgi madongo, kata ka midekre kata tuo omakogi,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.28",
            "verseOrgIds": [
              "2CH.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "to ka ngʼato kuom jogi ma jo-Israel olemo kata okwayi, ka gingʼeyo gima chando chunygi kod lit ka girieyo bedegi kochomo hekaluni,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.29",
            "verseOrgIds": [
              "2CH.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "to yie iwinji gie polo kama idakie. Wenegi richogi kendo tim ne ngʼato ka ngʼato gima owinjore gi gik motimo nikech ingʼeyo chunygi (nikech in kendi ema ingʼeyo chuny dhano),",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.30",
            "verseOrgIds": [
              "2CH.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "mondo omi gilwori kendo giwuoth e yoreni ndalogi duto ma gin-go e piny mane imiyo kwerewa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.31",
            "verseOrgIds": [
              "2CH.6.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"To kuom jadak ma ok achiel kuom jogi Israel moa e piny mabor nikech nyingi maduongʼ kendo lweti maratego kod badi marabora moriere, ka gibiro ma gilemo ka gichomo hekaluni,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.32",
            "verseOrgIds": [
              "2CH.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "to yie mondo iwinji gie polo kama idakie kendo tim gimoro amora ma jadakno okwayi mondo ogendini duto mag piny ongʼe nyingi kendo oluori mana kaka jogi Israel kendo mondo gingʼe ni ot ma asegeroni luongo nyingi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.33",
            "verseOrgIds": [
              "2CH.6.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ka jogi odhi kedo gi jowasikgi kamoro amora ma ibiro orogie ka gilami kagichomo dalani miseyiero kendo hekalu masegero maluongo nyingi,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.34",
            "verseOrgIds": [
              "2CH.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2CH 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "to yie iwinji gie polo lamogi kod kwayogi kendo konygi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.35",
            "verseOrgIds": [
              "2CH.6.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2CH 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"To ka giketho e nyimi, nimar onge ngʼato kata achiel ma ok jaketho mi ikecho kodgi kendo ichiwogi e lwet wasigu mi giterogi e twech e piny mabor kata machiegni,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.36",
            "verseOrgIds": [
              "2CH.6.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2CH 6:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo ka chunygi olokore e piny mane otergi e twech kendo giweyo richogi kendo gikwayi e piny wasikgi mane otweyogi kagiwacho niya, 'Wasetimo richo kendo waseketho bende wasetimo mamono;'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.37",
            "verseOrgIds": [
              "2CH.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2CH 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "to ka gidwogo iri gi chunygi duto kod ngimagi duto e piny mane otergi e twech, kendo gilemo ka girango pinygi mane imiyo kweregi, kod dala maduongʼ miseyiero kod hekalu ma asegero ni nyingi,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.38",
            "verseOrgIds": [
              "2CH.6.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2CH 6:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "to yie iwinji lemogi gi kwayogi gie polo kar dakni kendo ikonygi. Kendo iwe ni jogi mosetimo richo e nyimi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.39",
            "verseOrgIds": [
              "2CH.6.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "2CH 6:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Koro Nyasacha, yie mondo wengegi oyawre kendo itgi mondo owinj maber lemo ma wachiwo kaeni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.40",
            "verseOrgIds": [
              "2CH.6.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "2CH 6:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaye Jehova Nyasaye, koro chungʼ malo kendo idonj e kar yweyo,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "2CH 6:41"
      },
      "items": [
        {
          "text": "in kaachiel gi Sandug Muma mar singruokni mar tekoni maduongʼ.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1",
        "vid": "2CH 6:41"
      },
      "items": [
        {
          "text": "Yaye Jehova Nyasaye, mad jodolo magi orwakre gi warruok,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "2CH 6:41"
      },
      "items": [
        {
          "text": "mad jogi maler obed gi ilo kuom berni.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "2CH 6:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye Jehova Nyasaye, kik ikwed ngʼatno misewiro.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "2CH 6:42"
      },
      "items": [
        {
          "text": "Par hera maduongʼ mane isingone Daudi jatichni.\"",
          "type": "text"
        }
      ]
    }
  ],
