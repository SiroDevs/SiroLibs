  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "EST 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Modekai okwayo Esta mondo okony jo-Yahudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane Modekai owinjo gigo duto mane osetimore, noyiecho lepe morwako pien gugru mobukore gi buru, kodhi e dala maduongʼ koywak kendo kogoyo nduru matek ka chunye lit.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.1",
            "verseOrgIds": [
              "EST.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "To nodhi mana nyaka e dhoranga ruoth nikech ne ok oyiene ngʼat morwako pien gugru mondo odonji.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.2",
            "verseOrgIds": [
              "EST.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "E piny ka piny mane wach ruoth ochopoe, kuyo nomako jo-Yahudi, ka gitweyo chiemo, ka giywak kendo ka gidengo. Thothgi nonindo e piende gugru ka gibukore gi buru.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.3",
            "verseOrgIds": [
              "EST.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane jotich Esta ma nyiri gi mago machwo mabwoch okelone wach mar Modekai nokuyo ahinya. Noorone lewni mondo orwaki kar rwako pien gugru, to notamore kawogi.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.4",
            "verseOrgIds": [
              "EST.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Esta noluongo Hathak, achiel kuom jotich ruoth mabwoch manoketi mondo otine, noore ir Modekai mondo onone kuom gima chande.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.5",
            "verseOrgIds": [
              "EST.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Hathak nowuok modhi ir Modekai e paw dala maduongʼ mane ni e nyim dhoranga ruoth.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.6",
            "verseOrgIds": [
              "EST.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Modekai nonyise gik moko duto mosetimorene, nonyise koda kar romb pesa ma Haman nosesingore nodhi chulo e kar keno mar joka ruoth mondo otiekgo jo-Yahudi.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.7",
            "verseOrgIds": [
              "EST.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomiye kalatas mondikie weche mag tiekogi ma nondiki e dala mar Susa, mondo onyis Esta kendo olerne weche mondikgo, nowachone ni mondo okwaye mondo odhi e nyim ruoth kendo ohomb ruoth ongʼwon ne ogandane.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.8",
            "verseOrgIds": [
              "EST.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hathak nodok ir Esta monyise weche mane Modekai owacho.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.9",
            "verseOrgIds": [
              "EST.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka nonyiso ngʼatno mondo owach ne Modekai niya,",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.10",
            "verseOrgIds": [
              "EST.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Jotelo duto mag ruoth to gi ji duto moa e gwenge mag pinyruoth, ongʼeyo ni onge ngʼato angʼata madichwo kata ma dhako manyalo donjo ir ruoth e laru maiye ka ok ruoth ema oluonge to oket chik achiel kende ni nyaka nege. Makmana ka ruoth orieyo ludhe mar dhahabu kochomo ngʼatno eka ok nonege. Koro to osekawo ndalo piero adek kapok ruoth oluonga.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.11",
            "verseOrgIds": [
              "EST.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane onyis Modekai weche mane Esta owacho,",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.12",
            "verseOrgIds": [
              "EST.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nodwoko kowacho niya, \"Kik ipar ni in kendi ema inikwo e dhood jo-Yahudi duto nikech in e od ruoth.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.13",
            "verseOrgIds": [
              "EST.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "To nikech ka ilingʼ e kinde ma kama, to jo-Yahudi noyud resruok e yo moro machielo, to in kod jood wuonu notieku. To ngʼama dingʼe ni ne ibiro e od ruoth e sa ma kama mana ni mondo ikonywa?\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.14",
            "verseOrgIds": [
              "EST.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Esta nooro dwoko ne Modekai kama:",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.15",
            "verseOrgIds": [
              "EST.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Dhi ichok jo-Yahudi duto man Susa, mondo utwe chiemo kulemona. Kik uchiem kata metho kuom ndalo adek otieno gi odiechiengʼ. An gi nyiri matiyona bende wabiro tweyo chiemo kendo metho mana kaka un. Ka usetimo kamano, to abiro dhi ir ruoth, kata obedo ni chik ok oyie kamano. Ka ochuno ni nyaka atho, to anatho.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.16",
            "verseOrgIds": [
              "EST.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Modekai nodhi motimo duto mane Esta ochiko mondo otim.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.17",
            "verseOrgIds": [
              "EST.4.17"
            ]
          }
        }
      ]
    }
  ],
