{
  "id": "ACT.8",
  "number": "8",
  "bookId": "ACT",
  "reference": "Tich Joote 8",
  "copyright": "Biblica® Ochiw Thuolo Motingʼo Loko Manyien™ Weg Loko © 1980, 2002, 2003, 2020 otim gi Biblica, Inc. Biblica® Open New Luo Translation™ Copyright © 1980, 2002, 2003, 2020 by Biblica, Inc. \"Biblica\" en sai mondik mongorore e piny Amerika kendo en kido moyie malongʼo e ofis Biblica, Inc. Itiyo kode gi thuolo moa kuom Biblica, Inc. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "ACT 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo mane oyudo ni kanyo noyie gi nek mar Stefano.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.1",
            "verseOrgIds": [
              "ACT.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1",
        "vid": "ACT 8:1"
      },
      "items": [
        {
          "text": "Kanisa oyudo sand",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ACT 8:1"
      },
      "items": [
        {
          "text": "Kochakore chiengʼno kanisa man Jerusalem nochako yudo sand malit kendo giduto negiringo mi gikere e pinje mag Judea gi Samaria, makmana joote kende ema nodongʼ Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.1",
            "verseOrgIds": [
              "ACT.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma oluoro Nyasaye noyiko Stefano kendo ne giywage malit.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.2",
            "verseOrgIds": [
              "ACT.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "E kindeno Saulo nochako sando kanisa kodonjo e ot ka ot kendo omako chwo gi mon moter e od twech.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.3",
            "verseOrgIds": [
              "ACT.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Filipo odhi Samaria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma noke e pinje maokogo noyalo Injili kamoro amora mane gidhiye.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.4",
            "verseOrgIds": [
              "ACT.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filipo nodhi nyaka e dala mar Samaria mi olando Wach Kristo kuno.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.5",
            "verseOrgIds": [
              "ACT.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane oganda owinjo yalo mar Filipo, kendo kane gineno honni mane otimo, negimedo chiko itgi mondo giwinj wechene.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.6",
            "verseOrgIds": [
              "ACT.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jochiende nowuok kuom ji mangʼeny ka giywak malit, kendo jo-athany kod pudhe nochangi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.7",
            "verseOrgIds": [
              "ACT.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo dalano nopongʼ gi mor maduongʼ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.8",
            "verseOrgIds": [
              "ACT.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Simon gi timbene mag jwok",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nitie ngʼat moro miluongo ni Simon. Ngʼatni nosebedo katimo timbe jwok e dala mar Samaria, kendo timbene nomako dho ji duto. Nosungore ni en ngʼama lich,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.9",
            "verseOrgIds": [
              "ACT.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo jo-Samaria duto, jomatindo gi jomadongo, noyie kode. Negiluwo bangʼe ka gikok niya, \"Ngʼatni nigi teko Nyasaye miluongo ni Teko Maduongʼ.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.10",
            "verseOrgIds": [
              "ACT.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji ne luwe nikech kinde mathoth nosemako dho ji gi timbene mag jwok.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.11",
            "verseOrgIds": [
              "ACT.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "To kane Filipo oyalo ne jogo Injili mar pinyruoth Nyasaye, kod nying Yesu Kristo, ne giyie, mi giyudo batiso giduto, chwo gi mon.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.12",
            "verseOrgIds": [
              "ACT.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simon owuon bende noyie, bangʼe noyudo batiso, kendo nosiko koluwo bangʼ Filipo kamoro amora mane odhiye, kowuoro ranyisi madongo kod honni ma noneno ka Filipo timo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.13",
            "verseOrgIds": [
              "ACT.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane joote man Jerusalem owinjo ni jo-Samaria noserwako wach Nyasaye, negioro Petro gi Johana irgi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.14",
            "verseOrgIds": [
              "ACT.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane gichopo, ne gilamonegi mondo giyud Roho Maler,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.15",
            "verseOrgIds": [
              "ACT.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikech Roho Maler ne pok obiro kuom ngʼato angʼata kuomgi, to nosebatisgi mana e nying Ruoth Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.16",
            "verseOrgIds": [
              "ACT.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼe Petro gi Johana noyieyo lwetgi kuomgi mi giyudo Roho Maler.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.17",
            "verseOrgIds": [
              "ACT.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane Simon oneno ni ji ne yudo Roho Maler ka joote oyieyo lwetgi kuomgi, nomiyogi pesa kowacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.18",
            "verseOrgIds": [
              "ACT.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"An bende miyaeuru teko ma un-goni mondo ngʼato angʼata ma ayieyo lweta kuome oyud Roho Maler.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.19",
            "verseOrgIds": [
              "ACT.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Petro nodwoke niya, \"Mad pesagigo lal kodi nono, nikech chunyi wuondi ni inyalo ngʼiewo mich Nyasaye gi pesa!",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.20",
            "verseOrgIds": [
              "ACT.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ionge gi migawo moro amora e tijwani, kendo kwan-ni onge e iye, nikech chunyi ok nikare e nyim Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.21",
            "verseOrgIds": [
              "ACT.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo lokri iwe timni marachni, kendo ilam Ruoth Nyasaye, dipo ka oweyoni richoni kuom bedo gi paro marachno e chunyi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.22",
            "verseOrgIds": [
              "ACT.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech aneno ka chunyi opongʼ gi nyiego mangʼeny, kendo richo oloki misumbane chuth.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.23",
            "verseOrgIds": [
              "ACT.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Simon nodwoko niya, \"Lamna Ruoth Nyasaye mondo gima rach misewacho kuomano kik timrena.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.24",
            "verseOrgIds": [
              "ACT.8.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane gisetimo neno kendo yalo wach Ruoth, Petro gi Johana nodok Jerusalem, ka giyalo Injili e miech Samaria mangʼeny.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.25",
            "verseOrgIds": [
              "ACT.8.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Filipo gi ja-Ethiopia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika mar Ruoth nowacho ni Filipo niya, \"Koro aa malo idhi yo milambo, kiluwo yo mongʼado i thim moa Jerusalem kadhi Gaza.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.26",
            "verseOrgIds": [
              "ACT.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano, Filipo nochako wuoth, to kane oyudo odhi, noromo gi ja-Ethiopia mabwoch, mane en jatelo maduongʼ morito mwandu duto mag Kandake, \"ruoth ma dhako mar jo-Ethiopia.\" Ngʼatni noa lemo Jerusalem,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.27",
            "verseOrgIds": [
              "ACT.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo koro nodok dala, koidho gache kendo kosomo kitap Janabi Isaya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.28",
            "verseOrgIds": [
              "ACT.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Roho Maler nowacho ni Filipo niya, \"Dhiyo mondo ichungʼ machiegni gi gari cha.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.29",
            "verseOrgIds": [
              "ACT.8.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Filipo noringo odhi nyaka but garino mi owinjo ka ngʼatno somo kitap Janabi Isaya. Filipo nopenje niya, \"Bende iwinjo tiend gima isomono?\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.30",
            "verseOrgIds": [
              "ACT.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ja-Ethiopia nodwoko Filipo niya, \"Ere kaka dawinj tiende kaonge ngʼama olerona tiende?\" Omiyo norwako Filipo mondo oidh obed kode ei gari.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.31",
            "verseOrgIds": [
              "ACT.8.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama noyudo ngʼatno somo ndiko kama wacho ni:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.32",
            "verseOrgIds": [
              "ACT.8.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ACT 8:32"
      },
      "items": [
        {
          "text": "\"Notere kar thone mana ka rombo mitero kar yengʼo,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.32",
            "verseOrgIds": [
              "ACT.8.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 8:32"
      },
      "items": [
        {
          "text": "kendo nolingʼ ka nyarombo manie lwet ngʼama ngʼado yiere,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.32",
            "verseOrgIds": [
              "ACT.8.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 8:32"
      },
      "items": [
        {
          "text": "omiyo en bende ne ok otingʼo dhoge.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.32",
            "verseOrgIds": [
              "ACT.8.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne oyale angʼaya kimiye wichkuot.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.33",
            "verseOrgIds": [
              "ACT.8.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 8:33"
      },
      "items": [
        {
          "text": "Bende en gi kothe ma ji noparego?",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.33",
            "verseOrgIds": [
              "ACT.8.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 8:33"
      },
      "items": [
        {
          "text": "Nikech ngimane nogol oko e piny.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.33",
            "verseOrgIds": [
              "ACT.8.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jatelono nopenjo Filipo niya, \"Yie inyisae ni Janabi wuoyo kuom ngʼa e Ndikoni? Owuoyo kuome owuon, koso owuoyo kuom ngʼat machielo?\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.34",
            "verseOrgIds": [
              "ACT.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Filipo nochako gi Ndiko kama ne ja-Ethiopiano somo, mi odhi nyime gi yalone Injili mar Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.35",
            "verseOrgIds": [
              "ACT.8.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane gimedo dhi nyime, negichopo kama pi moro ne nitie. Ja-Ethiopia nowachone Filipo niya, \"Pi eri, angʼo ma dimona yudo batiso?\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.36",
            "verseOrgIds": [
              "ACT.8.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ACT 8:36"
      },
      "items": [
        {
          "text": "[",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.36",
            "verseOrgIds": [
              "ACT.8.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filipo nodwoke niya, \"Inyalo yudo batiso, kiyie gi chunyi duto.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.37",
            "verseOrgIds": [
              "ACT.8.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ACT 8:37"
      },
      "items": [
        {
          "text": "Nodwoke niya, \"Ee, ayie ni Yesu Kristo en Wuod Nyasaye.\"]",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.37",
            "verseOrgIds": [
              "ACT.8.37"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.37",
            "verseOrgIds": [
              "ACT.8.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo nochiwo chik mondo gari ochungʼ. Eka ne gilor gidhi e pi mi Filipo nobatise.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.38",
            "verseOrgIds": [
              "ACT.8.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 8:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "To kane giwuok e pi, Roho Maler mar Ruoth Nyasaye nokawo Filipo apoya, mi ja-Ethiopiano ne ok ochako onene kendo to nodhi e wuodhe kopongʼ gi mor.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.39",
            "verseOrgIds": [
              "ACT.8.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 8:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filipo nopo kochopo e dala mar Azoto, kendo nowuotho koni gi koni, koyalo Injili e mier duto nyaka nochopo Kaisaria.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.40",
            "verseOrgIds": [
              "ACT.8.40"
            ]
          }
        }
      ]
    }
  ],
