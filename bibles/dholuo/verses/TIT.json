{
  "TIT.1": {
    "id": "TIT.1",
    "number": "1",
    "bookId": "TIT",
    "reference": "Tito 1",
    "copyright": "Biblica® Ochiw Thuolo Motingʼo Loko Manyien™ Weg Loko © 1980, 2002, 2003, 2020 otim gi Biblica, Inc. Biblica® Open New Luo Translation™ Copyright © 1980, 2002, 2003, 2020 by Biblica, Inc. \"Biblica\" en sai mondik mongorore e piny Amerika kendo en kido moyie malongʼo e ofis Biblica, Inc. Itiyo kode gi thuolo moa kuom Biblica, Inc. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
    "verseCount": 16,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "1",
          "style": "c",
          "sid": "TIT 1"
        },
        "items": [
          {
            "text": "1",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "TIT 1:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "An Paulo, ma jatich Nyasaye kendo ma jaote Yesu Kristo ema andikonu baruwani. Nyasaye ne oora mondo ajiw yie mar joma Nyasaye oyiero obed motegno, kendo mondo apuonjgi adiera mamiyo giluoro Nyasaye,",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.1",
              "verseOrgIds": [
                "TIT.1.1"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "TIT 1:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "kuom geno yudo ngima mochwere, mane Nyasaye, ma ok riambi osesingore chon ni nomiwa.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.2",
              "verseOrgIds": [
                "TIT.1.2"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "TIT 1:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nyasaye ma Jawarwa ema nohulo wachne malongʼo e ndalo mane en owuon oketo, kendo nogolo chik ni an ema onego miya tich mar lando wachneno.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.3",
              "verseOrgIds": [
                "TIT.1.3"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "TIT 1:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ne Tito, wuoda mar adier kuom yie moriwowa e achiel:",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.4",
              "verseOrgIds": [
                "TIT.1.4"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b",
          "vid": "TIT 1:4"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p",
          "vid": "TIT 1:4"
        },
        "items": [
          {
            "text": "Ngʼwono gi kwe moa kuom Nyasaye Wuoro kod Kristo Yesu ma Jawarwa obed kodi.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.4",
              "verseOrgIds": [
                "TIT.1.4"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Tich momi Tito",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "TIT 1:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "Gima omiyo ne aweyi Krete ne en ni mondo irie gik moko mane odongʼ kapok atieko, kendo mondo iyier jodong kanisa e dala ka dala, kaka ne achiki ni itim.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.5",
              "verseOrgIds": [
                "TIT.1.5"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "TIT 1:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Jaduongʼ kanisa nyaka bed ngʼat ma wach moro amora marach onge kuome, kendo ngʼatno man-gi dhako achiel, ngʼat ma nyithinde oyie kendo ma ok nyal kwan kaka nyithindo maricho kendo ma wigi tek.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.6",
              "verseOrgIds": [
                "TIT.1.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "TIT 1:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nikech jatend kanyakla mar jo-Kristo en ngʼat marito tich Nyasaye, omiyo nyaka obed ngʼat ma wach moro amora marach onge kuome. Kik obed ngʼat mamiyo kanyakla mar joma oyie tingʼ mapek. Bende kik obed ngʼat mochayo ji kata ma ja-mirima, kata ngʼat mamer gi kongʼo, kata ngʼat mohero dhawo, kata ngʼat moyudo mwandu e yor mibadhi.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.7",
              "verseOrgIds": [
                "TIT.1.7"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "TIT 1:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "To nyaka obed ngʼat mohero rwako welo, mohero gigo mabeyo, ngʼat ma terore mos, ma ja-ratiro, moluoro Nyasaye; kendo mawinjo puonj.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.8",
              "verseOrgIds": [
                "TIT.1.8"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "TIT 1:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nyaka omak motegno puonj migeno, mana kaka osepuonje e kinde motelo, mondo eka ojiw joma moko gi puonj madier kendo okwer joma kwedo puonjno.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.9",
              "verseOrgIds": [
                "TIT.1.9"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "TIT 1:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nikech nitie ji mangʼeny ma jongʼanyo, ma gin mana jothor wach kendo jowuond ji, to moloyo jogo moter nyangu ma gin jo-Yahudi moyie.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.10",
              "verseOrgIds": [
                "TIT.1.10"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "TIT 1:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Jogi nyaka kwer mondo olingʼ, nikech giketho mier mangʼeny ka gipuonjo gik ma ok owinjore gipuonji; kendo gitimo kamano mana mondo giyudie ohala ma ok nikare.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.11",
              "verseOrgIds": [
                "TIT.1.11"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "TIT 1:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "Kata mana janabi moro ma margi owuon osewacho niya, \"Jo-Krete riambo kinde duto, gin ondiegi malich ma timbegi richo kendo gin jowuoro ma budho abudha.\"",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.12",
              "verseOrgIds": [
                "TIT.1.12"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "13",
              "style": "v",
              "sid": "TIT 1:13"
            },
            "items": [
              {
                "text": "13",
                "type": "text"
              }
            ]
          },
          {
            "text": "Wach janabigino en adier. Omiyo kwergi matek mondo eka gibed gi yie mar adier,",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.13",
              "verseOrgIds": [
                "TIT.1.13"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "14",
              "style": "v",
              "sid": "TIT 1:14"
            },
            "items": [
              {
                "text": "14",
                "type": "text"
              }
            ]
          },
          {
            "text": "kendo mondo kik gichik itgi ni sigendini mag jo-Yahudi kata ni chike mag joma odagi adiera.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.14",
              "verseOrgIds": [
                "TIT.1.14"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "15",
              "style": "v",
              "sid": "TIT 1:15"
            },
            "items": [
              {
                "text": "15",
                "type": "text"
              }
            ]
          },
          {
            "text": "Gik moko duto ler mana ni jomaler, to kuom joma okethore ma ok oyie to onge gima ler. Chutho, pachgi kaachiel gi chunygi monego onyisgi kethogi osetho.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.15",
              "verseOrgIds": [
                "TIT.1.15"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "16",
              "style": "v",
              "sid": "TIT 1:16"
            },
            "items": [
              {
                "text": "16",
                "type": "text"
              }
            ]
          },
          {
            "text": "Giwacho ni gingʼeyo Nyasaye to gikwedo Nyasaye nogo gi timbegi manono. Gin acheje ma wigi tek kendo ok ginyal timo gimoro amora maber.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.16",
              "verseOrgIds": [
                "TIT.1.16"
              ]
            }
          }
        ]
      }
    ],
    "next": {
      "id": "TIT.2",
      "number": "2",
      "bookId": "TIT"
    },
    "previous": {
      "id": "TIT.intro",
      "number": "intro",
      "bookId": "TIT"
    }
  },
  "TIT.2": {
    "id": "TIT.2",
    "number": "2",
    "bookId": "TIT",
    "reference": "Tito 2",
    "copyright": "Biblica® Ochiw Thuolo Motingʼo Loko Manyien™ Weg Loko © 1980, 2002, 2003, 2020 otim gi Biblica, Inc. Biblica® Open New Luo Translation™ Copyright © 1980, 2002, 2003, 2020 by Biblica, Inc. \"Biblica\" en sai mondik mongorore e piny Amerika kendo en kido moyie malongʼo e ofis Biblica, Inc. Itiyo kode gi thuolo moa kuom Biblica, Inc. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
    "verseCount": 15,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "2",
          "style": "c",
          "sid": "TIT 2"
        },
        "items": [
          {
            "text": "2",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Puonj kuom jo-Kristo",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "TIT 2:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nyaka ipuonj weche mowinjore gi puonj ma adiera.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.1",
              "verseOrgIds": [
                "TIT.2.1"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "TIT 2:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "Puonj jodongo mondo obed joma obidhore, ma ok ohero oyuma, kendo moritore, bende man-gi yie mar adier gihera kod kinda.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.2",
              "verseOrgIds": [
                "TIT.2.2"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "TIT 2:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Kamano bende puonj mon madongo mondo kit ngimagi obed ranyisi maber, ma ok jokuoth, kata joma ohero madho kongʼo, to nyaka gibed gi puonj mabeyo.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.3",
              "verseOrgIds": [
                "TIT.2.3"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "TIT 2:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ka gitimo kamano, to ginyalo puonjo mon matindo kaka onego giher chwogi gi nyithindgi;",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.4",
              "verseOrgIds": [
                "TIT.2.4"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "TIT 2:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "ka giterore mos kendo gidak e ngima maler bende ka girito e utegi. Nyaka gibed mon mangʼwon kendo moluoro chwogi mondo kik ngʼato angʼata yany wach Nyasaye.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.5",
              "verseOrgIds": [
                "TIT.2.5"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "TIT 2:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Kamano bende onego ijiw yawuowi matindo mondo oritre.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.6",
              "verseOrgIds": [
                "TIT.2.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "TIT 2:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Bednegi ranyisi e yore duto kitimo gik mabeyo. Kipuonjo to nyis ni in ngʼama ngimane oriere tir kendo ma ok dwar oyuma,",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.7",
              "verseOrgIds": [
                "TIT.2.7"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "TIT 2:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "wecheni obed weche mowinjore ma ngʼato ok nyal chayo ni gin weche mofuwo mondo joma ok oyie kodi wigi okuodi nikech gionge gimoro amora marach ma ginyalo wacho kuomwa.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.8",
              "verseOrgIds": [
                "TIT.2.8"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "TIT 2:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Puonj wasumbini mondo owinj ruodhi mag-gi e weche duto, kendo gitem timonegi mana gik malongʼo ma ok gidwokore kodgi,",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.9",
              "verseOrgIds": [
                "TIT.2.9"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "TIT 2:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "kata kik gikwal gigegi, to ginyisre ni gin joma inyalo geno e weche duto mondo omi e yore duto gimi puonj mar Nyasaye Jawarwa oywa ji.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.10",
              "verseOrgIds": [
                "TIT.2.10"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "TIT 2:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nikech ngʼwono mar Nyasaye makelo warruok osefwenyore ne ji duto.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.11",
              "verseOrgIds": [
                "TIT.2.11"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "TIT 2:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ngʼwonono puonjowa mondo wakwed timbe maricho kod gombo mochido mag piny, kendo mondo wabed kawaritore e ngima makare mamiyo Nyasaye duongʼ e kindeni,",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.12",
              "verseOrgIds": [
                "TIT.2.12"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "13",
              "style": "v",
              "sid": "TIT 2:13"
            },
            "items": [
              {
                "text": "13",
                "type": "text"
              }
            ]
          },
          {
            "text": "kapod warito geno mogwedhi ma en fwenyruok man-gi duongʼ mar Nyasacha maduongʼ kod Jawarwa, Yesu Kristo,",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.13",
              "verseOrgIds": [
                "TIT.2.13"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "14",
              "style": "v",
              "sid": "TIT 2:14"
            },
            "items": [
              {
                "text": "14",
                "type": "text"
              }
            ]
          },
          {
            "text": "mane ochiworenwa mondo oreswa wawe timbe maricho kendo mondo opwodh ne en owuon joma owinjore bedo joge, moikore timo gik mabeyo.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.14",
              "verseOrgIds": [
                "TIT.2.14"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "15",
              "style": "v",
              "sid": "TIT 2:15"
            },
            "items": [
              {
                "text": "15",
                "type": "text"
              }
            ]
          },
          {
            "text": "Koro magi e gik monego ipuonji. Jiw ji kendo ikwergi gi teko duto. Kik iwene ngʼato thuolo mondo ochayi.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.15",
              "verseOrgIds": [
                "TIT.2.15"
              ]
            }
          }
        ]
      }
    ],
    "next": {
      "id": "TIT.3",
      "number": "3",
      "bookId": "TIT"
    },
    "previous": {
      "id": "TIT.1",
