{
  "id": "MAT.3",
  "number": "3",
  "bookId": "MAT",
  "reference": "Mathayo 3",
  "copyright": "Biblica® Ochiw Thuolo Motingʼo Loko Manyien™ Weg Loko © 1980, 2002, 2003, 2020 otim gi Biblica, Inc. Biblica® Open New Luo Translation™ Copyright © 1980, 2002, 2003, 2020 by Biblica, Inc. \"Biblica\" en sai mondik mongorore e piny Amerika kendo en kido moyie malongʼo e ofis Biblica, Inc. Itiyo kode gi thuolo moa kuom Biblica, Inc. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "MAT 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Johana ja-Batiso oloso yo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "E ndalogo Johana ja-Batiso nobiro, koyalo e thim mar Judea,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.1",
            "verseOrgIds": [
              "MAT.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kowacho niya, \"Weuru richo, nikech pinyruodh polo ni machiegni.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.2",
            "verseOrgIds": [
              "MAT.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma e jalno mane owuo kuome gi dho janabi Isaya niya,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.3",
            "verseOrgIds": [
              "MAT.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 3:3"
      },
      "items": [
        {
          "text": "\"Ngʼat moro kok e thim ni,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.3",
            "verseOrgIds": [
              "MAT.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 3:3"
      },
      "items": [
        {
          "text": "'Losuru yo ne Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.3",
            "verseOrgIds": [
              "MAT.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 3:3"
      },
      "items": [
        {
          "text": "losneuru yore moriere tir.' \"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.3",
            "verseOrgIds": [
              "MAT.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lep Johana nochwe gi yie ngamia, kendo notweyo kamba mar pien e nungone. Chiembe ne gin bonyo gi mor kich mag bungu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.4",
            "verseOrgIds": [
              "MAT.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji nowuok odhi ire koa Jerusalem gi Judea duto koda ka gwengʼ Jordan duto.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.5",
            "verseOrgIds": [
              "MAT.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane gihulo richogi, ne obatisogi e Aora Jordan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.6",
            "verseOrgIds": [
              "MAT.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "To kane oneno jo-Farisai gi jo-Sadukai ka biro kama ne obatisoe ji, nowachonegi niya, \"Un koth thuondegi! En ngʼa mane onyisou mondo uring utony ne mirima mager mabiro?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.7",
            "verseOrgIds": [
              "MAT.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyaguru olemo manyiso ni uselokoru uweyo richo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.8",
            "verseOrgIds": [
              "MAT.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo kik upar e kindu uwegi ni, 'Wan gi Ibrahim kaka wuonwa.' Awachonu ni kata mana kuom kitegi Nyasaye nyalo loko nyithind Ibrahim.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.9",
            "verseOrgIds": [
              "MAT.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Le oseketi e tiend yiende kendo yien ka yien ma ok nyag olemo mabeyo ibiro tongʼ mi go piny kendo witi e mach.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.10",
            "verseOrgIds": [
              "MAT.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"An abatisou gi pi mondo omi ulokru uwe richou. To ngʼato biro bangʼa ma oloya gi duongʼ, ma kata akande ok awinjora tingʼo. En obiro batisou gi Roho Maler kod mach.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.11",
            "verseOrgIds": [
              "MAT.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odheru mare mar piedho cham ni e lwete, kendo obiro yweyo maler kare mar dino cham, kochoko ngano mage okano e dero, to mihudhi to owangʼo gi mach ma ok nyal negi.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.12",
            "verseOrgIds": [
              "MAT.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Batiso mar Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Yesu nobiro koa e piny Galili nyaka e aora Jordan mondo Johana obatise.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.13",
            "verseOrgIds": [
              "MAT.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Johana notemo tame, kawacho niya, \"Ibiro ira nade to an ema adwaro mondo ibatisa?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.14",
            "verseOrgIds": [
              "MAT.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nodwoko niya,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.15",
            "verseOrgIds": [
              "MAT.3.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"We otimre kamano sani; en gima ber ne an kodi mondo watim ma, eka wachop tim makare duto.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.3.15",
                "verseOrgIds": [
                  "MAT.3.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Eka Johana noyie.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.15",
            "verseOrgIds": [
              "MAT.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane osebatiso Yesu to nowuok oa ei pi. To gisano polo noyawore kendo noneno Roho mar Nyasaye kalor e kido mar akuru, kendo piyo kuome.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.16",
            "verseOrgIds": [
              "MAT.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "To dwol moro moa e polo nowacho niya, \"Ma en wuoda, ma ahero, kendo chunya mor kode.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.17",
            "verseOrgIds": [
              "MAT.3.17"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "MAT.4",
    "number": "4",
    "bookId": "MAT"
  },
  "previous": {
    "id": "MAT.2",
