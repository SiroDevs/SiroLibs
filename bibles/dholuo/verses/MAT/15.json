{
  "id": "MAT.15",
  "number": "15",
  "bookId": "MAT",
  "reference": "Mathayo 15",
  "copyright": "Biblica® Ochiw Thuolo Motingʼo Loko Manyien™ Weg Loko © 1980, 2002, 2003, 2020 otim gi Biblica, Inc. Biblica® Open New Luo Translation™ Copyright © 1980, 2002, 2003, 2020 by Biblica, Inc. \"Biblica\" en sai mondik mongorore e piny Amerika kendo en kido moyie malongʼo e ofis Biblica, Inc. Itiyo kode gi thuolo moa kuom Biblica, Inc. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 39,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "MAT 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gik maler kod gik mogak",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka jo-Farisai gi Jopuonj chik moko nobiro ir Yesu koa Jerusalem mi openje niya,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.1",
            "verseOrgIds": [
              "MAT.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Angʼo momiyo jopuonjreni ketho chike gi timbe mag jodongo? Ok giluok lwetgi kapok gichiemo!\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.2",
            "verseOrgIds": [
              "MAT.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nodwokogi niya,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.3",
            "verseOrgIds": [
              "MAT.15.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Angʼo momiyo uketho chik Nyasaye nikech wach chikeu gi timbeu?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.3",
                "verseOrgIds": [
                  "MAT.15.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.3",
            "verseOrgIds": [
              "MAT.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nimar Nyasaye nowacho ni, 'Luor wuonu gi minu'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.4",
                "verseOrgIds": [
                  "MAT.15.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.4",
            "verseOrgIds": [
              "MAT.15.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "kendo ni, 'Ngʼato angʼata mokwongʼo wuon kata min nyaka negi.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.4",
                "verseOrgIds": [
                  "MAT.15.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.4",
            "verseOrgIds": [
              "MAT.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Un to uwacho ni ka ngʼato owacho ne wuon kata ne min ni, 'Kony moro amora ma dine uyudo koa kuoma en mich mowal ne Nyasaye,'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.5",
                "verseOrgIds": [
                  "MAT.15.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.5",
            "verseOrgIds": [
              "MAT.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "to ngʼama kamano koro ogony kuom 'luoro wuon gi min' gi michneno. Kamano umiyo wach Nyasaye bedo maonge teko nikech wach kitu gi timbeu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.6",
                "verseOrgIds": [
                  "MAT.15.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.6",
            "verseOrgIds": [
              "MAT.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Un joma wuondoregi! Isaya ne ni kare kane okoro wach kuomu kama:",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.7",
                "verseOrgIds": [
                  "MAT.15.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\" 'Jogi paka mana gi dhogi kende,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.8",
                "verseOrgIds": [
                  "MAT.15.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 15:8"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "to chunygi bor koda.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.8",
                "verseOrgIds": [
                  "MAT.15.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gilama kayiem nono;",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.9",
                "verseOrgIds": [
                  "MAT.15.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 15:9"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "to gik ma gipuonjo gin mana chike mag dhano.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.9",
                "verseOrgIds": [
                  "MAT.15.9"
                ]
              }
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.9",
                "verseOrgIds": [
                  "MAT.15.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu noluongo oganda ire kendo mowachonegi niya,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.10",
            "verseOrgIds": [
              "MAT.15.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Chikuru itu mondo uwinj tiend wach.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.10",
                "verseOrgIds": [
                  "MAT.15.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.10",
            "verseOrgIds": [
              "MAT.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gima donjo e dho ngʼato ok mi odok mogak, to mana gima wuok koa e dhoge ema miyo odoko mogak.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.11",
                "verseOrgIds": [
                  "MAT.15.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka jopuonjre nobiro ire mopenje niya, \"Bende ingʼeyo ni jo-Farisai ne ochwanyore kane giwinjo wachni?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.12",
            "verseOrgIds": [
              "MAT.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nodwoko niya,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.13",
            "verseOrgIds": [
              "MAT.15.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Yien moro amora ma Wuonwa manie polo ok opidho ibiro pudh oko gi tiendene.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.13",
                "verseOrgIds": [
                  "MAT.15.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.13",
            "verseOrgIds": [
              "MAT.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Wegiuru aweya; gin jotecho ma muofni. Ongʼere ni ka ngʼama muofu otelo ne muofu wadgi to nyaka gilingʼre ei bugo giduto kargi ji ariyogo.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.14",
                "verseOrgIds": [
                  "MAT.15.14"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro nowacho niya, \"Nyiswae tiend ngerono.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.15",
            "verseOrgIds": [
              "MAT.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Yesu nopenjogi niya,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.16",
            "verseOrgIds": [
              "MAT.15.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kare un bende wach pod ok donjnu?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.16",
                "verseOrgIds": [
                  "MAT.15.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.16",
            "verseOrgIds": [
              "MAT.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Donge ungʼeyo ni gimoro amora madonjo e dhok dhi nyaka e ich bangʼe owuok oko mar del?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.17",
                "verseOrgIds": [
                  "MAT.15.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.17",
            "verseOrgIds": [
              "MAT.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To gik mawuok e dhok aa e chuny, kendo gin ema gimiyo ngʼato doko 'mogak.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.18",
                "verseOrgIds": [
                  "MAT.15.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.18",
            "verseOrgIds": [
              "MAT.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nikech chuny ema gik maricho kaka; paro maricho, nek, terruok, chode, kuo, hango wach, gi ketho nying ji wuokie.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.19",
                "verseOrgIds": [
                  "MAT.15.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.19",
            "verseOrgIds": [
              "MAT.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Magi e gik mamiyo ngʼato bedo 'mogak.' To chiemo gi lwedo ma ok olwoki ok mi odok 'mogak.' \"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.20",
                "verseOrgIds": [
                  "MAT.15.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yie mar chi Kanaan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka noa kanyo, Yesu nodhi nyaka e gwengʼ mar Turo gi Sidon.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.21",
            "verseOrgIds": [
              "MAT.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chi Kanaan moro mane odak machiegni gi kanyo nobiro ire kaywagore niya, \"Ruoth, Wuod Daudi, kecha! Nyara nigi jachien marach kendo osandore malit.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.22",
            "verseOrgIds": [
              "MAT.15.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Yesu ne ok odwoke kata wach achiel. Omiyo jopuonjre nobiro ire mojiwe niya, \"Riembe odhi, nikech osiko kogoyo koko bangʼwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.23",
            "verseOrgIds": [
              "MAT.15.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nodwoko niya,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.24",
            "verseOrgIds": [
              "MAT.15.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ne oora mana ne rombe molal mag Israel kende.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.24",
                "verseOrgIds": [
                  "MAT.15.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "To dhakono nobiro mogoyo chonge piny e nyime, kawacho niya, \"Ruoth, yie ikonya.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.25",
            "verseOrgIds": [
              "MAT.15.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "To nodwoko niya,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.26",
            "verseOrgIds": [
              "MAT.15.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ok en gima kare kawo chiemb nyithindo mondo idir ne guogi.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.26",
                "verseOrgIds": [
                  "MAT.15.26"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhakono nodwoke niya, \"Mano en adier Ruoth, to kata guogi bende chamo ngʼinjo molwar piny koa e mesa mar ruodhgi.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.27",
            "verseOrgIds": [
              "MAT.15.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Yesu nodwoko niya,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.28",
            "verseOrgIds": [
              "MAT.15.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Dhako, in gi yie maduongʼ ndi! Kwayoni osechopi.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.28",
                "verseOrgIds": [
                  "MAT.15.28"
                ]
              }
            }
          ]
        },
        {
          "text": "Kendo nyare nochango kochakore sano.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.28",
            "verseOrgIds": [
              "MAT.15.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu omiyo ji alufu angʼwen chiemo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu noa kanyo koluwo tie Nam Galili. Eka noidho malo mobet piny e bath got.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.29",
            "verseOrgIds": [
              "MAT.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oganda maduongʼ nobiro ire, kendo negikelone rongʼonde, muofni, pudhe, momni gi ji matuo mamoko mangʼeny, mine giketogi e tiende kendo nochangogi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.30",
            "verseOrgIds": [
              "MAT.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji nohum kane gineno ka momni wuoyo, pudhe ngima, rongʼonde wuotho, kendo muofni neno, kendo negipako Nyasach Israel.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.31",
            "verseOrgIds": [
              "MAT.15.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu noluongo jopuonjrene ire mowachonegi niya,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.32",
            "verseOrgIds": [
              "MAT.15.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Akecho jogi nikech koro gisebedo koda kae kuom ndalo adek to gionge gi gima digicham. Ok adwar mondo gidhi ka gidenyo, nono to kech nyalo goyogi piny e yo.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.32",
                "verseOrgIds": [
                  "MAT.15.32"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jopuonjrene nodwoke niya, \"Ere kuma dwayudie makati e dier thim manyalo pidho oganda maduongʼ machal kama?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.33",
            "verseOrgIds": [
              "MAT.15.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nopenjogi niya,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.34",
            "verseOrgIds": [
              "MAT.15.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Un gi makati adi?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.15.34",
                "verseOrgIds": [
                  "MAT.15.34"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 15:34"
      },
      "items": [
        {
          "text": "Negidwoke niya, \"Abiriyo kende gi rech matindo manok.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.34",
            "verseOrgIds": [
              "MAT.15.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nowachone ogandago mondo obed piny e lum.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.35",
            "verseOrgIds": [
              "MAT.15.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ mano nokawo makati abiriyogo gi rechgo, kendo kane osegoyo erokamano, nongʼingogi bangʼe omiyogi jopuonjrene, mondo opog ji.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.36",
            "verseOrgIds": [
              "MAT.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negichiemo giduto mi giyiengʼ. Bangʼ chiemo jopuonjre nochoko ngʼinjo mag chiemo mane ji ochamo oweyo moromo okepe abiriyo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.37",
            "verseOrgIds": [
              "MAT.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kar romb joma nochiemo duto ne gin alufu angʼwen, ka ok okwan mon gi nyithindo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.38",
            "verseOrgIds": [
              "MAT.15.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ ka Yesu nosegonyo oganda odhi, nodonjo e yie mi odhi e gwengʼ mar Magadan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.39",
            "verseOrgIds": [
              "MAT.15.39"
            ]
          }
        }
      ]
    }
  ],
