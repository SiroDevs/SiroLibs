        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Awachonu adier ni nitie jomoko mochungʼ buta ka ma ok nokal e tho kapok gineno Wuod Dhano kabiro gi pinyruodhe.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.28",
                "verseOrgIds": [
