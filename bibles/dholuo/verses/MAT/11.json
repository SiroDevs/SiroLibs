  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "MAT 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu gi Johana ja-Batiso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ ka Yesu nosetieko tiego jopuonjrene apar gariyo, nodhi nyime koa kanyo mondo opuonj kendo oyal e mier mag Galili.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.1",
            "verseOrgIds": [
              "MAT.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane Johana owinjo ka en od twech gik ma Kristo ne timo, nooro jopuonjrene",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.2",
            "verseOrgIds": [
              "MAT.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mondo openje niya, \"In e jalno mane onego obi, koso warit ngʼat machielo?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.3",
            "verseOrgIds": [
              "MAT.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nodwokogi niya,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.4",
            "verseOrgIds": [
              "MAT.11.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Doguru mondo udwok wach ne Johana gik muwinjo kendo uneno:",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.4",
                "verseOrgIds": [
                  "MAT.11.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.4",
            "verseOrgIds": [
              "MAT.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Muofni neno, rongʼonde wuotho, jogo man-gi dhoho ichango, joma itgi odinore winjo wach, joma otho ichiero, kendo Injili iyalo ne joma odhier.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.5",
                "verseOrgIds": [
                  "MAT.11.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.5",
            "verseOrgIds": [
              "MAT.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "En ngʼat mogwedhi jal ma ok chwanyre mabar nikech an.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.6",
                "verseOrgIds": [
                  "MAT.11.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane oyudo jopuonjre Johana wuok mondo odogi, Yesu nochako wuoyo gi oganda kuom Johana kowacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.7",
            "verseOrgIds": [
              "MAT.11.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Angʼo mane udhi mondo une e thim? Ne udhi neno odundu ma yamo tero koso?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.7",
                "verseOrgIds": [
                  "MAT.11.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.7",
            "verseOrgIds": [
              "MAT.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ka ok mano to en angʼo mane udhi mondo une? Ne udhi neno ngʼat morwakore gi lewni mabeyo koso? Ooyo, jogo marwakore gi lewni mabeyo iyudo mana e ute ruodhi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.8",
                "verseOrgIds": [
                  "MAT.11.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.8",
            "verseOrgIds": [
              "MAT.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To kara nudhi mondo une angʼo? Janabi? Ee, awachonu ni ne udhi neno ngʼat moloyo janabi gi duongʼ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.9",
                "verseOrgIds": [
                  "MAT.11.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.9",
            "verseOrgIds": [
              "MAT.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma e jal mane ondik kuome niya,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.10",
                "verseOrgIds": [
                  "MAT.11.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 11:10"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\" 'Abiro oro jaotena mondo otel e nyimi,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.10",
                "verseOrgIds": [
                  "MAT.11.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 11:10"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "obiro losoni yori kapok ibiro.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.10",
                "verseOrgIds": [
                  "MAT.11.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Awachonu adier kama: Kuom jogo duto mamon onywolo, onge ngʼama osewuok e dier ji maduongʼ moloyo Johana ja-Batiso; kata kamano ngʼatno matinie moloyo e pinyruodh polo duongʼ moloye.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.11",
                "verseOrgIds": [
                  "MAT.11.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.11",
            "verseOrgIds": [
              "MAT.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Chakre ndalo mag Johana ja-Batiso nyaka sani, pinyruodh polo osebedo ka idonje githuon, kendo joma thuondi ema kawe.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.12",
                "verseOrgIds": [
                  "MAT.11.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.12",
            "verseOrgIds": [
              "MAT.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nimar ndiko mag jonabi gi mag chik nokoro nyaka ndalo Johana.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.13",
                "verseOrgIds": [
                  "MAT.11.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.13",
            "verseOrgIds": [
              "MAT.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kendo kaponi uhero mar rwako wachni to ngʼeuru ni en e Elija mane onego obi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.14",
                "verseOrgIds": [
                  "MAT.11.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.14",
            "verseOrgIds": [
              "MAT.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ngʼat man-gi ite mondo owinji.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.15",
                "verseOrgIds": [
                  "MAT.11.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"En angʼo ma dapimgo tiengʼni? Gichalo nyithindo mobet e chirni kendo maluongo jowetegi kagiwacho niya,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.16",
                "verseOrgIds": [
                  "MAT.11.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ne wagoyonu asili,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.17",
                "verseOrgIds": [
                  "MAT.11.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 11:17"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "to ne ok umiel;",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.17",
                "verseOrgIds": [
                  "MAT.11.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 11:17"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "bende ne wadengo ka wawero wend tho,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.17",
                "verseOrgIds": [
                  "MAT.11.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 11:17"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "to ne ok uywak.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.17",
                "verseOrgIds": [
                  "MAT.11.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nimar Johana Ja-Batiso nobiro ka ok ochiem kata metho, to giwacho ni, 'En gi jachien.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.18",
                "verseOrgIds": [
                  "MAT.11.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.18",
            "verseOrgIds": [
              "MAT.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Wuod Dhano nobiro ka chiemo kendo metho, to uwacho ni, 'Neyeuru jawuoro kendo jamer mosiep josol osuru gi joricho.' To rieko ifwenyo adimba kuom timbene.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.19",
                "verseOrgIds": [
                  "MAT.11.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Malit ma mier madongo modagi lokore biro neno",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Yesu nochako kwedo mier mane thoth honnige osetimoree, nikech negitamore weyo richo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.20",
            "verseOrgIds": [
              "MAT.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mano kaka unune malit un jo-Korazin! Mano kaka unune malit, un jo-Bethsaida! Nimar ka dine honni motimnugi dinetim ne Turo gi Sidon to dine giseweyo richo chon ka girwakore gi lep gugru kendo ka gibukore gi buru.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.21",
                "verseOrgIds": [
                  "MAT.11.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.21",
            "verseOrgIds": [
              "MAT.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To awachonu ni chiengʼ ngʼado bura weche nobed maberber ne Turo gi Sidon moloyou.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.22",
                "verseOrgIds": [
                  "MAT.11.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.22",
            "verseOrgIds": [
              "MAT.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To in Kapernaum, bende ibiro tingʼori malo nyaka polo koso? Ooyo, ibiro lwar piny nyaka piny joma otho. Ka dine bed ni honni mane otim e iyi ne otim ei Sodom to dikoro pod entie nyaka kawuono.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.23",
                "verseOrgIds": [
                  "MAT.11.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.23",
            "verseOrgIds": [
              "MAT.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To awachonu ni chiengʼ ngʼado bura weche nobed maberber ne Sodom moloyou.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.24",
                "verseOrgIds": [
                  "MAT.11.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yweyo ne joma ojony",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "E sechego Yesu nowacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.25",
            "verseOrgIds": [
              "MAT.11.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Apakoi Wuonwa, Ruodh polo gi piny, nikech isepando gigi ne joma riek gi joma osomo, to isefwenyogi ne nyithindo matindo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.25",
                "verseOrgIds": [
                  "MAT.11.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.25",
            "verseOrgIds": [
              "MAT.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ee Wuora, nimar mano ema ne berni kotimore.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.26",
                "verseOrgIds": [
                  "MAT.11.26"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Wuonwa oseketo gik moko duto e lweta. To onge ngʼama ongʼeyo Wuowi makmana Wuoro kende, bende onge ngʼama ongʼeyo Wuoro makmana Wuowi kaachiel gi joma Wuowi oyiero mondo ofwenynegi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.27",
                "verseOrgIds": [
                  "MAT.11.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Biuru ira, un duto mujony kendo motingʼore mapek, mondo amiu yweyo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.28",
                "verseOrgIds": [
                  "MAT.11.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.28",
            "verseOrgIds": [
              "MAT.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kawuru lodina mondo utingʼ kendo puonjreuru kuoma, nimar chunya muol kendo ahora mos, eka unuyud yweyo ne chunyu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.29",
                "verseOrgIds": [
                  "MAT.11.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.29",
            "verseOrgIds": [
              "MAT.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nimar lodina ok pek kendo misika yot.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.30",
                "verseOrgIds": [
                  "MAT.11.30"
                ]
              }
            }
          ]
