  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "MAT 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngʼama duongʼ moloyo e Pinyruodh Polo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "E kindeno jopuonjre nobiro ir Yesu mopenje niya, \"En ngʼa maduongʼ moloyo e pinyruodh polo?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.1",
            "verseOrgIds": [
              "MAT.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "To noluongo nyathi moro matin mi okete ochungʼ e diergi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.2",
            "verseOrgIds": [
              "MAT.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka nowacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.3",
            "verseOrgIds": [
              "MAT.18.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Awachonu adier ni ka ok ulokoru ma uchalo gi nyithindo matindo, to ok ubi donjo e pinyruodh polo ngangʼ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.3",
                "verseOrgIds": [
                  "MAT.18.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.3",
            "verseOrgIds": [
              "MAT.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Emomiyo ngʼato angʼata mobolore kaka nyathini e ngʼat maduongʼ moloyo e pinyruodh polo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.4",
                "verseOrgIds": [
                  "MAT.18.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.4",
            "verseOrgIds": [
              "MAT.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kendo ngʼato angʼata morwako nyathi machal kama e nyinga to an ema orwaka.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.5",
                "verseOrgIds": [
                  "MAT.18.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Miyo ngʼato podho",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"To ka ngʼato omiyo achiel kuom jomatindo moyie kuomagi odonjo e richo to dibed maber ka otwene pongʼ marangʼongo e ngʼute bangʼe onyumego e chuny nam.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.6",
                "verseOrgIds": [
                  "MAT.18.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Piny none malit nikech gik mamiyo ji donjo e richo! Ochuno ni gik makamagi nyaka bedie, to okwongʼ ngʼatno makelo gigo!",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.7",
                "verseOrgIds": [
                  "MAT.18.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.7",
            "verseOrgIds": [
              "MAT.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ka lweti kata tiendi miyo idonjo e richo to ngʼade oko kendo iwite mabor. Ber moloyo kidonjo e ngima ka ionge lweti kata kingʼol moloyo bedo gi lwetegi ariyo kata tiendeni ariyo to owiti e mach manyaka chiengʼ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.8",
                "verseOrgIds": [
                  "MAT.18.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.8",
            "verseOrgIds": [
              "MAT.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kamano bende ka wangʼi miyo itimo richo to lodhe oko kendo iwite mabor. Ber moloyo kidonjo e ngima gi wangʼ achiel kar bedo gi wenge ariyo to owiti e mach mar Gehena.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.9",
                "verseOrgIds": [
                  "MAT.18.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngech rombo molal",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Neuru ni ok uchayo achiel kuom jomatindogi. Nimar anyisou ni malaikegi manie polo osiko ka ngʼiyo wangʼ Wuora manie polo. [",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.10",
                "verseOrgIds": [
                  "MAT.18.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.10",
            "verseOrgIds": [
              "MAT.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nikech Wuod Dhano osebiro mondo owar joma olal.]",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.11",
                "verseOrgIds": [
                  "MAT.18.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Uparo nade? Ka ngʼato nigi rombe mia achiel, to achiel kuomgi olal, donge ngʼatno diwe piero ochiko gochikogo mi odhi omany achiel molalno?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.12",
                "verseOrgIds": [
                  "MAT.18.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.12",
            "verseOrgIds": [
              "MAT.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To awachonu adier ni ka oyude to obedo mamor kuom rombo achielno, moloyo kuom piero ochiko gochiko mane ok olal.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.13",
                "verseOrgIds": [
                  "MAT.18.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.13",
            "verseOrgIds": [
              "MAT.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Machalre gi mano, wuonu manie polo ok dwar ni kata achiel kuom jomatindogi olal.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.14",
                "verseOrgIds": [
                  "MAT.18.14"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Owadu mokethoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ka owadu ochwanyi to dhi kendo inyise kethone, mana e kindu kode ji ariyo. Ka ochikoni ite mowinjo to mano iseloso kindi gi owaduno.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.15",
                "verseOrgIds": [
                  "MAT.18.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.15",
            "verseOrgIds": [
              "MAT.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To ka otamore winji to kaw ngʼato achiel kata ji ariyo idhi iwuogo kode, mondo, wach moro mantie e kind ji nyaka ngʼere malongʼo ka nitiere joneno ariyo kata adek.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.16",
                "verseOrgIds": [
                  "MAT.18.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.16",
            "verseOrgIds": [
              "MAT.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kodagi winjogi, to nyis kanisa wachno; to kodagi winjo nyaka kanisa, to kawe kaka dikaw ngʼat ma japiny kata jasol osuru.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.17",
                "verseOrgIds": [
                  "MAT.18.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Awachonu adier ni gimoro amora mutweyo e piny-ka notwe e polo bende, kendo gimoro amora mugonyo e piny-ka nogony e polo bende.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.18",
                "verseOrgIds": [
                  "MAT.18.18"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Awachonu bende ni ka ji ariyo kuomu e piny-ka owinjore kuom gimoro amora mukwayo to Wuora manie polo notimnugo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.19",
                "verseOrgIds": [
                  "MAT.18.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.19",
            "verseOrgIds": [
              "MAT.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nimar kama ji ariyo kata adek ochokoree e nyinga to an kodgi kanyo.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.20",
                "verseOrgIds": [
                  "MAT.18.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngech jatich maonge kech",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Petro nobiro ir Yesu mopenje niya, \"Ruoth, owinjore awe ne owadwa ndalo adi kokethona? Nyaka ndalo abiriyo koso?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.21",
            "verseOrgIds": [
              "MAT.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nodwoke niya,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.22",
            "verseOrgIds": [
              "MAT.18.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Awachoni ni ok nyadibiriyo to nyadi piero abiriyo nyadibiriyo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.22",
                "verseOrgIds": [
                  "MAT.18.22"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mano emomiyo pinyruodh polo chal gi ruoth mane dwaro nono kaka jotichne osetiyo gi pesane.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.23",
                "verseOrgIds": [
                  "MAT.18.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.23",
            "verseOrgIds": [
              "MAT.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kane ochako timo nonrono, ngʼat moro mane nigi gope moromo silingʼ tara gi tara ne okel e nyime.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.24",
                "verseOrgIds": [
                  "MAT.18.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.24",
            "verseOrgIds": [
              "MAT.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To kaka ne ok onyal chulo gopeno, ruodhe nogolo chik mondo en kaachiel gi chiege gi nyithinde, kod gik moko duto mane en-go ousi mondo ochul gowino.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.25",
                "verseOrgIds": [
                  "MAT.18.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"To jatijno nogoyo chonge piny e nyime, moywagorene ni, 'Yie ihorina mos, abiro chuli gopino duto.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.26",
                "verseOrgIds": [
                  "MAT.18.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.26",
            "verseOrgIds": [
              "MAT.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ruodh jatijno nokeche mi owene gopeno kendo ogonye odhi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.27",
                "verseOrgIds": [
                  "MAT.18.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"To bangʼ ka jatijno nosedhi, noyudo achiel kuom jotich wetene mane nigi gope moromo dinari mia achiel. Nomake matek mochako deye, kowachone ni, 'Chula gopa ma in-go sani!'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.28",
                "verseOrgIds": [
                  "MAT.18.28"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Jatich wadgino nogoyo chonge piny e nyime moywagorene ni, 'Yie itimna ngʼwono, abiro chuli gopi.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.29",
                "verseOrgIds": [
                  "MAT.18.29"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"To nodagi. Kar timo kamano to noa kanyo mi oloso wach mondo orwak ngʼatno e od twech nyaka chop ochul gowino.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.30",
                "verseOrgIds": [
                  "MAT.18.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.30",
            "verseOrgIds": [
              "MAT.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kane jotich mamoko oneno gima notimoreno, chunygi nodoko malit ahinya kendo negidhi mi ginyiso ruodhgi gik moko duto mane osetimore.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.31",
                "verseOrgIds": [
                  "MAT.18.31"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Eka ruodhno noluongo jatichneno ire, mowachone ni, 'An ne aweni gopa mane in-go duto nikech ne iywagorina mondo atim kamano.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.32",
                "verseOrgIds": [
                  "MAT.18.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.32",
            "verseOrgIds": [
              "MAT.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Angʼo momiyo in to ne itamori kecho jatich wadu kaka an bende ne akonyi?'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.33",
                "verseOrgIds": [
                  "MAT.18.33"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.33",
            "verseOrgIds": [
              "MAT.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ruodhe ne mirima omako kode mi nochiwe e lwet jo-jela mondo orodhe maonge kech, nyaka chop ochul gowi duto mane en-go.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.34",
                "verseOrgIds": [
                  "MAT.18.34"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kamano e kaka Wuora manie polo biro timo ne ngʼato ka ngʼato ka ok oweyo ne nyawadgi gie chunye.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.35",
                "verseOrgIds": [
                  "MAT.18.35"
                ]
              }
            }
          ]
        }
      ]
    }
