  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "MAT 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chiwone joma ochando",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Beduru motangʼ mondo kik utim timbeu makare e nyim ji, mondo eka gineu. Kutimo kamano to ok ubi yudo pok moa kuom Wuonu manie polo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.1",
                "verseOrgIds": [
                  "MAT.6.1"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kuom mano kuchiwo kony ne joma ochando to kik uland gima utimo gi turumbete, kaka joma wuondore timo ei sinagoke kendo e yore manie kind mier, mondo ji omigi luor. Awachonu adier ni giseyudo pokgi duto.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.2",
                "verseOrgIds": [
                  "MAT.6.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.2",
            "verseOrgIds": [
              "MAT.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To kichiwo kony ne joma ochando to kik iyie lweti ma koracham ongʼe gima lweti ma korachwich timo,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.3",
                "verseOrgIds": [
                  "MAT.6.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.3",
            "verseOrgIds": [
              "MAT.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "mondo chiwo mari obed malingʼ-lingʼ. Eka Wuonu maneno gima ochiw lingʼ-lingʼ nomiyi pokni.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.4",
                "verseOrgIds": [
                  "MAT.6.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lamo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Bende ka ulamo, to kik uchal gi joma wuondore, nimar gihero lamo ka gichungʼ ei sinagoke, kendo e akek yore mondo ji onegi. Awachonu adier ni giseyudo pokgi duto.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.5",
                "verseOrgIds": [
                  "MAT.6.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.5",
            "verseOrgIds": [
              "MAT.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To kilamo to donji e odi maiye, ilor dhoot eka ilam Wuonu ma ok ne. Eka Wuonu maneno gima otim lingʼ-lingʼ nomiyi pokni.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.6",
                "verseOrgIds": [
                  "MAT.6.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.6",
            "verseOrgIds": [
              "MAT.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To kulamo to kik usik kunuoyo weche kayiem kaka jopiny, nimar giparo ni ibiro winjgi nikech wechegi mathoth.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.7",
                "verseOrgIds": [
                  "MAT.6.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.7",
            "verseOrgIds": [
              "MAT.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kik uchal kodgi, nikech Wuonu ongʼeyo gik muchando kata kapok ukwaye.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.8",
                "verseOrgIds": [
                  "MAT.6.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Koro kama e kaka onego ulam:",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.9",
                "verseOrgIds": [
                  "MAT.6.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 6:9"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\" 'Wuonwa manie polo,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.9",
                "verseOrgIds": [
                  "MAT.6.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 6:9"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "nyingi mondo omi duongʼ,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.9",
                "verseOrgIds": [
                  "MAT.6.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pinyruoth mari obi,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.10",
                "verseOrgIds": [
                  "MAT.6.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 6:10"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "dwaroni mondo otimre",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.10",
                "verseOrgIds": [
                  "MAT.6.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 6:10"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "e piny kaka timore e polo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.10",
                "verseOrgIds": [
                  "MAT.6.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Miwa kawuono chiembwa mapile pile.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.11",
                "verseOrgIds": [
                  "MAT.6.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Wenwa richowa,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.12",
                "verseOrgIds": [
                  "MAT.6.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 6:12"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "kaka wan bende waweyone joma timonwa marach.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.12",
                "verseOrgIds": [
                  "MAT.6.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bende kik iwe wadonj e tem,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.13",
                "verseOrgIds": [
                  "MAT.6.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 6:13"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "to reswa e lwet ngʼat marach.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.13",
                "verseOrgIds": [
                  "MAT.6.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nimar ka uweyo ne ji ka gikethonu, eka Wuonu manie polo biro weyonu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.14",
                "verseOrgIds": [
                  "MAT.6.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.14",
            "verseOrgIds": [
              "MAT.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To ka ok uwe ni ji richogi to wuonu manie polo ok bi weyonu richou.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.15",
                "verseOrgIds": [
                  "MAT.6.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tweyo chiemo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ka utweyo chiemo to kik unen malich kaka joma wuondore timo, nimar gimieno wengegi mondo ginyis ni gitweyo chiemo. Awachonu adier ni giseyudo pokgi duto.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.16",
                "verseOrgIds": [
                  "MAT.6.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.16",
            "verseOrgIds": [
              "MAT.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To in, kitweyo chiemo to ol mo e wiyi kendo luok wangʼi,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.17",
                "verseOrgIds": [
                  "MAT.6.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.17",
            "verseOrgIds": [
              "MAT.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "mondo kik obed gima ongʼere ne ji ni itweyo chiemo, to Wuonu ma ok ne kende ema ongʼe. Eka Wuonu maneno gima otim lingʼ-lingʼ nomiyi pokni.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.18",
                "verseOrgIds": [
                  "MAT.6.18"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwandu manie polo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kik ukan mwandu ne un uwegi e piny kama olwenda gi nyal kethoe gik moko, kendo kama jokwoge turoe kendo kweloe.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.19",
                "verseOrgIds": [
                  "MAT.6.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.19",
            "verseOrgIds": [
              "MAT.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To kanuru mwandu magu e polo kama olwenda kata nyal ok kethie gik moko kendo jokuo ok turie ma kwelie,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.20",
                "verseOrgIds": [
                  "MAT.6.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.20",
            "verseOrgIds": [
              "MAT.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nimar kama mwanduni nitie e kama chunyi bende nobedie.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.21",
                "verseOrgIds": [
                  "MAT.6.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Wangʼ e taya mar ringri. Ka wengeni neno maber to ringri duto opongʼ gi ler.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.22",
                "verseOrgIds": [
                  "MAT.6.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.22",
            "verseOrgIds": [
              "MAT.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To ka wengeni richo to ringri duto biro pongʼ gi mudho. Omiyo ka ler manie iyi en mudho, to mano kaka en mudho maduongʼ miwuoro!",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.23",
                "verseOrgIds": [
                  "MAT.6.23"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Onge jatich manyalo tiyo ne ruodhi ariyo. Nimar obiro chayo achiel to ohero machielo, kata obiro chiwore ne achiel to ochayo machielo. Ok inyal tiyo ne Nyasaye kendo ne pesa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.24",
                "verseOrgIds": [
                  "MAT.6.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kik uluor",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Emomiyo awachonu ni, kik uparru kuom ngimau, kata kuom gik ma ubiro chamo kata madho; kata kuom dendu kata gik ma ubiro rwako. Donge ngima duongʼ moloyo chiemo, koso del donge duongʼ moloyo lewni?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.25",
                "verseOrgIds": [
                  "MAT.6.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.25",
            "verseOrgIds": [
              "MAT.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ranguru ane winy ma huyo e kor polo. Ok chwo cham to bende ok gikee kata giken e dere, to eka Wuonu manie polo pod pidhogi apidha. To un donge un gi nengo mamalo moloyogi?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.26",
                "verseOrgIds": [
                  "MAT.6.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.26",
            "verseOrgIds": [
              "MAT.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "En ngʼa kuomu ma parruok moparorego nyalo miyo omed bedo mangima kata mana kuom sa achiel kende?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.27",
                "verseOrgIds": [
                  "MAT.6.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Koso uparoru ne wach lewni nangʼo? Neyeuru kaka ondanyo mag pap dongo. Ok ginyagre gi tich kata gi chwecho.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.28",
                "verseOrgIds": [
                  "MAT.6.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.28",
            "verseOrgIds": [
              "MAT.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To kata kamano awachonu ni kata mana Solomon e rwakruokne malich duto ne ok orwakore ka achiel kuomgi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.29",
                "verseOrgIds": [
                  "MAT.6.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.29",
            "verseOrgIds": [
              "MAT.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ka kamano e kaka Nyasaye rwako lum aluma manie pap, ma kawuono nitie to kiny iwite e mach, donge obiro rwakou maber moloyo, yaye un joma yiegi tin-gi?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.30",
                "verseOrgIds": [
                  "MAT.6.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.30",
            "verseOrgIds": [
              "MAT.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Omiyo kik uparru kuwacho ni, 'Wabiro chamo angʼo?' Kata ni, 'Wabiro madho angʼo?' Kata ni, 'Wabiro rwako angʼo?'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.31",
                "verseOrgIds": [
                  "MAT.6.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.31",
            "verseOrgIds": [
              "MAT.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nimar jopiny ema chandore ka dwaro gigi duto; to bende Wuonu manie polo ongʼeyo ni udwaro gigi duto.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.32",
                "verseOrgIds": [
                  "MAT.6.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.32",
            "verseOrgIds": [
              "MAT.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To mokwongo, dwaruru pinyruoth Nyasaye kod timne makare eka gigi duto bende nomiu kaachiel gi mago.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.33",
                "verseOrgIds": [
                  "MAT.6.33"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.33",
            "verseOrgIds": [
              "MAT.6.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kuom mano, kik uparru kuom kiny, nikech kiny noparre kuome owuon. Odiechiengʼ kodiechiengʼ nigi chandruokne morome.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.34",
                "verseOrgIds": [
                  "MAT.6.34"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
