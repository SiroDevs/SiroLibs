      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:11"
      },
      "items": [
        {
          "text": "e kaka ngʼatno mayudo mwandu gi yore ma ok kare.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.11",
            "verseOrgIds": [
              "JER.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:11"
      },
      "items": [
        {
          "text": "Ka nus ngimane oserumo, mwandune noweye,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.11",
            "verseOrgIds": [
              "JER.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:11"
      },
      "items": [
        {
          "text": "kendo gikone nonere malongʼo ni en ngʼama ofuwo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.11",
            "verseOrgIds": [
              "JER.17.11"
            ]
          }
        }
      ]
    },
    {
