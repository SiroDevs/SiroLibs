          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaka winyo ma butno e tongʼ mane ok onywolo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.11",
            "verseOrgIds": [
              "JER.17.11"
            ]
