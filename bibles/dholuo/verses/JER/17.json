          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Changa, yaye Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.14",
            "verseOrgIds": [
              "JER.17.14"
            ]
          }
        }
