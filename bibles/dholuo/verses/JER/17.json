          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kom duongʼ, motingʼ malo aa chakruok,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.12",
            "verseOrgIds": [
              "JER.17.12"
            ]
          }
        }
