      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:14"
      },
      "items": [
        {
          "text": "kendo anachangi;",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.14",
            "verseOrgIds": [
              "JER.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:14"
      },
      "items": [
        {
          "text": "resa kendo anaresra,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.14",
            "verseOrgIds": [
              "JER.17.14"
            ]
          }
        }
      ]
    },
    {
