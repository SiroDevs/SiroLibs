      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:12"
      },
      "items": [
        {
          "text": "e kama ler mar lemo marwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.12",
            "verseOrgIds": [
              "JER.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye Jehova Nyasaye, geno mar Israel,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.13",
            "verseOrgIds": [
              "JER.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:13"
      },
      "items": [
        {
          "text": "jogo duto mojwangʼi noyud wichkuot.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.13",
            "verseOrgIds": [
              "JER.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:13"
      },
      "items": [
        {
          "text": "Jogo molokoni ngʼegi nondik nying-gi e buru",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.13",
            "verseOrgIds": [
              "JER.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:13"
      },
      "items": [
        {
          "text": "nikech gisejwangʼo Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.13",
            "verseOrgIds": [
              "JER.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:13"
      },
      "items": [
        {
          "text": "soko mar pi ngima.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.13",
            "verseOrgIds": [
              "JER.17.13"
            ]
          }
        }
      ]
    },
    {
