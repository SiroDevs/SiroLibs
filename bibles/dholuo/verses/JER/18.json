          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende ber inyalo chul gi tim marach?",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.20",
            "verseOrgIds": [
              "JER.18.20"
            ]
          }
        }
