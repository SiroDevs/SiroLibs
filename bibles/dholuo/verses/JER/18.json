      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:21"
      },
      "items": [
        {
          "text": "bolgi e teko mar ligangla.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.21",
            "verseOrgIds": [
              "JER.18.21"
            ]
