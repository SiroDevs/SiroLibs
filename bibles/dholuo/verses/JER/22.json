    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne amiyou siem e kinde mane uparo ni uritoru maber,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.21",
            "verseOrgIds": [
              "JER.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:21"
      },
      "items": [
        {
          "text": "to ne iwacho ni, 'Ok anachik ita!'",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.21",
            "verseOrgIds": [
              "JER.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 22:21"
      },
      "items": [
        {
          "text": "Ma osebedo yori chakre ibed rawera;",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.21",
            "verseOrgIds": [
              "JER.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:21"
      },
      "items": [
        {
          "text": "ok iseluora.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.21",
            "verseOrgIds": [
              "JER.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamo noriemb jokwadhu duto,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.22",
            "verseOrgIds": [
              "JER.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:22"
      },
      "items": [
        {
          "text": "kendo joma osiepeni noter e twech.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.22",
            "verseOrgIds": [
              "JER.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 22:22"
      },
      "items": [
        {
          "text": "Eka wiyi nokuodi kendo nogengʼni",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.22",
            "verseOrgIds": [
              "JER.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:22"
      },
      "items": [
        {
          "text": "nikech timbegi maricho.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.22",
            "verseOrgIds": [
              "JER.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Un jogo modak Lebanon,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.23",
            "verseOrgIds": [
              "JER.22.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:23"
      },
      "items": [
        {
          "text": "modak e ute bao mag sida moger gi malo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.23",
            "verseOrgIds": [
              "JER.22.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 22:23"
      },
      "items": [
        {
          "text": "mano kaka unuywag malit ka rem ochopo kuomu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.23",
            "verseOrgIds": [
              "JER.22.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:23"
      },
      "items": [
        {
          "text": "rem machalo gi mar dhako mamuoch kayo!\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.23",
            "verseOrgIds": [
              "JER.22.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye owacho niya, \"An Jehova Nyasaye mangima akwongʼora ni kata ne bed ni in Jehoyakin wuod Jehoyakim ruodh Juda, ni in e tere manie lweta ma korachwich, to pod dawuodhi oko.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.24",
            "verseOrgIds": [
              "JER.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anachiwi ne jogo madwaro ngimani kendo miluoro. Abiro chiwou ne Nebukadneza ruodh Babulon kod jo-Babulon.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.25",
            "verseOrgIds": [
              "JER.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anadiri oko kod miyo mane onywoli e piny machielo, kama onge ngʼama nonywole kuomu, kendo kanyo ema uduto unuthoe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.26",
            "verseOrgIds": [
              "JER.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ok unuduogie piny ma ugombo duogoeni.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.27",
            "verseOrgIds": [
              "JER.22.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende ngʼatni Jehoyakin en ngʼama ojar,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.28",
            "verseOrgIds": [
              "JER.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:28"
      },
      "items": [
        {
          "text": "agulu motore, gino maonge ngʼama dwaro?",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.28",
            "verseOrgIds": [
              "JER.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 22:28"
      },
      "items": [
        {
          "text": "En angʼo momiyo en kod nyithinde",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.28",
            "verseOrgIds": [
              "JER.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:28"
      },
      "items": [
        {
          "text": "nyaka witgi oko e piny ma ok gingʼeyo?",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.28",
            "verseOrgIds": [
              "JER.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye piny, piny, piny,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.29",
            "verseOrgIds": [
              "JER.22.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:29"
      },
      "items": [
        {
          "text": "winj wach Jehova Nyasaye!",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.29",
            "verseOrgIds": [
              "JER.22.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma e gima Jehova Nyasaye wacho:",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.30",
            "verseOrgIds": [
              "JER.22.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 22:30"
      },
      "items": [
        {
          "text": "\"Kwan ngʼatni ka ngʼama onge nyathi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.30",
            "verseOrgIds": [
              "JER.22.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:30"
      },
      "items": [
        {
          "text": "ngʼatno ma ok nyal dhi nyime maber,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.30",
            "verseOrgIds": [
              "JER.22.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 22:30"
      },
      "items": [
        {
          "text": "e kinde mar ngimane,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.30",
            "verseOrgIds": [
              "JER.22.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 22:30"
      },
      "items": [
        {
          "text": "nimar onge gunde mane dhi maber,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.30",
            "verseOrgIds": [
              "JER.22.30"
            ]
          }
        }
      ]
    },
    {
