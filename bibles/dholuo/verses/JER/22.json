          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Dhiyo Lebanon kendo iywag matek,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.20",
            "verseOrgIds": [
              "JER.22.20"
            ]
          }
        }
