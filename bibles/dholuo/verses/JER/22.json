      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:20"
      },
      "items": [
        {
          "text": "mad dwondi winjre Bashan,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.20",
            "verseOrgIds": [
              "JER.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 22:20"
      },
      "items": [
        {
          "text": "ywagi ka ia Abarim,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.20",
            "verseOrgIds": [
              "JER.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:20"
      },
      "items": [
        {
          "text": "nimar joma osiepenigo oseduny matindo tindo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.20",
            "verseOrgIds": [
              "JER.22.20"
            ]
          }
        }
