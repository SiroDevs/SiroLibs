      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:18"
      },
      "items": [
        {
          "text": "'Yaye, jatenda! Yaye, duongʼ mari!'",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.18",
            "verseOrgIds": [
              "JER.22.18"
            ]
          }
