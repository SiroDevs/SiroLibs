      "attrs": {
        "style": "q2",
        "vid": "JER 22:19"
      },
      "items": [
        {
          "text": "moywa kendo owit oko mar dhorangeye Jerusalem.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.19",
            "verseOrgIds": [
              "JER.22.19"
            ]
          }
        }
