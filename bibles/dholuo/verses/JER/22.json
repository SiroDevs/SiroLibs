          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"To wengeu kod chunyu ochikore",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.17",
            "verseOrgIds": [
              "JER.22.17"
            ]
