  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "JER 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kum ne ruodhi ma timbegi mono",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma e gima Jehova Nyasaye wacho: \"Dhiyo e kar dak mar ruodh Juda kendo iland wachni kanyo:",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.1",
            "verseOrgIds": [
              "JER.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Winj wach Jehova Nyasaye, yaye ruodh Juda, un joma bet e kom duongʼ Daudi, in, jotendi kod jogi madonjo gie dhorangeyegi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.2",
            "verseOrgIds": [
              "JER.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma e gima Jehova Nyasaye wacho: Tim gima nikare kendo mowinjore. Res ngʼatno e lwet ngʼama thire, ngʼatno mosemaye. Kik itim marach kata tugo lweny gi jadak, kiye kata mon ma chwogi otho, kendo kik ichwer remo maonge gi wach ka eri.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.3",
            "verseOrgIds": [
              "JER.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar ka urito chikegi maber, eka ruodhi mabet e kom duongʼ mar Daudi nondonji gi e dhorangeye mag kar dak ruoth, ka giriembo geche kendo giidho farese, ka gin gi jotendgi kod jogegi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.4",
            "verseOrgIds": [
              "JER.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ka ok urito chikegi, Jehova Nyasaye wacho, akwongʼora an owuon ni kar dak ruodhni nolal nono.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.5",
            "verseOrgIds": [
              "JER.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar ma e gima Jehova Nyasaye wacho kuom kar dak mar ruodh Juda:",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.6",
            "verseOrgIds": [
              "JER.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 22:6"
      },
      "items": [
        {
          "text": "\"Kata obedo ni in kaka Gilead ne an,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.6",
            "verseOrgIds": [
              "JER.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:6"
      },
      "items": [
        {
          "text": "kaka wi got Lebanon,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.6",
            "verseOrgIds": [
              "JER.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 22:6"
      },
      "items": [
        {
          "text": "adiera analoku kaka kama otwo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.6",
            "verseOrgIds": [
              "JER.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:6"
      },
      "items": [
        {
          "text": "ka mier maonge joma odakie.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.6",
            "verseOrgIds": [
              "JER.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaor joma tiekou,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.7",
            "verseOrgIds": [
              "JER.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:7"
      },
      "items": [
        {
          "text": "ngʼato ka ngʼato gi gige lweny,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.7",
            "verseOrgIds": [
              "JER.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 22:7"
      },
      "items": [
        {
          "text": "kendo ginitongʼ sirniu mabeyo mag sida",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.7",
            "verseOrgIds": [
              "JER.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:7"
      },
      "items": [
        {
          "text": "mi giwitgi ei mach.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.7",
            "verseOrgIds": [
              "JER.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ji moa e pinje mangʼeny nokal e dala maduongʼni kendo ginipenjre kendgi giwegi ni, 'Angʼo momiyo Jehova Nyasaye timo gima chalo kama ne dala maduongʼni?'",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.8",
            "verseOrgIds": [
              "JER.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "To dwoko nobed: 'Nikech gisejwangʼo singruok mar Jehova Nyasaye ma Nyasachgi kendo giselamo kendo tiyone nyiseche mamoko.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.9",
            "verseOrgIds": [
              "JER.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik uywag ruoth motho kata goyo nduru ne lal mare;",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.10",
            "verseOrgIds": [
              "JER.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:10"
      },
      "items": [
        {
          "text": "to onego, uywag malit ne ngʼatno moter e twech,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.10",
            "verseOrgIds": [
              "JER.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 22:10"
      },
      "items": [
        {
          "text": "nikech ok enoduogi kata",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.10",
            "verseOrgIds": [
              "JER.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:10"
      },
      "items": [
        {
          "text": "neno piny mane onywole kendo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.10",
            "verseOrgIds": [
              "JER.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar ma e gima Jehova Nyasaye osewacho kawuoyo kuom Shalum wuod Josia, mane okawo loch bangʼ wuon-gi kaka ruodh Juda, \"Osea ka kendo ok nodwogi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.11",
            "verseOrgIds": [
              "JER.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enotho kama gisetere e twech; ok enone pinyni kendo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.12",
            "verseOrgIds": [
              "JER.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mano kaka none malit",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.13",
            "verseOrgIds": [
              "JER.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:13"
      },
      "items": [
        {
          "text": "ngʼatno magero kare mar dak maonge ratiro,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.13",
            "verseOrgIds": [
              "JER.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 22:13"
      },
      "items": [
        {
          "text": "utene mamalo e yor mecho",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.13",
            "verseOrgIds": [
              "JER.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:13"
      },
      "items": [
        {
          "text": "koketo jothurgi tiyo maonge chudo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.13",
            "verseOrgIds": [
              "JER.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owacho, 'Anagerne an owuon kar dak mara maduongʼ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.14",
            "verseOrgIds": [
              "JER.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:14"
      },
      "items": [
        {
          "text": "ka en-gi ute mamalo malach.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.14",
            "verseOrgIds": [
              "JER.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 22:14"
      },
      "items": [
        {
          "text": "Omiyo oloso dirisni malach kuome,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.14",
            "verseOrgIds": [
              "JER.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:14"
      },
      "items": [
        {
          "text": "olwore gi fito mar yiend sida,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.14",
            "verseOrgIds": [
              "JER.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:14"
      },
      "items": [
        {
          "text": "kendo obuke gi range marakwaro.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.14",
            "verseOrgIds": [
              "JER.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bedo gi yiende mag sida",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.15",
            "verseOrgIds": [
              "JER.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:15"
      },
      "items": [
        {
          "text": "mangʼeny nyalo miyo ibed ruoth?",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.15",
            "verseOrgIds": [
              "JER.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 22:15"
      },
      "items": [
        {
          "text": "Donge wuonu ne nigi chiemo kod math?",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.15",
            "verseOrgIds": [
              "JER.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:15"
      },
      "items": [
        {
          "text": "Notimo gima ratiro kendo nikare,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.15",
            "verseOrgIds": [
              "JER.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:15"
      },
      "items": [
        {
          "text": "omiyo duto nobedo maber kode.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.15",
            "verseOrgIds": [
              "JER.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ochungʼ motegno ne joma odhier",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.16",
            "verseOrgIds": [
              "JER.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:16"
      },
      "items": [
        {
          "text": "kendo ni gidwaro, kendo duto nobedo maber kode.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.16",
            "verseOrgIds": [
              "JER.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 22:16"
      },
      "items": [
        {
          "text": "Donge mano e tiend ngʼeya?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.16",
            "verseOrgIds": [
              "JER.22.16"
            ]
          }
        }
