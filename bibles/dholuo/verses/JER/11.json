          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano Jehova Nyasaye Maratego wacho ni, 'Anakumgi. Rowere mag-gi noneg gi ligangla, yawuotgi kod nyigi kech nonegi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.22",
            "verseOrgIds": [
              "JER.11.22"
            ]
          }
        },
        {
