      },
      "items": [
        {
          "text": "146",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 146",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 146:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pak ne Jehova Nyasaye!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.1",
            "verseOrgIds": [
              "PSA.146.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 146:1"
      },
      "items": [
        {
          "text": "Yaye chunya, pak Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.1",
            "verseOrgIds": [
              "PSA.146.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 146:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro pako Jehova Nyasaye e ngimana duto;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.2",
            "verseOrgIds": [
              "PSA.146.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 146:2"
      },
      "items": [
        {
          "text": "abiro wero wende pak ne Nyasacha kinde duto ma angima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.2",
            "verseOrgIds": [
              "PSA.146.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 146:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik iket genoni kuom ruodhi mag piny,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.3",
            "verseOrgIds": [
              "PSA.146.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 146:3"
      },
      "items": [
        {
          "text": "kata kuom dhano matho ma ok nyal waro ngʼato,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.3",
            "verseOrgIds": [
              "PSA.146.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 146:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikech ka chunygi ochot to gidok e lowo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.4",
            "verseOrgIds": [
              "PSA.146.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 146:4"
      },
      "items": [
        {
          "text": "kendo chiengʼono chenrogi ogik gikanyono.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.4",
            "verseOrgIds": [
              "PSA.146.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 146:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogwedh ngʼat ma konyruokne en Nyasach Jakobo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.5",
            "verseOrgIds": [
              "PSA.146.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 146:5"
      },
      "items": [
        {
          "text": "ngʼat ma genone ni kuom Jehova Nyasaye ma Nyasache.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.5",
            "verseOrgIds": [
              "PSA.146.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 146:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "En jachwech mar polo gi piny,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.6",
            "verseOrgIds": [
              "PSA.146.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 146:6"
      },
      "items": [
        {
          "text": "gi nam kod gik moko duto manie igi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.6",
            "verseOrgIds": [
              "PSA.146.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 146:6"
      },
      "items": [
        {
          "text": "osiko ka en ja-adiera nyaka chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.6",
            "verseOrgIds": [
              "PSA.146.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 146:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ochwako ngʼat misando",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.7",
            "verseOrgIds": [
              "PSA.146.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 146:7"
      },
      "items": [
        {
          "text": "kendo ochiwo chiemo ne joma odenyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.7",
            "verseOrgIds": [
              "PSA.146.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 146:7"
      },
      "items": [
        {
          "text": "Jehova Nyasaye gonyo joma otwe mi gibed thuolo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.7",
            "verseOrgIds": [
              "PSA.146.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 146:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo Jehova Nyasaye miyo muofni neno.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.8",
            "verseOrgIds": [
              "PSA.146.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 146:8"
      },
      "items": [
        {
          "text": "Jehova Nyasaye miyo joma piny otaro aa malo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.8",
            "verseOrgIds": [
              "PSA.146.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 146:8"
      },
      "items": [
        {
          "text": "kendo ohero joma kare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.8",
            "verseOrgIds": [
              "PSA.146.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 146:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye rito jadak",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.9",
            "verseOrgIds": [
              "PSA.146.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 146:9"
      },
      "items": [
        {
          "text": "kendo okonyo nyathi kich gi dhako ma chwore otho,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.9",
            "verseOrgIds": [
              "PSA.146.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 146:9"
      },
      "items": [
        {
          "text": "to yore mag ngʼama timbene richo to orocho.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.9",
            "verseOrgIds": [
              "PSA.146.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 146:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye olocho nyaka chiengʼ yaye Sayun,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.10",
            "verseOrgIds": [
              "PSA.146.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 146:10"
      },
      "items": [
        {
          "text": "Nyasachi olocho nyaka tienge duto mabiro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.10",
            "verseOrgIds": [
              "PSA.146.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 146:10"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 146:10"
      },
      "items": [
        {
          "text": "Pakuru Jehova Nyasaye!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.10",
            "verseOrgIds": [
              "PSA.146.10"
            ]
          }
        }
      ]
    }
  ],
