  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "145",
        "style": "c",
        "sid": "PSA 145"
      },
      "items": [
        {
          "text": "145",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 145",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Zaburi mar pak. Mar Daudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 145:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro tingʼo nyingi malo, yaye Nyasacha ma Ruoth;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.1",
            "verseOrgIds": [
              "PSA.145.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:1"
      },
      "items": [
        {
          "text": "abiro pako nyingi nyaka chiengʼ kendo nyaka chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.1",
            "verseOrgIds": [
              "PSA.145.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 145:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro paki pile ka pile",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.2",
            "verseOrgIds": [
              "PSA.145.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:2"
      },
      "items": [
        {
          "text": "kendo abiro tingʼo nyingi malo mochwere manyaka chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.2",
            "verseOrgIds": [
              "PSA.145.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 145:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye duongʼ miwuoro kendo owinjore gi pak,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.3",
            "verseOrgIds": [
              "PSA.145.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:3"
      },
      "items": [
        {
          "text": "onge ngʼama nyalo yango duongʼne.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.3",
            "verseOrgIds": [
              "PSA.145.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 145:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiengʼ achiel biro pako tijeni ne tiengʼ machielo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.4",
            "verseOrgIds": [
              "PSA.145.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:4"
      },
      "items": [
        {
          "text": "adier, gibiro nyiso ji kuom tijeni madongo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.4",
            "verseOrgIds": [
              "PSA.145.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 145:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gibiro wuoyo kuom duongʼni mangʼongo kendo marieny,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.5",
            "verseOrgIds": [
              "PSA.145.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:5"
      },
      "items": [
        {
          "text": "to an abiro paro mos kuom tijeni miwuoro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.5",
            "verseOrgIds": [
              "PSA.145.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 145:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gibiro nyiso kuom tekoni mitimogo gik malich miwuoro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.6",
            "verseOrgIds": [
              "PSA.145.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:6"
      },
      "items": [
        {
          "text": "to an abiro hulo kuom tijeni madongo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.6",
            "verseOrgIds": [
              "PSA.145.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 145:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gibiro loso nyasi mar ber ni mogundho",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.7",
            "verseOrgIds": [
              "PSA.145.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:7"
      },
      "items": [
        {
          "text": "kendo gibiro wer gi mor kuom timbeni makare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.7",
            "verseOrgIds": [
              "PSA.145.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 145:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye ngʼwon kendo kecho ji,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.8",
            "verseOrgIds": [
              "PSA.145.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:8"
      },
      "items": [
        {
          "text": "iye ok wangʼ piyo kendo en gihera mangʼeny.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.8",
            "verseOrgIds": [
              "PSA.145.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 145:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye timo maber ne ji duto;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.9",
            "verseOrgIds": [
              "PSA.145.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:9"
      },
      "items": [
        {
          "text": "okecho ji duto mosechweyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.9",
            "verseOrgIds": [
              "PSA.145.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 145:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji duto ma isechweyo biro paki, yaye Jehova Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.10",
            "verseOrgIds": [
              "PSA.145.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:10"
      },
      "items": [
        {
          "text": "jogi maler duto biro dhiali.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.10",
            "verseOrgIds": [
              "PSA.145.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 145:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gibiro nyiso ji kuom duongʼ mar pinyruodhi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.11",
            "verseOrgIds": [
              "PSA.145.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:11"
      },
      "items": [
        {
          "text": "kendo gibiro wuoyo kuom tekoni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.11",
            "verseOrgIds": [
              "PSA.145.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 145:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "mondo ji duto ongʼe gik madongo mitimo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.12",
            "verseOrgIds": [
              "PSA.145.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:12"
      },
      "items": [
        {
          "text": "kod duongʼ mangʼongo mar pinyruodhi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.12",
            "verseOrgIds": [
              "PSA.145.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 145:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pinyruodhi en pinyruoth mochwere,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.13",
            "verseOrgIds": [
              "PSA.145.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:13"
      },
      "items": [
        {
          "text": "kendo lochni osiko nyaka tienge duto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.13",
            "verseOrgIds": [
              "PSA.145.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 145:13"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 145:13"
      },
      "items": [
        {
          "text": "Jehova Nyasaye chopo singruok mage duto",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.13",
            "verseOrgIds": [
              "PSA.145.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:13"
      },
      "items": [
        {
          "text": "kendo ohero ji duto mosechweyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.13",
            "verseOrgIds": [
              "PSA.145.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 145:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye chungo ji duto mopodho",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.14",
            "verseOrgIds": [
              "PSA.145.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:14"
      },
      "items": [
        {
          "text": "kendo omiyo joma piny otaro aa malo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.14",
            "verseOrgIds": [
              "PSA.145.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 145:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "In ema wenge ji duto ngʼiyi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.15",
            "verseOrgIds": [
              "PSA.145.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:15"
      },
      "items": [
        {
          "text": "kendo imiyogi chiembgi e kinde mowinjore.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.15",
            "verseOrgIds": [
              "PSA.145.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 145:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka iyawo lweti",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.16",
            "verseOrgIds": [
              "PSA.145.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:16"
      },
      "items": [
        {
          "text": "to gik mangima duto yudo konyruokgi duto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.16",
            "verseOrgIds": [
              "PSA.145.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 145:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye nikare e yorene duto",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.17",
            "verseOrgIds": [
              "PSA.145.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:17"
      },
      "items": [
        {
          "text": "kendo ohero ji duto mosechweyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.17",
            "verseOrgIds": [
              "PSA.145.17"
            ]
          }
        }
      ]
    },
    {
