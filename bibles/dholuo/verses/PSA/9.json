  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "PSA 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kuom jatend wer. E dwol mar \"Tho mar wuowi.\" Zaburi mar Daudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro paki gi chunya duto, yaye Jehova Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.1",
            "verseOrgIds": [
              "PSA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:1"
      },
      "items": [
        {
          "text": "abiro nyiso timbegi madongo duto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.1",
            "verseOrgIds": [
              "PSA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro bedo mamor kendo abiro bedo moil kodi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.2",
            "verseOrgIds": [
              "PSA.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:2"
      },
      "items": [
        {
          "text": "abiro pako nyingi gi wer, yaye Nyasaye Man Malo Moloyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.2",
            "verseOrgIds": [
              "PSA.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasika dok chien;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.3",
            "verseOrgIds": [
              "PSA.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:3"
      },
      "items": [
        {
          "text": "gichwanyore kendo gilal e nyimi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.3",
            "verseOrgIds": [
              "PSA.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech isechungʼna matek ka ichwaka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.4",
            "verseOrgIds": [
              "PSA.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:4"
      },
      "items": [
        {
          "text": "isebet e kom duongʼ mari, kiyalo bura kare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.4",
            "verseOrgIds": [
              "PSA.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isekwero ogendini kendo isetieko joma richo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.5",
            "verseOrgIds": [
              "PSA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:5"
      },
      "items": [
        {
          "text": "iserucho nying-gi oko manyaka chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.5",
            "verseOrgIds": [
              "PSA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kethruok mosiko osejuko jasigu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.6",
            "verseOrgIds": [
              "PSA.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:6"
      },
      "items": [
        {
          "text": "isemuko miechgi madongo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.6",
            "verseOrgIds": [
              "PSA.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:6"
      },
      "items": [
        {
          "text": "kendo wi ji osewil kodgi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.6",
            "verseOrgIds": [
              "PSA.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye olocho nyaka chiengʼ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.7",
            "verseOrgIds": [
              "PSA.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:7"
      },
      "items": [
        {
          "text": "oseguro kom loch mare mar ngʼado bura.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.7",
            "verseOrgIds": [
              "PSA.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obiro ngʼado bura ne piny gi tim makare;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.8",
            "verseOrgIds": [
              "PSA.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:8"
      },
      "items": [
        {
          "text": "obiro rito ogendini gi adiera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.8",
            "verseOrgIds": [
              "PSA.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye en kar pondo ne joma idiyo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.9",
            "verseOrgIds": [
              "PSA.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:9"
      },
      "items": [
        {
          "text": "en e kar pondo e kinde mag chandruok.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.9",
            "verseOrgIds": [
              "PSA.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma ongʼeyo nyingi biro geno kuomi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.10",
            "verseOrgIds": [
              "PSA.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:10"
      },
      "items": [
        {
          "text": "nikech in, yaye Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.10",
            "verseOrgIds": [
              "PSA.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:10"
      },
      "items": [
        {
          "text": "ne pok ijwangʼo joma manyi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.10",
            "verseOrgIds": [
              "PSA.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wer wende pak ne Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.11",
            "verseOrgIds": [
              "PSA.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:11"
      },
      "items": [
        {
          "text": "mobet e kom lochne e Sayun;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.11",
            "verseOrgIds": [
              "PSA.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:11"
      },
      "items": [
        {
          "text": "hul ni ogendini gik mosetimo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.11",
            "verseOrgIds": [
              "PSA.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech ngʼat machulo kuor kuom remo mochwer siko kaparo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.12",
            "verseOrgIds": [
              "PSA.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:12"
      },
      "items": [
        {
          "text": "ok owe mak odewo ywak joma hinyore.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.12",
            "verseOrgIds": [
              "PSA.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neye kaka wasika sanda, yaye Jehova Nyasaye!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.13",
            "verseOrgIds": [
              "PSA.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:13"
      },
      "items": [
        {
          "text": "Kecha kendo tingʼa igola e dhorangeye mag tho,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.13",
            "verseOrgIds": [
              "PSA.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "mondo anyis pakni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.14",
            "verseOrgIds": [
              "PSA.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:14"
      },
      "items": [
        {
          "text": "e dhorangeye mag Nyi Sayun,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.14",
            "verseOrgIds": [
              "PSA.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:14"
      },
      "items": [
        {
          "text": "kendo abed mamor kuno nikech warruokni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.14",
            "verseOrgIds": [
              "PSA.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogendini oselutore e buche ma gikunyo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.15",
            "verseOrgIds": [
              "PSA.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:15"
      },
      "items": [
        {
          "text": "tiendegi ogajore e tondegi ma gichokogo ji.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.15",
            "verseOrgIds": [
              "PSA.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye ongʼere nikech adier mare;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.16",
            "verseOrgIds": [
              "PSA.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:16"
      },
      "items": [
        {
          "text": "joma timbegi richo omoko e gik ma giloso gi lwetgi giwegi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.16",
            "verseOrgIds": [
              "PSA.9.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Higaion. Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.9.16",
                "verseOrgIds": [
                  "PSA.9.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
