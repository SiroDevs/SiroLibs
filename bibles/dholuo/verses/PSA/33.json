  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "33",
        "style": "c",
        "sid": "PSA 33"
      },
      "items": [
        {
          "text": "33",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 33",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weruru gimor ni Jehova Nyasaye, un joma kare;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.1",
            "verseOrgIds": [
              "PSA.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:1"
      },
      "items": [
        {
          "text": "en gima owinjore mondo joma kare opake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.1",
            "verseOrgIds": [
              "PSA.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuru Jehova Nyasaye gi nyatiti;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.2",
            "verseOrgIds": [
              "PSA.33.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:2"
      },
      "items": [
        {
          "text": "werneuru wer mamit gi nyatiti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.2",
            "verseOrgIds": [
              "PSA.33.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Werneuru wer manyien;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.3",
            "verseOrgIds": [
              "PSA.33.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:3"
      },
      "items": [
        {
          "text": "werneuru kugoyone nyiduonge kendo weruru gi ilo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.3",
            "verseOrgIds": [
              "PSA.33.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wach Jehova Nyasaye nikare kendo en adier;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.4",
            "verseOrgIds": [
              "PSA.33.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:4"
      },
      "items": [
        {
          "text": "en ja-adiera e gik moko duto motimo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.4",
            "verseOrgIds": [
              "PSA.33.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye ohero tim makare kod ratiro;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.5",
            "verseOrgIds": [
              "PSA.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:5"
      },
      "items": [
        {
          "text": "piny duto opongʼ gi herane ma ok rem.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.5",
            "verseOrgIds": [
              "PSA.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Polo ne ochwe kuom wach Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.6",
            "verseOrgIds": [
              "PSA.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:6"
      },
      "items": [
        {
          "text": "i dwe gi nyinyo duto nochweyo gi much dhoge.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.6",
            "verseOrgIds": [
              "PSA.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ochoko pige mag nembe madongo e tawo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.7",
            "verseOrgIds": [
              "PSA.33.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:7"
      },
      "items": [
        {
          "text": "oketo kut e dere.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.7",
            "verseOrgIds": [
              "PSA.33.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piny duto mondo oluor Jehova Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.8",
            "verseOrgIds": [
              "PSA.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:8"
      },
      "items": [
        {
          "text": "ji duto manie e piny mondo okulrene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.8",
            "verseOrgIds": [
              "PSA.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech ne owuoyo mi piny nobetie,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.9",
            "verseOrgIds": [
              "PSA.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:9"
      },
      "items": [
        {
          "text": "nogolo chik mi ochungʼ mongirore.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.9",
            "verseOrgIds": [
              "PSA.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye ketho chenro duto mag pinje;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.10",
            "verseOrgIds": [
              "PSA.33.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:10"
      },
      "items": [
        {
          "text": "othiro dwaro ma ogendini nigo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.10",
            "verseOrgIds": [
              "PSA.33.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "To chenro duto mag Jehova Nyasaye to siko kochungʼ nyaka chiengʼ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.11",
            "verseOrgIds": [
              "PSA.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:11"
      },
      "items": [
        {
          "text": "ochopo dwaro duto manie chunye e tienge duto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.11",
            "verseOrgIds": [
              "PSA.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piny ma ogeno Jehova Nyasaye ma Nyasache ogwedhi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.12",
            "verseOrgIds": [
              "PSA.33.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:12"
      },
      "items": [
        {
          "text": "nikech gin oganda mane oyiero kaka girkeni mare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.12",
            "verseOrgIds": [
              "PSA.33.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye rango piny gie polo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.13",
            "verseOrgIds": [
              "PSA.33.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:13"
      },
      "items": [
        {
          "text": "kendo oneno dhano duto;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.13",
            "verseOrgIds": [
              "PSA.33.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ongʼiyo ji duto modak e piny gie kar dakne e polo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.14",
            "verseOrgIds": [
              "PSA.33.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "en ema ne ochweyo chunje ji duto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.15",
            "verseOrgIds": [
              "PSA.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:15"
      },
      "items": [
        {
          "text": "kendo onono gik moko duto ma gitimo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.15",
            "verseOrgIds": [
              "PSA.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onge ruoth minyalo reso nikech en gi jolweny mangʼeny;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.16",
            "verseOrgIds": [
              "PSA.33.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:16"
      },
      "items": [
        {
          "text": "bende onge jakedo manyalo tony nikech tekone ngʼeny.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.16",
            "verseOrgIds": [
              "PSA.33.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geno yudo resruok kuom faras en gima nono",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.17",
            "verseOrgIds": [
              "PSA.33.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:17"
      },
      "items": [
        {
          "text": "kata obedo ni en giteko mangʼeny to ok onyal reso ngʼato.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.17",
            "verseOrgIds": [
              "PSA.33.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "To wangʼ Jehova Nyasaye neno jogo momiye luor,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.18",
            "verseOrgIds": [
              "PSA.33.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:18"
      },
      "items": [
        {
          "text": "orango joma geno margi ni kuom herane ma ok rem,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.18",
            "verseOrgIds": [
              "PSA.33.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "mondo oresgi e tho",
          "type": "text",
