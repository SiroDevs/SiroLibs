      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:26"
      },
      "items": [
        {
          "text": "kendo ondieg nam mane ichweyo miluongo ni Leviathan tuge.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.26",
            "verseOrgIds": [
              "PSA.104.26"
            ]
          }
