          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikelo mudho mi piny lokre otieno,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.20",
            "verseOrgIds": [
              "PSA.104.20"
            ]
          }
