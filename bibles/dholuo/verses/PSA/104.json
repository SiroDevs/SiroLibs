        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 104",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 104:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pak Jehova Nyasaye, yaye chunya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.1",
            "verseOrgIds": [
              "PSA.104.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 104:1"
      },
      "items": [
        {
          "text": "Yaye Jehova Nyasaye Nyasacha, mano kaka iduongʼ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.1",
            "verseOrgIds": [
              "PSA.104.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:1"
      },
      "items": [
        {
          "text": "irwakori gi luor kod duongʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.1",
            "verseOrgIds": [
              "PSA.104.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 104:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oumore gi ler mana kaka nanga; oyaro polo mana kaka hema",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.2",
            "verseOrgIds": [
              "PSA.104.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 104:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo ogero ode moluore ewi pi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.3",
            "verseOrgIds": [
              "PSA.104.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 104:3"
      },
      "items": [
        {
          "text": "Oidho boche polo kaka gache mar lweny",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.3",
            "verseOrgIds": [
              "PSA.104.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:3"
      },
      "items": [
        {
          "text": "kendo yamo e ndike moriembo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.3",
            "verseOrgIds": [
              "PSA.104.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 104:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo yembe bedo kaka jootene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.4",
            "verseOrgIds": [
              "PSA.104.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:4"
      },
      "items": [
        {
          "text": "kendo jotichne kaka ligek mach.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.4",
            "verseOrgIds": [
              "PSA.104.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 104:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iseguro piny e mise mage;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.5",
            "verseOrgIds": [
              "PSA.104.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:5"
      },
      "items": [
        {
          "text": "ma ok onyal yiengni kata matin.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.5",
            "verseOrgIds": [
              "PSA.104.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 104:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne iume gi kut mana kaka nanga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.6",
            "verseOrgIds": [
              "PSA.104.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:6"
      },
      "items": [
        {
          "text": "mi pige obiwore moyombo gode.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.6",
            "verseOrgIds": [
              "PSA.104.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 104:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "To kane ikwero pigego to ne gileny nono,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.7",
            "verseOrgIds": [
              "PSA.104.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:7"
      },
      "items": [
        {
          "text": "kane giwinji kimor to ne giwalore gia;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.7",
            "verseOrgIds": [
              "PSA.104.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 104:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne gimol ewi gode,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.8",
            "verseOrgIds": [
              "PSA.104.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:8"
      },
      "items": [
        {
          "text": "ka giridore gidhi e holni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.8",
            "verseOrgIds": [
              "PSA.104.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:8"
      },
      "items": [
        {
          "text": "kuonde mane ochan-negi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.8",
            "verseOrgIds": [
              "PSA.104.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 104:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne iketonegi tongʼ ma ok ginyal kadho;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.9",
            "verseOrgIds": [
              "PSA.104.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:9"
      },
      "items": [
        {
          "text": "mondo kik gichak giim piny kendo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.9",
            "verseOrgIds": [
              "PSA.104.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 104:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye miyo sokni olo pi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.10",
            "verseOrgIds": [
              "PSA.104.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:10"
      },
      "items": [
        {
          "text": "e bugni ka gimol e kind gode.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.10",
            "verseOrgIds": [
              "PSA.104.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 104:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gichiwo pi ne le mag bungu duto;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.11",
            "verseOrgIds": [
              "PSA.104.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:11"
      },
      "items": [
        {
          "text": "kanyna mag bungu tieko riyo ma gin-go.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.11",
            "verseOrgIds": [
              "PSA.104.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 104:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Winy mafuyo e kor polo ogero utegi e bath pigego,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.12",
            "verseOrgIds": [
              "PSA.104.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:12"
      },
      "items": [
        {
          "text": "kendo giwer ewi yiende.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.12",
            "verseOrgIds": [
              "PSA.104.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 104:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo koth chue ewi gode koa e dalane manie polo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.13",
            "verseOrgIds": [
              "PSA.104.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:13"
      },
      "items": [
        {
          "text": "piny nyago olembe moromo nikech tijene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.13",
            "verseOrgIds": [
              "PSA.104.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 104:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo lum loth ne jamni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.14",
            "verseOrgIds": [
              "PSA.104.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:14"
      },
      "items": [
        {
          "text": "kod cham ma dhano doyo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.14",
            "verseOrgIds": [
              "PSA.104.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:14"
      },
      "items": [
        {
          "text": "mamiyo chiemo yudore e piny;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.14",
            "verseOrgIds": [
              "PSA.104.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 104:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kaachiel gi divai mamoro chuny dhano,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.15",
            "verseOrgIds": [
              "PSA.104.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:15"
      },
      "items": [
        {
          "text": "gi mo mamiyo lela wangʼe leny,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.15",
            "verseOrgIds": [
              "PSA.104.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:15"
      },
      "items": [
        {
          "text": "kod makati molerogo chunye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.15",
            "verseOrgIds": [
              "PSA.104.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 104:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yiende Jehova Nyasaye yudo pi moromogi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.16",
            "verseOrgIds": [
              "PSA.104.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:16"
      },
      "items": [
        {
          "text": "yiendego gin sida mag Lebanon mane opidho.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.16",
            "verseOrgIds": [
              "PSA.104.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 104:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanyo ema winy geroe utegi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.17",
            "verseOrgIds": [
              "PSA.104.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:17"
      },
      "items": [
        {
          "text": "winj nyamnaha nigi utegi ewi yiende mag obudo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.17",
            "verseOrgIds": [
              "PSA.104.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
