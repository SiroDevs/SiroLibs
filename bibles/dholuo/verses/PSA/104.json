          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibuoche ruto ka gimanyo chiemo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.21",
            "verseOrgIds": [
              "PSA.104.21"
            ]
          }
        }
      ]
