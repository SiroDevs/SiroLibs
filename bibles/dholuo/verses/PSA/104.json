      "attrs": {
        "style": "q2",
        "vid": "PSA 104:29"
      },
      "items": [
        {
          "text": "ka igolo muchi kuomgi, to githo kendo gidok e lowo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.29",
            "verseOrgIds": [
              "PSA.104.29"
            ]
          }
