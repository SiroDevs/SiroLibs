      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:34"
      },
      "items": [
        {
          "text": "seche duto ma amor kuom Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.34",
            "verseOrgIds": [
              "PSA.104.34"
            ]
          }
        }
      ]
    },
