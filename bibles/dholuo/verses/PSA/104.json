      "attrs": {
        "style": "q2",
        "vid": "PSA 104:19"
      },
      "items": [
        {
          "text": "kendo wangʼ chiengʼ ongʼeyo sa monego opodhie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.19",
            "verseOrgIds": [
              "PSA.104.19"
            ]
          }
        }
