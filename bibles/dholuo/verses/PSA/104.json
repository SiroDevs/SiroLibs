      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:32"
      },
      "items": [
        {
          "text": "kendo komulo gode to gode dhwolo iro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.32",
            "verseOrgIds": [
              "PSA.104.32"
            ]
          }
        }
      ]
    },
