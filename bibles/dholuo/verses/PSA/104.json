      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:33"
      },
      "items": [
        {
          "text": "adier, abiro wero wende pak ne Nyasacha e kinde duto ma pod angima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.33",
            "verseOrgIds": [
              "PSA.104.33"
            ]
          }
        }
