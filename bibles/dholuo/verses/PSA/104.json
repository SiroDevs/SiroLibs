      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:23"
      },
      "items": [
        {
          "text": "kendo nyagore gi tich nyaka odhiambo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.23",
            "verseOrgIds": [
              "PSA.104.23"
            ]
          }
        }
      ]
    },
    {
