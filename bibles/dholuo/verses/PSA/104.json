      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:21"
      },
      "items": [
        {
          "text": "gimanyo chiembgi kuom Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.21",
            "verseOrgIds": [
              "PSA.104.21"
            ]
          }
        }
      ]
    },
    {
