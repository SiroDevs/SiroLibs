          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka dhano wuok oko chako tijene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.23",
            "verseOrgIds": [
              "PSA.104.23"
            ]
          }
        }
      ]
    },
