          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuno ema meli kwangʼie koni gi koni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.26",
            "verseOrgIds": [
              "PSA.104.26"
            ]
          }
        }
      ]
