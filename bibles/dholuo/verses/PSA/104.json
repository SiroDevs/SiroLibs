          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro wer ne Jehova Nyasaye e ngimana duto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.33",
            "verseOrgIds": [
              "PSA.104.33"
            ]
          }
        }
      ]
