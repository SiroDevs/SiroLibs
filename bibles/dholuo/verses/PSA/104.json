          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diek mag bungu odak e gode maboyo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.18",
            "verseOrgIds": [
              "PSA.104.18"
            ]
          }
        }
      ]
