          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PSA 104:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mano kaka gik michweyo ngʼeny, yaye Jehova Nyasaye!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.24",
            "verseOrgIds": [
              "PSA.104.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:24"
      },
      "items": [
        {
          "text": "Ne ichweyogi duto gi rieko miwuoro;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.24",
            "verseOrgIds": [
              "PSA.104.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:24"
      },
      "items": [
        {
          "text": "piny opongʼ gi gik michweyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.24",
            "verseOrgIds": [
              "PSA.104.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
