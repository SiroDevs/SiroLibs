          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ioro Roho mari, to gibedo mangima;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.30",
            "verseOrgIds": [
              "PSA.104.30"
            ]
