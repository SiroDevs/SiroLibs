      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:25"
      },
      "items": [
        {
          "text": "mopongʼ gi le mamol mathoth mokalo akwana,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.25",
            "verseOrgIds": [
              "PSA.104.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:25"
      },
      "items": [
        {
          "text": "gik mangima madongo gi matindo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.25",
            "verseOrgIds": [
              "PSA.104.25"
            ]
          }
        }
      ]
    },
    {
