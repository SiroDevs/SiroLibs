          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad duongʼ mar Jehova Nyasaye sik nyaka chiengʼ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.31",
            "verseOrgIds": [
              "PSA.104.31"
            ]
