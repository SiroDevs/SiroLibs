      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:18"
      },
      "items": [
        {
          "text": "to lwendni morokore gin kuonde pondo mag aidha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.18",
            "verseOrgIds": [
              "PSA.104.18"
            ]
          }
        }
      ]
    },
