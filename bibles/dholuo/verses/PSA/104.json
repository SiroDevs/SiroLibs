      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:20"
      },
      "items": [
        {
          "text": "kendo le mag bungu duto lak oko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.20",
            "verseOrgIds": [
              "PSA.104.20"
            ]
          }
        }
      ]
    },
    {
