      "attrs": {
        "style": "q2",
        "vid": "PSA 104:30"
      },
      "items": [
        {
          "text": "kendo imiyo piny bedo gi ngima manyien.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.30",
            "verseOrgIds": [
              "PSA.104.30"
            ]
          }
        }
      ]
    },
