          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "En e ma kongʼiyo piny to piny yiengni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.32",
            "verseOrgIds": [
              "PSA.104.32"
            ]
          }
        }
      ]
    },
