          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ka chiengʼ wuok to gidok e bungu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.22",
            "verseOrgIds": [
              "PSA.104.22"
            ]
          }
        }
      ]
    },
    {
