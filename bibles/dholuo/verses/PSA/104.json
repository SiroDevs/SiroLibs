          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isechweyo nam maduongʼ kendo malach",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.25",
            "verseOrgIds": [
              "PSA.104.25"
            ]
          }
        }
      ]
    },
