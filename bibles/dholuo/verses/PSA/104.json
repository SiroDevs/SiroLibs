      "attrs": {
        "style": "q2",
        "vid": "PSA 104:31"
      },
      "items": [
        {
          "text": "mad Jehova Nyasaye bed mamor gi gik mane ochweyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.31",
            "verseOrgIds": [
              "PSA.104.31"
            ]
          }
        }
      ]
    },
    {
