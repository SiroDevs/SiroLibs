      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:22"
      },
      "items": [
        {
          "text": "gidok kendo ginindo e gondegi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.22",
            "verseOrgIds": [
              "PSA.104.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
