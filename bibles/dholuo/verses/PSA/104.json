          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dwe pogo kinde mag chwiri gi kinde mag opon",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.19",
            "verseOrgIds": [
              "PSA.104.19"
            ]
          }
