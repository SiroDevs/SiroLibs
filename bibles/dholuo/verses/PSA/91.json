  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "91",
        "style": "c",
        "sid": "PSA 91"
      },
      "items": [
        {
          "text": "91",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 91",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 91:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼat modak ei kar pondo mar Nyasaye Man Malo Moloyo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.1",
            "verseOrgIds": [
              "PSA.91.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:1"
      },
      "items": [
        {
          "text": "biro yudo yweyo e bwo tipo mar Jehova Nyasaye Maratego.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.1",
            "verseOrgIds": [
              "PSA.91.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 91:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼat ma kamano nyalo wacho kuom Jehova Nyasaye niya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.2",
            "verseOrgIds": [
              "PSA.91.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:2"
      },
      "items": [
        {
          "text": "\"En e kar pondona kendo en e ohingana,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.2",
            "verseOrgIds": [
              "PSA.91.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:2"
      },
      "items": [
        {
          "text": "en e Nyasacha ma ageno kuome.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.2",
            "verseOrgIds": [
              "PSA.91.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 91:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye biro resi adier kuom gik mochikigo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.3",
            "verseOrgIds": [
              "PSA.91.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:3"
      },
      "items": [
        {
          "text": "mondo ohinyi kendo kuom tuoche maricho maneko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.3",
            "verseOrgIds": [
              "PSA.91.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 91:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obiro umi gi bwombene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.4",
            "verseOrgIds": [
              "PSA.91.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:4"
      },
      "items": [
        {
          "text": "kendo ibiro yudo konyruok e bwo bwombene;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.4",
            "verseOrgIds": [
              "PSA.91.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:4"
      },
      "items": [
        {
          "text": "adierane biro bedoni ka okumba kendo ka siro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.4",
            "verseOrgIds": [
              "PSA.91.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 91:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ok iniluor masira mar otieno,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.5",
            "verseOrgIds": [
              "PSA.91.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:5"
      },
      "items": [
        {
          "text": "kata asere machielore godiechiengʼ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.5",
            "verseOrgIds": [
              "PSA.91.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 91:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata tuoche maricho maliwo ji e mudho,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.6",
            "verseOrgIds": [
              "PSA.91.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:6"
      },
      "items": [
        {
          "text": "kata tho matieko ngima ji e dier odiechiengʼ tir.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.6",
            "verseOrgIds": [
              "PSA.91.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 91:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji alufu achiel nyalo podho e bathi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.7",
            "verseOrgIds": [
              "PSA.91.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:7"
      },
      "items": [
        {
          "text": "ee, ji alufu apar nyalo riere e badi korachwich,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.7",
            "verseOrgIds": [
              "PSA.91.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:7"
      },
      "items": [
        {
          "text": "to in onge moro ma nochop buti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.7",
            "verseOrgIds": [
              "PSA.91.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 91:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iningʼigi angʼiya gi wengeni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.8",
            "verseOrgIds": [
              "PSA.91.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:8"
      },
      "items": [
        {
          "text": "kendo inine kikumo joma timbegi richo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.8",
            "verseOrgIds": [
              "PSA.91.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 91:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka iwacho niya, \"Jehova Nyasaye e kar pondona,\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.9",
            "verseOrgIds": [
              "PSA.91.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:9"
      },
      "items": [
        {
          "text": "kendo iketo Nyasaye Man Malo Moloyo kar dakni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.9",
            "verseOrgIds": [
              "PSA.91.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 91:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "to onge gimoro amora marach ma notimreni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.10",
            "verseOrgIds": [
              "PSA.91.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:10"
      },
      "items": [
        {
          "text": "kendo onge masira ma nosud machiegni gi odi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.10",
            "verseOrgIds": [
              "PSA.91.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 91:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar obiro miyo malaika mage chik nikech in",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.11",
            "verseOrgIds": [
              "PSA.91.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:11"
      },
      "items": [
        {
          "text": "mondo giriti e yoreni duto;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.11",
            "verseOrgIds": [
              "PSA.91.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 91:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "gibiro tingʼi malo e lwetgi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.12",
            "verseOrgIds": [
              "PSA.91.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:12"
      },
      "items": [
        {
          "text": "mondo kik ichwany tiendi e kidi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.12",
            "verseOrgIds": [
              "PSA.91.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 91:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ininyon sibuor gi thuond fu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.13",
            "verseOrgIds": [
              "PSA.91.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:13"
      },
      "items": [
        {
          "text": "adier ininyon sibuor maratego gi thuol maduongʼ man-gi kwiri marach.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.13",
            "verseOrgIds": [
              "PSA.91.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 91:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye wacho niya, \"Abiro rese nikech ohera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.14",
            "verseOrgIds": [
              "PSA.91.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:14"
      },
      "items": [
        {
          "text": "abiro rite nikech ohulo nyinga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.14",
            "verseOrgIds": [
              "PSA.91.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 91:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enoluonga, kendo anadwoke;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.15",
            "verseOrgIds": [
              "PSA.91.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:15"
      },
      "items": [
        {
          "text": "anabed kode e chandruok,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.15",
            "verseOrgIds": [
              "PSA.91.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:15"
      },
      "items": [
        {
          "text": "adier, anakonye kendo anamiye duongʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.15",
            "verseOrgIds": [
              "PSA.91.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 91:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anami odag amingʼa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.16",
            "verseOrgIds": [
              "PSA.91.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:16"
      },
      "items": [
        {
          "text": "kendo ananyise warruokna.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.16",
            "verseOrgIds": [
              "PSA.91.16"
            ]
          }
        }
      ]
    }
  ],
