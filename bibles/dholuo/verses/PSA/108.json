  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "108",
        "style": "c",
        "sid": "PSA 108"
      },
      "items": [
        {
          "text": "108",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 108",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Wer. Zaburi mar Daudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 108:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chunya ochungʼ mongirore, yaye Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.1",
            "verseOrgIds": [
              "PSA.108.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:1"
      },
      "items": [
        {
          "text": "abiro paki gi wer kendo abiro loso mamit gi chunya duto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.1",
            "verseOrgIds": [
              "PSA.108.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 108:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiewuru, un orutu gi nyatiti!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.2",
            "verseOrgIds": [
              "PSA.108.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:2"
      },
      "items": [
        {
          "text": "Abiro chiewo kogwen.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.2",
            "verseOrgIds": [
              "PSA.108.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 108:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro paki e dier ogendini, yaye Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.3",
            "verseOrgIds": [
              "PSA.108.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:3"
      },
      "items": [
        {
          "text": "abiro werni e dier ogendini.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.3",
            "verseOrgIds": [
              "PSA.108.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 108:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech herani maduongʼ chopo nyaka e polo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.4",
            "verseOrgIds": [
              "PSA.108.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:4"
      },
      "items": [
        {
          "text": "kendo adiera mari chopo nyaka ewi lwasi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.4",
            "verseOrgIds": [
              "PSA.108.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 108:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyingi mondo otingʼ malo moyombo polo, yaye Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.5",
            "verseOrgIds": [
              "PSA.108.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:5"
      },
      "items": [
        {
          "text": "mad duongʼ mari opongʼ piny duto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.5",
            "verseOrgIds": [
              "PSA.108.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 108:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reswa kendo konywa gi lweti ma korachwich,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.6",
            "verseOrgIds": [
              "PSA.108.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:6"
      },
      "items": [
        {
          "text": "mondo joma ihero ogol e chandruok.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.6",
            "verseOrgIds": [
              "PSA.108.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 108:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye osewuoyo gie kare maler kowacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.7",
            "verseOrgIds": [
              "PSA.108.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:7"
      },
      "items": [
        {
          "text": "\"Abiro pogo Shekem ne ji,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.7",
            "verseOrgIds": [
              "PSA.108.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:7"
      },
      "items": [
        {
          "text": "kendo abiro pimo ne ji Holo mar Sukoth.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.7",
            "verseOrgIds": [
              "PSA.108.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 108:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gilead en mara, Manase bende mara,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.8",
            "verseOrgIds": [
              "PSA.108.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:8"
      },
      "items": [
        {
          "text": "Efraim en oguta mar lweny,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.8",
            "verseOrgIds": [
              "PSA.108.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:8"
      },
      "items": [
        {
          "text": "to Juda en osimbona mar loch.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.8",
            "verseOrgIds": [
              "PSA.108.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 108:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moab en besen mara mar luok,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.9",
            "verseOrgIds": [
              "PSA.108.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:9"
      },
      "items": [
        {
          "text": "to Edom e kama amoe wuochena;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.9",
            "verseOrgIds": [
              "PSA.108.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:9"
      },
      "items": [
        {
          "text": "Filistia ema akoke ka aseloyo lweny.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.9",
            "verseOrgIds": [
              "PSA.108.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 108:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "En ngʼa mabiro kela e dala maduongʼ mochiel motegno?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.10",
            "verseOrgIds": [
              "PSA.108.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:10"
      },
      "items": [
        {
          "text": "En ngʼa mabiro telona nyaka Edom?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.10",
            "verseOrgIds": [
              "PSA.108.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 108:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Donge in ema isedagiwa, yaye Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.11",
            "verseOrgIds": [
              "PSA.108.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:11"
      },
      "items": [
        {
          "text": "kendo tinde ok idhi gi jolwenjwa e lweny?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.11",
            "verseOrgIds": [
              "PSA.108.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 108:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miwa kony mondo walo wasikwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.12",
            "verseOrgIds": [
              "PSA.108.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:12"
      },
      "items": [
        {
          "text": "nikech kony mar dhano onge tich.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.12",
            "verseOrgIds": [
              "PSA.108.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 108:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabiro loyo lweny ka Nyasaye nikodwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.13",
            "verseOrgIds": [
              "PSA.108.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:13"
      },
      "items": [
        {
          "text": "kendo obiro nyono wasikwa piny.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.13",
            "verseOrgIds": [
              "PSA.108.14"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.109",
    "number": "109",
