      "attrs": {
        "style": "q2",
        "vid": "PSA 35:16"
      },
      "items": [
        {
          "text": "ne gijara ka gichano timona marach, ne gikayona lekegi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.16",
            "verseOrgIds": [
              "PSA.35.16"
            ]
          }
