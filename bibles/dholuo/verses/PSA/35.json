      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:25"
      },
      "items": [
        {
          "text": "Kata giwach niya, \"Koro wasemuonye ngili.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.25",
            "verseOrgIds": [
              "PSA.35.25"
            ]
          }
        }
