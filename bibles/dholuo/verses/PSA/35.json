          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yala kichwaka kuom timni makare, yaye Jehova Nyasaye ma Nyasacha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.24",
            "verseOrgIds": [
              "PSA.35.24"
            ]
          }
        }
