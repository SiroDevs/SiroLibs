      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:25"
      },
      "items": [
        {
          "text": "\"Ero, otimorene mana kaka ne wadwaro.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.25",
            "verseOrgIds": [
              "PSA.35.25"
            ]
          }
        }
      ]
    },
