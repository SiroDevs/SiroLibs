          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik iyie ni jogo osungre ni gisenyala,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.19",
            "verseOrgIds": [
              "PSA.35.19"
            ]
          }
        }
