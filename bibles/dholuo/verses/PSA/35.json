      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:17"
      },
      "items": [
        {
          "text": "Res ngimana kuom kethruok duto mag-gi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.17",
            "verseOrgIds": [
              "PSA.35.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:17"
      },
      "items": [
        {
          "text": "Akwayi ni ires ngimana ma nengone tek e lwet sibuochegi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.17",
            "verseOrgIds": [
              "PSA.35.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
