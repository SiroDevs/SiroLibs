      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:19"
      },
      "items": [
        {
          "text": "joma obedo wasika maonge gima omiyo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.19",
            "verseOrgIds": [
              "PSA.35.19"
            ]
          }
        }
      ]
    },
