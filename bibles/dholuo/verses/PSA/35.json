  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "35",
        "style": "c",
        "sid": "PSA 35"
      },
      "items": [
        {
          "text": "35",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 35",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Zaburi mar Daudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye Jehova Nyasaye kedi gi joma kedo koda;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.1",
            "verseOrgIds": [
              "PSA.35.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:1"
      },
      "items": [
        {
          "text": "ked gi joma lawa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.1",
            "verseOrgIds": [
              "PSA.35.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaw kuodi gi okumbani;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.2",
            "verseOrgIds": [
              "PSA.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:2"
      },
      "items": [
        {
          "text": "aa malo mondo ibi ikonya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.2",
            "verseOrgIds": [
              "PSA.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chom tongʼ ma dhoge bith mar kedo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.3",
            "verseOrgIds": [
              "PSA.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:3"
      },
      "items": [
        {
          "text": "ibwog-go joma lawa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.3",
            "verseOrgIds": [
              "PSA.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 35:3"
      },
      "items": [
        {
          "text": "Wuo gi chunya kiwachone niya, \"An e warruokni.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.3",
            "verseOrgIds": [
              "PSA.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad joma dwaro ketho ngimana,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.4",
            "verseOrgIds": [
              "PSA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:4"
      },
      "items": [
        {
          "text": "ne wichkuot gi achaya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.4",
            "verseOrgIds": [
              "PSA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 35:4"
      },
      "items": [
        {
          "text": "Mad joma chanona hinyruok,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.4",
            "verseOrgIds": [
              "PSA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:4"
      },
      "items": [
        {
          "text": "chunygi nyosre mi giweya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.4",
            "verseOrgIds": [
              "PSA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad gichal gi mihudhi ma yamo tero,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.5",
            "verseOrgIds": [
              "PSA.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:5"
      },
      "items": [
        {
          "text": "ka malaika mar Jehova Nyasaye riembogi mabor;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.5",
            "verseOrgIds": [
              "PSA.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "mad yore ma giluwo bed gi mudho",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.6",
            "verseOrgIds": [
              "PSA.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:6"
      },
      "items": [
        {
          "text": "bende yoregigo obed makierogi ka malaika mar Jehova Nyasaye lawogi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.6",
            "verseOrgIds": [
              "PSA.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech gichikona obadhogi kayiem nono",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.7",
            "verseOrgIds": [
              "PSA.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:7"
      },
      "items": [
        {
          "text": "kendo gikunyona bur kayiem mondo alwarie;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.7",
            "verseOrgIds": [
              "PSA.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "mad kethruok jukgi apoya ka gikia",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.8",
            "verseOrgIds": [
              "PSA.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:8"
      },
      "items": [
        {
          "text": "mad obadhogi ma gisechikona makgi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.8",
            "verseOrgIds": [
              "PSA.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:8"
      },
      "items": [
        {
          "text": "mad gilwar ei bur ma kargi lal nono.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.8",
            "verseOrgIds": [
              "PSA.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka chunya nobed mamor kuom Jehova Nyasaye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.9",
            "verseOrgIds": [
              "PSA.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:9"
      },
      "items": [
        {
          "text": "kendo anabed gimor kuom warruokne.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.9",
            "verseOrgIds": [
              "PSA.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ringra gi chunya duto, biro hulo kawacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.10",
            "verseOrgIds": [
              "PSA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:10"
      },
      "items": [
        {
          "text": "\"En ngʼa machalo kodi, yaye Jehova Nyasaye.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.10",
            "verseOrgIds": [
              "PSA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 35:10"
      },
      "items": [
        {
          "text": "Ireso joma odhier e lwet joma nigi teko moloyogi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.10",
            "verseOrgIds": [
              "PSA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:10"
      },
      "items": [
        {
          "text": "Adier, ikonyo joma odhier gi jochan kuom joma mayogi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.10",
            "verseOrgIds": [
              "PSA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma timo neno ma wengegi tek sudo nyime;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.11",
            "verseOrgIds": [
              "PSA.35.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:11"
      },
      "items": [
        {
          "text": "gipenja gik ma ok angʼeyo gimoro amora kuomgi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.11",
            "verseOrgIds": [
              "PSA.35.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gichula rach kar ber,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.12",
            "verseOrgIds": [
              "PSA.35.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:12"
      },
      "items": [
        {
          "text": "kendo giweyo chunya kochwanyore.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.12",
            "verseOrgIds": [
              "PSA.35.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "To kane gituo magihewore to ne arwako law ywagruok",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.13",
            "verseOrgIds": [
              "PSA.35.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:13"
      },
      "items": [
        {
          "text": "kendo ne abolora katweyo chiemo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.13",
            "verseOrgIds": [
              "PSA.35.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 35:13"
      },
      "items": [
        {
          "text": "Kane lamona ok odwoki,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.13",
            "verseOrgIds": [
              "PSA.35.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne awuotho koni gi koni ka chunya lit,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.14",
            "verseOrgIds": [
              "PSA.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:14"
      },
      "items": [
        {
          "text": "mana ka gima aywago osiepna kata owadwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.14",
            "verseOrgIds": [
              "PSA.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 35:14"
      },
      "items": [
        {
          "text": "Ne akulo wiya ka an gi kuyo maduongʼ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.14",
            "verseOrgIds": [
              "PSA.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:14"
      },
      "items": [
        {
          "text": "mana ka gima aywago minwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.14",
            "verseOrgIds": [
              "PSA.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "To kane achwanyora, negichokore kaachiel gi mor;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.15",
            "verseOrgIds": [
              "PSA.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:15"
      },
      "items": [
        {
          "text": "joma ne monja nochokorena sa ma ok angʼeyo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.15",
            "verseOrgIds": [
              "PSA.35.15"
            ]
          }
