      "attrs": {
        "style": "q2",
        "vid": "PSA 35:18"
      },
      "items": [
        {
          "text": "abiro paki e dier oganda maduongʼ mochokore kaachiel.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.18",
            "verseOrgIds": [
              "PSA.35.18"
            ]
          }
        }
      ]
