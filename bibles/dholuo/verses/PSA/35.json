      "attrs": {
        "style": "q2",
        "vid": "PSA 35:22"
      },
      "items": [
        {
          "text": "Kik ibed koda mabor, yaye Ruoth Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.22",
            "verseOrgIds": [
              "PSA.35.22"
            ]
          }
        }
      ]
    },
