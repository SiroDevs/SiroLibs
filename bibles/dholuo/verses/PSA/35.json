          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaka joma ok oluoro Nyasaye chayo ji,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.16",
            "verseOrgIds": [
              "PSA.35.16"
            ]
