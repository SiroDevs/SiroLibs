      "attrs": {
        "style": "q2",
        "vid": "PSA 35:23"
      },
      "items": [
        {
          "text": "Kedna, yaye Nyasacha kendo Ruodha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.23",
            "verseOrgIds": [
              "PSA.35.23"
            ]
          }
        }
