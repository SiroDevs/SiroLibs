      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 35:19"
      },
      "items": [
        {
          "text": "iyie joma ochaya maonge gimoro sigre",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.19",
            "verseOrgIds": [
              "PSA.35.19"
            ]
          }
        }
