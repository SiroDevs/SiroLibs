      "attrs": {
        "style": "q2",
        "vid": "PSA 35:24"
      },
      "items": [
        {
          "text": "kik iyienegi gisungre ni gisenyala.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.24",
            "verseOrgIds": [
              "PSA.35.24"
            ]
          }
        }
      ]
