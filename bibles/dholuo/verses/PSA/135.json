      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 135",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 135:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuru Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.1",
            "verseOrgIds": [
              "PSA.135.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 135:1"
      },
      "items": [
        {
          "text": "Pakuru nying Jehova Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.1",
            "verseOrgIds": [
              "PSA.135.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:1"
      },
      "items": [
        {
          "text": "pakeuru, un jotich mag Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.1",
            "verseOrgIds": [
              "PSA.135.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 135:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "un mutiyo e od Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.2",
            "verseOrgIds": [
              "PSA.135.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:2"
      },
      "items": [
        {
          "text": "e laru mag od Nyasachwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.2",
            "verseOrgIds": [
              "PSA.135.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 135:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuru Jehova Nyasaye, nimar Jehova Nyasaye ber;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.3",
            "verseOrgIds": [
              "PSA.135.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:3"
      },
      "items": [
        {
          "text": "pakuru nyinge gi wende pak nimar timo kamano en gima ber.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.3",
            "verseOrgIds": [
              "PSA.135.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 135:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar Jehova Nyasaye oseyiero Jakobo, mondo obed gire owuon;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.4",
            "verseOrgIds": [
              "PSA.135.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:4"
      },
      "items": [
        {
          "text": "oseyiero Israel, mondo obed mwandune mogeno.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.4",
            "verseOrgIds": [
              "PSA.135.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 135:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angʼeyo ni Jehova Nyasaye duongʼ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.5",
            "verseOrgIds": [
              "PSA.135.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:5"
      },
      "items": [
        {
          "text": "angʼeyo adier ni Ruoth Nyasachwa duongʼ moloyo nyiseche duto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.5",
            "verseOrgIds": [
              "PSA.135.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 135:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye timo gimoro amora mohero,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.6",
            "verseOrgIds": [
              "PSA.135.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:6"
      },
      "items": [
        {
          "text": "e polo kendo e piny,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.6",
            "verseOrgIds": [
              "PSA.135.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:6"
      },
      "items": [
        {
          "text": "ei nembe kendo e kudegi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.6",
            "verseOrgIds": [
              "PSA.135.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 135:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo boche wuok koa e tungʼ piny koni gi koni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.7",
            "verseOrgIds": [
              "PSA.135.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:7"
      },
      "items": [
        {
          "text": "kendo ooro mil polo ka koth chue,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.7",
            "verseOrgIds": [
              "PSA.135.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:7"
      },
      "items": [
        {
          "text": "bende okelo yamo kogolo e utege mokanogie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.7",
            "verseOrgIds": [
              "PSA.135.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 135:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ogoyo nyithindo makayo mag Misri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.8",
            "verseOrgIds": [
              "PSA.135.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:8"
      },
      "items": [
        {
          "text": "nyithindo makayo mag dhano kod le.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.8",
            "verseOrgIds": [
              "PSA.135.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 135:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ooro ranyisi gi honni mage e dieru, yaye Misri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.9",
            "verseOrgIds": [
              "PSA.135.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:9"
      },
      "items": [
        {
          "text": "noorogi kuom Farao kaachiel gi jotichne duto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.9",
            "verseOrgIds": [
              "PSA.135.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 135:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ogoyo pinje mangʼeny piny,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.10",
            "verseOrgIds": [
              "PSA.135.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:10"
      },
      "items": [
        {
          "text": "kendo ne onego ruodhi maroteke,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.10",
            "verseOrgIds": [
              "PSA.135.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 135:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kaka Sihon ruodh jo-Amor,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.11",
            "verseOrgIds": [
              "PSA.135.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:11"
      },
      "items": [
        {
          "text": "gi Og ruodh Bashan,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.11",
            "verseOrgIds": [
              "PSA.135.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:11"
      },
      "items": [
        {
          "text": "kod ruodhi duto mag Kanaan,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.11",
            "verseOrgIds": [
              "PSA.135.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 135:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo nomiyogi piny jogo kaka girkeni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.12",
            "verseOrgIds": [
              "PSA.135.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:12"
      },
      "items": [
        {
          "text": "kaka girkeni ne joge ma gin jo-Israel.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.12",
            "verseOrgIds": [
              "PSA.135.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 135:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye Jehova Nyasaye, nyingi osiko nyaka chiengʼ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.13",
            "verseOrgIds": [
              "PSA.135.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:13"
      },
      "items": [
        {
          "text": "yaye Jehova Nyasaye, humbi ochwere e tienge duto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.13",
            "verseOrgIds": [
              "PSA.135.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 135:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar Jehova Nyasaye biro chwako joge,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.14",
            "verseOrgIds": [
              "PSA.135.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:14"
      },
      "items": [
        {
          "text": "kendo obiro kecho jotichne.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.14",
            "verseOrgIds": [
              "PSA.135.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 135:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyiseche mopa mag ogendini gin fedha gi dhahabu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.15",
            "verseOrgIds": [
              "PSA.135.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:15"
      },
      "items": [
        {
          "text": "molos gi lwet dhano.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.15",
            "verseOrgIds": [
              "PSA.135.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 135:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin gi dhogi, to kata kamano, ok ginyal wuoyo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.16",
            "verseOrgIds": [
              "PSA.135.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:16"
      },
      "items": [
        {
          "text": "gin gi wenge, to ok ginyal neno.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.16",
            "verseOrgIds": [
              "PSA.135.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 135:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin gi it, to ok ginyal winjo wach,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.17",
            "verseOrgIds": [
              "PSA.135.17"
            ]
          }
