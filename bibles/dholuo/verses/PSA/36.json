{
  "id": "PSA.36",
  "number": "36",
  "bookId": "PSA",
  "reference": "Zaburi 36",
  "copyright": "Biblica® Ochiw Thuolo Motingʼo Loko Manyien™ Weg Loko © 1980, 2002, 2003, 2020 otim gi Biblica, Inc. Biblica® Open New Luo Translation™ Copyright © 1980, 2002, 2003, 2020 by Biblica, Inc. \"Biblica\" en sai mondik mongorore e piny Amerika kendo en kido moyie malongʼo e ofis Biblica, Inc. Itiyo kode gi thuolo moa kuom Biblica, Inc. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "36",
        "style": "c",
        "sid": "PSA 36"
      },
      "items": [
        {
          "text": "36",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 36",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kuom jatend wer. Zaburi mar Daudi jatich Jehova Nyasaye.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "An-gi wach e chunya mowuok kuom Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.1",
            "verseOrgIds": [
              "PSA.36.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:1"
      },
      "items": [
        {
          "text": "kuom gima joricho timo:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.1",
            "verseOrgIds": [
              "PSA.36.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 36:1"
      },
      "items": [
        {
          "text": "Ok giluoro Nyasaye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.1",
            "verseOrgIds": [
              "PSA.36.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:1"
      },
      "items": [
        {
          "text": "kata matin.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.1",
            "verseOrgIds": [
              "PSA.36.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech chunye wuonde kendo owuondore kende,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.2",
            "verseOrgIds": [
              "PSA.36.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:2"
      },
      "items": [
        {
          "text": "chunye wuonde ma ok onyal neno richone mosin-go.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.2",
            "verseOrgIds": [
              "PSA.36.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weche mawuok e dhoge richo kendo gin miriambo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.3",
            "verseOrgIds": [
              "PSA.36.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:3"
      },
      "items": [
        {
          "text": "oseweyo bedo mariek kod timo maber.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.3",
            "verseOrgIds": [
              "PSA.36.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata konindo e kitandane, to ochano timo gima rach;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.4",
            "verseOrgIds": [
              "PSA.36.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:4"
      },
      "items": [
        {
          "text": "oseketo chunye mar luwo yor richo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.4",
            "verseOrgIds": [
              "PSA.36.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:4"
      },
      "items": [
        {
          "text": "kendo ok otamre gima rach.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.4",
            "verseOrgIds": [
              "PSA.36.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Herani ochopo nyaka e polo malo, yaye Jehova Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.5",
            "verseOrgIds": [
              "PSA.36.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:5"
      },
      "items": [
        {
          "text": "adierani chopo nyaka e polo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.5",
            "verseOrgIds": [
              "PSA.36.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timni makare chalo gi gode madongo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.6",
            "verseOrgIds": [
              "PSA.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:6"
      },
      "items": [
        {
          "text": "ratiro mari chalo gi kut matut.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.6",
            "verseOrgIds": [
              "PSA.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 36:6"
      },
      "items": [
        {
          "text": "Yaye Jehova Nyasaye, in ema irito ngima dhano gi le.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.6",
            "verseOrgIds": [
              "PSA.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mano kaka herani ma ok rum nengone tek, yaye Nyasaye!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.7",
            "verseOrgIds": [
              "PSA.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 36:7"
      },
      "items": [
        {
          "text": "Joma idewo kaachiel gi joma ni piny",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.7",
            "verseOrgIds": [
              "PSA.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:7"
      },
      "items": [
        {
          "text": "yudo kar pondo margi e bwo tipo mar bwombeni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.7",
            "verseOrgIds": [
              "PSA.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gichamo chiemo mangʼeny e hekalu mari ka gimor;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.8",
            "verseOrgIds": [
              "PSA.36.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:8"
      },
      "items": [
        {
          "text": "imiyogi math moa e aorani mar mor.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.8",
            "verseOrgIds": [
              "PSA.36.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar in ema in gi soko mar pi mar ngima;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.9",
            "verseOrgIds": [
              "PSA.36.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:9"
      },
      "items": [
        {
          "text": "kuom lerni ema wanenoe ler.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.9",
            "verseOrgIds": [
              "PSA.36.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Med nyiso herani ni joma ongʼeyi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.10",
            "verseOrgIds": [
              "PSA.36.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:10"
      },
      "items": [
        {
          "text": "med nyiso timni makare ne joma gie chunygi ni kare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.10",
            "verseOrgIds": [
              "PSA.36.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad tiend joma sungore kik nyona,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.11",
            "verseOrgIds": [
              "PSA.36.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:11"
      },
      "items": [
        {
          "text": "kata lwet joma timbegi richo gola kama antie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.11",
            "verseOrgIds": [
              "PSA.36.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neye kaka joma timo gik maricho oriere piny kopodho",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.12",
            "verseOrgIds": [
              "PSA.36.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 36:12"
      },
      "items": [
        {
          "text": "osedirgi piny ma ok ginyal aa malo!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.12",
            "verseOrgIds": [
              "PSA.36.13"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.37",
    "number": "37",
    "bookId": "PSA"
  },
  "previous": {
    "id": "PSA.35",
    "number": "35",
