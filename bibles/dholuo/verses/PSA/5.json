  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "PSA 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kuom jatend wende miwero gi asili. Zaburi Mar Daudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chik iti mondo iwinj wechena, yaye Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.1",
            "verseOrgIds": [
              "PSA.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:1"
      },
      "items": [
        {
          "text": "para kuom pek manie chunya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.1",
            "verseOrgIds": [
              "PSA.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Winj ywakna mar dwaro kony,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.2",
            "verseOrgIds": [
              "PSA.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:2"
      },
      "items": [
        {
          "text": "Yaye Ruodha kendo Nyasacha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.2",
            "verseOrgIds": [
              "PSA.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:2"
      },
      "items": [
        {
          "text": "nikech in ema alami.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.2",
            "verseOrgIds": [
              "PSA.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yie iwinj dwonda gokinyi, yaye Jehova Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.3",
            "verseOrgIds": [
              "PSA.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:3"
      },
      "items": [
        {
          "text": "aketo kwayona e nyimi gokinyi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.3",
            "verseOrgIds": [
              "PSA.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:3"
      },
      "items": [
        {
          "text": "kendo arito dwoko ka an gi geno.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.3",
            "verseOrgIds": [
              "PSA.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ok in Nyasaye mamor gi timbe maricho.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.4",
            "verseOrgIds": [
              "PSA.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:4"
      },
      "items": [
        {
          "text": "Joma richo ok nyal dak kodi kanyachiel.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.4",
            "verseOrgIds": [
              "PSA.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josunga ok nyal chungʼ e nyimi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.5",
            "verseOrgIds": [
              "PSA.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:5"
      },
      "items": [
        {
          "text": "imon gi ji duto matimo gik maricho.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.5",
            "verseOrgIds": [
              "PSA.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itieko joma wacho miriambo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.6",
            "verseOrgIds": [
              "PSA.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:6"
      },
      "items": [
        {
          "text": "Jehova Nyasaye ok mor gi joma dwaro chwero remo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.6",
            "verseOrgIds": [
              "PSA.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:6"
      },
      "items": [
        {
          "text": "kod jo-miriambo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.6",
            "verseOrgIds": [
              "PSA.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "An to, nikech kechni maduongʼ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.7",
            "verseOrgIds": [
              "PSA.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:7"
      },
      "items": [
        {
          "text": "abiro donjo e odi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.7",
            "verseOrgIds": [
              "PSA.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 5:7"
      },
      "items": [
        {
          "text": "abiro kulora gi luor",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.7",
            "verseOrgIds": [
              "PSA.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:7"
      },
      "items": [
        {
          "text": "ka achomo hekalu mari maler.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.7",
            "verseOrgIds": [
              "PSA.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Telna, yaye Jehova Nyasaye, kuom adiera mari,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.8",
            "verseOrgIds": [
              "PSA.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:8"
      },
      "items": [
        {
          "text": "nikech wasigu molwora,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.8",
            "verseOrgIds": [
              "PSA.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:8"
      },
      "items": [
        {
          "text": "yie iriena yori tir e nyima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.8",
            "verseOrgIds": [
              "PSA.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata wach achiel mowuok e dho jogi ok nyal gen;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.9",
            "verseOrgIds": [
              "PSA.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:9"
      },
      "items": [
        {
          "text": "chunygi opongʼ gi kethruok.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.9",
            "verseOrgIds": [
              "PSA.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 5:9"
      },
      "items": [
        {
          "text": "Dwondgi chalo gi liel mapok oum;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.9",
            "verseOrgIds": [
              "PSA.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:9"
      },
      "items": [
        {
          "text": "lewgi olony e wacho miriambo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.9",
            "verseOrgIds": [
              "PSA.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwan-gi kaka joketho, yaye Nyasaye!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.10",
            "verseOrgIds": [
              "PSA.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:10"
      },
      "items": [
        {
          "text": "Ket obadho ma giketo ne ji ogajgi gin giwegi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.10",
            "verseOrgIds": [
              "PSA.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 5:10"
      },
      "items": [
        {
          "text": "Riembgi nikech richogi mathoth,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.10",
            "verseOrgIds": [
              "PSA.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:10"
      },
      "items": [
        {
          "text": "nimar gisengʼanyoni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.10",
            "verseOrgIds": [
              "PSA.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "We ji duto moketi kar pondo margi obed mamor;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.11",
            "verseOrgIds": [
              "PSA.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:11"
      },
      "items": [
        {
          "text": "we gisiki ka giwer gimor.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.11",
            "verseOrgIds": [
              "PSA.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 5:11"
      },
      "items": [
        {
          "text": "Umgi gi rit mari,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.11",
            "verseOrgIds": [
              "PSA.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:11"
      },
      "items": [
        {
          "text": "mondo joma ohero nyingi omor kodi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.11",
            "verseOrgIds": [
              "PSA.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech igwedho joma kare adier, yaye Jehova Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.12",
            "verseOrgIds": [
              "PSA.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:12"
      },
      "items": [
        {
          "text": "igengʼogi gi hapi mana ka okumba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.12",
            "verseOrgIds": [
              "PSA.5.13"
            ]
          }
        }
      ]
    }
  ],
