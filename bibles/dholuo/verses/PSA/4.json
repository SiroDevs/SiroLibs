  "verseCount": 8,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "PSA 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kuom jatend wer. Miwero gi gig wer man-gi tondegi. Zaburi mar Daudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka aluongi to yie idwoka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.1",
            "verseOrgIds": [
              "PSA.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:1"
      },
      "items": [
        {
          "text": "yaye Nyasacha makare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.1",
            "verseOrgIds": [
              "PSA.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 4:1"
      },
      "items": [
        {
          "text": "Konya e lit momako chunya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.1",
            "verseOrgIds": [
              "PSA.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:1"
      },
      "items": [
        {
          "text": "yie ikecha kendo iwinj lamona.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.1",
            "verseOrgIds": [
              "PSA.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye, ubiro chayo duongʼ ka ukuodo wiya nyaka karangʼo?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.2",
            "verseOrgIds": [
              "PSA.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:2"
      },
      "items": [
        {
          "text": "Ubiro hero gik manono kendo luwo nyiseche manono nyaka karangʼo?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.2",
            "verseOrgIds": [
              "PSA.4.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.4.2",
                "verseOrgIds": [
                  "PSA.4.3"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼeuru ni Jehova Nyasaye oseyiera mondo abed mare owuon;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.3",
            "verseOrgIds": [
              "PSA.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:3"
      },
      "items": [
        {
          "text": "kendo Jehova Nyasaye winja, ka aluonge.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.3",
            "verseOrgIds": [
              "PSA.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka iu owangʼ to kik utim richo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.4",
            "verseOrgIds": [
              "PSA.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:4"
      },
      "items": [
        {
          "text": "seche ma uyweyo mos e kitandau,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.4",
            "verseOrgIds": [
              "PSA.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 4:4"
      },
      "items": [
        {
          "text": "to nonuru chunyu ka ulingʼ mos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.4",
            "verseOrgIds": [
              "PSA.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:4"
      },
      "items": [
        {
          "text": "keturu chunyu mos ka unindo e kitandau.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.4",
            "verseOrgIds": [
              "PSA.4.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.4.4",
                "verseOrgIds": [
                  "PSA.4.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiwuru misengini mowinjore",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.5",
            "verseOrgIds": [
              "PSA.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:5"
      },
      "items": [
        {
          "text": "kendo genuru kuom Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.5",
            "verseOrgIds": [
              "PSA.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji mangʼeny penjo niya, \"En ngʼa manyalo timonwa gimoro maber?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.6",
            "verseOrgIds": [
              "PSA.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:6"
      },
      "items": [
        {
          "text": "Mad ler moa e lela wangʼi rieny kuomwa, yaye Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.6",
            "verseOrgIds": [
              "PSA.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isepongʼo chunya gi mor maduongʼ moloyo mor ma gin-go",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.7",
            "verseOrgIds": [
              "PSA.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:7"
      },
      "items": [
        {
          "text": "e kinde ma gin-gi cham kod divai mangʼeny.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.7",
            "verseOrgIds": [
              "PSA.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro riera piny mi anind gi kwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.8",
            "verseOrgIds": [
              "PSA.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:8"
      },
      "items": [
        {
          "text": "nikech in kendi, yaye Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.8",
            "verseOrgIds": [
              "PSA.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:8"
      },
      "items": [
        {
          "text": "in ema imiyo adak gi kwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.8",
            "verseOrgIds": [
              "PSA.4.9"
            ]
          }
        }
      ]
    }
  ],
