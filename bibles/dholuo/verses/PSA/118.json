          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 118:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo-Israel mondo owach niya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.2",
            "verseOrgIds": [
              "PSA.118.2"
            ]
