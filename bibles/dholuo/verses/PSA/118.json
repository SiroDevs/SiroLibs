      "attrs": {
        "style": "q2",
        "vid": "PSA 118:2"
      },
      "items": [
        {
          "text": "\"Herane osiko nyaka chiengʼ.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.2",
            "verseOrgIds": [
              "PSA.118.2"
            ]
          }
        }
      ]
    },
    {
