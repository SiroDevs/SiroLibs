          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gouru erokamano ne Jehova Nyasaye, nimar ober;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.1",
            "verseOrgIds": [
              "PSA.118.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 118:1"
      },
      "items": [
        {
          "text": "kendo herane osiko nyaka chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.1",
            "verseOrgIds": [
              "PSA.118.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
