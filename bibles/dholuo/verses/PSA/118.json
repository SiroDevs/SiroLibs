      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 118:12"
      },
      "items": [
        {
          "text": "to ne githo ka mach ma wangʼo kudho;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.12",
            "verseOrgIds": [
              "PSA.118.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 118:12"
      },
      "items": [
        {
          "text": "mine atiekogi e nying Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.12",
            "verseOrgIds": [
              "PSA.118.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
