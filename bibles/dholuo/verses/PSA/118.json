      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 118:10"
      },
      "items": [
        {
          "text": "to ne atiekogi e nying Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.10",
            "verseOrgIds": [
              "PSA.118.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 118:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne gilwora koni gi koni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.11",
            "verseOrgIds": [
              "PSA.118.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 118:11"
      },
      "items": [
        {
          "text": "to ne atiekogi e nying Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.11",
            "verseOrgIds": [
              "PSA.118.11"
            ]
          }
        }
      ]
