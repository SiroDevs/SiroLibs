      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 118:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ginur kuoma ka kich,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.12",
            "verseOrgIds": [
              "PSA.118.12"
            ]
          }
        }
      ]
    },
