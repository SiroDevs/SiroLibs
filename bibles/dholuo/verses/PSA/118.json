            "sid": "PSA 118:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo-dhood Harun mondo owach niya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.3",
            "verseOrgIds": [
              "PSA.118.3"
            ]
          }
        }
