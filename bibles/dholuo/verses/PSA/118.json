          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogendini duto nolwora koni gi koni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.10",
            "verseOrgIds": [
              "PSA.118.10"
            ]
          }
        }
