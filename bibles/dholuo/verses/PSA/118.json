          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne gidhira gichien kendo ne achiegni podho,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.13",
            "verseOrgIds": [
              "PSA.118.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 118:13"
      },
      "items": [
        {
          "text": "to Jehova Nyasaye nokonya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.13",
            "verseOrgIds": [
              "PSA.118.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 118:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye e tekra kendo en e wenda;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.14",
            "verseOrgIds": [
              "PSA.118.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 118:14"
      },
      "items": [
        {
          "text": "osedoko warruok mara.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.14",
            "verseOrgIds": [
              "PSA.118.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 118:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koko mag mor gi mag loch",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.15",
            "verseOrgIds": [
              "PSA.118.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 118:15"
      },
      "items": [
        {
          "text": "winjore ei hembe mag joma kare kama:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.15",
            "verseOrgIds": [
              "PSA.118.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 118:15"
      },
      "items": [
        {
          "text": "\"Lwet Jehova Nyasaye ma korachwich osetimo gik madongo!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.15",
            "verseOrgIds": [
              "PSA.118.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 118:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwet Jehova Nyasaye ma korachwich otingʼ malo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.16",
            "verseOrgIds": [
              "PSA.118.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 118:16"
      },
      "items": [
        {
          "text": "lwet Jehova Nyasaye ma korachwich osetimo gik madongo!\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.16",
            "verseOrgIds": [
              "PSA.118.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 118:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ok abi tho, abiro bedo mangima;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.17",
            "verseOrgIds": [
              "PSA.118.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 118:17"
      },
      "items": [
        {
          "text": "abiro bedo mangima modo ahul gik ma Jehova Nyasaye osetimo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.17",
            "verseOrgIds": [
              "PSA.118.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
