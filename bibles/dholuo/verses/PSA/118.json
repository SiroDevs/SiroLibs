    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 118:3"
      },
      "items": [
        {
          "text": "\"Herane osiko nyaka chiengʼ.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.3",
            "verseOrgIds": [
              "PSA.118.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 118:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma oluoro Jehova Nyasaye mondo owach niya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.4",
            "verseOrgIds": [
              "PSA.118.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 118:4"
      },
      "items": [
        {
          "text": "\"Herane osiko nyaka chiengʼ.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.4",
            "verseOrgIds": [
              "PSA.118.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 118:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne aywak ne Jehova Nyasaye kane chunya lit,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.5",
            "verseOrgIds": [
              "PSA.118.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 118:5"
      },
      "items": [
        {
          "text": "kendo ne odwoka mine ogonya thuolo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.5",
            "verseOrgIds": [
              "PSA.118.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 118:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye ni koda, omiyo ok analuor.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.6",
            "verseOrgIds": [
              "PSA.118.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 118:6"
      },
      "items": [
        {
          "text": "Ere gima dhano ditimna?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.6",
            "verseOrgIds": [
              "PSA.118.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 118:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye ni koda; en e Jakonyna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.7",
            "verseOrgIds": [
              "PSA.118.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 118:7"
      },
      "items": [
        {
          "text": "Abiro neno gi wangʼa ka olo wasika.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.7",
            "verseOrgIds": [
              "PSA.118.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 118:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ber pondo kuom Jehova Nyasaye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.8",
            "verseOrgIds": [
              "PSA.118.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 118:8"
      },
      "items": [
        {
          "text": "moloyo geno kuom dhano.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.8",
            "verseOrgIds": [
              "PSA.118.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
