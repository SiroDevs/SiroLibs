          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kiristoosiin Jireenya Argachuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EPH 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin irra daddarbaa keessanii fi cubbuu keessaniin duutanii turtan;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.1",
            "verseOrgIds": [
              "EPH.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EPH 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis isuma isin yeroo jireenya addunyaa kanaatii fi bulchaa mootummaa qilleensaa jechuunis hafuura amma iyyuu warra hin ajajamne keessatti hojjetu duukaa buutanitti keessa jiraachaa turtanii dha.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.2",
            "verseOrgIds": [
              "EPH.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EPH 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hundi keenyas yeroo tokko dharraa foon keenyaa guutaa, hawwii fi yaada isaa duukaa buʼaa isaan gidduu jiraanne. Uumama keenyaanis akkuma warra kaanii dheekkamsa jala turre.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.3",
            "verseOrgIds": [
              "EPH.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EPH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu Waaqni araaraan guutame sun sababii jaalala guddaa nuu qabuuf,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.4",
            "verseOrgIds": [
              "EPH.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EPH 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "yeroo nu irra daddarbaa keenyaan duunee turretti illee Kiristoos wajjin jiraattota nu taasise; isinis ayyaanaan fayyina argattan.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.5",
            "verseOrgIds": [
              "EPH.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqnis Kiristoos wajjin duʼaa nu kaase; karaa Kiristoos Yesuusiinis isa wajjin iddoo samii irra nu teessise;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.6",
            "verseOrgIds": [
              "EPH.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EPH 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "innis bara dhufuuf jiru keessa badhaadhummaa ayyaana isaa kan gita hin qabne sana arjummaa karaa Kiristoos Yesuusiin nuuf qabu argisiisuuf jedhee waan kana godhe.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.7",
            "verseOrgIds": [
              "EPH.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EPH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isinis ayyaanaan karaa amantiitiin fayyitaniirtuutii; kunis kennaa Waaqaati malee hojii ofii keessanii miti;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.8",
            "verseOrgIds": [
              "EPH.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EPH 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "akka namni tokko iyyuu of hin jajneefis kun hojiidhaan miti.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.9",
            "verseOrgIds": [
              "EPH.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EPH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu hojii harka isaatii; hojii gaarii Waaqni duraan dursee akka nu hojjennuuf qopheesse sana akka hojjennuufis karaa Kiristoos Yesuusiin uumamne.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.10",
            "verseOrgIds": [
              "EPH.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kiristoosiin Tokko Taʼuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EPH 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaaf isin warri durumaa dhalootaan Namoota Ormaa taatan akka warra dhagna qabaa harka namaatiin dhagna namaa irratti hojjetamuun, \"Nu warra dhagna qabatee dha\" ofiin jedhan biratti \"Warra dhagna hin qabatin\" jedhamtanii waamamtan sana yaadadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.11",
            "verseOrgIds": [
              "EPH.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EPH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "isin akka yeroo sana Kiristoos irraa cittanii, lammummaa Israaʼel keessaa baafamtanii, kakuu waadaatiifis keessumoota taatanii, abdii malee, Waaqa malees addunyaa keessa turtan yaadadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.12",
            "verseOrgIds": [
              "EPH.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EPH 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma garuu isin warri yeroo tokko fagoo turtan Kiristoos Yesuusiin dhiiga Kiristoosiin dhiʼeeffamtaniirtu.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.13",
            "verseOrgIds": [
              "EPH.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EPH 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiristoos nagaa keenyaatii; innis dallaa diinummaa kan gargar baasu sana diigee jara lamaanuu tokko godheera;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.14",
            "verseOrgIds": [
              "EPH.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EPH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "inni foon ofiitiin seera ajajaa fi sirna isaa wajjin diigeera. Kaayyoon isaas jara lamaan keessaa ofuma isaatiin nama haaraa tokko uumee akkasiin nagaa buusuudhaan",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.15",
            "verseOrgIds": [
              "EPH.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EPH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "fannoo ittiin diinummaa isaanii ajjeese sanaan lamaan isaanii iyyuu dhagna tokko godhee Waaqatti araarse.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.16",
            "verseOrgIds": [
              "EPH.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EPH 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis dhufee isin warra fagoo turtanitti nagaa, warra dhiʼoo turanittis nagaa lallabe.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.17",
            "verseOrgIds": [
              "EPH.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EPH 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu lamaanuu karaa isaatiin Hafuura tokkicha sanaan akka itti Abbaa bira geenyu qabnaatii.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.18",
            "verseOrgIds": [
              "EPH.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu isin siʼachi saba Waaqaa wajjin lammii fi miseensota warra mana Waaqaa jiraataniiti malee ormaa fi alagoota miti;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.19",
            "verseOrgIds": [
              "EPH.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "isin hundee ergamootaa fi raajotaa irratti ijaaramtaniirtu; Kiristoos Yesuus ofii isaatii mataa dhagaa golee ti.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.20",
            "verseOrgIds": [
              "EPH.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EPH 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karaa isaas ijaarsi sun guutuun tokkummaan wal qabatee mana qulqullummaa qulqulluu taʼuuf Gooftaadhaan guddata.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.21",
            "verseOrgIds": [
              "EPH.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EPH 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isinis isumaan mana Waaqni Hafuura isaatiin keessa jiraatu taatanii tokkummaadhaan ijaaramaa jirtu.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.22",
            "verseOrgIds": [
              "EPH.2.22"
            ]
          }
        }
      ]
    }
  ],
