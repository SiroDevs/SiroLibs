  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "EPH 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "nb"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EPH 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaaf akkuma ijoollee jaallatamootti fakkeenya Waaqaa duukaa buʼaa;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.1",
            "verseOrgIds": [
              "EPH.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EPH 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkuma Kiristoos nu jaallatee nuufis jedhee akka aarsaa fi qalma urgaaʼuutti Waaqaaf of kenne sana isinis jaalalaan deddeebiʼaa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.2",
            "verseOrgIds": [
              "EPH.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EPH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu waaʼeen halalummaa yookaan xuraaʼummaa gosa kamii iyyuu yookaan waaʼeen doqnummaa gidduu keessanitti hin dhagaʼamin; wanni akkasii qulqulloota Waaqaa biratti hin barbaachisuutii.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.3",
            "verseOrgIds": [
              "EPH.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EPH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Galateeffachuu malee haasaan qaanii yookaan dubbiin gowwummaa kan faayidaa hin qabne yookaan qoosaan namatti hin tolle isin gidduu hin jiraatin.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.4",
            "verseOrgIds": [
              "EPH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EPH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halaleen yookaan xuraaʼaan yookaan sassattuun jechuunis kan Waaqa tolfamaa waaqeffatu mootummaa Kiristoosii fi kan Waaqaa keessaa akka dhaala tokko illee hin qabne beekaa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.5",
            "verseOrgIds": [
              "EPH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni tokko iyyuu dubbii faayidaa hin qabneen isin hin gowwoomsin; sababii waan akkanaatiif dheekkamsi Waaqaa warra hin ajajamnetti ni dhufaatii.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.6",
            "verseOrgIds": [
              "EPH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EPH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu isin waan isaan hojjetan keessatti hin hirmaatinaa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.7",
            "verseOrgIds": [
              "EPH.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EPH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin dur dukkana turtaniitii; amma garuu Gooftaadhaan ifa taataniirtu. Akka ijoollee ifaatti jiraadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.8",
            "verseOrgIds": [
              "EPH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EPH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "iji ifaa gaarummaa, qajeelummaa fi dhugaa hunda keessatti argamaatii;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.9",
            "verseOrgIds": [
              "EPH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EPH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "waan Gooftaa gammachiisu qoradhaa bira gaʼaa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.10",
            "verseOrgIds": [
              "EPH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EPH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojii dukkanaa kan ija hin qabne saaxilaa malee irratti hin hirmaatinaa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.11",
            "verseOrgIds": [
              "EPH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EPH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan isaan icciitiin hojjetan dubbachuun iyyuu qaaniidhaatii.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.12",
            "verseOrgIds": [
              "EPH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EPH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni ifni sun saaxilu hundinuu garuu ni mulʼata;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.13",
            "verseOrgIds": [
              "EPH.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EPH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kanaafis,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.14",
            "verseOrgIds": [
              "EPH.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EPH 5:14"
      },
      "items": [
        {
          "text": "\"Ati yaa isa raftu, dammaqi;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.14",
            "verseOrgIds": [
              "EPH.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EPH 5:14"
      },
      "items": [
        {
          "text": "warra duʼan keessaas kaʼi;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.14",
            "verseOrgIds": [
              "EPH.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EPH 5:14"
      },
      "items": [
        {
          "text": "Kiristoos siif ibsaatii\" jedhameera.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.14",
            "verseOrgIds": [
              "EPH.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EPH 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egaa isin akkamitti akka jiraattan jabeessaa of eeggadhaa! Akka ogeeyyiitti jiraadhaa malee akka warra ogeeyyii hin taʼiniitti hin jiraatinaa;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.15",
            "verseOrgIds": [
              "EPH.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EPH 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "waan guyyoonni kunneen hamoo taʼaniif baricha furaa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.16",
            "verseOrgIds": [
              "EPH.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EPH 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu fedhiin Gooftaa maal akka taʼe hubadhaa malee gowwaa hin taʼinaa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.17",
            "verseOrgIds": [
              "EPH.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EPH 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daadhii wayiniitiin hin machaaʼinaa; kun jireenya gad dhiisiitti geessaatii. Qooda kanaa Hafuuraan guutamaa;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.18",
            "verseOrgIds": [
              "EPH.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "faarfannaadhaan, weedduu galataatii fi faarfannaa Hafuuraatiin wal jalaa qabaa. Garaa keessan keessatti Gooftaaf faarfadhaatii muuziiqaa dhageessisaa;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.19",
            "verseOrgIds": [
              "EPH.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "yeroo hundas waan hundaaf maqaa Gooftaa keenya Yesuus Kiristoosiin Waaqa Abbaa galateeffadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.20",
            "verseOrgIds": [
              "EPH.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Qajeelfama Maatiin Kiristaanaa Ittiin Jiraatu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "EPH.5.22-EPH.6.9"
          },
          "items": [
            {
              "text": "5:22–6:9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwf –",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "xt"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "COL.3.18-COL.4.1"
              },
              "items": [
                {
                  "text": "Qol 3:18–4:1",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EPH 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodaa Kiristoosiif qabdaniin waliif ajajamaa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.21",
            "verseOrgIds": [
              "EPH.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EPH 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa niitota, akkuma Gooftaaf ajajamtanitti dhirsoota keessaniif ajajamaa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.22",
            "verseOrgIds": [
              "EPH.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EPH 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma Kiristoos waldaa kiristaanaatiif mataa taʼe sana dhirsi niitiif mataadhaatii; Kiristoos Fayyisaa waldaa kiristaanaa ti; waldaan kiristaanaa immoo dhagna isaa ti.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.23",
            "verseOrgIds": [
              "EPH.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EPH 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egaa akkuma waldaan kiristaanaa Kiristoosiif ajajamtu, niitonnis waan hundaan dhirsoota isaaniitiif haa ajajaman.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.24",
            "verseOrgIds": [
              "EPH.5.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EPH 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa dhirsoota, akkuma Kiristoos waldaa kiristaanaa jaallatee isheef of kenne sana isinis niitota keessan jaalladhaa;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.25",
            "verseOrgIds": [
              "EPH.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EPH 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "innis karaa dubbii isaatiin bishaaniin ishee dhiqee qulleessee akka isheen qulqulluu taatuuf,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.26",
            "verseOrgIds": [
              "EPH.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EPH 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "waldaa kiristaanaa ulfina qabeettii, mudaa yookaan suntuura yookaan waan akkanaa tokko illee hin qabnee garuu qulqullooftuu mudaa hin qabne godhee ofitti ishee dhiʼeessuuf waan kana godhe.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.27",
            "verseOrgIds": [
              "EPH.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EPH 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasuma immoo dhirsoonni niitota isaanii akkuma dhagna ofii isaaniitti jaallachuu qabu. Namni niitii ofii jaallatu of jaallata.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.28",
            "verseOrgIds": [
              "EPH.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EPH 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma Kiristoos waldaa kiristaanaatiif godhu sana namni kam iyyuu foon ofii ni soora; ni kunuunsas malee foon ofii hin jibbu;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.29",
            "verseOrgIds": [
              "EPH.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
