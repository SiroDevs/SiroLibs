  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "EPH 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Karoora Gaarii Waaqni Namoota Ormaatiif Qabu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EPH 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii kanaaf ani Phaawulos isin Namoota Ormaatiif jedhee hidhamaa Kiristoos Yesuus taʼeera.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.1",
            "verseOrgIds": [
              "EPH.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EPH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin dhugumaan waaʼee hojii ayyaana Waaqaa kan isiniif jedhamee natti kenname sanaa dhageessaniirtu;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.2",
            "verseOrgIds": [
              "EPH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EPH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis akkuma ani kanaan dura gabaabsee isinii barreessetti icciitii mulʼataatiin natti beeksifame.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.3",
            "verseOrgIds": [
              "EPH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EPH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin yommuu waan kana dubbiftanitti akka ani waaʼee icciitii Kiristoos beekumsa qabu hubachuu ni dandeessu;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.4",
            "verseOrgIds": [
              "EPH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EPH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "icciitiin kunis akka amma Hafuuraan ergamootaa fi raajota qulqulloota Waaqaatti mulʼifametti dhaloota kaanitti hin beeksifamne.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.5",
            "verseOrgIds": [
              "EPH.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icciitiin kunis Namoonni Ormaa karaa wangeelaatiin saba Israaʼel wajjin dhaaltota, isaanuma wajjin dhagna tokko, waadaa Kiristoos Yesuusiin kenname keessatti immoo hirmaattota taʼuu isaanii ti.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.6",
            "verseOrgIds": [
              "EPH.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EPH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis kennaa ayyaana Waaqaa kan karaa hojii humna isaatiin naa kennameen tajaajilaa wangeela kanaa taʼeera.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.7",
            "verseOrgIds": [
              "EPH.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EPH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani qulqulloota hundaa gad taʼu iyyuu akka badhaadhummaa Kiristoos kan qoramee bira hin gaʼamne sana Namoota Ormaatti lallabuuf ayyaanni kun naa kennameera;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.8",
            "verseOrgIds": [
              "EPH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EPH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkasumas icciitiin bara dheeraaf Waaqa waan hunda uumeen dhokfamee ture kun maal akka taʼe ani namoota hundaaf akka ibsuuf.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.9",
            "verseOrgIds": [
              "EPH.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EPH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaayyoon isaas akka ogummaan Waaqaa inni dachaa hedduu qabu sun amma karaa waldaa kiristaanaatiin bulchitootaa fi abbootii taayitaa kanneen samii irra jiranitti beeksifamuuf;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.10",
            "verseOrgIds": [
              "EPH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EPH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis akkuma kaayyoo isaa kan bara baraa kan inni karaa Gooftaa keenya Yesuus Kiristoosiin raawwate sanaatti ture.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.11",
            "verseOrgIds": [
              "EPH.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EPH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nus isaan, amantii isa irratti qabnuun, ija jabinaa fi amanachuudhaan Waaqatti dhiʼaachuu dandeenya.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.12",
            "verseOrgIds": [
              "EPH.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EPH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu sababii ani isiniif dhiphachaa jiruuf jettanii akka abdii hin kutanne isin kadhadha; dhiphachuun koo ulfinuma keessan.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.13",
            "verseOrgIds": [
              "EPH.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kadhannaa Warra Efesooniif Kadhatame",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EPH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii kanaaf ani fuula Abbaa duratti nan jilbeenfadha;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.14",
            "verseOrgIds": [
              "EPH.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EPH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "maatiin isaa warri samii irraa fi warri lafa irraa hundinuu maqaa isaanii isa irraa argatu.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.15",
            "verseOrgIds": [
              "EPH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EPH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni akkuma badhaadhummaa ulfina isaatti karaa Hafuura isaatiin namummaa keessan kan keessaa humnaan akka cimsuuf nan kadhadha;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.16",
            "verseOrgIds": [
              "EPH.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EPH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "akka Kiristoosis karaa amantiitiin garaa keessan keessa jiraatuuf nan kadhadha. Akka isin hidda gad fageeffattanii jaalalaan dhaabattaniifis nan kadhadha;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.17",
            "verseOrgIds": [
              "EPH.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EPH 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "isinis jaalalli Kiristoos hammam akka balʼatu, hammam akka dheeratu, hammam akka ol fagaatuu fi hammam akka gad fagaatu qulqulloota hunda wajjin hubachuudhaaf akka humna qabaattaniif,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.18",
            "verseOrgIds": [
              "EPH.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "akka guutama Waaqaa hundaan guutamtaniifis jaalala Kiristoos kan beekumsaa ol taʼe sana akka beektaniif nan kadhadha.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.19",
            "verseOrgIds": [
              "EPH.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqa isa humna isaa kan nu keessatti hojjetu sanaan hamma nu kadhannu yookaan hamma nu yaadnu hundumaa olitti akka malee hojjechuu dandaʼu sanaaf,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.20",
            "verseOrgIds": [
              "EPH.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EPH 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "waldaa kiristaanaa keessatti, dhaloota hunda keessattis karaa Kiristoos Yesuusiin bara baraa hamma bara baraatti ulfinni isaaf haa taʼu! Ameen.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.21",
            "verseOrgIds": [
              "EPH.3.21"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "EPH.4",
    "number": "4",
    "bookId": "EPH"
  },
