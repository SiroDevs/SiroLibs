  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "GAL 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bilisummaa Kiristoosiin Argamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GAL 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka bilisummaan jiraannuuf Kiristoos bilisa nu baase. Kanaafuu jabaadhaa dhaabadhaa! Deebitaniis waanjoo garbummaatiin hin qabaminaa.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.1",
            "verseOrgIds": [
              "GAL.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GAL 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunoo, dhagna yoo qabattan Kiristoos waan tokko akka isin hin fayyadne ani Phaawulos isinitti nan hima.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.2",
            "verseOrgIds": [
              "GAL.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GAL 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni dhagna qabatu hundinuu akka guutummaatti seera eeguun dirqama isaa taʼe ani amma illee nan mirkaneessaaf.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.3",
            "verseOrgIds": [
              "GAL.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GAL 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin warri seeraan qajeeltota taasifamuu barbaaddan Kiristoos irraa gargar baataniirtu; ayyaana irraas kuftaniirtu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.4",
            "verseOrgIds": [
              "GAL.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu garuu qajeelummaa abdannu sana karaa Hafuuraatiin hawwiidhaan amantiin eegganna.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.5",
            "verseOrgIds": [
              "GAL.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GAL 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiristoos Yesuusitti jiraannaan dhagna qabachuun yookaan qabachuu baachuun faayidaa tokko illee hin qabuutii. Wanni gatii qabu amantii jaalalaan of mulʼisu qofa.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.6",
            "verseOrgIds": [
              "GAL.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin fiigicha gaarii fiigaa turtan. Eenyutu gufuu isinitti taʼee dhugaadhaaf ajajamuu isin dhowwe ree?",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.7",
            "verseOrgIds": [
              "GAL.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GAL 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sossobbiin akkasii isa isin waame sana biraa hin dhufu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.8",
            "verseOrgIds": [
              "GAL.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Raacitiin xinnoon bukoo guutuu ni bukeessa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.9",
            "verseOrgIds": [
              "GAL.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani akka isin yaada biraa hin qabaanne karaa Gooftaatiin isin amanadha. Abbaa fedhe illee taanaan namni isin jeequu murtii ni argata.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.10",
            "verseOrgIds": [
              "GAL.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa obboloota, ani amma iyyuu yoon dhagna qabaa lallabaa jiraadhee ani amma iyyuu maaliifin ariʼatama ree? Yoo akkas taʼee immoo fannoon gufuu taʼuun isaa ni hafa ture!",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.11",
            "verseOrgIds": [
              "GAL.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri isin jeeqan sun dhagna qabachuu qofa utuu hin taʼin utuu of irraa muranii iyyuu nan hawwa!",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.12",
            "verseOrgIds": [
              "GAL.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hafuuraan Jiraachuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GAL 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa obboloota ko, isin akka bilisa taataniif waamamtan. Jaalalaan wal tajaajilaa malee bilisummaa keessan fedhii foonii guutuuf hin oolchinaa.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.13",
            "verseOrgIds": [
              "GAL.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seerri guutuun ajaja tokkicha, \"Ollaa kee akka ofii keetiitti jaalladhu\"",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.14",
            "verseOrgIds": [
              "GAL.5.14"
            ]
          }
        },
        {
          "text": "jedhuun xumurameeraatii.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.14",
            "verseOrgIds": [
              "GAL.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu isin yoo wal ciniinuu fi wal nyaachuutti fuftan akka wal hin balleessineef of eeggadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.15",
            "verseOrgIds": [
              "GAL.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu ani, \"Hafuuraan jiraadhaa; yoos hawwii foonii hin guuttaniitii\" jedha.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.16",
            "verseOrgIds": [
              "GAL.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Foon Hafuuraan ni mormaatii; Hafuurris fooniin ni morma. Isaan akka isin waan hojjechuu barbaaddan hin hojjenneef wal mormu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.17",
            "verseOrgIds": [
              "GAL.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin garuu Hafuuraan yoo geggeeffamtan seera jala hin jirtan.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.18",
            "verseOrgIds": [
              "GAL.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GAL 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojiiwwan fooniis beekamoo dha; isaanis halalummaa, xuraaʼummaa fi jireenya gad dhiisii,",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.19",
            "verseOrgIds": [
              "GAL.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GAL 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "waaqota tolfamoo waaqeffachuu, falfala hojjechuu, jibba, aarii, hinaaffaa, dheekkamsa, ofittummaa, wal loluu, gargar baʼuu,",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.20",
            "verseOrgIds": [
              "GAL.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GAL 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "weennoo, machii, addaggummaa fi kanneen kana fakkaatan. Ani akkuman kanaan dura godhe sana akka warri waan akkanaa hojjetan mootummaa Waaqaa hin dhaalle isinin akeekkachiisa.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.21",
            "verseOrgIds": [
              "GAL.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GAL 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iji Hafuuraa garuu jaalala, gammachuu, nagaa, obsa, arjummaa, gaarummaa, amanamummaa,",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.22",
            "verseOrgIds": [
              "GAL.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GAL 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "garraamummaa fi of qabuu dha. Seerri waan akkanaa mormus hin jiru.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.23",
            "verseOrgIds": [
              "GAL.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GAL 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri kan Kiristoos Yesuus taʼan immoo foon fedhii isaatii fi hawwii isaa wajjin fannisaniiru.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.24",
            "verseOrgIds": [
              "GAL.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GAL 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu erga Hafuuraan jiraannee kottaa Hafuuraan haa deddeebinu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.25",
            "verseOrgIds": [
              "GAL.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GAL 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kottaa of hin tuulluu; wal hin aarsinuu; walittis hin hinaafnuu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.26",
            "verseOrgIds": [
              "GAL.5.26"
            ]
          }
        }
      ]
    }
  ],
