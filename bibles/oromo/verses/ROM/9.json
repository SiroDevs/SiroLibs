  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "ROM 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Filannoo Waaqaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani Kiristoosiin dhugaa nan dubbadha; ani hin sobu; yaadni koos Hafuura Qulqulluudhaan naa mirkaneessa;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.1",
            "verseOrgIds": [
              "ROM.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ani gadda guddaa fi dhiphina wal irraa hin cinne garaa koo keessaa qaba.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.2",
            "verseOrgIds": [
              "ROM.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani iyyuu obboloota koo warra akka fooniitti sanyii koo taʼaniif jedhee utuun Kiristoos irraa gargar baʼee abaaramee nan hawwa tureetii;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.3",
            "verseOrgIds": [
              "ROM.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "isaan saba Israaʼel. Ilmummaan, ulfinni, kakuun, seera fudhachuun, tajaajiluu fi waadaan kan isaanii ti.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.4",
            "verseOrgIds": [
              "ROM.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abbootiin kan isaanii ti; Kiristoosis",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.5",
            "verseOrgIds": [
              "ROM.9.5"
            ]
          }
        },
        {
          "text": "isaan irraa fooniin dhalate; inni waan hunda irratti Waaqa; inni bara baraan haa eebbifamu! Ameen.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.5",
            "verseOrgIds": [
              "ROM.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kun garuu dubbiin Waaqaa diigameera jechuu miti. Kan Israaʼel irraa dhalate hundi Israaʼel miti.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.6",
            "verseOrgIds": [
              "ROM.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yookaan isaan sababii sanyii Abrahaam taʼaniif hundi isaanii ijoollee isaa miti. Garuu, \"Sanyiin kee Yisihaaqiin siif waamama\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.7",
            "verseOrgIds": [
              "ROM.9.7"
            ]
          }
        },
        {
          "text": "jedhameera.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.7",
            "verseOrgIds": [
              "ROM.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana jechuunis ijoollee waadaatu sanyiitti lakkaaʼama malee ijoolleen foon irraa dhalatan ijoollee Waaqaa miti.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.8",
            "verseOrgIds": [
              "ROM.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubbiin waadaa sunis kan, \"Ani yeroo murteeffametti deebiʼee nan dhufa; Saaraanis ilma ni deessi\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.9",
            "verseOrgIds": [
              "ROM.9.9"
            ]
          }
        },
        {
          "text": "jedhu tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.9",
            "verseOrgIds": [
              "ROM.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana qofa miti; Ribqaan yeroo namuma tokkoof, abbaa keenya Yisihaaqiif ulfooftetti,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.10",
            "verseOrgIds": [
              "ROM.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ijoolleen sun utuu hin dhalatin yookaan utuu waan gaarii yookaan waan hamaa hin hojjetin akka kaayyoon filannoo Waaqaa raawwatamuuf,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.11",
            "verseOrgIds": [
              "ROM.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "utuu hojiin hin taʼin isa waamicha Waaqaatiin, \"Inni hangafni isa quxisuu tajaajila\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.12",
            "verseOrgIds": [
              "ROM.9.12"
            ]
          }
        },
        {
          "text": "jedhamee isheetti himame.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.12",
            "verseOrgIds": [
              "ROM.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunis akkuma, \"Yaaqoobin nan jaalladhe; Esaawun garuu nan jibbe\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.13",
            "verseOrgIds": [
              "ROM.9.13"
            ]
          }
        },
        {
          "text": "jedhamee barreeffamee dha.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.13",
            "verseOrgIds": [
              "ROM.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egaa maal jenna ree? Waaqni jalʼaadhaa? Gonkumaa akkas miti!",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.14",
            "verseOrgIds": [
              "ROM.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni Museedhaan,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.15",
            "verseOrgIds": [
              "ROM.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 9:15"
      },
      "items": [
        {
          "text": "\"Ani kanan maaru nan maara;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.15",
            "verseOrgIds": [
              "ROM.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 9:15"
      },
      "items": [
        {
          "text": "kanan garaa laafuufiis garaa nan laafa\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.15",
            "verseOrgIds": [
              "ROM.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "ROM 9:15"
      },
      "items": [
        {
          "text": "jedhaatii.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.15",
            "verseOrgIds": [
              "ROM.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu wanti kun araara Waaqaatiin malee hawwii yookaan carraaqqii namaatiin miti.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.16",
            "verseOrgIds": [
              "ROM.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katabbiin qulqulluun Faraʼooniin, \"Ani humna koo sirratti argisiisuuf, maqaan koos akka lafa hunda irratti labsamuuf kaayyoo kanaaf si kaaseera\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.17",
            "verseOrgIds": [
              "ROM.9.17"
            ]
          }
        },
        {
          "text": "jedhaatii.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.17",
            "verseOrgIds": [
              "ROM.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaaf Waaqni kan maaruu barbaadu ni maara; kan mata jabeessa gochuu barbaadu immoo mata jabeessa godha.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.18",
            "verseOrgIds": [
              "ROM.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isinis, \"Yoos Waaqni maaliif amma iyyuu dogoggora nurra barbaada? Fedhii isaas eenyutu mormuu dandaʼa?\" naan jettu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.19",
            "verseOrgIds": [
              "ROM.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu yaa namichoo, Waaqaan mormuuf ati eenyu? \"Wanti tolfame tokko kan isa tolcheen, 'Ati maaliif akkanatti na tolchite?' \"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.20",
            "verseOrgIds": [
              "ROM.9.20"
            ]
          }
        },
        {
          "text": "jedhaa?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.20",
            "verseOrgIds": [
              "ROM.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suphee dhooftuun tokko dhoqqee suphee kan bukaaʼe irraa qodaa ulfinaa fi salphinaaf oolu tolchuuf mirga hin qabuu?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.21",
            "verseOrgIds": [
              "ROM.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni dheekkamsa isaa argisiisuu fi humna isaas beeksisuuf jedhee yoo miʼa dheekkamsaa kanneen badiisaaf qopheeffaman obsa guddaan bira darbe hoo?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.22",
            "verseOrgIds": [
              "ROM.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni badhaadhummaa ulfina isaa yoo miʼa araara isaa kanneen duraan dursee ulfinaaf qopheessetti beeksisuuf jedhee waan kana godhe hoo?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.23",
            "verseOrgIds": [
              "ROM.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nus warra waamaman keessaa tokkoo dha; inni Yihuudoota qofa keessaa utuu hin taʼin Namoota Ormaa keessaas waameera.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.24",
            "verseOrgIds": [
              "ROM.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni kitaaba Hooseʼaa keessatti akkana jedha:",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.25",
            "verseOrgIds": [
              "ROM.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 9:25"
      },
      "items": [
        {
          "text": "\"Ani warra saba koo hin taʼiniin, 'saba koo' nan jedha;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.25",
            "verseOrgIds": [
              "ROM.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 9:25"
      },
      "items": [
        {
          "text": "ishee jaallatamtuu hin taʼiniin immoo,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.25",
            "verseOrgIds": [
              "ROM.9.25"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "'jaallatamtuu' nan jedha.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.25",
            "verseOrgIds": [
              "ROM.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasumas isaan,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.26",
            "verseOrgIds": [
              "ROM.9.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 9:26"
      },
      "items": [
        {
          "text": "\"Iddoodhuma itti, 'Isin saba koo miti'",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.26",
            "verseOrgIds": [
              "ROM.9.26"
            ]
          }
        }
      ]
