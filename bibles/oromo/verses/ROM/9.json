          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼeloonni seera qajeelummaa duukaa buʼan garuu qajeelummaa hin arganne.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.31",
