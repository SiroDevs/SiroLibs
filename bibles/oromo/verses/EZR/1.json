          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walumaa galatti miʼa warqeetii fi kan meetii 5,400 ture.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EZR 1:11"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EZR 1:11"
      },
      "items": [
        {
          "text": "Sheeshbazaaris miʼoota kanneen hunda yeroo boojiʼamtoota Baabilonii baasee Yerusaalemitti geessetti guuree deeme.",
          "type": "text",
          "attrs": {
