                  "EZR.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "akka dubbiin",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.1",
            "verseOrgIds": [
              "EZR.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "EZR.1.1",
                "verseOrgIds": [
                  "EZR.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "kan afaan Ermiyaasiin dubbatame sun raawwatamuuf jedhee bara Qiiros mooticha Faares keessa waggaa jalqabaatti akka inni mootummaa isaa hunda keessa labsii tokko dabarsuu fi akka labsiin sunis barreeffamuuf hafuura Qiiros mooticha Faares ni kakaase; labsiin sunis akkana jedha:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.1",
            "verseOrgIds": [
              "EZR.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Qiiros mootichi Faares akkana jedha:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.2",
            "verseOrgIds": [
              "EZR.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "EZR 1:2"
      },
      "items": [
        {
          "text": "\" '",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.2",
            "verseOrgIds": [
              "EZR.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EZR.1.2",
                "verseOrgIds": [
                  "EZR.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni samii mootummoota lafa irraa hunda naaf kenneera; akka ani Yihuudaa keessatti Yerusaalemitti mana qulqullummaa isaaf ijaaruufis na muudeera.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.2",
            "verseOrgIds": [
              "EZR.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saba isaa keessaa nama gidduu keessanitti argamu kam iyyuu Waaqni isaa isa wajjin haa taʼu; innis gara Yerusaalem ishee Yihuudaa keessaa sanaa ol baʼee mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.3",
            "verseOrgIds": [
              "EZR.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EZR.1.3",
                "verseOrgIds": [
                  "EZR.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa Israaʼel, Waaqa Yerusaalem keessa jiraatu sanaa haa ijaaru.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.3",
            "verseOrgIds": [
              "EZR.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warra hafanii iddoo kam iyyuu jiraatan hundaaf sabni biyya isaan keessa jiraatan sanaa kennaa fedhiidhaan mana qulqullummaa Waaqaa kan Yerusaalem keessa jiru sanaaf kennuu irratti dabalee meetii fi warqee, miʼaa fi horii gumaachuudhaan isa haa gargaaran.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.4",
            "verseOrgIds": [
              "EZR.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii hangafoonni maatii Yihuudaa fi Beniyaam, luboonnii fi Lewwonni jechuunis namoonni Waaqni garaa isaanii kakaase hundi dhaqanii mana",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.5",
            "verseOrgIds": [
              "EZR.1.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "EZR.1.5",
                "verseOrgIds": [
                  "EZR.1.5"
                ]
              }
            }
          ]
        },
        {
          "text": "kan Yerusaalem keessaa sana ijaaruuf qophaaʼan.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.5",
            "verseOrgIds": [
              "EZR.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olloonni isaanii hundinuus kennaa fedhiidhaan kennan irratti dabalanii miʼa meetii fi warqee, qodaa fi horii akkasumas kennaawwan gatii guddaa baasan gumaachuudhaan isaan gargaaran.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.6",
            "verseOrgIds": [
              "EZR.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana malees Qiiros Mootichi miʼoota mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.7",
            "verseOrgIds": [
              "EZR.1.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "EZR.1.7",
                "verseOrgIds": [
                  "EZR.1.7"
                ]
              }
            }
          ]
        },
        {
          "text": "kanneen Nebukadnezar Yerusaalemii guurratee mana Waaqa isaa keessa kaaʼatee ture sana gad ni baase.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.7",
            "verseOrgIds": [
              "EZR.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qiiros mootichi Faares akka Mitredaat itti gaafatamaan qabeenyaa sun miʼa sana fidee Sheeshbazaar bulchaa Yihuudaatiif lakkaaʼu godhe.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.8",
            "verseOrgIds": [
              "EZR.1.8"
            ]
          }
        }
      ]
    },
