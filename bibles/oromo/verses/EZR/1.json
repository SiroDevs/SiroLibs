      },
      "items": [
        {
          "text": "waciitii meetii kan qadaada qabu 410,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.10",
            "verseOrgIds": [
              "EZR.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
