                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus erga barattoota isaa kudha lamaaniif ajaja kennuu raawwatee booddee magaalaawwan Galiilaa keessatti barsiisuu fi lallabuuf jedhee achii kaʼee karaa isaa itti fufe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.1",
            "verseOrgIds": [
              "MAT.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yohannis mana hidhaa taaʼee yommuu waan Kiristoos hojjechaa ture dhagaʼetti barattoota isaa ergee,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.2",
            "verseOrgIds": [
              "MAT.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Inni dhufuuf jiru sun siʼi moo yookaan kan biraa eegganna?\" jedhee isa gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.3",
            "verseOrgIds": [
              "MAT.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis akkana jedhee deebiseef;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.4",
            "verseOrgIds": [
              "MAT.11.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Deebiʼaatii waan dhageessanii fi waan argitan Yohannisitti himaa;",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.4",
                "verseOrgIds": [
                  "MAT.11.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.4",
            "verseOrgIds": [
              "MAT.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "jaamonni ni argu; warri naafatan ni deemu; warri lamxaaʼan ni qulqullaaʼu; warri duudan ni dhagaʼu; warri duʼan ni kaʼu; hiyyeeyyiifis wangeelli ni lallabama.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.5",
                "verseOrgIds": [
                  "MAT.11.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.5",
            "verseOrgIds": [
              "MAT.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Namni natti hin gufanne kam iyyuu eebbifamaa dha.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.6",
                "verseOrgIds": [
                  "MAT.11.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma barattoonni Yohannis baʼanii qajeelaniin, Yesuus akkana jedhee waaʼee Yohannis namootatti himuu jalqabe;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.7",
            "verseOrgIds": [
              "MAT.11.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Isin maal arguuf gammoojjiitti gad baatan? Shambaqqoo qilleensi raasu moo?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.7",
                "verseOrgIds": [
                  "MAT.11.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.7",
            "verseOrgIds": [
              "MAT.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yoos maal arguu baatan ree? Nama uffata miidhagaa uffate moo? Lakki, warri uffata miidhagaa uffatan masaraa moototaa jiru.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.8",
                "verseOrgIds": [
                  "MAT.11.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.8",
            "verseOrgIds": [
              "MAT.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yoos maal arguu baatan ree? Raajii moo? Eeyyee; ani isinittin hima; kan raajii iyyuu caalu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.9",
                "verseOrgIds": [
                  "MAT.11.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.9",
            "verseOrgIds": [
              "MAT.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kunis isa waaʼeen isaa akkana jedhamee barreeffamee dha.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.10",
                "verseOrgIds": [
                  "MAT.11.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 11:10"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\" 'Kunoo, ani ergamaa koo isa fuula kee duraan",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.10",
                "verseOrgIds": [
                  "MAT.11.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 11:10"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "karaa kee qopheessu, si dura nan erga.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.10",
                "verseOrgIds": [
                  "MAT.11.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ani dhuguma isinittin hima; namoota dubartoota irraa dhalatan keessaa namni Yohannis Cuuphaa caalu tokko iyyuu hin kaane; namni mootummaa samii keessatti nama hundumaa gad taʼe kam iyyuu garuu isa ni caala.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.11",
                "verseOrgIds": [
                  "MAT.11.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.11",
            "verseOrgIds": [
              "MAT.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mootummaan samii bara Yohannis Cuuphaatii jalqabee hamma ammaatti humnaan dhiibbachaa jira; namoonni dhiibbatanis humnaan mootummaa sana argatu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.12",
                "verseOrgIds": [
                  "MAT.11.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.12",
            "verseOrgIds": [
              "MAT.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Raajonni hundinuu, Seerris hamma Yohannis Cuuphaatti raajii dubbataniiruutii.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.13",
                "verseOrgIds": [
                  "MAT.11.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.13",
            "verseOrgIds": [
              "MAT.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Isinis kana fudhachuuf yoo fedhii qabaattan, inni Eeliyaas isa dhufuuf jiruu dha.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.14",
                "verseOrgIds": [
                  "MAT.11.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.14",
            "verseOrgIds": [
              "MAT.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Namni gurra dhagaʼu qabu haa dhagaʼu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.15",
                "verseOrgIds": [
                  "MAT.11.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ani dhaloota kana maaliinan wal fakkeessuu dandaʼa? Isaan akkuma ijoollee iddoo gabaa taaʼanii warra kaan waamanii akkana jedhanii ti:",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.16",
                "verseOrgIds": [
                  "MAT.11.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\" 'Nu ulullee isinii afuufne;",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.17",
                "verseOrgIds": [
                  "MAT.11.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 11:17"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "isin garuu hin sirbine;",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.17",
                "verseOrgIds": [
                  "MAT.11.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 11:17"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "faaruu booʼichaas faarsine;",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.17",
                "verseOrgIds": [
                  "MAT.11.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 11:17"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "isin garuu hin boonye.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.17",
                "verseOrgIds": [
                  "MAT.11.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yohannis yeroo dhufetti hin nyaatu, hin dhugus tureetii; isaan immoo, 'Inni hafuura hamaa qaba' jedhu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.18",
                "verseOrgIds": [
                  "MAT.11.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.18",
            "verseOrgIds": [
              "MAT.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ilmi Namaa nyaachaa, dhugaas dhufe; isaan immoo, 'Kunoo albaadhessaa fi machaaʼaa, michuu qaraxxootaatii fi cubbamootaa' jedhu. Ogummaan garuu hojii isheetiin mirkaneeffamti.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.19",
                "verseOrgIds": [
                  "MAT.11.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
