        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Yaa barsiistota seeraatii fi Fariisota fakkeessitoota nana, isiniif wayyoo! Isin akkuma awwaala nooraa dibame kan duubni isaa bareedaa fakkaatee keessi isaa immoo lafee namoota duʼaniitiin, xuraaʼummaa hundaanis guutamee ti.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.27",
                "verseOrgIds": [
