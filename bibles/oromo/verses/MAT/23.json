        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kanaafuu namni iddoo aarsaatiin kakatu, iddoo aarsaatii fi waan isa irra jiru hundumaan ni kakata.",
              "type": "text",
