        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Yaa barsiistota seeraatii fi Fariisota fakkeessitoota nana, isiniif wayyoo! Duuba xoofootii fi caabii ni qulqulleessitu; keessi isaanii garuu saamichaa fi ofittummaadhaan guutameera.",
              "type": "text",
              "attrs": {
