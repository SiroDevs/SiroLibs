        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ani isinittin himaatii; isin hamma, 'Inni maqaa Gooftaatiin dhufu sun eebbifamaa dha' jettanitti lammata na hin argitan.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.39",
