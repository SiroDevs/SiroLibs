        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Isin, 'Nu utuu bara abbootii keenyaa sana jiraannee silaa dhiiga raajotaa dhangalaasuu keessatti isaan wajjin hin hirmaannu ture' jettu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.30",
                "verseOrgIds": [
                  "MAT.23.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.30",
            "verseOrgIds": [
              "MAT.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
