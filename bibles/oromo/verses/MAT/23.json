        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Namni mana qulqullummaatiin kakatu, mana qulqullummaatii fi isa mana qulqullummaa keessa jiraatuun kakata.",
