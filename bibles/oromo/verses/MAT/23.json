        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Egaa safartuu cubbuu abbootii keessanii guutaa!",
              "type": "text",
              "attrs": {
