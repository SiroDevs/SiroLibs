        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Isinis akkasuma duubaan qajeeltota fakkaattanii namootatti mulʼattu; keessi keessan garuu fakkeessuu fi hamminaan guutameera.",
              "type": "text",
              "attrs": {
