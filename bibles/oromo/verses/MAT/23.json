        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Yaa barsiistota seeraatii fi Fariisota fakkeessitoota nana, isiniif wayyoo! Isin raajotaaf awwaala ijaartuutii; soodduu qajeeltotaas ni bareechitu.",
              "type": "text",
              "attrs": {
