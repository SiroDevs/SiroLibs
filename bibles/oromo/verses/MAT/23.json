        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yaa Fariisicha jaamaa nana! Jalqabatti keessa xoofootii fi caabii qulqulleessi; ergasii duubni isaas ni qulqullaaʼaa.",
