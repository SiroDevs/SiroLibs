        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Isin qajeelchitoota jaamota nana! Bookee ni calaltu; gaala immoo ni liqimsitu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.24",
                "verseOrgIds": [
                  "MAT.23.24"
                ]
              }
            }
          ]
        }
