  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "DEU 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni tokko erga niitii fuudhee booddee yoo waan fafaa ishee irratti argee ishee jibbe, inni waraqaa ragaa hiikkaa barreessee itti kennuudhaan mana isaatii baasee ishee haa geggeessu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.1",
            "verseOrgIds": [
              "DEU.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheen erga mana isaatii baatee booddee yoo niitii nama biraa taate,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.2",
            "verseOrgIds": [
              "DEU.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "yoo dhirsi ishee lammaffaan ishee jibbee waraqaa hiikkaa barreessee kenneefii mana isaatii ishee baase yookaan yoo inni duʼe,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.3",
            "verseOrgIds": [
              "DEU.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "dhirsi inni jalqabaa kan ishee hiike sun erga isheen xurooftee booddee deebiʼee ishee fuudhuun isaaf hin eeyyamamu. Wanni kun fuula",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.4",
            "verseOrgIds": [
              "DEU.24.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.24.4",
                "verseOrgIds": [
                  "DEU.24.4"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti balfamaa dha. Ati biyya",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.4",
            "verseOrgIds": [
              "DEU.24.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.24.4",
                "verseOrgIds": [
                  "DEU.24.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee akka dhaalaatti siif kennutti cubbuu hin fidin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.4",
            "verseOrgIds": [
              "DEU.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni dhiʼeenyatti niitii fuudhe tokko lafa waraanaatti hin ergamin yookaan akka hojii biraa hojjetu hin dirqamin; inni waggaa tokkoof mana ofii isaa haa turu; niitii isaas haa gammachiisu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.5",
            "verseOrgIds": [
              "DEU.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati dhagaa daakuutii fi majii isaa yookaan majii isaa qofa illee taanaan akka qabdiitti hin fudhatin; kun lubbuu namaa qabdii godhanii fudhachuu taʼaatii.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.6",
            "verseOrgIds": [
              "DEU.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni tokko yoo obboleessa isaa kan gosa Israaʼel tokko hatee garbicha godhate yookaan gurgurate inni ajjeefamuu qaba. Ati waan hamaa gidduu keetii baasi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.7",
            "verseOrgIds": [
              "DEU.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaʼee nama lamxaaʼee garuu akkuma Lewwonni luboota taʼan qajeelcha siif kennan sanatti hojjechuu kee qalbeeffadhu. Ati waan ani isaan ajaje of eeggannaadhaan duukaa buʼuu qabda.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.8",
            "verseOrgIds": [
              "DEU.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.9",
            "verseOrgIds": [
              "DEU.24.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.24.9",
                "verseOrgIds": [
                  "DEU.24.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee erga isin biyya Gibxiitii baatanii booddee karaa irratti Miiriyaamitti fide sana yaadadhu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.9",
            "verseOrgIds": [
              "DEU.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu ollaa keetiif liqii gosa kamii iyyuu kennitutti waan inni akka qabdiitti siif kennu fudhachuudhaaf mana isaa hin seenin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.10",
            "verseOrgIds": [
              "DEU.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati ala turiitii namichi ati waa liqeessituuf sun qabdii siif kennu sana siif haa fidu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.11",
            "verseOrgIds": [
              "DEU.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo namni sun hiyyeessa taʼe qabdii isaa of bira hin bulchin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.12",
            "verseOrgIds": [
              "DEU.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka inni kootii isaa uffatee buluuf utuu aduun hin dhiʼin deebisiif. Innis si eebbisa; wanni kun immoo fuula",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.13",
            "verseOrgIds": [
              "DEU.24.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.24.13",
                "verseOrgIds": [
                  "DEU.24.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keetii duratti akka hojii qajeelummaatti siif hedama.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.13",
            "verseOrgIds": [
              "DEU.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obboleessa kee nama gosa Israaʼel yookaan alagaa magaalaawwan kee tokko keessa jiraatu illee taanaan hiyyeessa yookaan rakkataa qaxarame tokko hin saamin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.14",
            "verseOrgIds": [
              "DEU.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gatii inni ittiin hojjete gaafuma sana utuu aduun hin lixin kenniif; waan hiyyeessa taʼeef inni abdiidhaan eegataatii. Yoo kanaa achii inni",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.15",
            "verseOrgIds": [
              "DEU.24.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "DEU.24.15",
                "verseOrgIds": [
                  "DEU.24.15"
                ]
              }
            }
          ]
        },
        {
          "text": "sitti waammatee wanni kun cubbuu sitti taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.15",
            "verseOrgIds": [
              "DEU.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abbootiin sababii ijoollee isaaniitiif ajjeefamuu hin qaban yookaan ijoolleen sababii abbootii isaaniitiif ajjeefamuu hin qaban; tokkoon tokkoon namaa sababii cubbuu ofii isaatiif duʼa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.16",
            "verseOrgIds": [
              "DEU.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati murtii alagaa yookaan ijoollee abbaa hin qabnee hin jalʼisin yookaan uffata haadha hiyyeessaa qabdii hin fudhatin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.17",
            "verseOrgIds": [
              "DEU.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati akka biyya Gibxitti garbicha turtee fi akka",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.18",
            "verseOrgIds": [
              "DEU.24.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.24.18",
                "verseOrgIds": [
                  "DEU.24.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee achii si fure yaadadhu. Wanni ani akka ati waan kana hojjettuuf si ajajuufis kanuma.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.18",
            "verseOrgIds": [
              "DEU.24.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu midhaan lafa qotiisaa keetii walitti qabdutti yoo bissiin hafe jiraate isaaf jettee duubatti hin deebiʼin; akka",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.19",
            "verseOrgIds": [
              "DEU.24.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.24.19",
                "verseOrgIds": [
                  "DEU.24.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee hojii harka keetii hundaan si eebbisuuf alagoota, ijoollee abbaa hin qabnee fi haadha hiyyeessaatiif dhiisi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.19",
            "verseOrgIds": [
              "DEU.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu ija muka ejersa keetii harcaaftuttis kan hafe funaannachuuf jettee hin deebiʼin; waan hafe sana alagaaf, ijoollee abbaa hin qabnee fi haadha hiyyeessaatiif dhiisi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.20",
            "verseOrgIds": [
              "DEU.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu ija iddoo dhaabaa wayinii keetii walitti qabduttis waan hafe funaannachuudhaaf hin deebiʼin. Waan hafe sana alagaadhaaf, ijoollee abbaa hin qabnee fi haadha hiyyeessaatiif dhiisi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.21",
            "verseOrgIds": [
              "DEU.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati akka Gibxitti garbicha turte yaadadhu. Wanni ani akka ati waan kana gootu si ajajuufis kanuma.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.22",
            "verseOrgIds": [
              "DEU.24.22"
            ]
          }
        }
      ]
    }
  ],
