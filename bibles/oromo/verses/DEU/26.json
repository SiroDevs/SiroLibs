        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ija Jalqabaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati yommuu biyya",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.1",
            "verseOrgIds": [
              "DEU.26.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.1",
                "verseOrgIds": [
                  "DEU.26.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee dhaala godhee siif kennutti galtee dhaaltee keessa qubattutti,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.1",
            "verseOrgIds": [
              "DEU.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "midhaan lafa biyya",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.2",
            "verseOrgIds": [
              "DEU.26.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.2",
                "verseOrgIds": [
                  "DEU.26.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee siif kennu irraa argattu hunda irraa mataa isaa fuudhiitii guuboo keessa kaaʼi. Ergasiis iddoo",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.2",
            "verseOrgIds": [
              "DEU.26.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.2",
                "verseOrgIds": [
                  "DEU.26.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee iddoo jireenya Maqaa isaatiif filatu dhaqi;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.2",
            "verseOrgIds": [
              "DEU.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "luba yeroo sanatti hojii irra jiruun, \"Ani biyya",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.3",
            "verseOrgIds": [
              "DEU.26.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.3",
                "verseOrgIds": [
                  "DEU.26.3"
                ]
              }
            }
          ]
        },
        {
          "text": "akka nuu kennu abbootii keenyaaf waadaa galetti dhufuu koo harʼa fuula",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.3",
            "verseOrgIds": [
              "DEU.26.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.3",
                "verseOrgIds": [
                  "DEU.26.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keetii duratti nan labsa\" jedhi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.3",
            "verseOrgIds": [
              "DEU.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubni sunis guuboo sana si harkaa fuudhee iddoo aarsaa",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.4",
            "verseOrgIds": [
              "DEU.26.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.4",
                "verseOrgIds": [
                  "DEU.26.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keetii dura ni kaaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.4",
            "verseOrgIds": [
              "DEU.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atis",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.5",
            "verseOrgIds": [
              "DEU.26.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.5",
                "verseOrgIds": [
                  "DEU.26.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa kee duratti akkana jettee ni labsita; \"Abbaan koo nama biyya Arraam kan asii fi achi godaanu ture; innis namoota xinnoo fudhatee Gibxitti gad buʼe; achis jiraatee saba guddaa, humna qabeessaa fi akka malee baayʼee taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.5",
            "verseOrgIds": [
              "DEU.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri Gibxi garuu nu hacuucuu fi nu dhiphisuudhaan hojii jabaa nutti feʼan.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.6",
            "verseOrgIds": [
              "DEU.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu ergasii gara",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.7",
            "verseOrgIds": [
              "DEU.26.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.7",
                "verseOrgIds": [
                  "DEU.26.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa abbootii keenyaatti iyyanne;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.7",
            "verseOrgIds": [
              "DEU.26.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.7",
                "verseOrgIds": [
                  "DEU.26.7"
                ]
              }
            }
          ]
        },
        {
          "text": "sagalee keenya dhagaʼee rakkina keenya, dadhabbii keenyaa fi hacuucamuu keenya arge.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.7",
            "verseOrgIds": [
              "DEU.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.8",
            "verseOrgIds": [
              "DEU.26.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.8",
                "verseOrgIds": [
                  "DEU.26.8"
                ]
              }
            }
          ]
        },
        {
          "text": "harka jabaa fi irree diriirfameen, sodaachisa guddaadhaan, mallattoo fi dinqiidhaan Gibxii nu baase.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.8",
            "verseOrgIds": [
              "DEU.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iddoo kanattis nu fidee biyya aannanii fi damma baaftu kana nuuf kenne;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.9",
            "verseOrgIds": [
              "DEU.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ammas yaa",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.10",
            "verseOrgIds": [
              "DEU.26.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.10",
                "verseOrgIds": [
                  "DEU.26.10"
                ]
              }
            }
          ]
        },
        {
          "text": "kunoo, ani midhaan lafa ati naa kennitee irraa mataa isaa fideera.\" Guuboo sanas fuula",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.10",
            "verseOrgIds": [
              "DEU.26.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.10",
                "verseOrgIds": [
                  "DEU.26.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keetii dura kaaʼiitii fuula isaa duratti gad jedhii sagadi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.10",
            "verseOrgIds": [
              "DEU.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati, Lewwonnii fi alagoonni gidduu kee jiraatan waan gaarii",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.11",
            "verseOrgIds": [
              "DEU.26.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.11",
                "verseOrgIds": [
                  "DEU.26.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee sii fi maatii keetiif kenne hundaan gammadaa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.11",
            "verseOrgIds": [
              "DEU.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu waggaa sadaffaatti jechuunis waggaa itti kennaa kudhan keessaa tokko baafamutti midhaan kee irraa erga kennaa kudhan keessaa tokko baaftee raawwatee booddee akka isaan magaalaawwan kee keessatti nyaatanii quufaniif Lewwotaaf, alagootaaf, ijoollee abbaa hin qabnee fi haadhota hiyyeessaatiif kenni.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.12",
            "verseOrgIds": [
              "DEU.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.13",
            "verseOrgIds": [
              "DEU.26.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.13",
                "verseOrgIds": [
                  "DEU.26.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keetiin akkana jedhi; \"Ani akkuma ajaja kee kan ati na ajajje hundaatti qooda qulqulluu mana kootii baasee Lewwotaaf, alagootaaf, ijoollee abbaa hin qabnee fi haadhota hiyyeessaatiif kenneera. Ani ajajawwan kee irraa hin gorre yookaan tokkoo isaanii illee hin daganne.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.13",
            "verseOrgIds": [
              "DEU.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani yeroon gadda irra tures kutaa qulqulluu sana irraa homaa hin nyaanne; yookaan ani yeroon xuraaʼetti isa irraa waan tokko illee hin fuune; warra duʼaniifis hin dhiʼeessine; ani",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.14",
            "verseOrgIds": [
              "DEU.26.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.14",
                "verseOrgIds": [
                  "DEU.26.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa kootiif ajajameera; waan ati na ajajje hundas hojjedheera.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.14",
            "verseOrgIds": [
              "DEU.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samii irraa, iddoo jireenya keetii qulqulluu irraa gad ilaali; saba kee Israaʼelii fi biyya akkuma abbootii keenyaaf waadaa galtetti nuu kennite kan aannanii fi dammi keessaa burqu kana eebbisi.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.15",
            "verseOrgIds": [
              "DEU.26.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ajajawwan",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duukaa buʼuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.16",
                "verseOrgIds": [
                  "DEU.26.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee akka ati ajajawwanii fi seerawwan kanneen eegdu harʼa si ajaja; ati akka garaa kee guutuu fi lubbuu kee guutuudhaan isaan eegdu of eeggadhu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.16",
            "verseOrgIds": [
              "DEU.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 26:17"
