  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "DEU 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuu sangaan yookaan hoolaan obboleessa keetii badaa jiruu yoo argite, deebisiitii isatti fidi malee calʼiftee bira hin darbin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.1",
            "verseOrgIds": [
              "DEU.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo obboleessi sun sirraa fagoo jiraate yookaan yoo isa beekuu baatte sangaa yookaan hoolaa sana fuudhii galiitii hamma inni barbaacha dhufutti of bira tursi. Ergasii deebisii isaaf kenni.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.2",
            "verseOrgIds": [
              "DEU.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo harreen yookaan wayyaan yookaan wanni fedhe iyyuu obboleessa kee jalaa badee argite akkasuma godhi malee dhiiftee bira hin darbin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.3",
            "verseOrgIds": [
              "DEU.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo harreen yookaan sangaan obboleessa keetii karaa irratti kufee argite akka inni ol kaasee miilla isaatiin dhaabu gargaari malee bira hin darbin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.4",
            "verseOrgIds": [
              "DEU.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubartiin uffata dhiiraa uffachuu hin qabdu yookaan dhiirri uffata dubartii uffachuu hin qabu;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.5",
            "verseOrgIds": [
              "DEU.22.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.22.5",
                "verseOrgIds": [
                  "DEU.22.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee nama waan akkasii hojjetu kam iyyuu ni jibbaatii.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.5",
            "verseOrgIds": [
              "DEU.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati yoo mana simbiraa kan muka irra yookaan lafa jiru utuu haati cuucii ishee yookaan anqaaquu ishee hammattee jirtuu karaa cinatti argite haadha sana cuucii ishee wajjin hin fudhatin;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.6",
            "verseOrgIds": [
              "DEU.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati cuucii ishee fudhachuu ni dandeessa; garuu akka siif tolee bara dheeraa jiraattuuf akka haadha gad dhiifte mirkaneeffadhu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.7",
            "verseOrgIds": [
              "DEU.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu mana haaraa ijaartutti akka namni bantii manaa irraa kufee mana keetti yakka dhangalaʼuu dhiigaa hin fidneef qarqara bantii isaatti ittisa tolchi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.8",
            "verseOrgIds": [
              "DEU.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iddoo dhaabaa wayinii keetii keessa sanyii gosa lamaa hin facaasin; yoo ati akkas goote sanyii ati facaafte sana qofa utuu hin taʼin iji iddoo dhaabaa wayinii keetiis ni bada.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.9",
            "verseOrgIds": [
              "DEU.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qotiyyoo fi harree walitti camaddee ittiin hin qotin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.10",
            "verseOrgIds": [
              "DEU.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uffata suufii fi quncee talbaa kan walitti foʼamee dhaʼame hin uffatin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.11",
            "verseOrgIds": [
              "DEU.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Roga wayyaa uffattuu afran irratti handaara tolchi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.12",
            "verseOrgIds": [
              "DEU.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rakkina Gaaʼela Keessatti Uumamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo namni tokko niitii fuudhee erga ishee wajjin ciisee booddee ishee jibbee,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.13",
            "verseOrgIds": [
              "DEU.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ishees qaanessee maqaa balleessuudhaan, \"Ani niitii tana fuudheera; garuu yommuu ani ishee wajjin ciisetti waan durbummaa ishee mirkaneessu hin arganne\" jedhee,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.14",
            "verseOrgIds": [
              "DEU.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "abbaa fi haati intalattii ragaa durbummaa ishee mirkaneessu balbala irratti maanguddoota magaalattiitti haa dhiʼeessan.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.15",
            "verseOrgIds": [
              "DEU.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abbaan intalattiis maanguddootaan akkana haa jedhu; \"Ani intala koo nama kanatti heerumsiiseera; inni garuu ishee jibbe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.16",
            "verseOrgIds": [
              "DEU.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maqaa ishees balleessee, 'Ani intala kee durbummaa isheetiin hin arganne' jedhe. Garuu ragaan durbummaa intala kootii mirkaneessu kunoo ti.\" Kana irratti abbaa fi haati ishee fuula maanguddoota magaalattii duratti wayyaa sana haa diriirsan;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.17",
            "verseOrgIds": [
              "DEU.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "maanguddoonni sunis namicha sana qabanii haa adaban.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.18",
            "verseOrgIds": [
              "DEU.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis sababii namichi kun maqaa durba Israaʼel tokkoo xureesseef meetii saqilii dhibba tokko baasisanii abbaa intalattiitiif haa kennan; isheen niitii isaa taatee haa jiraattu; innis hamma lubbuudhaan jirutti ishee hiikuu hin dandaʼu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.19",
            "verseOrgIds": [
              "DEU.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus yoo himannaan dhiʼaate sun dhugaa taʼee ragaan durbummaa intalattii mirkaneessu hin argamin,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.20",
            "verseOrgIds": [
              "DEU.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "isheen balbala mana abbaa ishee duratti fidamtee namoonni magaalaa ishee hamma isheen duututti dhagaadhaan ishee haa tuman; isheen utuma mana abbaa ishee jirtuu sagaagaluudhaan gocha Israaʼel keessatti qaanii taʼe hojjetteerti. Ati gidduu keetii waan hamaa baasuu qabda.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.21",
            "verseOrgIds": [
              "DEU.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo namni tokko utuu niitii nama biraa wajjin ciisuu argame lamaan isaanii iyyuu, namichi ishee wajjin ciisee fi dubartiin sun ajjeefamuu qabu. Ati Israaʼel keessaa waan hamaa baasuu qabda.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.22",
            "verseOrgIds": [
              "DEU.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo namni tokko durba kaadhimamte magaalaatti argee ishee wajjin ciise,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.23",
            "verseOrgIds": [
              "DEU.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "waan isheen utuu magaalaa keessa jirtuu na oolchaa jettee hin iyyiniif, namichi immoo waan niitii nama biraa salphiseef, lamaan isaanii iyyuu gara balbala magaalaatti geessaatii hamma isaan duʼanitti dhagaadhaan tumaa. Waan hamaa gidduu keessanii balleessaa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.24",
            "verseOrgIds": [
              "DEU.22.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu yoo namni tokko durba kadhatamte tokko baadiyyaatti argee ishee gudeede, namichi waan kana godhe qofti haa ajjeefamu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.25",
            "verseOrgIds": [
              "DEU.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intalattii hin tuqinaa; isheen cubbuu duʼaan ishee gaʼu tokko iyyuu hin hojjenneetii. Dubbiin akkasii nama balaa buusee namicha ollaa isaa ajjeesuun wal fakkaata;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.26",
            "verseOrgIds": [
              "DEU.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis waan namichi durba kaadhimamte sana baadiyyaatti argatee yoo iyyite illee namni isheef birmatu hin argamneef.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.27",
            "verseOrgIds": [
              "DEU.22.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni tokko yoo durba hin kaadhimamin tokko argee humnaan ishee gudeedee wanni kun beekame,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.28",
            "verseOrgIds": [
              "DEU.22.28"
            ]
          }
        },
        {
