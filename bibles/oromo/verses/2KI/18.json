    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara Hoosheeʼaa ilma Eelaa mooticha Israaʼel keessa waggaa sadaffaatti Hisqiyaas ilmi Aahaaz mooticha Yihuudaa mootii taʼee bulchuu jalqabe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.1",
            "verseOrgIds": [
              "2KI.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni Yeroo mootii taʼetti nama waggaa digdamii shan ture; innis Yerusaalem keessa taaʼee waggaa digdamii sagal bulche. Maqaan haadha isaa Abiiyaa ture; isheenis intala Zakkaariyaas.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.2",
            "verseOrgIds": [
              "2KI.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akkuma Daawit abbaan isaa godhe sana fuula",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.3",
            "verseOrgIds": [
              "2KI.18.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.18.3",
                "verseOrgIds": [
                  "2KI.18.3"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti waan qajeelaa hojjete.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.3",
            "verseOrgIds": [
              "2KI.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni iddoowwan sagadaa kanneen gaarran irraa diige; dhagaawwan waaqeffannaa caccabsee siidaawwan Aasheeraa illee burkuteesse. Sababii Israaʼeloonni hamma bara sanaatti ixaana aarsaafii turaniif inni fakkii bofaa kan Museen naasii irraa hojjete sana illee ni caccabse. Fakkiin bofaa sun Nehushtaan jedhamee waamama ture.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.4",
            "verseOrgIds": [
              "2KI.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hisqiyaas",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.5",
            "verseOrgIds": [
              "2KI.18.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.18.5",
                "verseOrgIds": [
                  "2KI.18.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa Israaʼel amanate. Mootota Yihuudaa hunda keessaa namni akka isaa tokko iyyuu isa duraan yookaan isa duubaan hin turre.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.5",
            "verseOrgIds": [
              "2KI.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni jabaatee",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.6",
            "verseOrgIds": [
              "2KI.18.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyotti",
              "type": "text",
              "attrs": {
                "verseId": "2KI.18.6",
                "verseOrgIds": [
                  "2KI.18.6"
                ]
              }
            }
          ]
        },
        {
          "text": "hiiqe malee isa duukaa buʼuu hin dhiisne; seera",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.6",
            "verseOrgIds": [
              "2KI.18.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.18.6",
                "verseOrgIds": [
                  "2KI.18.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Museef kenne sanas ni eege.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.6",
            "verseOrgIds": [
              "2KI.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "2KI.18.7",
                "verseOrgIds": [
                  "2KI.18.7"
                ]
              }
            }
          ]
        },
        {
          "text": "isa wajjin ture; inni waan hojjete hunda keessatti ni milkaaʼe. Inni mootii Asooritti fincile malee isa hin tajaajille.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.7",
            "verseOrgIds": [
              "2KI.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni gamoo eegumsaatii jalqabee hamma magaalaa dallaa jabaa qabuutti, hamma Gaazaattii fi daangaa isheetti Filisxeemota ni moʼate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.8",
            "verseOrgIds": [
              "2KI.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waggaa afuraffaa bara Hisqiyaas mootichaa keessa jechuunis waggaa torbaffaa bara Hoosheeʼaa ilma Eelaa mooticha Israaʼel keessa Shalmaneseer mootichi Asoor Samaariyaatti duulee marsee ishee qabate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.9",
            "verseOrgIds": [
              "2KI.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhuma waggaa sadaffaatti Asooronni ishee fudhatan. Akkasiinis Samaariyaan waggaa jaʼaffaa bara mootummaa Hisqiyaas keessa, waggaa saglaffaa bara Hoosheeʼaa mooticha Israaʼel keessa ni fudhatamte.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.10",
            "verseOrgIds": [
              "2KI.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootiin Asooris Israaʼeloota boojiʼee Asooritti geessee Halaa keessa, Goozaan keessa, Laga Haaboor biraa fi magaalaawwan Midiyaan keessa ni qubachiise.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.11",
            "verseOrgIds": [
              "2KI.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni kun sababii isaan",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.12",
            "verseOrgIds": [
              "2KI.18.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.18.12",
                "verseOrgIds": [
                  "2KI.18.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa isaaniitiif ajajamuu didanii kakuu isaa, ajaja Museen garbichi",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.12",
            "verseOrgIds": [
              "2KI.18.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.18.12",
                "verseOrgIds": [
                  "2KI.18.12"
                ]
              }
            }
          ]
        },
        {
          "text": "isaaniif kenne hunda cabsaniif isaanitti dhufe. Isaan ajaja sana hin dhaggeeffanne yookaan hojii irra hin oolchine.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.12",
            "verseOrgIds": [
              "2KI.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara mootummaa Hisqiyaas mootichaa keessa waggaa kudha afuraffaatti, Senaaheriib mootichi Asoor magaalaawwan Yihuudaa kanneen dallaa jabaa qaban hunda lolee ni qabate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.13",
            "verseOrgIds": [
              "2KI.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Hisqiyaas mootichi Yihuudaa, \"Ani balleessaa hojjedheera. Biyya koo keessaa naa baʼi; ani waan ati na gaafattu kam iyyuu siifin kennaa\" jedhee gara Laakkiishitti mooticha Asooritti ergaa ergate. Mootichi Asooris, \"Meetii taalaantii dhibba sadii fi warqee taalaantii soddoma naa kenni\" jedhee Hisqiyaas mooticha Yihuudaa ni gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.14",
            "verseOrgIds": [
              "2KI.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Hisqiyaas meetii mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.15",
            "verseOrgIds": [
              "2KI.18.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.18.15",
                "verseOrgIds": [
                  "2KI.18.15"
                ]
              }
            }
          ]
        },
        {
          "text": "keessattii fi kan mankuusaa masaraa mootummaa keessatti argamu hunda guuree kenneef.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.15",
            "verseOrgIds": [
              "2KI.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo kanatti Hisqiyaas mootichi Yihuudaa warqee balbalaa fi dhaaba balbala mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.16",
            "verseOrgIds": [
              "2KI.18.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootti",
              "type": "text",
              "attrs": {
                "verseId": "2KI.18.16",
                "verseOrgIds": [
                  "2KI.18.16"
                ]
              }
            }
          ]
        },
        {
          "text": "uffisee ture irraa baasee mootii Asooriif kenne.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.16",
            "verseOrgIds": [
              "2KI.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Senaaheriib Yerusaalemin Doorsise",
          "type": "text"
        }
      ]
    },
    {
