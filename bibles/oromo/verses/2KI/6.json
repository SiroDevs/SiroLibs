  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "2KI 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Qottoon Bishaan Irra Deeme",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaan raajotaa sun Elsaaʼiin akkana jedhan; \"Kunoo, iddoon nu si wajjin wal geenyu nutti dhiphateera.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.1",
            "verseOrgIds": [
              "2KI.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka nu Yordaanos dhaqnee tokkoon tokkoon keenya muka cirannee iddoo jiraannu achitti ijaarrannuuf nuu eeyyami.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.2",
            "verseOrgIds": [
              "2KI.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 6:2"
      },
      "items": [
        {
          "text": "Innis, \"Dhaqaa\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.2",
            "verseOrgIds": [
              "2KI.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan keessaa namni tokko, \"Maaloo ati nu garboota kee wajjin hin deemtuu?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.3",
            "verseOrgIds": [
              "2KI.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 6:3"
      },
      "items": [
        {
          "text": "Elsaaʼi immoo, \"Nan deema\" jedhee deebise.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.3",
            "verseOrgIds": [
              "2KI.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis isaan wajjin deeme.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.4",
            "verseOrgIds": [
              "2KI.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 6:4"
      },
      "items": [
        {
          "text": "Isaan Yordaanos dhaqanii muka cirachuu jalqaban.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.4",
            "verseOrgIds": [
              "2KI.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan keessaa tokko utuu muka muruutti jiruu qottoon muka isaa irraa buqqaʼee bishaan keessa buʼe. Namichi sunis, \"Wayyoo kaa, yaa gooftaa koo; wanni kun waan ergifatamee dha!\" jedhee iyye.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.5",
            "verseOrgIds": [
              "2KI.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni Waaqaa sunis \"Qottoon eessa buʼe?\" jedhee gaafate. Yommuu inni iddoo qottoon sun buʼe isa argisiisetti Elsaaʼi muka xinnaa tokko kutee achi keessa buusee akka sibiilli sun bishaan gubbaa deemu godhe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.6",
            "verseOrgIds": [
              "2KI.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis, \"Ol fudhadhu\" jedheen. Namichi sunis harka diriirfatee qottoo isaa fudhate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.7",
            "verseOrgIds": [
              "2KI.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Elsaaʼi Namoota Sooriyaa Jaamse",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo sanatti mootiin Sooriyaa Israaʼeliin wal lolaa ture. Innis erga ajajjoota loltoota isaatiin mariʼatee booddee, \"Ani lafa akkasiitii fi lafa akkasii keessa qubata koo nan dhaabbadha\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.8",
            "verseOrgIds": [
              "2KI.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni Waaqaa sunis, \"Sababii namoonni Sooriyaa achitti gad buʼaa jiraniif ati akka karaa sanaan hin dabarre of eeggadhu\" jedhee mootii Israaʼelitti ergaa erge.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.9",
            "verseOrgIds": [
              "2KI.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu mootiin Israaʼel gara iddoo namni Waaqaa sun waaʼee isaa dubbate sanaatti nama ergee ni toʼate. Elsaaʼis akka mootichi iddoowwan akkasii irraa of eeggatu ammumaa amma isa akeekkachiise.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.10",
            "verseOrgIds": [
              "2KI.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni kun akka malee mootii Sooriyaa aarse. Innis ajajjoota loltoota isaa walitti waamee, \"Isin amma nama nu keessaa mootii Israaʼeliif hojjechaa jiru natti hin himtanii?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.11",
            "verseOrgIds": [
              "2KI.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajajjoota sana keessaa namni tokko akkana jedhe; \"Yaa gooftaa koo mooticha, nu keessaa namni akkasii hin jiru; garuu Elsaaʼi raajicha Israaʼel keessa jiru sanatu dubbii ati diinqa kee keessatti dubbattu hunda mootii Israaʼelitti hima.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.12",
            "verseOrgIds": [
              "2KI.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichi Sooriyaas, \"Akka ani nama itti ergee isa qabsiisuu dandaʼuuf dhaqaatii lafa inni jiru ilaalaa\" jedhee ajaje. Oduun, \"Inni Dootaan keessa jira\" jedhu tokkos isatti himame.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.13",
            "verseOrgIds": [
              "2KI.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis ergasii fardeen, gaariiwwanii fi waraana jabaa achitti ni erge. Isaanis halkaniin dhaqanii magaalaa sana marsan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.14",
            "verseOrgIds": [
              "2KI.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu tajaajilaan nama Waaqaa sanaa guyyaa itti aanu ganama bariin gad baʼetti humni waraanaa tokko fardeenii fi gaariiwwaniin magaalaa sana marsee ture. Tajaajilaan sunis, \"Wayyoo kaa, yaa gooftaa ko, maal goonu?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.15",
            "verseOrgIds": [
              "2KI.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Raajiin sun immoo, \"Hin sodaatin; warri nu wajjin jiran warra isaan wajjin jiran caalaniitii\" jedhee deebise.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.16",
            "verseOrgIds": [
              "2KI.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elsaaʼis, \"Yaa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.17",
            "verseOrgIds": [
              "2KI.6.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.6.17",
                "verseOrgIds": [
                  "2KI.6.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", akka inni arguu dandaʼuuf ija isaa baniif\" jedhee kadhate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.17",
            "verseOrgIds": [
              "2KI.6.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "2KI.6.17",
                "verseOrgIds": [
                  "2KI.6.17"
                ]
              }
            }
          ]
        },
        {
          "text": "ija tajaajilaa sanaa ni bane; innis milʼatee akka gaarran sun naannoo Elsaaʼitti fardeenii fi gaariiwwan ibiddaatiin guutamanii jiran ni arge.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.17",
            "verseOrgIds": [
              "2KI.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diinni sun gara isaatti gad buunaan Elsaaʼi, \"Jara kana jaamsi\" jedhee",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.18",
            "verseOrgIds": [
              "2KI.6.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "2KI.6.18",
                "verseOrgIds": [
                  "2KI.6.18"
                ]
              }
            }
          ]
        },
        {
          "text": "kadhate. Kanaafuu Waaqni akkuma Elsaaʼi isa kadhate sana isaan jaamse.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.18",
            "verseOrgIds": [
              "2KI.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elsaaʼis, \"Karaan sun kana miti; magaalaan sunis kana miti. Amma na duukaa buʼaa; anis nama isin barbaaddanitti isinan geessa\" jedheen. Innis akkasiin Samaariyaatti isaan ni geesse.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.19",
            "verseOrgIds": [
              "2KI.6.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erga isaan magaalaa sana seenanii booddee Elsaaʼi, \"Yaa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.20",
            "verseOrgIds": [
              "2KI.6.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.6.20",
                "verseOrgIds": [
                  "2KI.6.20"
                ]
              }
            }
          ]
        },
        {
          "text": "akka isaan arguu dandaʼaniif ija jara kanaa baniif\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.20",
            "verseOrgIds": [
              "2KI.6.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "2KI.6.20",
                "verseOrgIds": [
                  "2KI.6.20"
                ]
              }
            }
          ]
        },
        {
          "text": "ija isaanii ni baneef; isaanis akka Samaariyaa keessa jiran ni argan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.20",
            "verseOrgIds": [
              "2KI.6.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootiin Israaʼelis isaan arginaan, \"Yaa abbaa ko, ani isaan fixuu? Ani isaan fixuu?\" jedhee Elsaaʼin ni gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.21",
            "verseOrgIds": [
              "2KI.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akkana jedhee deebise; \"Isaan hin fixin; ati namoota boojite goraadee keetiin yookaan xiyya keetiin ni ajjeeftaa? Akka isaan nyaatanii dhuganii gara gooftaa isaaniitti deebiʼaniif nyaataa fi dhugaatii dhiʼeessiif.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.22",
            "verseOrgIds": [
              "2KI.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu inni cidha guddaa qopheesseefii erga isaan nyaatanii dhuganii booddee of irraa isaan geggeesse; isaanis gara gooftaa isaaniitti deebiʼan. Namoonni Sooriyaas ergasii deebiʼanii biyya Israaʼel hin weerarre.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.23",
            "verseOrgIds": [
              "2KI.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ben-Hadaad Samaariyaa Marse",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo gabaabaa booddee, Ben-Hadaad mootichi Sooriyaa loltoota isaa hunda walitti qabatee dhaqee Samaariyaa marse.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.24",
            "verseOrgIds": [
              "2KI.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beela akka malee hamaatu magaalaa sana keessa ture; waan magaalaan sun yeroo dheeraadhaaf marfamteef, mataan harree tokko meetii saqilii saddeettamatti, udaan gugee kiiloon tokko harka afur keessaa harki tokko meetii saqilii shanitti gurgurame.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.25",
            "verseOrgIds": [
              "2KI.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuu mootiin Israaʼel dallaa dhagaa irraan darbuu dubartiin tokko, \"Yaa gooftaa koo mooticha, na gargaari\" jettee itti iyyite.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.26",
            "verseOrgIds": [
              "2KI.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichi immoo akkana jedhee deebiseef; \"Yoo",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.27",
            "verseOrgIds": [
              "2KI.6.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.6.27",
                "verseOrgIds": [
                  "2KI.6.27"
                ]
              }
            }
          ]
        },
        {
          "text": "si hin gargaarin ani eessaan gargaarsa siif arga? Oobdii midhaanii irraa moo? Iddoo wayinii itti cuunfan irraa?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.27",
            "verseOrgIds": [
              "2KI.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii, \"Rakkoon kee maal?\" jedhee ishee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.28",
            "verseOrgIds": [
              "2KI.6.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 6:28"
      },
      "items": [
        {
          "text": "Isheenis akkana jettee deebifteef; \"Dubartiin kun, 'Akka nu harʼa isa nyaannuuf mucaa kee nuu kenni; bor immoo mucaa koo nyaannaatii' naan jette.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.28",
            "verseOrgIds": [
              "2KI.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaaf nu mucaa koo bilcheeffannee nyaanne. Guyyaa itti aanutti immoo ani, 'Akka nu isa nyaannuuf mucaa kee nuuf kenni' jedheen. Isheen garuu mucaa ishee ni dhokfatte.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.29",
            "verseOrgIds": [
              "2KI.6.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichi yommuu dubbii dubartii sanaa dhagaʼetti uffata isaa tarsaase. Utuu inni dallaa dhagaa irraan darbaa jiruu namoonni akka inni dhagna isaatti aansee wayyaa gaddaa uffatee jiru argan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.30",
            "verseOrgIds": [
              "2KI.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis, \"Yoo mataan Elsaaʼi ilma Shaafaax, edana isa irra bule, Waaqni na haa adabu; adabbiin sunis akka malee natti haa cimuu!\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.31",
            "verseOrgIds": [
              "2KI.6.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo kanatti Elsaaʼi mana isaa keessa taaʼaa ture; maanguddoonnis isa wajjin tataaʼaa turan. Mootichi ergamaa tokko of dura erge; garuu utuu ergamaan sun hin dhufinuu Elsaaʼi maanguddootaan akkana jedhe; \"Isin akka namichi nama ajjeesu kun mataa narraa kutuuf nama erge argituu? Kunoo yoo ergamaan sun dhufe balbala cufaatii ol seenuu dhowwaa. Kotteen gooftaa isaa isa duubaan dhagaʼamaa jira mitii?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.32",
            "verseOrgIds": [
              "2KI.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuma inni amma iyyuu isaan wajjin haasaʼaa jiruu, ergamaan sun gara isaa dhufe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.33",
            "verseOrgIds": [
              "2KI.6.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 6:33"
      },
      "items": [
        {
          "text": "Mootichis, \"Balaan kun",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.33",
            "verseOrgIds": [
              "2KI.6.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.6.33",
                "verseOrgIds": [
                  "2KI.6.33"
                ]
              }
            }
          ]
        },
        {
          "text": "biraa dhufe. Ani siʼachi maaliifin",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.33",
            "verseOrgIds": [
              "2KI.6.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "2KI.6.33",
                "verseOrgIds": [
                  "2KI.6.33"
                ]
              }
            }
          ]
        },
        {
          "text": "eega?\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.33",
            "verseOrgIds": [
              "2KI.6.33"
            ]
          }
        }
      ]
    }
  ],
