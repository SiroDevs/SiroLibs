  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "2KI 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Naʼamaan Lamxii Irraa Fayyifame",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naʼamaan ajajaa loltoota mooticha Sooriyaa ture. Sababii",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.1",
            "verseOrgIds": [
              "2KI.5.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.5.1",
                "verseOrgIds": [
                  "2KI.5.1"
                ]
              }
            }
          ]
        },
        {
          "text": "karaa isaatiin warra Sooriyaatiif mooʼicha kenneef inni fuula gooftaa isaa duratti nama guddaa akka malee ulfina qabu ture. Inni loltuu jagna; garuu lamxii qaba ture.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.1",
            "verseOrgIds": [
              "2KI.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara sana keessa tuunni loltoota Sooriyaa dhaqee intala dargaggeettii gosa Israaʼel tokko boojiʼe; isheenis niitii Naʼamaan tajaajilaa turte.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.2",
            "verseOrgIds": [
              "2KI.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheenis giiftii isheetiin, \"Gooftaan koo utuu raajicha Samaariyaa jiru sana bira dhaqee silaa inni lamxii sana irraa isa fayyisa ture!\" jette.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.3",
            "verseOrgIds": [
              "2KI.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naʼamaan dhaqee waan intalli Israaʼel jetteen sana gooftaa isaatti ni hime.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.4",
            "verseOrgIds": [
              "2KI.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootiin Sooriyaas, \"Waan fedhe illee taanaan ati dhaqi; ani mootii Israaʼelitti xalayaa nan barreessaatii\" jedhee deebiseef. Kanaafuu Naʼamaan meetii taalaantii kudhan, warqee saqilii kuma jaʼaa fi uffata irraa jalaa kudhan fudhatee qajeele.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.5",
            "verseOrgIds": [
              "2KI.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Xalayaan inni mootii Israaʼelitti geesse sun akkana jedha; \"Ani akka ati lamxii irraa isa fayyiftuuf xalayaa kana wajjin tajaajilaa koo Naʼamaanin sitti ergeera.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.6",
            "verseOrgIds": [
              "2KI.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootiin Israaʼelis akkuma xalayaa sana dubbiseen uffata ofii tarsaasee akkana jedhe; \"Ani Waaqaa? Ani nama ajjeesuu fi deebisee jiraachisuu nan dandaʼaa? Namichi kun maaliif akka lamxiin isaa fayyuuf nama natti erga? Mee akka inni lola natti kaasuu barbaadu ilaalaa!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.7",
            "verseOrgIds": [
              "2KI.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elsaaʼi namni Waaqaa sun akka mootiin Israaʼel uffata isaa tarsaase dhageenyaan ergaa itti ergee, \"Ati maaliif uffata kee tarsaafte? Namicha sana natti ergi; innis akka Israaʼel keessa raajiin jiru ni beekaatii\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.8",
            "verseOrgIds": [
              "2KI.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Naʼamaan fardeen isaatii fi gaariiwwan isaa fudhatee dhaqee balbala mana Elsaaʼi dura dhaabate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.9",
            "verseOrgIds": [
              "2KI.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elsaaʼi immoo, \"Dhaqii Yordaanos keessatti yeroo torba dhiqadhu; foon kee fayyee akka duraatti siif deebiʼa; atis ni qulqullooftaa\" jedhee nama itti erge.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.10",
            "verseOrgIds": [
              "2KI.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naʼamaan garuu aariidhaan kaʼee biraa deemee akkana jedhe; \"Ani waan inni dhugumaan gara koo dhufee dhaabatee maqaa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.11",
            "verseOrgIds": [
              "2KI.5.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.5.11",
                "verseOrgIds": [
                  "2KI.5.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa isaa waamee iddoo sana irra harka isaa qabee lamxii koo fayyisun seʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.11",
            "verseOrgIds": [
              "2KI.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaanaa fi Faarfaan lageen Damaasqoo sun bishaanota Israaʼel keessaa kam iyyuu hin caalanii? Ani isaan keessatti dhiqadhee fayyuu hin dandaʼu turee?\" Kanaafuu inni akka malee aaree of irra garagalee deeme.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.12",
            "verseOrgIds": [
              "2KI.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tajaajiltoonni Naʼamaanis gara isaa dhaqanii, \"Yaa abbaa ko, ati utuu raajiin kun waan guddaa tokko hojjedhu siin jedhee ni hojjetta mitii? Yoo inni, 'Dhiqadhuutii qulqullaaʼi' siin jedhe immoo hammam caalchiftee hin hojjettu ree?\" jedhaniin.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.13",
            "verseOrgIds": [
              "2KI.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu inni dhaqee akkuma namni Waaqaa sun jedheenitti yeroo torba Yordaanos keessa seenee baʼe; dhagni isaas fayyee akkuma duraatti deebiʼeefii akkuma dhagna mucaa xinnaa tokkootti qulqullaaʼeef.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.14",
            "verseOrgIds": [
              "2KI.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Naʼamaanii fi tajaajiltoonni isaa hundi gara nama Waaqaa sanaatti deebiʼan. Niʼimaanis fuula isaa dura dhaabatee, \"Ani akka Israaʼel keessa malee addunyaa guutuu keessa Waaqni hin jirre amma beekeera. Kanaafuu maaloo garbicha kee irraa kennaa tokko fudhadhu\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.15",
            "verseOrgIds": [
              "2KI.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Raajiin sun immoo, \"Dhugaa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.16",
            "verseOrgIds": [
              "2KI.5.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.5.16",
                "verseOrgIds": [
                  "2KI.5.16"
                ]
              }
            }
          ]
        },
        {
          "text": "jiraataa ani isa tajaajiluu sanaa, ani waan tokko illee sirraa hin fudhadhu\" jedhee deebise. Yoo Naʼamaan cimsee isa kadhate iyyuu inni fudhachuu dide.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.16",
            "verseOrgIds": [
              "2KI.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti Naʼamaan akkana jedheen; \"Yoo fudhachuu baatte immoo, maaloo akka biyyoon gaangoo lamaa ana garbicha keetiif kennamu ajaji; garbichi kee siʼachi deebiʼee",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.17",
            "verseOrgIds": [
              "2KI.5.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "2KI.5.17",
                "verseOrgIds": [
                  "2KI.5.17"
                ]
              }
            }
          ]
        },
        {
          "text": "malee waaqota tolfamoo biraatiif aarsaa gubamuu fi qalma hin dhiʼeessuutii.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.17",
            "verseOrgIds": [
              "2KI.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.18",
            "verseOrgIds": [
              "2KI.5.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.5.18",
                "verseOrgIds": [
                  "2KI.5.18"
                ]
              }
            }
          ]
        },
        {
          "text": "waan tokkicha kana garbicha keetiif haa dhiisu: Gooftaan koo yommuu achitti sagaduuf mana qulqullummaa Rimoon seenutti natti irkata; anis yommuu inni sagadutti nan sagada;",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.18",
            "verseOrgIds": [
              "2KI.5.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.5.18",
                "verseOrgIds": [
                  "2KI.5.18"
                ]
              }
            }
          ]
        },
        {
          "text": "waan kana ana garbicha keetiif haa dhiisu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.18",
            "verseOrgIds": [
              "2KI.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eelisaaʼis, \"Nagaan deemi\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.19",
            "verseOrgIds": [
              "2KI.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 5:19"
      },
      "items": [
        {
          "text": "Erga Naʼamaan xinnoo achi fagaatee booddee,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.19",
            "verseOrgIds": [
              "2KI.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gehaaz tajaajilaan Elsaaʼi nama Waaqaa sanaa akkana ofiin jedhe; \"Gooftaan koo utuu kennaa inni fide sana irraa hin fudhatin Naʼamaan namicha warra Arraam kana akkasumatti gad lakkise. Dhugaa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.20",
            "verseOrgIds": [
              "2KI.5.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.5.20",
                "verseOrgIds": [
                  "2KI.5.20"
                ]
              }
            }
          ]
        },
        {
          "text": "jiraataa, ani isa faana fiigeen waa irraa fudhadha.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.20",
            "verseOrgIds": [
              "2KI.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Gehaaz dafee Niʼimaan duukaa buʼe. Naʼamaanis yommuu akka inni gara isaatti fiigaa jiru argetti isa simachuudhaaf gaarii irraa buʼee, \"Wanni hundi nagumaa?\" jedhee isa gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.21",
            "verseOrgIds": [
              "2KI.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gehaazis akkana jedhee deebiseef; \"Wanni hundinuu naguma. Gooftaan koo, 'Kunoo ammuma waldaa raajotaa keessaa dargaggoonni lama biyya gaaraa Efreem irraa natti dhufaniiru. Maaloo meetii taalaantii tokkoo fi uffata irraa jalaa lama kenniif' akkan siin jedhuuf na erge.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.22",
            "verseOrgIds": [
              "2KI.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naʼamaan immoo Gehaaziin, \"Akkuma fedhe illee taʼu taalaantii lama fudhadhu\" jedhe. Innis akka Gehaaz waan sana fudhatuuf cimsee isa kadhate; ergasiis meetii taalaantii lama borsaa lamatti hidhee uffata irraa jalaa lama wajjin tajaajiltoota isaatti kenne. Isaanis baatanii Gehaaz dura qajeelan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.23",
            "verseOrgIds": [
              "2KI.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gehaazis yommuu gaara bira gaʼetti waan sana hojjettoota sana harkaa fuudhee mana keessa ol kaaʼe. Namoota sanas of irraa geggeesse; isaanis kaʼanii deeman.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.24",
            "verseOrgIds": [
              "2KI.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis ergasii dhaqee fuula gooftaa isaa Elsaaʼi dura dhaabate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.25",
            "verseOrgIds": [
              "2KI.5.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 5:25"
      },
      "items": [
        {
          "text": "Elsaaʼis, \"Gehaaz, ati eessa turte?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.25",
            "verseOrgIds": [
              "2KI.5.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 5:25"
      },
      "items": [
        {
          "text": "Gehaaz immoo, \"Ani garbichi kee eessa iyyuu hin deemne\" jedhee deebise.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.25",
            "verseOrgIds": [
              "2KI.5.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elsaaʼi garuu akkana jedheen; \"Yeroo namichi sun siʼi simachuuf gaarii isaa irraa buʼe sanatti hafuurri koo si wajjin hin turree? Yeroon kun yeroo itti maallaqa yookaan wayyaa, lafa qotiisaa ejersaa, iddoo dhaabaa wayinii, bushaayee, karra loonii yookaan garboota dhiiraa fi garboota nadheenii fudhataniidhaa?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.26",
            "verseOrgIds": [
              "2KI.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lamxiin Naʼamaan sun hamma bara baraatti siʼii fi sanyii keetiitti qabatee hafa.\" Innis lamxaaʼee akkuma cabbii addaatee fuula Elsaaʼi duraa baʼee deeme.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.27",
            "verseOrgIds": [
              "2KI.5.27"
            ]
          }
        }
      ]
    }
  ],
