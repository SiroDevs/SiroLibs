        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lafti Dubartii Suunam Ni Deebiʼeef",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo kanatti Elsaaʼi dubartii ilma ishee duʼaa kaaseef sanaan, \"Sababii",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.1",
            "verseOrgIds": [
              "2KI.8.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.8.1",
                "verseOrgIds": [
                  "2KI.8.1"
                ]
              }
            }
          ]
        },
        {
          "text": "beela waggaa torba turu tokko biyya kanatti ajajeef, maatii kee wajjin asii deemiitii iddoo jiraachuu dandeessu kam iyyuu jiraadhu\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.1",
            "verseOrgIds": [
              "2KI.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubartiin sunis kaatee akkuma namni Waaqaa sun jedheen goote. Ishee fi maatiin ishee dhaqanii biyya Filisxeemotaa keessa waggaa torba jiraatan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.2",
            "verseOrgIds": [
              "2KI.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheenis dhuma waggaa torbaatti biyya Filisxeemotaatii deebitee manaa fi lafa ishee kadhachuuf gara mootichaa ni dhaqxe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.3",
            "verseOrgIds": [
              "2KI.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis, \"Mee waan Elsaaʼi hojjete gurguddaa natti himi\" jedhee Gehaaz tajaajilaa nama Waaqaa sana wajjin haasaʼaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.4",
            "verseOrgIds": [
              "2KI.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuma Gehaaz akka Elsaaʼi nama duʼe illee duʼaa kaase isatti himuutti jiruu dubartiin Elsaaʼi ilma ishee duʼaa kaaseef sun manaa fi lafa ishee kadhachuudhaaf gara mootichaa dhufte.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.5",
            "verseOrgIds": [
              "2KI.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 8:5"
      },
      "items": [
        {
          "text": "Gehaazis, \"Yaa gooftaa koo mooticha, dubartiin Elsaaʼi mucaa ishee duʼaa kaaseef sun kunoo ti\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.5",
            "verseOrgIds": [
              "2KI.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichi waaʼee waan sanaa dubartittii gaafate; isheenis itti himte.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.6",
            "verseOrgIds": [
              "2KI.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 8:6"
      },
      "items": [
        {
          "text": "Innis ergasii qondaala tokko dubbii isheetti ramadee, \"Galii guyyaa isheen biyyaa baatee jalqabee lafa qotiisaa ishee irraa argame hunda itti dabaliitii waan kan ishee ture hunda deebisiif\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.6",
            "verseOrgIds": [
              "2KI.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hazaaʼeel Ben-Hadaadin Ajjeese",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elsaaʼi Damaasqoo dhaqe; Ben-Hadaad mootichi Sooriyaa immoo dhukkubsatee ture. Mootiin sunis yommuu, \"Namni Waaqaa sun as dhufee jira\" jedhanii itti himanitti,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.7",
            "verseOrgIds": [
              "2KI.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazaaʼeeliin akkana jedhe; \"Kennaa wayii fudhadhuutii dhaqii nama Waaqaa sana simadhu. Karaa isaatiinis, 'Ani dhukkuba kana irraa nan hafaa?' jedhii",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.8",
            "verseOrgIds": [
              "2KI.8.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "2KI.8.8",
                "verseOrgIds": [
                  "2KI.8.8"
                ]
              }
            }
          ]
        },
        {
          "text": "gaafadhu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.8",
            "verseOrgIds": [
              "2KI.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazaaʼeelis waan Damaasqoo keessaa akka malee gaggaarii taʼe fudhatee kennaa feʼiisa gaala afurtamaatiin Elsaaʼin simachuu dhaqe. Ol seenees fuula isaa dura dhaabatee, \"Ilma kee Ben-Hadaad mooticha Sooriyaatu, 'Ani dhukkuba kana irraa hafaa?' jedhee sitti na erge\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.9",
            "verseOrgIds": [
              "2KI.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elsaaʼi immoo, \"Dhaqiitii, 'Ati dhugumaan irraa hafta' jedhiin; garuu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.10",
            "verseOrgIds": [
              "2KI.8.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.8.10",
                "verseOrgIds": [
                  "2KI.8.10"
                ]
              }
            }
          ]
        },
        {
          "text": "akka inni dhugumaan duʼu na argisiiseera\" jedhee deebiseef.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.10",
            "verseOrgIds": [
              "2KI.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elsaaʼi hamma Hazaaʼeel qaanaʼutti utuu ija irraa hin buqqifatin isa ilaale. Ergasii namni Waaqaa sun booʼuu jalqabe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.11",
            "verseOrgIds": [
              "2KI.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazaaʼeelis, \"Gooftaan koo maaliif booʼa?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.12",
            "verseOrgIds": [
              "2KI.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 8:12"
      },
      "items": [
        {
          "text": "Inni immoo akkana jedhee deebise; \"Sababii ani miidhaa ati Israaʼelitti fiddu beekuuf; ati daʼannoo isaaniitti ibidda naqxa; dargaggoota isaanii goraadeedhaan fixxa; daaʼimman isaanii lafaan dhooftee mimmiciriqsita; dubartoota isaanii kanneen ulfaaʼan garaa baqaqsita.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.12",
            "verseOrgIds": [
              "2KI.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazaaʼeel, \"Ani garbichi kee sareen kun akkamiin waan hamtuu akkanaa hojjedha?\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.13",
            "verseOrgIds": [
              "2KI.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 8:13"
      },
      "items": [
        {
          "text": "Elsaaʼi immoo, \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.13",
            "verseOrgIds": [
              "2KI.8.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.8.13",
                "verseOrgIds": [
                  "2KI.8.13"
                ]
              }
            }
          ]
        },
        {
          "text": "akka ati mootii Sooriyaa taatu na argisiiseera\" jedhee deebiseef.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.13",
            "verseOrgIds": [
              "2KI.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazaaʼeel ergasii Elsaaʼi biraa baʼee gara gooftaa isaatti deebiʼe. Yommuu Ben-Hadaad, \"Elsaaʼi maal siin jedhe?\" jedhee gaafatettis, Hazaaʼeel, \"Inni akka ati dhugumaan irraa haftu natti hime\" jedhee deebise.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.14",
            "verseOrgIds": [
              "2KI.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni garuu guyyaa itti aanu wayyaa furdaa tokko fuudhee bishaan keessa cuuphee fuula mootichaa haguuge; akkasiin mootichi duʼe. Ergasii Hazaaʼeel iddoo isaa buʼee mootii taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.15",
            "verseOrgIds": [
              "2KI.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yehooraam Mooticha Yihuudaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2KI.8.16-2KI.8.24"
          },
          "items": [
            {
              "text": "8:16‑24",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwf –",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "xt"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "2CH.21.5-2CH.21.10"
              },
              "items": [
                {
                  "text": "2Sn 21:5‑10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "2CH.21.20"
              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara Yehooraam ilma Ahaab mooticha Israaʼel keessa waggaa shanaffaatti Yooraam ilmi Yehooshaafaax mooticha Yihuudaa sun mootii taʼee bulchuu jalqabe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.16",
            "verseOrgIds": [
              "2KI.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo sanatti umuriin isaa waggaa soddomii lama ture; innis Yerusaalem keessa taaʼee waggaa saddeet ni bulche.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.17",
            "verseOrgIds": [
              "2KI.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akkuma manni Ahaab godhee ture sana karaa mootota Israaʼel duukaa buʼe; intala Ahaab fuudhee tureetii. Fuula",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.18",
            "verseOrgIds": [
              "2KI.8.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.8.18",
                "verseOrgIds": [
                  "2KI.8.18"
                ]
              }
            }
          ]
        },
        {
          "text": "durattis waan hamaa hojjete.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.18",
            "verseOrgIds": [
              "2KI.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.19",
            "verseOrgIds": [
              "2KI.8.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.8.19",
                "verseOrgIds": [
                  "2KI.8.19"
                ]
              }
            }
          ]
        },
        {
          "text": "sababii garbicha isaa Daawitiif jedhee Yihuudaa balleessuun fedhii",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.19",
            "verseOrgIds": [
              "2KI.8.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.8.19",
                "verseOrgIds": [
                  "2KI.8.19"
                ]
              }
            }
          ]
        },
        {
          "text": "hin turre. Inni Daawitii fi sanyii isaatiif ibsaa bara baraa dhaabuuf kakuu galee ture.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.19",
            "verseOrgIds": [
              "2KI.8.19"
            ]
          }
        }
      ]
