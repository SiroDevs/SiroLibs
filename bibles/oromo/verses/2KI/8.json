    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara Yehooraam ilma Ahaab mooticha Israaʼel keessa waggaa kudha lammaffaatti Ahaaziyaan ilmi Yooraam mootii Yihuudaa taʼee bulchuu jalqabe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.25",
            "verseOrgIds": [
              "2KI.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahaaziyaan yeroo mootii taʼetti umuriin isaa waggaa digdamii lama ture; innis Yerusaalem keessa taaʼee waggaa tokko ni bulche. Maqaan haadha isaa Ataaliyaa dha; isheenis intala ilma Omrii mooticha Israaʼel sanaa turte.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.26",
            "verseOrgIds": [
              "2KI.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis karaa mana Ahaab duukaa buʼee, akkuma manni Ahaab godhe sana fuula",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.27",
            "verseOrgIds": [
              "2KI.8.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.8.27",
                "verseOrgIds": [
                  "2KI.8.27"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti waan hamaa hojjete; inni karaa fuudhaatiin maatii Ahaabitti firoomee tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.27",
            "verseOrgIds": [
              "2KI.8.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahaaziyaanis Yooraam ilma Ahaab wajjin Hazaaʼeel mooticha Arraam loluudhaaf Raamoot Giliʼaaditti duule. Warri Arraamis Yooraamin ni madeessan;",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.28",
            "verseOrgIds": [
              "2KI.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "kanaafuu Yehooraam mootichi madaa warri Arraam yeroo inni Raamaat keessatti Hazaaʼeel mooticha Arraam wajjin wal loletti isa madeessan sana fayyuuf jedhee Yizriʼeelitti deebiʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.29",
            "verseOrgIds": [
              "2KI.8.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 8:29"
      },
      "items": [
        {
          "text": "Kana irratti Ahaaziyaan ilmi Yooraam mootichi Yihuudaa sababii inni madaaʼee tureef Yooraam ilma Ahaab arguuf gara Yizriʼeelitti gad buʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.29",
            "verseOrgIds": [
              "2KI.8.29"
            ]
          }
        }
      ]
    }
