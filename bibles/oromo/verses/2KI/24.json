  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "2KI 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara mootummaa Yehooyaaqiim keessa Nebukadnezar mootichi Baabilon biyya sana ni weerare; Yehooyaaqiimis waggaa sadii isaaf garboome. Ergasii garuu yaada geeddaratee Nebukadnezaritti fincile.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.1",
            "verseOrgIds": [
              "2KI.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "2KI.24.2",
                "verseOrgIds": [
                  "2KI.24.2"
                ]
              }
            }
          ]
        },
        {
          "text": "saamtota Baabilon, saamtota Sooriyaa, saamtota Moʼaabii fi saamtota Amoon isatti erge. Innis akkuma dubbii",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.2",
            "verseOrgIds": [
              "2KI.24.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.24.2",
                "verseOrgIds": [
                  "2KI.24.2"
                ]
              }
            }
          ]
        },
        {
          "text": "kan garboonni isaa raajonni dubbatan sanaatti Yihuudaa balleessuudhaaf isaan erge.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.2",
            "verseOrgIds": [
              "2KI.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhugumaan wanni kun sababii cubbuu Minaaseetii fi waan inni hojjete hundaatiif fuula isaa duraa isaan balleessuudhaaf akkuma ajaja",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.3",
            "verseOrgIds": [
              "2KI.24.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootti",
              "type": "text",
              "attrs": {
                "verseId": "2KI.24.3",
                "verseOrgIds": [
                  "2KI.24.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Yihuudaatti dhufe;",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.3",
            "verseOrgIds": [
              "2KI.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkasumas sababii inni dhiiga namoota yakka hin qabnee dhangalaasee fi sababii inni dhiiga namoota yakka hin qabneetiin Yerusaalemin guuteef",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.4",
            "verseOrgIds": [
              "2KI.24.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.24.4",
                "verseOrgIds": [
                  "2KI.24.4"
                ]
              }
            }
          ]
        },
        {
          "text": "dhiisuufii hin barbaanne.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.4",
            "verseOrgIds": [
              "2KI.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wantoonni bara mootummaa Yehooyaaqiim keessa hojjetaman kanneen biraatii fi wanni inni hojjete hundi kitaaba seenaa mootota Yihuudaa keessatti barreeffamaniiru mitii?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.5",
            "verseOrgIds": [
              "2KI.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooyaaqiim abbootii isaa wajjin ni boqote. Ilmi isaa Yehooyaakiin iddoo isaa buʼee mootii taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.6",
            "verseOrgIds": [
              "2KI.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii mootichi Baabilon biyya isaa hunda, Malkaa Gibxii jalqabee hamma Laga Efraaxiisitti qabateef mootiin Gibxi lammata duulaaf biyya isaatii hin baane.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.7",
            "verseOrgIds": [
              "2KI.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yehooyaakiin Mooticha Yihuudaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2KI.24.8-2KI.24.17"
          },
          "items": [
            {
              "text": "24:8‑17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwf –",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "xt"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "2CH.36.9-2CH.36.10"
              },
              "items": [
                {
                  "text": "2Sn 36:9‑10",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooyaakiin yeroo mootii taʼetti umuriin isaa waggaa kudha saddeet ture; innis Yerusaalem keessa taaʼee jiʼa sadii bulche. Maqaan haadha isaa Nehushtaa ture; isheenis intala Elnaataan namicha Yerusaalem sanaa ti.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.8",
            "verseOrgIds": [
              "2KI.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akkuma abbaan isaa hojjete sana fuula",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.9",
            "verseOrgIds": [
              "2KI.24.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.24.9",
                "verseOrgIds": [
                  "2KI.24.9"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti waan hamaa hojjete.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.9",
            "verseOrgIds": [
              "2KI.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeruma sanatti loltoonni Nebukadnezar mooticha Baabilon Yerusaalemitti duulanii ishee ni marsan;",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.10",
            "verseOrgIds": [
              "2KI.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "utuma ajajjoonni loltoota isaa ishee marsaa jiranuu Nebukadnezar mataan isaa gara magaalattii ni dhufe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.11",
            "verseOrgIds": [
              "2KI.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooyaakiin mootichi Yihuudaa, haati isaa, garboonni isaa, namoonni isaa bebeekamoonii fi qondaaltonni isaa hundinuu mootii Baabilonitti harka kennatan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.12",
            "verseOrgIds": [
              "2KI.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 24:12"
      },
      "items": [
        {
          "text": "Mootiin Baabilonis mooʼee waggaa saddeettaffaatti Yehooyaakiinin boojiʼee ni fudhate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.12",
            "verseOrgIds": [
              "2KI.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadnezaris akkuma",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.13",
            "verseOrgIds": [
              "2KI.24.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.24.13",
                "verseOrgIds": [
                  "2KI.24.13"
                ]
              }
            }
          ]
        },
        {
          "text": "dubbatee ture sanatti qabeenya mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.13",
            "verseOrgIds": [
              "2KI.24.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootii",
              "type": "text",
              "attrs": {
                "verseId": "2KI.24.13",
                "verseOrgIds": [
                  "2KI.24.13"
                ]
              }
            }
          ]
        },
        {
          "text": "fi kan masaraa mootummaa keessa ture hunda ni fudhate; miʼa warqee kan Solomoon mootichi Israaʼel mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.13",
            "verseOrgIds": [
              "2KI.24.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootiif",
              "type": "text",
              "attrs": {
                "verseId": "2KI.24.13",
                "verseOrgIds": [
                  "2KI.24.13"
                ]
              }
            }
          ]
        },
        {
          "text": "tolche hunda isaa immoo caccabse.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.13",
            "verseOrgIds": [
              "2KI.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni warra Yerusaalem keessa jiraatan hunda ajajjoota waraanaatii fi loltoota hunda, warra ogummaa hojii harkaa qabanii fi warra sibiila tuman hunda walumatti nama kuma kudhan boojiʼee ni fudhate. Namoota akka malee hiyyeeyyii qofatu biyya sanatti hafe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.14",
            "verseOrgIds": [
              "2KI.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadnezar Yehooyaakiinin boojiʼee Baabilonitti ni geesse. Akkasumas haadha mootichaa, niitota isaa, qondaaltota isaatii fi namoota biyya sanaa bebbeekamoo boojiʼee Yerusaalemii gara Baabilonitti ni geesse.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.15",
            "verseOrgIds": [
              "2KI.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana malees mootichi Baabilon humna waraanaa guutuu kan nama kuma torba of keessaa qabu, warra ogummaa hojii harkaa qabanii fi warra sibiila tuman kuma tokko boojiʼee Baabilonitti ni geesse; isaan kunneen hundi jajjaboo fi warra lola dandaʼan turan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.16",
            "verseOrgIds": [
              "2KI.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis Mataaniyaa eessuma Yehooyaakiin sana iddoo isaa mootii godhe; maqaa isaas Zedeqiyaatti ni geeddare.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.17",
            "verseOrgIds": [
              "2KI.24.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zedeqiyaa Mooticha Yihuudaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
