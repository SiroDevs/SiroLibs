    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Solomoon Xiyoon magaalaa Daawit irraa taabota kakuu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.2",
            "verseOrgIds": [
              "2CH.5.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.5.2",
                "verseOrgIds": [
                  "2CH.5.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ol fichisiisuudhaaf jedhee maanguddoota Israaʼel, abbootii gosootaa hundaa fi hangafoota maatiiwwan Israaʼel Yerusaalemitti walitti waame.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.2",
            "verseOrgIds": [
              "2CH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼeloonni hundinuus jiʼa torbaffaa keessa yeroo ayyaanaatti mooticha biratti walitti qabaman.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.3",
            "verseOrgIds": [
              "2CH.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu maanguddoonni Israaʼel hundi achi gaʼanitti Lewwonni taaboticha ol fuudhan;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.4",
            "verseOrgIds": [
              "2CH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "isaanis taabota sana, dunkaana wal gaʼiitii fi miʼoota qulqulleeffaman kanneen dunkaanicha keessa turan hunda ni fidan. Lewwonni luboota taʼanis baatanii ol isaan fidan;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.5",
            "verseOrgIds": [
              "2CH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoon Mootichii fi waldaan Israaʼel kan isa biratti walitti qabaman guutuun hoolotaa fi loon akka malee baayʼatanii galmeessuu fi lakkaaʼuun hin dandaʼamne aarsaa dhiʼeessaa isa wajjin fuula taabotaa dura turan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.6",
            "verseOrgIds": [
              "2CH.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luboonnis ergasii taabota kakuu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.7",
            "verseOrgIds": [
              "2CH.5.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.5.7",
                "verseOrgIds": [
                  "2CH.5.7"
                ]
              }
            }
          ]
        },
        {
          "text": "sana iddoo isaa gara kutaa qulqullicha mana qulqullummaa keessaa jechuunis Iddoo Iddoo Hunda Caalaa Qulqulluu taʼe sanatti ol galchanii qoochoo kiirubeelii jala kaaʼan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.7",
            "verseOrgIds": [
              "2CH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiirubeeliinis iddoo taabotichaa irratti qoochoowwan isaanii babalʼisanii taabotichaa fi danqaraawwan ittiin taabota baatan ni haguugan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.8",
            "verseOrgIds": [
              "2CH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Danqaraawwan kunneen waan akka malee dhedheerataniif fiixeen isaanii taaboticha biraa dhedheerattee fuula Iddoo Qulqulluu gara keessaa jiru sanaa duraa ni mulʼatu ture; garuu iddoo qulqulluu sanaa alatti hin mulʼatan ture; danqaraawwan kunneen hamma harʼaatti illee achuma jiru.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.9",
            "verseOrgIds": [
              "2CH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taabota sana keessa gabateewwan kanneen Museen Kooreebitti, iddoo",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.10",
            "verseOrgIds": [
              "2CH.5.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.5.10",
                "verseOrgIds": [
                  "2CH.5.10"
                ]
              }
            }
          ]
        },
        {
          "text": "erga Israaʼeloonni Gibxii baʼanii booddee itti isaan wajjin kakuu seene sanatti isa keessa kaaʼe lamaan malee wanni tokko iyyuu hin turre.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.10",
            "verseOrgIds": [
              "2CH.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luboonnis Iddoo Qulqulluu sanaa ni baʼan. Luboonni achi turan hundinuu yoo dabareen kan isaanii taʼuu baate iyyuu of qulqulleessanii turan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.11",
            "verseOrgIds": [
              "2CH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lewwonni faarfattoota turan jechuunis Asaaf, Heemaan, Yeduutuun, ilmaan isaaniitii fi firoonni isaanii wayyaa haphii quncee talbaa irraa hojjetame uffatanii iddoo aarsaa bira karaa baʼa biiftuutiin dhaabatanii kilillee kililchaa, baganaa fi kiraara taphachaa turan. Luboonni 120 kanneen malakata afuufan isaan wajjin turan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.12",
            "verseOrgIds": [
              "2CH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri malakata afuufanii fi faarfattoonni",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "2CH.5.13",
                "verseOrgIds": [
                  "2CH.5.13"
                ]
              }
            }
          ]
        },
        {
          "text": "leellisuu fi galateeffachuudhaaf jedhanii akkuma nama tokkootti walii galanii sagalee isaanii tokko godhatan. Isaanis malakatatti, kilillee fi miʼoota faarfannaa biraatti fayyadamanii sagalee isaanii ol fudhatanii",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "2CH.5.13",
                "verseOrgIds": [
                  "2CH.5.13"
                ]
              }
            }
          ]
        },
        {
          "text": "galateeffachuudhaan:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2CH 5:13"
      },
      "items": [
        {
          "text": "\"Inni gaarii dha;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2CH 5:13"
      },
      "items": [
        {
          "text": "jaalalli isaas bara baraan ni jiraata\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "2CH 5:13"
      },
      "items": [
        {
          "text": "jedhanii faarfatan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 5:13"
      },
      "items": [
        {
          "text": "Ergasiis manni qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.5.13",
                "verseOrgIds": [
                  "2CH.5.13"
                ]
              }
            }
          ]
        },
        {
          "text": "duumessaan ni guutame;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "luboonnis sababii duumessa sanaatiif hojii isaanii hojjechuu hin dandeenye; ulfinni",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.14",
            "verseOrgIds": [
              "2CH.5.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.5.14",
                "verseOrgIds": [
                  "2CH.5.14"
                ]
              }
            }
          ]
        },
        {
          "text": "mana qulqullummaa Waaqaa guutee tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.14",
            "verseOrgIds": [
              "2CH.5.14"
            ]
          }
        }
      ]
    }
  ],
