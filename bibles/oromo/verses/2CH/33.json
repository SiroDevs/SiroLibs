    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aamoon yeroo mootii taʼetti umuriin isaa waggaa digdamii lama ture. Innis Yerusaalem keessa taaʼee waggaa lama bulche.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.21",
            "verseOrgIds": [
              "2CH.33.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akkuma abbaan isaa Minaaseen hojjetee ture sana fuula",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.22",
            "verseOrgIds": [
              "2CH.33.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.33.22",
                "verseOrgIds": [
                  "2CH.33.22"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti waan hamaa hojjete. Aamoon waaqota Minaaseen tolche waaqeffate; hunda isaaniitifis aarsaa dhiʼeesse.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.22",
            "verseOrgIds": [
              "2CH.33.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 33:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni garuu akka abbaa isaa Minaasee fuula",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.23",
            "verseOrgIds": [
              "2CH.33.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.33.23",
                "verseOrgIds": [
                  "2CH.33.23"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti gad of hin qabne; Aamoon ittuma caalchisee yakka hojjete.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.23",
            "verseOrgIds": [
              "2CH.33.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 33:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qondaaltonni Amoon isatti mariʼatanii masaruma mootummaa isaa keessatti isa ajjeesan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.24",
            "verseOrgIds": [
              "2CH.33.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 33:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti namoonni biyya sanaa warra Aamoon Mootichatti malatan hunda fixanii ilma isaa Yosiyaasin immoo iddoo isaa mootii godhatan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.25",
            "verseOrgIds": [
              "2CH.33.25"
            ]
          }
        }
      ]
    }
