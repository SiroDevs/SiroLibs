    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aasaan waan fuula",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.2",
            "verseOrgIds": [
              "2CH.14.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.14.2",
                "verseOrgIds": [
                  "2CH.14.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa isaa duratti gaarii fi qajeelaa taʼe hojjete.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.2",
            "verseOrgIds": [
              "2CH.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis iddoowwan aarsaa waaqota ormaa fi iddoowwan sagadaa kanneen gaarran irraa ni diige; soodduuwwan dhagaa fi siidaawwan Aasheeraa ni caccabse.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.3",
            "verseOrgIds": [
              "2CH.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka sabni Yihuudaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.4",
            "verseOrgIds": [
              "2CH.14.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.14.4",
                "verseOrgIds": [
                  "2CH.14.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa abbootii isaa barbaadu, akka seera isaa fi ajaja isaaf bulu ni ajaje.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.4",
            "verseOrgIds": [
              "2CH.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magaalaawwan Yihuudaa hunda keessaas iddoowwan sagadaa kanneen gaarran irraa fi iddoowwan aarsaa ixaanaa balleesse; mootummaanis isa jalatti nagaadhaan ni jiraate.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.5",
            "verseOrgIds": [
              "2CH.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis waan biyyattiin nagaa argatteef Yihuudaa keessatti magaalaawwan dallaa jabaa qaban ni ijaare. Sababii",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.6",
            "verseOrgIds": [
              "2CH.14.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.14.6",
                "verseOrgIds": [
                  "2CH.14.5"
                ]
              }
            }
          ]
        },
        {
          "text": "boqonnaa isaaf kenneef waggoota sana keessa namni tokko iyyuu lola isatti hin kaafne.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.6",
            "verseOrgIds": [
              "2CH.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis namoota Yihuudaan akkana jedhe; \"Kottaa nu magaalaawwan kanneen haa ijaarru; dallaa gamoo, cufaa fi danqaraawwan qabu itti naannessinee haa ijaarru; sababii nu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.7",
            "verseOrgIds": [
              "2CH.14.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.14.7",
                "verseOrgIds": [
                  "2CH.14.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keenya barbaanneef lafti kun ammas keenyuma; nu isa barbaanne; innis karaa hundaan boqonnaa nuuf kenne.\" Isaan ni ijaaran; hojiin isaaniis ni milkaaʼeef.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.7",
            "verseOrgIds": [
              "2CH.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aasaan namoota Yihuudaa kanneen gaachana gurguddaa fi eeboo qabatan kuma dhibba sadii, namoota Beniyaam kanneen gaachana xixinnaa fi xiyyawwan qabatan kuma dhibba lamaa fi saddeettama qaba ture. Isaan kunneen hundi loltoota ciccimoo turan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.8",
            "verseOrgIds": [
              "2CH.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zeraan namichi Itoophiyaa tokko immoo loltoota miliyoona tokkoo fi gaariiwwan dhibba sadii fudhatee hamma Maareeshaatti isaanitti ni duule.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.9",
            "verseOrgIds": [
              "2CH.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aasaanis isatti baʼe; isaanis Sulula Zefaataa keessatti Maareeshaa iddoo lolaa qabatan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.10",
            "verseOrgIds": [
              "2CH.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti Aasaan",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.11",
            "verseOrgIds": [
              "2CH.14.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.14.11",
                "verseOrgIds": [
                  "2CH.14.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa isaa waammatee akkana jedhe; \"Yaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.11",
            "verseOrgIds": [
              "2CH.14.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.14.11",
                "verseOrgIds": [
                  "2CH.14.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", kan akka kee namoota humna hin qabne gargaaree namoota jajjaboo jalaa baasu tokko iyyuu hin jiru. Yaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.11",
            "verseOrgIds": [
              "2CH.14.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.14.11",
                "verseOrgIds": [
                  "2CH.14.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keenya, nu sitti of kennineerraatii nu gargaari; maqaa keetiinis waraana akka malee guddaa kanatti duulleerra. Yaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.11",
            "verseOrgIds": [
              "2CH.14.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.14.11",
                "verseOrgIds": [
                  "2CH.14.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ati Waaqa keenya; akka namni sitti cimuuf ofitti hin dhiisin.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.11",
            "verseOrgIds": [
              "2CH.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "2CH.14.12",
                "verseOrgIds": [
                  "2CH.14.11"
                ]
              }
            }
          ]
        },
        {
          "text": "fuula Aasaatii fi Yihuudaa duraa namoota Itoophiyoota ni dhaʼe; namoonni Itoophiyaas ni baqatan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.12",
            "verseOrgIds": [
              "2CH.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aasaa fi loltoonni isaas hamma Geraaraatti isaan ariʼan. Waan Baayʼeen isaanii dhumaniif namoonni Itoophiyaa deebiʼanii bayyanachuu hin dandeenye; isaan fuula",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.13",
            "verseOrgIds": [
              "2CH.14.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.14.13",
                "verseOrgIds": [
                  "2CH.14.12"
                ]
              }
            }
          ]
        },
        {
          "text": "fi fuula loltoota isaa duratti barbadeeffamaniiruutii. Namoonni Yihuudaas boojuu baayʼee fudhatanii deebiʼan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.13",
            "verseOrgIds": [
              "2CH.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan sababii sodaachisni guddaan",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.14",
            "verseOrgIds": [
              "2CH.14.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.14.14",
                "verseOrgIds": [
                  "2CH.14.13"
                ]
              }
            }
          ]
        },
        {
          "text": "biraa jaratti dhufeef gandoota naannoo Geraaraa jiran hunda barbadeessan. Isaanis sababii wantoonni boojiʼaman hedduun achi turaniif gandoota kanneen ni saaman.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.14",
            "verseOrgIds": [
              "2CH.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasumas qubatawwan tiksootaa dhaʼanii karra hoolotaa fi reʼoota akka malee hedduu fi gaalawwan illee boojiʼanii fudhatan. Ergasiis Yerusaalemitti dachaʼan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.15",
            "verseOrgIds": [
              "2CH.14.14"
            ]
          }
        }
      ]
    }
  ],
