    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiyaanis abbootii ofii isaa wajjin boqotee Magaalaa Daawit keessatti awwaalame. Ilmi isaa Aasaan iddoo isaa buʼee mootii taʼe; bara isaa keessas biyyattiin waggaa kudhan nagaadhaan jiraatte.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.1",
            "verseOrgIds": [
              "2CH.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aasaa Mooticha Yihuudaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
