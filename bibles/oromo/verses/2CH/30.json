              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hisqiyaasis Lewwota waaʼee tajaajila",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.22",
            "verseOrgIds": [
              "2CH.30.22"
            ]
