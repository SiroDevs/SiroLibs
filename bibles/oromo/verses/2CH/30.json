        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hisqiyaas Faasiikaa Ayyaaneffate",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hisqiyaas akka isaan",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.1",
            "verseOrgIds": [
              "2CH.30.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.30.1",
                "verseOrgIds": [
                  "2CH.30.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa Israaʼeliif Faasiikaa ayyaaneffachuuf jedhanii gara Yerusaalem, gara mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.1",
            "verseOrgIds": [
              "2CH.30.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.30.1",
                "verseOrgIds": [
                  "2CH.30.1"
                ]
              }
            }
          ]
        },
        {
          "text": "dhufaniif Israaʼelii fi Yihuudaa hundatti ergaa erge; Efreemii fi Minaaseetti immoo xalayaa barreesse.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.1",
            "verseOrgIds": [
              "2CH.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichii fi qondaaltonni isaa akkasumas waldaan Yerusaalem keessa jiru hundi jiʼa lammaffaatti Faasiikaa ayyaaneffachuuf murteessan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.2",
            "verseOrgIds": [
              "2CH.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan sababii luboonni of qulqulleessan lakkoobsaan gaʼoo hin taʼinii fi sababii namoonni Yerusaalemitti walitti hin qabaminiif yeroo barbaachisaa taʼetti Faasiikaa ayyaaneffachuu hin dandeenye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.3",
            "verseOrgIds": [
              "2CH.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karoorri sunis mootichaa fi waldaa sana guutuu ni gammachiise.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.4",
            "verseOrgIds": [
              "2CH.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis akka namoonni",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.5",
            "verseOrgIds": [
              "2CH.30.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.30.5",
                "verseOrgIds": [
                  "2CH.30.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa Israaʼeliif Faasiikaa ayyaaneffachuuf jedhanii gara Yerusaalem dhufaniif Bersheebaa hamma Daanitti Israaʼel hunda keessa labsii labsuuf murteessan. Ayyaanni Faasiikaa akka barreeffametti iddoo namoonni hedduun jiranitti ayyaaneffamee hin beekuutii.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.5",
            "verseOrgIds": [
              "2CH.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergamoonnis ajaja mootichaatiin xalayaa mootichaa fi qondaaltota isaa biraa ergame fuudhanii guutummaa Israaʼelii fi Yihuudaa keessa qajeelan; xalayaan sunis akkana jedha:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.6",
            "verseOrgIds": [
              "2CH.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2CH 30:6"
      },
      "items": [
        {
          "text": "\"Yaa saba Israaʼel, akka inni gara keessan gara warra haftanii harka mootota Asoor jalaa baatan sanaatti deebiʼuuf gara",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.6",
            "verseOrgIds": [
              "2CH.30.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.30.6",
                "verseOrgIds": [
                  "2CH.30.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa Abrahaam, Waaqa Yisihaaqii fi Waaqa Israaʼelitti deebiʼaa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.6",
            "verseOrgIds": [
              "2CH.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka abbootii keessanii fi akka obboloota keessan kanneen inni sababii isaan",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.7",
            "verseOrgIds": [
              "2CH.30.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.30.7",
                "verseOrgIds": [
                  "2CH.30.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa abbootii isaaniif amanamuu didaniif akkuma isin argitan kana waan fafaa isaan godhe sanaa hin taʼinaa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.7",
            "verseOrgIds": [
              "2CH.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin akka abbootii keessanii mata jabeeyyii hin taʼinaa;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.8",
            "verseOrgIds": [
              "2CH.30.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootti",
              "type": "text",
              "attrs": {
                "verseId": "2CH.30.8",
                "verseOrgIds": [
                  "2CH.30.8"
                ]
              }
            }
          ]
        },
        {
          "text": "harka kennadhaa. Gara iddoo qulqullummaa isaa kan inni bara baraan qulqulleesse sanaa kottaa. Akka dheekkamsi isaa sodaachisaan sun isin irraa deebiʼuuf",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.8",
            "verseOrgIds": [
              "2CH.30.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.30.8",
                "verseOrgIds": [
                  "2CH.30.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keessan tajaajilaa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.8",
            "verseOrgIds": [
              "2CH.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.9",
            "verseOrgIds": [
              "2CH.30.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.30.9",
                "verseOrgIds": [
                  "2CH.30.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni keessan arjaa fi gara laafessa taʼeef isin yoo gara",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.9",
            "verseOrgIds": [
              "2CH.30.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootti",
              "type": "text",
              "attrs": {
                "verseId": "2CH.30.9",
                "verseOrgIds": [
                  "2CH.30.9"
                ]
              }
            }
          ]
        },
        {
          "text": "deebitan obboloonni keessanii fi ijoolleen keessan warra isaan boojiʼan biratti gara laafina ni argatu; biyya kanattis ni deebiʼu. Isin yoo gara isaatti deebitan inni fuula isaa isin irraa hin garagalfatu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.9",
            "verseOrgIds": [
              "2CH.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergamoonnis Efreemii fi Minaasee keessa magaalaa tokkoo gara magaalaa kaaniitti naannaʼaa hamma Zebuuloonitti deeman; namoonni garuu isaan tuffatan; itti qoosanis.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.10",
            "verseOrgIds": [
              "2CH.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni Aasheer, kan Minaasee fi kan Zebuuloon tokko tokko garuu gad of qabanii Yerusaalem dhaqan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.11",
            "verseOrgIds": [
              "2CH.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka isaan waan mootichii fi qondaaltonni isaa akkuma dubbii",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.12",
            "verseOrgIds": [
              "2CH.30.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootti",
              "type": "text",
              "attrs": {
                "verseId": "2CH.30.12",
                "verseOrgIds": [
                  "2CH.30.12"
                ]
              }
            }
          ]
        },
        {
          "text": "ajajanii turan sana hojjetaniif harki Waaqaa yaada tokko isaanii kennuuf akkasuma Yihuudaa irra ture.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.12",
            "verseOrgIds": [
              "2CH.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuunni akka malee guddaan tokko jiʼa lammaffaatti Ayyaana Maxinoo ayyaanessuuf Yerusaalem keessatti walitti qabame.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.13",
            "verseOrgIds": [
              "2CH.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis iddoowwan aarsaa kanneen Yerusaalem keessa turan bubuqqisanii, iddoowwan aarsaa ixaanaas diiganii geessanii Sulula Qeedroonitti ni gatan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.14",
            "verseOrgIds": [
              "2CH.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa kudha afuraffaa jiʼa lammaffaattis hoolaa Faasiikaa qalan. Luboonnii fi Lewwonnis qaanaʼanii of qulqulleessuudhaan aarsaa gubamu gara mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.15",
            "verseOrgIds": [
              "2CH.30.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.30.15",
                "verseOrgIds": [
                  "2CH.30.15"
                ]
              }
            }
          ]
        },
        {
          "text": "fidan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.15",
            "verseOrgIds": [
              "2CH.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis akkuma Seera Musee nama Waaqaa sanaa keessatti ajajametti iddoo isaaniif ramadame ni qabatan. Luboonnis dhiiga Lewwonni isaanitti kennan sana ni faffacaasan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.16",
            "verseOrgIds": [
              "2CH.30.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii waldaa sana keessaa namoonni hedduun of hin qulqulleessiniif Lewwonni namoota akka seeraatti hin qulqullaaʼinii fi namoota hoolota isaanii",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.17",
            "verseOrgIds": [
              "2CH.30.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "2CH.30.17",
                "verseOrgIds": [
                  "2CH.30.17"
                ]
              }
            }
          ]
        },
        {
          "text": "qulqulleessuu hin dandaʼin hundaaf jedhanii hoolota Faasiikaa ni qalu turan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.17",
            "verseOrgIds": [
              "2CH.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoota biyya Efreem, Minaasee, Yisaakorii fi Zebuuloonii dhufan hedduu keessaa garri caalu of qulqulleessuu baatan iyyuu isaan waan barreeffameen alatti Faasiikaa nyaatan; Hisqiyaas garuu akkana jedhee Waaqa kadhateef; \"Yaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.18",
            "verseOrgIds": [
              "2CH.30.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.30.18",
                "verseOrgIds": [
