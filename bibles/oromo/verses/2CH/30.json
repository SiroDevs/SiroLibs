          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.30.22",
                "verseOrgIds": [
                  "2CH.30.22"
                ]
              }
            }
          ]
        },
        {
          "text": "irratti hubannaa gaarii qaban jajjabeessuudhaan itti dubbate. Isaanis bultii torbanuu waan isaaniif qoodame nyaachaa, aarsaa nagaas dhiʼeessaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.22",
            "verseOrgIds": [
