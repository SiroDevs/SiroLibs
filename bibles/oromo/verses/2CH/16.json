    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara mootummaa Aasaa keessa waggaa soddomii jaʼaffaatti Baʼishaan mootichi Israaʼel biyya Yihuudaatti duulee akka namni tokko iyyuu daangaa biyya Aasaa mooticha Yihuudaa keessaa hin baane yookaan akka achi hin seenne gochuudhaaf jedhee Raamaa jabeessee ijaare.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.1",
            "verseOrgIds": [
              "2CH.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aasaanis meetii fi warqee mankuusa mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.2",
            "verseOrgIds": [
              "2CH.16.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootii",
              "type": "text",
              "attrs": {
                "verseId": "2CH.16.2",
                "verseOrgIds": [
                  "2CH.16.2"
                ]
              }
            }
          ]
        },
        {
          "text": "fi masaraa mootummaa isaa keessaa baasee Ben-Hadaad mooticha Sooriyaa kan Damaasqoo taaʼee bulchaa ture sanaaf ni erge.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.2",
            "verseOrgIds": [
              "2CH.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis, \"Akkuma walii galtee kanaan dura abbaa koo fi abbaa kee gidduu ture sanaatti ammas anaa fi si gidduu walii galteen haa jiraatu. Kunoo ani meetii fi warqee siif ergeera. Akka inni narraa deebiʼuuf dhaqiitii walii galtee Baʼishaan mooticha Israaʼel wajjin qabdu sana diigi\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.3",
            "verseOrgIds": [
              "2CH.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ben-Hadaadis yaada Aasaa mootichaa fudhatee ajajjuuwwan loltoota isaa magaalaawwan Israaʼelitti duulchise. Isaanis magaalaawwan Iiyoon, Daan, Abeel Maayimii fi magaalaawwan mankuusa Niftaalem hunda rukutan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.4",
            "verseOrgIds": [
              "2CH.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baʼishaanis yommuu waan kana dhagaʼetti Raamaa ijaaruu dhiisee hojii ofii isaa dhaabe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.5",
            "verseOrgIds": [
              "2CH.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aasaan Mootichis namoota Yihuudaa hunda ni fide; isaanis dhagaawwanii fi muka Baʼishaan ittiin hojjechaa ture Raamaadhaa fudhatanii deeman. Aasaanis Gebaa fi Miisphaa ittiin ijaarrate.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.6",
            "verseOrgIds": [
              "2CH.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo sanattis Hanaaniin ilaalaan sun Aasaa mooticha Yihuudaa bira dhufee akkana jedheen; \"Waan ati",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.7",
            "verseOrgIds": [
              "2CH.16.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.16.7",
                "verseOrgIds": [
                  "2CH.16.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa kee dhiiftee mootii Sooriyaa amanatteef loltoonni Sooriyaa si harkaa baʼaniiru.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.7",
            "verseOrgIds": [
              "2CH.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni Itoophiyaa fi Liibiyaa gaariiwwanii fi abbootii fardaa kanneen akka malee baayʼee qaban sun loltoota jajjaboo hin turree? Taʼus waan ati",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.8",
            "verseOrgIds": [
              "2CH.16.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "2CH.16.8",
                "verseOrgIds": [
                  "2CH.16.8"
                ]
              }
            }
          ]
        },
        {
          "text": "abdatteef inni dabarsee harka keetti isaan siif kenne.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.8",
            "verseOrgIds": [
              "2CH.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iji",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.9",
            "verseOrgIds": [
              "2CH.16.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.16.9",
                "verseOrgIds": [
                  "2CH.16.9"
                ]
              }
            }
          ]
        },
        {
          "text": "warra garaa guutuun isa amanatan jajjabeessuuf guutummaa addunyaa ni ilaalaatii. Sababii ati hojii gowwummaa hojjetteef kana booddee waraanni sirraa hin caamu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.9",
            "verseOrgIds": [
              "2CH.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aasaan sababii kanaaf ilaaltuu sanatti ni aare; akka malee dheekkamees mana hidhaa keessa isa buuse. Yeruma sanatti Aasaan namoota tokko tokko gara jabinaan ni cunqurse.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.10",
            "verseOrgIds": [
              "2CH.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni bara mootummaa Aasaa keessa jalqabaa hamma dhumaatti hojjetame kitaaba mootota Yihuudaa fi Israaʼel keessatti barreeffameera.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.11",
            "verseOrgIds": [
              "2CH.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aasaanis bara mootummaa isaa keessa waggaa soddomii saglaffaatti dhukkuba miillaatiin akka malee ni dhiphate. Taʼus inni dhukkuba akka malee hamaa kana keessatti illee ogeeyyii fayyaa malee gargaarsa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.12",
            "verseOrgIds": [
              "2CH.16.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.16.12",
                "verseOrgIds": [
                  "2CH.16.12"
                ]
              }
            }
          ]
        },
        {
          "text": "hin barbaanne.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.12",
            "verseOrgIds": [
              "2CH.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Aasaan bara mootummaa isaa keessa waggaa afurtamii tokkoffaatti duʼee abbootii ofii isaa wajjin boqote.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.13",
            "verseOrgIds": [
              "2CH.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis awwaala inni Magaalaa Daawit keessatti dhagaa cabsee ofii isaatii qopheeffatetti isa ni awwaalan. Wasaasaa urgooftuuwwanii fi shittoodhaan guutame irra isa ni ciibsan; ulfina isaatiifis ibidda guddaa bobeessan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.14",
            "verseOrgIds": [
              "2CH.16.14"
            ]
          }
        }
      ]
    }
  ],
