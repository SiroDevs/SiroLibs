        "style": "s1"
      },
      "items": [
        {
          "text": "Aahaaz Mooticha Yihuudaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
