    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasiin Yehooshaafaax mootii taʼee Yihuudaa ni bulche. Inni yeroo mootii Yihuudaa taʼetti nama umuriin isaa waggaa soddomii shan ture; innis Yerusaalem keessa taaʼee waggaa digdamii shan ni bulche. Maqaan haadha isaa Azuubaa ture; isheenis intala Shilhii turte.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.31",
            "verseOrgIds": [
              "2CH.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis karuma abbaa isaa Aasaa irra deeme malee isa irraa hin jalʼanne; fuula",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.32",
            "verseOrgIds": [
              "2CH.20.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.32",
                "verseOrgIds": [
                  "2CH.20.32"
                ]
              }
            }
          ]
        },
        {
          "text": "durattis waan qajeelaa hojjete.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.32",
            "verseOrgIds": [
              "2CH.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus iddoowwan sagadaa kanneen gaarran irraa hin diigamne ture; namoonnis qalbii isaanii gara Waaqa abbootii isaaniitti hin deebine ture.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.33",
            "verseOrgIds": [
              "2CH.20.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wantoonni bara mootummaa Yehooshaafaax keessa jalqabaa hamma dhumaatti hojjetaman kanneen biraa seenaa Yehuu ilma Hanaanii kan kitaaba mootota Israaʼel keessatti galmeeffame sana keessatti barreeffamaniiru.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.34",
            "verseOrgIds": [
              "2CH.20.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2CH 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Yehooshaafaax mootichi Yihuudaa, Ahaaziyaa mootii Israaʼel kan hojiin isaa jibbisiisaa taʼe sana wajjin walii galtee godhate.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.35",
            "verseOrgIds": [
              "2CH.20.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2CH 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis dooniiwwan daldalaa hojjechuuf isaan walii gale; isaanis Eziyoon Geberitti dooniiwwan ni hojjechiisan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.36",
            "verseOrgIds": [
              "2CH.20.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2CH 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliiʼezer raajichi ilmi Doodaawaahuu namichi Maareeshaa sun, \"Sababii ati Ahaaziyaa wajjin walii galtee godhatteef",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.37",
            "verseOrgIds": [
              "2CH.20.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.37",
                "verseOrgIds": [
                  "2CH.20.37"
                ]
              }
            }
          ]
        },
        {
          "text": "hojii kee ni diiga\" jedhee Yehooshaafaaxiin mormee raajii ni dubbate. Dooniiwwanis ni caccaban; gara Tarshiishis dhaquu hin dandeenye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.37",
            "verseOrgIds": [
              "2CH.20.37"
            ]
          }
        }
      ]
    }
