                "verseOrgIds": [
                  "2CH.20.21"
                ]
              }
            }
          ]
        },
        {
          "text": "faarfatanii sababii ulfina qulqullummaa isaatiif isa leellisaniif faarfattoota muude.",
          "type": "text",
