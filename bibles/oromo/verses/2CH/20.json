    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma isaan faarfachuu fi galateeffachuu jalqabaniinis",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.22",
            "verseOrgIds": [
              "2CH.20.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.22",
                "verseOrgIds": [
                  "2CH.20.22"
                ]
              }
            }
          ]
        },
        {
          "text": "namoota Amoon kan Moʼaabii fi kan Gaara Seeʼiir kanneen Yihuudaatti duulan sana dura waraana riphee eeggatu tokko ni kaaʼe; isaanis ni moʼataman.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.22",
            "verseOrgIds": [
              "2CH.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni Amoonii fi Moʼaab namoota Tulluu Seeʼiir irraa dhufan guutumaan guutuutti barbadeessuudhaaf itti kaʼan. Isaanis erga namoota Seeʼiir dhufan sana fixanii booddee deebiʼanii wal fixan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.23",
            "verseOrgIds": [
              "2CH.20.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni Yihuudaas yommuu iddoo gara gammoojjiitti garagalee jiru gaʼanii waraana guddaa sana ilaalanitti reeffa lafatti kufe qofa argan; namni tokko iyyuu hin miliqne.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.24",
            "verseOrgIds": [
              "2CH.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Yehooshaafaaxii fi namoonni isaa boojuu isaanii guurrachuu dhaqan; isaanis miʼa lolaa hedduu fi uffata akkasumas miʼoota gatii guddaa baasan kan guurratanii fixuu hin dandeenye achitti ni argatan. Boojuun argames waan akka malee baayʼee tureef walitti qabuuf bultii sadii fudhate.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.25",
            "verseOrgIds": [
              "2CH.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bultii afuraffaatti lafa itti",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.26",
            "verseOrgIds": [
              "2CH.20.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.26",
                "verseOrgIds": [
                  "2CH.20.26"
                ]
              }
            }
          ]
        },
        {
          "text": "galata dhiʼeessan sana Sulula Beraakaa keessatti walitti qabaman. Kanaafuu iddoon suni hamma harʼaatti Sulula Beraakaa jedhamee waamama.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.26",
            "verseOrgIds": [
              "2CH.20.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni Yihuudaa fi Yerusaalem sababii",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.27",
            "verseOrgIds": [
              "2CH.20.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.27",
                "verseOrgIds": [
                  "2CH.20.27"
                ]
              }
            }
          ]
        },
        {
          "text": "waan isaan ittiin diinota isaanii irratti gammadan isaaniif kenneef Yehooshaafaaxiin hoogganamanii gammachuudhaan Yerusaalemitti deebiʼan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.27",
            "verseOrgIds": [
              "2CH.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis Yerusaalem seenanii baganaa, kiraaraa fi malakata qabatanii gara mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.28",
            "verseOrgIds": [
              "2CH.20.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.28",
                "verseOrgIds": [
                  "2CH.20.28"
                ]
              }
            }
          ]
        },
        {
          "text": "ni dhaqan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.28",
            "verseOrgIds": [
              "2CH.20.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootummoonni biyyoota hundaas yommuu akka itti",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.29",
            "verseOrgIds": [
              "2CH.20.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.29",
                "verseOrgIds": [
                  "2CH.20.29"
                ]
              }
            }
          ]
        },
        {
          "text": "diinota Israaʼel lole dhagaʼanitti Waaqa sodaachuun isaan qabate.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.29",
            "verseOrgIds": [
              "2CH.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootummaan Yehooshaafaaxis waan Waaqni isaa karaa hundaan boqonnaa isaaf kenneef nagaadhaan ni jiraate.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.30",
            "verseOrgIds": [
              "2CH.20.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhuma Bara Mootummaa Yehooshaafaax",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
