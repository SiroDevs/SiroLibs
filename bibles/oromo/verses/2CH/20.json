  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "2CH 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yehooshaafaax Moʼaabii fi Amoon Moʼate",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana booddee Moʼaabonnii fi Amoononni Miʼuunota tokko tokko wajjin Yehooshaafaaxin loluuf dhufan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.1",
            "verseOrgIds": [
              "2CH.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni tokko tokkos dhufanii, \"Waraanni akka malee guddaan isaa Edoom gama Galaanaatii sitti dhufaa jira. Duulli kunis kunoo Een Gaadii lafa Hazezoon Taamaar jedhamu gaʼee jira\" jedhanii Yehooshaafaaxitti himan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.2",
            "verseOrgIds": [
              "2CH.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooshaafaaxis waan akka malee sodaateef",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.3",
            "verseOrgIds": [
              "2CH.20.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.3",
                "verseOrgIds": [
                  "2CH.20.3"
                ]
              }
            }
          ]
        },
        {
          "text": "waammachuuf murteeffate; guutummaa Yihuudaa keessattis sooma labse.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.3",
            "verseOrgIds": [
              "2CH.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni Yihuudaas gargaarsa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.4",
            "verseOrgIds": [
              "2CH.20.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.4",
                "verseOrgIds": [
                  "2CH.20.4"
                ]
              }
            }
          ]
        },
        {
          "text": "barbaacha walitti ni qabaman; isaan dhugumaan isa barbaacha magaalaawwan Yihuudaa hunda keessaa ni dhufan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.4",
            "verseOrgIds": [
              "2CH.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooshaafaaxis mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.5",
            "verseOrgIds": [
              "2CH.20.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.5",
                "verseOrgIds": [
                  "2CH.20.5"
                ]
              }
            }
          ]
        },
        {
          "text": "keessa oobdii haaraa dura waldaa Yihuudaa fi Yerusaalem gidduu dhaabatee",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.5",
            "verseOrgIds": [
              "2CH.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkana jedhe:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.6",
            "verseOrgIds": [
              "2CH.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2CH 20:6"
      },
      "items": [
        {
          "text": "\"Yaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.6",
            "verseOrgIds": [
              "2CH.20.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.6",
                "verseOrgIds": [
                  "2CH.20.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", Waaqa abbootii keenyaa, ati Waaqa samii keessa jiraattu mitii? Ati mootummoota sabootaa hunda bulchita; humnii fi jabinni si harka jiru; namni siin mormuu dandaʼu tokko iyyuu hin jiru.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.6",
            "verseOrgIds": [
              "2CH.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Waaqa keenya, ati jiraattota biyya kanaa fuula saba kee Israaʼel duraa baaftee biyyattii bara baraan sanyiiwwan Abrahaam michuu kee sanaaf hin kenninee?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.7",
            "verseOrgIds": [
              "2CH.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis biyya sana keessa jiraatanii Maqaa keetiif mana qulqullummaa ni ijaaran; akkanas jedhan:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.8",
            "verseOrgIds": [
              "2CH.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Yoo wanni hamaan nutti dhufe, yoo goraadeen, murtiin yookaan dhaʼichi yookaan beelli nutti dhufe, nu fuula kee dura mana qulqullummaa kan Maqaa keetiin waamamu kana dura dhaabannee dhiphina keenya keessatti sitti iyyanna; atis nu dhageessee nu oolchitta.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.9",
            "verseOrgIds": [
              "2CH.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Amma garuu namoonni Amoon, kan Moʼaabii fi kan Gaara Seeʼiir kanneen ati akka Israaʼeloonni yeroo Gibxii dhufanitti isaan hin tuqne gootee akkasiin badiisa oolan sun as jiru.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.10",
            "verseOrgIds": [
              "2CH.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunoo akka isaan biyya ati dhaala gootee nuu kennite keessaa nu baasuudhaan galata keenya nuu deebisuuf dhufan ilaali.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.11",
            "verseOrgIds": [
              "2CH.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Waaqa keenya ati isaanitti hin murtuu? Nu waraana guddaa nutti dhufe kana of irraa deebisuudhaaf humna hin qabnu. Nu waan goonu hin beeknu; iji keenya garuu sirra jira.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.12",
            "verseOrgIds": [
              "2CH.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni Yihuudaa hundinuu niitota isaanii, ijoollee fi daaʼimman isaanii wajjin fuula",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.13",
            "verseOrgIds": [
              "2CH.20.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.13",
                "verseOrgIds": [
                  "2CH.20.13"
                ]
              }
            }
          ]
        },
        {
          "text": "dura dhadhaabatanii turan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.13",
            "verseOrgIds": [
              "2CH.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahiziiʼeel ilma Zakkaariyaas ilma Benaayaa, ilma Yeʼiiʼeel ilma Mataan Lewwicha sanyii Asaaf sana utuma inni waldaa keessa dhabatuu Hafuurri",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.14",
            "verseOrgIds": [
              "2CH.20.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.14",
                "verseOrgIds": [
                  "2CH.20.14"
                ]
              }
            }
          ]
        },
        {
          "text": "isa irra buʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.14",
            "verseOrgIds": [
              "2CH.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akkana jedhe; \"Yehooshaafaax yaa mootii, warri Yihuudaa fi Yerusaalem keessa jiraattan hundinuu dhagaʼaa!",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.15",
            "verseOrgIds": [
              "2CH.20.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.15",
                "verseOrgIds": [
                  "2CH.20.15"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana isiniin jedha: 'Isin sababii waraana guddaa kanaatiif jettanii hin sodaatinaa yookaan abdii hin kutatinaa. Lolli kun kan Waaqaa ti malee kan keessan miti.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.15",
            "verseOrgIds": [
              "2CH.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bor isaanitti gad buʼaa. Isaan karaa malkaa Ziizi ol baʼu; isin immoo gammoojjii Yiruuʼeel keessatti qarqara sululichaa irratti isaan argattu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.16",
            "verseOrgIds": [
              "2CH.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lola kana loluu isin hin barbaachisu. Isin iddoo iddoo keessan qabadhaa; yaa Yihuudaa fi Yerusaalem jabaadhaa dhaabadhaatii moʼannoo",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.17",
            "verseOrgIds": [
              "2CH.20.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.17",
                "verseOrgIds": [
                  "2CH.20.17"
                ]
              }
            }
          ]
        },
        {
          "text": "isiniif kennu ilaalaa. Hin sodaatinaa; abdiis hin kutatinaa. Bor isaanitti baʼaa;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.17",
            "verseOrgIds": [
              "2CH.20.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.17",
                "verseOrgIds": [
                  "2CH.20.17"
                ]
              }
            }
          ]
        },
        {
          "text": "isin wajjin dhaabata.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.17",
            "verseOrgIds": [
              "2CH.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooshaafaax adda isaatiin lafatti gombifame; namoonni Yihuudaa fi Yerusaalem hundinuus fuula",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.18",
            "verseOrgIds": [
              "2CH.20.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.18",
                "verseOrgIds": [
                  "2CH.20.18"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti addaan lafatti gombifamanii ni sagadan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.18",
            "verseOrgIds": [
              "2CH.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii immoo garee Qohaatii fi Qooraahi keessaa Lewwonni tokko tokko dhaabatanii, sagalee guddaadhaan",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.19",
            "verseOrgIds": [
              "2CH.20.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.19",
                "verseOrgIds": [
                  "2CH.20.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa Israaʼel ni galateeffatan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.19",
            "verseOrgIds": [
              "2CH.20.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis guyyaa itti aanu ganamaan kaʼanii gammoojjii Teqooʼaatti ni qajeelan. Yehooshaafaaxis akkuma isaan baʼaniin dhaabatee, \"Namoonni Yihuudaa fi Yerusaalem na dhaggeeffadhaa! Isin ni jabaattuutii",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.20",
            "verseOrgIds": [
              "2CH.20.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.20.20",
                "verseOrgIds": [
                  "2CH.20.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keessan amanadhaa; raajota isaa illee amanaa isin ni milkooftuutii\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.20",
            "verseOrgIds": [
              "2CH.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooshaafaax erga namoota wajjin mariʼatee booddee akka isaan loltoota dura deemanii,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.21",
            "verseOrgIds": [
              "2CH.20.21"
            ]
          }
        }
      ]
    },
