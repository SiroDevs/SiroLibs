        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.32.22",
                "verseOrgIds": [
                  "2CH.32.22"
                ]
              }
            }
          ]
        },
        {
          "text": "akkasiin Hisqiyaasii fi namoota Yerusaalem harka Senaaheriib mooticha Asoorii fi harka diinota isaa hundaa jalaa ni baase. Inni karaa hundaan isaan eege.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.22",
            "verseOrgIds": [
              "2CH.32.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 32:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni baayʼeenis gara Yerusaalemitti",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.23",
            "verseOrgIds": [
              "2CH.32.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "2CH.32.23",
                "verseOrgIds": [
                  "2CH.32.23"
                ]
              }
            }
          ]
        },
        {
          "text": "aarsaa fidan; Hisqiyaas mooticha Yihuudaatiif immoo kennaa gatii guddaa fidan. Innis yeroo sanaa jalqabee fuula saboota hundaa duratti ulfina argate.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.23",
            "verseOrgIds": [
              "2CH.32.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Of tuulummaa, Milkaaʼinaa fi Duʼa Hisqiyaas",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
