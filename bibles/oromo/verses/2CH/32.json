    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 32:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara sana keessa Hisqiyaas dhukkubsatee duʼuu gaʼe. Innis",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.24",
            "verseOrgIds": [
              "2CH.32.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "2CH.32.24",
                "verseOrgIds": [
                  "2CH.32.24"
                ]
              }
            }
          ]
        },
        {
          "text": "ni kadhate; Waaqayyos deebii kennee fi mallattoo dinqisiisaa isa argisiise.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.24",
            "verseOrgIds": [
              "2CH.32.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hisqiyaas garuu garaa isaatti of tuule malee waan gaarii isaaf godhameef deebii malu hin kennine; kanaafuu dheekkamsi",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.25",
            "verseOrgIds": [
              "2CH.32.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.32.25",
                "verseOrgIds": [
                  "2CH.32.25"
                ]
              }
            }
          ]
        },
        {
          "text": "isatti, Yihuudaa fi Yerusaalemitti dhufe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.25",
            "verseOrgIds": [
              "2CH.32.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 32:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti Hisqiyaas akkuma namoota Yerusaalem sanaa of tuulummaa garaa isaa irraa ni deebiʼe; kanaafuu bara Hisqiyaas keessa dheekkamsi",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.26",
            "verseOrgIds": [
              "2CH.32.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.32.26",
                "verseOrgIds": [
                  "2CH.32.26"
                ]
              }
            }
          ]
        },
        {
          "text": "isaanitti hin dhufne.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.26",
            "verseOrgIds": [
              "2CH.32.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hisqiyaas qabeenya akka malee baayʼee fi ulfina guddaa qaba ture; innis meetii isaaf, warqee isaaf, dhagaawwan isaa gati jabeeyyiif, urgooftuuwwan isaaf, gaachanawwan isaa fi miʼoota garaa garaa kanneen gatii guddaa qaban hundaaf mankuusa ni ijaare.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.27",
            "verseOrgIds": [
              "2CH.32.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasumas midhaaniif gombisaa ijaare; daadhii wayinii haaraa fi zayitiidhaaf qodaa itti kuusan qopheesse; loon gosa hundaaf dallaa, bushaayeef immoo gola ni ijaare.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.28",
            "verseOrgIds": [
              "2CH.32.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis sababii Waaqni badhaadhummaa guddaa isaaf kenneef bushaayee baayʼee, karra loonii hedduus horatee magaalaawwanis ni ijaarrate.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.29",
            "verseOrgIds": [
              "2CH.32.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni afaan burqaa Giihoon kan olii cufee bishaan isaa gara lixa Magaalaa Daawititti jalʼise Hisqiyaasuma kana. Hojiin isaa hundis ni milkaaʼeef.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.30",
            "verseOrgIds": [
              "2CH.32.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu yeroo bulchitoonni Baabilon waaʼee hojii dinqii kan biyya sanatti hojjetamee isa gaafachuuf ergamoota erganitti Waaqni isa qoruu fi waan garaa isaa keessa jiru ilaaluudhaaf isa dhiise.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.31",
            "verseOrgIds": [
              "2CH.32.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wantoonni bara mootummaa Hisqiyaas keessa hojjetaman kanneen biraa fi gaarummaan isaa mulʼata Isaayyaas raajicha ilma Amoos, kitaaba mootota Yihuudaa fi Israaʼel keessatti barreeffamaniiru.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.32",
            "verseOrgIds": [
              "2CH.32.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 32:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hisqiyaasis abbootii isaa wajjin boqotee lafa awwaala sanyiiwwan Daawititti gaara irratti awwaalame. Yeroo inni duʼettis Yihuudaa fi sabni Yerusaalem hundinuu isa kabajan. Ilmi isaa Minaaseen iddoo isaa buʼee mootii taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.33",
            "verseOrgIds": [
              "2CH.32.33"
            ]
          }
        }
      ]
    }
  ],
