    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehooboʼaam erga mootii taʼee mootummaa isaa cimsatee booddee innii fi Israaʼeloonni isa wajjin jiraatan hundi seera",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.1",
            "verseOrgIds": [
              "2CH.12.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.12.1",
                "verseOrgIds": [
                  "2CH.12.1"
                ]
              }
            }
          ]
        },
        {
          "text": "eeguu didan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.1",
            "verseOrgIds": [
              "2CH.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii isaan",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.2",
            "verseOrgIds": [
              "2CH.12.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "2CH.12.2",
                "verseOrgIds": [
                  "2CH.12.2"
                ]
              }
            }
          ]
        },
        {
          "text": "amanamuu didaniif waggaa shanaffaa Rehooboʼaam mootii taʼetti Shiishaaq mootiin Gibxi Yerusaalemin waraane.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.2",
            "verseOrgIds": [
              "2CH.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis gaariiwwan kuma tokkoo fi dhibba lama, abbootii fardaa kuma jaatamaa fi loltoota Liibiyaa, kan Sukkiimiitii fi kan Itoophiyaa warra baayʼinni isaanii hin beekamne kanneen isa wajjin Gibxii dhufan fudhatee,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.3",
            "verseOrgIds": [
              "2CH.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "magaalaawwan Yihuudaa kanneen jajjabeeffamanii ijaaraman qabatee hamma Yerusaalemiitti ni dhufe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.4",
            "verseOrgIds": [
              "2CH.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Shemaaʼiyaan raajichi gara Rehooboʼaamii fi bulchitoota Yihuudaa kanneen Shiishaaq sodaatanii Yerusaalem keessatti walitti qabamanii dhufee, \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.5",
            "verseOrgIds": [
              "2CH.12.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.12.5",
                "verseOrgIds": [
                  "2CH.12.5"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedha; 'Isin na dhiiftan; anis harka Shiishaaqitti isin kenneera' \" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.5",
            "verseOrgIds": [
              "2CH.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bulchitoonni Israaʼelii fi Rehooboʼaam mootichi gad of deebisanii, \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.6",
            "verseOrgIds": [
              "2CH.12.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.12.6",
                "verseOrgIds": [
                  "2CH.12.6"
                ]
              }
            }
          ]
        },
        {
          "text": "qajeelaa dha\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.6",
            "verseOrgIds": [
              "2CH.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.7",
            "verseOrgIds": [
              "2CH.12.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.12.7",
                "verseOrgIds": [
                  "2CH.12.7"
                ]
              }
            }
          ]
        },
        {
          "text": "akka isaan gad of deebisan argetti, dubbiin",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.7",
            "verseOrgIds": [
              "2CH.12.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.12.7",
                "verseOrgIds": [
                  "2CH.12.7"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedhee gara Shemaaʼiyaa dhufe; \"Waan isaan gad of deebisaniif, ani dafeen isaan fura malee isaan hin balleessu. Dheekkamsi koos karaa Shiishaaqiin Yerusaalemitti hin dhangalaasu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.7",
            "verseOrgIds": [
              "2CH.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus isaan akka garaa garummaa ana tajaajiluu fi mootota biyya biraa tajaajiluu gidduu jiru beekaniif isaaf ni garboomu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.8",
            "verseOrgIds": [
              "2CH.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shiishaaq mootiin Gibxi yeroo Yerusaalem qabatetti qabeenya mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.9",
            "verseOrgIds": [
              "2CH.12.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootii",
              "type": "text",
              "attrs": {
                "verseId": "2CH.12.9",
                "verseOrgIds": [
                  "2CH.12.9"
                ]
              }
            }
          ]
        },
        {
          "text": "fi qabeenya masaraa mootummaa guurratee deeme. Gaachanawwan warqee kanneen Solomoon hojjete dabalatee waan guurratee gale.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.9",
            "verseOrgIds": [
              "2CH.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Rehooboʼaam mootichi iddoo isaanii buusuuf jedhee gaachana naasii hojjetee ajajjuuwwan eegdota dabaree eegumsa balbala masaraa mootummaatti kenne.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.10",
            "verseOrgIds": [
              "2CH.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo mootichi gara mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.11",
            "verseOrgIds": [
              "2CH.12.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.12.11",
                "verseOrgIds": [
                  "2CH.12.11"
                ]
              }
            }
          ]
        },
        {
          "text": "dhaqu hunda eegdonni sun gaachana sana baachaa isa wajjin deemanii ergasii immoo kutaa eegdotaatti deebisu ture.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.11",
            "verseOrgIds": [
              "2CH.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii Rehooboʼaam gad of deebiseef dheekkamsi",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.12",
            "verseOrgIds": [
              "2CH.12.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.12.12",
                "verseOrgIds": [
                  "2CH.12.12"
                ]
              }
            }
          ]
        },
        {
          "text": "isa irraa ni deebiʼe; kanaafuu inni guutummaatti hin balleeffamne; dhugumaan Yihuudaa keessa haala gaariitu ture.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.12",
            "verseOrgIds": [
              "2CH.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehooboʼaam mootichis Yerusaalem keessatti of cimsee mootii taʼee ni jiraate. Yeroo inni mootii taʼetti umuriin isaa waggaa afurtamii tokko ture. Innis waggaa kudha torba Yerusaalem magaalaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.13",
            "verseOrgIds": [
              "2CH.12.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.12.13",
                "verseOrgIds": [
                  "2CH.12.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Maqaa ofii isaa achi kaaʼachuuf jedhee gosoota Israaʼel hunda keessaa filate sana keessatti mootii taʼee bulche. Maqaan haadha isaa Naʼamaa ture; isheenis gosa Amoon turte.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.13",
            "verseOrgIds": [
              "2CH.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni sababii",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.14",
            "verseOrgIds": [
              "2CH.12.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "2CH.12.14",
                "verseOrgIds": [
                  "2CH.12.14"
                ]
              }
            }
          ]
        },
        {
          "text": "barbaaduuf garaa isaa hin qopheessiniif waan hamaa hojjete.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.14",
            "verseOrgIds": [
              "2CH.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wantoonni bara mootummaa Rehooboʼaam keessa jalqabaa hamma dhumaatti hojjetaman galmee seenaa kan Shemaaʼiyaa raajichaa fi seenaa dhalootaa kan Iddoon namichi ilaalaan sun barreesse keessatti barreeffamaniiru mitii? Rehooboʼaamii fi Yerobiʼaam gidduu waraana gargari hin cinnetu ture.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.15",
            "verseOrgIds": [
              "2CH.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehooboʼaam abbootii ofii wajjin boqotee Magaalaa Daawit keessatti ni awwaalame. Ilmi isaa Abiyaan iddoo isaa buʼee mootii taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.16",
            "verseOrgIds": [
              "2CH.12.16"
            ]
          }
        }
      ]
    }
  ],
