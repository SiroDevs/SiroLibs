    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehooboʼaamis sababii Israaʼeloonni hundinuu mootii isa gochuudhaaf achi yaaʼaniif kaʼee Sheekem dhaqe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.1",
            "verseOrgIds": [
              "2CH.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yerobiʼaam ilmi Nebaat yommuu oduu kana dhagaʼetti deebiʼee dhufe; inni Solomoon Mooticha jalaa baqatee Gibxi jiraachaa tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.2",
            "verseOrgIds": [
              "2CH.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Yerobiʼaamitti nama erganii waamanii, innii fi Israaʼel hundinuu gara Rehooboʼaam dhaqanii akkana jedhaniin:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.3",
            "verseOrgIds": [
              "2CH.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Abbaan kee waanjoo ulfaatu nurra kaaʼee ture; ati immoo amma hojii inni humnaan nu hojjechiise sanaa fi waanjoo ulfaataa inni nurra kaaʼe sana nuuf salphisi; nus si tajaajillaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.4",
            "verseOrgIds": [
              "2CH.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehooboʼaam immoo deebisee, \"Bultii sadii keessatti deebiʼaa gara koo kottaa\" jedheen. Kanaafuu namoonni sun baʼanii deeman.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.5",
            "verseOrgIds": [
              "2CH.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis Rehooboʼaam Mootichi maanguddoota bara jireenya isaa keessa abbaa isaa Solomoonin tajaajilaniin mariʼate. Innis, \"Isin akka ani namoota kanaaf maal deebisu na gorsitu?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.6",
            "verseOrgIds": [
              "2CH.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis, \"Yoo ati saba kanaaf garaa laaftee isaan gammachiiftee deebii gaarii kenniteef, isaan yeroo hunda tajaajiltoota kee ni taʼu\" jedhanii deebisaniif.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.7",
            "verseOrgIds": [
              "2CH.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehooboʼaam garuu gorsa maanguddoonni kennaniif didee dargaggoota isa wajjin guddatan kanneen isa tajaajilan wajjin mariʼate.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.8",
            "verseOrgIds": [
              "2CH.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis, \"Gorsi keessan maal? Namoota, 'Waanjoo abbaan kee nurra kaaʼe kana nuuf salphisi' naan jedhan kanaaf akkamitti haa deebisnu?\" jedhee isaan gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.9",
            "verseOrgIds": [
              "2CH.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dargaggoonni isa wajjin guddatan sunis akkana jedhanii deebisaniif; \"Namoonni, 'Abbaan kee waanjoo ulfaataa nurra kaaʼe; ati garuu waanjoo keenya nuu salphisi' siin jedhan; ati amma akkana jedhiin; 'Qubni koo xinnaan mudhii abbaa kootii irra furdaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.10",
            "verseOrgIds": [
              "2CH.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abbaan koo waanjoo ulfaataa isin irra kaaʼe; ani immoo hammas caalaa iyyuu isinittan ulfaachisa. Abbaan koo qacceedhaan isin garafe; ani immoo torbaanqabaadhaanan isin garafa.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.11",
            "verseOrgIds": [
              "2CH.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bultii sadii booddee akkuma mootichi, \"Guyyaa sadii keessatti deebiʼaa gara koo kottaa\" jedhe sana Yerobiʼaamii fi namoonni hundi gara Rehooboʼaamitti deebiʼan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.12",
            "verseOrgIds": [
              "2CH.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichi immoo afaan hamaadhaan deebii kenneef. Gorsa maanguddootaas didee,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.13",
            "verseOrgIds": [
              "2CH.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "gorsa dargaggootaa fudhatee, \"Abbaan koo waanjoo keessan isinitti ulfaachise; ani immoo hammas iyyuu caalaa isinittan ulfaachisa. Abbaan koo qacceedhaan isin garafe; ani immoo torbaanqabaadhaanan isin garafa\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.14",
            "verseOrgIds": [
              "2CH.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu mootichi namoota sana hin dhaggeeffanne; wanni kun akka dubbiin",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.15",
            "verseOrgIds": [
              "2CH.10.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.10.15",
                "verseOrgIds": [
                  "2CH.10.15"
                ]
              }
            }
          ]
        },
        {
          "text": "karaa Ahiiyaa namicha biyya Shiiloo sanaatiin Yerobiʼaam ilma Nebaatitti dubbate sun raawwatamuuf Waaqayyo biraa dhufeetii.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.15",
            "verseOrgIds": [
              "2CH.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼel hundi yommuu akka mootichi isaan dhaggeeffachuu dide arganitti, akkana jedhanii mootichaaf deebii kennan:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.16",
            "verseOrgIds": [
              "2CH.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2CH 10:16"
      },
      "items": [
        {
          "text": "\"Nu Daawit irraa qooda maalii qabna?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.16",
            "verseOrgIds": [
              "2CH.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2CH 10:16"
      },
      "items": [
        {
          "text": "Ilma Isseey irraas maal qabna?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.16",
            "verseOrgIds": [
              "2CH.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2CH 10:16"
      },
      "items": [
        {
          "text": "Yaa Israaʼel gara dunkaana keetii!",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.16",
            "verseOrgIds": [
              "2CH.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2CH 10:16"
      },
      "items": [
        {
          "text": "Yaa Daawit atis mana kee eeggadhu!\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.16",
            "verseOrgIds": [
              "2CH.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "2CH 10:16"
      },
      "items": [
        {
          "text": "Kanaafuu Israaʼeloonni hundi gara mana ofii isaaniitti deebiʼan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.16",
            "verseOrgIds": [
              "2CH.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼeloota magaalaawwan Yihuudaa keessa jiraatan garuu Rehooboʼaamtu bulchaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.17",
            "verseOrgIds": [
              "2CH.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehooboʼaam mootichis Hadooraam itti gaafatamaa hojjettoota hojii humnaa ni erge; Israaʼeloonni immoo dhagaadhaan tumanii isa ajjeesan. Rehooboʼaam mootichi garuu ariitiidhaan gaarii ofii isaa yaabbatee jalaa miliqee Yerusaalemitti baqate.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.18",
            "verseOrgIds": [
              "2CH.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Israaʼeloonni hamma harʼaatti mana Daawititti fincilaniiru.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.19",
            "verseOrgIds": [
              "2CH.10.19"
            ]
          }
        }
      ]
    }
  ],
