    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:2"
      },
      "items": [
        {
          "text": "magaalaawwan ishees gad deebiʼaa jiru;",
          "type": "text",
          "attrs": {
