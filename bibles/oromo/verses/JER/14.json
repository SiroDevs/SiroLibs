      "attrs": {
        "style": "q1",
        "vid": "JER 14:18"
      },
      "items": [
        {
          "text": "Raajonnii fi luboonni",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.18",
            "verseOrgIds": [
              "JER.14.18"
            ]
