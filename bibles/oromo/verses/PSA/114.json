    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Faarfannaa Faasiikaaf Dhiʼeeffamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 114:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo sabni Israaʼel biyya Gibxii, manni Yaaqoobis",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.1",
            "verseOrgIds": [
              "PSA.114.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 114:1"
      },
      "items": [
        {
          "text": "saba afaan ormaa dubbatu keessaa baʼetti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.1",
            "verseOrgIds": [
              "PSA.114.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 114:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yihuudaan mana qulqullummaa Waaqaa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.2",
            "verseOrgIds": [
              "PSA.114.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 114:2"
      },
      "items": [
        {
          "text": "Israaʼel immoo bulchiinsa isaa taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.2",
            "verseOrgIds": [
              "PSA.114.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 114:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Galaanni argee baqate;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.3",
            "verseOrgIds": [
              "PSA.114.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 114:3"
      },
      "items": [
        {
          "text": "Yordaanosis duubatti deebiʼe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.3",
            "verseOrgIds": [
              "PSA.114.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 114:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "tulluuwwan akka korbeeyyii hoolaa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.4",
            "verseOrgIds": [
              "PSA.114.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 114:4"
      },
      "items": [
        {
          "text": "gaarranis akkuma xobbaallaawwan hoolaa burraaqan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.4",
            "verseOrgIds": [
              "PSA.114.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 114:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa galaana, ati maaliif baqatte?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.5",
            "verseOrgIds": [
              "PSA.114.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 114:5"
      },
      "items": [
        {
          "text": "Yaa Yordaanos, atis maaliif duubatti deebite?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.5",
            "verseOrgIds": [
              "PSA.114.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 114:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa tulluuwwan, isin maaliif akka korbeeyyii hoolaa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.6",
            "verseOrgIds": [
              "PSA.114.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 114:6"
      },
      "items": [
        {
          "text": "yaa gaarran isinis maaliif akka xobbaallaawwan hoolaa burraaqxu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.6",
            "verseOrgIds": [
              "PSA.114.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 114:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa lafa, fuula Gooftaa duratti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.7",
            "verseOrgIds": [
              "PSA.114.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 114:7"
      },
      "items": [
        {
          "text": "fuula Waaqa Yaaqoob duratti holladhu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.7",
            "verseOrgIds": [
              "PSA.114.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 114:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "inni kattaa gara harootti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.8",
            "verseOrgIds": [
              "PSA.114.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 114:8"
      },
      "items": [
        {
          "text": "kattaa jabaa immoo gara burqaa bishaaniitti geeddare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.114.8",
            "verseOrgIds": [
              "PSA.114.8"
            ]
          }
        }
      ]
    }
