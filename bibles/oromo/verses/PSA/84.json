      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:9"
      },
      "items": [
        {
          "text": "fuula dibamaa kee sanaas ilaali.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.9",
            "verseOrgIds": [
              "PSA.84.10"
            ]
          }
        }
      ]
    },
