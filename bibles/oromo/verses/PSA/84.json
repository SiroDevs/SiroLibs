      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:10"
      },
      "items": [
        {
          "text": "guyyaa tokko oobdii keetii irra ooluu wayya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.10",
            "verseOrgIds": [
              "PSA.84.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 84:10"
      },
      "items": [
        {
          "text": "dunkaana hamootaa keessa jiraachuu irra,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.10",
            "verseOrgIds": [
              "PSA.84.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:10"
      },
      "items": [
        {
          "text": "eegduu balbala mana Waaqa koo taʼuu naa wayya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.10",
            "verseOrgIds": [
              "PSA.84.11"
            ]
          }
        }
      ]
    },
