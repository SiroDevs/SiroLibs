          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garaan keenya dugda duubatti hin deebine;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.18",
            "verseOrgIds": [
              "PSA.44.19"
            ]
          }
        }
