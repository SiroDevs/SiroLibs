      "attrs": {
        "style": "q2",
        "vid": "PSA 44:20"
      },
      "items": [
        {
          "text": "yookaan utuu harka keenya gara waaqa ormaatti balʼifannee jiraannee,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.20",
            "verseOrgIds": [
