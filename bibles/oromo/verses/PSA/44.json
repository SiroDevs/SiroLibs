          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuu nu maqaa Waaqa keenyaa irraanfannee,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.20",
            "verseOrgIds": [
              "PSA.44.21"
            ]
