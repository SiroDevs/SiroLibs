      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:17"
      },
      "items": [
        {
          "text": "taʼus nu si hin daganne;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.17",
            "verseOrgIds": [
              "PSA.44.18"
            ]
          }
        }
      ]
    },
