      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:16"
      },
      "items": [
        {
          "text": "sababii diinaatii fi sababii nama haaloo baafatuutiif taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.16",
            "verseOrgIds": [
              "PSA.44.17"
            ]
          }
        }
      ]
    },
    {
