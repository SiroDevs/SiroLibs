      "attrs": {
        "style": "q2",
        "vid": "PSA 44:21"
      },
      "items": [
        {
          "text": "Inni icciitii garaa namaa beekaatii.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.21",
            "verseOrgIds": [
              "PSA.44.22"
