          "text": "44",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Faarfannaa 44",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Faaruu Booʼichaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Dura buʼaa faarfattootaatiif.",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "Maskiilii",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaan Qooraahi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 44:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Waaqi, waan ati bara durii,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.1",
            "verseOrgIds": [
              "PSA.44.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:1"
      },
      "items": [
        {
          "text": "jabana isaanii keessa hojjette sana,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.1",
            "verseOrgIds": [
              "PSA.44.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 44:1"
      },
      "items": [
        {
          "text": "abbootiin keenya nutti himaniiru;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.1",
            "verseOrgIds": [
              "PSA.44.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:1"
      },
      "items": [
        {
          "text": "nuus gurra keenyaan dhageenyeerra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.1",
            "verseOrgIds": [
              "PSA.44.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 44:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati harka keetiin saboota ariitee baafte;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.2",
            "verseOrgIds": [
              "PSA.44.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:2"
      },
      "items": [
        {
          "text": "abbootii keenya immoo ni dhaabde;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.2",
            "verseOrgIds": [
              "PSA.44.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 44:2"
      },
      "items": [
        {
          "text": "namoota ni balleessite;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.2",
            "verseOrgIds": [
              "PSA.44.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:2"
      },
      "items": [
        {
          "text": "abbootii keenya garuu bilisa baafte.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.2",
            "verseOrgIds": [
              "PSA.44.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 44:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harka kee mirgaatiin, irree keetii fi ifa fuula keetiitiin dhaalan malee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.3",
            "verseOrgIds": [
              "PSA.44.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:3"
      },
      "items": [
        {
          "text": "isaan goraadee isaaniitiin lafa sana hin dhaalle;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.3",
            "verseOrgIds": [
              "PSA.44.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 44:3"
      },
      "items": [
        {
          "text": "yookaan irreen isaanii moʼannoo isaaniif hin fidne;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.3",
            "verseOrgIds": [
              "PSA.44.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:3"
      },
      "items": [
        {
          "text": "ati isaan jaallatteertaatii.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.3",
            "verseOrgIds": [
              "PSA.44.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 44:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati Mootii koo fi Waaqa koo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.4",
            "verseOrgIds": [
              "PSA.44.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:4"
      },
      "items": [
        {
          "text": "kan Yaaqoobiif moʼicha ajajjuu dha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.4",
            "verseOrgIds": [
              "PSA.44.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 44:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu siin diinota keenya duubatti deebifna;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.5",
            "verseOrgIds": [
              "PSA.44.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:5"
      },
      "items": [
        {
          "text": "maqaa keetiinis amajaajota keenya gad dhidhiinna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.5",
            "verseOrgIds": [
              "PSA.44.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 44:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani iddaa koo hin amanadhu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.6",
            "verseOrgIds": [
              "PSA.44.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:6"
      },
      "items": [
        {
          "text": "goraadeen koos moʼannaa naa hin fidu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.6",
            "verseOrgIds": [
              "PSA.44.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 44:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati garuu diinota keenya jalaa nu oolchita;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.7",
            "verseOrgIds": [
              "PSA.44.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:7"
      },
      "items": [
        {
          "text": "warra nu jibban immoo ni qaanessita.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.7",
            "verseOrgIds": [
              "PSA.44.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 44:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu yeroo hundumaa Waaqaan dhaadanna;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.8",
            "verseOrgIds": [
              "PSA.44.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:8"
      },
      "items": [
        {
          "text": "maqaa kees bara baraan ni galateeffanna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.8",
            "verseOrgIds": [
              "PSA.44.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 44:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma garuu ati nu gatteerta; gadis nu deebifteerta;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.9",
            "verseOrgIds": [
              "PSA.44.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:9"
      },
      "items": [
        {
          "text": "ati loltoota keenya wajjin hin baane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.9",
            "verseOrgIds": [
              "PSA.44.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 44:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka nu diinota keenya baqannu nu gooteerta;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.10",
            "verseOrgIds": [
              "PSA.44.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:10"
      },
      "items": [
        {
          "text": "warri nu jibbanis nu saamaniiru.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.10",
            "verseOrgIds": [
              "PSA.44.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 44:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati akka hoolota qalamuuf qopheeffamanii nu gooteerta;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.11",
            "verseOrgIds": [
              "PSA.44.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:11"
      },
      "items": [
        {
          "text": "ormoota keessas nu bittinneessiteerta.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.11",
            "verseOrgIds": [
              "PSA.44.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 44:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saba kee gatii xinnaatti gurgurteerta;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.12",
            "verseOrgIds": [
              "PSA.44.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:12"
      },
      "items": [
        {
          "text": "gurgurtaa isaanii irraas buʼaa hin arganne.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.12",
            "verseOrgIds": [
              "PSA.44.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 44:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ollaa keenya duratti nama kolfaa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.13",
            "verseOrgIds": [
              "PSA.44.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:13"
      },
      "items": [
        {
          "text": "warra naannoo keenyaa birattis",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.13",
            "verseOrgIds": [
              "PSA.44.14"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "waan qoosaatii fi nama tuffii nu gooteerta.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.13",
            "verseOrgIds": [
              "PSA.44.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 44:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ormoota keessatti waan mammaaksaa nu goote;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.14",
            "verseOrgIds": [
              "PSA.44.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:14"
      },
      "items": [
        {
          "text": "namoonnis mataa nutti raasan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.14",
            "verseOrgIds": [
              "PSA.44.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 44:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salphinni koo guyyaa guutuu fuula koo dura jira;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.15",
            "verseOrgIds": [
              "PSA.44.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:15"
      },
      "items": [
        {
          "text": "fuulli koos qaaniidhaan haguugameera.",
          "type": "text",
          "attrs": {
