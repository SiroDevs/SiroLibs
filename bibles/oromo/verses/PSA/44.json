          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati garuu iddoo waangoonni jiraatanitti nu caccabsite;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.19",
            "verseOrgIds": [
              "PSA.44.20"
            ]
