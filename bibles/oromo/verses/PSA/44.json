          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kun hundi nutti dhufeera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.17",
            "verseOrgIds": [
              "PSA.44.18"
            ]
          }
        }
      ]
    },
