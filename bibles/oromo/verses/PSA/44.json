          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunis sababii dubbii warra na tuffataniitii fi warra na arrabsaniitiif,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.16",
            "verseOrgIds": [
              "PSA.44.17"
            ]
          }
        }
      ]
    },
    {
