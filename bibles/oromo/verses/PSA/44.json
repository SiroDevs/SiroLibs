      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:17"
      },
      "items": [
        {
          "text": "yookaan kakuu kee keessatti amanamummaa hin dhabne.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.17",
            "verseOrgIds": [
              "PSA.44.18"
            ]
          }
        }
      ]
    },
    {
