      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:18"
      },
      "items": [
        {
          "text": "tarkaanfiin keenyas karaa kee irraa hin jalʼanne.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.18",
            "verseOrgIds": [
              "PSA.44.19"
            ]
          }
        }
