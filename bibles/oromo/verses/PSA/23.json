            "number": "1",
            "style": "v",
            "sid": "PSA 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.23.1",
                "verseOrgIds": [
                  "PSA.23.1"
                ]
              }
            }
          ]
        },
        {
          "text": "tiksee koo ti; ani homaa hin dhabu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.1",
            "verseOrgIds": [
              "PSA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni marga lalisaa keessa na boqochiisa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.2",
            "verseOrgIds": [
              "PSA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 23:2"
      },
      "items": [
        {
          "text": "gara bishaan tasgabbaaʼaattis na geessa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.2",
            "verseOrgIds": [
              "PSA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "inni lubbuu natti deebisa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.3",
            "verseOrgIds": [
              "PSA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 23:3"
      },
      "items": [
        {
          "text": "Maqaa isaatiif jedhees",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.3",
            "verseOrgIds": [
              "PSA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 23:3"
      },
      "items": [
        {
          "text": "karaa qajeelaa irra na deemsisa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.3",
            "verseOrgIds": [
              "PSA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani yoon sulula gaaddisa duʼaa keessa deeme illee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.4",
            "verseOrgIds": [
              "PSA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 23:4"
      },
      "items": [
        {
          "text": "ati waan na wajjin jirtuuf, homaa hin sodaadhu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.4",
            "verseOrgIds": [
              "PSA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 23:4"
      },
      "items": [
        {
          "text": "uleen keetii fi bokkuun kee na jajjabeessu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.4",
            "verseOrgIds": [
              "PSA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati utuma diinonni koo ilaalanuu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.5",
            "verseOrgIds": [
              "PSA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 23:5"
      },
      "items": [
        {
          "text": "fuula koo duratti maaddii naa qopheessita.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.5",
            "verseOrgIds": [
              "PSA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 23:5"
      },
      "items": [
        {
          "text": "Mataa koo zayitii dibda;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.5",
            "verseOrgIds": [
              "PSA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 23:5"
      },
      "items": [
        {
          "text": "xoofoon koos guutuu irraan dhangalaʼaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.5",
            "verseOrgIds": [
              "PSA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhugumaan gaarummaan keetii fi araarri kee,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.6",
            "verseOrgIds": [
              "PSA.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 23:6"
      },
      "items": [
        {
          "text": "bara jireenya kootii hunda na duukaa buʼu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.6",
            "verseOrgIds": [
              "PSA.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 23:6"
      },
      "items": [
        {
          "text": "anis bara baraan, mana",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.6",
            "verseOrgIds": [
              "PSA.23.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.23.6",
                "verseOrgIds": [
                  "PSA.23.6"
                ]
              }
            }
          ]
        },
        {
          "text": "keessa nan jiraadha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.23.6",
            "verseOrgIds": [
              "PSA.23.6"
            ]
          }
        }
      ]
    }
  ],
