        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Faarfannaa Boojiʼamtootaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 137:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu yeroo Xiyoonin yaadannetti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.1",
            "verseOrgIds": [
              "PSA.137.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:1"
      },
      "items": [
        {
          "text": "lageen Baabilon bira teenyee boonye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.1",
            "verseOrgIds": [
              "PSA.137.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 137:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achittis kiraara keenya",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.2",
            "verseOrgIds": [
              "PSA.137.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:2"
      },
      "items": [
        {
          "text": "muka alaltuutti fannifne;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.2",
            "verseOrgIds": [
              "PSA.137.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 137:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "achitti warri nu boojiʼan faarfannaa, warri nu dhiphisanis,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.3",
            "verseOrgIds": [
              "PSA.137.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:3"
      },
      "items": [
        {
          "text": "\"Faarfannaawwan Xiyoon keessaa tokko nuu faarfadhaa!\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.3",
            "verseOrgIds": [
              "PSA.137.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:3"
      },
      "items": [
        {
          "text": "jedhanii akka nu faarfannaa gammachuu isaaniif faarfannu nu gaafatan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.3",
            "verseOrgIds": [
              "PSA.137.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 137:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu utuu biyya ormaa jirruu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.4",
            "verseOrgIds": [
              "PSA.137.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:4"
      },
      "items": [
        {
          "text": "akkamitti faarfannaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.4",
            "verseOrgIds": [
              "PSA.137.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.137.4",
                "verseOrgIds": [
                  "PSA.137.4"
                ]
              }
            }
          ]
        },
        {
          "text": "faarfachuu dandeenya?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.4",
            "verseOrgIds": [
              "PSA.137.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 137:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Yerusaalem, yoo ani si irraanfadhe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.5",
            "verseOrgIds": [
              "PSA.137.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:5"
      },
      "items": [
        {
          "text": "harki koo mirgaa ogummaa isaa haa irraanfatu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.5",
            "verseOrgIds": [
              "PSA.137.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 137:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo ani si yaadachuu baadhe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.6",
            "verseOrgIds": [
              "PSA.137.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:6"
      },
      "items": [
        {
          "text": "yoo ani gammachuu koo guddichaa olitti",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.6",
            "verseOrgIds": [
              "PSA.137.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 137:6"
      },
      "items": [
        {
          "text": "Yerusaalemin ilaaluu baadhe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.6",
            "verseOrgIds": [
              "PSA.137.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:6"
      },
      "items": [
        {
          "text": "arrabni koo laagaa kootti haa maxxanu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.6",
            "verseOrgIds": [
              "PSA.137.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 137:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.7",
            "verseOrgIds": [
              "PSA.137.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.137.7",
                "verseOrgIds": [
                  "PSA.137.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", waan warri Edoom",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.7",
            "verseOrgIds": [
              "PSA.137.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:7"
      },
      "items": [
        {
          "text": "gaafa Yerusaalem diigamte jedhan sana yaadadhu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.7",
            "verseOrgIds": [
              "PSA.137.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 137:7"
      },
      "items": [
        {
          "text": "isaanis, \"Ishee diigaa!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.7",
            "verseOrgIds": [
              "PSA.137.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:7"
      },
      "items": [
        {
          "text": "Hamma hundee isheetti ishee diigaa!\" jedhanii iyyan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.7",
            "verseOrgIds": [
              "PSA.137.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 137:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa intala Baabilon, kan baduudhaaf qophoofte,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.8",
            "verseOrgIds": [
              "PSA.137.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:8"
      },
      "items": [
        {
          "text": "inni waan ati nu goote sanaaf,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.8",
            "verseOrgIds": [
              "PSA.137.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:8"
      },
      "items": [
        {
          "text": "gatii kee siif kennu eebbifamaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.8",
            "verseOrgIds": [
              "PSA.137.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 137:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni daaʼimman kee qabee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.9",
            "verseOrgIds": [
              "PSA.137.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 137:9"
      },
      "items": [
        {
          "text": "dhagaa irratti caccabsu sun eebbifamaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.9",
            "verseOrgIds": [
              "PSA.137.9"
            ]
          }
        }
      ]
    }
  ],
