      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Iyyata Nama Qajeelaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kadhannaa Daawit.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.1",
            "verseOrgIds": [
              "PSA.17.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.17.1",
                "verseOrgIds": [
                  "PSA.17.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", iyyata ani murtii qajeelaaf iyyadhu dhagaʼi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.1",
            "verseOrgIds": [
              "PSA.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:1"
      },
      "items": [
        {
          "text": "booʼicha koos dhaggeeffadhu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.1",
            "verseOrgIds": [
              "PSA.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 17:1"
      },
      "items": [
        {
          "text": "Kadhannaa koo kan afaan nama hin gowwoomsine",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.1",
            "verseOrgIds": [
              "PSA.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:1"
      },
      "items": [
        {
          "text": "keessaa baʼuufis gurra kenni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.1",
            "verseOrgIds": [
              "PSA.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murtiin koo si biraa haa dhufu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.2",
            "verseOrgIds": [
              "PSA.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:2"
      },
      "items": [
        {
          "text": "iji kees waan qajeelaa haa argu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.2",
            "verseOrgIds": [
              "PSA.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati yoo garaa koo qorte, halkaniinis yoo na ilaalte,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.3",
            "verseOrgIds": [
              "PSA.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:3"
      },
      "items": [
        {
          "text": "yoo na sakattaates, homaa narratti hin argattu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.3",
            "verseOrgIds": [
              "PSA.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:3"
      },
      "items": [
        {
          "text": "ani akka afaan koo cubbuu hin hojjenneef kutadheeraatii.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.3",
            "verseOrgIds": [
              "PSA.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaʼee hojii namootaa immoo ani dubbii afaan keetiitiin",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.4",
            "verseOrgIds": [
              "PSA.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:4"
      },
      "items": [
        {
          "text": "karaa gooltotaa irraa of eeggadheera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.4",
            "verseOrgIds": [
              "PSA.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tarkaanfiin koo karaa kee irratti cimeera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.5",
            "verseOrgIds": [
              "PSA.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:5"
      },
      "items": [
        {
          "text": "miilli koos hin mucucaanne.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.5",
            "verseOrgIds": [
              "PSA.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Waaqi, waan ati deebii naa kennituuf ani sin waammadha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.6",
            "verseOrgIds": [
              "PSA.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:6"
      },
      "items": [
        {
          "text": "gurra kee gara kootti qabiitii kadhannaa koo dhagaʼi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.6",
            "verseOrgIds": [
              "PSA.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa isa warra diinota isaanii jalaa sitti baqatan",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.7",
            "verseOrgIds": [
              "PSA.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:7"
      },
      "items": [
        {
          "text": "harka kee mirgaatiin oolchitu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.7",
            "verseOrgIds": [
              "PSA.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:7"
      },
      "items": [
        {
          "text": "ati jaalala kee isa hin geeddaramne sana haala dinqisiisaadhaan argisiisi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.7",
            "verseOrgIds": [
              "PSA.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka agartuu ija keetiitti na eegi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.8",
            "verseOrgIds": [
              "PSA.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:8"
      },
      "items": [
        {
          "text": "gaaddidduu qoochoo keetiitiinis na dhoksi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.8",
            "verseOrgIds": [
              "PSA.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "hamoota na dhiphisan jalaa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.9",
            "verseOrgIds": [
              "PSA.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:9"
      },
      "items": [
        {
          "text": "diinota na ajjeesuuf na marsan jalaa na baasi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.9",
            "verseOrgIds": [
              "PSA.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan garaa isaanii kan namaa hin naane sana ni guduunfu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.10",
            "verseOrgIds": [
              "PSA.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:10"
      },
      "items": [
        {
          "text": "afaan isaaniis of tuulummaadhaan dubbata.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.10",
            "verseOrgIds": [
              "PSA.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan faana na dhaʼu; ammas na marsaniiru;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.11",
            "verseOrgIds": [
              "PSA.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:11"
      },
      "items": [
        {
          "text": "lafaan na dhaʼuudhaafis ija babaasu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.11",
            "verseOrgIds": [
              "PSA.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan akka leenca waa kukkutachuu kajeeluu ti;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.12",
            "verseOrgIds": [
              "PSA.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:12"
      },
      "items": [
        {
          "text": "akka leenca guddaa riphee waa gaaduu ti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.12",
            "verseOrgIds": [
              "PSA.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.13",
            "verseOrgIds": [
              "PSA.17.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.17.13",
                "verseOrgIds": [
                  "PSA.17.13"
                ]
              }
            }
          ]
        },
        {
          "text": "kaʼi; itti baʼiitii isaan kuffisi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.13",
            "verseOrgIds": [
              "PSA.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:13"
      },
      "items": [
        {
          "text": "goraadee keetiinis hamoota jalaa na baasi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.13",
            "verseOrgIds": [
              "PSA.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.14",
            "verseOrgIds": [
              "PSA.17.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.17.14",
                "verseOrgIds": [
                  "PSA.17.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", namoota akkanaa jalaa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.14",
            "verseOrgIds": [
              "PSA.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 17:14"
      },
      "items": [
        {
          "text": "namoota addunyaa kanaa warra qoodni isaanii jireenyuma ammaa taʼe jalaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.14",
            "verseOrgIds": [
              "PSA.17.14"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "harka keetiin na baraari.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.17.14",
            "verseOrgIds": [
              "PSA.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
