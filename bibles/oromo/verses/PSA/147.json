      "items": [
        {
          "text": "tokkoo tokkoo isaaniis maqaa maqaadhaan waama.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.4",
            "verseOrgIds": [
              "PSA.147.4"
            ]
          }
        }
