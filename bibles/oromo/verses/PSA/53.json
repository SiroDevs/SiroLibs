        "style": "ms1"
      },
      "items": [
        {
          "text": "Waan Warra Waaqatti Hin Bulle Eeggatu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "mr"
      },
