        "style": "d"
      },
      "items": [
        {
          "text": "Faarfannaa Daawit.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 108:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Waaqi, garaan koo hin raafamu; ani nan faarfadha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.1",
            "verseOrgIds": [
              "PSA.108.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:1"
      },
      "items": [
        {
          "text": "lubbuu koo guutuudhaanis sin galateeffadha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.1",
            "verseOrgIds": [
              "PSA.108.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 108:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa kiraaraa fi baganaa dammaqaa!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.2",
            "verseOrgIds": [
              "PSA.108.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:2"
      },
      "items": [
        {
          "text": "Anis ganamaan nan dammaqa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.2",
            "verseOrgIds": [
              "PSA.108.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 108:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.3",
            "verseOrgIds": [
              "PSA.108.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.108.3",
                "verseOrgIds": [
                  "PSA.108.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", ani saboota gidduutti galata siif nan galcha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.3",
            "verseOrgIds": [
              "PSA.108.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:3"
      },
      "items": [
        {
          "text": "namoota gidduuttis waaʼee kee nan faarfadha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.3",
            "verseOrgIds": [
              "PSA.108.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 108:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jaalalli kee guddaa dha; samiiwwanis caalaa ol dheeraadhaatii;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.4",
            "verseOrgIds": [
              "PSA.108.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:4"
      },
      "items": [
        {
          "text": "amanamummaan kees samiiwwan qaqqaba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.4",
            "verseOrgIds": [
              "PSA.108.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 108:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Waaqi, ati samiiwwaniin olitti ol ol jedhi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.5",
            "verseOrgIds": [
              "PSA.108.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:5"
      },
      "items": [
        {
          "text": "ulfinni kees lafa hunda irra haa jiraatu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.5",
            "verseOrgIds": [
              "PSA.108.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 108:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka warri ati jaallattu furamaniif,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.6",
            "verseOrgIds": [
              "PSA.108.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:6"
      },
      "items": [
        {
          "text": "harka kee mirgaatiin nu oolchi; nu gargaaris;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.6",
            "verseOrgIds": [
              "PSA.108.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 108:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni iddoo qulqullummaa isaatii akkana jedhee dubbateera:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.7",
            "verseOrgIds": [
              "PSA.108.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:7"
      },
      "items": [
        {
          "text": "\"Ani gammachuudhaan Sheekemin gargar nan qooda;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.7",
            "verseOrgIds": [
              "PSA.108.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:7"
      },
      "items": [
        {
          "text": "Sulula Sukootis nan safara.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.7",
            "verseOrgIds": [
              "PSA.108.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 108:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Giliʼaad kan koo ti; Minaaseenis kan koo ti;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.8",
            "verseOrgIds": [
              "PSA.108.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:8"
      },
      "items": [
        {
          "text": "Efreem gonfoo sibiilaa koo ti;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.8",
            "verseOrgIds": [
              "PSA.108.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:8"
      },
      "items": [
        {
          "text": "Yihuudaanis bokkuu mootummaa koo ti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.8",
            "verseOrgIds": [
              "PSA.108.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 108:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moʼaab caabii dhiqannaa koo ti;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.9",
            "verseOrgIds": [
              "PSA.108.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:9"
      },
      "items": [
        {
          "text": "Edoom irra kophee koo darbadhee nan buusa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.9",
            "verseOrgIds": [
              "PSA.108.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:9"
      },
      "items": [
        {
          "text": "Filisxeem irrattis moʼannaadhaan nan geerara.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.9",
            "verseOrgIds": [
              "PSA.108.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 108:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eenyutu magaalaa jabeeffamtee ijaaramtetti na fida?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.10",
            "verseOrgIds": [
              "PSA.108.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:10"
      },
      "items": [
        {
          "text": "Eenyutu Edoomitti na geessa?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.10",
            "verseOrgIds": [
              "PSA.108.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 108:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Waaqi kan nu gatte,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.11",
            "verseOrgIds": [
              "PSA.108.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:11"
      },
      "items": [
        {
          "text": "kan loltoota keenya wajjin baʼuu diddes suma mitii?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.11",
            "verseOrgIds": [
              "PSA.108.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 108:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diina keenya of irraa dhowwuu nu gargaar,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.12",
            "verseOrgIds": [
              "PSA.108.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:12"
      },
      "items": [
        {
          "text": "gargaarsi namaa faayidaa hin qabuutii.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.12",
            "verseOrgIds": [
              "PSA.108.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 108:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu Waaqa wajjin ni moʼanna;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.13",
            "verseOrgIds": [
              "PSA.108.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 108:13"
      },
      "items": [
        {
          "text": "innis diinota keenya gad dhidhiita.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.13",
            "verseOrgIds": [
              "PSA.108.14"
            ]
          }
        }
      ]
    }
  ],
