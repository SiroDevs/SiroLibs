          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diinonni koo hundinuu haa qaanaʼan; akka malees haa rifatan;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.10",
            "verseOrgIds": [
              "PSA.6.11"
            ]
          }
        }
      ]
