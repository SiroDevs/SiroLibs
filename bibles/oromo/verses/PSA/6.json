                "verseId": "PSA.6.4",
                "verseOrgIds": [
                  "PSA.6.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", deebiʼiitii lubbuu koo oolchi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.4",
            "verseOrgIds": [
              "PSA.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:4"
      },
      "items": [
        {
          "text": "araara keetiif jedhiitii na fayyisi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.4",
            "verseOrgIds": [
              "PSA.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni duʼe si hin yaadatu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.5",
            "verseOrgIds": [
              "PSA.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:5"
      },
      "items": [
        {
          "text": "Siiʼool keessatti eenyutu si galateeffata?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.5",
            "verseOrgIds": [
              "PSA.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani aaduu kootiin bututeera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.6",
            "verseOrgIds": [
              "PSA.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 6:6"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 6:6"
      },
      "items": [
        {
          "text": "Halkan hunda booʼichaan siree koo nan dhiqa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.6",
            "verseOrgIds": [
              "PSA.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:6"
      },
      "items": [
        {
          "text": "imimmaaniinis iddoo ciisichaa koo nan tortorsa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.6",
            "verseOrgIds": [
              "PSA.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iji koo gaddaan fajajeera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.7",
            "verseOrgIds": [
              "PSA.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:7"
      },
      "items": [
        {
          "text": "sababii diinota koo hundaatiifis dadhabeera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.7",
            "verseOrgIds": [
              "PSA.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
