        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Kadhannaa Yeroo Dhiphinaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Dura buʼaa faarfattootaatiif. Faarfannaa Baganaadhaan faarfatamu. Faarfannaa Daawit kan akka sirna",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "Shamiiniitiitti",
              "type": "text"
            }
          ]
        },
        {
          "text": "faarfatamu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.1",
            "verseOrgIds": [
              "PSA.6.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.6.1",
                "verseOrgIds": [
                  "PSA.6.2"
                ]
              }
            }
          ]
        },
        {
          "text": "aarii keetiin na hin hifatin;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.1",
            "verseOrgIds": [
              "PSA.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:1"
      },
      "items": [
        {
          "text": "yookaan dheekkamsa keetiin na hin adabin.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.1",
            "verseOrgIds": [
              "PSA.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa gameeraatii yaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.2",
            "verseOrgIds": [
              "PSA.6.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.6.2",
                "verseOrgIds": [
                  "PSA.6.3"
                ]
              }
            }
          ]
        },
        {
          "text": "naaf araarami;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.2",
            "verseOrgIds": [
              "PSA.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:2"
      },
      "items": [
        {
          "text": "lafeen koos jeeqameeraatii yaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.2",
            "verseOrgIds": [
              "PSA.6.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.6.2",
                "verseOrgIds": [
                  "PSA.6.3"
                ]
              }
            }
          ]
        },
        {
          "text": "na fayyisi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.2",
            "verseOrgIds": [
              "PSA.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubbuun koo akka malee jeeqameera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.3",
            "verseOrgIds": [
              "PSA.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 6:3"
      },
      "items": [
        {
          "text": "kun hamma yoomiitti? Yaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.3",
            "verseOrgIds": [
              "PSA.6.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.6.3",
                "verseOrgIds": [
                  "PSA.6.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", hamma yoomiitti?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.3",
            "verseOrgIds": [
              "PSA.6.4"
            ]
          }
        }
      ]
    },
