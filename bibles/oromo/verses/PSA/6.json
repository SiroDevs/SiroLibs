          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.6.8",
                "verseOrgIds": [
                  "PSA.6.9"
                ]
              }
            }
          ]
        },
        {
          "text": "sagalee booʼicha koo dhagaʼeeraatii.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.6.8",
            "verseOrgIds": [
              "PSA.6.9"
            ]
          }
        }
      ]
    },
