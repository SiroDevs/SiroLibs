              "attrs": {
                "verseId": "PSA.11.4",
                "verseOrgIds": [
                  "PSA.11.4"
                ]
              }
            }
          ]
        },
        {
          "text": "samii irra jira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.4",
            "verseOrgIds": [
              "PSA.11.4"
            ]
          }
        }
      ]
    },
    {
