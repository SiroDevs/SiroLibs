    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 11:5"
      },
      "items": [
        {
          "text": "lubbuun isaa garuu nama goolii jaallatu ni jibbiti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.5",
            "verseOrgIds": [
              "PSA.11.5"
            ]
