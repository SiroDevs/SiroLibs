          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni gorsa hamootaatiin hin deddeebine,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.1",
            "verseOrgIds": [
              "PSA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 1:1"
      },
      "items": [
        {
          "text": "yookaan karaa cubbamootaa irra hin dhaabanne,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.1",
            "verseOrgIds": [
              "PSA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 1:1"
      },
      "items": [
        {
          "text": "yookaan barcuma qoostotaa irra hin teenye, eebbifamaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.1",
            "verseOrgIds": [
              "PSA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu inni seera",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.2",
            "verseOrgIds": [
              "PSA.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootti",
              "type": "text",
              "attrs": {
                "verseId": "PSA.1.2",
                "verseOrgIds": [
                  "PSA.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "gammada;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.2",
            "verseOrgIds": [
              "PSA.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 1:2"
      },
      "items": [
        {
          "text": "seera isaas halkanii guyyaa irra deddeebiʼee itti yaada.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.2",
            "verseOrgIds": [
              "PSA.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni akkuma muka qarqara bishaan yaaʼuu dhaabamee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.3",
            "verseOrgIds": [
              "PSA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 1:3"
      },
      "items": [
        {
          "text": "yeroo isaatti ija isaa kennu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.3",
            "verseOrgIds": [
              "PSA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 1:3"
      },
      "items": [
        {
          "text": "kan baalli isaas hin coollagnee ti;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.3",
            "verseOrgIds": [
              "PSA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 1:3"
      },
      "items": [
        {
          "text": "wanni inni hojjetu hundinuus ni tolaaf.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.3",
            "verseOrgIds": [
              "PSA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamoonni garuu akkana miti;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.4",
            "verseOrgIds": [
              "PSA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 1:4"
      },
      "items": [
        {
          "text": "isaan akka habaqii qilleensi fudhatee balleessuu ti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.4",
            "verseOrgIds": [
              "PSA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu hamoonni murtii dura,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.5",
            "verseOrgIds": [
              "PSA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 1:5"
      },
      "items": [
        {
          "text": "yookaan cubbamoonni waldaa qajeeltotaa keessa hin dhaabatan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.5",
            "verseOrgIds": [
              "PSA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.1.6",
                "verseOrgIds": [
                  "PSA.1.6"
                ]
              }
            }
          ]
        },
        {
          "text": "karaa qajeeltotaa ni beekaatii;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.6",
            "verseOrgIds": [
              "PSA.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 1:6"
      },
      "items": [
        {
          "text": "karaan hamootaa garuu gara badiitti geessa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.1.6",
            "verseOrgIds": [
              "PSA.1.6"
            ]
          }
        }
      ]
