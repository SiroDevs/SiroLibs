      },
      "items": [
        {
          "text": "81",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Faarfannaa 81",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Ayyaana Daasiitiif",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Dura Buʼaa Faarfattootaatiif. Faarfannaa Asaaf Kan",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "Gitiitiidhaan",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faarfatamu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 81:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqa jabina nuu taʼeef gammachuudhaan faarfadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.1",
            "verseOrgIds": [
              "PSA.81.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:1"
      },
      "items": [
        {
          "text": "Waaqa Yaaqoobiitiif gammachuudhaan ililchaa!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.1",
            "verseOrgIds": [
              "PSA.81.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 81:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faarfachuu jalqabaa; dibbees rukutaa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.2",
            "verseOrgIds": [
              "PSA.81.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:2"
      },
      "items": [
        {
          "text": "baganaa fi kiraara sagalee gaarii qabu rukutaa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.2",
            "verseOrgIds": [
              "PSA.81.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 81:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo Baatiin dhalattu, yommuu jiʼi goobanutti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.3",
            "verseOrgIds": [
              "PSA.81.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:3"
      },
      "items": [
        {
          "text": "guyyaa ayyaana keenyaa malakata afuufaa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.3",
            "verseOrgIds": [
              "PSA.81.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 81:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kun seera Israaʼeliif kenname,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.4",
            "verseOrgIds": [
              "PSA.81.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:4"
      },
      "items": [
        {
          "text": "ajaja Waaqa Yaaqoob.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.4",
            "verseOrgIds": [
              "PSA.81.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 81:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni yeroo biyya Gibxi dhaʼuuf baʼetti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.5",
            "verseOrgIds": [
              "PSA.81.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:5"
      },
      "items": [
        {
          "text": "waan kana Yoosefiif seera godhee dhaabe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.5",
            "verseOrgIds": [
              "PSA.81.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 81:5"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 81:5"
      },
      "items": [
        {
          "text": "Anis afaan duraan hin beekin tokko dhagaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.5",
            "verseOrgIds": [
              "PSA.81.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 81:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akkana jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.6",
            "verseOrgIds": [
              "PSA.81.7"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "\"Ani gatiittii isaanii irraa baʼaa buuseera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.6",
            "verseOrgIds": [
              "PSA.81.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:6"
      },
      "items": [
        {
          "text": "harki isaanis guuboo baachuu jalaa baʼe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.6",
            "verseOrgIds": [
              "PSA.81.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 81:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati dhiphina kee keessatti na waammatte; anis sin oolche;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.7",
            "verseOrgIds": [
              "PSA.81.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:7"
      },
      "items": [
        {
          "text": "anis lafa bakakkaan itti dhokatu keessaa deebii siifin kenne;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.7",
            "verseOrgIds": [
              "PSA.81.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:7"
      },
      "items": [
        {
          "text": "bishaan Mariibaa birattis sin qore.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.7",
            "verseOrgIds": [
              "PSA.81.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 81:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaa saba koo dhagaʼi; ani siin akeekkachiisa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.8",
            "verseOrgIds": [
              "PSA.81.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:8"
      },
      "items": [
        {
          "text": "yaa Israaʼel ati utuu na dhaggeeffate!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.8",
            "verseOrgIds": [
              "PSA.81.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 81:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni ormaa tokko iyyuu isin gidduu hin jiraatin;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.9",
            "verseOrgIds": [
              "PSA.81.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:9"
      },
      "items": [
        {
          "text": "ana malee waaqa biraa hin waaqeffatin.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.9",
            "verseOrgIds": [
              "PSA.81.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 81:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.10",
            "verseOrgIds": [
              "PSA.81.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.81.10",
                "verseOrgIds": [
                  "PSA.81.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa kee,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.10",
            "verseOrgIds": [
              "PSA.81.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:10"
      },
      "items": [
        {
          "text": "kan Gibxii baasee isin fidee dha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.10",
            "verseOrgIds": [
              "PSA.81.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:10"
      },
      "items": [
        {
          "text": "Afaan kee balʼisii banadhu; ani nan guutaa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.10",
            "verseOrgIds": [
              "PSA.81.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 81:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sabni koo garuu na hin dhaggeeffanne;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.11",
            "verseOrgIds": [
              "PSA.81.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:11"
      },
      "items": [
        {
          "text": "Israaʼel anaaf hin bulle.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.11",
            "verseOrgIds": [
              "PSA.81.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 81:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu ani akka isaan karaa fedhii isaanii deemaniif",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.12",
            "verseOrgIds": [
              "PSA.81.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:12"
      },
      "items": [
        {
          "text": "dabarsee mata jabina isaaniitti isaan kenne.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.12",
            "verseOrgIds": [
              "PSA.81.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 81:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Utuu sabni koo na dhaggeeffatee,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.13",
            "verseOrgIds": [
              "PSA.81.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:13"
      },
      "items": [
        {
          "text": "utuu Israaʼel karaa koo irra deemee jiraatee,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.13",
            "verseOrgIds": [
              "PSA.81.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 81:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ani silaa akkam dafee diinota isaanii jilbeenfachiisee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.14",
            "verseOrgIds": [
              "PSA.81.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:14"
      },
      "items": [
        {
          "text": "harka koos amajaajota isaaniitti nan kaasa ture!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.14",
            "verseOrgIds": [
              "PSA.81.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 81:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.15",
            "verseOrgIds": [
              "PSA.81.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "PSA.81.15",
                "verseOrgIds": [
                  "PSA.81.16"
                ]
              }
            }
          ]
