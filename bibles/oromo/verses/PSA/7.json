        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.7.6",
                "verseOrgIds": [
                  "PSA.7.7"
                ]
              }
            }
          ]
        },
        {
          "text": "aarii keetiin kaʼi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.6",
            "verseOrgIds": [
              "PSA.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:6"
      },
      "items": [
        {
          "text": "dheekkamsa diinota kootti kaʼi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.6",
            "verseOrgIds": [
              "PSA.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:6"
      },
      "items": [
        {
          "text": "Yaa Waaqa koo anaaf dammaqi; murtii qajeelaa labsi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.6",
            "verseOrgIds": [
              "PSA.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaaʼiin namootaa naannoo keetti walitti haa qabamu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.7",
            "verseOrgIds": [
              "PSA.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:7"
      },
      "items": [
        {
          "text": "atis ol gubbaadhaa isaan bulchi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.7",
            "verseOrgIds": [
              "PSA.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.7.8",
                "verseOrgIds": [
                  "PSA.7.9"
                ]
              }
            }
          ]
        },
        {
          "text": "sabootaaf murtii haa kennu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.8",
            "verseOrgIds": [
              "PSA.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 7:8"
      },
      "items": [
        {
          "text": "Yaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.8",
            "verseOrgIds": [
              "PSA.7.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.7.8",
                "verseOrgIds": [
                  "PSA.7.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", akka qajeelummaa kootiitti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.8",
            "verseOrgIds": [
              "PSA.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:8"
      },
      "items": [
        {
          "text": "akka amanamummaa kootiittis naa murteessi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.8",
            "verseOrgIds": [
              "PSA.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Waaqa qajeelaa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.9",
            "verseOrgIds": [
              "PSA.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:9"
      },
      "items": [
        {
          "text": "kan yaadaa fi garaa namaa qortu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.9",
            "verseOrgIds": [
              "PSA.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 7:9"
      },
      "items": [
        {
          "text": "fincila hamootaa balleessi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.9",
            "verseOrgIds": [
              "PSA.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:9"
      },
      "items": [
        {
          "text": "qajeeltota immoo jabeessii dhaabi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.9",
            "verseOrgIds": [
              "PSA.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaachanni koo Waaqa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.10",
            "verseOrgIds": [
              "PSA.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:10"
      },
      "items": [
        {
          "text": "inni gara toleeyyii ni oolcha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.10",
            "verseOrgIds": [
              "PSA.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni abbaa murtii qajeelaa dha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.11",
            "verseOrgIds": [
              "PSA.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:11"
      },
      "items": [
        {
          "text": "inni Waaqa guyyaa hunda dheekkamsa isaa mulʼisuu dha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.11",
            "verseOrgIds": [
              "PSA.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo namni qalbii jijjiirrachuu baate,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.12",
            "verseOrgIds": [
              "PSA.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:12"
      },
      "items": [
        {
          "text": "inni goraadee isaa ni qarata;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.12",
            "verseOrgIds": [
              "PSA.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:12"
      },
      "items": [
        {
          "text": "iddaa isaas dabsee qopheeffata.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.12",
            "verseOrgIds": [
              "PSA.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni meeshaa nama ajjeesu",
