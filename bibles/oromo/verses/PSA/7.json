        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "Shiigaayoonni",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawit kan inni waaʼee Kuushi namicha gosa Beniyaamiif jedhee",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text"
            }
          ]
        },
        {
          "text": "faarfate.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.1",
            "verseOrgIds": [
              "PSA.7.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.7.1",
                "verseOrgIds": [
                  "PSA.7.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa ko, ani kooluu sitti nan gala;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.1",
            "verseOrgIds": [
              "PSA.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:1"
      },
      "items": [
        {
          "text": "warra na ariʼatan hunda jalaa na baasi; na oolchis;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.1",
            "verseOrgIds": [
              "PSA.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "yoo kanaa achii isaan yeroo namni na oolchu hin jirretti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.2",
            "verseOrgIds": [
              "PSA.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:2"
      },
      "items": [
        {
          "text": "akka leencaa na cicciratu; na kukkutatus.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.2",
            "verseOrgIds": [
              "PSA.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.3",
            "verseOrgIds": [
              "PSA.7.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.7.3",
                "verseOrgIds": [
                  "PSA.7.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa ko, yoo ani waan kana godhee jiraadhe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.3",
            "verseOrgIds": [
              "PSA.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:3"
      },
      "items": [
        {
          "text": "yoo harka koo keessa yakki jiraate,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.3",
            "verseOrgIds": [
              "PSA.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "yoo ani nama nagaadhaan na wajjin jiraatutti hamaa hojjedhee jiraadhe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.4",
            "verseOrgIds": [
              "PSA.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:4"
      },
      "items": [
        {
          "text": "yookaan yoo ani sababii malee diina koo saamee jiraadhe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.4",
            "verseOrgIds": [
              "PSA.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "diinni koo ariʼee na haa qabatu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.5",
            "verseOrgIds": [
              "PSA.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:5"
      },
      "items": [
        {
          "text": "jireenya koo lafatti haa dhidhiitu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.5",
            "verseOrgIds": [
              "PSA.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:5"
      },
      "items": [
        {
          "text": "ulfina koos awwaara keessa haa buusu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.5",
            "verseOrgIds": [
              "PSA.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
