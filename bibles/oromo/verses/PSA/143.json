      "attrs": {
        "style": "q2",
        "vid": "PSA 143:4"
      },
      "items": [
        {
          "text": "onneen koos na keessatti rifatteerti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.4",
            "verseOrgIds": [
              "PSA.143.4"
            ]
          }
        }
