            "sid": "PSA 143:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diinni lubbuu koo ariʼachaa jiraatii;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.3",
            "verseOrgIds": [
              "PSA.143.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:3"
      },
      "items": [
        {
          "text": "jireenya koos butuchee biyyootti make.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.3",
            "verseOrgIds": [
              "PSA.143.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 143:3"
      },
      "items": [
        {
          "text": "Akkuma warra dur duʼaniittis",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.3",
            "verseOrgIds": [
              "PSA.143.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:3"
      },
      "items": [
        {
          "text": "dukkana keessa na jiraachiseera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.3",
            "verseOrgIds": [
              "PSA.143.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
