                "verseOrgIds": [
                  "PSA.143.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", kadhannaa koo naa dhagaʼi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.1",
            "verseOrgIds": [
              "PSA.143.1"
