            "sid": "PSA 143:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati garbicha kee murtiitti hin dhiʼeessin;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.2",
            "verseOrgIds": [
              "PSA.143.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:2"
      },
      "items": [
        {
          "text": "namni lubbuun jiraatu kam iyyuu fuula kee duratti qajeelaa mitiitii.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.2",
            "verseOrgIds": [
              "PSA.143.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
