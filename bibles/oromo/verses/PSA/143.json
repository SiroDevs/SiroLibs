      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:1"
      },
      "items": [
        {
          "text": "gurra kees gara waammata kootiitti deebisi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.1",
            "verseOrgIds": [
              "PSA.143.1"
            ]
          }
