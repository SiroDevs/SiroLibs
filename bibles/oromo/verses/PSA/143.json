          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu hafuurri koo na keessatti gaggabeera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.4",
            "verseOrgIds": [
              "PSA.143.4"
            ]
