          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan sababii malee kiyyoo isaanii dhoksanii",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.7",
            "verseOrgIds": [
              "PSA.35.7"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "na dura kaaʼaniiruutii;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.7",
            "verseOrgIds": [
              "PSA.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:7"
      },
      "items": [
        {
          "text": "sababii malees boolla naa qotaniiru;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.7",
            "verseOrgIds": [
              "PSA.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "utuu inni hin beekin badiisni isatti haa dhufu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.8",
            "verseOrgIds": [
              "PSA.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:8"
      },
      "items": [
        {
          "text": "kiyyoon inni dhokse sunis isuma haa qabu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.8",
            "verseOrgIds": [
              "PSA.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:8"
      },
      "items": [
        {
          "text": "boolluma qote sanattis haa kufu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.8",
            "verseOrgIds": [
              "PSA.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoos lubbuun ko,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.9",
            "verseOrgIds": [
              "PSA.35.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyotti",
              "type": "text",
              "attrs": {
                "verseId": "PSA.35.9",
                "verseOrgIds": [
                  "PSA.35.9"
                ]
              }
            }
          ]
        },
        {
          "text": "gammaddi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.9",
            "verseOrgIds": [
              "PSA.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:9"
      },
      "items": [
        {
          "text": "fayyisuu isaattis ni ililchiti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.9",
            "verseOrgIds": [
              "PSA.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lafeen koo hundi akkana siin jedha:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.10",
            "verseOrgIds": [
              "PSA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:10"
      },
      "items": [
        {
          "text": "\"Yaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.10",
            "verseOrgIds": [
              "PSA.35.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.35.10",
                "verseOrgIds": [
                  "PSA.35.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", kan akka keetii eenyu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.10",
            "verseOrgIds": [
              "PSA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 35:10"
      },
      "items": [
        {
          "text": "Ati dadhabdoota warra isaan caalaa jabaatan jalaa baafta;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.10",
            "verseOrgIds": [
              "PSA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:10"
      },
      "items": [
        {
          "text": "hiyyeeyyii fi rakkattoota illee saamtota jalaa baafta.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.10",
            "verseOrgIds": [
              "PSA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhuga baatonni sobaa natti kaʼan;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.11",
            "verseOrgIds": [
              "PSA.35.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:11"
      },
      "items": [
        {
          "text": "waan ani waaʼee isaa hin beeknes na gaafatu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.11",
            "verseOrgIds": [
              "PSA.35.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan qooda waan gaarii waan hamaa naa deebisu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.12",
            "verseOrgIds": [
              "PSA.35.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:12"
      },
      "items": [
        {
          "text": "lubbuu koos kophaatti hambisu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.12",
            "verseOrgIds": [
              "PSA.35.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
