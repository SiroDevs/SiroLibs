            "number": "6",
            "style": "v",
            "sid": "PSA 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karaan isaanii dukkanaaʼaa fi mucucaataa haa taʼu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.6",
            "verseOrgIds": [
              "PSA.35.6"
            ]
          }
        }
      ]
    },
