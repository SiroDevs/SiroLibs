        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Bulchiinsa Qajeelaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Faarfannaa Daawit.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 101:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani jaalala keetii fi murtii kee qajeelaa sanaaf nan faarfadha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.1",
            "verseOrgIds": [
              "PSA.101.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:1"
      },
      "items": [
        {
          "text": "Yaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.1",
            "verseOrgIds": [
              "PSA.101.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.101.1",
                "verseOrgIds": [
                  "PSA.101.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ani siif nan faarfadha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.1",
            "verseOrgIds": [
              "PSA.101.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 101:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani jireenya hirʼina hin qabne jiraachuuf of nan eeggadha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.2",
            "verseOrgIds": [
              "PSA.101.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:2"
      },
      "items": [
        {
          "text": "ati yoom gara koo dhufta?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.2",
            "verseOrgIds": [
              "PSA.101.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 101:2"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 101:2"
      },
      "items": [
        {
          "text": "Ani garaa qulqulluudhaan,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.2",
            "verseOrgIds": [
              "PSA.101.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:2"
      },
      "items": [
        {
          "text": "mana koo nan jiraadha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.2",
            "verseOrgIds": [
              "PSA.101.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 101:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani ija koo dura,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.3",
            "verseOrgIds": [
              "PSA.101.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:3"
      },
      "items": [
        {
          "text": "waan hamaa hin kaaʼu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.3",
            "verseOrgIds": [
              "PSA.101.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 101:3"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 101:3"
      },
      "items": [
        {
          "text": "Hojii jalʼootaa nan jibba;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.3",
            "verseOrgIds": [
              "PSA.101.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:3"
      },
      "items": [
        {
          "text": "nattis hin qabatu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.3",
            "verseOrgIds": [
              "PSA.101.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 101:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni yaada micciiramaa qaban narraa haa fagaatan;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.4",
            "verseOrgIds": [
              "PSA.101.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:4"
      },
      "items": [
        {
          "text": "ani jalʼina wajjin tokkummaa hin qabaadhu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.4",
            "verseOrgIds": [
              "PSA.101.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 101:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama dhoksaan ollaa isaa hamatu kam iyyuu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.5",
            "verseOrgIds": [
              "PSA.101.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:5"
      },
      "items": [
        {
          "text": "ani afaan nan qabachiisa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.5",
            "verseOrgIds": [
              "PSA.101.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 101:5"
      },
      "items": [
        {
          "text": "nama tuffiin nama ilaaluu fi kan garaa of tuulu qabuuf,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.5",
            "verseOrgIds": [
              "PSA.101.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:5"
      },
      "items": [
        {
          "text": "ani obsa hin qabaadhu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.5",
            "verseOrgIds": [
              "PSA.101.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 101:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka isaan na wajjin jiraataniif,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.6",
            "verseOrgIds": [
              "PSA.101.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:6"
      },
      "items": [
        {
          "text": "iji koo amanamoota biyyattii irra jiraatti;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.6",
            "verseOrgIds": [
              "PSA.101.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:6"
      },
      "items": [
        {
          "text": "namni karaa qajeelaa irra deemu, inni na tajaajila.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.6",
            "verseOrgIds": [
              "PSA.101.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 101:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni nama gowwoomsu tokko iyyuu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.7",
            "verseOrgIds": [
              "PSA.101.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:7"
      },
      "items": [
        {
          "text": "mana koo keessa hin jiraatu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.7",
            "verseOrgIds": [
              "PSA.101.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 101:7"
      },
      "items": [
        {
          "text": "namni soba dubbatu tokko iyyuu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.7",
            "verseOrgIds": [
              "PSA.101.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:7"
      },
      "items": [
        {
          "text": "fuula koo dura hin dhaabatu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.7",
            "verseOrgIds": [
              "PSA.101.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 101:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani jalʼoota biyyattii hunda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.8",
            "verseOrgIds": [
              "PSA.101.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:8"
      },
      "items": [
        {
          "text": "ganama ganama nan barbadeessa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.8",
            "verseOrgIds": [
              "PSA.101.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 101:8"
      },
      "items": [
        {
          "text": "warra waan hamaa hojjetan",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.8",
            "verseOrgIds": [
              "PSA.101.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:8"
      },
      "items": [
        {
          "text": "magaalaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.8",
            "verseOrgIds": [
              "PSA.101.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.101.8",
                "verseOrgIds": [
                  "PSA.101.8"
                ]
              }
            }
          ]
        },
        {
          "text": "keessaa nan balleessa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.8",
            "verseOrgIds": [
              "PSA.101.8"
            ]
          }
        }
      ]
