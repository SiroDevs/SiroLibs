      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:2"
      },
      "items": [
        {
          "text": "eebbifamaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.2",
            "verseOrgIds": [
              "PSA.32.2"
            ]
          }
        }
      ]
    },
    {
