          "text": "cubbuu itti hin lakkoofne,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.2",
            "verseOrgIds": [
              "PSA.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:2"
      },
      "items": [
        {
          "text": "kan hafuura isaa keessas gowwoomsaan hin jirre,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.2",
            "verseOrgIds": [
              "PSA.32.2"
            ]
          }
        }
