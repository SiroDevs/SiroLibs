          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harki kee halkanii fi guyyaa natti ulfaateeraatii;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.4",
            "verseOrgIds": [
              "PSA.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:4"
      },
      "items": [
        {
          "text": "jabinni koos akkuma waan hoʼa bonaatiin taʼuutti xuuxame.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.4",
            "verseOrgIds": [
              "PSA.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis cubbuu koo sitti nan himadhe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.5",
            "verseOrgIds": [
              "PSA.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:5"
      },
      "items": [
        {
          "text": "balleessaa koos si hin dhokfanne.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.5",
            "verseOrgIds": [
              "PSA.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 32:5"
      },
      "items": [
        {
          "text": "Anis, \"Irra daddarba koo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.5",
            "verseOrgIds": [
              "PSA.32.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootti",
              "type": "text",
              "attrs": {
                "verseId": "PSA.32.5",
                "verseOrgIds": [
                  "PSA.32.5"
                ]
              }
            }
          ]
        },
        {
          "text": "nan himadha\" nan jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.5",
            "verseOrgIds": [
              "PSA.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:5"
      },
      "items": [
        {
          "text": "atis yakka cubbuu kootii, naa dhiifteerta.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.5",
            "verseOrgIds": [
              "PSA.32.5"
            ]
          }
        }
      ]
    },
