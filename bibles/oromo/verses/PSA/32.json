      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:1"
      },
      "items": [
        {
          "text": "kan cubbuun isaas haguugameef,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.1",
            "verseOrgIds": [
              "PSA.32.1"
            ]
          }
        }
