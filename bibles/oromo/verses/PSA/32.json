      "items": [
        {
          "text": "isaan yoo luugamaa fi fuuloodhaan qabaman malee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.9",
            "verseOrgIds": [
              "PSA.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:9"
      },
      "items": [
        {
          "text": "gara kee hin dhufan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.9",
            "verseOrgIds": [
              "PSA.32.9"
            ]
          }
        }
      ]
    },
