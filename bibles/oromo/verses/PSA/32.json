          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo ani cubbuu koo himachuu dhiisetti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.3",
            "verseOrgIds": [
              "PSA.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:3"
      },
      "items": [
        {
          "text": "guyyaa guutuu aaduu kootiin,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.3",
            "verseOrgIds": [
              "PSA.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:3"
      },
      "items": [
        {
          "text": "lafeen koo ni bosose.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.3",
            "verseOrgIds": [
              "PSA.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
