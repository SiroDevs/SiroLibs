          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.32.2",
                "verseOrgIds": [
                  "PSA.32.2"
                ]
              }
            }
          ]
        },
