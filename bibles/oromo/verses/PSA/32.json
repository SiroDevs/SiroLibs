      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:8"
      },
      "items": [
        {
          "text": "ani ija koo jaalalaatiin sin ilaala; sin gorsa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.8",
            "verseOrgIds": [
              "PSA.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
