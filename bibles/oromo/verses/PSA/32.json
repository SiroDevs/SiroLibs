          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhiphinni namoota hamoo baayʼee dha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.10",
            "verseOrgIds": [
              "PSA.32.10"
            ]
          }
        }
