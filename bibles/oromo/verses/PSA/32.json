      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 32:7"
      },
      "items": [
        {
          "text": "faarfannaa moʼannaatiinis na marsita.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.7",
            "verseOrgIds": [
              "PSA.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
