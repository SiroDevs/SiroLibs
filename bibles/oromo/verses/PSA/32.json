          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani karaa ati irra deemtu irratti sin qajeelcha; sin barsiisas;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.32.8",
            "verseOrgIds": [
              "PSA.32.8"
            ]
          }
        }
      ]
    },
