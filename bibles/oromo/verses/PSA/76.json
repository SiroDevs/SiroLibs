  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "76",
        "style": "c",
        "sid": "PSA 76"
      },
      "items": [
        {
          "text": "76",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Faarfannaa 76",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Faarfannaa Waaqa Sodaatamuu Qabuuf Faarfatame",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Dura Buʼaa Faarfattootaatiif. Miʼa Ribuutiin. Faarfannaa Asaaf.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 76:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yihuudaa keessatti Waaqni beekamaa dha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.1",
            "verseOrgIds": [
              "PSA.76.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:1"
      },
      "items": [
        {
          "text": "maqaan isaas Israaʼel keessatti guddaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.1",
            "verseOrgIds": [
              "PSA.76.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 76:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dunkaanni isaa Saalem keessa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.2",
            "verseOrgIds": [
              "PSA.76.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:2"
      },
      "items": [
        {
          "text": "iddoon jireenya isaa Xiyoon keessa jira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.2",
            "verseOrgIds": [
              "PSA.76.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 76:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis achitti xiyya bobaʼuu fi gaachana, goraadee fi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.3",
            "verseOrgIds": [
              "PSA.76.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:3"
      },
      "items": [
        {
          "text": "meeshaawwan waraanaa caccabse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.3",
            "verseOrgIds": [
              "PSA.76.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 76:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati ifa uffattee miidhagdeerta;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.4",
            "verseOrgIds": [
              "PSA.76.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:4"
      },
      "items": [
        {
          "text": "ati tulluuwwan bara baraa caalaa Surra qabeessa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.4",
            "verseOrgIds": [
              "PSA.76.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 76:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gootonni boojiʼamaniiru;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.5",
            "verseOrgIds": [
              "PSA.76.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:5"
      },
      "items": [
        {
          "text": "hirribaanis fudhatamaniiru;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.5",
            "verseOrgIds": [
              "PSA.76.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 76:5"
      },
      "items": [
        {
          "text": "duultota keessaas namni tokko iyyuu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.5",
            "verseOrgIds": [
              "PSA.76.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:5"
      },
      "items": [
        {
          "text": "harka sochoofachuu hin dandeenye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.5",
            "verseOrgIds": [
              "PSA.76.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 76:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Waaqa Yaaqoob, ifannaa keetiin fardeenii",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.6",
            "verseOrgIds": [
              "PSA.76.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:6"
      },
      "items": [
        {
          "text": "fi warri fardeen yaabbatan of wallaalaniiru.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.6",
            "verseOrgIds": [
              "PSA.76.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 76:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siʼi qofatu sodaatamuu qaba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.7",
            "verseOrgIds": [
              "PSA.76.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:7"
      },
      "items": [
        {
          "text": "Yommuu ati aartu eenyutu fuula kee dura dhaabachuu dandaʼaa?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.7",
            "verseOrgIds": [
              "PSA.76.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 76:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati samii irraa murtii kennite;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.8",
            "verseOrgIds": [
              "PSA.76.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:8"
      },
      "items": [
        {
          "text": "laftis ni sodaatte; ni calʼiftes;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.8",
            "verseOrgIds": [
              "PSA.76.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 76:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaa Waaqi, wanni kunis yommuu ati murtii kennuudhaaf,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.9",
            "verseOrgIds": [
              "PSA.76.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:9"
      },
      "items": [
        {
          "text": "rakkattoota biyyattii fayyisuuf kaatetti taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.9",
            "verseOrgIds": [
              "PSA.76.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 76:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dheekkamsi ati namatti dheekkamtu dhugumaan ulfina siif fida;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.10",
            "verseOrgIds": [
              "PSA.76.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:10"
      },
      "items": [
        {
          "text": "warra dheekkamsa kee irraa hafanis ni hidhatta.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.10",
            "verseOrgIds": [
              "PSA.76.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 76:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.76.11",
                "verseOrgIds": [
                  "PSA.76.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keessaniif wareegaa; wareegichas guuttadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.11",
            "verseOrgIds": [
              "PSA.76.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:11"
      },
      "items": [
        {
          "text": "warri naannoo isaa jiraatan hundinuus",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.11",
            "verseOrgIds": [
              "PSA.76.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:11"
      },
      "items": [
        {
          "text": "Waaqa sodaatamuu qabu sanaaf kennaawwan haa fidan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.11",
            "verseOrgIds": [
              "PSA.76.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 76:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni hafuura bulchitootaa ni cabsa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.12",
            "verseOrgIds": [
              "PSA.76.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:12"
      },
      "items": [
        {
          "text": "mootonni lafaas isa sodaatu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.12",
            "verseOrgIds": [
              "PSA.76.13"
            ]
          }
        }
      ]
    }
  ],
