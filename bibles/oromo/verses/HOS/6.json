      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:10"
      },
      "items": [
        {
          "text": "Israaʼelis ni xuraaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.10",
            "verseOrgIds": [
              "HOS.6.10"
            ]
          }
        }
      ]
    },
