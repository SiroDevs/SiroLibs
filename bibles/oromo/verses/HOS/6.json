          "text": "Kottaa",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.3",
            "verseOrgIds": [
              "HOS.6.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "HOS.6.3",
                "verseOrgIds": [
                  "HOS.6.3"
                ]
              }
            }
          ]
        },
        {
          "text": "haa beeknu;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.3",
            "verseOrgIds": [
              "HOS.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:3"
      },
      "items": [
        {
          "text": "isa beekuufis haa tattaaffannu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.3",
            "verseOrgIds": [
              "HOS.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 6:3"
      },
      "items": [
        {
          "text": "Akkuma aduun dhugumaan baatu sana",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.3",
            "verseOrgIds": [
              "HOS.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:3"
      },
      "items": [
        {
          "text": "inni dhugumaan ni dhufa;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.3",
            "verseOrgIds": [
              "HOS.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 6:3"
      },
      "items": [
        {
          "text": "inni akkuma bokkaa gannaa,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.3",
            "verseOrgIds": [
              "HOS.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 6:3"
      },
      "items": [
        {
          "text": "akkuma bokkaa birraa kan lafa quubsu sanaatti",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.3",
            "verseOrgIds": [
              "HOS.6.3"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "gara keenya ni dhufa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.3",
            "verseOrgIds": [
              "HOS.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
