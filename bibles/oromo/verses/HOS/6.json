                "verseId": "HOS.6.1",
                "verseOrgIds": [
                  "HOS.6.1"
                ]
              }
            }
          ]
        },
        {
          "text": "deebinaa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.1",
            "verseOrgIds": [
              "HOS.6.1"
            ]
          }
        }
