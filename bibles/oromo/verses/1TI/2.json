        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Qajeelcha Waaʼee Waaqeffannaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TI 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egaa ani akka waammachuun, kadhannaan, namaaf kadhachuu fi galanni maqaa nama hundaatiin dhiʼeeffamu duraan dursee nan gorsa;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.1",
            "verseOrgIds": [
              "1TI.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nus akka Waaqa sodaachuu hundumaan, ulfinaanis jireenya nagaatii fi tasgabbiin jiraannuuf moototaa fi warra taayitaa qaban hundumaafis akkasuma haa godhamu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.2",
            "verseOrgIds": [
              "1TI.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TI 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunis gaarii dha; fuula Fayyisaa keenya Waaqaa durattis fudhatamaa dha;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.3",
            "verseOrgIds": [
              "1TI.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni akka namni hundinuu fayyuu fi akka dhugaa beekuu biras gaʼu barbaada.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.4",
            "verseOrgIds": [
              "1TI.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni tokkicha; Waaqaa fi nama gidduu immoo gidduu galeessa tokkotu jira; innis Kiristoos Yesuus isa nama taʼee dha;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.5",
            "verseOrgIds": [
              "1TI.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TI 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus kunis isa furii taʼee nama hundaaf dabarsee of kennee dha; kunis yeroo isaatti mirkaneeffameera.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.6",
            "verseOrgIds": [
              "1TI.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii kanaaf ani lallabaa fi ergamaa, Namoota Ormaatiif immoo barsiisaa amantii dhugaa taʼee muudameen jira. Ani dhugaa dubbadha; hin sobu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.7",
            "verseOrgIds": [
              "1TI.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TI 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu ani akka dhiironni iddoo hundatti dheekkamsaa fi wal mormii malee harka qulqullaaʼaa ol fudhatanii kadhatan nan barbaada.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.8",
            "verseOrgIds": [
              "1TI.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasumas dubartoonni akka hin malletti mataa dhaʼachuun, warqee yookaan lula naqachuun yookaan uffata gatii guddaa uffachuun utuu hin taʼin akka of qabuu fi naamusaaf taʼutti uffatanii akka of miidhagsan nan barbaada;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.9",
            "verseOrgIds": [
              "1TI.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "isaanis akkuma dubartoota, \"Nu Waaqa sodaanna\" jedhaniitti waan gaarii haa hojjetan.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.10",
            "verseOrgIds": [
              "1TI.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubartiin waan hundaan ajajamuun calʼistee haa barattu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.11",
            "verseOrgIds": [
              "1TI.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TI 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani akka dubartiin calʼistu malee akka barsiiftu yookaan akka dhiira irratti taayitaa qabaattu hin eeyyamu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.12",
            "verseOrgIds": [
              "1TI.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababiin isaas Addaam jalqabatti uumame; Hewaan immoo ergasii uumamte.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.13",
            "verseOrgIds": [
              "1TI.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TI 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Addaam hin gowwoomfamne; dubartittiin garuu gowwoomfamtee seera cabsite.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.14",
            "verseOrgIds": [
              "1TI.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus dubartoonni yoo amantiin, jaalalaa fi qulqullinaan, naamusaan jiraatan ijoollee daʼuudhaan ni fayyu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.15",
            "verseOrgIds": [
              "1TI.2.15"
            ]
          }
        }
      ]
    }
  ],
