  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "2TI 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "po"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2TI 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phaawulos isa akkuma waadaa jireenya karaa Kiristoos Yesuusiin galame sanaatti fedhii Waaqaatiin ergamaa Kiristoos Yesuus taʼe irraa,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "po"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gara Xiimotewos, ilma koo jaallatamaatti:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "po",
        "vid": "2TI 1:2"
      },
      "items": [
        {
          "text": "Abbaa keenya Waaqaa fi Gooftaa keenya Kiristoos Yesuus irraa ayyaanni, araarrii fi nagaan siif haa taʼu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Galateeffachuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TI 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani yommuu utuu gargar hin kutin halkanii guyyaa kadhannaa koo keessatti si yaadadhutti Waaqa akkuma abbootii kootii anis yaada qulqulluun isa waaqeffadhu sana nan galateeffadha.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.3",
            "verseOrgIds": [
              "2TI.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TI 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani yommuun imimmaan kee yaadadhutti akka gammachuudhaan guutamuuf guddisee si arguu nan hawwa.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.4",
            "verseOrgIds": [
              "2TI.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TI 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani amantii kee isa dhugaa sana nan yaadadha; amantiin kunis jalqabatti akkoo kee Looʼisii fi haadha kee Ewuunqee keessa ture; amma immoo akka si keessa jiru nan amana.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.5",
            "verseOrgIds": [
              "2TI.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akka Phaawulosii fi Wangeelaaf Of Kennaniif Sossobachuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TI 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii kanaaf ani akka ati kennaa Waaqaa kan yeroo ani harka koo sirra kaaʼetti siif kenname sana akka ibiddaatti akka qabsiiftuuf sin yaadachiisa.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.6",
            "verseOrgIds": [
              "2TI.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TI 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni hafuura humnaa, kan jaalalaatii fi kan of dhowwuu nuu kenne malee hafuura sodaa nuuf hin kennineetii.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.7",
            "verseOrgIds": [
              "2TI.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TI 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu waaʼee Gooftaa keenyaa dhugaa baʼuutti yookaan ana nama isaaf jedhee hidhametti hin qaanaʼin. Wangeelaaf dhiphachuu keessatti garuu humna Waaqaatiin na wajjin hirmaadhu;",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.8",
            "verseOrgIds": [
              "2TI.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TI 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni sababii kaayyoo isaatii fi sababii ayyaana isaatiif nu fayyisee gara jireenya qulqulluutti nu waame malee sababii hojii nu hojjenne kamiif iyyuu miti. Ayyaanni kunis uumama addunyaatiin dura karaa Kiristoos Yesuusiin nuu kenname;",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.9",
            "verseOrgIds": [
              "2TI.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TI 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "amma garuu ayyaanni sun dhufaatii Fayyisaa keenya Kiristoos Yesuus isa karaa wangeelaatiin duʼa balleessee jireenyaa fi badiisa ooluu ifatti baase sanaatiin mulʼifameera.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.10",
            "verseOrgIds": [
              "2TI.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TI 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis wangeela kanaaf lallabaa, ergamaa fi barsiisaa taʼee muudameera.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.11",
            "verseOrgIds": [
              "2TI.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TI 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis akka amma jiru kanatti dhiphachuun koo kanumaaf. Ani garuu eenyun akka amane waan beekuuf hin qaanaʼu; akka inni waan ani imaanaa itti kennadhe hamma guyyaa sanaatti eeguu dandaʼus nan amana.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.12",
            "verseOrgIds": [
              "2TI.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2TI 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan narraa dhageesse sana akka fakkeenya barsiisa dhugaatti amantii fi jaalala Kiristoos Yesuusiin qabdu jabeessii qabadhu.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.13",
            "verseOrgIds": [
              "2TI.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2TI 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan gaarii imaanaa sitti kenname sana gargaarsa Hafuura Qulqulluu nu keessa jiraatu sanaatiin eegi.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.14",
            "verseOrgIds": [
              "2TI.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fakkeenya Of Kennuu Dhabuu fi Of Kennuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TI 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni biyya Asiyaa keessa jiraatan hundinuu akka narraa gara galan ni beekta; Fiigeloosii fi Hermoogenees isaan keessa jiru.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.15",
            "verseOrgIds": [
              "2TI.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TI 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oneesifooros yeroo baayʼee waan na boqochiiseef Gooftaan warra mana isaa jiraataniif araara haa buusu; inni hidhamuu kootti illee hin qaanofneetii.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.16",
            "verseOrgIds": [
              "2TI.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TI 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasumas inni yeroo Roomaa dhufetti hamma na argutti dhimmee na barbaadaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.17",
            "verseOrgIds": [
              "2TI.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2TI 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka inni guyyaa sanatti Gooftaa irraa araara argatuuf fedhii Gooftaa haa taʼu! Inni Efesoon keessatti karaa baayʼeen akka na tajaajile ati iyyuu sirriitti beekta.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.18",
            "verseOrgIds": [
              "2TI.1.18"
            ]
          }
        }
      ]
    }
  ],
