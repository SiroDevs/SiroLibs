          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Abbaan inni na erges ofii isaatii waaʼee koo dhugaa baʼeera. Isin takkumaa sagalee isaa hin dhageenye; bifa isaas takkumaa hin argine.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.37",
                "verseOrgIds": [
                  "JHN.5.37"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.37",
            "verseOrgIds": [
              "JHN.5.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 5:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Isin sababii isa inni erge hin amaniniif dubbiin isaa isin keessa hin jiraatu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.38",
                "verseOrgIds": [
                  "JHN.5.38"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.38",
            "verseOrgIds": [
              "JHN.5.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 5:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Isin Katabbiiwwan Qulqulluudhaan jireenya bara baraa arganna jettanii waan yaaddaniif Katabbiiwwan Qulqulluu sana qorattu. Katabbiiwwan Qulqulluun kunneenis waaʼee koo dhugaa baʼu;",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.39",
                "verseOrgIds": [
                  "JHN.5.39"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.39",
            "verseOrgIds": [
              "JHN.5.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 5:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "isin garuu jireenya argachuudhaaf gara koo dhufuu hin barbaaddan.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.40",
                "verseOrgIds": [
                  "JHN.5.40"
                ]
              }
            }
          ]
        }
