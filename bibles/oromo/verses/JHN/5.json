              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ani maqaa Abbaa kootiin dhufeera; isin na hin simattan; utuu namni biraa maqaa ofii isaatiin dhufee garuu isa ni simattu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.43",
