        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "garuu akka isin jaalala Waaqaa of keessaa hin qabne nan beeka.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.42",
                "verseOrgIds": [
