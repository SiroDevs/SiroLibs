        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Isin yoo wal irraa ulfina argattanii ulfina Waaqa tokkicha biraa dhufu garuu hin barbaanne akkamitti amanuu dandeessu ree?",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.44",
