        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Garuu kan waaʼee koo dhugaa baʼu biraa jira; anis akka dhuga baʼumsi inni waaʼee koo kennu sun dhugaa taʼe beeka.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.32",
                "verseOrgIds": [
                  "JHN.5.32"
                ]
              }
            }
          ]
