        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ani dhuga baʼumsa namaa hin fudhadhu; garuu akka isin fayyitaniif wantoota kanneen nan dubbadha.",
