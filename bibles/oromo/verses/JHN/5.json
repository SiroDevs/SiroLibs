        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Warri waan gaarii hojjetan duʼaa kaʼuu jireenyaatiif, warri waan hamaa hojjetan immoo duʼaa kaʼuu murtiitiif duʼaa ni kaʼu.",
              "type": "text",
