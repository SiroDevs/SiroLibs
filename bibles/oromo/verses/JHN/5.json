        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yohannis ibsaa bobaʼee ifa kennu ture; isinis yeroo xinnoo ifa isaatti gammaduu barbaaddan.",
