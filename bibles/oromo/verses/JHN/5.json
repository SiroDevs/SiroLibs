        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Waan ani Abbaa duratti isin himadhu hin seʼinaa. Kan isin himatu tokko jira; innis Musee isin abdattan sana.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.45",
                "verseOrgIds": [
                  "JHN.5.45"
                ]
              }
            }
