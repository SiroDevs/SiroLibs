        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ani ofii kootiin waan tokko illee gochuu hin dandaʼu; ani akkuman dhagaʼutti nan murteessa; ani fedhii isa na ergee malee fedhii mataa kootii waan hin barbaanneef murtiin koo qajeelaa dha.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.30",
