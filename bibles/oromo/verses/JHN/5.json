        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ani yoon waaʼee ofii kootii dhugaa baʼe, dhuga baʼumsi koo dhugaa miti.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.31",
                "verseOrgIds": [
                  "JHN.5.31"
                ]
              }
            }
