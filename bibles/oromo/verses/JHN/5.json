        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kana hin dinqisiifatinaa; saʼaatiin itti warri awwaala keessa jiran hundi sagalee isaa dhagaʼan tokko ni dhufaatii.",
