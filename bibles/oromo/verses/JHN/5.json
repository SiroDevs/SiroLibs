          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Isin Yohannisitti ergitaniirtu; innis dhugaa sanaaf, dhugaa baʼeera.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.33",
                "verseOrgIds": [
