      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ani akka isin hin gufanneef jedhee wantoota kanneen isinitti himeera.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.1",
                "verseOrgIds": [
                  "JHN.16.1"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.1",
            "verseOrgIds": [
              "JHN.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Isaan mana sagadaa keessaa isin ariʼu; dhugumaan yeroon itti namni isin ajjeesu kam iyyuu akka waan Waaqa tajaajiluutti yaadu tokko ni dhufa.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.2",
                "verseOrgIds": [
                  "JHN.16.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.2",
            "verseOrgIds": [
              "JHN.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Isaanis waan Abbaa yookaan na hin beekiniif wantoota kanneen godhu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.3",
                "verseOrgIds": [
                  "JHN.16.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.3",
            "verseOrgIds": [
              "JHN.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Anis akka isin yommuu yeroon sun gaʼutti isaan yaadattaniif wantoota kanneen isinitti himeera. Ani waanan isin wajjin tureef jalqabatti wantoota kanneen isinitti hin himne.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.4",
                "verseOrgIds": [
                  "JHN.16.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hojii Hafuura Qulqulluu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Amma garuu ani gara isa na ergee nan dhaqa; taʼus isin keessaa namni, 'Ati eessa dhaqxa?' jedhee na gaafatu tokko iyyuu hin jiru.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.5",
                "verseOrgIds": [
                  "JHN.16.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.5",
            "verseOrgIds": [
              "JHN.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Garuu waan ani wantoota kanneen isinitti himeef garaan keessan gaddaan guutameera.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.6",
                "verseOrgIds": [
                  "JHN.16.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.6",
            "verseOrgIds": [
              "JHN.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ani garuu dhuguman isinitti hima; deemuun koo buʼaa isiniif qaba; yoo ani deeme malee Jajjabeessaan sun gara keessan hin dhufu; ani yoon deeme garuu isa isiniif nan erga.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.7",
                "verseOrgIds": [
                  "JHN.16.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.7",
            "verseOrgIds": [
              "JHN.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Innis yommuu dhufutti akka addunyaan waaʼee cubbuu, waaʼee qajeelummaatii fi waaʼee murtii dogoggoree jiru mirkaneessa;",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.8",
                "verseOrgIds": [
                  "JHN.16.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.8",
            "verseOrgIds": [
              "JHN.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "waaʼee cubbuu, sababii namoonni natti hin amanneef;",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.9",
                "verseOrgIds": [
                  "JHN.16.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.9",
            "verseOrgIds": [
              "JHN.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "waaʼee qajeelummaa, sababii ani gara Abbaa dhaquu fi sababii isinis siʼachi na hin argineef;",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.10",
                "verseOrgIds": [
                  "JHN.16.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.10",
            "verseOrgIds": [
              "JHN.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "waaʼee murtii immoo sababii bulchaa addunyaa kanaatti murameef.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.11",
                "verseOrgIds": [
                  "JHN.16.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ani amma iyyuu waanan isinitti himu baayʼee qaba; isin garuu amma baachuu hin dandeessan.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.12",
                "verseOrgIds": [
                  "JHN.16.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.12",
            "verseOrgIds": [
              "JHN.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Hafuurri dhugaa sun yommuu dhufutti gara dhugaa hundaatti isin geessa. Inni waan dhagaʼu qofa dubbata malee ofuma isaatiin hin dubbatu; waan dhufuuf jirus isinitti hima.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.13",
                "verseOrgIds": [
                  "JHN.16.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.13",
            "verseOrgIds": [
              "JHN.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Inni sababii waanuma koo fuudhee isinitti beeksisuuf ulfina naa kenna.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.14",
                "verseOrgIds": [
                  "JHN.16.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.14",
            "verseOrgIds": [
              "JHN.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Wanni Abbaan qabu hundinuu kan koo ti. Inni waanuma koo fuudhee isinitti beeksisa jechuun koos kanumaaf.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.15",
                "verseOrgIds": [
                  "JHN.16.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Isin yeroo muraasa booddee na hin argitan; yeroo muraasa booddee immoo deebitanii na argitu.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.16",
                "verseOrgIds": [
                  "JHN.16.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gaddi Barattootaa Gammachuutti Ni Geeddarama",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barattoota isaa keessaas tokko tokko, \"Inni,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.17",
            "verseOrgIds": [
              "JHN.16.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "'Isin yeroo muraasaaf na hin argitan; yeroo muraasaaf immoo deebitanii na argitu'",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.17",
                "verseOrgIds": [
                  "JHN.16.17"
                ]
              }
            }
          ]
        },
        {
          "text": "akkanumas",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.17",
            "verseOrgIds": [
              "JHN.16.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "'Ani waanan gara Abbaa dhaquuf'",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.17",
                "verseOrgIds": [
                  "JHN.16.17"
                ]
              }
            }
          ]
        },
        {
          "text": "nuun jechuun isaa maal jechuu isaa ti?\" waliin jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.17",
            "verseOrgIds": [
              "JHN.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis, \"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.18",
            "verseOrgIds": [
              "JHN.16.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "'Yeroo muraasaaf'",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.18",
                "verseOrgIds": [
                  "JHN.16.18"
                ]
              }
            }
          ]
        },
        {
          "text": "jechuun isaa maal jechuu isaa ti? Maal jechuu isaa akka taʼe nu hin beeknu\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.18",
            "verseOrgIds": [
              "JHN.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus immoo akka isaan isa gaafachuu barbaadan beekee akkana jedheen;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.19",
            "verseOrgIds": [
              "JHN.16.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Wanni ani, 'Isin yeroo muraasaaf na hin argitan; yeroo muraasaaf immoo deebitanii na argitu' jedhe sun maal jechuu koo akka taʼe wal gaafachaa jirtuu?",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.19",
                "verseOrgIds": [
                  "JHN.16.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.19",
            "verseOrgIds": [
              "JHN.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ani dhuguman, dhuguman isinitti hima; isin ni boossu; ni gadittus. Addunyaan garuu ni gammada. Isin ni gadditu; gaddi keessan garuu gammachuutti ni geeddarama.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.20",
                "verseOrgIds": [
                  "JHN.16.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.20",
            "verseOrgIds": [
              "JHN.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Dubartiin yommuu ciniinsifattu, waan yeroon ishee gaʼeef ni gadditi; erga daaʼima deessee booddee garuu waan addunyaa irratti namni dhalateef, isheenis waan gammadduuf dhiphina sana hin yaadattu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.21",
                "verseOrgIds": [
                  "JHN.16.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.21",
            "verseOrgIds": [
              "JHN.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Isinis akkasuma amma gadditaniirtu; ani garuu deebiʼeen isin ilaala; garaan keessanis ni gammada. Gammachuu keessanis eenyu iyyuu isin irraa hin fudhatu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.22",
                "verseOrgIds": [
                  "JHN.16.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.22",
            "verseOrgIds": [
              "JHN.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gaafas isin homaa na hin kadhattan. Ani dhuguman, dhuguman isinitti hima; Abbaan waan isin maqaa kootiin kadhattan kam iyyuu isinii kenna.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.23",
                "verseOrgIds": [
                  "JHN.16.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.23",
            "verseOrgIds": [
              "JHN.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Isin hamma ammaatti maqaa kootiin homaa hin kadhanne. Akka gammachuun keessan guutuu taʼuuf kadhadhaa ni argattu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.24",
                "verseOrgIds": [
                  "JHN.16.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ani wantoota kanneen fakkeenyaan isinitti himeera; garuu yeroon ani deebiʼee fakkeenyaan isinitti hin dubbanne ni dhufa; yommus ani waaʼee Abbaa koo ifaan ifatti isinittin hima.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.25",
                "verseOrgIds": [
                  "JHN.16.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.25",
            "verseOrgIds": [
              "JHN.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Isin gaafas maqaa kootiin ni kadhattu. Ani Abbaa isiniif nan kadhadha isiniin hin jedhu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.26",
                "verseOrgIds": [
                  "JHN.16.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.26",
            "verseOrgIds": [
              "JHN.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Isin waan na jaallattaniif, Waaqa biraa baʼuu koo waan amantaniif Abbaan mataan isaa isin jaallata.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.27",
                "verseOrgIds": [
                  "JHN.16.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.27",
            "verseOrgIds": [
              "JHN.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ani Abbaa biraa baʼee gara addunyaa dhufeera; ammas addunyaa dhiisee gara Abbaa nan dhaqa.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.28",
                "verseOrgIds": [
                  "JHN.16.28"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barattoonni isaas akkana jedhan; \"Kunoo, ati amma iyyuu fakkeenyaan utuu hin taʼin ifaan ifatti dubbachaa jirta.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.29",
            "verseOrgIds": [
              "JHN.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka ati waan hunda beektuu fi akka namni tokko iyyuu gaaffii si gaafachuu hin barbaachifne nu amma ni beekna. Kanaanis nu akka ati Waaqa biraa baate ni amanna.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.30",
            "verseOrgIds": [
              "JHN.16.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis deebisee akkana jedheen;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.31",
            "verseOrgIds": [
              "JHN.16.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Isin amma ni amantuu?",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.31",
                "verseOrgIds": [
                  "JHN.16.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.31",
            "verseOrgIds": [
              "JHN.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kunoo yeroon isin itti kophaatti na dhiiftanii tokkoon tokkoon keessan gara feetanitti bittinnooftan tokko ni dhufa. Ammuma iyyuu dhufeera. Garuu waan Abbaan koo na wajjin jiruuf ani kophaa koo miti.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.32",
                "verseOrgIds": [
                  "JHN.16.32"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Akka isin anaan nagaa qabaattaniif ani wantoota kanneen isinitti himeera. Addunyaa kana irratti rakkinni isin argata. Garuu jabaadhaa! Ani addunyaa moʼadheeraa.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.16.33",
                "verseOrgIds": [
                  "JHN.16.33"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
