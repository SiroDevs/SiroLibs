              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus immoo akkana jedheen;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.50",
            "verseOrgIds": [
              "JHN.1.50"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ati sababii ani muka harbuu jalattan si arge siin jedheef amantee? Waan kana caalu iyyuu arguuf jirta.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.1.50",
                "verseOrgIds": [
                  "JHN.1.50"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
