    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa itti aanutti Yohannis ammas barattoota isaa keessaa lama wajjin achi ture.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.35",
            "verseOrgIds": [
              "JHN.1.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis utuu Yesuus achi irra darbuu argee, \"Ilaa, Hoolaa Waaqaa!\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.36",
            "verseOrgIds": [
              "JHN.1.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 1:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barattoonni lamaanis waan kana dubbachuu isaa dhagaʼanii Yesuus duukaa buʼan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.37",
            "verseOrgIds": [
              "JHN.1.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis of irra garagalee isa duukaa buʼuu isaanii argee,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.38",
            "verseOrgIds": [
              "JHN.1.38"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Isin maal barbaaddu?\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.1.38",
                "verseOrgIds": [
                  "JHN.1.38"
                ]
              }
            }
          ]
        },
        {
          "text": "jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.38",
            "verseOrgIds": [
              "JHN.1.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 1:38"
      },
      "items": [
        {
          "text": "Isaanis, \"Rabbii, ati eessa jiraatta?\" jedhaniin. Rabbii jechuun Barsiisaa jechuu dha.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.38",
            "verseOrgIds": [
              "JHN.1.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 1:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.39",
            "verseOrgIds": [
              "JHN.1.39"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kottaatii ilaalaa\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.1.39",
                "verseOrgIds": [
                  "JHN.1.39"
                ]
              }
            }
          ]
        },
        {
          "text": "jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.39",
            "verseOrgIds": [
              "JHN.1.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 1:39"
      },
      "items": [
        {
          "text": "Isaanis dhaqanii akka inni eessa jiraatu argan; gaafa sana isa wajjin oolan. Yeroon sunis gara saʼaatii kurnaffaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.39",
            "verseOrgIds": [
              "JHN.1.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warra waan Yohannis dubbate dhagaʼanii Yesuus duukaa buʼan lamaan keessaa inni tokko Indiriiyaas obboleessa Simoon Phexros ture.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.40",
            "verseOrgIds": [
              "JHN.1.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis duraan dursee obboleessa isaa Simoonin argatee, \"Nu Masiihicha arganneerra\" jedheen; Masiihii jechuun Kiristoos jechuu dha.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.41",
            "verseOrgIds": [
              "JHN.1.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indiriiyaasis Simʼoonin gara Yesuusitti fide.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.42",
            "verseOrgIds": [
              "JHN.1.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 1:42"
      },
      "items": [
        {
          "text": "Yesuusis isa ilaalee,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.42",
            "verseOrgIds": [
              "JHN.1.42"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ati Simoon ilma Yohannis, Keefaa jedhamtee ni waamamta\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.1.42",
                "verseOrgIds": [
                  "JHN.1.42"
                ]
              }
            }
          ]
        },
        {
          "text": "jedheen. Keefaa jechuun Phexros jechuu dha.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.42",
            "verseOrgIds": [
              "JHN.1.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesuus Fiiliphoosii fi Naatnaaʼelin Waamuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 1:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis guyyaa itti aanutti Galiilaa dhaquu barbaade. Innis Fiiliphoosin argee,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.43",
            "verseOrgIds": [
              "JHN.1.43"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Na duukaa buʼi\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.1.43",
                "verseOrgIds": [
                  "JHN.1.43"
                ]
              }
            }
          ]
        },
        {
          "text": "jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.43",
            "verseOrgIds": [
              "JHN.1.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fiiliphoosis akkuma Indiriiyaasii fi Phexros nama magaalaa Beetisayidaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.44",
            "verseOrgIds": [
              "JHN.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fiiliphoos Naatnaaʼelin argee, \"Isa Museen kitaaba Seeraa keessatti waaʼee isaa barreessee fi isa raajonnis waaʼee isaa barreessan, ilma Yoosef, Yesuus nama Naazreeti arganneerra\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.45",
            "verseOrgIds": [
              "JHN.1.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 1:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naatnaaʼelis, \"Naazreeti keessaa wanni gaariin baʼuu ni dandaʼaa?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.46",
            "verseOrgIds": [
              "JHN.1.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 1:46"
      },
      "items": [
        {
          "text": "Fiiliphoosis, \"Kottuutii ilaali\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.46",
            "verseOrgIds": [
              "JHN.1.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 1:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis utuu Naatnaaʼel gara isaa dhufuu argee,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.47",
            "verseOrgIds": [
              "JHN.1.47"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ilaa Israaʼelicha dhugaa kan haxxummaan keessa hin jirre!\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.1.47",
                "verseOrgIds": [
                  "JHN.1.47"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhee waaʼee isaa dubbate.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.47",
            "verseOrgIds": [
              "JHN.1.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JHN 1:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naatnaaʼelis, \"Ati eessatti na beekta?\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.48",
            "verseOrgIds": [
              "JHN.1.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 1:48"
      },
      "items": [
        {
          "text": "Yesuusis,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.48",
            "verseOrgIds": [
              "JHN.1.48"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Utuu Fiiliphoos si hin waamin dura yeroo ati muka harbuu jala turtettin si arge\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.1.48",
                "verseOrgIds": [
                  "JHN.1.48"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhee deebiseef.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.48",
            "verseOrgIds": [
              "JHN.1.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
