          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis itti dabalee,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.51",
            "verseOrgIds": [
              "JHN.1.51"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ani dhuguman, dhuguman isiniin jedha; samiin banamee utuu ergamoonni Waaqaa Ilma Namaa irra ol baʼanii gad buʼanuu ni argitu\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.1.51",
                "verseOrgIds": [
                  "JHN.1.51"
                ]
              }
            }
          ]
        },
        {
