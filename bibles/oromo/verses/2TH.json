  "2TH.3": {
    "id": "2TH.3",
    "number": "3",
    "bookId": "2TH",
    "reference": "2 Tasaloniiqee 3",
    "copyright": "Biblica® Hiikkaa Ammayyaa Banamaa Haaraa™, Loqoda Dhiʼaa Mirgi seeraan eegama © 2022 Biblica, Inc. Biblica® Open New Oromo Contemporary Version™, Western Copyright © 2022 by Biblica, Inc. \"Biblica\" jechuun mallattoo eenyummaa kan Biblica, Inc., Waajjira Eeyyamaa fi Mallattoo Eenyummaa kan Ameerikaa keessaatti galmeessee dha. Eeyyamaan itti fayyadamu. \"Biblica\" is trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
    "verseCount": 18,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "3",
          "style": "c",
          "sid": "2TH 3"
        },
        "items": [
          {
            "text": "3",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Nuuf Kadhadhaa",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "2TH 3:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Egaa yaa obboloota, akka dubbiin Gooftaa akkuma isin biratti taʼe sana dafee iddoo hunda gaʼuu fi akka ulfinas qabaatu nuuf kadhadhaa.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.1",
              "verseOrgIds": [
                "2TH.3.1"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "2TH 3:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "Akka nu harka namoota hamootii fi jalʼootaa jalaa baanuufis nuuf kadhadhaa; amantii kan qabu nama hunda mitii.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.2",
              "verseOrgIds": [
                "2TH.3.2"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "2TH 3:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Gooftaan garuu amanamaa dha; inni isin cimsa; isa hamaa irraas isin eega.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.3",
              "verseOrgIds": [
                "2TH.3.3"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "2TH 3:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nu akka isin waan nu isin ajajne sana hojjechaa jirtan, akka ittuma fuftaniis hojjetan Gooftaa ni amananna.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.4",
              "verseOrgIds": [
                "2TH.3.4"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "2TH 3:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "Gooftaan garaa keessan gara jaalala Waaqaatii fi gara obsa Kiristoositti haa qajeelchu.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.5",
              "verseOrgIds": [
                "2TH.3.5"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Dirqama Hojii Hojjechuu",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "2TH 3:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Yaa obboloota, isin obboleessa dhibaaʼaa fi kan akka bartee isin nurraa argattan sanaattis hin jiraanne hunda irraa akka fagaattaniif maqaa Gooftaa keenya Yesuus Kiristoosiin isin ajajna.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.6",
              "verseOrgIds": [
                "2TH.3.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "2TH 3:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Isin mataan keessan akkamitti akka fakkeenya keenya duukaa buʼuu qabdan ni beektuutii. Nu yeroo isin bira turretti dhibaaʼota hin turre;",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.7",
              "verseOrgIds": [
                "2TH.3.7"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "2TH 3:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "nus akka isin keessaa nama tokkotti illee baʼaa hin taaneef jennee, dadhabbii fi tattaaffii guddaan halkanii guyyaa hojjechaa turre malee buddeena nama tokkoo illee tola hin nyaanne.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.8",
              "verseOrgIds": [
                "2TH.3.8"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "2TH 3:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nu fakkeenya isinii taʼuuf waan kana goone malee waan aangoo hin qabneef miti.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.9",
              "verseOrgIds": [
                "2TH.3.9"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "2TH 3:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "Nu yommuu isin bira turretti ajaja, \"Namni hojjechuu hin barbaanne kam iyyuu hin nyaatin\" jedhu isinii kenninee turreetii.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.10",
              "verseOrgIds": [
                "2TH.3.10"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "2TH 3:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Akka isin keessaa namoonni tokko tokko dhibaaʼota taʼanii jiraatan dhageenyeerraatii. Isaan dhimma nama biraa keessa galuu malee ofii isaaniitii waan tokko illee hin hojjetan.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.11",
              "verseOrgIds": [
                "2TH.3.11"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "2TH 3:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "Namoonni akkanaa akka gab jedhanii hojii hojjetanii fi akka buddeena ofii isaanii nyaataniif Gooftaa Yesuus Kiristoosiin isaan ajajna; ni gorsinas.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.12",
              "verseOrgIds": [
                "2TH.3.12"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "13",
              "style": "v",
              "sid": "2TH 3:13"
            },
            "items": [
              {
                "text": "13",
                "type": "text"
              }
            ]
          },
          {
            "text": "Isin garuu yaa obboloota, waan gaarii hojjechuutti hin laafinaa.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.13",
              "verseOrgIds": [
                "2TH.3.13"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "14",
              "style": "v",
              "sid": "2TH 3:14"
            },
            "items": [
              {
                "text": "14",
                "type": "text"
              }
            ]
          },
          {
            "text": "Yoo namni kam iyyuu dubbii keenya kan xalayaa kana keessaatiif hin ajajamne, nama kana yaadatti qabadhaa. Akka inni qaanaʼuufis isa wajjin tokkummaa hin qabaatinaa.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.14",
              "verseOrgIds": [
                "2TH.3.14"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "15",
              "style": "v",
              "sid": "2TH 3:15"
            },
            "items": [
              {
                "text": "15",
                "type": "text"
              }
            ]
          },
          {
            "text": "Taʼus akka obboleessaatti isa gorsaa malee akka diinaatti isa hin ilaalinaa.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.15",
              "verseOrgIds": [
                "2TH.3.15"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Dhaamsa Nagaa Xumuraa",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "16",
              "style": "v",
              "sid": "2TH 3:16"
            },
            "items": [
              {
                "text": "16",
                "type": "text"
              }
            ]
          },
          {
            "text": "Gooftaan nagaa mataan isaas yeroo hunda, karaa hundaan nagaa isinii haa kennu. Gooftaan hunduma keessan wajjin haa taʼu.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.16",
              "verseOrgIds": [
                "2TH.3.16"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "17",
              "style": "v",
              "sid": "2TH 3:17"
            },
            "items": [
              {
                "text": "17",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ani Phaawulos xalayaa kana harkuma kootiin barreessa; kunis mallattoo xalayoota koo hundaa ti. Akki ani itti barreessus kanuma.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.17",
              "verseOrgIds": [
                "2TH.3.17"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "18",
              "style": "v",
              "sid": "2TH 3:18"
            },
            "items": [
              {
                "text": "18",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ayyaanni Gooftaa keenya Yesuus Kiristoos isin hunda wajjin haa taʼu.",
            "type": "text",
            "attrs": {
              "verseId": "2TH.3.18",
              "verseOrgIds": [
                "2TH.3.18"
              ]
            }
          }
        ]
      }
    ],
