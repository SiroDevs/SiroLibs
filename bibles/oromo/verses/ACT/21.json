    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 21:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phaawulos yommuu loltoonni isa fuudhanii qubata loltootaatti ol isa galchuuf jedhanitti, ajajaa sanaan, \"Akka ani waa sitti himu naa eeyyamtaa?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.37",
            "verseOrgIds": [
              "ACT.21.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ACT 21:37"
      },
      "items": [
        {
          "text": "Ajajaan sun immoo deebisee akkana jedhe; \"Ati afaan Giriik ni dubbattaa?",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.37",
            "verseOrgIds": [
              "ACT.21.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 21:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati namicha biyya Gibxi kan dhiʼeenya kana goolii kaasee shororkeessitoota",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.38",
            "verseOrgIds": [
              "ACT.21.38"
            ]
          }
        },
        {
          "text": "4,000 fudhatee gammoojjiitti gale sana mitii?\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.38",
            "verseOrgIds": [
              "ACT.21.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 21:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phaawulosis, \"Ani Yihuudii Xarsees magaalaa beekamtuu Kiilqiyaa keessaa sanaa ti. Maaloo, akka ani namoota kanatti dubbadhu naa eeyyami\" jedhee deebise.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.39",
            "verseOrgIds": [
              "ACT.21.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 21:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phaawulos akkuma eeyyama ajajaa sanaa argateen gulantaa sana irra dhaabatee akka namoonni calʼisaniif harkaan mallattoo kenne; yommuu isaan hundinuu calʼisanitti immoo afaan Araamaayikiitiin akkana jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.40",
            "verseOrgIds": [
              "ACT.21.40"
            ]
          }
        }
      ]
    }
