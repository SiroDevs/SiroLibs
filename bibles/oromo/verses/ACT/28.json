  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "ACT 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Phaawulos Malaaxiyaa Gaʼuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nus nagumaan qarqara galaanaatti baanee akka biyyi bishaaniin marfamte sun Malaaxiyaa jedhamtu beekne.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.1",
            "verseOrgIds": [
              "ACT.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni biyya bishaaniin marfamte sana irra jiraatanis gara laafina dinqisiisaa nu argisiisan. Isaanis sababii roobnii fi dhaamochi tureef ibidda bobeessanii hunda keenya simatan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.2",
            "verseOrgIds": [
              "ACT.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuu Phaawulos hanxaxii qoraanii walitti qabee ibiddatti naqaa jiruu buutiin sababii hoʼaatiin gad baate tokko harka isaatti maxxantee gad dhiisuu didde.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.3",
            "verseOrgIds": [
              "ACT.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri biyya bishaaniin marfamte sana irra jiraatan sunis buutii harka isaatti rarraatu arganii, \"Namichi kun nama nama ajjeese taʼuu hin oolu; inni yoo balaa galaanaa jalaa baʼe illee Murtiin Qajeelaan akka inni jiraatu hin eeyyamneef\" waliin jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.4",
            "verseOrgIds": [
              "ACT.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phaawulos buutii sana ibidda keessa of irraa buuse; miidhaa tokko malees hafe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.5",
            "verseOrgIds": [
              "ACT.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni sunis, \"Inni ni dhiitaʼa yookaan akkuma tasaa kufee duʼa\" jedhanii eegan; garuu yommuu yeroo dheeraa eeganii akka inni waa tokko illee hin taʼin arganitti yaada geeddaratanii, \"Inni waaqa\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.6",
            "verseOrgIds": [
              "ACT.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bulchaan biyya bishaaniin marfamtee kan Phubiliyoos jedhamu tokkos naannoo sanaa lafa qotiisaa qaba ture; innis mana isaatti nu simatee guyyaa sadii jaalalaan nu keessumsiise.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.7",
            "verseOrgIds": [
              "ACT.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abbaan Phubiliyoos dhukkuba dhagna nama gubuu fi garaa nama kaasuun qabamee ciisaa ture; Phaawulosis isa gaafachuuf ol seenee erga kadhatee booddee harka irra kaaʼee isa fayyise.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.8",
            "verseOrgIds": [
              "ACT.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu wanni kun taʼetti dhukkubsattoonni biyya bishaaniin marfamte sana irra jiraatan biraa hundi dhufanii fayyan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.9",
            "verseOrgIds": [
              "ACT.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis karaa baayʼeedhaan ulfina nuu kennan; yommuu nu dooniin deemuuf kaanettis waan nu barbaachisu hunda nuuf kennan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.10",
            "verseOrgIds": [
              "ACT.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Phaawulos Roomaa Gaʼe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nus jiʼa sadii booddee doonii Iskindiriyaa kan biyya bishaaniin marfamte sana irratti yeroo gannaa dabarse tokkoon kaanee deemsa jalqabne; dooniin sunis asxaa waaqota lakkuu Kastoorii fi Paaluksi adda isaa irraa qaba ture.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.11",
            "verseOrgIds": [
              "ACT.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seraakuus geenyees bultii sadii achi turre.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.12",
            "verseOrgIds": [
              "ACT.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achiis kaanee Reegiyuumitti galle; guyyaa tokko booddees waan bubbeen kibbaa bubbiseef guyyaa itti aanutti Putiyooluus geenye.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.13",
            "verseOrgIds": [
              "ACT.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achitti obboloota tokko tokko arganne; isaanis akka nu bultii torba isaan bira turru nu kadhatan. Nus akkasiin Roomaatti galle.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.14",
            "verseOrgIds": [
              "ACT.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obboloonni achi turanis yommuu dhufaatii keenya dhagaʼanitti hamma iddoo gabaa Aphiyuusiittii fi iddoo \"Lafa Bultoo Sadii\" jedhamuutti nu simachuu dhufan; Phaawulosis isaan argee Waaqa galateeffate; ofii isaatiis ni jajjabaate.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.15",
            "verseOrgIds": [
              "ACT.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu nu Roomaa geenyetti Phaawulos akka loltuu isa eegu tokko wajjin kophaa isaa jiraatu eeyyamameef.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.16",
            "verseOrgIds": [
              "ACT.28.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Phaawulos Eegumsa Jalatti Roomaatti Lallabuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phaawulosis guyyaa sadii booddee dura buʼoota Yihuudootaa walitti waame; yommuu isaan walitti qabamanittis akkana jedheen; \"Yaa obboloota ko, ani utuu waan saba keenyaan yookaan duudhaa abbootii keenyaatiin mormu tokko illee hin hojjetin Yerusaalem keessatti qabamee dabarfamee harka warra Roomaatti kennameera.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.17",
            "verseOrgIds": [
              "ACT.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis erga na qoranii booddee sababii ani yakka duʼa namatti mursiisu tokko illee hin qabaatiniif gad na dhiisuu barbaadan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.18",
            "verseOrgIds": [
              "ACT.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani garuu yoo waan ittiin saba koo himadhu tokko iyyuu hin qabaatin illee yommuu Yihuudoonni mormanitti akka Qeesaaritti ol iyyadhu nan dirqame.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.19",
            "verseOrgIds": [
              "ACT.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni ani isin arguu fi isin wajjin haasaʼuu kadhadheefis kanuma. Ani sababuma abdii Israaʼeliif jedhee foncaa kanaan hidhameera.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.20",
            "verseOrgIds": [
              "ACT.28.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis akkana jedhanii deebisan; \"Nu xalayaa waaʼee kee dubbatu tokko illee biyya Yihuudaatii hin arganne; obboloota achii dhufan keessaas namni tokko iyyuu waaʼee kee waan hamaa hin dubbanne; nuttis hin himne.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.21",
            "verseOrgIds": [
              "ACT.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu garuu yaadni kee maal akka taʼe sirraa dhagaʼuu barbaanna; nu akka namoonni iddoo hunda jiran garee kanaan morman ni beeknaatii.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.22",
            "verseOrgIds": [
              "ACT.28.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis guyyaa itti Phaawulos wajjin wal argan qabatanii, akka malee baayʼatanii lafa inni jiraachaa ture dhaqan; innis ganamaa jalqabee hamma galgalaatti waaʼee mootummaa Waaqaa isaanii ibsaa, lallabaas ture; waaʼee Yesuusiis Seera Museetii fi Kitaabota Raajotaa keessaa eeree isaan amansiisuu yaalaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.23",
            "verseOrgIds": [
              "ACT.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan keessaa warri tokko tokko waan inni jedhe ni fudhatan; warri kaan immoo amanuu didan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.24",
            "verseOrgIds": [
              "ACT.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan gidduutti waldhabiisni uumamnaan kaʼanii deemuu jalqaban; kunis erga Phaawulos akkana jedhee dubbii dhumaa dubbatee booddee; \"Hafuurri Qulqulluun yeroo karaa Isaayyaas raajichaatiin abbootii keessanitti dubbate sana dhugaa isaa dubbate; innis akkana jedhe:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.25",
            "verseOrgIds": [
              "ACT.28.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Gara saba kanaa dhaqiitii akkana jedhi;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.26",
            "verseOrgIds": [
              "ACT.28.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ACT 28:26"
      },
      "items": [
        {
          "text": "\"Dhagaʼuu inuma dhageessu; garuu hin hubattan;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.26",
            "verseOrgIds": [
              "ACT.28.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 28:26"
      },
      "items": [
        {
          "text": "ilaaluus inuma ilaaltu; garuu hin qalbeeffattan.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.26",
            "verseOrgIds": [
              "ACT.28.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qalbiin saba kanaa doomeeraatii;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.27",
            "verseOrgIds": [
              "ACT.28.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 28:27"
      },
      "items": [
        {
          "text": "gurri isaanii sirriitti hin dhagaʼu;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.27",
            "verseOrgIds": [
              "ACT.28.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 28:27"
      },
      "items": [
