          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus isa dirmammeessuu fi isa dhiphisuun fedhii",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.10",
            "verseOrgIds": [
              "ISA.53.10"
            ]
          }
        },
