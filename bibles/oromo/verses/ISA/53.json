          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergaa keenya eenyutu amane?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.1",
            "verseOrgIds": [
              "ISA.53.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:1"
      },
      "items": [
        {
          "text": "Irreen",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.1",
            "verseOrgIds": [
              "ISA.53.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoos",
              "type": "text",
              "attrs": {
                "verseId": "ISA.53.1",
                "verseOrgIds": [
                  "ISA.53.1"
                ]
              }
            }
          ]
        },
        {
          "text": "eenyutti mulʼate?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.1",
            "verseOrgIds": [
              "ISA.53.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 53:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni fuula isaa duratti akkuma biqiltuu kichuu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.2",
            "verseOrgIds": [
              "ISA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:2"
      },
      "items": [
        {
          "text": "akkuma hidda lafa gogaa keessaa baʼu tokkootti guddate.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.2",
            "verseOrgIds": [
              "ISA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 53:2"
      },
      "items": [
        {
          "text": "Akka nu isa ilaalluuf, inni bifa hin tolu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.2",
            "verseOrgIds": [
              "ISA.53.2"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "yookaan simboo hin qabu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.2",
            "verseOrgIds": [
              "ISA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:2"
      },
      "items": [
        {
          "text": "akka nu isa hawwinuufis miidhagina hin qabu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.2",
            "verseOrgIds": [
              "ISA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 53:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni nama biratti tuffatamee jibbame;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.3",
            "verseOrgIds": [
              "ISA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:3"
      },
      "items": [
        {
          "text": "inni nama gaddaa fi gadadamuun jiraatuu dha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.3",
            "verseOrgIds": [
              "ISA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 53:3"
      },
      "items": [
        {
          "text": "Akkuma nama namoonni fuula isaanii irraa garagalfatanii,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.3",
            "verseOrgIds": [
              "ISA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:3"
      },
      "items": [
        {
          "text": "inni ni tuffatame; nus ulfina hin kennineef.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.3",
            "verseOrgIds": [
              "ISA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 53:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhugumaan inni dhukkuba keenya fudhate;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.4",
            "verseOrgIds": [
              "ISA.53.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:4"
      },
      "items": [
        {
          "text": "gadda keenyas baate;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.4",
            "verseOrgIds": [
              "ISA.53.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 53:4"
      },
      "items": [
        {
          "text": "nu garuu akka waan Waaqni isa dhaʼeetti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.4",
            "verseOrgIds": [
              "ISA.53.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:4"
      },
      "items": [
        {
          "text": "akka waan inni rukutee isa miidheetti isa hedne.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.4",
            "verseOrgIds": [
              "ISA.53.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 53:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni garuu sababii yakka keenyaatiif waraaname;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.5",
            "verseOrgIds": [
              "ISA.53.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:5"
      },
      "items": [
        {
          "text": "balleessaa keenyaafis caccabsame;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.5",
            "verseOrgIds": [
              "ISA.53.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 53:5"
      },
      "items": [
        {
          "text": "nu adabamuu isaatiin nagaa arganne;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.5",
            "verseOrgIds": [
              "ISA.53.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:5"
      },
      "items": [
        {
          "text": "madaaʼuu isaatiin immoo fayyine.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.5",
            "verseOrgIds": [
              "ISA.53.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 53:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hundi keenya akka hoolaa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.6",
            "verseOrgIds": [
              "ISA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:6"
      },
      "items": [
        {
          "text": "karaa irraa badnee turre;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.6",
            "verseOrgIds": [
              "ISA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 53:6"
      },
      "items": [
        {
          "text": "tokkoon tokkoon keenya gara karaa keenyaatti gorre;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.6",
            "verseOrgIds": [
              "ISA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:6"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "ISA.53.6",
                "verseOrgIds": [
                  "ISA.53.6"
                ]
              }
            }
          ]
        },
        {
          "text": "balleessaa hunda keenyaa isa irra kaaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.6",
            "verseOrgIds": [
              "ISA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 53:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni ni cunqurfame; ni dhiphates;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.7",
            "verseOrgIds": [
              "ISA.53.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:7"
      },
      "items": [
        {
          "text": "garuu afaan isaa hin saaqqanne;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.7",
            "verseOrgIds": [
              "ISA.53.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 53:7"
      },
      "items": [
        {
          "text": "inni akkuma ilmoo hoolaa kan iddoo qalmaatti geeffamuu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.7",
            "verseOrgIds": [
              "ISA.53.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:7"
      },
      "items": [
        {
          "text": "akkuma hoolaa fuula nama rifeensa irraa murmuruu duratti calʼisuu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.7",
            "verseOrgIds": [
              "ISA.53.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:7"
      },
      "items": [
        {
          "text": "akkasuma afaan isaa hin saaqqanne.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.7",
            "verseOrgIds": [
              "ISA.53.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 53:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni cunqursaa fi murtiidhaan fudhatame.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.8",
            "verseOrgIds": [
              "ISA.53.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:8"
      },
      "items": [
        {
          "text": "Eenyutu waaʼee dhaloota isaa dubbachuu dandaʼa?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.8",
            "verseOrgIds": [
              "ISA.53.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 53:8"
      },
      "items": [
        {
          "text": "Inni biyya jiraattotaa irraa kutameeraatii;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.8",
            "verseOrgIds": [
              "ISA.53.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:8"
      },
      "items": [
        {
          "text": "dogoggora saba kootiifis rukutameera.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.8",
            "verseOrgIds": [
              "ISA.53.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 53:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni goolii kaasuu baatu iyyuu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.9",
            "verseOrgIds": [
              "ISA.53.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:9"
      },
      "items": [
        {
          "text": "yookaan sobni afaan isaatii baʼuu baatu iyyuu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.9",
            "verseOrgIds": [
              "ISA.53.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 53:9"
      },
      "items": [
        {
          "text": "akka awwaalli isaa hamoota wajjin",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.9",
            "verseOrgIds": [
              "ISA.53.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:9"
      },
      "items": [
        {
          "text": "duuti isaas sooreyyii wajjin taʼu godhan.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.9",
            "verseOrgIds": [
              "ISA.53.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
