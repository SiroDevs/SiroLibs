          "text": "lubbuu isaa aarsaa yakkaa godhu iyyuu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.10",
            "verseOrgIds": [
              "ISA.53.10"
            ]
          }
        }
      ]
    },
