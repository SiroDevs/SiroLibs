          "type": "text",
          "attrs": {
            "verseId": "ISA.53.10",
            "verseOrgIds": [
              "ISA.53.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
