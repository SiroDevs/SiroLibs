          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Raajii Gibxiin mormu:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.1",
            "verseOrgIds": [
              "ISA.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 19:1"
      },
      "items": [
        {
          "text": "kunoo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.1",
            "verseOrgIds": [
              "ISA.19.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ISA.19.1",
                "verseOrgIds": [
                  "ISA.19.1"
                ]
              }
            }
          ]
        },
        {
          "text": "duumessa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.1",
            "verseOrgIds": [
              "ISA.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:1"
      },
      "items": [
        {
          "text": "saffisaa yaabbatee gara Gibxi dhufaa jira.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.1",
            "verseOrgIds": [
              "ISA.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 19:1"
      },
      "items": [
        {
          "text": "Waaqonni Gibxi tolfamoon fuula isaa duratti hollatu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.1",
            "verseOrgIds": [
              "ISA.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:1"
      },
      "items": [
        {
          "text": "garaan warra Gibxis isaan keessatti baqa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.1",
            "verseOrgIds": [
              "ISA.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ani warra Gibxi walitti nan naqa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.2",
            "verseOrgIds": [
              "ISA.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:2"
      },
      "items": [
        {
          "text": "obboleessi obboleessa isaa, ollaan ollaa isaa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.2",
            "verseOrgIds": [
              "ISA.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:2"
      },
      "items": [
        {
          "text": "magaalaan tokko magaalaa kaan,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.2",
            "verseOrgIds": [
              "ISA.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:2"
      },
      "items": [
        {
          "text": "mootummaanis mootummaa kaan lola.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.2",
            "verseOrgIds": [
              "ISA.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hafuurri warra Gibxi isaan keessatti jeeqama;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.3",
            "verseOrgIds": [
              "ISA.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:3"
      },
      "items": [
        {
          "text": "anis karoora isaanii nan fashaleessa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.3",
            "verseOrgIds": [
              "ISA.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 19:3"
      },
      "items": [
        {
          "text": "isaanis waaqota tolfamoo fi hafuurota warra duʼanii,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.3",
            "verseOrgIds": [
              "ISA.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:3"
      },
      "items": [
        {
          "text": "ilaaltotaa fi eker dubbistoota gorsa gaafatu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.3",
            "verseOrgIds": [
              "ISA.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis dabarsee warra Gibxi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.4",
            "verseOrgIds": [
              "ISA.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:4"
      },
      "items": [
        {
          "text": "humna gooftaa garaa jabaatu tokkootti nan kenna;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.4",
            "verseOrgIds": [
              "ISA.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 19:4"
      },
      "items": [
        {
          "text": "mootiin hamaan tokkos isaan ni bulcha\" jedha Gooftaan,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.4",
            "verseOrgIds": [
              "ISA.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:4"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "ISA.19.4",
                "verseOrgIds": [
                  "ISA.19.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.4",
            "verseOrgIds": [
              "ISA.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bishaanonni galaanaa ni gogu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.5",
            "verseOrgIds": [
              "ISA.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:5"
      },
      "items": [
        {
          "text": "lagni isaas ni hirʼata; ni gogas.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.5",
            "verseOrgIds": [
              "ISA.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Burqaawwan isaa ni ajaaʼu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.6",
            "verseOrgIds": [
              "ISA.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:6"
      },
      "items": [
        {
          "text": "lageen Gibxiis qalʼatanii gogu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.6",
            "verseOrgIds": [
              "ISA.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 19:6"
      },
      "items": [
        {
          "text": "Shambaqqoo fi dhallaadduun ni coollagu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.6",
            "verseOrgIds": [
              "ISA.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "biqiltuuwwan ededa Abbayyaa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.7",
            "verseOrgIds": [
              "ISA.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:7"
      },
      "items": [
        {
          "text": "kanneen qarqara lagichaa jiranis ni coollagu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.7",
            "verseOrgIds": [
              "ISA.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 19:7"
      },
      "items": [
        {
          "text": "Wanni laga Abbayyaa biratti facaafame hundi ni goga;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.7",
            "verseOrgIds": [
              "ISA.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:7"
      },
      "items": [
        {
          "text": "bubbeedhaan fudhatama; deebiʼees hin argamu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.7",
            "verseOrgIds": [
              "ISA.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qurxummii qabdoonni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.8",
            "verseOrgIds": [
              "ISA.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:8"
      },
      "items": [
        {
          "text": "warri hokkoo Abbayyaa keessa buusan",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.8",
            "verseOrgIds": [
              "ISA.19.8"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "hundi aadanii booʼu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.8",
            "verseOrgIds": [
              "ISA.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:8"
      },
      "items": [
        {
          "text": "warri kiyyoo bishaanitti darbatanis ni dadhabu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.8",
            "verseOrgIds": [
              "ISA.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri quncee talbaa iddame qopheessan,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.9",
            "verseOrgIds": [
              "ISA.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:9"
      },
      "items": [
        {
          "text": "wayyaa dhooftonnis abdii kutatu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.9",
            "verseOrgIds": [
              "ISA.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri wayyaa dhaʼan mataa buusu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.10",
            "verseOrgIds": [
              "ISA.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:10"
      },
      "items": [
        {
          "text": "warri mindaadhaan hojjetan hundis ni gaddu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.10",
            "verseOrgIds": [
              "ISA.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qondaaltonni Zooʼaan gowwoota;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.11",
            "verseOrgIds": [
              "ISA.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:11"
      },
      "items": [
        {
          "text": "gorsitoonni Faraʼoon ogeeyyiinis",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.11",
            "verseOrgIds": [
              "ISA.19.11"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "gorsa faayidaa hin qabne kennu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.11",
            "verseOrgIds": [
              "ISA.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 19:11"
      },
      "items": [
        {
          "text": "Isin akkamitti Faraʼooniin,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.11",
            "verseOrgIds": [
              "ISA.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:11"
      },
      "items": [
        {
          "text": "\"Ani namoota ogeeyyii keessaa tokkoo dha;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.11",
            "verseOrgIds": [
              "ISA.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:11"
      },
      "items": [
        {
          "text": "ani barataa mootota durii ti\" jechuu dandeessu?",
          "type": "text",
          "attrs": {
