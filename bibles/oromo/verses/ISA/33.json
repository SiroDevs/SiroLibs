    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhiphinaa fi Gargaarsa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa barbadeessaa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.1",
            "verseOrgIds": [
              "ISA.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:1"
      },
      "items": [
        {
          "text": "ati kan hin barbadeeffamin siif wayyoo!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.1",
            "verseOrgIds": [
              "ISA.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 33:1"
      },
      "items": [
        {
          "text": "Yaa gantuu, ati kan hin ganamin siif wayyoo!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.1",
            "verseOrgIds": [
              "ISA.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:1"
      },
      "items": [
        {
          "text": "Ati yommuu barbadeessuu dhiiftutti ni barbadeeffamta;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.1",
            "verseOrgIds": [
              "ISA.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:1"
      },
      "items": [
        {
          "text": "yommuu ganuu dhiiftuttis ni ganamta.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.1",
            "verseOrgIds": [
              "ISA.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.2",
            "verseOrgIds": [
              "ISA.33.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ISA.33.2",
                "verseOrgIds": [
                  "ISA.33.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", nu maari; nu si eeggannaa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.2",
            "verseOrgIds": [
              "ISA.33.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:2"
      },
      "items": [
        {
          "text": "Ati ganama ganama jabina keenya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.2",
            "verseOrgIds": [
              "ISA.33.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:2"
      },
      "items": [
        {
          "text": "yeroo dhiphinaatti immoo fayyina keenya nuuf taʼi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.2",
            "verseOrgIds": [
              "ISA.33.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sagalee kakawwee keetiitiin, namoonni baqatu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.3",
            "verseOrgIds": [
              "ISA.33.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:3"
      },
      "items": [
        {
          "text": "yeroo ati ol kaatutti, saboonni ni bittinnaaʼu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.3",
            "verseOrgIds": [
              "ISA.33.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa saboota, akkuma hawwaannisni walitti qabamu sana",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.4",
            "verseOrgIds": [
              "ISA.33.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:4"
      },
      "items": [
        {
          "text": "boojuun keessan walitti qabama;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.4",
            "verseOrgIds": [
              "ISA.33.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:4"
      },
      "items": [
        {
          "text": "namoonnis akkuma tuuta hawwaannisaa irra uʼutaalu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.4",
            "verseOrgIds": [
              "ISA.33.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ISA.33.5",
                "verseOrgIds": [
                  "ISA.33.5"
                ]
              }
            }
          ]
        },
        {
          "text": "ol ol jedha; inni ol gubbaa jiraataatii;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.5",
            "verseOrgIds": [
              "ISA.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:5"
      },
      "items": [
        {
          "text": "inni murtii qajeelaa fi qajeelummaadhaan Xiyoonin guuta.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.5",
            "verseOrgIds": [
              "ISA.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni bara keetiif hundee amansiisaa, kuusaa fayyinaa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.6",
            "verseOrgIds": [
              "ISA.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:6"
      },
      "items": [
        {
          "text": "kan ogummaatii fi kan beekumsaa taʼa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.6",
            "verseOrgIds": [
              "ISA.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:6"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "ISA.33.6",
                "verseOrgIds": [
                  "ISA.33.6"
                ]
              }
            }
          ]
        },
        {
          "text": "sodaachuun furtuu badhaadhummaa kanaa ti.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.6",
            "verseOrgIds": [
              "ISA.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunoo gootonni isaanii sagalee ol fudhatanii daandii irratti iyyu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.7",
            "verseOrgIds": [
              "ISA.33.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:7"
      },
      "items": [
        {
          "text": "ergamoonni nagaas hiqqifatanii booʼu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.7",
            "verseOrgIds": [
              "ISA.33.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karaawwan gurguddaan onaniiru;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.8",
            "verseOrgIds": [
              "ISA.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:8"
      },
      "items": [
        {
          "text": "namni karaa irra deemu hin jiru.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.8",
            "verseOrgIds": [
              "ISA.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 33:8"
      },
      "items": [
        {
          "text": "Walii galteen diigameera;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.8",
            "verseOrgIds": [
              "ISA.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:8"
      },
      "items": [
        {
          "text": "dhuga baatonni ishee tuffatamaniiru;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.8",
            "verseOrgIds": [
              "ISA.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:8"
      },
      "items": [
        {
          "text": "namni tokko iyyuu hin kabajamu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.8",
            "verseOrgIds": [
              "ISA.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lafti ni boossi; ni barbadoofti;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.9",
            "verseOrgIds": [
              "ISA.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:9"
      },
      "items": [
        {
          "text": "Libaanoon ni qaanofti; ni coollagdi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.9",
            "verseOrgIds": [
              "ISA.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 33:9"
      },
      "items": [
        {
          "text": "Shaaroon akka gammoojjii taati;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.9",
            "verseOrgIds": [
              "ISA.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:9"
      },
      "items": [
        {
          "text": "Baashaanii fi Qarmeloos baala isaanii harcaafatu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.9",
            "verseOrgIds": [
              "ISA.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ISA.33.10",
                "verseOrgIds": [
                  "ISA.33.10"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedha; \"Ani amma nan kaʼa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.10",
            "verseOrgIds": [
              "ISA.33.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:10"
      },
      "items": [
        {
          "text": "ani amma ol ol nan jedha;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.10",
            "verseOrgIds": [
              "ISA.33.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:10"
      },
      "items": [
        {
          "text": "ani amma nan kabajama.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.10",
            "verseOrgIds": [
              "ISA.33.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin habaqii ulfooftu; cidii deessu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.11",
            "verseOrgIds": [
              "ISA.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:11"
      },
      "items": [
        {
          "text": "hafuurri isin baafattan ibidda gubee isin fixuu dha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.11",
            "verseOrgIds": [
              "ISA.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni akkuma nooraa gubamu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.12",
            "verseOrgIds": [
              "ISA.33.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 33:12"
      },
      "items": [
        {
          "text": "akkuma qoraattii cirameettis ibiddi itti qabsiifama.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.12",
            "verseOrgIds": [
              "ISA.33.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
