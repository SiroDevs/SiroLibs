      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 15:1"
      },
      "items": [
        {
          "text": "Aari isheen Moʼaab keessaa diigamteerti;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.1",
            "verseOrgIds": [
              "ISA.15.1"
