      "attrs": {
        "style": "q2",
        "vid": "ISA 15:5"
      },
      "items": [
        {
          "text": "kooluu galtoonni ishee hamma Zoʼaariitti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.5",
            "verseOrgIds": [
              "ISA.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:5"
      },
      "items": [
        {
          "text": "hamma Eglaati Sheelishiyaatti baqatu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.5",
            "verseOrgIds": [
              "ISA.15.5"
            ]
          }
