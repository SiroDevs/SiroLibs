          "text": "Kanaafuu isaan qabeenya argatanii kuufatan sana",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.7",
            "verseOrgIds": [
              "ISA.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:7"
      },
      "items": [
        {
          "text": "Laga Alaltuu irraan baatanii dabarfatu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.7",
            "verseOrgIds": [
              "ISA.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
