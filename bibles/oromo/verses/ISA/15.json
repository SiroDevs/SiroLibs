          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bishaanonni Diimon dhiigaan guutamaniiru;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.9",
            "verseOrgIds": [
              "ISA.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:9"
      },
      "items": [
        {
          "text": "ani immoo waan kana caalu iyyuu Diimonitti nan fida;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.9",
            "verseOrgIds": [
              "ISA.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 15:9"
      },
      "items": [
        {
          "text": "warra Moʼaab keessaa baqatan",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.9",
            "verseOrgIds": [
              "ISA.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:9"
      },
      "items": [
        {
          "text": "kanneen biyya sanatti hafanitti leenca nan erga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.9",
            "verseOrgIds": [
              "ISA.15.9"
            ]
          }
