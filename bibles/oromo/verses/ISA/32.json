  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "32",
        "style": "c",
        "sid": "ISA 32"
      },
      "items": [
        {
          "text": "32",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mootummaa Qajeelummaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunoo mootiin qajeelummaadhaan moʼa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.1",
            "verseOrgIds": [
              "ISA.32.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:1"
      },
      "items": [
        {
          "text": "bulchitoonnis murtii qajeelaadhaan bulchu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.1",
            "verseOrgIds": [
              "ISA.32.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tokkoon tokkoon namaa akkuma daʼannoo bubbee jalaa itti daʼatanii,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.2",
            "verseOrgIds": [
              "ISA.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:2"
      },
      "items": [
        {
          "text": "akkuma iddoo itti jabaa jalaa baqataniitti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.2",
            "verseOrgIds": [
              "ISA.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 32:2"
      },
      "items": [
        {
          "text": "akkuma bishaan gammoojjii keessa yaaʼuutii fi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.2",
            "verseOrgIds": [
              "ISA.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:2"
      },
      "items": [
        {
          "text": "akkuma gaaddisa kattaa guddaa kan lafa gogaa keessaa ni taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.2",
            "verseOrgIds": [
              "ISA.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis iji warra waa arguu hin dunuunfatu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.3",
            "verseOrgIds": [
              "ISA.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:3"
      },
      "items": [
        {
          "text": "gurri warra waa dhagaʼuus ni dhaggeeffata.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.3",
            "verseOrgIds": [
              "ISA.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qalbiin nama jarjaru tokkoo ni beeka; ni hubata;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.4",
            "verseOrgIds": [
              "ISA.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:4"
      },
      "items": [
        {
          "text": "arrabni giingees qajeelchee qulqulleessee dubbata.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.4",
            "verseOrgIds": [
              "ISA.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siʼachi gowwaan ulfina qabeessa hin jedhamu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.5",
            "verseOrgIds": [
              "ISA.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:5"
      },
      "items": [
        {
          "text": "addaggeenis baayʼee hin kabajamu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.5",
            "verseOrgIds": [
              "ISA.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gowwaan sababii gowwummaa dubbatuuf",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.6",
            "verseOrgIds": [
              "ISA.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:6"
      },
      "items": [
        {
          "text": "qalbiin isaa hammina hojjeta;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.6",
            "verseOrgIds": [
              "ISA.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 32:6"
      },
      "items": [
        {
          "text": "inni waan Waaqni hin jaallanne hojjeta;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.6",
            "verseOrgIds": [
              "ISA.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:6"
      },
      "items": [
        {
          "text": "waaʼee",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.6",
            "verseOrgIds": [
              "ISA.32.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoos",
              "type": "text",
              "attrs": {
                "verseId": "ISA.32.6",
                "verseOrgIds": [
                  "ISA.32.6"
                ]
              }
            }
          ]
        },
        {
          "text": "dogoggora odeessa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.6",
            "verseOrgIds": [
              "ISA.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 32:6"
      },
      "items": [
        {
          "text": "inni nama beelaʼe beela hin baasu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.6",
            "verseOrgIds": [
              "ISA.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:6"
      },
      "items": [
        {
          "text": "nama dheebote illee bishaan dhowwata.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.6",
            "verseOrgIds": [
              "ISA.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malli addaggee hammina;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.7",
            "verseOrgIds": [
              "ISA.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:7"
      },
      "items": [
        {
          "text": "inni utuma iyyanni rakkattootaa qajeelaa taʼee jiruu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.7",
            "verseOrgIds": [
              "ISA.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:7"
      },
      "items": [
        {
          "text": "sobumaan hiyyeeyyii balleessuuf jedhee jalʼina yaada.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.7",
            "verseOrgIds": [
              "ISA.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni ulfina qabeessi garuu karoora ulfaataa baasa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.8",
            "verseOrgIds": [
              "ISA.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:8"
      },
      "items": [
        {
          "text": "hojii ulfina qabeessa sanattis ni jabaata.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.8",
            "verseOrgIds": [
              "ISA.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dubartoota Yerusaalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa dubartoota akka malee boontan",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.9",
            "verseOrgIds": [
              "ISA.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:9"
      },
      "items": [
        {
          "text": "kaʼaatii na dhaggeeffadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.9",
            "verseOrgIds": [
              "ISA.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 32:9"
      },
      "items": [
        {
          "text": "yaa intallan waan nagaa qabdan of seetan",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.9",
            "verseOrgIds": [
              "ISA.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:9"
      },
      "items": [
        {
          "text": "waan ani jedhu dhagaʼaa!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.9",
            "verseOrgIds": [
              "ISA.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin warri waan nagaa qabdan of seetan",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.10",
            "verseOrgIds": [
              "ISA.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:10"
      },
      "items": [
        {
          "text": "erga waggaan tokko xinnuma darbee booddee ni hollattu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.10",
            "verseOrgIds": [
              "ISA.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 32:10"
      },
      "items": [
        {
          "text": "wayiniin ija hin kennu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.10",
            "verseOrgIds": [
              "ISA.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:10"
      },
      "items": [
        {
          "text": "yeroon itti iji walitti qabamus hin dhufu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.10",
            "verseOrgIds": [
              "ISA.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa dubartoota boontuuwwan isin holladhaa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.11",
            "verseOrgIds": [
              "ISA.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:11"
      },
      "items": [
        {
          "text": "intallan waan nagaa qabdan of seetanis raafamaa!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.11",
            "verseOrgIds": [
              "ISA.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 32:11"
      },
      "items": [
        {
          "text": "Uffata keessan of irraa baasaatii",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.11",
            "verseOrgIds": [
              "ISA.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:11"
      },
      "items": [
        {
          "text": "wayyaa gaddaa mudhii keessanitti hidhadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.11",
            "verseOrgIds": [
              "ISA.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lafa qotiisaa gaariif,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.12",
            "verseOrgIds": [
              "ISA.32.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:12"
      },
      "items": [
        {
          "text": "muka wayinii ija naqatuufis laphee keessan dhaʼaa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.12",
            "verseOrgIds": [
              "ISA.32.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "lafa uummata koo kan qoraattii fi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.13",
            "verseOrgIds": [
              "ISA.32.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 32:13"
      },
      "items": [
        {
          "text": "sokorruun irratti guddatuuf laphee keessan dhaʼaa;",
