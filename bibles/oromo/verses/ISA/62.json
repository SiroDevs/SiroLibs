      "attrs": {
        "style": "q2",
        "vid": "ISA 62:8"
      },
      "items": [
        {
          "text": "nyaata godhee diinota keetiif hin kennu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.8",
            "verseOrgIds": [
              "ISA.62.8"
            ]
