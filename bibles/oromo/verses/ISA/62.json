          "text": "ati maqaa haaraa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.2",
            "verseOrgIds": [
              "ISA.62.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:2"
      },
      "items": [
