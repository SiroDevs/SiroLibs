          "attrs": {
            "verseId": "ISA.62.4",
            "verseOrgIds": [
              "ISA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:4"
      },
      "items": [
        {
          "text": "yookaan biyyi kee Ontuu hin jedhamtu.",
