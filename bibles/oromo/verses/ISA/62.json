        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "ISA.62.3",
                "verseOrgIds": [
                  "ISA.62.3"
                ]
              }
            }
          ]
        },
        {
          "text": "keessatti gonfoo ulfinaa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.3",
            "verseOrgIds": [
              "ISA.62.3"
            ]
          }
        }
      ]
