      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:2"
      },
      "items": [
        {
          "text": "mootonni hundinuus ulfina kee ni argu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.2",
            "verseOrgIds": [
              "ISA.62.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 62:2"
      },
      "items": [
