  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "EST 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waan Asteer Mooticha Kadhatte",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa sadaffaatti Asteer uffata ishee kan mootummaa uffatee dhaqxee oobdii masaraa mootichaa kan gara keessaa irra fuula galma mootichaa dura dhaabatte. Mootichi immoo galma sana keessa gara balbalaatti garagalee teessoo mootummaa isaa irra taaʼee ture.",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.1",
            "verseOrgIds": [
              "EST.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis utuu Asteer Mootittiin oobdii keessa dhaabachaa jirtuu argee isheetti gammadee bokkuu warqee kan harkatti qabatee ture sana isheef diriirse. Kanaafuu Asteer itti dhiʼaattee fiixee bokkuu sanaa tuqxe.",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.2",
            "verseOrgIds": [
              "EST.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichi, \"Yaa Asteer Mootittii maal siif godhu? Maal barbaadda? Walakkaa mootummaa koo illee taanaan siif ni kennama\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.3",
            "verseOrgIds": [
              "EST.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asteeris, \"Yoo wanni kun mooticha gammachiise, mootichi gara cidha ani isaaf qopheesse sanaa Haamaan wajjin harʼa haa dhufu\" jettee deebifteef.",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.4",
            "verseOrgIds": [
              "EST.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis, \"Akka waan Asteer jette sana goonuuf dafaatii Hamaa fidaa\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.5",
            "verseOrgIds": [
              "EST.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EST 5:5"
      },
      "items": [
        {
          "text": "Kanaafuu mootichii fi Haamaan gara cidha Asteer qopheessite sanaa dhaqan.",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.5",
            "verseOrgIds": [
              "EST.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuma daadhii wayinii dhuganuu mootichi amma illee akkana jedhee Asteerin gaafate; \"Mee wanni ati kadhattu maal? Wanni sun siif kennama. Gaaffiin kee maali? Walakkaa mootummaa koo illee taanaan siif kennama.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.6",
            "verseOrgIds": [
              "EST.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asteeris akkana jettee deebifteef; \"Wanni ani kadhadhuu fi gaaffiin koo kanaa dha:",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.7",
            "verseOrgIds": [
              "EST.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo ani fuula mootichaa duratti surraa argadhee mootichis kadhannaa koo fudhatee waan ani isa gaafadhe naaf guutuun isa gammachiise, mootichii fi Haamaan cidha ani isaaniif qopheessu irratti bor haa argaman. Ani ergasii gaaffii mootichaa nan deebisa.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.8",
            "verseOrgIds": [
              "EST.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Haamaan Mordekaayiitti Aaruu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafas Haamaan gammadee itti tolee gad baʼe. Inni garuu karra mootichaa duratti Mordekaayiin argee yommuu akka inni isaaf hin kaʼin yookaan isa hin sodaatin hubatetti Mordekaayiitti akka malee aare.",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.9",
            "verseOrgIds": [
              "EST.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼu illee Haamaan of qabee mana isaatti gale.",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.10",
            "verseOrgIds": [
              "EST.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EST 5:10"
      },
      "items": [
        {
          "text": "Ergasiis michoota isaatii fi niitii isaa Zeresh walitti qabe;",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.10",
            "verseOrgIds": [
              "EST.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haamaanis qabeenya isaa guddaa sanaan, ilmaan isaa hedduu sanaan akkasumas ulfina mootichi isaaf kenne hundaa fi akkaataa itti mootichi qondaaltota isaatii fi tajaajiltoota isaa kaanii olitti isa guddiseen isaanitti of jaje.",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.11",
            "verseOrgIds": [
              "EST.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haamaan itti fufee akkana jedhe; \"Kana qofa miti; namni Asteer Mootittiin akka mooticha wajjin gara cidha qopheessite sanaa dhufu waamte anuma qofa. Boris akkasuma mooticha wajjin na affeerteerti.",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.12",
            "verseOrgIds": [
              "EST.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus wanni kun hundinuu utuu ani Mordekaayi Yihuudicha isaa karra mootichaa dura taaʼu arguu na hin gammachiisu.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.13",
            "verseOrgIds": [
              "EST.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niitiin isaa Zeresh fi michoonni isaa hundinuu, \"Muka itti nama fannisan kan dhundhuma shantama ol dheeratu dhaabiitii akka Mordekaayi bor ganama irratti fannifamu mooticha gaafadhu. Ergasiis mooticha wajjin gara cidha sanaa dhaqii gammadi\" jedhaniin. Yaadni kun Haamaanin gammachiise; innis muka sana dhaabe.",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.14",
            "verseOrgIds": [
              "EST.5.14"
            ]
          }
        }
      ]
    }
  ],
