    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Haamaan Yihuudoota Balleessuuf Malate",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan kanneen booddee Ahashweroos Mootichi Haamaan ilma Hamedaataa namicha biyya Agaag ol ol qabuudhaan teessoo qondaaltota kaanii hunda caalu kenneefii isa kabaje.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.1",
            "verseOrgIds": [
              "EST.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qondaaltonni mootichaa warri karra eegan hundi jilbeenfatanii Haamaaniif ulfina kennan; mootichi waaʼee isaa waan kana ajajee tureetii. Mordekaayi garuu hin jilbeenfanne yookaan ulfina isaaf hin kennine.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.2",
            "verseOrgIds": [
              "EST.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qondaaltonni mootichaa warri karra mootichaa dura turan, \"Ati maaliif ajaja mootichaa eeguu didda?\" jedhanii Mordekaayiin gaafatan.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.3",
            "verseOrgIds": [
              "EST.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan guyyuma guyyaadhaan isatti himaa turan; inni garuu isaan dhagaʼuu dide. Kanaafuu isaan sababii Mordekaayi akka nama gosa Yihuudaa taʼe isaanitti hime tureef dubbiin isaa kun akka maal taʼuu qabu beekuudhaaf waan kana Haamaanitti himan.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.4",
            "verseOrgIds": [
              "EST.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haamaan akka Mordekaayi isaaf hin jilbeenfatin yookaan ulfina hin kenniniif arginaan akka malee aare.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.5",
            "verseOrgIds": [
              "EST.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haamaanis eenyummaa saba Mordekaayi beeknaan Mordekaayiin qofa ajjeesuu ni tuffate. Qooda kanaa Haamaan saba Mordekaayi hunda jechuunis Yihuudoota mootummaa Ahashweroos guutuu keessa jiraatan fixuuf karaa barbaadaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.6",
            "verseOrgIds": [
              "EST.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis waggaa kudha lammaffaa bara Ahashweroos Mootichaa keessa jiʼa jalqabaa jiʼa Niisaan jedhamu keessa guyyaa fi jiʼa filachuudhaaf fuula Haamaan duratti",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.7",
            "verseOrgIds": [
              "EST.3.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "Fuur",
              "type": "text",
              "attrs": {
                "verseId": "EST.3.7",
                "verseOrgIds": [
                  "EST.3.7"
                ]
              }
            }
          ]
        },
        {
          "text": "jechuunis ixaa buusan. Ixaan sun jiʼa kudha lammaffaa jechuunis jiʼa Adaar irra buʼe.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.7",
            "verseOrgIds": [
              "EST.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haamaanis Ahashweroos Mootichaan akkana jedhe; \"Uummanni tokko saba kutaalee biyyaa mootummaa keetii keessa jiran hunda gidduu faffacaʼeera; duudhaan uummata kanaa duudhaa saba kaanii hundaan adda; isaan seera mootichaa hin kabajan; kanaafuu mootichi uummata kanaaf obsa qabaachuun hin malu.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.8",
            "verseOrgIds": [
              "EST.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo wanni kun mooticha gammachiise saba kana balleessuudhaaf labsiin tokko haa baʼu; anis warra waan kana hojjetaniif meetii taalaantii kuma kudhan mankuusa qabeenya mootichaatti nan galcha.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.9",
            "verseOrgIds": [
              "EST.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu mootichi qubeelaa chaappaa isaa quba ofii irraa baasee Haamaan ilma Hamedaataa namicha biyya Agaag, diina Yihuudootaa sanatti kenne.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.10",
            "verseOrgIds": [
              "EST.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis Haamaaniin, \"Maallaqnis, sabni sunis sitti kennameeraatii akkuma feete godhi\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.11",
            "verseOrgIds": [
              "EST.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa kudha sadaffaa jiʼa jalqabaatti barreessitoonni mootichaa walitti waamaman. Isaanis waan Haamaan ajaje sana hunda arfii tokkoo tokkoo kutaa biyyaatiin, afaan saba hundaatiinis gara biyya bulchitoota mootichaatti, bulchitoota tokkoo tokkoo kutaalee biyyaatii fi gara gurguddoota saba adda addaatti barreessan. Wanni kunis maqaa Ahashweroos Mootichaatiin barreeffamee, qubeelaa chaappaa isaatiin mallatteeffame.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.12",
            "verseOrgIds": [
              "EST.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Xalayoonni akka Yihuudoonni hundi dargaggoonnii fi maanguddoonni, dubartoonnii fi ijoolleen xixinnoon guyyuma tokkotti jechuunis guyyaa kudha sadaffaa jiʼa kudha lammaffaatti, jiʼa Adaar jedhamu keessa ajjeefaman, akka barbadeeffamanii fi lafa irraa balleeffaman, akka qabeenyi isaaniis saamamu gara kutaalee biyya mootichaa hundaatti ajajaan ergamootaan ergaman.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.13",
            "verseOrgIds": [
              "EST.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka sabni hundi beekee guyyaa sanaaf qophaaʼuufis garagalchi barreeffama sanaas akka seeraatti kutaalee biyyaa hunda keessatti saba hundatti labsamuu qaba ture.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.14",
            "verseOrgIds": [
              "EST.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergamoonni sun ajaja mootichaatiin ariitiidhaan deeman; labsiin sunis Suusaa magaalaa guddittii keessatti labsame. Mootichi fi Haamaan waa dhuguudhaaf taaʼan; magaalaan Suusaa garuu ni jeeqamte.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.15",
            "verseOrgIds": [
              "EST.3.15"
            ]
          }
        }
      ]
    }
  ],
