        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Fakkeenya kana muka harbuu irraa baradhaa; yommuu dameen isaa latee baala baafatutti akka bonni dhiʼaate ni beektu.",
