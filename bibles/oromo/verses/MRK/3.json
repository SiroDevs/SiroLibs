  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "MRK 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesuus Guyyaa Sanbataatiin Fayyisuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammas Yesuus mana sagadaa seene; namichi harki irratti goge tokkos achi ture.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.1",
            "verseOrgIds": [
              "MRK.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan keessaas namoonni tokko tokko Yesuusin himachuuf jedhanii sababa barbaadaa turan; kanaafuu akka inni Sanbataan namicha fayyisu ilaaluuf isa gaadan.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.2",
            "verseOrgIds": [
              "MRK.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis namicha harki irratti goge sanaan,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.3",
            "verseOrgIds": [
              "MRK.3.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kaʼii fuula nama hundaa dura dhaabadhu\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.3.3",
                "verseOrgIds": [
                  "MRK.3.3"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.3",
            "verseOrgIds": [
              "MRK.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.4",
            "verseOrgIds": [
              "MRK.3.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Sanbataan isa kamtu eeyyamamaa dha? Waan gaarii hojjechuu moo waan hamaa hojjechuu? Lubbuu oolchuu moo ajjeesuu?\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.3.4",
                "verseOrgIds": [
                  "MRK.3.4"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhee isaan gaafate. Isaan garuu ni calʼisan.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.4",
            "verseOrgIds": [
              "MRK.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis mata jabina isaaniitti akka malee gaddee, aariidhaan garagalee isaan ilaale; namicha sanaanis,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.5",
            "verseOrgIds": [
              "MRK.3.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Harka kee diriirfadhu!\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.3.5",
                "verseOrgIds": [
                  "MRK.3.5"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhe. Namichis harka diriirfate; harki isaas guutumaan guutuutti fayye.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.5",
            "verseOrgIds": [
              "MRK.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fariisonnis gad baʼanii akka ittiin Yesuusin ajjeesuu dandaʼan garee Heroodis wajjin mariʼachuu jalqaban.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.6",
            "verseOrgIds": [
              "MRK.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Namoonni Yesuus Duukaa Buʼan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
