    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haatii fi obboloonni isaa dhufanii, ala dhaabatanii nama itti erganii isa waamsisan.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.31",
            "verseOrgIds": [
              "MRK.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni baayʼeenis isatti naannaʼanii taaʼaa turan; isaanis, \"Haati keetii fi obboloonni kee ala dhadhaabatanii si iyyaafachaa jiru\" jedhanii isatti himan.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.32",
            "verseOrgIds": [
              "MRK.3.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 3:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni immoo,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.33",
            "verseOrgIds": [
              "MRK.3.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Haati kootii fi obboloonni koo eenyu?\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.3.33",
                "verseOrgIds": [
                  "MRK.3.33"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.33",
            "verseOrgIds": [
              "MRK.3.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 3:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis warra naannoo isaa marsanii tataaʼan ilaalee akkana jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.34",
            "verseOrgIds": [
              "MRK.3.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Haati kootii fi obboloonni koo kunoo ti!",
              "type": "text",
              "attrs": {
                "verseId": "MRK.3.34",
                "verseOrgIds": [
                  "MRK.3.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.34",
            "verseOrgIds": [
              "MRK.3.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 3:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Namni fedhii Waaqaa raawwatu kam iyyuu obboleessa koo ti; obboleettii koo ti; haadha kootis.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.3.35",
                "verseOrgIds": [
                  "MRK.3.35"
                ]
              }
            }
          ]
        }
      ]
    }
