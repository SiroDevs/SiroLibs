    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis tulluutti ol baʼee warra ofii isaatii barbaade ofitti waame; isaanis gara isaa dhufan.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.13",
            "verseOrgIds": [
              "MRK.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akka isaan isa wajjin jiraatanii fi akka lallabaaf isaan erguuf namoota kudha lama muudee barattoota jedhee moggaase;",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.14",
            "verseOrgIds": [
              "MRK.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "akka isaan hafuurota hamoo baasaniifis taayitaa kenneef.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.15",
            "verseOrgIds": [
              "MRK.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lh"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri kudha lamaan inni muudes isaan kana:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "MRK 3:16"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MRK 3:16"
      },
      "items": [
        {
          "text": "Simoon isa inni \"Phexros\" jedhee moggaase,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.16",
            "verseOrgIds": [
              "MRK.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaaqoob ilma Zabdewoosii fi obboleessa isaa Yohannis warra inni \"Boʼanergees\" jedhee moggaase; Boʼanergees jechuun ilmaan \"Kakawwee\" jechuu dha;",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.17",
            "verseOrgIds": [
              "MRK.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indiriiyaas,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.18",
            "verseOrgIds": [
              "MRK.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MRK 3:18"
      },
      "items": [
        {
          "text": "Fiiliphoos,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.18",
            "verseOrgIds": [
              "MRK.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MRK 3:18"
      },
      "items": [
        {
          "text": "Bartaloomewoos,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.18",
            "verseOrgIds": [
              "MRK.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MRK 3:18"
      },
      "items": [
        {
          "text": "Maatewos,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.18",
            "verseOrgIds": [
              "MRK.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MRK 3:18"
      },
      "items": [
        {
          "text": "Toomaas,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.18",
            "verseOrgIds": [
              "MRK.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MRK 3:18"
      },
      "items": [
        {
          "text": "Yaaqoob ilma Alfewoos,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.18",
            "verseOrgIds": [
              "MRK.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MRK 3:18"
      },
      "items": [
        {
          "text": "Taadewoos,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.18",
            "verseOrgIds": [
              "MRK.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MRK 3:18"
      },
      "items": [
        {
          "text": "Simoon Hinaafticha,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.18",
            "verseOrgIds": [
              "MRK.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
