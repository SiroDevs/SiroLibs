  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "PRO 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati waaʼee boriitiin hin boonin;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.1",
            "verseOrgIds": [
              "PRO.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:1"
      },
      "items": [
        {
          "text": "waan guyyaan fidu hin beektuutii.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.1",
            "verseOrgIds": [
              "PRO.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni biraa si haa jaju malee ati afaan keetiin of hin jajin;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.2",
            "verseOrgIds": [
              "PRO.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:2"
      },
      "items": [
        {
          "text": "namni kaan si haa jajuu malee hidhiin kee si hin jajin.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.2",
            "verseOrgIds": [
              "PRO.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhagaan ni ulfaata; cirrachis baʼaa dha;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.3",
            "verseOrgIds": [
              "PRO.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:3"
      },
      "items": [
        {
          "text": "tuttuqaan gowwaa garuu lachuu caalaa ulfaata.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.3",
            "verseOrgIds": [
              "PRO.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dheekkamsi gara jabeessa; aariinis guutee dhangalaʼa;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.4",
            "verseOrgIds": [
              "PRO.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:4"
      },
      "items": [
        {
          "text": "hinaaffaa dura garuu eenyutu dhaabachuu dandaʼa?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.4",
            "verseOrgIds": [
              "PRO.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jaalala dhokfamee mannaa",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.5",
            "verseOrgIds": [
              "PRO.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:5"
      },
      "items": [
        {
          "text": "ifannaa ifatti baʼe wayya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.5",
            "verseOrgIds": [
              "PRO.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madaan michuun nama madeessu amanamaa dha;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.6",
            "verseOrgIds": [
              "PRO.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:6"
      },
      "items": [
        {
          "text": "dhungachuun diinaa garuu gowwoomsaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.6",
            "verseOrgIds": [
              "PRO.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni quufe damma illee ni balfa;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.7",
            "verseOrgIds": [
              "PRO.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:7"
      },
      "items": [
        {
          "text": "kan beelaʼe garuu wanni hadhaaʼu iyyuu itti miʼaawa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.7",
            "verseOrgIds": [
              "PRO.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni mana isaatii badu tokko,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.8",
            "verseOrgIds": [
              "PRO.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:8"
      },
      "items": [
        {
          "text": "akkuma simbirroo manʼee isheetii badduu ti.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.8",
            "verseOrgIds": [
              "PRO.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shittoo fi ixaanni garaa nama gammachiisu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.9",
            "verseOrgIds": [
              "PRO.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:9"
      },
      "items": [
        {
          "text": "gorsi michuus garaa nama ciibsa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.9",
            "verseOrgIds": [
              "PRO.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Michoota keetii fi michoota abbaa keetii hin gatin;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.10",
            "verseOrgIds": [
              "PRO.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:10"
      },
      "items": [
        {
          "text": "yoo balaan sitti dhufe mana obboleessa keetii hin dhaqin;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.10",
            "verseOrgIds": [
              "PRO.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:10"
      },
      "items": [
        {
          "text": "obboleessa fagoo jiru irra ollaa dhiʼoo jiru wayya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.10",
            "verseOrgIds": [
              "PRO.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa ilma ko, ogeessa taʼiitii garaa koo gammachiisi;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.11",
            "verseOrgIds": [
              "PRO.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:11"
      },
      "items": [
        {
          "text": "ergasii ani nama na tuffatu hundaaf",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.11",
            "verseOrgIds": [
              "PRO.27.11"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "deebii kennuu nan dandaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.11",
            "verseOrgIds": [
              "PRO.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni hubataan balaa argee jalaa dhokata;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.12",
            "verseOrgIds": [
              "PRO.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:12"
      },
      "items": [
        {
          "text": "wallaalaan immoo ittuma deemee adabama.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.12",
            "verseOrgIds": [
              "PRO.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama nama ormaatiif wabii taʼe irraa uffata isaa fudhadhu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.13",
            "verseOrgIds": [
              "PRO.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:13"
      },
      "items": [
        {
          "text": "yoo inni dubartii ormaatiif wabii taʼes uffata sana qabdii qabadhu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.13",
            "verseOrgIds": [
              "PRO.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni tokko ganamaan sagalee ol fudhatee",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.14",
            "verseOrgIds": [
              "PRO.27.14"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "ollaa isaa yoo eebbise",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.14",
            "verseOrgIds": [
              "PRO.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:14"
      },
      "items": [
        {
          "text": "wanni sun akka abaarsaatti fudhatama.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.14",
            "verseOrgIds": [
              "PRO.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niitiin nyakkiftuun, akkuma bokkaa guyyaa roobaa",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.15",
            "verseOrgIds": [
              "PRO.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:15"
      },
      "items": [
        {
          "text": "dhimmisaa ooluu ti;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.15",
            "verseOrgIds": [
              "PRO.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ishee ittisuun akkuma bubbee ittisuu ti",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.16",
            "verseOrgIds": [
              "PRO.27.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 27:16"
      },
      "items": [
        {
          "text": "yookaan akkuma zayitii harkaan qabuu ti.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.16",
            "verseOrgIds": [
              "PRO.27.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
