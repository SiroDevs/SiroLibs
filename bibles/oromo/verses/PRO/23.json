      "attrs": {
        "style": "q2",
        "vid": "PRO 23:29"
      },
      "items": [
        {
          "text": "Eenyutu sababii malee madaaʼa? Kan iji isaa diimatu eenyu?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.29",
            "verseOrgIds": [
              "PRO.23.29"
            ]
          }
