    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filisxeemonni yeroo kanatti Israaʼelitti waraana kaasan; Israaʼeloonnis isaan duraa baqatan; hedduun isaaniis Tulluu Gilboʼaa irratti dhuman.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.1",
            "verseOrgIds": [
              "1SA.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filisxeemonni ittuma jabeessanii Saaʼolii fi ilmaan isaa ariʼan; isaanis ilmaan isaa jechuunis Yoonaataan, Abiinaadaabii fi Malkii-Shuwaa ajjeesan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.2",
            "verseOrgIds": [
              "1SA.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lollis naannoo Saaʼolitti baayʼee cime; warri xiyyaan lolanis isa qaqqabanii akka malee isa madeessan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.3",
            "verseOrgIds": [
              "1SA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saaʼolis namicha miʼa lolaa isaa baatuun, \"Goraadee kee luqqifadhuutii na waraani; yoo kanaa achii namoonni dhagna hin qabamin kunneen dhufanii na waraananii natti taphatuu\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.4",
            "verseOrgIds": [
              "1SA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 31:4"
      },
      "items": [
        {
          "text": "Namichi miʼa lolaa baatuuf sun garuu waan akka malee sodaateef isa hin waraanne; kanaafuu Saaʼol goraadee ofii isaa luqqifatee irratti kufe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.4",
            "verseOrgIds": [
              "1SA.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichi miʼa lolaa baatu sun yommuu akka Saaʼol duʼe argetti innis goraadee ofii isaa irratti kufee Saaʼol wajjin duʼe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.5",
            "verseOrgIds": [
              "1SA.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Saaʼolii fi ilmaan isaa sadan, namichi miʼa lolaa baatuu fi namoonni isaa hundinuu gaafasuma walumaan dhuman.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.6",
            "verseOrgIds": [
              "1SA.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼeloonni qarqara sululaatii fi gama Yordaanos jiran yommuu akka loltoonni Israaʼel baqatanii fi akka Saaʼolii fi ilmaan isaas dhuman arganitti magaalaawwan isaanii dhiisanii baqatan. Filisxeemonni immoo dhufanii keessa qubatan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.7",
            "verseOrgIds": [
              "1SA.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filisxeemonnis guyyaa itti aanutti yommuu warra dhuman irraa hidhannaa hiikkachuu dhufanitti, akka Saaʼolii fi ilmaan isaa sadan Tulluu Gilboʼaa irratti kukkufanii jiran argan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.8",
            "verseOrgIds": [
              "1SA.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis mataa Saaʼol irraa kutanii, miʼa lolaa isa irraa fudhatanii akka isaan mana waaqota tolfamoo isaanii keessattii fi saba isaaniitiif oduu kana labsaniif guutummaa biyya Filisxeemotaa keessa ergamoota ergan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.9",
            "verseOrgIds": [
              "1SA.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis miʼa lolaa isaa mana Ashtooreti waaqicha tolfamaa keessa kaaʼan; reeffa isaa immoo dallaa Beet Shaanitti hodhan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.10",
            "verseOrgIds": [
              "1SA.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni Yaabeesh Giliʼaad yommuu waan Filisxeemonni Saaʼolin godhan dhagaʼanitti,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.11",
            "verseOrgIds": [
              "1SA.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "namoonni jajjaboon isaanii hundi halkaniin kaʼanii dhaqanii reeffa Saaʼolii fi reeffa ilmaan isaa dallaa Beet Shaan irraa buusanii gara Yaabeeshitti fidanii achitti guban.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.12",
            "verseOrgIds": [
              "1SA.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii lafee isaanii fuudhanii Yaabeeshitti muka tamirii jalatti awwaalan; bultii torbas ni sooman.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.13",
            "verseOrgIds": [
              "1SA.31.13"
            ]
          }
        }
      ]
    }
  ],
