          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni hundinuus Saamuʼeeliin, \"Akka nu tajaajiltoonni kee hin dhumneef",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.19",
            "verseOrgIds": [
              "1SA.12.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "1SA.12.19",
                "verseOrgIds": [
                  "1SA.12.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa kee nuuf kadhadhu; nu cubbuu keenya hunda irratti daballee mootiin nurratti akka moʼu gaafachuudhaan daba hojjenneerraatii\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.19",
            "verseOrgIds": [
              "1SA.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saamuʼeelis deebisee akkana jedhe; \"Hin sodaatinaa; isin hammina kana hunda raawwattaniirtu; taʼus garaa guutuudhaan",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.20",
            "verseOrgIds": [
              "1SA.12.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "1SA.12.20",
                "verseOrgIds": [
                  "1SA.12.20"
                ]
              }
            }
          ]
        },
        {
          "text": "tajaajilaa malee",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.20",
            "verseOrgIds": [
              "1SA.12.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.12.20",
                "verseOrgIds": [
                  "1SA.12.20"
                ]
              }
            }
          ]
        },
        {
          "text": "irraa hin deebiʼinaa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.20",
            "verseOrgIds": [
              "1SA.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garagaltanii wantoota faayidaa hin qabne kanneen isin fayyaduu yookaan isin oolchuu hin dandeenye duukaa hin buʼinaa; isaan faayidaa hin qabaniitii.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.21",
            "verseOrgIds": [
              "1SA.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.12.22",
                "verseOrgIds": [
                  "1SA.12.22"
                ]
              }
            }
          ]
        },
        {
          "text": "sababii maqaa isaa guddaa sanaatiif jedhee saba isaa hin gatu;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.22",
            "verseOrgIds": [
              "1SA.12.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.12.22",
                "verseOrgIds": [
                  "1SA.12.22"
                ]
              }
            }
          ]
        },
        {
          "text": "kan ofii isaa isin godhachuu jaallateeraatii.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.22",
            "verseOrgIds": [
              "1SA.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka yaada kootti ani isinii kadhachuu dhiisee",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.23",
            "verseOrgIds": [
              "1SA.12.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyotti",
              "type": "text",
              "attrs": {
                "verseId": "1SA.12.23",
                "verseOrgIds": [
                  "1SA.12.23"
                ]
              }
            }
          ]
        },
        {
          "text": "yakka hojjechuun narraa haa fagaatu. Ani karaa gaarii fi qajeelaa taʼe isin nan barsiisa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.23",
            "verseOrgIds": [
              "1SA.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.24",
            "verseOrgIds": [
              "1SA.12.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "1SA.12.24",
                "verseOrgIds": [
                  "1SA.12.24"
                ]
              }
            }
          ]
        },
        {
          "text": "sodaadhaa; garaa keessan guutuunis amanamuudhaan isaaf hojjedhaa; waan guddaa inni isinii godhes yaadadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.24",
            "verseOrgIds": [
              "1SA.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo hammina hojjechuu itti fuftan garuu, isinis mootiin keessanis ni baddu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.25",
            "verseOrgIds": [
              "1SA.12.25"
            ]
          }
        }
