          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti Saamuʼeel",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.18",
            "verseOrgIds": [
              "1SA.12.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "1SA.12.18",
                "verseOrgIds": [
                  "1SA.12.18"
                ]
              }
            }
          ]
        },
        {
          "text": "waammate;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.18",
            "verseOrgIds": [
              "1SA.12.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "1SA.12.18",
                "verseOrgIds": [
                  "1SA.12.18"
                ]
              }
            }
          ]
        },
        {
          "text": "yeruma sana qaqawweessaa fi bokkaa erge. Namoonni hundinuus",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.18",
            "verseOrgIds": [
              "1SA.12.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.12.18",
                "verseOrgIds": [
                  "1SA.12.18"
                ]
              }
            }
          ]
        },
        {
          "text": "fi Saamuʼeelin akka malee sodaatan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.18",
            "verseOrgIds": [
              "1SA.12.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
