  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "1SA 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhalachuu Saamuʼeel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namicha biyya gaara Efreem keessa Raamaatayiim Zoofiim jiraatu kan maqaan isaa Elqaanaa jedhamu tokkotu ture; innis ilma Yeroohaam, ilma Eliihuu, ilma Toohuu, ilma Zuufi, ilma Naasiib ture.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.1",
            "verseOrgIds": [
              "1SA.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis niitii lama qaba ture; maqaan ishee tokko Haannaa, kaan immoo Pheniinaa jedhama ture. Pheniinaan ijoollee qabdi; Haannaan garuu ijoollee tokko illee hin qabdu ture.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.2",
            "verseOrgIds": [
              "1SA.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elqaanaan wagguma waggaadhaan",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.3",
            "verseOrgIds": [
              "1SA.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.3",
                "verseOrgIds": [
                  "1SA.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼuuf aarsaa dhiʼeessuu fi sagaduudhaaf magaalaa jiraatuu kaʼee gara Shiilootti ol baʼa ture. Achittis ilmaan Eelii lamaan Hofniinii fi Fiinehaas luboota",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.3",
            "verseOrgIds": [
              "1SA.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.3",
                "verseOrgIds": [
                  "1SA.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "turan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.3",
            "verseOrgIds": [
              "1SA.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu guyyaan itti Elqaanaan aarsaa dhiʼeessu gaʼutti inni niitii isaa Pheniinaa, ilmaan isaatii fi intallan isaa hundaaf foon sana irraa qooda isaanii ni kenna ture.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.4",
            "verseOrgIds": [
              "1SA.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni sababii Haannaa jaallatuuf qooda harka lama isheedhaaf kenna ture;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.5",
            "verseOrgIds": [
              "1SA.1.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.5",
                "verseOrgIds": [
                  "1SA.1.5"
                ]
              }
            }
          ]
        },
        {
          "text": "garuu gadameessa ishee cufee ture.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.5",
            "verseOrgIds": [
              "1SA.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.6",
            "verseOrgIds": [
              "1SA.1.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.6",
                "verseOrgIds": [
                  "1SA.1.6"
                ]
              }
            }
          ]
        },
        {
          "text": "gadameessa Haannaa cufeef masaanuun ishee akka isheen aartuuf ishee tuttuqaa turte.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.6",
            "verseOrgIds": [
              "1SA.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunis wagguma waggaadhaan itti fufe. Yeroo Haannaan gara mana",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.7",
            "verseOrgIds": [
              "1SA.1.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootti",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.7",
                "verseOrgIds": [
                  "1SA.1.7"
                ]
              }
            }
          ]
        },
        {
          "text": "ol baatutti masaanuun ishee, ishee tuttuqaa turte; kanaafuu Haannaan ni boossi, nyaatas hin nyaattu turte.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.7",
            "verseOrgIds": [
              "1SA.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhirsi ishee Elqaanaanis, \"Haannaa ati maaliif boossa? Maaliif hin nyaattu? Garaan kee maaliif gaddaa? Ani ilmaan kudhan siif hin caaluu?\" Isheen jedha ture.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.8",
            "verseOrgIds": [
              "1SA.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafa tokko isaan Shiilootti erga nyaatanii dhuganii booddee Haannaan ol kaatee dhaabate. Eeliin lubichi dhaaba balbala mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.9",
            "verseOrgIds": [
              "1SA.1.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.9",
                "verseOrgIds": [
                  "1SA.1.9"
                ]
              }
            }
          ]
        },
        {
          "text": "bira barcuma irra taaʼaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.9",
            "verseOrgIds": [
              "1SA.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haannaanis guddaa gadditee hiqqifatee booʼuudhaan",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.10",
            "verseOrgIds": [
              "1SA.1.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.10",
                "verseOrgIds": [
                  "1SA.1.10"
                ]
              }
            }
          ]
        },
        {
          "text": "kadhatte.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.10",
            "verseOrgIds": [
              "1SA.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkanas jettee wareegde; \"Yaa",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.11",
            "verseOrgIds": [
              "1SA.1.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.11",
                "verseOrgIds": [
                  "1SA.1.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandeessu, yoo ati dhiphina garbittii keetii ilaaltee na yaadatte, yoo ati garbittii kee dagachuu baattee ilma naa kennite ani bara jireenya isaa guutuu isa",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.11",
            "verseOrgIds": [
              "1SA.1.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.11",
                "verseOrgIds": [
                  "1SA.1.11"
                ]
              }
            }
          ]
        },
        {
          "text": "nan kenna; qarabaan tokko iyyuu mataa isaa hin tuqu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.11",
            "verseOrgIds": [
              "1SA.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo Haannaan ittuma fuftee fuula",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.12",
            "verseOrgIds": [
              "1SA.1.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.12",
                "verseOrgIds": [
                  "1SA.1.12"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti kadhachaa turtettis Eeliin afaan ishee ilaalaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.12",
            "verseOrgIds": [
              "1SA.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haannaanis garaa isheetti kadhachaa turte; hidhii isheetu sochoʼa malees sagaleen ishee hin dhagaʼamu ture. Kanaafuu Eeliin waan isheen machoofte seʼee,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.13",
            "verseOrgIds": [
              "1SA.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ati hamma yoomiitti machoofta? Daadhii wayinii kee of irraa fageessi\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.14",
            "verseOrgIds": [
              "1SA.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haannaanis akkana jettee deebifte; \"Lakki akkas miti; yaa gooftaa ko, ani dubartii akka malee dhiphatee dha. Ani lubbuu koo fuula",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.15",
            "verseOrgIds": [
              "1SA.1.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.15",
                "verseOrgIds": [
                  "1SA.1.15"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti dhangalaase malee daadhii wayinii yookaan dhugaatii nama macheessu hin dhugne.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.15",
            "verseOrgIds": [
              "1SA.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati garbittii kee akka dubartii faayidaa hin qabne tokkootti hin ilaalin. Ani sababii dhiphinaa fi gadda koo guddaa sanaatiif hamma ammaatti kadhachaara.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.16",
            "verseOrgIds": [
              "1SA.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eeliinis, \"Nagaan deemi; Waaqni Israaʼel waan ati kadhatte siif haa kennu\" jedhee deebiseef.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.17",
            "verseOrgIds": [
              "1SA.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheenis, \"Garbittiin kee fuula kee duratti surraa haa argattu\" jette. Ergasiis deemsa ishee itti fufte; nyaata ni nyaatte; gaddis fuula ishee irratti hin mulʼanne.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.18",
            "verseOrgIds": [
              "1SA.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis guyyaa itti aanu ganama barii kaʼanii fuula",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.19",
            "verseOrgIds": [
              "1SA.1.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.19",
                "verseOrgIds": [
                  "1SA.1.19"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti sagadanii gara mana isaanii Raamaatti deebiʼan. Elqaanaan niitii isaa Haannaa bira gaʼe;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.19",
            "verseOrgIds": [
              "1SA.1.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.19",
                "verseOrgIds": [
                  "1SA.1.19"
                ]
              }
            }
          ]
        },
        {
          "text": "ishee yaadate.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.19",
            "verseOrgIds": [
              "1SA.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haannaan ulfooftee yeroon isaa geenyaan ilma deesse. Maqaa isaas, \"Ani",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.20",
            "verseOrgIds": [
              "1SA.1.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.20",
                "verseOrgIds": [
                  "1SA.1.20"
                ]
              }
            }
          ]
        },
        {
          "text": "irraa isa kadhadheeraatii\" jettee Saamuʼeel jettee moggaafte.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.20",
            "verseOrgIds": [
              "1SA.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Saamuʼeel Waaqaaf kenname",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elqaanaan warra mana isaa jiraatan hunda wajjin",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.21",
            "verseOrgIds": [
              "1SA.1.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.21",
                "verseOrgIds": [
                  "1SA.1.21"
                ]
              }
            }
          ]
        },
        {
          "text": "aarsaa waggaa dhiʼeessuu fi wareega isaa galchuuf ol baʼe;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.21",
            "verseOrgIds": [
              "1SA.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haannaan garuu hin dhaqne. Isheenis dhirsa isheetiin, \"Erga mucaan kun harma guʼee booddee ani isa geesseen fuula",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.22",
            "verseOrgIds": [
              "1SA.1.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.22",
                "verseOrgIds": [
                  "1SA.1.22"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti isa dhiʼeessa; innis jireenya isaa guutuu achuma jiraata\" jette.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.22",
            "verseOrgIds": [
              "1SA.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhirsi ishee Elqaanaanis, \"Waanuma jaallatte godhi; ati hamma harma isa guusiftutti asuma turi;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.23",
            "verseOrgIds": [
              "1SA.1.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.23",
                "verseOrgIds": [
                  "1SA.1.23"
                ]
              }
            }
          ]
        },
        {
          "text": "garuu dubbii isaa fiixaan haa baasu\" jedheen. Kanaafuu dubartittiin mana turtee hamma harma isa guusiftutti ilma ishee hoosifte.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.23",
            "verseOrgIds": [
              "1SA.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishee erga mucicha harma guusiftee booddee mucichaa fi dibicha loonii kan umuriin isaa waggaa sadii taʼe, daakuu iifii",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.24",
            "verseOrgIds": [
              "1SA.1.24"
            ]
          }
        },
        {
          "text": "tokkoo fi daadhii wayinii qalqalloo tokko fudhattee gara Shiiloo gara mana",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.24",
            "verseOrgIds": [
              "1SA.1.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootti",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.24",
                "verseOrgIds": [
                  "1SA.1.24"
                ]
              }
            }
          ]
        },
        {
          "text": "fidde. Mucichis daaʼima ture.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.24",
            "verseOrgIds": [
              "1SA.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis dibicha sana qalanii mucicha gara Eeliitti fidan;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.25",
            "verseOrgIds": [
              "1SA.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "isheenis akkana jetteen; \"Yaa gooftaa ko, duʼa lubbuu keetii ti; dubartiin as si bira dhaabattee",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.26",
            "verseOrgIds": [
              "1SA.1.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.26",
                "verseOrgIds": [
                  "1SA.1.26"
                ]
              }
            }
          ]
        },
        {
          "text": "kadhachaa turte sun anuma.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.26",
            "verseOrgIds": [
              "1SA.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani mucaa kana argachuuf kadhadheera;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.27",
            "verseOrgIds": [
              "1SA.1.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.27",
                "verseOrgIds": [
                  "1SA.1.27"
                ]
              }
            }
          ]
        },
        {
          "text": "waan ani isa kadhadhe naaf kenneera.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.27",
            "verseOrgIds": [
              "1SA.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu ani amma",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.28",
            "verseOrgIds": [
              "1SA.1.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoofan",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.28",
                "verseOrgIds": [
                  "1SA.1.28"
                ]
              }
            }
          ]
        },
        {
          "text": "isa kenna. Bara jireenya isaa guutuu",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.28",
            "verseOrgIds": [
              "1SA.1.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.28",
                "verseOrgIds": [
                  "1SA.1.28"
                ]
              }
            }
          ]
        },
        {
          "text": "ni kennama.\" Isaanis achitti",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.28",
            "verseOrgIds": [
              "1SA.1.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.28",
                "verseOrgIds": [
                  "1SA.1.28"
                ]
              }
            }
          ]
        },
        {
          "text": "sagadan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.28",
            "verseOrgIds": [
              "1SA.1.28"
            ]
          }
        }
