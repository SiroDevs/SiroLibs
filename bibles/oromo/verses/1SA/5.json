        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Filisxeemonni Taabota Boojiʼuu Isaanii",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filisxeemonni erga taabota Waaqaa boojiʼanii booddee Ebeenezerii fuudhanii Ashdooditti geessan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.1",
            "verseOrgIds": [
              "1SA.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis taabota sana gara galma Daagonitti geessanii Daagon bira kaaʼan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.2",
            "verseOrgIds": [
              "1SA.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni Ashdood yommuu guyyaa itti aanu ganamaan kaʼanitti Daagon taabota",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.3",
            "verseOrgIds": [
              "1SA.5.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.5.3",
                "verseOrgIds": [
                  "1SA.5.3"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti addaan lafatti gombifamee argan! Isaanis lafaa kaasanii iddoo isaatti isa deebisan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.3",
            "verseOrgIds": [
              "1SA.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu yommuu isaan guyyaa itti aanu ganama kaʼanitti Daagon taabota",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.4",
            "verseOrgIds": [
              "1SA.5.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.5.4",
                "verseOrgIds": [
                  "1SA.5.4"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti addaan lafatti gombifamee ture! Mataa fi harki isaas irraa caccabee gulantaa balbalaa irra bubbuʼee ture; dhagna isaa qofatu hafe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.4",
            "verseOrgIds": [
              "1SA.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni luboonni Daagon yookaan namni galma Daagon kan Ashdood jiru sana ol seenu kam iyyuu hamma harʼaatti gulantaa balbalaa irra hin ejjenneef kanuma.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.5",
            "verseOrgIds": [
              "1SA.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harki",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.6",
            "verseOrgIds": [
              "1SA.5.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.5.6",
                "verseOrgIds": [
                  "1SA.5.6"
                ]
              }
            }
          ]
        },
        {
          "text": "saba Ashdoodii fi naannoo ishee irratti jabaate; badiisa isaanitti fide; iitoos isaanitti naqe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.6",
            "verseOrgIds": [
              "1SA.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni Ashdoodis yeroo waan taʼaa ture arganitti, \"Sababii harki isaa nuu fi Waaqa keenya Daagon irratti jabaateef taabonni Waaqa Israaʼel as turuu hin qabu\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.7",
            "verseOrgIds": [
              "1SA.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaaf bulchitoota Filisxeem hunda walitti waamanii, \"Taabota Waaqa Israaʼel maal gochuu qabna?\" jedhanii isaan gaafatan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.8",
            "verseOrgIds": [
              "1SA.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 5:8"
      },
      "items": [
        {
          "text": "Isaanis, \"Taabota Waaqa Israaʼel gara Gaati geessaa!\" jedhanii deebisan. Kanaaf taabota Waaqa Israaʼel achii baasan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.8",
            "verseOrgIds": [
              "1SA.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erga taabota sana achii baasanii booddee harki",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.9",
            "verseOrgIds": [
              "1SA.5.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.5.9",
                "verseOrgIds": [
                  "1SA.5.9"
                ]
              }
            }
          ]
        },
        {
          "text": "magaalaa sanatti jabaatee badiisa guddaa fide. Namoota magaalaa sana jiraatanis xinnaadhaa hamma guddaatti dhaʼe; akka dhiitoon isaanitti yaaʼus godhe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.9",
            "verseOrgIds": [
              "1SA.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu taabota Waaqaa gara Eqroonitti ergan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.10",
            "verseOrgIds": [
              "1SA.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 5:10"
      },
      "items": [
        {
          "text": "Akkuma taabonni Waaqaa Eqroon seeneenis namoonni Eqroon, \"Isin nuu fi namoota keenya fixuudhaaf taabota Waaqaa nutti fiddan\" jedhanii iyyan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.10",
            "verseOrgIds": [
              "1SA.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu bulchitoota Filisxeem hunda walitti waamanii, \"Taabota Waaqa Israaʼel asii fageessaa; iddoo isaatti haa deebiʼu; yoo kanaa achii inni nuu fi saba keenya fixa\" jedhaniin. Sodaan duʼaa magaalaa sana guutee tureetii; harki Waaqaas akka malee itti jabaatee ture.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.11",
            "verseOrgIds": [
              "1SA.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri hin duʼinis waan dhiitoon isaanitti yaaʼeef iyyi isaanii samiitti ol baʼe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.12",
            "verseOrgIds": [
              "1SA.5.12"
            ]
          }
        }
      ]
    }
  ],
