    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lh"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qoodni gosa Yihuudaatiif balbala balbalaan ramadame hamma daarii Edoomitti, qarqara kibbaatiin immoo hamma Gammoojjii Siinitti balʼata.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daariin isaanii karaa kibbaa galoo galaanaa qarqara kibba Galaana soogiddaattii jalqabee",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.2",
            "verseOrgIds": [
              "JOS.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kibba Malkaa Aqrabiim qaxxaamuree gara Siin itti fufee hamma kibba Qaadesh Barneetti deema. Ergasiis Hezroon darbee Adaaritti ol baʼee gara Qarqaatti gora.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.3",
            "verseOrgIds": [
              "JOS.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii immoo achii kaʼee karaa Azimooniin darbee hamma lafa goggogaa Gibxiitti dhufee galaana gaʼee dhaabata. Daariin isaanii kan gara kibbaa kanaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.4",
            "verseOrgIds": [
              "JOS.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daariin gara baʼaas Galaana Soogiddaa ture; innis hamma dhuma laga Yordaanositti deema.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.5",
            "verseOrgIds": [
              "JOS.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JOS 15:5"
      },
      "items": [
        {
          "text": "Daariin gara kaabaa immoo galoo galaanaa kan qarqara Yordaanosii jalqabee",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.5",
            "verseOrgIds": [
              "JOS.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "gara Beet Hoglaatti ol baʼee ergasii immoo karaa kaaba Beet Arabbaatiin gara Dhagaa Boohan ilma Ruubeenitti deema.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.6",
            "verseOrgIds": [
              "JOS.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daariin sunis ergasii Sulula Aakoor keessaa Debiiritti ol baʼee gara Gilgaal gama kibba laga sanaatiin fuullee Malkaa Adumiim sanaa kaabatti gora. Daariin kun ittuma fufee gara bishaanota Een Shemeshi darbee Een Roogeelitti gad baʼa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.7",
            "verseOrgIds": [
              "JOS.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis karaa kibba tabba magaalaa Yebuusotaatiin jechuunis Yerusaalemitiin baʼee Sulula Ben Hinoom irraan darba. Achiis baʼee qarqara kaaba Sulula Refaayimitti fiixee tulluu gama lixa Sulula Hinoom jirutti ol baʼe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.8",
            "verseOrgIds": [
              "JOS.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daariin sun ammas fiixee gaaraa irraa kaʼee gara burqaa bishaanota Neftooʼaatti qajeelee magaalaawwan Tulluu Efrooniin baʼee gara Baʼaalaatti jechuunis Kiriyaati Yeʼaariimitti gad buʼe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.9",
            "verseOrgIds": [
              "JOS.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Baʼaalaa irraa Tulluu Seeʼiiriitti gara lixaatti garagalee tabba kaaba Tulluu Yiʼaariim jechuunis Kesaaloon irra baʼee itti fufuudhaan Beet Shemeshitti gad buʼee Tiimnaahitti darba.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.10",
            "verseOrgIds": [
              "JOS.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gara kaaba tabba Eqroonitti darbee Shikeroonitti goree Tulluu Baʼaalaa irra qaxxaamuruudhaan hamma Yabniʼeelitti deema. Daariin sunis galaana gaʼee dhaabate.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.11",
            "verseOrgIds": [
              "JOS.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daariin gara lixaa immoo qarqara Galaana Guddaa ti.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.12",
            "verseOrgIds": [
              "JOS.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "JOS 15:12"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lf",
        "vid": "JOS 15:12"
      },
      "items": [
        {
          "text": "Daariiwwan akkuma balbala gosa isaaniitti saba Yihuudaa marsanis kanneenii dha.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyyaasuun akkuma",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.13",
            "verseOrgIds": [
              "JOS.15.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.15.13",
                "verseOrgIds": [
                  "JOS.15.13"
                ]
              }
            }
          ]
        },
        {
          "text": "isa ajajetti, qooda Yihuudaa irraa kutee Kebroon biyya Kiriyaati Arbaaq jedhamtu sana Kaaleb ilma Yefuneetiif kenne. Arbaaq kunis abbaa Anaaq.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.13",
            "verseOrgIds": [
              "JOS.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaalebis ilmaan Anaaq sadan jechuunis Sheeshaayiin, Ahiimanii fi Talmaayi sanyii Anaaq ariʼee achii baase.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.14",
            "verseOrgIds": [
              "JOS.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achiis namoota biyya Debiir ishee dur Kiriyaati Seefer jedhamaa turte sana keessa jiraatanitti duule.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.15",
            "verseOrgIds": [
              "JOS.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaalebis, \"Ani nama Kiriyaati Seefer lolee qabatutti intala koo Aaksaa nan heerumsiisa\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.16",
            "verseOrgIds": [
              "JOS.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obboleessi Kaaleb, Otniiʼeel ilmi Qenaz magaalattii qabate; Kaalebis intala isaa Aaksaa isatti heerumsiise.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.17",
            "verseOrgIds": [
              "JOS.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheenis yeroo gara Otniiʼeel dhuftetti akka inni abbaa ishee lafa qotiisaa kadhatu isa kakaafte. Kaalebis yommuu isheen harree ishee irraa buutetti, \"Ani maal siif godhu?\" jedhee ishee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.18",
            "verseOrgIds": [
              "JOS.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheenis deebiftee, \"Waan addaa tokko naa godhi. Akkuma Negeeb keessatti lafa naa kennite sana burqaawwan bishaaniis naa kenni\" jetteen. Kaalebis burqaawwan oliitii fi gadii kenneef.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.19",
            "verseOrgIds": [
              "JOS.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lh"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhaalli gosti Yihuudaa balbala balbalaan argate kunoo kana:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negeeb keessaa magaalaawwan gosa Yihuudaa kanneen qarqara kibbaatti daarii Edoom irratti argaman kanneenii dha:",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.21",
            "verseOrgIds": [
              "JOS.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JOS 15:21"
      },
      "items": [
        {
          "text": "Qabziʼeel, Eederi, Yaaguur,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.21",
            "verseOrgIds": [
              "JOS.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qiinaa, Diimonaa, Adiʼaadaa,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.22",
            "verseOrgIds": [
              "JOS.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qaadesh, Haazoor, Yitinaan,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.23",
            "verseOrgIds": [
              "JOS.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ziif, Telem, Baʼaalooti,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.24",
            "verseOrgIds": [
              "JOS.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haazoor Hadaataa, Keriiyooti kan Hezroon jedhamtu sana,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.25",
            "verseOrgIds": [
              "JOS.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaam, Shemaa, Molaadaa,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.26",
            "verseOrgIds": [
              "JOS.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazar Gadaa, Heshmoon, Beet Phelexi,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.27",
            "verseOrgIds": [
              "JOS.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazar Shuuʼaal, Bersheebaa, Biziyootiyaa,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.28",
            "verseOrgIds": [
              "JOS.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baʼaalaa, Iyyiim, Ezem,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.29",
            "verseOrgIds": [
              "JOS.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eltolaad, Kisiil, Hormaa,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.30",
            "verseOrgIds": [
              "JOS.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siiqlaag, Madmaanaa, Saansaanaa,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.31",
            "verseOrgIds": [
              "JOS.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lebaaʼoot, Shiiliihiim, Aayinii fi Rimoonii dha; magaalaawwanii fi gandoonni isaanii walumaa galatti digdamii sagal turan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.32",
            "verseOrgIds": [
              "JOS.15.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karaa sulula lixa biiftuutiin immoo:",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.33",
            "verseOrgIds": [
              "JOS.15.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JOS 15:33"
      },
      "items": [
        {
          "text": "Eshitaaʼol, Zoraa, Ashinaa,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.33",
            "verseOrgIds": [
              "JOS.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOS 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zaanoʼaa, Een Ganiim, Tafuuʼaa, Eenaami,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.34",
            "verseOrgIds": [
              "JOS.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yarmuuti, Adulaam, Sookoo, Azeeqaa,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.35",
            "verseOrgIds": [
              "JOS.15.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JOS 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shaʼarayiim, Aaditaayim, Gedeeraa fi Gedeerootaayimii dha; magaalaawwanii fi gandoonni isaanii kudha afur turan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.36",
            "verseOrgIds": [
              "JOS.15.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JOS 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zenaan, Hadaashaa, Migdaal Gaad,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.37",
            "verseOrgIds": [
              "JOS.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JOS 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diliʼaan, Miisphaa, Yoqtiʼeel,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.38",
            "verseOrgIds": [
              "JOS.15.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JOS 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laakkiish, Boozqaati, Egloon,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.39",
            "verseOrgIds": [
              "JOS.15.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JOS 15:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaboon, Lahimaas, Kiitiliish,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.40",
            "verseOrgIds": [
              "JOS.15.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JOS 15:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gedeerooti, Beet Daagon, Naʼamaa fi Maqeedaa dha; magaalaawwanii fi gandoonni isaanii kudha jaʼa turan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.41",
            "verseOrgIds": [
              "JOS.15.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JOS 15:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Libnaa, Eteeri, Ashaan,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.42",
            "verseOrgIds": [
              "JOS.15.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JOS 15:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yiftaa, Ashinaa, Neziibi,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.43",
            "verseOrgIds": [
              "JOS.15.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JOS 15:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qeyiilaa, Akziibii fi Maareeshaa dha; magaalaawwanii fi gandoonni isaanii sagal turan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.44",
            "verseOrgIds": [
              "JOS.15.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JOS 15:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eqroon, qubatawwanii fi gandoota naannoo ishee jiran wajjin,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.45",
            "verseOrgIds": [
              "JOS.15.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JOS 15:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkasumas karaa lixa Eqrooniitiin qubatawwanii fi gandoota isaanii kanneen naannoo Ashdood jiran hunda,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.46",
            "verseOrgIds": [
              "JOS.15.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JOS 15:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashdood, magaalaa isheetii fi gandoota ishee, Gaazaa, magaalaa isheetii fi gandoota ishee kanneen hamma Laga Gibxii fi hamma qarqara Galaana Guddichaatti jiranii dha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.47",
            "verseOrgIds": [
              "JOS.15.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JOS 15:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biyya gaaraa keessatti immoo:",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.48",
            "verseOrgIds": [
              "JOS.15.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JOS 15:48"
      },
      "items": [
        {
          "text": "Shaamiir, Yatiir, Sookoo,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.48",
            "verseOrgIds": [
              "JOS.15.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JOS 15:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Danaa, Kiriyaati Sanaa jechuunis Debiir,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.49",
            "verseOrgIds": [
              "JOS.15.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JOS 15:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aanaab, Eshitmoʼaa, Aaniim,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.50",
            "verseOrgIds": [
              "JOS.15.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JOS 15:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gooshen, hooloonii fi Giiloo dha; magaalaawwanii fi gandoonni isaanii kudha tokko turan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.51",
            "verseOrgIds": [
              "JOS.15.51"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "JOS 15:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Araab, Duumaa, Eshiʼaan,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.52",
            "verseOrgIds": [
              "JOS.15.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "JOS 15:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaanuum, Beet Tafuuʼaa, Afeeqaa,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.53",
            "verseOrgIds": [
              "JOS.15.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "JOS 15:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Humtaa, Kebroon ishee Kiriyaati Arbaaq jedhamtuu fi Ziiʼoorii dha; magaalaawwanii fi gandoonni isaanii sagal turan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.54",
            "verseOrgIds": [
              "JOS.15.54"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "JOS 15:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maaʼoon, Qarmeloos, Ziif, Yutaa,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.55",
            "verseOrgIds": [
              "JOS.15.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "JOS 15:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yizriʼeel, Yooqidiʼaam, Zaanoʼaa,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.56",
            "verseOrgIds": [
              "JOS.15.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "JOS 15:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qaayin, Gibeʼaa fi Tiimnaahii dha; magaalaawwanii fi gandoonni isaanii kudhan turan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.57",
            "verseOrgIds": [
              "JOS.15.57"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "JOS 15:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halhuul, Beet Zuuri, Gedoor,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.58",
            "verseOrgIds": [
              "JOS.15.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "JOS 15:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maʼaaraati, Beet Anootii fi Elteqoonii dha; magaalaawwanii fi gandoonni isaanii jaʼa turan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.59",
            "verseOrgIds": [
              "JOS.15.59"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "60",
            "style": "v",
            "sid": "JOS 15:60"
          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiriyaati Baʼaal kan Kiriyaati Yeʼaariim jedhamtuu fi Raabbaa dha; magaalaawwanii fi gandoonni ishee lama turan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.60",
            "verseOrgIds": [
              "JOS.15.60"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "61",
            "style": "v",
            "sid": "JOS 15:61"
          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gammoojjii keessatti immoo:",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.61",
            "verseOrgIds": [
              "JOS.15.61"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JOS 15:61"
      },
      "items": [
        {
          "text": "Beet Arabbaa, Midiin, Sekaakaa,",
