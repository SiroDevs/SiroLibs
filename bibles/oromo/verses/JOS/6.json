      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOS 6:26"
      },
      "items": [
        {
          "text": "ilmi isaa hangafti haa duʼu;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.26",
            "verseOrgIds": [
              "JOS.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOS 6:26"
      },
      "items": [
        {
          "text": "karra ishee ijaaruu jalqabnaan,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.26",
            "verseOrgIds": [
              "JOS.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOS 6:26"
      },
      "items": [
        {
          "text": "ilmi isaa quxisuun haa duʼu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.26",
            "verseOrgIds": [
              "JOS.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
