              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.27",
            "verseOrgIds": [
              "JOS.6.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.27",
                "verseOrgIds": [
                  "JOS.6.27"
                ]
              }
            }
          ]
        },
        {
          "text": "Iyyaasuu wajjin ture; maqaan isaas guutummaa biyyatii keessatti beekame.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.27",
