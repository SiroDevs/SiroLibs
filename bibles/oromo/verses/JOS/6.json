          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis waan magaalaa sana",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.21",
            "verseOrgIds": [
              "JOS.6.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.21",
                "verseOrgIds": [
                  "JOS.6.21"
                ]
              }
            }
          ]
        },
        {
          "text": "addaan baasaniif waan isa keessa jiru hunda jechuunis dhiiraa dubartii, xinnaa guddaa, loon, hoolotaa fi harroota goraadeedhaan fixan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.21",
            "verseOrgIds": [
              "JOS.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyyaasuunis namoota lamaan biyya sana basaasanii turaniin, \"Mana sagaagaltuu sanaa ol seenaatii akkuma isin isheef kakattanitti ishee fi warra kan ishee taʼan hunda gad baasaa fidaa\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.22",
            "verseOrgIds": [
              "JOS.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu dargaggoonni basaasuu dhaqanii turan sun ol seenanii Rahaab, abbaa isheetii fi haadha ishee, obboloota isheetii fi waan kan ishee taʼe hundumaa gad baasan. Maatii ishee hundas alatti baasanii qubata Israaʼeliitiin ala isaan tursan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.23",
            "verseOrgIds": [
              "JOS.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii guutummaa magaalaa sanaatii fi waan ishee keessa jiru hunda guban; garuu meetii fi warqee, miʼa naasiitii fi sibiilaa mankuusa mana",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.24",
            "verseOrgIds": [
              "JOS.6.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootti",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.24",
                "verseOrgIds": [
                  "JOS.6.24"
                ]
              }
            }
          ]
        },
        {
          "text": "galchan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.24",
            "verseOrgIds": [
              "JOS.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyyaasuun garuu sababii isheen namoota inni akka basaasaniif gara Yerikootti ergee ture sana dhoksiteef Rahaab sagaagaltuu sana maatii isheetii fi waan kan ishee taʼe hunda wajjin ni baraare; isheenis hamma ammaatti Israaʼeloota gidduu jiraatti.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.25",
            "verseOrgIds": [
              "JOS.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyyaasuunis yeroo sanatti akkana jedhee kakate; \"Namni magaalaa Yerikoo kana deebisee ijaaru fuula",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.26",
            "verseOrgIds": [
              "JOS.6.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.26",
                "verseOrgIds": [
                  "JOS.6.26"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti abaaramaa haa taʼu:",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.26",
            "verseOrgIds": [
              "JOS.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOS 6:26"
      },
      "items": [
        {
          "text": "\"Inni hundee ishee buusnaan,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.26",
            "verseOrgIds": [
              "JOS.6.26"
            ]
          }
        }
      ]
    },
    {
