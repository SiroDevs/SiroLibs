              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu kunoo amma harka kee keessa jirra. Atis waan gaarii fi qajeelaa seete hundumaa nurratti raawwadhu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.25",
            "verseOrgIds": [
