    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Qooda Gosa Efreemii fi Gosa Minaasee",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qoodni Yoosef Yordaanos Yerikoo biratti argamtu, karaa baʼa bishaanota Yerikootii kaʼee gammoojjii keessa qaxxaamuree biyya gaaraa Beetʼeelitti ol baʼa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.1",
            "verseOrgIds": [
              "JOS.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luuzi ishee Beetʼeel jedhamtu sanaa kaʼee gara biyya Arkaawotaa kan Axaaroti keessatti argamtu sanaatti ceʼa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.2",
            "verseOrgIds": [
              "JOS.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achii immoo gara lixaa biyya Yafleexotaatti gad buʼee Beet Horoon gaʼee gara Geezir itti fufee galaanicha gaʼee dhaabata.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.3",
            "verseOrgIds": [
              "JOS.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lf"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasitti Minaasee fi Efreem, ilmaan Yoosef dhaala isaanii argatan.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lh"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qoodni gosti Efreem balbala balbalaan argatte kunoo kana:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "JOS 16:5"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JOS 16:5"
      },
      "items": [
        {
          "text": "Daariin dhaala isaanii gara baʼaatiin Axaaroti Adaarii kaʼee hamma Beet Horoon gara Ol aanuutti deemee",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.5",
            "verseOrgIds": [
              "JOS.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "hamma galaanaatti itti fufa. Karaa kaabaatiin Mikmetaatii kaʼee karaa baʼaatiin gara Taanaat Shiiloo goree achiin darbee baʼa Yaanoʼaatti qajeela.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.6",
            "verseOrgIds": [
              "JOS.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii immoo Yaanoʼaadhaa kaʼee Axaarotii fi Naʼaraatti gad buʼee Yerikoo irra naannaʼee Yordaanositti gad baʼa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.7",
            "verseOrgIds": [
              "JOS.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daariin sun Tafuuʼaadhaa kaʼee gama Lixaatiin Laga Qaanaatti gad buʼee galaana gaʼee dhaabata. Dhaalli gosti Efreem balbala balbalaan argatte kanaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.8",
            "verseOrgIds": [
              "JOS.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daariin kun magaalaawwanii fi olloota isaanii kanneen dhaala gosa Minaasee keessatti gosa Efreemiif hambifaman hundas ni dabalata.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.9",
            "verseOrgIds": [
              "JOS.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan Kanaʼaanota Geezir keessa jiraachaa turan sana ariʼanii achii hin baafne ture; hamma harʼaatti Kanaʼaanonni saba Efreem gidduu jiraatu; garuu akka hojii humnaa hojjetan dirqamu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.10",
            "verseOrgIds": [
              "JOS.16.10"
            ]
          }
        }
      ]
    }
  ],
