  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "JOS 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cubbuu Aakaan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼeloonni garuu waan Waaqayyoof addaan baafame irratti amanamummaa dhaban; Aakaan ilmi Karmii, ilmi Zabdii, ilmi Zaaraa kan gosa Yihuudaa waan Waaqayyoof addaan baafame sana keessaa waan tokko tokko fudhate. Kanaafis dheekkamsi",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.1",
            "verseOrgIds": [
              "JOS.7.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.7.1",
                "verseOrgIds": [
                  "JOS.7.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Israaʼel irratti bobaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.1",
            "verseOrgIds": [
              "JOS.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti Iyyaasuun Yerikoodhaa gara Aayi kan Beet Aawwen bira gama baʼa Beetʼeelitti argamtu sanaatti nama ergee, \"Dhaqaatii naannoo sana basaasaa\" jedhe. Kanaafuu namoonni ol baʼanii Aayin basaasan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.2",
            "verseOrgIds": [
              "JOS.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis gara Iyyaasuutti deebiʼanii, \"Namni hundinuu Aayitti ol baʼuu hin qabu. Sababii namni muraasni qofti achi jiruuf akka isaan dhaqanii biyyattii fudhataniif nama kuma lama yookaan kuma sadii taʼu ergi malee namoota hundumaa hin dadhabsiisin\" jedhaniin.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.3",
            "verseOrgIds": [
              "JOS.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu namoonni gara kuma sadii taʼan kaʼanii ol baʼan; isaan garuu namoota Aayi duraa baqatan;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.4",
            "verseOrgIds": [
              "JOS.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "namoonni Aayis gara nama soddomii jaʼa isaan jalaa fixan. Isaanis karra magaalattiitii jalqabanii hamma Shabaariimiitti Israaʼeloota ariʼanii ededa irratti isaan fixan; kanaanis onneen namootaa baqxee akka bishaanii taate.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.5",
            "verseOrgIds": [
              "JOS.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyyaasuunis uffata isaa tarsaasee fuula taabota",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.6",
            "verseOrgIds": [
              "JOS.7.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.7.6",
                "verseOrgIds": [
                  "JOS.7.6"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti addaan lafatti gombifamee hamma galgalaatti achuma ture. Maanguddoonni saba Israaʼelis akkasuma godhanii mataa ofii isaanii irratti awwaara firfirsan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.6",
            "verseOrgIds": [
              "JOS.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyyaasuunis akkana jedhe; \"Yaa",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.7",
            "verseOrgIds": [
              "JOS.7.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.7.7",
                "verseOrgIds": [
                  "JOS.7.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Gooftaa, ati maaliif akka isaan nu fixaniif harka Amoorotaatti nu kennuuf jettee saba kana Yordaanosiin ceesifte? Silaa utuu Yordaanos gamatti hafnee nuuf wayya ture!",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.7",
            "verseOrgIds": [
              "JOS.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Gooftaa, erga sabni Israaʼel diinota isaa baqatee ani amma maal jechuu dandaʼa?",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.8",
            "verseOrgIds": [
              "JOS.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaʼaanonnii fi saboonni biyya kanaa kan biraa waan kana dhagaʼanii nu marsanii maqaa keenya lafa irraa ni balleessu. Yoos ati maqaa kee guddaa sanaaf maal goota?\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.9",
            "verseOrgIds": [
              "JOS.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "JOS.7.10",
                "verseOrgIds": [
                  "JOS.7.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Iyyaasuudhaan akkana jedhe; \"Ol kaʼi! Ati maaliif addaan gombifamte?",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.10",
            "verseOrgIds": [
              "JOS.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼel cubbuu hojjeteera; isaan kakuu koo kan ani akka isaan eeganiif isaan ajaje sana cabsaniiru. Isaan waan addaan naa baafame keessaa waan tokko tokko fudhataniiru; hataniiru; sobaniiru; waan sanas qabeenya isaanii wajjin ol kaaʼataniiru.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.11",
            "verseOrgIds": [
              "JOS.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni Israaʼeloonni diinota isaanii dura dhaabachuu hin dandeenyeefis kanuma; isaan sababii badiisaaf ramadamaniif dugda duubatti garagalanii diinota isaanii baqatan. Ani hamma ati waan badiisaaf ajajame kam iyyuu gidduu keessanii balleessitutti siʼachi isin wajjin hin jiraadhu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.12",
            "verseOrgIds": [
              "JOS.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kaʼiitii saba qulqulleessi. Akkanas isaaniin jedhi; 'Boriif ofi qulqulleessaa; wanni",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.13",
            "verseOrgIds": [
              "JOS.7.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.7.13",
                "verseOrgIds": [
                  "JOS.7.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni Israaʼel jedhu isa kanaatii; yaa Israaʼel, wanni hirmii taʼe tokko gidduu keessan jira. Isin hamma waan sana of keessaa baaftanitti diinota keessan of irraa ittisuu hin dandeessan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.13",
            "verseOrgIds": [
              "JOS.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kanaafuu ganama gosa gosaan ofi dhiʼeessaa. Gosti",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.14",
            "verseOrgIds": [
              "JOS.7.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.7.14",
                "verseOrgIds": [
                  "JOS.7.14"
                ]
              }
            }
          ]
        },
        {
          "text": "filatu balbala balbalaan gara fuula duraatti haa baʼu; balballi",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.14",
            "verseOrgIds": [
              "JOS.7.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.7.14",
                "verseOrgIds": [
                  "JOS.7.14"
                ]
              }
            }
          ]
        },
        {
          "text": "filatus maatii maatiidhaan gara fuula duraatti haa baʼu; maatiin",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.14",
            "verseOrgIds": [
              "JOS.7.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.7.14",
                "verseOrgIds": [
                  "JOS.7.14"
                ]
              }
            }
          ]
        },
        {
          "text": "filatus nama tokko tokkoon gara fuula duraatti haa baʼu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.14",
            "verseOrgIds": [
              "JOS.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni waan balleeffamuu qabu wajjin qabame, waan qabu hundumaa wajjin ibiddaan haa gubamu. Inni kakuu",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.15",
            "verseOrgIds": [
              "JOS.7.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.7.15",
                "verseOrgIds": [
                  "JOS.7.15"
                ]
              }
            }
          ]
        },
        {
          "text": "cabseera; waan Israaʼel keessatti qaanii taʼes hojjeteera!' \"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.15",
            "verseOrgIds": [
              "JOS.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Iyyaasuun ganama bariin kaʼee saba Israaʼel gosa gosaan gara fuula duraatti baase; gosti Yihuudaas ni filatame.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.16",
            "verseOrgIds": [
              "JOS.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balballi Yihuudaa gara fuula duraatti baʼe; Iyyaasuunis balbala Zaaraa addaan baase. Balballi Zaaraas maatii maatiin gara fuula duraatti baʼe; Zabdiinis ni filatame.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.17",
            "verseOrgIds": [
              "JOS.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyyaasuunis maatii isaa nama tokko tokkoon gara fuula duratti baase; Aakaan ilmi Karmii, ilmi Zabdii, ilmi Zaaraa kan gosa Yihuudaa ni filatame.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.18",
            "verseOrgIds": [
              "JOS.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti Iyyaasuun Aakaaniin akkana jedhe; \"Yaa ilma ko,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.19",
            "verseOrgIds": [
              "JOS.7.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.7.19",
                "verseOrgIds": [
                  "JOS.7.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa Israaʼeliif ulfina kenni; cubbuu kees isatti himadhu; mee waan hojjette natti himi; na hin dhoksin.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.19",
            "verseOrgIds": [
              "JOS.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aakaanis akkana jedhee deebise; \"Wanni kun dhugaa dha! Ani",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.20",
            "verseOrgIds": [
              "JOS.7.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.7.20",
                "verseOrgIds": [
                  "JOS.7.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa Israaʼelitti cubbuu hojjedheera. Wanni ani hojjedhes kunoo kana:",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.20",
            "verseOrgIds": [
              "JOS.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani waan Baabilonii boojiʼame keessaa waaroo bareedaa tokko, meetii saqilii dhibba lamaa fi warqee saqilii shantama ulfaatu arginaan kajeelee fudhadheera. Miʼi kunis dunkaana koo keessatti meetii jala lafa keessatti dhokfameera.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.21",
            "verseOrgIds": [
              "JOS.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Iyyaasuun ergamoota erge; isaanis gara dunkaana sanaatti fiigan; miʼi sunis dunkaanicha keessatti, meetii jala dhokfamee ture.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.22",
            "verseOrgIds": [
              "JOS.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan miʼa sana dunkaanicha keessaa guuranii gara Iyyaasuutii fi Israaʼeloota hundaatti fidanii fuula",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.23",
            "verseOrgIds": [
              "JOS.7.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.7.23",
                "verseOrgIds": [
                  "JOS.7.23"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti diriirsan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.23",
            "verseOrgIds": [
              "JOS.7.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis Iyyaasuu fi Israaʼeloonni hundi Aakaan ilma Zaaraa, meetii, waaroo, muraa warqee, ilmaan isaatii fi intallan isaa, loon isaa, harroota isaa, hoolota isaa, dunkaana isaatii fi waan inni qabu hunda guuranii Sulula Aakooritti geessan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.24",
            "verseOrgIds": [
              "JOS.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyyaasuunis, \"Ati maaliif rakkina kana hunda nutti fidde?",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.25",
            "verseOrgIds": [
              "JOS.7.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.7.25",
                "verseOrgIds": [
                  "JOS.7.25"
                ]
              }
            }
          ]
        },
        {
          "text": "harʼa rakkina sitti fida\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.25",
            "verseOrgIds": [
              "JOS.7.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOS 7:25"
      },
      "items": [
        {
          "text": "Israaʼeloonni hundinuus dhagaadhaan isa tuman; jara kaan illee erga dhagaadhaan tumanii booddee ibiddaan isaan guban.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.25",
            "verseOrgIds": [
              "JOS.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aakaan irratti tuulaa dhagaa guddaa hamma harʼaatti illee jiru tokko tuulan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.26",
            "verseOrgIds": [
              "JOS.7.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "JOS.7.26",
                "verseOrgIds": [
                  "JOS.7.26"
                ]
              }
            }
          ]
        },
        {
          "text": "dheekkamsa isaa guddaa sana irraa deebiʼe. Kanaafis iddoon sun hamma harʼaatti Sulula Aakoor jedhamee waamama.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.26",
            "verseOrgIds": [
              "JOS.7.26"
            ]
          }
        }
      ]
    }
  ],
