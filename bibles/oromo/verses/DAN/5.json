          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Katabbii Keenyan Manaa Irraa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beelshaazaar mootichi qondaaltota isaa kuma tokkoof dhangaa guddaa qopheessee fuula isaanii duratti daadhii wayinii dhuge.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.1",
            "verseOrgIds": [
              "DAN.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beelshaazaaris utuu daadhii wayinii dhugaa jiruu akka innii fi qondaaltonni isaa, niitonnii fi saajjatoowwan isaa ittiin dhuganiif akka isaan xoofoo warqeetii fi meetii kan abbaan isaa Nebukadnezar mana qulqullummaa Yerusaalemii fide sana fidan ajaje.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.2",
            "verseOrgIds": [
              "DAN.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu isaan xoofoo warqee kan mana qulqullummaa Waaqaa kan Yerusaalemii fudhataman sana fidan; mootichi, qondaaltonni, niitonnii fi saajjatoowwan isaa ittiin dhugan.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.3",
            "verseOrgIds": [
              "DAN.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan utuma daadhii wayinii sana dhugaa jiranuu, waaqota warqeetii fi meetii, kan naasiitii fi sibiilaa, kan mukaatii fi dhagaa galateeffatan.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.4",
            "verseOrgIds": [
              "DAN.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma tasaa qubni harka namaa mulʼatee keenyan manaa kan masaraa mootii keessa baattuu ibsaa bira jiru irratti barreesse. Mootichis harka sana utuu inni barreessuu arge.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.5",
            "verseOrgIds": [
              "DAN.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fuulli mootichaa ni geeddaramee; innis sodaadhaan guutamee jilbii isaa hollatee waldhaʼe; miilli isaas ni laafe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.6",
            "verseOrgIds": [
              "DAN.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis sagalee isaa ol fuudhee akka mortoota, warra urjii ilaalanii fi ilaaltota ol isaaf galchan ajaje. Ogeeyyii Baabiloniinis akkana jedhe; \"Nama katabbii kana dubbisee hiikkaa isaa natti himu kamitti iyyuu uffanni diimaan dhiilgeen uffifamee morma isaatti faayi warqee ni kaaʼamaaf; mootummaa koo keessattis bulchaa ol aanaa sadaffaa taʼa.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.7",
            "verseOrgIds": [
              "DAN.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis ogeeyyiin mootichaa hundi ol seenan; isaan keessaa garuu namni katabbii sana dubbisuu yookaan hiikkaa isaa mootichatti himuu dandaʼu tokko iyyuu hin argamne.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.8",
            "verseOrgIds": [
              "DAN.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti Beelshaazaar mootichi kan duraa caalaa sodaatee fuulli isaa geeddarame; qondaaltonni isaas waan godhan wallaalan.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.9",
            "verseOrgIds": [
              "DAN.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootittiinis waca mootichaatii fi qondaaltota isaa dhageessee galma cidha sanaa ol seente. Isheenis akkana jette; \"Yaa mootii, bara baraan jiraadhu! Hin rifatin; fuulli kees hin geeddaramin!",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.10",
            "verseOrgIds": [
              "DAN.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootummaa kee keessa namichi hafuurri waaqota qulqullootaa keessa jiru tokko jira. Namichi kun bara abbaa keetii keessa nama hubannaa, beekumsaa fi ogummaa akkuma waaqotaa qabu taʼee argame. Abbaan kee Nebukadnezar Mootichi, itti gaafatamaa tolchitootaa, mortootaa, kan warra urjii ilaalaniitii fi ilaaltotaa godhee isa muudee ture.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.11",
            "verseOrgIds": [
              "DAN.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daaniʼel namichi mootichi Beelxishaazaari jedhee waamu kun nama hafuurri gaariin, beekumsii fi hubannaan keessa jiru taʼee argame; innis abjuu, hibboo fi rakkoo hiikuuf dandeettii addaa qaba ture. Daaniʼelin waami; innis hiikkaa katabbii kanaa sitti himaatii.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.12",
            "verseOrgIds": [
              "DAN.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Daaniʼel fuula mootichaa duratti dhiʼeeffame; mootichis akkana jedheen; \"Warra abbaan koo mootichi boojiʼee Yihuudaadhaa fide keessaa kan Daaniʼel jedhamu siʼii?",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.13",
            "verseOrgIds": [
              "DAN.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani akka hafuurri waaqotaa si keessa jiruu fi akka ati hubannaa, beekumsaa fi ogummaa addaa qabdu dhagaʼeera.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.14",
            "verseOrgIds": [
              "DAN.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogeeyyiinii fi mortoonni akka katabbii kana dubbisanii hiikkaa isaa natti himaniif fuula koo duratti fidamanii turan; isaan garuu ibsuu hin dandeenye.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.15",
            "verseOrgIds": [
              "DAN.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani akka ati hiikkaa kennitee rakkoofis fala kennuu dandeessu dhagaʼeera. Yoo ati katabbii kana dubbiftee hiikkaa isaa natti himuu dandeesse, uffata diimaa dhiilgeetu sitti uffifama; faayi warqees morma keetti siif kaaʼama; mootummaa koo keessattis bulchaa ol aanaa sadaffaa taata.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.16",
            "verseOrgIds": [
              "DAN.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti Daaniʼel deebisee mootichaan akkana jedhe; \"Kennaan kee sumaaf haa hafu; badhaasni kee immoo nama biraatiif haa kennamu. Taʼu iyyuu ani katabbicha dubbisee hiikkaa isaa mootichatti nan hima.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.17",
            "verseOrgIds": [
              "DAN.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaa mootii, Waaqni Waan Hundaa Olii abbaa kee Nebukadnezariif surraa fi guddina, ulfinaa fi kabaja kenne.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.18",
            "verseOrgIds": [
              "DAN.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii ol aantummaa inni isaaf kenneef saboonnii fi mootummoonni hundi, namoonni afaan garaa garaa dubbatan ni hollataniif; isa sodaatanis. Mootichis warra ajjeesuu barbaade ni ajjeesa; warra oolchuu barbaade ni oolcha, kan muuduu barbaade ni muuda, kan salphisuu barbaades ni salphisa ture.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.19",
            "verseOrgIds": [
              "DAN.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafa garaan isaa of tuulee mataa jabaatetti garuu inni teessoo isaa irraa kaafamee ulfinni isaas isa irraa fudhatame.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.20",
            "verseOrgIds": [
              "DAN.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni uummata keessaa ariʼamee qalbiin horii kennameef; harroota diidaa wajjin jiraatee akka loonii marga nyaate; inni hamma akka Waaqni Waan Hundaa Olii mootummoota namootaa irratti bulchaa taʼee fi akka inni abbaa fedhe isaan irratti muudu beekutti dhagni isaa fixeensa samiitiin jiidhe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.21",
            "verseOrgIds": [
              "DAN.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaa Beelshaazaar, ati ilmi isaa utuma waan kana hunda beektuu mataa kee gad hin qabanne.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.22",
            "verseOrgIds": [
              "DAN.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qooda kanaa ati Gooftaa samii irratti mataa ol qabatte. Ati xoofoowwan mana qulqullummaa isaatii fichisiiftee atii fi qondaaltonni kee, niitonnii fi saajjatoowwan kee isaan keessaa dhugdan. Ati waaqota meetii, warqee, naasii, sibiilaa, mukaatii fi kan dhagaa kanneen arguu yookaan dhagaʼuu yookaan hubachuu hin dandeenye jajatte. Waaqa lubbuu keetii fi karaa kee hunda harka isaatti qabatee jiru garuu hin ulfeessine.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.23",
            "verseOrgIds": [
              "DAN.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu inni harka katabbii sana barreesse erge.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.24",
            "verseOrgIds": [
              "DAN.5.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Katabbiin barreeffamee tures kana:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.25",
            "verseOrgIds": [
              "DAN.5.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pc",
        "vid": "DAN 5:25"
      },
      "items": [
        {
          "text": "Maanee, Maanee, Teeqeel, Faares.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.25",
            "verseOrgIds": [
              "DAN.5.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hiikkaan isaas kana:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.26",
            "verseOrgIds": [
              "DAN.5.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "DAN 5:26"
      },
      "items": [
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.26",
            "verseOrgIds": [
              "DAN.5.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "Maanee",
              "type": "text",
              "attrs": {
                "verseId": "DAN.5.26",
                "verseOrgIds": [
                  "DAN.5.26"
                ]
              }
            }
          ]
        },
        {
          "text": "jechuun Waaqni bara kee murteessee gara dhumaatti fide jechuu dha.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.26",
