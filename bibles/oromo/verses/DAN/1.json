        "sid": "DAN 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daaniʼel Baabilon keessatti Leenjifame",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara Yehooyaaqiim mooticha Yihuudaa keessa, waggaa sadaffaatti Nebukadnezar mootiin Baabilon dhufee Yerusaalemin marse.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.1",
            "verseOrgIds": [
              "DAN.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gooftaanis Yehooyaaqiim mooticha Yihuudaa miʼoota mana qulqullummaa Waaqaa tokko tokko wajjin dabarsee harka isaatti kenne. Miʼoota kanneenis gara mana Waaqa isaa, gara Baabilonitti geeffatee mankuusaa mana Waaqa isaa keessa kaaʼate.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.2",
            "verseOrgIds": [
              "DAN.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis ergasii Ashfenaz itti gaafatamaa qondaaltota isaa sana waamee akka inni Israaʼeloota sanyii moototaatii fi maatii ulfina qabeeyyii taʼan tokko tokko ol galchu ajaje;",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.3",
            "verseOrgIds": [
              "DAN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "isaanis dargaggeeyyii hirʼina dhagnaa hin qabne, babbareedoo, kanneen barumsa gosa kamii iyyuu barachuuf dandeettii ogummaa qaban, kanneen beekumsaan badhaadhan, kanneen waan hunda hubachuu dandaʼanii fi masaraa mootummaa keessa tajaajiluuf gaʼumsa qaban turan. Innis afaanii fi katabbii Baabilonotaa isaan barsiisuu qaba ture.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.4",
            "verseOrgIds": [
              "DAN.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis nyaataa fi daadhii wayinii kan guyyaa guyyaatti isaan barbaachisu maaddii mootummaa irraa isaaniif ajaje. Isaanis tajaajila mootichaa seenuuf waggaa sadii leenjifamuu qabu ture.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.5",
            "verseOrgIds": [
              "DAN.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan kanneen keessaa warri Yihuudaadhaa dhufan Daaniʼel, Hanaaniyaa, Miishaaʼeelii fi Azaariyaa turan.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.6",
            "verseOrgIds": [
              "DAN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itti gaafatamaan qondaaltotaa sun Daaniʼeliin Beelxishaazaar, Hanaaniyaadhaan Shaadraak, Miishaaʼeelin, Meeshak, Azaariyaadhaan immoo Abdanaagoo jedhee maqaa haaraa baaseef.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.7",
            "verseOrgIds": [
              "DAN.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daaniʼel garuu nyaataa fi daadhii wayinii mootichaatiin of xureessuu dide; innis akkasiin akka of hin xureessineef itti gaafatamaa qondaaltotaa sana eeyyama gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.8",
            "verseOrgIds": [
              "DAN.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqnis yeroo kanatti akka Daaniʼel fuula qondaala sanaa duratti surraa fi gara laafina argatu godhe;",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.9",
            "verseOrgIds": [
              "DAN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "qondaalli sun garuu Daaniʼeliin, \"Ani gooftaa koo isa nyaataa fi dhugaatii keessan isiniif ramade sana nan sodaadha; inni maaliif dargaggoota hiriyoota keessan kaan caalaa huqqattanii isin arga? Kanaan isin mootichi balaa mataa kootti fiddu\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.10",
            "verseOrgIds": [
              "DAN.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti Daaniʼel waardiyyaa itti gaafatamaan qondaaltotaa sun Daaniʼelii fi Hanaaniyaa irratti, Miishaaʼeelii fi Azaariyaa irratti muude Meldaariin akkana jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.11",
            "verseOrgIds": [
              "DAN.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Maaloo tajaajiltoota kee bultii kudhaniif ilaali; biqiltuu nyaatamuu fi bishaan dhugamu malee waan biraa nuuf hin kennin.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.12",
            "verseOrgIds": [
              "DAN.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sana booddee bifa keenyaa fi bifa dargaggoota nyaata mootii nyaatanii wal biratti ilaali; waan argite irratti hundaaʼiitii tajaajiltoota kee irratti waan feete murteessi.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.13",
            "verseOrgIds": [
              "DAN.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis yaada kana fudhatee bultii kudhan isaan qore.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.14",
            "verseOrgIds": [
              "DAN.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhuma bultii kurnan sanaattis isaan dargaggoota nyaata mootii nyaatan sana caalaa fayyaaleyyii fi warra dhagni isaanii furdatee miidhage taʼanii argaman.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.15",
            "verseOrgIds": [
              "DAN.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu waardiyyaan sun qooda nyaata filatamaa fi daadhii wayinii kan isaan dhuguu qaban sanaa raafuu qofa isaaniif kenne.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.16",
            "verseOrgIds": [
              "DAN.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqnis dargaggoota afran kanneeniif barumsaa fi ogummaa hunda keessatti beekumsaa fi dandeetii kenneef. Daaniʼelis mulʼataa fi abjuu hunda hubachuu dandaʼa ture.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.17",
            "verseOrgIds": [
              "DAN.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu guyyaan mootichi akka isaan gara isaatti dhiʼaatan murteesse gaʼettis, qondaalli hangaftichi fuula Nebukadnezar duratti isaan dhiʼeesse.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.18",
            "verseOrgIds": [
              "DAN.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis isaan haasofsiise; innis nama Daaniʼeliin, Hanaaniyaan, Miishaaʼeelii fi Azaariyaan qixxaatu tokko illee hin arganne; kanaafuu isaan hojii mootichaa jalqaban.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.19",
            "verseOrgIds": [
              "DAN.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis waaʼee ogummaa fi beekumsaa kan isaan gaafate hundaan akka isaan ilaaltotaa fi falfaltoota biyyattiitti argaman hunda harka kudhan caalan arge.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.20",
            "verseOrgIds": [
              "DAN.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daaniʼelis hamma waggaa tokkoffaa Qiiros mootichaatti achuma ture.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.21",
            "verseOrgIds": [
              "DAN.1.21"
            ]
          }
        }
      ]
    }
  ],
