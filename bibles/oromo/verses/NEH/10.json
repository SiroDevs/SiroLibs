          "attrs": {
            "verseId": "NEH.10.26",
            "verseOrgIds": [
              "NEH.10.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maluuk, Haariimii fi Baʼanaa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.27",
            "verseOrgIds": [
              "NEH.10.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Namoonni hafan kaan jechuunis luboonni, Lewwonni, eegdonni karraa, faarfattoonni, tajaajiltoonni mana qulqullummaatii fi warri Seera Waaqaatiif jedhanii saboota ollaa irraa kophaa of baasan hundinuu niitota isaanii, ilmaanii fi intallan isaanii kanneen waa hubachuu dandaʼan hunda wajjin",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.28",
            "verseOrgIds": [
              "NEH.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "obboloota isaanii bebeekamootti dabalamanii akka Seera Waaqaa kan karaa Musee garbicha Waaqaa sanaatiin kenname sana eeganiif ajaja, seeraa fi labsii",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.29",
            "verseOrgIds": [
              "NEH.10.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NEH.10.29",
                "verseOrgIds": [
                  "NEH.10.30"
                ]
              }
            }
          ]
        },
        {
          "text": "Gooftaa keenyaa hundaaf ajajamaniif abaarsaa fi kakuudhaan waadaa galan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.29",
            "verseOrgIds": [
              "NEH.10.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nu akka warra naannoo keenya jiraatanitti intallan keenya hin heerumsiifne yookaan akka ilmaan keenya illee intallan isaanii hin fuusifne waadaa galla.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.30",
            "verseOrgIds": [
              "NEH.10.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yoo saboonni ollaa keenya jiraatan miʼa daldalaa yookaan midhaan gurguraa guyyaa Sanbataatiin fidan nu guyyaa Sanbataatiin yookaan guyyaa qulqulluu kamiin iyyuu isaan irraa hin bitannu. Waggaa torbaffaa kam iyyuu lafa qotiisaa boqochiifnee idaa hunda namaaf ni dhiifna.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.31",
            "verseOrgIds": [
              "NEH.10.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Akka waggaa hunda tajaajila mana Waaqa keenyaatiif jennee saqilii argannu harka sadii keessaa harka tokko kenninu itti gaafatamummaa ni fudhanna;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.32",
            "verseOrgIds": [
              "NEH.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis buddeena minjaala irratti dhiʼeeffamuuf, kennaa midhaaniitii fi aarsaa gubamu kan yeroo yerootti dhiʼeeffamuuf, aarsaa guyyaa Sanbataatiif, kan ayyaana Baatii Haaraatii fi kan ayyaanota bebeekamoo, aarsaawwan qulqullaaʼoodhaaf, aarsaawwan cubbuu kanneen Israaʼeliif araara buusuuf dhiʼeeffamaniif, akkasumas hojiiwwan mana Waaqa keenyaa keessaa hundaafii dha.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.33",
            "verseOrgIds": [
              "NEH.10.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NEH 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nu, luboonni, Lewwonnii fi sabni yeroo itti tokkoon tokkoon maatiiwwan keenyaa akkuma Seera keessatti barreeffametti waggaa hunda keessaa yeroo murteeffametti iddoo aarsaa",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.34",
            "verseOrgIds": [
              "NEH.10.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NEH.10.34",
                "verseOrgIds": [
                  "NEH.10.35"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keenyaa irratti bobeessuuf kennaa qoraanii gara mana Waaqa keenyaa fiduu qabnu beekuuf ixaa buufanneerra.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.34",
            "verseOrgIds": [
              "NEH.10.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NEH 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Akkasumas nu mataa midhaan keenyaatii fi mataa muka ija kennuu hunda waggaa waggaadhaan gara mana",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.35",
            "verseOrgIds": [
              "NEH.10.36"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "NEH.10.35",
                "verseOrgIds": [
                  "NEH.10.36"
                ]
              }
            }
          ]
        },
        {
          "text": "fiduuf itti gaafatama fudhanneerra.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.35",
            "verseOrgIds": [
              "NEH.10.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NEH 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Akkuma Seera keessatti barreeffametti hangafa ilmaan keenyaatii fi hangafa loon keenyaa, hangafa horii keenyaatii fi hangafa bushaayee keenyaa gara mana Waaqa keenyaa, luboota achi keessa tajaajilanitti ni geessina.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.36",
            "verseOrgIds": [
              "NEH.10.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NEH 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana malees nu daakuu keenya kan bukeeffame irraa, kennaawwan midhaan keenyaa irraa, ija mukkeen keenyaa hunda irraa, daadhii wayinii keenyaa haaraa fi zayitii irraa mataa fuunee gara mankuusaalee mana Waaqa keenyaa lubootatti geessina. Amma illee sababii warri harka kudhan keessaa harka tokko walitti qaban Lewwota taʼaniif magaalaawwan keessa hojjennu hunda keessaa oomisha midhaan keenyaa harka kudhan keessaa harka tokko Lewwotatti geessina.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.37",
            "verseOrgIds": [
              "NEH.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NEH 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo Lewwonni kennaa harka kudhan keessaa tokko walitti qabanitti lubni sanyii Aroon keessaa dhalate tokko isaan wajjin jiraachuu qaba; ergasii Lewwonni kennaa walitti qaban sana keessaa harka kudhan keessaa tokko gara mana Waaqa keenyaa, gara mankuusaa qabeenyaatti fiduu qabu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.38",
            "verseOrgIds": [
              "NEH.10.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NEH 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sabni Israaʼelii fi ilmaan Lewwii kennaa midhaanii, kan daadhii wayinii haaraa fi kan zayitii gara mankuusaalee miʼi mana qulqullummaa kaaʼamu, iddoo luboonni tajaajilan, eegdonni karraa fi faarfattoonni taaʼanitti fiduu qabu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.39",
            "verseOrgIds": [
              "NEH.10.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "NEH 10:39"
      },
      "items": [
        {
          "text": "\"Nus mana Waaqa keenyaa hin dagannu.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.39",
            "verseOrgIds": [
              "NEH.10.40"
            ]
          }
        }
      ]
    }
  ],
