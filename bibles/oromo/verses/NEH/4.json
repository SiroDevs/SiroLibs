  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "NEH 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Deebisanii Ijaaruu Irratti Mormiin Kaʼuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanbalaaxi akka nu dallaa kana deebifnee ijaaraa jirru dhageenyaan aariin gubatee dheekkame. Innis Yihuudootatti qoosee",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.1",
            "verseOrgIds": [
              "NEH.3.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "fuula obboloota isaa fi fuula loltoota Samaariyaa duratti akkana jedhe; \"Yihuudoonni dadhaboonni kunneen maal hojjechaa jiru? Isaan dallaa isaanii deebisanii ijaaruu? Aarsaa illee ni dhiʼeessuu? Guyyaa tokko keessatti ni fixuu? Isaan waan akkas gubamee tuulame keessaa dhagaa fuudhanii akka duriitti deebisuu dandaʼuu?\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.2",
            "verseOrgIds": [
              "NEH.3.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Xoobbiyaan namichi Amoon kan isa bira dhaabate sunis, \"Waan isaan ijaaraa jiran kana, dallaa isaanii kan dhagaa kana waangoon iyyuu yoo yaabde ni jigsiti!\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.3",
            "verseOrgIds": [
              "NEH.3.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Waaqa keenya nu dhagaʼi; nu tuffatamneerraatii. Arraba isaan nu arrabsan matuma isaaniitti deebisi. Boojuudhaaf dabarsii biyya ormaatti isaan kenni.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.4",
            "verseOrgIds": [
              "NEH.3.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii isaan fuula ijaartotaa duratti dheekkamsaaf si kakaasaniif yakka isaanii hin dhoksiniif yookaan cubbuu isaanii fuula kee duraa hin haqiniif.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.5",
            "verseOrgIds": [
              "NEH.3.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu akkasiin dallaa sana hamma inni walakkaa dheerina isaa gaʼutti deebifnee ijaarre; namoonni garaa tokkoon hojjechaa turaniitii.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.6",
            "verseOrgIds": [
              "NEH.3.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu Sanbalaaxi, Xoobbiyaan, Araboonni, Amoononnii fi namoonni Ashdood yommuu akka haaromfamuun dallaa Yerusaalem ittuma fufaa jiruu fi akka qaawwi isaa duuchamaa jiru dhagaʼanitti akka malee aaran.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.7",
            "verseOrgIds": [
              "NEH.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan hundinuu dhufanii Yerusaalemin loluu fi rakkina itti fiduudhaaf tokkummaadhaan malatan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.8",
            "verseOrgIds": [
              "NEH.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu garuu Waaqa keenya kadhannee doorsisa kana of irraa ittisuuf jennee waardiyyaa halkanii fi guyyaa eegu tokko kaaʼanne.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.9",
            "verseOrgIds": [
              "NEH.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sabni Yihuudaas, \"Humni hojjettootaa laafeera; sababii diigamni isaa akka malee guddaa taʼeef nu dallaa kana deebifnee ijaaruu hin dandeenyu\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.10",
            "verseOrgIds": [
              "NEH.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diinonni keenyas, \"Utuu isaan hin beekin yookaan nu hin argin isaan gidduu seennee isaan fixnee hojii sana dhaabbachiifna\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.11",
            "verseOrgIds": [
              "NEH.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yihuudoonni isaanitti dhiʼoo jiraatan dhufanii, \"Yoo isin eessa illee dhaqxan isaan inuma nu lolu\" jedhanii yeroo kudhan nutti himan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.12",
            "verseOrgIds": [
              "NEH.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu ani namoota sana keessaa tokko tokko dachaa dallaa duubaan jiru keessa, iddoo ol kaʼaa irratti ramadee akka isaan goraadee, eeboo fi iddaa qabatanii dhaabatan nan godhe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.13",
            "verseOrgIds": [
              "NEH.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis ergan asii fi achi ilaalee booddee ol kaʼee namoota bebeekamoodhaan, qondaaltotaa fi uummata kaaniin akkana nan jedhe; \"Isin jara hin sodaatinaa. Gooftaa guddichaa fi sodaachisaa sana yaadadhaatii obboloota keessaniif, ilmaan keessaniif, intallan keessaniif, niitota keessanii fi manneen keessaniif lolaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.14",
            "verseOrgIds": [
              "NEH.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo diinonni keenya akka nu mala isaaniitti dammaqne, akka Waaqnis mala isaanii sana jalaa diige dhagaʼanitti nu hundi gara dallaatti, tokkoon tokkoon keenyas hojii keenyatti deebine.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.15",
            "verseOrgIds": [
              "NEH.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafasii jalqabee namoota koo keessaa walakkaan isaanii hojii hojjetanii walakkaan kaan immoo eeboo, gaachana, iddaa fi miʼa lolaa hidhatan. Ajajjoonnis saba Yihuudaa hunda duubaan dhaabachaa turan;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.16",
            "verseOrgIds": [
              "NEH.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "warri dallaa ijaaranii fi baʼaa baatanis harka tokkoon ni hojjetu, harka tokkoon immoo miʼa lolaa qabatu turan;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.17",
            "verseOrgIds": [
              "NEH.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "tokkoon tokkoon ijaartota sanaa goraadee ofii isaanii mudhiitti hidhatanii hojii hojjetan. Namichi malakata afuufu garuu na wajjin ture.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.18",
            "verseOrgIds": [
              "NEH.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis namoota bebeekamoodhaan, qondaaltotaa fi uummata kaaniin akkana nan jedhe; \"Hojiin kun guddaa fi balʼaa dha; tokkoon tokkoon keenyas gargar fagaannee dallaa irra jirra.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.19",
            "verseOrgIds": [
              "NEH.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NEH 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iddoo itti sagalee malakataa dhageessan kamitti iyyuu nutti makamaa. Waaqni keenya nuuf lolaa!\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.20",
            "verseOrgIds": [
              "NEH.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu nu barii barraaqaa jalqabnee hamma urjiiwwan baʼanitti akkuma namoota keenya keessaa gariin eeboo qabatanii jiranitti hojii itti fufne.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.21",
            "verseOrgIds": [
              "NEH.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis yeroo sanatti namootaan akkanan jedhe; \"Akka isaan halkan akka eegdotaatti, guyyaa immoo akka hojjettootaatti nu tajaajiluu dandaʼaniif nama kam iyyuu gargaaraa isaa wajjin halkan Yerusaalem keessa tursaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.22",
            "verseOrgIds": [
              "NEH.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis, obboloonni koos, namoonni koos, eegdonni na wajjin turanis uffata keenya hin baafanne; tokkoon tokkoon namaa yeroo bishaan barbaacha deemu illee miʼa isaa kan waraanaa harkatti qabata ture.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.23",
            "verseOrgIds": [
              "NEH.4.17"
            ]
          }
        }
      ]
    }
  ],
