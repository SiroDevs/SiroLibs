  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "EXO 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Seera Murtii Qajeelaa fi Araaraa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Oduu sobaa hin odeessin; dhuga baʼuu jalʼaa kennuudhaan nama balleessaa hojjete hin gargaarin.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.1",
            "verseOrgIds": [
              "EXO.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Waan hamaa hojjechuuf jettee nama baayʼee faana hin buʼin. Fuula seeraa duratti yommuu dhugaa baatu, gara nama baayʼee gortee murtii hin jalʼisin;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.2",
            "verseOrgIds": [
              "EXO.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "murtii irratti hiyyeessaaf hin loogin.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.3",
            "verseOrgIds": [
              "EXO.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yoo sangaa yookaan harree diina keetii kan baduutti jiru argite deebisii geessiif.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.4",
            "verseOrgIds": [
              "EXO.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo harree nama si jibbu tokkoo utuu isheen baʼaa baattee kuftee jirtuu argite achitti hin dhiisin; isa gargaarii ol kaasi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.5",
            "verseOrgIds": [
              "EXO.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Murtii irratti hiyyeessa saba keetii jalaa murtii hin dabsin.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.6",
            "verseOrgIds": [
              "EXO.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Himata sobaa keessatti hin hirmaatin; waan ani nama balleessaa hojjete hin qulqulleessineef nama yakka hin qabne yookaan nama qajeelaa hin ajjeesin.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.7",
            "verseOrgIds": [
              "EXO.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ati mattaʼaa hin fudhatin; mattaʼaan ogeeyyii ni jaamsaatii; dubbii qajeeltotaas jalʼisa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.8",
            "verseOrgIds": [
              "EXO.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Alagaa hin cunqursin; isin waan biyya Gibxiitti alagaa turtaniif alagaa taʼuun maal akka taʼe isin mataan keessan ni beektuutii.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.9",
            "verseOrgIds": [
              "EXO.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Seera Sanbataa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Waggaa jaʼa lafa qotiisaa kee facaafadhu; midhaanis galfadhu;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.10",
            "verseOrgIds": [
              "EXO.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "waggaa torbaffaatti garuu lafa sana boqochiisi malee hin qotin. Akkasiin hiyyeeyyiin saba keetii laficha irraa nyaata argatu; waan isaan irraa hafe immoo bineensi haa nyaatu. Muka wayinii keetiitii fi muka ejersa keetiis akkasuma godhi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.11",
            "verseOrgIds": [
              "EXO.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Guyyaa jaʼa hojii kee hojjetadhu; akka sangaan keetii fi harreen kee boqotaniif, akka garbichi mana keetti dhalatee fi alagaan aara galfataniif guyyaa torbafaatti hin hojjetin.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.12",
            "verseOrgIds": [
              "EXO.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Waan ani isinitti hime hunda eegaa; maqaa waaqota biraa hin waammatinaa; afaan keessanii iyyuu hin baʼin.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.13",
            "verseOrgIds": [
              "EXO.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ayyaana Waggaa Sadan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ati waggaatti yeroo sadii ayyaana naa ayyaaneffadhu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.14",
            "verseOrgIds": [
              "EXO.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ayyaana Maxinoo Ayyaaneffadhu; akkuma ani si ajaje sana bultii torba Maxinoo nyaadhu. Waan kanas jiʼa Abiibii keessa yeroo murtaaʼetti godhi; ati jiʼa sana keessa Gibxii baateetii.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.15",
            "verseOrgIds": [
              "EXO.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 23:15"
      },
      "items": [
        {
          "text": "\"Namni tokko iyyuu harka duwwaa fuula koo duratti hin dhiʼaatin.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.15",
            "verseOrgIds": [
              "EXO.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mataa midhaan keetii kan lafa qotiisaa keetti facaafatteen Ayyaana Galchaa Midhaanii ayyaaneffadhu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.16",
            "verseOrgIds": [
              "EXO.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 23:16"
      },
      "items": [
        {
          "text": "\"Dhuma waggaatti yeroo midhaan kee lafa qotiisaa irraa walitti qabattutti Ayyaana Galchaa Midhaanii ayyaaneffadhu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.16",
            "verseOrgIds": [
              "EXO.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Dhiirri hundi waggaatti yeroo sadii fuula",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.17",
            "verseOrgIds": [
              "EXO.23.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.23.17",
                "verseOrgIds": [
                  "EXO.23.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Gooftaa duratti haa dhiʼaatu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.17",
            "verseOrgIds": [
              "EXO.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Dhiiga aarsaa waan raacitii qabu wajjin naa hin dhiʼeessin.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.18",
            "verseOrgIds": [
              "EXO.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 23:18"
      },
      "items": [
        {
          "text": "\"Coomni aarsaa ayyaana koos hamma bariitti hin turin.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.18",
            "verseOrgIds": [
              "EXO.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mataa midhaan lafa keetii keessaa filatamaa isaa gara mana",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.19",
            "verseOrgIds": [
              "EXO.23.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.23.19",
                "verseOrgIds": [
                  "EXO.23.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keetii fidi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.19",
            "verseOrgIds": [
              "EXO.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 23:19"
      },
      "items": [
        {
          "text": "\"Ilmoo reʼee aannan haadha isheetiin hin affeelin.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.19",
            "verseOrgIds": [
              "EXO.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ergamaan Waaqayyoo Karaa Qopheessuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Akka inni karaa irratti si eegee iddoo ani qopheessetti si galchuuf kunoo ani fuula kee dura ergamaa koo tokko nan erga.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.20",
            "verseOrgIds": [
              "EXO.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Xiyyeeffadhuutii waan inni jedhu dhaggeeffadhu. Isatti hin fincilin; inni waan Maqaa koo of irraa qabuuf fincila kee siif hin dhiisuutii.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.21",
            "verseOrgIds": [
              "EXO.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo ati waan inni jedhu akka gaarii dhaggeeffatee waan ani dubbadhu hunda goote, ani diinota keetti diina nan taʼa; warra siin mormaniinis nan morma.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.22",
            "verseOrgIds": [
              "EXO.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergamaan koos fuula kee dura deemee biyya Amoorotaatti, Heetotaatti, Feerzotaatti, Kanaʼaanotaatti, Hiiwotaattii fi Yebuusotaatti si galcha; anis jara nan balleessa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.23",
            "verseOrgIds": [
              "EXO.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqota isaaniitiif hin sagadin; hin waaqeffatinis; hojii isaanii faanas hin buʼin. Ati isaan balleessitee soodduu waaqeffannaa isaanii illee caccabsuu qabda.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.24",
            "verseOrgIds": [
              "EXO.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.23.25",
                "verseOrgIds": [
                  "EXO.23.25"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa kee waaqeffadhu; innis midhaan keetii fi bishaan kee ni eebbisa. Dhukkubas isin gidduudhaa nan balleessa;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.25",
            "verseOrgIds": [
              "EXO.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "biyya kee keessatti dubartiin ulfi irraa baʼu yookaan dhabduun tokko iyyuu hin argamtu. Jireenya guutuus siif nan kenna.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.26",
            "verseOrgIds": [
              "EXO.23.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ani sodaachisuu koo si dura ergee saba ati itti dhuftu hunda nan burjaajessa. Akka diinonni kee hundinuu dugda sitti galanii baqatanis nan godha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.27",
            "verseOrgIds": [
              "EXO.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka inni Hiiwota, Kanaʼaanotaa fi Heetota karaa kee irraa ariʼuuf ani si duraan sonsa nan erga.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.28",
            "verseOrgIds": [
              "EXO.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka lafti onee bineensi wal horee sitti hin baayʼanneef ani waggaa tokko keessatti saba kana si duraa ariʼee hin baasu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.29",
            "verseOrgIds": [
              "EXO.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamma ati baayʼattee biyyattii dhaaltutti ani xinnoo xinnoon fuula kee duraa isaan nan baasa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.30",
            "verseOrgIds": [
              "EXO.23.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Anis daarii kee Galaana Diimaadhaa jalqabee hamma Galaana Filisxeemiitti, lafa alootii jalqabee hamma Laga Efraaxiisiitti siifin dhaaba. Namoota biyya sana jiraatanis dabarsee harka keetti nan kenna; ati immoo of duraa ariitee isaan baafta.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.31",
            "verseOrgIds": [
              "EXO.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati isaan wajjin yookaan waaqota isaanii wajjin kakuu tokko illee hin galin.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.32",
            "verseOrgIds": [
              "EXO.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka isaan biyya kee keessa jiraatan hin eeyyamaniif; yoo akkas taʼe isaan akka ati cubbuu natti hojjettu si godhu; ati waaqota isaanii waaqeffannaan kun dhugumaan kiyyoo sitti taʼaatii.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.33",
            "verseOrgIds": [
              "EXO.23.33"
            ]
          }
        }
      ]
    }
  ],
