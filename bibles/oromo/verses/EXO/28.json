    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 28:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Huccuu bifti isaa guutumaan guutuutti cuquliisa taʼe irraa wandaboo dirataa tolchi;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.31",
            "verseOrgIds": [
              "EXO.28.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 28:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "walakkaa gubbaa isaattis afaan ittiin mataa seensifatan tolchi. Akka inni hin tarsaaneefis qarqara afaan isaa irra wanni faayeffamee qopheeffame haa jiraatu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.32",
            "verseOrgIds": [
              "EXO.28.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 28:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naannoo xiyyoo wandaboo sanaatti immoo kirrii bifa cuquliisaa, dhiilgee fi bildiimaadhaan roomaanii hojjedhuutii gidduu isaatti immoo bilbila warqee tolchi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.33",
            "verseOrgIds": [
              "EXO.28.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 28:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bilbilli warqeetii fi roomaaniin sun wal jala dadarbanii naannoo xiyyoo wandaboo sanaatti haa hojjetaman.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.34",
            "verseOrgIds": [
              "EXO.28.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 28:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroon yeroo tajaajilu wandaboo kana haa uffatu; akka inni hin duuneef yommuu inni fuula",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.35",
            "verseOrgIds": [
              "EXO.28.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.28.35",
                "verseOrgIds": [
                  "EXO.28.35"
                ]
              }
            }
          ]
        },
        {
          "text": "dura iddoo qulqulluu seenuu fi yommuu inni achii gad baʼutti sagaleen bilbila sanaa ni dhagaʼama.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.35",
            "verseOrgIds": [
              "EXO.28.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 28:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Warqee qulqulluu irraa faaya tolchii,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.36",
            "verseOrgIds": [
              "EXO.28.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pc",
        "vid": "EXO 28:36"
      },
      "items": [
        {
          "text": "Kan",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.36",
            "verseOrgIds": [
              "EXO.28.36"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "EXO.28.36",
                "verseOrgIds": [
                  "EXO.28.36"
                ]
              }
            }
          ]
        },
        {
          "text": "Qulqulleeffame,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.36",
            "verseOrgIds": [
              "EXO.28.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "EXO 28:36"
      },
      "items": [
        {
          "text": "jedhiitii akkuma waan chaappaa irratti soofamuutti soofii barreessi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.36",
            "verseOrgIds": [
              "EXO.28.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 28:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faaya sana marata mataatiin wal qabsiisuuf funyoo bifa cuquliisaa itti hidhi; innis marata mataa fuula duraan haa taʼu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.37",
            "verseOrgIds": [
              "EXO.28.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 28:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faayi kunis adda Aroon irra taaʼa; Aroonis yakka kennaawwan qulqulluu ilmaan Israaʼel dhiʼeessan keessatti argamu hunda ni baata. Kunis akka isaan fuula",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.38",
            "verseOrgIds": [
              "EXO.28.38"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.28.38",
                "verseOrgIds": [
                  "EXO.28.38"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti fudhatama argataniif adda Aroon irra jiraata.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.38",
            "verseOrgIds": [
              "EXO.28.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 28:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Quncee talbaa kan qalʼifamee foʼame dhoofsisiitii qomee hojjedhu; marata mataa illee quncee talbaa gaarii irraa tolchi. Sabbannis ogeessa harka qajeeluun haa tolfamu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.39",
            "verseOrgIds": [
              "EXO.28.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EXO 28:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka ilmaan Aroonis ulfinaa fi miidhagina argataniif qomee, sabbataa fi marata mataa tolchiif.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.40",
            "verseOrgIds": [
              "EXO.28.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EXO 28:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erga uffata kana obboleessa kee Aroonittii fi ilmaan isaatti uffiftee booddee dibii isaan muudi. Akka isaan luboota taʼanii na tajaajilaniifis isaan qulqulleessi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.41",
            "verseOrgIds": [
              "EXO.28.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EXO 28:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Qumxaa wayyaa jalaa kan mudhiidhaa jalqabee hamma gudeedaatti qullaa namaa dhoksu quncee talbaa irraa hojjedhuuf.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.42",
            "verseOrgIds": [
              "EXO.28.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EXO 28:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroonii fi ilmaan isaa akka balleessaa hojjetanii hin duuneef yeroo dunkaana wal gaʼii seenan yookaan Iddoo Qulqulluu sanatti tajaajila kennuuf iddoo aarsaatti dhiʼaatan uffata kana uffachuu qabu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.43",
            "verseOrgIds": [
              "EXO.28.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 28:43"
      },
      "items": [
        {
          "text": "\"Kunis Aroonii fi sanyii isaatiif sirna bara baraa haa taʼu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.43",
            "verseOrgIds": [
              "EXO.28.43"
            ]
          }
        }
      ]
    }
