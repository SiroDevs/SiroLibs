    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 37:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baattuu ibsaa, somaa isaatii fi damee isaa wajjin warqee qulqulluu irraa tumanii tolchan; waciitii isaa, hudhaa isaatii fi daraaraa isaa illee warqeedhuma tokko irraa tolchan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.17",
            "verseOrgIds": [
              "EXO.37.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 37:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bitaa mirga baattuu ibsaa sana keessaas dameewwan jaʼa jechuunis sadii gama tokkoon sadii immoo gama kaaniin baafaman.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.18",
            "verseOrgIds": [
              "EXO.37.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 37:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Xoofoowwan lawuzii fakkaatan kanneen tokkoon tokkoon isaanii hudhaa fi daraaraa qaban sadii damee tokko irratti, waciitiiwwan lawuzii fakkaatan kanneen tokkoon tokkoon isaanii hudhaa fi daraaraa qaban sadii immoo damee kaan irratti tolchan. Dameewwan jaʼaan baattuu ibsaa irraa babbaʼan hunda irrattis akkasuma tolchan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.19",
            "verseOrgIds": [
              "EXO.37.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 37:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Xoofoowwan hudhaa fi daraaraa qaban kanneen bifa lawuziitiin tolfaman afur baattuu ibsaa sana irra turan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.20",
            "verseOrgIds": [
              "EXO.37.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 37:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hudhaan tokko cimdii jalqabaa kan dameewwan baattuu ibsaa irraa babbaʼan jala, hudhaan lammaffaan cimdii lammaffaa jala, hudhaan sadaffaan immoo cimdii sadaffaa jala ture; walumaa galatti dameewwan jaʼatu ture.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.21",
            "verseOrgIds": [
              "EXO.37.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 37:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hudhaawwanii fi dameewwan hundinuu baattuu ibsaa sana wajjin warqeedhuma qulqulluu tumame tokko irraa tolfaman.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.22",
            "verseOrgIds": [
              "EXO.37.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 37:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibsaa torban sana, waan ittiin daaraa isaa dhadhaʼanii fi baattuu daaraa sana baattu illee warqee qulqulluu irraa tolchan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.23",
            "verseOrgIds": [
              "EXO.37.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 37:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baattuu ibsaatii fi miʼa isaa hunda warqee qulqulluu taalaantii tokko irraa tolchan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.24",
            "verseOrgIds": [
              "EXO.37.24"
            ]
          }
        }
      ]
    },
    {
