  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "EXO 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Musee fi Daggala Bobaʼu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museen bushaayee abbaa niitii isaa Yetroo lubicha Midiyaan sanaa tiksaa ture; innis gaaf tokko hamma dhiʼa lafa gammoojjiitti bushaayee sana oofee gara tulluu Waaqaa gara Kooreeb dhufe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.1",
            "verseOrgIds": [
              "EXO.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achittis Ergamaan",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.2",
            "verseOrgIds": [
              "EXO.3.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.3.2",
                "verseOrgIds": [
                  "EXO.3.2"
                ]
              }
            }
          ]
        },
        {
          "text": "daggala bobaʼu keessaa arraba ibiddaa keessaan isatti mulʼate. Museenis daggalli sun bobaʼu illee akka hin gubatin arge.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.2",
            "verseOrgIds": [
              "EXO.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museenis, \"Daggalli kun maaliif hin gubatu laata? Ani itti goree waan dinqisiisaa kana ilaaluu qaba\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.3",
            "verseOrgIds": [
              "EXO.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "EXO.3.4",
                "verseOrgIds": [
                  "EXO.3.4"
                ]
              }
            }
          ]
        },
        {
          "text": "yommuu akka Museen ilaaluuf achi gore argetti, Waaqni daggala sana keessaa, \"Musee! Musee!\" jedhee isa waame.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.4",
            "verseOrgIds": [
              "EXO.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 3:4"
      },
      "items": [
        {
          "text": "Museenis, \"Kunoo ani asan jira\" jedhee deebise.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.4",
            "verseOrgIds": [
              "EXO.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni immoo, \"As hin dhiʼaatin; Sababii iddoon ati dhaabatu kun qulqulluu taʼeef kophee kee baafadhu\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.5",
            "verseOrgIds": [
              "EXO.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itti fufees, \"Ani Waaqa abbaa keetii, Waaqa Abrahaam, Waaqa Yisihaaqii fi Waaqa Yaaqoob\" jedhe. Kana irratti Museen Waaqa ilaaluu waan sodaateef fuula isaa dhokfate.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.6",
            "verseOrgIds": [
              "EXO.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.3.7",
                "verseOrgIds": [
                  "EXO.3.7"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedhe; \"Ani dhugumaan dhiphina saba koo warra Gibxi keessa jiraatan irra gaʼu argeera. Iyya isaan warra humnaan isaan hojjechiisan jalaa baʼuuf iyyanis dhagaʼeera; ani rakkina isaaniis nan beeka.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.7",
            "verseOrgIds": [
              "EXO.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu ani harka warra Gibxiitii isaan baasee gara biyya gaarii fi balʼaatti, biyya aannanii fi dammi keessaa burquutti jechuunis gara biyya Kanaʼaanotaatti, Heetotaatti, Amoorotaatti, Feerzotaatti, Hiiwotaattii fi Yebuusotaatti ol isaan baasuuf jedhee gad buʼeera.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.8",
            "verseOrgIds": [
              "EXO.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma kunoo iyyi Israaʼelootaa na bira gaʼeera. Ani haala itti warri Gibxi isaan cunqursanis argeera.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.9",
            "verseOrgIds": [
              "EXO.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu ati amma dhaqi. Ani akka ati saba koo Israaʼeloota Gibxi keessaa baaftuuf Faraʼoonitti sin erga.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.10",
            "verseOrgIds": [
              "EXO.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museen garuu Waaqaan, \"Faraʼoon bira dhaqee Gibxii Israaʼeloota baasuuf ani eenyu?\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.11",
            "verseOrgIds": [
              "EXO.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqnis akkana jedhe; \"Ani si wajjin nan taʼa. Ati saba sana Gibxii yommuu baaftutti isin tulluu kana irratti Waaqa waaqeffattu. Si erguu kootiifis kun mallattoo siif taʼa.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.12",
            "verseOrgIds": [
              "EXO.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museen immoo Waaqaan, \"Kunoo ani gara Israaʼelootaa dhaqee, 'Waaqni abbaa keessanii na ergeera' yommun jedhutti yoo isaan, 'Maqaan isaa eenyu?' jedhanii na gaafatan, ani maal jedheen isaanitti hima?\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.13",
            "verseOrgIds": [
              "EXO.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqnis Museedhaan, \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.14",
            "verseOrgIds": [
              "EXO.3.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "ANI ANUMA",
              "type": "text",
              "attrs": {
                "verseId": "EXO.3.14",
                "verseOrgIds": [
                  "EXO.3.14"
                ]
              }
            }
          ]
        },
        {
          "text": "; ati saba Israaʼeliin, 'Inni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.14",
            "verseOrgIds": [
              "EXO.3.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "ANI ANUMA",
              "type": "text",
              "attrs": {
                "verseId": "EXO.3.14",
                "verseOrgIds": [
                  "EXO.3.14"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhu sun gara keessanitti na ergeera' jedhi\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.14",
            "verseOrgIds": [
              "EXO.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni ammas Museedhaan akkana jedhe; \"Israaʼelootaan akkana jedhi; '",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.15",
            "verseOrgIds": [
              "EXO.3.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.3.15",
                "verseOrgIds": [
                  "EXO.3.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni abbootii keessanii, Waaqni Abrahaam, Waaqni Yisihaaq, Waaqni Yaaqoob isinitti na ergeera.'",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.15",
            "verseOrgIds": [
              "EXO.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EXO 3:15"
      },
      "items": [
        {
          "text": "\"Maqaan kun bara baraan maqaa koo ti;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.15",
            "verseOrgIds": [
              "EXO.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 3:15"
      },
      "items": [
        {
          "text": "maqaa ani dhalootaa hamma dhalootaatti",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.15",
            "verseOrgIds": [
              "EXO.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 3:15"
      },
      "items": [
        {
          "text": "ittiin yaadatamuu dha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.15",
            "verseOrgIds": [
              "EXO.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Dhaqii maanguddoota Israaʼel walitti qabiitii akkana jedhiin; '",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.16",
            "verseOrgIds": [
              "EXO.3.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.3.16",
                "verseOrgIds": [
                  "EXO.3.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni abbootii keessanii, Waaqni Abrahaam, kan Yisihaaqii fi kan Yaaqoob natti mulʼatee akkana jedhe: \"Ani isin ilaaleera; waan Gibxitti isin irra gaʼes argeera.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.16",
            "verseOrgIds": [
              "EXO.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu ani rakkina Gibxi keessaa isin baasee biyya aannanii fi dammi keessaa burqu jechuunis biyya Kanaʼaanotaa, Heetotaa, Amoorotaa, Feerzotaa, Hiiwotaatii fi biyya Yebuusotaatti isin geessuuf murteesseera.\" '",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.17",
            "verseOrgIds": [
              "EXO.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Maanguddoonni Israaʼel si dhagaʼu. Atii fi maanguddoonni Israaʼel mootii Gibxi bira dhaqxanii, '",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.18",
            "verseOrgIds": [
              "EXO.3.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.3.18",
                "verseOrgIds": [
                  "EXO.3.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni Ibrootaa nutti mulʼateera; egaa amma akka nu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.18",
            "verseOrgIds": [
              "EXO.3.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.3.18",
                "verseOrgIds": [
                  "EXO.3.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keenyaaf aarsaa dhiʼeessinuuf gara gammoojjiitti karaa guyyaa sadii nuu eeyyami' jettuun.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.18",
            "verseOrgIds": [
              "EXO.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu akka mootiin Gibxi yoo irreen jabaan isa dirqisiise malee deemuuf isinii hin eeyyamne anuu beeka.",
          "type": "text",
          "attrs": {
