          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naasiin aarsaa sochoofamuus taalaantii 70 fi saqilii 2,400 ture.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.29",
            "verseOrgIds": [
              "EXO.38.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 38:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isas miilla balbala dunkaana wal gaʼii, iddoo aarsaa kan naasii irraa hojjetame, gingilchaa isaa kan naasii irraa hojjetamee fi miʼa isaa hunda tolchuuf itti fayyadaman;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.30",
            "verseOrgIds": [
              "EXO.38.30"
            ]
          }
        },
