    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara mootummaa Yerobiʼaam mooticha Israaʼel keessa waggaa digdammaffaatti Aasaan mootii Yihuudaa taʼe;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.9",
            "verseOrgIds": [
              "1KI.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "innis waggaa afurtamii tokko Yerusaalemin bulche. Maqaan akkoo isaa Maʼakaa ture; isheen intala Abiishaaloom turte.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.10",
            "verseOrgIds": [
              "1KI.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aasaan akkuma Daawit Abbaan isaa hojjete sana waan fuula",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.11",
            "verseOrgIds": [
              "1KI.15.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1KI.15.11",
                "verseOrgIds": [
                  "1KI.15.11"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti qajeelaa taʼe hojjete.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.11",
            "verseOrgIds": [
              "1KI.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni mana sagadaa kan dhiirota sagaagalanii biyya sanaa balleessee waaqota tolfamoo abbootiin isaa hojjetan hundas barbadeesse.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.12",
            "verseOrgIds": [
              "1KI.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkoo isaa Maʼakaa iyyuu waan isheen fakkii Asheeraa jibbisiisaa tokko tolfatteef iddoo ulfinaa kan isheen akka haadha mootiitti qabaatte sana irra ishee buuse. Aasaan fakkii sana diigee Sulula Qeedroon keessatti ni gube.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.13",
            "verseOrgIds": [
              "1KI.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo inni iddoowwan sagadaa kanneen gaarran irraa guutumaan guutuutti balleessuu baate iyyuu bara jireenya isaa guutuu garaan Aasaa",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.14",
            "verseOrgIds": [
              "1KI.15.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "1KI.15.14",
                "verseOrgIds": [
                  "1KI.15.14"
                ]
              }
            }
          ]
        },
        {
          "text": "kennamee ture.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.14",
            "verseOrgIds": [
              "1KI.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis meetii fi warqee akkasumas miʼoota innii fi abbaan isaa Waaqaaf addaan baasan gara mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.15",
            "verseOrgIds": [
              "1KI.15.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootti",
              "type": "text",
              "attrs": {
                "verseId": "1KI.15.15",
                "verseOrgIds": [
                  "1KI.15.15"
                ]
              }
            }
          ]
        },
        {
          "text": "ni galche.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.15",
            "verseOrgIds": [
              "1KI.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aasaa fi Baʼishaan mooticha Israaʼel gidduu bara mootummaa isaanii guutuu waraanatu ture.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.16",
            "verseOrgIds": [
              "1KI.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baʼishaan mootichi Israaʼel biyya Yihuudaatti duulee akka namni tokko iyyuu daangaa biyya Aasaa mooticha Yihuudaa keessaa hin baane yookaan akka achi hin seenne gochuudhaaf jedhee Raamaa jabeessee ijaare.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.17",
            "verseOrgIds": [
              "1KI.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aasaanis meetii fi warqee mankuusa mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.18",
            "verseOrgIds": [
              "1KI.15.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootii",
              "type": "text",
              "attrs": {
                "verseId": "1KI.15.18",
                "verseOrgIds": [
                  "1KI.15.18"
                ]
              }
            }
          ]
        },
        {
          "text": "fi masaraa mootummaa ofii isaa keessatti hafe hunda fudhate. Innis waan kana qondaaltota isaatti imaanaa kennee gara Ben-Hadaad ilma Xabrimoon ilma Heziyoon mooticha Sooriyaa kan Damaasqoo taaʼee bulchaa ture sanaatti isaan erge.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.18",
            "verseOrgIds": [
              "1KI.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis, \"Akkuma walii galtee kanaan dura abbaa koo fi abbaa kee gidduu ture sanaatti ammas anaa fi si gidduu walii galteen haa jiraatu. Kunoo ani kennaa meetii fi warqee siif ergeera. Akka inni narraa deebiʼuuf dhaqiitii walii galtee Baʼishaan mooticha Israaʼel wajjin qabdu sana diigi\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.19",
            "verseOrgIds": [
              "1KI.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ben-Hadaadis yaada Aasaa Mootichaa fudhatee ajajjuuwwan loltoota isaa magaalaawwan Israaʼelitti duulchise. Innis Iiyoon, Daan, Abeel Beet Maʼaakaa fi Kinereeti hunda Niftaalemin dabalee of jala galfate.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.20",
            "verseOrgIds": [
              "1KI.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baʼishaanis yommuu waan kana dhagaʼetti Raamaa ijaaruu dhiisee Tiirzaatti gale.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.21",
            "verseOrgIds": [
              "1KI.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aasaan mootichis guutummaa Yihuudaatti ajaja baase; namni tokkos hin hambifamne; isaanis dhagaawwanii fi muka Baʼishaan achitti ittiin hojjechaa ture Raamaadhaa fudhatanii deeman. Aasaa mootichis Beniyaam keessatti Gebaa, akkasumas Miisphaa ittiin ijaarrate.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.22",
            "verseOrgIds": [
              "1KI.15.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wantoonni bara mootummaa Aasaa keessa hojjetaman kanneen biraa hundi, jabinni isaa hundi, wanni inni hojjete hundii fi magaalaawwan inni ijaare kitaaba seenaa mootota Yihuudaa keessatti barreeffamaniiru mitii? Bara dulluma isaa keessa garuu miilli isaa ni dhukkubsate.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.23",
            "verseOrgIds": [
              "1KI.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Aasaan abbootii ofii wajjin boqotee magaalaa abbaa isaa magaalaa Daawit keessatti abbootii isaa biratti awwaalame. Yehooshaafaax ilmi isaas iddoo isaa buʼee mootii taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.24",
            "verseOrgIds": [
              "1KI.15.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Naadaab Mooticha Israaʼel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naadaab ilmi Yerobiʼaamis bara Aasaan mootichi Yihuudaa mootii taʼe keessa waggaa lammaffaatti mootii Israaʼel taʼee waggaa lama Israaʼelin bulche.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.25",
            "verseOrgIds": [
              "1KI.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis karuma abbaa isaa irra deemee cubbuu abbaan isaa hojjetee saba Israaʼelinis hojjechiise sana hojjechuudhaan fuula",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.26",
            "verseOrgIds": [
              "1KI.15.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1KI.15.26",
                "verseOrgIds": [
                  "1KI.15.26"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti waan hamaa hojjete.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.26",
            "verseOrgIds": [
              "1KI.15.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuma Naadaabii fi sabni Israaʼel hundi magaalaa Filisxeemotaa kan Gibetoon jedhamtu marsaa jiranuu Baʼishaan ilmi Ahiiyaa namichi biyya Yisaakor sun Naadaabitti fincilee Gibetoon keessatti dhaʼee isa ajjeese.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.27",
            "verseOrgIds": [
              "1KI.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baʼishaanis bara Aasaan mootichi Yihuudaa mootii taʼe keessa waggaa sadaffaatti Naadaabin ajjeesee iddoo isaa buʼee mootii taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.28",
            "verseOrgIds": [
              "1KI.15.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni akkuma mootii taʼeen maatii Yerobiʼaam hunda fixe. Akkuma dubbii",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.29",
            "verseOrgIds": [
              "1KI.15.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1KI.15.29",
                "verseOrgIds": [
                  "1KI.15.29"
                ]
              }
            }
          ]
        },
        {
          "text": "karaa garbicha isaa Ahiiyaa namicha Shiilootiin dubbatee ture sanaatti hunda isaanii fixe malee nama hafuura baafatu tokko illee Yerobiʼaamiif hin hambifne.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.29",
            "verseOrgIds": [
              "1KI.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunis sababii cubbuu Yerobiʼaam hojjetee saba Israaʼelis cubbuu hojjechiisuudhaan",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.30",
            "verseOrgIds": [
              "1KI.15.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1KI.15.30",
                "verseOrgIds": [
                  "1KI.15.30"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa Israaʼel dheekkamsaaf kakaaseefii dha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.30",
            "verseOrgIds": [
              "1KI.15.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wantoonni biraa kanneen bara mootummaa Naadaab keessa hojjetamanii fi wanni inni hojjete hundi kitaaba seenaa mootota Israaʼel keessatti barreeffamaniiru mitii?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.31",
            "verseOrgIds": [
              "1KI.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aasaa fi Baʼishaan mooticha Israaʼel gidduu bara mootummaa isaanii guutuu waraanatu ture.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.32",
            "verseOrgIds": [
              "1KI.15.32"
            ]
          }
        }
      ]
    },
    {
