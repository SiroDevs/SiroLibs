          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis karuma Yerobiʼaam irra deemee cubbuu Yerobiʼaam hojjetee saba Israaʼelis hojjechiise sana hojjechuudhaan fuula",
          "type": "text",
          "attrs": {
