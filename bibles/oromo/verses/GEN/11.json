              "type": "text"
            }
          ]
        },
        {
          "text": "Taaraan waggaa 70 jiraatee Abraam, Naahoorii fi Haaraanin dhalche.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.26",
