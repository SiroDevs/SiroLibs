            "number": "9",
            "style": "v",
            "sid": "GEN 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.9",
            "verseOrgIds": [
              "GEN.11.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "GEN.11.9",
                "verseOrgIds": [
                  "GEN.11.9"
                ]
              }
            }
          ]
        },
        {
          "text": "achitti afaan addunyaa hunda waliin makeef iddoon sun Baabilon jedhame;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.9",
            "verseOrgIds": [
              "GEN.11.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "GEN.11.9",
                "verseOrgIds": [
                  "GEN.11.9"
                ]
              }
            }
          ]
        },
        {
          "text": "iddoo sanaa isaan baasee lafa hunda irra isaan bittinneesse.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.9",
            "verseOrgIds": [
              "GEN.11.9"
            ]
          }
        }
      ]
    },
