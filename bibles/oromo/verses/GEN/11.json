    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara sana addunyaan guutuun afaan tokkoo fi haasaa tokko qaba ture.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.1",
            "verseOrgIds": [
              "GEN.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni akkuma gara baʼa biiftuutti godaananiin, Shineʼaar keessatti lafa diriiraa argatanii achi qubatan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.2",
            "verseOrgIds": [
              "GEN.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis, \"Kottaa mee xuubii hojjennee ibiddaan gubnaa\" waliin jedhan. Isaanis qooda dhagaa, xuubiitti fayyadaman; hapheedhaaf immoo leeleetti fayyadaman.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.3",
            "verseOrgIds": [
              "GEN.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii, \"Kottaa mee akka ofii keenyaa maqaa argannuu fi akka addunyaa guutuu irra hin bibittinnoofneef magaalaa gamoon isaa samii qaqqabu tokko ijaarrannaa\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.4",
            "verseOrgIds": [
              "GEN.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "GEN.11.5",
                "verseOrgIds": [
                  "GEN.11.5"
                ]
              }
            }
          ]
        },
        {
          "text": "garuu magaalaa fi gamoo isaan ijaaraa turan sana ilaaluuf gad buʼe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.5",
            "verseOrgIds": [
              "GEN.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "GEN.11.6",
                "verseOrgIds": [
                  "GEN.11.6"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedhe; \"Erga isaan akka saba tokko kan afaanuma tokko dubbatuutti waan kana hojjechuu jalqabanii, yoos amma wanni isaan hojjechuuf karoorfatan kan isaaniif hin dandaʼamne tokko iyyuu hin jiraatu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.6",
            "verseOrgIds": [
              "GEN.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kottaa mee gad buunee, akka isaan wal hin hubanneef afaan isaanii waliin dhoofnaa!\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.7",
            "verseOrgIds": [
              "GEN.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
