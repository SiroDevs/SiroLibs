            "verseOrgIds": [
              "GEN.11.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "GEN.11.8",
                "verseOrgIds": [
                  "GEN.11.8"
                ]
              }
            }
          ]
        },
        {
          "text": "achii isaan baasee lafa hunda irra isaan bittinneesse; isaanis magaalaa ijaaruu dhiisan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.8",
            "verseOrgIds": [
              "GEN.11.8"
            ]
