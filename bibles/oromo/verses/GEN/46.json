          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmi Daan:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.23",
            "verseOrgIds": [
              "GEN.46.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 46:23"
      },
      "items": [
        {
          "text": "Hushiimii dha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.23",
            "verseOrgIds": [
              "GEN.46.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
