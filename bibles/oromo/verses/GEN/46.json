          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan kunneen ilmaan Raahel Yaaqoobiif deessee dha; isaanis walumaa galatti nama kudha afur turan.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
