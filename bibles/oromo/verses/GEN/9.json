  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "GEN 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kakuu Waaqni Nohi wajjin Gale",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni akkana jedhee Nohii fi ilmaan isaa eebbise; \"Horaa, baayʼadhaa, lafas guutaa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.1",
            "verseOrgIds": [
              "GEN.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodaachisuu fi naasisuun keessan bineensota lafaa hundumaa fi simbirroota samii hundumaa, uumamawwan lafa irra munyuuqan hundumaa fi qurxummiiwwan galaanaa hundumaa irra haa buʼu; isaan harka keessanitti kennamaniiru.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.2",
            "verseOrgIds": [
              "GEN.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni jiraatuu fi wanni munyuuqu hundi nyaata isiniif ni taʼa. Ani akkuman biqila lalisaa isinii kenne sana ammas waan hunda isiniif nan kenna.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.3",
            "verseOrgIds": [
              "GEN.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Isin garuu foon lubbuu isaa wajjin jechuunis dhiiga isaa wajjin hin nyaatinaa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.4",
            "verseOrgIds": [
              "GEN.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani dhugumaan dhiiga keessan kan lubbuun keessan keessa jirtu nan barbaada. Bineensa hunda irraa nan barbaada. Obboleessa nama hundaa irraas lubbuu namaa nan barbaada.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.5",
            "verseOrgIds": [
              "GEN.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nama dhiiga namaa dhangalaasu,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.6",
            "verseOrgIds": [
              "GEN.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 9:6"
      },
      "items": [
        {
          "text": "dhiigni isaa harka namaatiin dhangalaafama;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.6",
            "verseOrgIds": [
              "GEN.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 9:6"
      },
      "items": [
        {
          "text": "Waaqni bifa Waaqaatiin",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.6",
            "verseOrgIds": [
              "GEN.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 9:6"
      },
      "items": [
        {
          "text": "nama uumeetii.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.6",
            "verseOrgIds": [
              "GEN.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isinis horaa, baayʼadhaa; lafa guutaa, irrattis baayʼadhaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.7",
            "verseOrgIds": [
              "GEN.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Waaqni Nohii fi ilmaan isaa warra isaa wajjin turaniin akkana jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.8",
            "verseOrgIds": [
              "GEN.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kunoo ani isinii fi sanyii keessan warra isin booddee wajjin kakuu koo nan hundeessa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.9",
            "verseOrgIds": [
              "GEN.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasumas uumamawwan lubbu qabeeyyii isin wajjin turan hunda jechuunis simbirroota, horii fi bineensota lafaa hunda, waan isin wajjin doonii keessaa baʼe hunda, uumamawwan lafa irra jiraatan hunda wajjinis kakuu koo nan hundeessa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.10",
            "verseOrgIds": [
              "GEN.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka siʼachi wanni lubbuu qabu hundi deebiʼee bishaan badiisaatiin hin badneef, siʼachi bishaan badiisaa lafa balleessuuf gonkumaa akka hin dhufneef ani isin wajjin kakuu koo nan hundeessa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.11",
            "verseOrgIds": [
              "GEN.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni akkana jedhe; \"Mallattoon kakuu kan ani ofii kootii fi isin gidduutti, uumamawwan lubbuu qabeeyyii isin bira jiran hunda gidduutti, dhaloota dhufuuf jiru hundaaf galu kanaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.12",
            "verseOrgIds": [
              "GEN.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani sabbata koo duumessa keessa dhaabeera; innis kakuu anaa fi lafa gidduu jiruuf mallattoo taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.13",
            "verseOrgIds": [
              "GEN.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo ani lafa irratti duumessa fidee sabbanni koo duumessa keessaan mulʼatutti,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.14",
            "verseOrgIds": [
              "GEN.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ani kakuu koo kan ofii kootii fi isin gidduu, uumamawwan lubbu qabeeyyii gosa hundaa gidduus jiru sana nan yaadadha. Bishaanonnis deebiʼanii lubbuu hunda balleessuuf gonkumaa bishaan badiisaa hin taʼan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.15",
            "verseOrgIds": [
              "GEN.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo sabbanni koo duumessa keessaan mulʼatutti, ani isa ilaalee kakuu bara baraa kan Waaqaa fi uumamawwan lubbu qabeeyyii gosa hundaa kanneen lafa irra jiraatan gidduu jiru sana nan yaadadha.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.16",
            "verseOrgIds": [
              "GEN.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Waaqni Nohiin, \"Kun mallattoo kakuu ani ofii kootii fi lubbuu lafa irra jiraatu hunda gidduu dhaabe sanaa ti\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.17",
            "verseOrgIds": [
              "GEN.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ilmaan Nohi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaan Nohi warri doonii keessaa baʼan Seem, Haamii fi Yaafet turan. Haam abbaa Kanaʼaanii ti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.18",
            "verseOrgIds": [
              "GEN.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaan Nohi jara kana sadan turan; sanyiin namaa kan lafa hunda irra bittinneeffames isaanuma irraa argame.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.19",
            "verseOrgIds": [
              "GEN.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nohi qonnaan bulaa taʼee wayinii dhaabuutti nama jalqabaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.20",
            "verseOrgIds": [
              "GEN.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis daadhii wayinii sanaa dhugee machaaʼe; qullaa isaas dunkaana isaa keessa ciise.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.21",
            "verseOrgIds": [
              "GEN.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haam abbaan Kanaʼaan qullaa abbaa isaa argee obboloota isaa lamaan ala turanitti hime.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.22",
            "verseOrgIds": [
              "GEN.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seemii fi Yaafeti garuu wayyaa fuudhanii gatiittii isaanii lamaan irra buufatanii dugda duubaan deemanii qullaa abbaa isaaniitti uffisan. Waan fuulli isaanii achi garagalee tureef isaan qullaa abbaa isaanii hin argine.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.23",
            "verseOrgIds": [
              "GEN.9.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nohis yeroo machiin isaa irraa galetti waan ilmi isaa inni xinnaan isatti hojjete beekee",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.24",
            "verseOrgIds": [
              "GEN.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkana jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.25",
            "verseOrgIds": [
              "GEN.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 9:25"
      },
      "items": [
        {
          "text": "\"Kanaʼaan abaaramaa haa taʼu!",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.25",
            "verseOrgIds": [
              "GEN.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 9:25"
      },
      "items": [
        {
          "text": "Inni obboloota isaatiif",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.25",
            "verseOrgIds": [
              "GEN.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 9:25"
      },
      "items": [
        {
          "text": "garba garbootaa haa taʼu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.25",
            "verseOrgIds": [
              "GEN.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkanas jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.26",
            "verseOrgIds": [
              "GEN.9.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 9:26"
      },
      "items": [
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.26",
            "verseOrgIds": [
              "GEN.9.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
