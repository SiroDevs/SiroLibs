          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma inni Phenuuʼeelin darbeen aduun isatti baate; innis sababii luqqeettuu isaatiif okkolaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.31",
            "verseOrgIds": [
              "GEN.32.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Israaʼeloonni hamma harʼaatti ribuu tafaa hin nyaatan; inni buusaa luqqeettuu Yaaqoob kan tafaan wal qabatu tuqee tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.32",
