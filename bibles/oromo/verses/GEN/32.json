          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaaqoobis, \"Maaloo maqaa kee natti himi\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.29",
            "verseOrgIds": [
              "GEN.32.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 32:29"
      },
      "items": [
        {
          "text": "Inni garuu, \"Ati maaliif maqaa koo gaafatta?\" jedheen. Ergasiis inni achumatti isa eebbise.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.29",
            "verseOrgIds": [
              "GEN.32.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaaqoobis, \"Ani ifaan ifatti Waaqa argeeraatii; lubbuun koo garuu oolfamteerti\" jedhee iddoo sana Pheniiʼeel jedhee moggaase.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.30",
            "verseOrgIds": [
              "GEN.32.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
