            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashmoonaadhaa kaʼanii Mooserooti qubatan.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
