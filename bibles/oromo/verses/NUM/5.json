            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Yoo dubartiin utuma dhirsa qabduu karaa irraa gortee of xureessite",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.29",
            "verseOrgIds": [
