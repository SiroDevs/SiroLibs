          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni nama miti; inni hin sobu;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.19",
            "verseOrgIds": [
              "NUM.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 23:19"
      },
      "items": [
        {
          "text": "yookaan gaabbuudhaaf inni ilma namaa miti.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.19",
            "verseOrgIds": [
              "NUM.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 23:19"
      },
      "items": [
        {
          "text": "Inni waa dubbatee ergasii hin hojjetuu?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.19",
            "verseOrgIds": [
              "NUM.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 23:19"
      },
      "items": [
        {
          "text": "Inni waa abdachiisee ergasii hin raawwatuu?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.19",
            "verseOrgIds": [
              "NUM.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
