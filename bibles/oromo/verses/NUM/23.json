              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.23.21",
                "verseOrgIds": [
                  "NUM.23.21"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni isaanii isaan wajjin jira;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.21",
            "verseOrgIds": [
              "NUM.23.21"
            ]
          }
        }
      ]
