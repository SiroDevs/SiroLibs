      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 23:21"
      },
      "items": [
        {
          "text": "rakkina tokko illee Israaʼel keessatti hin argine.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.21",
            "verseOrgIds": [
              "NUM.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 23:21"
      },
      "items": [
        {
          "name": "char",
