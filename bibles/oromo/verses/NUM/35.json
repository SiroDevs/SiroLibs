    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Magaalaawwan jaʼan isin Lewwotaaf kennitan magaalaawwan itti baqatan kanneen namni nama ajjeese itti baqatu taʼu. Magaalaawwan afurtamii lamas kanatti dabalaatii isaanii kennaa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.6",
            "verseOrgIds": [
              "NUM.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walumaa galatti magaalaawwan afurtamii saddeet kanneen lafa tika ofii isaanii qaban Lewwotaaf kennaa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.7",
            "verseOrgIds": [
              "NUM.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magaalaawwan isin lafa Israaʼeloonni dhaalan irraa Lewwotaaf kennitan, akkuma qooda dhaala tokkoo tokkoo gosaatti haa taʼu; gosa dhaala baayʼee qabu irraa magaalaawwan baayʼee, gosa dhaala muraasa qabu irraa immoo magaalaawwan xinnoo fuudhaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.8",
            "verseOrgIds": [
              "NUM.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "NUM.35.9",
                "verseOrgIds": [
                  "NUM.35.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Museedhaan akkana jedhe:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.9",
            "verseOrgIds": [
              "NUM.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Israaʼelootatti dubbadhu; akkanas jedhiin: 'Isin yommuu Yordaanosin ceetanii Kanaʼaanitti galtanitti,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.10",
            "verseOrgIds": [
              "NUM.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "akka isin magaalaawwan itti baqatan kanneen namni tasa nama ajjeese itti baqatu isinii taʼaniif magaalaawwan filadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.11",
            "verseOrgIds": [
              "NUM.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magaalaawwan kunneenis akka namni nama ajjeesuudhaan himatame utuu murtii argachuuf waldaa duratti hin dhiʼaatin hin duuneef iddoo inni itti nama haaloo isa baʼu jalaa baqatu taʼu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.12",
            "verseOrgIds": [
              "NUM.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magaalaawwan isin kennitan jaʼan kunneenis magaalaawwan itti baqattan isinii taʼu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.13",
            "verseOrgIds": [
              "NUM.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yordaanos gamanaan magaalaawwan sadii, Kanaʼaan keessaa immoo magaalaawwan sadii, magaalaawwan itti baqatan godhaa kennaa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.14",
            "verseOrgIds": [
              "NUM.35.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magaalaawwan jaʼan kunneen akka namni tasa nama ajjeese kam iyyuu itti baqatuuf Israaʼelootaaf, alagootaa fi saba isaan gidduu jiraatuuf iddoo itti baqatan taʼu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.15",
            "verseOrgIds": [
              "NUM.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Namni tokko yoo meeshaa sibiilaatiin nama dhaʼee namichi sun duʼe, inni ajjeese sun nama gumaa ti; namichi ajjeese sun ajjeefamuu qaba.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.16",
            "verseOrgIds": [
              "NUM.35.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yookaan namni tokko yoo dhagaa nama ajjeesuu dandaʼu harkatti qabatee nama dhaʼee ajjeese, inni nama gumaa ti; namichi nama ajjeese sun ajjeefamuu qaba.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.17",
            "verseOrgIds": [
              "NUM.35.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yookaan namni tokko yoo meeshaa mukaa kan nama ajjeesuu dandaʼu harkatti qabatee nama dhaʼee namichi sun duʼe, inni ajjeese sun nama gumaa ti; namichi nama ajjeese sun ajjeefamuu qaba.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.18",
            "verseOrgIds": [
              "NUM.35.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichi haaloo dhiigaa baʼu sun namicha nama ajjeese sana haa ajjeesu; inni yommuu argatutti isa haa ajjeesu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.19",
            "verseOrgIds": [
              "NUM.35.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 35:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni tokko yoo jibbaan nama darbatee lafaan dhaʼee yookaan beekaa waa itti darbachuudhaan isa ajjeese,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.20",
            "verseOrgIds": [
              "NUM.35.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 35:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "yookaan yoo diinummaadhaan kaʼee harkaan isa dhaʼee namichi sun duʼe, inni nama ajjeese sun ajjeefamuu qaba; inni nama gumaa ti. Namichi haaloo dhiigaa baʼu sun namicha nama ajjeese sana yeroo argatutti isa haa ajjeesu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.21",
            "verseOrgIds": [
              "NUM.35.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 35:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Garuu inni yoo utuu diinummaa hin qabaatin tasa nama darbatee lafaan dhaʼe yookaan utuu hin beekin waan tokko isatti darbatee",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.22",
            "verseOrgIds": [
              "NUM.35.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 35:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "yookaan utuu isa hin argin dhagaa isa ajjeesuu dandaʼu itti gad dhiisee namichi sun duʼe, inni waan diina isaa hin taʼinii fi isa miidhuuf hin yaadiniif",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.23",
            "verseOrgIds": [
              "NUM.35.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 35:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "waldaan sun akkuma seera kanneeniitti namicha nama ajjeese sanaa fi isa haaloo dhiigaa baʼu sana gidduutti murtii haa kennu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.24",
            "verseOrgIds": [
              "NUM.35.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 35:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waldaan sun namicha nama ajjeesuudhaan himatame sana harka namicha haaloo dhiigaa baʼu sanaa jalaa baasee magaalaa inni itti baqatee ture sanatti deebisee isa haa ergu. Innis hamma lubni ol aanaan zayitii qulqulluudhaan dibame sun duʼutti achuma haa turu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.25",
            "verseOrgIds": [
              "NUM.35.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 35:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Taʼus yoo namichi nama ajjeese sun daarii magaalaa itti baqate sanaa keessaa baʼee",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.26",
            "verseOrgIds": [
              "NUM.35.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 35:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "namichi haaloo dhiigaa baʼu sun magaalaa sanaan alatti isa argate, namichi haaloo dhiigaa baʼu sun namicha himatame sana ajjeesuu dandaʼa; yakka ajjeechaa sanaattis hin gaafatamu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.27",
            "verseOrgIds": [
              "NUM.35.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 35:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichi nama ajjeese sun hamma lubni ol aanaan sun duʼutti magaalaa itti baqate keessa turuu qaba; inni erga lubichi ol aanaan duʼee booddee gara qabeenya isaatti deebiʼuu dandaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.28",
            "verseOrgIds": [
              "NUM.35.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 35:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Isaan kunneenis dhaloota dhufu keessatti lafa isin jiraattan kamitti iyyuu seeraa fi qajeelfama isiniif haa taʼan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.29",
            "verseOrgIds": [
              "NUM.35.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 35:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Namni kam iyyuu yoo nama ajjeese namichi sun ragaa dhugaa baatonni kennaniin ajjeefama. Taʼus namni kam iyyuu dhuga baʼumsa nama tokkoo qofaan hin ajjeefamin.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.30",
            "verseOrgIds": [
              "NUM.35.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 35:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Namicha nama ajjeesee duuti isaaf malu tokko irraa gumaa lubbuu hin fudhatinaa. Inni ajjeefamuu qaba.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.31",
            "verseOrgIds": [
              "NUM.35.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 35:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Akka inni utuu lubichi ol aanaan hin duʼin dura biyya ofii isaatti deebiʼee achi jiraatu eeyyamuuf jettanii nama gara magaalaa itti baqataniitti baqate kamiif iyyuu gumaa hin fudhatinaa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.32",
            "verseOrgIds": [
              "NUM.35.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 35:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Sababii dhangalaafamuun dhiigaa biyya xureessuuf, isin biyya keessa jiraattan sana hin xureessinaa; dhiiguma namicha dhiiga dhangalaase sanaatiin malees biyya dhiigni itti dhangalaafame sanaaf araarri hin buufamu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.33",
            "verseOrgIds": [
              "NUM.35.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 35:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biyya isin keessa jirtan iddoo ani jiraadhu sana hin xureessinaa. Ani",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.34",
            "verseOrgIds": [
              "NUM.35.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.35.34",
                "verseOrgIds": [
                  "NUM.35.34"
                ]
              }
            }
          ]
        },
        {
          "text": "Israaʼeloota gidduu nan jiraadhaatii.' \"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.34",
            "verseOrgIds": [
              "NUM.35.34"
            ]
          }
        }
      ]
    }
  ],
