    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Magaalaawwan Lewwotaaf Kennaman",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "NUM.35.1",
                "verseOrgIds": [
                  "NUM.35.1"
                ]
              }
            }
          ]
        },
        {
          "text": "dirreewwan Moʼaab irratti, Yordaanos biratti, Yerikoo gamatti Museedhaan akkana jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.1",
            "verseOrgIds": [
              "NUM.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Israaʼeloonni dhaala ofii isaaniitii argachuuf jiran keessaa magaalaawwan Lewwonni keessa jiraatan akka isaanii kennan Israaʼeloota ajaji. Lafa horii itti bobbaafatanis naannoo magaalaawwaniitti haa kennaniif.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.2",
            "verseOrgIds": [
              "NUM.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis magaalaawwan keessa jiraatanii fi lafa itti loon isaaniitii fi horii isaanii kaan hunda bobbaafatan ni qabaatu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.3",
            "verseOrgIds": [
              "NUM.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Lafti horiin itti bobbaʼu kan isin naannoo magaalaawwaniitti Lewwotaaf kennitan sun dallaa magaalaa irraa jalqabee gama hundaan dhundhuma kuma tokko achi balʼata.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.4",
            "verseOrgIds": [
              "NUM.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magaalaa sana gidduutti hambisuudhaan karaa alaatiin gama baʼaatiin dhundhuma kuma lama, gama kibbaatiin dhundhuma kuma lama, gama dhiʼaatiin dhundhuma kuma lama, gama kaabaatiin immoo dhundhuma kuma lama safaraa. Iddoowwan kunneen magaalaawwan sanaaf iddoowwan itti horii bobbaafatan taʼu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.5",
            "verseOrgIds": [
              "NUM.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Magaalaawwan Itti Baqatan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
