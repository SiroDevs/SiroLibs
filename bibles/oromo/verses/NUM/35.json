          },
          "items": [
            {
              "text": "35:6‑34",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwi –",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "xt"
          },
          "items": [
