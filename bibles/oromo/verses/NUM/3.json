          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lewwonni lakkaaʼaman hundi kanneen Musee fi Aroon ajaja",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootiin",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkuma balbala balbala isaaniitti lakkaaʼan, dhiironni jiʼa tokkoo fi hammasii olii hundi 22,000 turan.",
          "type": "text"
        }
      ]
    },
