          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balbalawwan Mahelootaa fi Muusotaa kan Meraarii turan; isaanis balbalawwan Meraarotaa ti.",
          "type": "text"
