          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itti gaafatamni Geershoononni dunkaana wal gaʼii keessatti qabanis dunkaana qulqulluu, dunkaanaa fi irra buusaa isaa, golgaa balbala dunkaana wal gaʼii irra jiru,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.25",
            "verseOrgIds": [
              "NUM.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "golgaawwan oobdii, golgaa balbala dallaa kan dunkaana qulqulluu fi iddoo aarsaatti naannaʼee jiru, funyoo fi tajaajila akkanaa kennu hunda eeguu ture.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.26",
            "verseOrgIds": [
              "NUM.3.26"
            ]
          }
        }
      ]
    },
    {
