    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NUM 3:17"
      },
      "items": [
        {
          "text": "Geershoon, Qohaatii fi Meraarii.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.17",
            "verseOrgIds": [
              "NUM.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunneen maqaawwan ilmaan Geershoonii ti:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.18",
            "verseOrgIds": [
              "NUM.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NUM 3:18"
      },
      "items": [
        {
          "text": "Loobeenii fi Shimeʼii.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.18",
            "verseOrgIds": [
              "NUM.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balbalawwan Qohaatotaa:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.19",
            "verseOrgIds": [
              "NUM.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NUM 3:19"
      },
      "items": [
        {
          "text": "Amraam, Yizihaar, Kebroonii fi Uziiʼeel.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.19",
            "verseOrgIds": [
              "NUM.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balbalawwan Meraarotaa:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.20",
            "verseOrgIds": [
              "NUM.3.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NUM 3:20"
      },
      "items": [
        {
          "text": "Mahilii fi Muusii.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.20",
            "verseOrgIds": [
              "NUM.3.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "NUM 3:20"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lf",
        "vid": "NUM 3:20"
      },
      "items": [
        {
          "text": "Kunneen akkuma maatii isaaniitti balbalawwan Lewwotaa ti.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lh"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balbalawwan Liibnii fi Shimeʼii kan Geershoon turan; isaanis balbalawwan Geershoonotaa ti.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baayʼinni dhiirota umuriin isaanii jiʼa tokkoo fi hammasii olii kanneen lakkaaʼaman hundaa 7,500 ture.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.22",
            "verseOrgIds": [
              "NUM.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balbalawwan Geershoonotaa karaa lixa biiftuutiin dunkaana qulqulluu dugda duubaan qubatan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.23",
