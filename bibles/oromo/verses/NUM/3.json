      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis taabota, minjaala, baattuu ibsaa, iddoowwan aarsaa, miʼa iddoo qulqulluu ittiin tajaajilan, golgaa fi wantoota tajaajila akkanaa kennan hunda eeguutti itti gaafatamtoota turan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.31",
            "verseOrgIds": [
              "NUM.3.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hoogganaan Lewwotaa hangafti Eleʼaazaar ilma Aroon lubichaa ture. Innis warra itti gaafatamtoota eegumsa iddoo qulqulluu turan sana irratti dibame.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.32",
            "verseOrgIds": [
              "NUM.3.32"
            ]
          }
        }
      ]
