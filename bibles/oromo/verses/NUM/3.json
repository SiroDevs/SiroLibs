          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hoogganaan maatiiwwan balbalawwan Qohaatotaas Eliisaafaan ilma Uziiʼeel ture.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.30",
            "verseOrgIds": [
