              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼeloota hangafoota 273 kanneen baayʼina Lewwotaa caalan furuuf,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.46",
            "verseOrgIds": [
              "NUM.3.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
