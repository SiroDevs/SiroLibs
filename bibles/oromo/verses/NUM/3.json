              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baayʼinni dhiirota umuriin isaanii jiʼa tokkoo fi hammasii olii kanneen lakkaaʼaman hundaa 6,200 ture.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.34",
