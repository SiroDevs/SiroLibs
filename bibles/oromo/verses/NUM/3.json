                "verseOrgIds": [
                  "NUM.3.40"
                ]
              }
            }
          ]
        },
        {
          "text": "Museedhaan akkana jedhe; \"Dhiirota Israaʼel hangafoota kanneen jiʼa tokkootii fi hammasii olii hunda lakkaaʼii maqaa isaanii barreessi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.40",
            "verseOrgIds": [
              "NUM.3.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 3:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qooda ijoollee Israaʼel kanneen hangafa taʼan hundaa Lewwota naa fudhadhu; qooda ilmaan hangafa horii Israaʼelootaa hundaas horii Lewwotaa naa fudhadhu. Ani",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.41",
            "verseOrgIds": [
              "NUM.3.41"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
