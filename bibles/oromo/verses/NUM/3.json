              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hoogganaan balbalawwan Geershoonotaas Eliyaasaaf ilma Laaʼel ture.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.24",
            "verseOrgIds": [
