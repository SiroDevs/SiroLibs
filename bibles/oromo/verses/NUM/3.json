                "verseId": "NUM.3.41",
                "verseOrgIds": [
                  "NUM.3.41"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.41",
            "verseOrgIds": [
              "NUM.3.41"
            ]
          }
        }
      ]
    },
