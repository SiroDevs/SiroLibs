          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhiironni hangafoonni jiʼa tokkoo fi hammasii olii kanneen maqaa maqaan barreeffaman hundii 22,273 turan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.43",
            "verseOrgIds": [
              "NUM.3.43"
            ]
          }
