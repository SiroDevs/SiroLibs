          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baayʼinni dhiirota jiʼa tokkoo fi hammasii olii hundaa 8,600 ture.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.28",
            "verseOrgIds": [
              "NUM.3.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NUM 3:28"
      },
      "items": [
        {
          "text": "Qohaatonni iddoo qulqulluu sana eeguutti itti gaafatamtoota turan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.28",
            "verseOrgIds": [
              "NUM.3.28"
            ]
          }
        }
      ]
    },
    {
