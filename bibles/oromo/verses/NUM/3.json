          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balbalawwan Amraamotaa, Yizihaarotaa, Kebroonotaa fi Uziiʼeelotaa balbalawwan Qohaatii ti; isaanis balbalawwan Qohaatotaa turan.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
