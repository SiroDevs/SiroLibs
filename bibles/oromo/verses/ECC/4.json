{
  "id": "ECC.4",
  "number": "4",
  "bookId": "ECC",
  "reference": "Lallaba 4",
  "copyright": "Biblica® Hiikkaa Ammayyaa Banamaa Haaraa™, Loqoda Dhiʼaa Mirgi seeraan eegama © 2022 Biblica, Inc. Biblica® Open New Oromo Contemporary Version™, Western Copyright © 2022 by Biblica, Inc. \"Biblica\" jechuun mallattoo eenyummaa kan Biblica, Inc., Waajjira Eeyyamaa fi Mallattoo Eenyummaa kan Ameerikaa keessaatti galmeessee dha. Eeyyamaan itti fayyadamu. \"Biblica\" is trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "ECC 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cunqursaa, Hojiidhaan Dadhabuu, Michuu Dhabuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani ammas ilaalee cunqursaa aduudhaa gaditti adeemsifamaa jiru hunda nan arge:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.1",
            "verseOrgIds": [
              "ECC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:1"
      },
      "items": [
        {
          "text": "Ani imimmaan cunqurfamtootaa nan arge;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.1",
            "verseOrgIds": [
              "ECC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:1"
      },
      "items": [
        {
          "text": "nama isaan jajjabeessu tokko illees hin qaban;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.1",
            "verseOrgIds": [
              "ECC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:1"
      },
      "items": [
        {
          "text": "humni gama cunqursitoota isaanii ture;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.1",
            "verseOrgIds": [
              "ECC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:1"
      },
      "items": [
        {
          "text": "isaan nama isaan jajjabeessu tokko illee hin qaban.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.1",
            "verseOrgIds": [
              "ECC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis akka warri duʼan,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.2",
            "verseOrgIds": [
              "ECC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:2"
      },
      "items": [
        {
          "text": "kanneen kanaan dura duʼan,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.2",
            "verseOrgIds": [
              "ECC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:2"
      },
      "items": [
        {
          "text": "jiraattota amma lubbuudhaan jiraatan caalan nan labse.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.2",
            "verseOrgIds": [
              "ECC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu namni hamma ammaatti hin dhalatin",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.3",
            "verseOrgIds": [
              "ECC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:3"
      },
      "items": [
        {
          "text": "kan hammina aduudhaa gaditti",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.3",
            "verseOrgIds": [
              "ECC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:3"
      },
      "items": [
        {
          "text": "hojjetamu hin argin,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.3",
            "verseOrgIds": [
              "ECC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:3"
      },
      "items": [
        {
          "text": "lachan isaanii irra wayya.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.3",
            "verseOrgIds": [
              "ECC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis akka dadhabbiin hojii hundii fi milkaaʼuun hundi hinaaffaa namni ollaa isaa wajjin qabu irraa burqu nan arga. Kunis bubbee ariʼuu dha; faayidaas hin qabu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.4",
            "verseOrgIds": [
              "ECC.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gowwaan harka isaa maratee taaʼa;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.5",
            "verseOrgIds": [
              "ECC.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:5"
      },
      "items": [
        {
          "text": "foonuma ofii isaas nyaata.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.5",
            "verseOrgIds": [
              "ECC.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dadhabbii fi bubbee ariʼuudhaan",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.6",
            "verseOrgIds": [
              "ECC.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:6"
      },
      "items": [
        {
          "text": "konyee lama argachuu irra",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.6",
            "verseOrgIds": [
              "ECC.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:6"
      },
      "items": [
        {
          "text": "nagaan konyee tokko argachuu wayya.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.6",
            "verseOrgIds": [
              "ECC.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani amma illee waan faayidaa hin qabne tokko aduudhaa gaditti nan arge:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.7",
            "verseOrgIds": [
              "ECC.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama kophaa isaa jiraatu tokkotu jira;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:8"
      },
      "items": [
        {
          "text": "innis ilma yookaan obboleessa hin qabu ture.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:8"
      },
      "items": [
        {
          "text": "Yeroo hunda hojiitti dadhaba;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:8"
      },
      "items": [
        {
          "text": "taʼus iji isaa qabeenya isaa ilaalee quufe hin jedhu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:8"
      },
      "items": [
        {
          "text": "Innis, \"Ani eenyuuf jedheen dadhaba?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:8"
      },
      "items": [
        {
          "text": "Maaliifan gammachuus of laga?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:8"
      },
      "items": [
        {
          "text": "Kunis faayidaa hin qabu;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:8"
      },
      "items": [
        {
          "text": "hojii buʼaa hin qabnee dha!",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan sababii hojii isaaniitiif gatii gaarii waan argataniif",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.9",
            "verseOrgIds": [
              "ECC.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:9"
      },
      "items": [
        {
          "text": "nama tokko irra nama lama wayya:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.9",
            "verseOrgIds": [
              "ECC.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo inni tokko kufe,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.10",
            "verseOrgIds": [
              "ECC.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:10"
      },
      "items": [
        {
          "text": "inni kaan ol isa qaba.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.10",
            "verseOrgIds": [
              "ECC.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:10"
      },
      "items": [
        {
          "text": "Garuu namni kufee kan ol isa kaasu hin qabne",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.10",
            "verseOrgIds": [
              "ECC.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:10"
      },
      "items": [
        {
          "text": "garaa nama nyaata!",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.10",
            "verseOrgIds": [
              "ECC.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo namoonni lama wajjin ciisan itti hoʼa;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.11",
            "verseOrgIds": [
              "ECC.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:11"
      },
      "items": [
        {
          "text": "nama tokko garuu akkamitti kophaa isaa itti hoʼuu dandaʼa?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.11",
            "verseOrgIds": [
              "ECC.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni tokko moʼatamuu dandaʼa;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.12",
            "verseOrgIds": [
              "ECC.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:12"
      },
      "items": [
        {
          "text": "namoonni lama garuu of irraa deebisuu dandaʼu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.12",
            "verseOrgIds": [
              "ECC.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:12"
      },
      "items": [
        {
          "text": "Funyoon foʼaa sadiin foʼame dafee hin citu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.12",
            "verseOrgIds": [
              "ECC.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Caalanii Argamuun Faayidaa Hin qabu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootii dulloomaa fi gowwaa siʼachi gorsa hin fudhanne irra, dargaggeessa hiyyeessa ogeessa wayya.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.13",
            "verseOrgIds": [
