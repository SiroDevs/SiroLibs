    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:3"
      },
      "items": [
        {
          "text": "sabootaaf immoo yeroo badiisaa ni taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.3",
            "verseOrgIds": [
              "EZK.30.3"
            ]
          }
        }
