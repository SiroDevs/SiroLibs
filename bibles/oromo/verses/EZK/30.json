    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:4"
      },
      "items": [
        {
          "text": "Itoophiyaatti immoo dhiphinni ni dhufa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.4",
            "verseOrgIds": [
              "EZK.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 30:4"
      },
      "items": [
        {
          "text": "Yommuu warri qalaman Gibxi keessatti kukkufanitti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.4",
            "verseOrgIds": [
              "EZK.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:4"
      },
      "items": [
        {
          "text": "qabeenyi ishee saamamee fudhatama;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.4",
            "verseOrgIds": [
              "EZK.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:4"
      },
      "items": [
        {
          "text": "hundeewwan ishee immoo ni diigamu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.4",
            "verseOrgIds": [
              "EZK.30.4"
            ]
          }
        }
