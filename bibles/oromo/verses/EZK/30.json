    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 30:2"
      },
      "items": [
        {
          "text": "\"Guyyaa sanaaf wayyoo!\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.2",
            "verseOrgIds": [
              "EZK.30.2"
            ]
          }
        }
