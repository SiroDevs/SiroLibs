      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 30:3"
      },
      "items": [
        {
          "text": "innis guyyaa duumessaa,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.3",
            "verseOrgIds": [
              "EZK.30.3"
            ]
