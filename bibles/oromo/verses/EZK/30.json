          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gibxitti goraadeen ni dhufa;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.4",
            "verseOrgIds": [
              "EZK.30.4"
            ]
          }
        }
