      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 30:2"
      },
      "items": [
        {
          "text": "\" 'Wawwaadhuutii akkana jedhi;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.2",
            "verseOrgIds": [
              "EZK.30.2"
            ]
