          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "anis waan",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.25",
            "verseOrgIds": [
              "EZK.11.25"
            ]
          }
        },
        {
          "name": "char",
