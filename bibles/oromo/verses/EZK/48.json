          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gosti Simiʼoon qooda tokko qabaata; kunis baʼaa hamma lixaatti biyya Beniyaam daangessa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.24",
            "verseOrgIds": [
              "EZK.48.24"
            ]
          }
        }
