          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naannoon magaalaa sanaa guutumaan guutuutti dhundhuma 18,000 taʼa.",
          "type": "text"
        }
      ]
    },
