          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daangaan Gaad kan karaa kibbaa sun Taamaarii jalqabee hamma bishaan Mariibaa Qaadeshiitti, ergasiis ededa Laga Gibxi irra hamma Galaana Guddichaatti gara Kaabaa deema.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.28",
            "verseOrgIds": [
              "EZK.48.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
