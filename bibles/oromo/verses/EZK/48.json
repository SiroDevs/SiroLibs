        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Qoqqoodamuu Biyyattii",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lh"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 48:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gosoonni maqaan isaanii galmeeffame kanneenii dha:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EZK 48:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EZK 48:1"
      },
      "items": [
        {
          "text": "\"Karaa daarii kaabaatiin gosti Daan qooda tokko qabaata; kunis daandii Hetiloon qabatee hamma qaxxaamura Hamaatitti deema; Hazar Eenaanii fi daariin Damaasqoo kan gara kaabaa inni Hamaatitti aanee jiru daarii isaa kan karaa baʼaatii jalqabee hamma karaa lixa biiftuutti jiruu taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.1",
            "verseOrgIds": [
              "EZK.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gosti Aasheer qooda tokko qabaata; kunis biyya Daan kan baʼaa hamma lixaatti jiru daangessa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.2",
            "verseOrgIds": [
              "EZK.48.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gosti Niftaalem qooda tokko qabaata; kunis biyya Aasheer kan baʼaa hamma lixaatti jiru daangessa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.3",
            "verseOrgIds": [
              "EZK.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gosti Minaasee qooda tokko qabaata; kunis biyya Niftaalem kan baʼaa hamma lixaatti jiru daangessa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.4",
            "verseOrgIds": [
              "EZK.48.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gosti Efreem qooda tokko qabaata; kunis biyya Minaasee kan baʼaa hamma lixaatti jiru daangessa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.5",
            "verseOrgIds": [
              "EZK.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gosti Ruubeen qooda tokko qabaata; kunis biyya Efreem kan baʼaa hamma lixaatti jiru daangessa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.6",
            "verseOrgIds": [
              "EZK.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gosti Yihuudaa qooda tokko qabaata; kunis biyya Ruubeen kan baʼaa hamma lixaatti jiru daangessa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.7",
            "verseOrgIds": [
              "EZK.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Biyyi baʼa biiftuutii gara lixa biiftuutti Yihuudaa daangessu qooda isin kennaa addaa gootanii dhiʼeessuu qabdanii dha. Balʼinni isaas dhundhuma 25,000, dheerinni isaa immoo baʼa biiftuutii gara lixa biiftuutti qooda gosaa keessaa isa tokko wajjin wal qixxee taʼa; iddoon qulqulluun sunis biyya sana gidduutti argama.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.8",
            "verseOrgIds": [
              "EZK.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Qoodni addaa kan isin",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.9",
            "verseOrgIds": [
              "EZK.48.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "EZK.48.9",
                "verseOrgIds": [
                  "EZK.48.9"
                ]
              }
            }
          ]
        },
        {
          "text": "dhiʼeessuu qabdan dheerinni isaa dhundhuma 25,000, balʼinni isaa immoo dhundhuma 10,000 taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.9",
            "verseOrgIds": [
              "EZK.48.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunis lubootaaf qooda qulqulluu taʼa. Innis karaa kaabaatiin dhundhuma 25,000 dheerata; karaa lixa biiftuutiin dhundhuma 10,000 balʼata; karaa baʼa biiftuun dhundhuma 10,000 balʼata; karaa kibbaatiin immoo dhundhuma 25,000 dheerata. Manni qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.10",
            "verseOrgIds": [
              "EZK.48.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoos",
              "type": "text",
              "attrs": {
                "verseId": "EZK.48.10",
                "verseOrgIds": [
                  "EZK.48.10"
                ]
              }
            }
          ]
        },
        {
          "text": "gidduu isaatti argama.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.10",
            "verseOrgIds": [
              "EZK.48.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunis luboota qulqullaaʼoo jechuunis ilmaan Zaadoq kanneen amanamummaadhaan na tajaajilaa turan kanneen yeroo Israaʼeloonni karaa irraa badanitti akka Lewwonni karaa irraa badan sana karaa irraa hin badin sanaaf taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.11",
            "verseOrgIds": [
              "EZK.48.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis qooda biyyattii isa qulqulluu irraa jechuunis qooda qulqulluu kan qooda hunda caalaa qulqulluu taʼe irraa kan biyya Lewwotaa daangessu sun isaaniif kennaa addaa taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.12",
            "verseOrgIds": [
              "EZK.48.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Biyya lubootaa biraan Lewwonni lafa dheerinni isaa dhundhuma 25,000, balʼinni isaa immoo dhundhuma 10,000 qabaatu. Walumaa galatti dheerinni isaa dhundhuma 25,000 balʼinni isaa immoo dhundhuma 10,000 taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.13",
            "verseOrgIds": [
              "EZK.48.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 48:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis lafa sana irraa waan tokko illee gurguruu yookaan geeddaruu hin qaban. Lafti kun biyyattii keessaa filatamaa dha; sababii",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.14",
            "verseOrgIds": [
              "EZK.48.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "EZK.48.14",
                "verseOrgIds": [
                  "EZK.48.14"
                ]
              }
            }
          ]
        },
        {
          "text": "qulqulluu taʼeefis harka nama biraatti darbuu hin qabu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.14",
            "verseOrgIds": [
              "EZK.48.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 48:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Lafti hafe kan balʼinni isaa dhundhuma 5,000, dheerinni isaa immoo dhundhuma 25,000 taʼe faayidaa magaalattiitiif oola; kunis ijaarsa manneeniitii fi lafa dheedaatiif taʼa. Magaalattiin immoo isa gidduu jiraatti;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.15",
            "verseOrgIds": [
              "EZK.48.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 48:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "magaalattiinis karaa kaabaatiin dhundhuma 4,500, karaa kibbaatiin dhundhuma 4,500, karaa baʼaatiin dhundhuma 4,500 karaa lixaatiinis dhundhuma 4,500 balʼatti.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.16",
            "verseOrgIds": [
              "EZK.48.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 48:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magaalattiin kaabaan dhundhuma 250, kibbaan dhundhuma 250, baʼaan dhundhuma 250, dhiʼaanis dhundhuma 250 lafa dheedaa ni qabaatti.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.17",
            "verseOrgIds": [
              "EZK.48.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 48:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni lafa sana irraa hafe kan kutaa qulqulluu daangessuu fi dheerina lafa sanaa qabatee jiru karaa baʼaatiin dhundhuma 10,000, karaa dhiʼaatiin illee dhundhuma 10,000 ni taʼa. Oomishni lafa sanaas hojjettoota magaalattiitiif nyaata ni taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.18",
            "verseOrgIds": [
              "EZK.48.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 48:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojjettoonni magaalattii kanneen lafa qotatan gosoota Israaʼel hunda keessaa dhufu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.19",
            "verseOrgIds": [
              "EZK.48.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 48:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutaan lafa sanaa hundi roga wal qixxee afur qabaata; tokkoon tokkoon roga sanaas dhundhuma 25,000 taʼa. Qabeenya magaalaa wajjinis akka kennaa addaa taʼuuf kutaa qulqulluu hambisaa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.20",
            "verseOrgIds": [
              "EZK.48.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 48:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wanni karaa kutaa qulqulluu lamaanii fi qabeenya magaalattii irraa hafe bulchaa sanaaf taʼa. Innis karaa baʼaa kutaa qulqulluu kan dhundhuma 25,000 dheeratu sana irraa jalqabee gara daangaa baʼaatti, karaa dhiʼaa immoo lafa dhundhuma 25,000 dheeratu sana irraa jalqabee gara daangaa dhiʼaatti balʼata. Lafti dheerina qoodawwan gosaa qabatee jiru sun lamaan bulchaa sanaaf taʼa; kutaan qulqulluun iddoo qulqulluu kan mana qulqullummaa wajjin jiru sun isaan gidduutti argama.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.21",
            "verseOrgIds": [
              "EZK.48.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 48:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu qabeenyi Lewwotaatii fi qabeenyi magaalattii lafa bulchaa sanaaf kenname sana walakkaatti argama. Lafti bulchaa sanaaf kenname sunis daangaa Yihuudaatii fi daangaa Beniyaam gidduutti argama.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.22",
            "verseOrgIds": [
              "EZK.48.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lh"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 48:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Qoodni gosoota hafanii kan armaan gad jiruu dha:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EZK 48:23"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EZK 48:23"
      },
      "items": [
        {
          "text": "\"Gosti Beniyaam qooda tokko qabaata; kunis gara baʼaatii hamma gara dhiʼaatti balʼata.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.23",
            "verseOrgIds": [
              "EZK.48.23"
            ]
          }
        }
      ]
