          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gosti Gaad qooda tokko qabaata; kunis baʼaa hamma lixaatti biyya Zebuuloon daangessa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.27",
