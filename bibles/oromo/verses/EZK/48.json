          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZK 48:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karaa dhiʼaa karrawwan dhundhuma 4,500 dheeratan sadiitu jira; isaanis karra Gaad, karra Aasheerii fi karra Niftaalem.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.34",
            "verseOrgIds": [
              "EZK.48.34"
            ]
          }
        }
      ]
    },
