          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gosti Zebuuloon qooda tokko qabaata; kunis baʼaa hamma lixaatti biyya Yisaakor daangessa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.26",
            "verseOrgIds": [
              "EZK.48.26"
            ]
          }
        }
