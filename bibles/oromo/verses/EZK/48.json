          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gosti Yisaakorii qooda tokko qabaata; kunis baʼaa hamma lixaatti biyya Simiʼoon daangessa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.25",
