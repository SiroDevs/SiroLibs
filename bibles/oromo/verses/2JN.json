    "verseCount": 13,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "1",
          "style": "c",
          "sid": "2JN 1"
        },
        "items": [
          {
            "text": "1",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Nagaa Gaafachuu",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "po"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "2JN 1:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Jaarsicha irraa,",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "po",
          "vid": "2JN 1:1"
        },
        "items": [
          {
            "text": "Gara giiftii filatamtuu fi ijoollee ishee, warra ani dhugaadhaan jaalladhu, warra ana qofa utuu hin taʼin warri dhugaa beekan hundi akkasuma jaallataniitti;",
            "type": "text"
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "2JN 1:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "kunis sababii dhugaa nu keessa jiraatuu fi isa bara baraan nu wajjin jiraatu sanaatiif:",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "po"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "2JN 1:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ayyaanni, araarrii fi nagaan Waaqa Abbaa biraa, Yesuus Kiristoos Ilma Abbaa biraas, dhugaa fi jaalalaan nu wajjin ni taʼa.",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Galata Galchuu",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "2JN 1:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ani waan ijoollee kee keessaa tokko tokko akka isaan akkuma Abbaan nu ajajetti dhugaan jiraatan argeef baayʼee gammadeera.",
            "type": "text",
            "attrs": {
              "verseId": "2JN.1.4",
              "verseOrgIds": [
                "2JN.1.4"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "2JN 1:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ammas yaa giiftii jaallatamtuu, ani ajaja durumaa jalqabee nuuf kenname sana malee ajaja haaraa siif barreessuutti hin jiru. Akka wal jaallannuufis sin kadhadha.",
            "type": "text",
            "attrs": {
              "verseId": "2JN.1.5",
              "verseOrgIds": [
                "2JN.1.5"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "2JN 1:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Jaalallis kana: kunis ajaja isaa eegnee jiraachuu dha. Akkuma isin durumaa jalqabdanii dhageessan sana ajajni isaa akka isin jaalalaan jiraattanii dha.",
            "type": "text",
            "attrs": {
              "verseId": "2JN.1.6",
              "verseOrgIds": [
                "2JN.1.6"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "2JN 1:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Gowwoomsitoonni akka Yesuus Kiristoos fooniin dhufe hin amanne hedduun addunyaa seenaniiru. Namni akkanaa kam iyyuu gowwoomsituu fi farra Kiristoos.",
            "type": "text",
            "attrs": {
              "verseId": "2JN.1.7",
              "verseOrgIds": [
                "2JN.1.7"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "2JN 1:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "Isin akka gatii guutuu argattan malee akka waan hojjettan sana hin dhabneef of eeggadhaa.",
            "type": "text",
            "attrs": {
              "verseId": "2JN.1.8",
              "verseOrgIds": [
                "2JN.1.8"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "2JN 1:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Namni barsiisa Kiristoosiin hin jiraanne kan barsiisa sana keessaa baʼu kam iyyuu Waaqa hin qabu; namni barsiisa Kiristoosiin jiraatu hundinuu immoo Abbaas Ilmas qaba.",
            "type": "text",
            "attrs": {
              "verseId": "2JN.1.9",
              "verseOrgIds": [
                "2JN.1.9"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "2JN 1:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "Isin yoo namni kam iyyuu gara keessan dhufee garuu barsiisa kana hin fidin, mana keessanitti ol isa hin galchinaa yookaan isa hin simatinaa.",
            "type": "text",
            "attrs": {
              "verseId": "2JN.1.10",
              "verseOrgIds": [
                "2JN.1.10"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "2JN 1:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Namni isa simatu kam iyyuu hojii isaa hamaa sana keessatti qooda qabaataatii.",
            "type": "text",
            "attrs": {
              "verseId": "2JN.1.11",
              "verseOrgIds": [
                "2JN.1.11"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Xumuraa fi Dhaamsa Nagaa",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "2JN 1:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ani waanan isiniif barreessu baayʼee qaba; taʼus waraqaa fi qalamiitti fayyadamuu hin barbaadu. Qooda kanaa akka gammachuun keenya guutuu taʼuuf ani gara keessan dhufee ifaan ifatti haasofnu abdiin qaba.",
            "type": "text",
            "attrs": {
              "verseId": "2JN.1.12",
              "verseOrgIds": [
                "2JN.1.12"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "b"
        },
        "items": []
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "13",
              "style": "v",
              "sid": "2JN 1:13"
            },
            "items": [
              {
                "text": "13",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ijoolleen obboleettii kee kan filatamte sanaas nagaa siif dhaamu.",
            "type": "text",
            "attrs": {
              "verseId": "2JN.1.13",
              "verseOrgIds": [
                "2JN.1.13"
              ]
            }
          }
        ]
      }
    ],
