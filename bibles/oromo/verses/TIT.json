{
  "TIT.1": {
    "id": "TIT.1",
    "number": "1",
    "bookId": "TIT",
    "reference": "Tiitoo 1",
    "copyright": "Biblica® Hiikkaa Ammayyaa Banamaa Haaraa™, Loqoda Dhiʼaa Mirgi seeraan eegama © 2022 Biblica, Inc. Biblica® Open New Oromo Contemporary Version™, Western Copyright © 2022 by Biblica, Inc. \"Biblica\" jechuun mallattoo eenyummaa kan Biblica, Inc., Waajjira Eeyyamaa fi Mallattoo Eenyummaa kan Ameerikaa keessaatti galmeessee dha. Eeyyamaan itti fayyadamu. \"Biblica\" is trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
    "verseCount": 16,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "1",
          "style": "c",
          "sid": "TIT 1"
        },
        "items": [
          {
            "text": "1",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Nagaa gaafachuu",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "po"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "TIT 1:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Phaawulos isa amantii filatamtoota Waaqaatii fi dhugaa beekuu gara Waaqaaf buluutti nama geessuuf garbicha Waaqaatii fi ergamaa Yesuus Kiristoos taʼe irraa;",
            "type": "text"
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "TIT 1:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "kunis abdii jireenya bara baraa isa Waaqni hin sobne sun jalqaba addunyaatiin dura waadaa gale irratti kan hundeeffamee dha;",
            "type": "text"
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "TIT 1:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "innis yommuu yeroon murteeffame sun gaʼetti karaa lallaba isa ajaja Fayyisaa keenya Waaqaatiin imaanaa natti kennameetiin dubbii isaa ifatti baaseera,",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "po"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "TIT 1:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Gara Tiitoo isa amantii walii wajjin qabnuun ilma koo dhugaa taʼeetti:",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "po",
          "vid": "TIT 1:4"
        },
        "items": [
          {
            "text": "Waaqa Abbaa fi Fayyisaa keenya Kiristoos Yesuus irraa ayyaannii fi nagaan siif haa taʼu.",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Jaarsolii Waan Gaarii Jaallatan Filachuu",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "TIT 1:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "Sababiin ani Qareexitti si hambiseef akka ati waan utuu hin xumuramin hafe toora qabsiiftuu fi akkuma ani si ajajettis magaalaawwan hunda keessatti jaarsolii muudduuf ture.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.5",
              "verseOrgIds": [
                "TIT.1.5"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "TIT 1:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Jaarsi tokko kan mudaa hin qabne, dhirsa niitii tokkittii, kan ijoolleen isaa amananii jireenya gad dhiisiitii fi ajajamuu diduun maqaan isaanii hin badin taʼuu qaba.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.6",
              "verseOrgIds": [
                "TIT.1.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "TIT 1:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Phaaphaasiin tokko sababii hojiin Waaqaa imaanaa isatti kennameef inni nama mudaa hin qabne taʼuu qaba malee kan of tuulu, kan dafee aaru, kan machaaʼu, kan lola jaallatuu fi kan karaa hin malleen buʼaa argachuuf tattaaffatu taʼuu hin qabu.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.7",
              "verseOrgIds": [
                "TIT.1.7"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "TIT 1:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "Qooda kanaa inni nama keessumaa simatu, nama waan gaarii jaallatu, kan of qabu, qajeelaa, qulqulluu fi nama naamusa qabu taʼuu qaba.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.8",
              "verseOrgIds": [
                "TIT.1.8"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "TIT 1:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Inni akka barsiisa dhugaatiin warra kaan gorsuu, warra barsiisa sanaan morman immoo akka dogoggora isaanii itti himee amansiisuu dandaʼuuf akkuma barsiifametti dubbii amanamaa sana jabeessee qabachuu qaba.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.9",
              "verseOrgIds": [
                "TIT.1.9"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Warra Waan Gaarii Hin hojjenne Ifachuu",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "TIT 1:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "Finciltoonni baayʼeen, warri dubbii faayidaa hin qabne dubbatanii fi gowwoomsitoonni keessumattuu miseensonni garee warra dhagna qabatanii hedduutu jiraatii.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.10",
              "verseOrgIds": [
                "TIT.1.10"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "TIT 1:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Isaan buʼaa hin malle argachuuf jedhanii waan barsiisuun isaan irra hin jirre barsiisuudhaan waan maatii guutuu diiganiif afaan qabachiifamuu qabu.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.11",
              "verseOrgIds": [
                "TIT.1.11"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "TIT 1:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "Raajota isaanii keessaa tokko, \"Warri Qareexi yeroo hunda sobdoota; bineensota hamoo dha; albaadheyyii dhibaaʼoo dha\" jedheera.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.12",
              "verseOrgIds": [
                "TIT.1.12"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "13",
              "style": "v",
              "sid": "TIT 1:13"
            },
            "items": [
              {
                "text": "13",
                "type": "text"
              }
            ]
          },
          {
            "text": "Dhuga baʼumsi kun dhugaa dha. Kanaafuu akka isaan amantii dhugaa qabaataniif jabeessii isaan ifadhu.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.13",
              "verseOrgIds": [
                "TIT.1.13"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "14",
              "style": "v",
              "sid": "TIT 1:14"
            },
            "items": [
              {
                "text": "14",
                "type": "text"
              }
            ]
          },
          {
            "text": "Akka isaan mammaaksa Yihuudootaa kan hundee hin qabne yookaan ajaja warra dhugaadhaan mormanii duukaa hin buuneefis jabeessii isaan ifadhu.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.14",
              "verseOrgIds": [
                "TIT.1.14"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "15",
              "style": "v",
              "sid": "TIT 1:15"
            },
            "items": [
              {
                "text": "15",
                "type": "text"
              }
            ]
          },
          {
            "text": "Warra qulqullaaʼoof wanni hundinuu qulqulluu dha; warra xuraaʼoo fi warra hin amanneef garuu wanni tokko iyyuu qulqulluu miti. Dhugumaanuu yaadni isaaniitii fi qalbiin isaanii xuraaʼeera.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.15",
              "verseOrgIds": [
                "TIT.1.15"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "16",
              "style": "v",
              "sid": "TIT 1:16"
            },
            "items": [
              {
                "text": "16",
                "type": "text"
              }
            ]
          },
          {
            "text": "Isaan nu Waaqa beekna jedhu; hojii isaaniitiin garuu isa ganu. Isaan jibbamoo dha; warra hin ajajamnee fi warra waan gaarii tokko iyyuu hojjechuuf gaʼumsa hin qabnee dha.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.1.16",
              "verseOrgIds": [
                "TIT.1.16"
              ]
            }
          }
        ]
      }
    ],
    "next": {
      "id": "TIT.2",
      "number": "2",
      "bookId": "TIT"
    },
    "previous": {
      "id": "TIT.intro",
      "number": "intro",
      "bookId": "TIT"
    }
  },
  "TIT.2": {
    "id": "TIT.2",
    "number": "2",
    "bookId": "TIT",
    "reference": "Tiitoo 2",
    "copyright": "Biblica® Hiikkaa Ammayyaa Banamaa Haaraa™, Loqoda Dhiʼaa Mirgi seeraan eegama © 2022 Biblica, Inc. Biblica® Open New Oromo Contemporary Version™, Western Copyright © 2022 by Biblica, Inc. \"Biblica\" jechuun mallattoo eenyummaa kan Biblica, Inc., Waajjira Eeyyamaa fi Mallattoo Eenyummaa kan Ameerikaa keessaatti galmeessee dha. Eeyyamaan itti fayyadamu. \"Biblica\" is trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
    "verseCount": 15,
    "content": [
      {
        "name": "chapter",
        "type": "tag",
        "attrs": {
          "number": "2",
          "style": "c",
          "sid": "TIT 2"
        },
        "items": [
          {
            "text": "2",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "s1"
        },
        "items": [
          {
            "text": "Wangeelaaf Jecha Waan Gaarii Hojjechuu",
            "type": "text"
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "1",
              "style": "v",
              "sid": "TIT 2:1"
            },
            "items": [
              {
                "text": "1",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ati garuu waan barsiisa dhugaa wajjin deemu barsiisi.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.1",
              "verseOrgIds": [
                "TIT.2.1"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "2",
              "style": "v",
              "sid": "TIT 2:2"
            },
            "items": [
              {
                "text": "2",
                "type": "text"
              }
            ]
          },
          {
            "text": "Jaarsoliin akka amala qabeeyyii, kabajamoo fi warra of qaban taʼaniif, akkasumas akka warra amantii dhugaa, jaalalaa fi obsa qabaatan barsiisi.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.2",
              "verseOrgIds": [
                "TIT.2.2"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "3",
              "style": "v",
              "sid": "TIT 2:3"
            },
            "items": [
              {
                "text": "3",
                "type": "text"
              }
            ]
          },
          {
            "text": "Akkasuma immoo jaartoliin akka jireenya isaaniitiin kabajamoo taʼan, akka waan gaariis barsiisan malee akka maqaa nama hin balleessine yookaan akka dhugaatii daadhii wayinii baayʼeetiin hin fudhatamne isaan barsiisi.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.3",
              "verseOrgIds": [
                "TIT.2.3"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "4",
              "style": "v",
              "sid": "TIT 2:4"
            },
            "items": [
              {
                "text": "4",
                "type": "text"
              }
            ]
          },
          {
            "text": "Yoos isaan akka dubartoonni shamarran dhirsoota isaanii fi ijoollee isaanii jaallatan barsiisuu ni dandaʼu;",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.4",
              "verseOrgIds": [
                "TIT.2.4"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "5",
              "style": "v",
              "sid": "TIT 2:5"
            },
            "items": [
              {
                "text": "5",
                "type": "text"
              }
            ]
          },
          {
            "text": "akka dubbiin Waaqaa hin tuffatamneefis akka of qaban, akka qulqullaaʼan, akka hojii mana keessaatiin qabaman, akka arjoota taʼan, akka dhirsoota isaaniitiif ajajaman ni barsiisu.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.5",
              "verseOrgIds": [
                "TIT.2.5"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "6",
              "style": "v",
              "sid": "TIT 2:6"
            },
            "items": [
              {
                "text": "6",
                "type": "text"
              }
            ]
          },
          {
            "text": "Akkasumas dargaggoonni akka of qabaniif gorsi.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.6",
              "verseOrgIds": [
                "TIT.2.6"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "7",
              "style": "v",
              "sid": "TIT 2:7"
            },
            "items": [
              {
                "text": "7",
                "type": "text"
              }
            ]
          },
          {
            "text": "Waan hunda keessatti waan gaarii hojjechuun fakkeenya isaaniif taʼi. Barsiisa kee keessatti amanamaa, kabajamaa fi nama akka salphaatti hin ilaalamne taʼi;",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.7",
              "verseOrgIds": [
                "TIT.2.7"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "8",
              "style": "v",
              "sid": "TIT 2:8"
            },
            "items": [
              {
                "text": "8",
                "type": "text"
              }
            ]
          },
          {
            "text": "akka warri siin morman waaʼee keenya waan hamaa dubbatan tokko illee dhabanii qaanaʼaniifis dubbii dhugaa kan tuffatamuu hin dandeenye dubbadhu.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.8",
              "verseOrgIds": [
                "TIT.2.8"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "9",
              "style": "v",
              "sid": "TIT 2:9"
            },
            "items": [
              {
                "text": "9",
                "type": "text"
              }
            ]
          },
          {
            "text": "Garboonni waan hundaan akka gooftota isaaniitiif ajajaman, akka gooftota isaanii gammachiisuu yaalan, akka waan gooftonni isaanii dubbataniif deebii mormii hin deebifne barsiisi;",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.9",
              "verseOrgIds": [
                "TIT.2.9"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "10",
              "style": "v",
              "sid": "TIT 2:10"
            },
            "items": [
              {
                "text": "10",
                "type": "text"
              }
            ]
          },
          {
            "text": "akka isaan gooftota isaanii jalaa hin hanne, garuu akka barsiisni Fayyisaa keenya Waaqaa karaa hundumaan hawwataa taʼu gochuuf akka isaan amanamummaa guutuu argisiisan barsiisi.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.10",
              "verseOrgIds": [
                "TIT.2.10"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "11",
              "style": "v",
              "sid": "TIT 2:11"
            },
            "items": [
              {
                "text": "11",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ayyaanni Waaqaa kan fayyina fidu nama hundatti mulʼifameeraatii.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.11",
              "verseOrgIds": [
                "TIT.2.11"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "12",
              "style": "v",
              "sid": "TIT 2:12"
            },
            "items": [
              {
                "text": "12",
                "type": "text"
              }
            ]
          },
          {
            "text": "Ayyaanni kunis Waaqa malee jiraachuu fi hawwii addunyaa ganuun bara kana keessa jireenya of qabiisaa, jireenya qajeelummaatii fi jireenya Waaqatti buluu akka jiraannu nu barsiisa;",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.12",
              "verseOrgIds": [
                "TIT.2.12"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "13",
              "style": "v",
              "sid": "TIT 2:13"
            },
            "items": [
              {
                "text": "13",
                "type": "text"
              }
            ]
          },
          {
            "text": "kunis yommuu nu abdii keenya isa eebbifamaa jechuunis mulʼachuu ulfina Waaqa keenya guddichaatii fi Fayyisaa keenya Yesuus Kiristoos eeggachaa jirrutti taʼa;",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.13",
              "verseOrgIds": [
                "TIT.2.13"
              ]
            }
          },
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "14",
              "style": "v",
              "sid": "TIT 2:14"
            },
            "items": [
              {
                "text": "14",
                "type": "text"
              }
            ]
          },
          {
            "text": "innis hammina hunda irraa nu furuu fi saba ofii isaa warra waan gaarii hojjechuuf hinaafan ofiif qulqulleeffachuuf jedhee of dabarsee nuuf kenneera.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.14",
              "verseOrgIds": [
                "TIT.2.14"
              ]
            }
          }
        ]
      },
      {
        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "p"
        },
        "items": [
          {
            "name": "verse",
            "type": "tag",
            "attrs": {
              "number": "15",
              "style": "v",
              "sid": "TIT 2:15"
            },
            "items": [
              {
                "text": "15",
                "type": "text"
              }
            ]
          },
          {
            "text": "Egaa wantoonni ati barsiisuu qabdu kanneenii dha. Taayitaa guutuun jajjabeessi; ifadhus. Namni tokko iyyuu si hin tuffatin.",
            "type": "text",
            "attrs": {
              "verseId": "TIT.2.15",
              "verseOrgIds": [
                "TIT.2.15"
              ]
            }
          }
        ]
      }
    ],
