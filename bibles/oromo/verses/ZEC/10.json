      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:6"
      },
      "items": [
        {
          "text": "deebisee isaan nan dhaaba.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        }
      ]
