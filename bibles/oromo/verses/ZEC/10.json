      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:1"
      },
      "items": [
        {
          "text": "biqiltuu dirree immoo tokkoo tokkoo namaatiif ni kenna.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.1",
            "verseOrgIds": [
              "ZEC.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
