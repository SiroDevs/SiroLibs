  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "ZEC 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Diinonni Yerusaalem ni barbadeeffamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kun raajii dubbii",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.1",
            "verseOrgIds": [
              "ZEC.12.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.12.1",
                "verseOrgIds": [
                  "ZEC.12.1"
                ]
              }
            }
          ]
        },
        {
          "text": "waaʼee Israaʼel dubbatuu dha.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.1",
            "verseOrgIds": [
              "ZEC.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ZEC 12:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 12:1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.12.1",
                "verseOrgIds": [
                  "ZEC.12.1"
                ]
              }
            }
          ]
        },
        {
          "text": "samiiwwan diriirse, inni hundee lafaa buuse, inni nama keessatti hafuura namaa uume sun akkana jedha:",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.1",
            "verseOrgIds": [
              "ZEC.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ani Yerusaalemin namoota naannoo ishee jiraatan hundatti xoofoo gatantarsu nan godha. Yihuudaan akkuma Yerusaalem marfamtee ni qabamti.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.2",
            "verseOrgIds": [
              "ZEC.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafas, yeroo saboonni lafaa hundi isheen mormuudhaan walitti qabamanitti, ani Yerusaalemin saboota hundatti kattaa hin sochoofamne nan godha. Warri ishee sochoosuu yaalan hundi of miidhu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.3",
            "verseOrgIds": [
              "ZEC.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafas ani fardeen hunda nan naasisa; isa yaabbatus nan maraacha\" jedha",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.4",
            "verseOrgIds": [
              "ZEC.12.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.12.4",
                "verseOrgIds": [
                  "ZEC.12.4"
                ]
              }
            }
          ]
        },
        {
          "text": ". \"Ani Yihuudaa eeguuf ija koo nan banadha; ija fardeen saboota hundaa garuu nan jaamsa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.4",
            "verseOrgIds": [
              "ZEC.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii hangafoonni Yihuudaa garaa isaaniitti, 'Jiraatonni Yerusaalem sababii",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.5",
            "verseOrgIds": [
              "ZEC.12.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.12.5",
                "verseOrgIds": [
                  "ZEC.12.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼu Waaqa isaanii taʼeef jajjaboo dha' jedhu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.5",
            "verseOrgIds": [
              "ZEC.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ani gaafas hangafoota Yihuudaa badaa ibiddaa tuullaa qoraanii keessaa, akkuma guca ibiddaa bissii keessaa nan godha. Isaan saboota naannoo isaanii kanneen mirgaa fi bitaan jiran hunda ni barbadeessu; Yerusaalem garuu utuu hin miidhamin iddoodhuma isheetti hafti.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.6",
            "verseOrgIds": [
              "ZEC.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.7",
            "verseOrgIds": [
              "ZEC.12.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.12.7",
                "verseOrgIds": [
                  "ZEC.12.7"
                ]
              }
            }
          ]
        },
        {
          "text": "akka ulfinni mana Daawitii fi jiraattota Yerusaalem ulfina Yihuudaa hin caalleef duraan dursee iddoo jireenya Yihuudaa ni baraara.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.7",
            "verseOrgIds": [
              "ZEC.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafas",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.8",
            "verseOrgIds": [
              "ZEC.12.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.12.8",
                "verseOrgIds": [
                  "ZEC.12.8"
                ]
              }
            }
          ]
        },
        {
          "text": "jiraattota Yerusaalemiif ni qolata; guyyaa sana isaan keessaa inni dadhabaan akka Daawit taʼa; manni Daawitis akka Waaqaa, akka ergamaa",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.8",
            "verseOrgIds": [
              "ZEC.12.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.12.8",
                "verseOrgIds": [
                  "ZEC.12.8"
                ]
              }
            }
          ]
        },
        {
          "text": "isa isaan dura deemuu ni taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.8",
            "verseOrgIds": [
              "ZEC.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani gaafas saboota Yerusaalem lolan hunda balleessuuf nan baʼa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.9",
            "verseOrgIds": [
              "ZEC.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Isa Waraanan Sanaaf Booʼuu Isaanii",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ani mana Daawitii fi jiraattota Yerusaalem irratti hafuura surraatii fi kadhannaa nan dhangalaasa. Isaan ana isa waraanan sana ni ilaalu; isaan akkuma nama ilma tokkichaaf booʼuutti ni booʼuuf; akkuma nama ilma hangafaaf baayʼisee gadduuttis ni gadduuf.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.10",
            "verseOrgIds": [
              "ZEC.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafas booʼichi Yerusaalem keessaa akkuma booʼicha dirree Megidoonitti Hadaad Rimooniif booʼame sanaa guddaa taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.11",
            "verseOrgIds": [
              "ZEC.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biyyattiin ni boossi; tokkoon tokkoon balbalaas niitota isaanii wajjin ofii isaaniitiif ni booʼu; balballi mana Daawitii fi niitonni isaanii, balballi mana Naataaniitii fi niitonni isaanii,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.12",
            "verseOrgIds": [
              "ZEC.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "balballi mana Lewwii fi niitonni isaanii, balballi Shimeʼiitii fi niitonni isaanii,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.13",
            "verseOrgIds": [
              "ZEC.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "balbalawwan hafan hundii fi niitonni isaanii ni booʼu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.14",
            "verseOrgIds": [
              "ZEC.12.14"
            ]
          }
        }
      ]
    }
  ],
