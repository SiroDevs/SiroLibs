    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawit ammas namoota Israaʼel keessaa filataman kuma soddoma walitti qabate.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.1",
            "verseOrgIds": [
              "2SA.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innii fi namoonni isa wajjin turan hundi taabota Waaqaa kan Maqaa, maqaa",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.2",
            "verseOrgIds": [
              "2SA.6.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.2",
                "verseOrgIds": [
                  "2SA.6.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼuu kan taabota gubbaa, kiirubeelii teessoo irra jiran gidduu jiru sanaatiin waamamu sana achii fiduuf gara Baʼaalaa ishee Yihuudaa keessaa sanaa ni dhaqan.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.2",
            "verseOrgIds": [
              "2SA.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis taabota Waaqaa gaarii haaraa irra kaaʼanii mana Abiinaadaab kan gaara irra jiru sanaa baasanii fidan. Ilmaan Abiinaadaabii, Uzaa fi Ahiiyoon gaarii haaraa sana oofaa turan;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.3",
            "verseOrgIds": [
              "2SA.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "taabonni Waaqaas gaarii irra kaaʼamee Ahiiyoon dura dura deema ture.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.4",
            "verseOrgIds": [
              "2SA.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawitii fi Israaʼel hundinuu humna isaanii guutuudhaan faarfannaadhaan, masiinqoodhaan, baganaadhaan, dibbeedhaan, bilbilaan, Kililleedhaanis fuula",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.5",
            "verseOrgIds": [
              "2SA.6.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.5",
                "verseOrgIds": [
                  "2SA.6.5"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti gammadanii shuubbisaa turan.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.5",
            "verseOrgIds": [
              "2SA.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu isaan oobdii Naakoon bira gaʼanitti waan sangoonni gufataniif Uzaan harka isaa hiixatee taabota Waaqaa qabe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.6",
            "verseOrgIds": [
              "2SA.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii hojii isaa kan ulfina hin qabneetiif dheekkamsi",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.7",
            "verseOrgIds": [
              "2SA.6.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.7",
                "verseOrgIds": [
                  "2SA.6.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Uzaatti bobaʼe; kanaafuu Waaqni isa rukute; innis achumatti taabota Waaqaa biratti duʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.7",
            "verseOrgIds": [
              "2SA.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawitis sababii",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.8",
            "verseOrgIds": [
              "2SA.6.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.8",
                "verseOrgIds": [
                  "2SA.6.8"
                ]
              }
            }
          ]
        },
        {
          "text": "akka malee Uzaatti dheekkameef ni aare; iddoon sun hamma harʼaatti Phereez Uzaa jedhamee waamama.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.8",
            "verseOrgIds": [
              "2SA.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawitis gaafa sana",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.9",
            "verseOrgIds": [
              "2SA.6.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.9",
                "verseOrgIds": [
                  "2SA.6.9"
                ]
              }
            }
          ]
        },
        {
          "text": "sodaatee, \"Taabonni",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.9",
            "verseOrgIds": [
              "2SA.6.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.9",
                "verseOrgIds": [
                  "2SA.6.9"
                ]
              }
            }
          ]
        },
        {
          "text": "akkamitti gara koo dhufa?\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.9",
            "verseOrgIds": [
              "2SA.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akka taabonni",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.10",
            "verseOrgIds": [
              "2SA.6.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.10",
                "verseOrgIds": [
                  "2SA.6.10"
                ]
              }
            }
          ]
        },
        {
          "text": "isa wajjin Magaalaa Daawit keessa jiraatuuf ofitti fudhachuu hin barbaanne. Qooda kanaa gara mana Oobeed Edoom namicha Gitii sanaatti geesse.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.10",
            "verseOrgIds": [
              "2SA.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taabonni",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.11",
            "verseOrgIds": [
              "2SA.6.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoos",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.11",
                "verseOrgIds": [
                  "2SA.6.11"
                ]
              }
            }
          ]
        },
        {
          "text": "jiʼa sadii mana namicha Gitii kan Oobeed Edoom jedhamu sanaa ture;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.11",
            "verseOrgIds": [
              "2SA.6.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.11",
                "verseOrgIds": [
                  "2SA.6.11"
                ]
              }
            }
          ]
        },
        {
          "text": "isaa fi warra mana isaa jiraatan hunda ni eebbise.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.11",
            "verseOrgIds": [
              "2SA.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo kanatti, \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.12",
            "verseOrgIds": [
              "2SA.6.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.12",
                "verseOrgIds": [
                  "2SA.6.12"
                ]
              }
            }
          ]
        },
        {
          "text": "sababii taabota Waaqaatiif jedhee warra mana Oobeed Edoom jiraatanii fi waan inni qabu hunda ni eebbise\" jedhanii Daawit Mootichatti himan. Kanaafuu Daawit gad buʼee taabota Waaqaa sana mana Abiidaaraatii gammachuudhaan gara Magaalaa Daawititti fide.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.12",
            "verseOrgIds": [
              "2SA.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akkuma namoonni taabota",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.13",
            "verseOrgIds": [
              "2SA.6.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.13",
                "verseOrgIds": [
                  "2SA.6.13"
                ]
              }
            }
          ]
        },
        {
          "text": "baatan sun tarkaanfii jaʼa achi hiiqaniin sangaa tokkoo fi jabbii coomaa tokko aarsaa dhiʼeesse.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.13",
            "verseOrgIds": [
              "2SA.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawitis Dirata quncee talbaa irraa hojjetame uffatee qondaaltota isaa wajjin fuula",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.14",
            "verseOrgIds": [
              "2SA.6.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.14",
                "verseOrgIds": [
                  "2SA.6.14"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti humna isaa guutuun shuubbisa ture;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.14",
            "verseOrgIds": [
              "2SA.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "innii fi Israaʼel hundi \"hoo\" jechaa sagalee malakataatiin taabota",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.15",
            "verseOrgIds": [
              "2SA.6.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.15",
                "verseOrgIds": [
                  "2SA.6.15"
                ]
              }
            }
          ]
        },
        {
          "text": "fidan.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.15",
            "verseOrgIds": [
              "2SA.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo taabonni",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.16",
            "verseOrgIds": [
              "2SA.6.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.16",
                "verseOrgIds": [
                  "2SA.6.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Magaalaa Daawit seenutti Miikaal intalli Saaʼol foddaa keessaan ilaalaa turte. Isheenis akka Daawit Mootichi fuula",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.16",
            "verseOrgIds": [
              "2SA.6.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.16",
                "verseOrgIds": [
                  "2SA.6.16"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti utaalee shuubbisu yommuu argitetti garaa ishee keessatti isa tuffatte.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.16",
            "verseOrgIds": [
              "2SA.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
