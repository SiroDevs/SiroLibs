          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis taabota",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.17",
            "verseOrgIds": [
              "2SA.6.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.17",
                "verseOrgIds": [
                  "2SA.6.17"
                ]
              }
            }
          ]
        },
        {
          "text": "fidanii dunkaana Daawit dhaabeef keessa ni kaaʼan; Daawitis aarsaa gubamuu fi aarsaa nagaa fuula",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.17",
            "verseOrgIds": [
              "2SA.6.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.17",
                "verseOrgIds": [
                  "2SA.6.17"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti dhiʼeesse.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.17",
            "verseOrgIds": [
              "2SA.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis erga aarsaa gubamuu fi aarsaa nagaa dhiʼeessee booddee maqaa",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.18",
            "verseOrgIds": [
              "2SA.6.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.18",
                "verseOrgIds": [
                  "2SA.6.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼuutiin namoota ni eebbise.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.18",
            "verseOrgIds": [
              "2SA.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis inni tokkoo tokkoo nama tuuta Israaʼelootaa guutuu keessa jiruutiif jechuunis dhiirotaafis dubartootaafis buddeena tokko tokko, gumaa foonii tokko tokkoo fi bixxillee ija wayinii tokko tokko ni kenne. Namoonni hundinuus gara mana mana isaanii deeman.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.19",
            "verseOrgIds": [
              "2SA.6.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu Daawit maatii ofii isaa eebbisuuf deebiʼettis Miikaal intalli Saaʼol isa simachuuf baatee, \"Harʼa mootiin Israaʼel akka nama gatii hin qabne tokkootti fuula xomboreewwan hojjettoota isaa duratti qullaa argamuun isaa ulfina taʼeeti moo!\" jette.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.20",
            "verseOrgIds": [
              "2SA.6.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawit immoo Miikaaliin akkana jedhe; \"Ani fuula",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.21",
            "verseOrgIds": [
              "2SA.6.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.21",
                "verseOrgIds": [
                  "2SA.6.21"
                ]
              }
            }
          ]
        },
        {
          "text": "isa abbaa keetii fi warra mana isaa jiran caalchisee na filatee saba",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.21",
            "verseOrgIds": [
              "2SA.6.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.21",
                "verseOrgIds": [
                  "2SA.6.21"
                ]
              }
            }
          ]
        },
        {
          "text": ", Israaʼel irratti na muude sanaaf fuula",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.21",
            "verseOrgIds": [
              "2SA.6.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.6.21",
                "verseOrgIds": [
                  "2SA.6.21"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti nan shuubbisa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.21",
            "verseOrgIds": [
              "2SA.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kana caalaa iyyuu ofin xinneessa; ija kee durattis of nan salphisa. Xomboreewwan ati jette kanneeniin garuu nan kabajama.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.22",
            "verseOrgIds": [
              "2SA.6.22"
            ]
          }
        }
      ]
