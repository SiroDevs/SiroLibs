      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2SA 23:24"
      },
      "items": [
        {
          "text": "Elhaanaan ilma Doodoo namicha Beetlihem,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.24",
            "verseOrgIds": [
              "2SA.23.24"
            ]
          }
        }
      ]
    },
