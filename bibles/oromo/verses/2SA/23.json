    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dubbii Daawit Kan Dhumaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubbiin Daawit dhuma irratti dubbate kanaa dha:",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.1",
            "verseOrgIds": [
              "2SA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 23:1"
      },
      "items": [
        {
          "text": "\"Himanni Daawit ilmi Isseey,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.1",
            "verseOrgIds": [
              "2SA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:1"
      },
      "items": [
        {
          "text": "himanni nama Waaqni Waan Hundaa Olii, ol ol isa qabe,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.1",
            "verseOrgIds": [
              "2SA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 23:1"
      },
      "items": [
        {
          "text": "nama Waaqni Yaaqoob isa dibe",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.1",
            "verseOrgIds": [
              "2SA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:1"
      },
      "items": [
        {
          "text": "faarfataan Israaʼel jaallatamaan sun akkana jedhe:",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.1",
            "verseOrgIds": [
              "2SA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hafuurri",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.2",
            "verseOrgIds": [
              "2SA.23.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.23.2",
                "verseOrgIds": [
                  "2SA.23.2"
                ]
              }
            }
          ]
        },
        {
          "text": "karaa kootiin dubbateera;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.2",
            "verseOrgIds": [
              "2SA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:2"
      },
      "items": [
        {
          "text": "dubbiin isaas arraba koo irra ture.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.2",
            "verseOrgIds": [
              "2SA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni Israaʼel dubbateera;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.3",
            "verseOrgIds": [
              "2SA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:3"
      },
      "items": [
        {
          "text": "Kattaan Israaʼel akkana naan jedhe:",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.3",
            "verseOrgIds": [
              "2SA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 23:3"
      },
      "items": [
        {
          "text": "'Namni qajeelummaan saba bulchu,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.3",
            "verseOrgIds": [
              "2SA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:3"
      },
      "items": [
        {
          "text": "kan sodaa Waaqaatiin bulchu,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.3",
            "verseOrgIds": [
              "2SA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "inni akka ifa biiftuu ganamaa",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.4",
            "verseOrgIds": [
              "2SA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:4"
      },
      "items": [
        {
          "text": "kan iddoo duumessi hin jirretti baʼuu,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.4",
            "verseOrgIds": [
              "2SA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 23:4"
      },
      "items": [
        {
          "text": "akkuma ifa aduu kan erga bokkaan caamee booddee",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.4",
            "verseOrgIds": [
              "2SA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:4"
      },
      "items": [
        {
          "text": "marga biqilchuu ti.'",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.4",
            "verseOrgIds": [
              "2SA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Manni koo Waaqa duratti qajeelaa mitii?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.5",
            "verseOrgIds": [
              "2SA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:5"
      },
      "items": [
        {
          "text": "Inni kakuu bara baraa na wajjin seenee",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.5",
            "verseOrgIds": [
              "2SA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:5"
      },
      "items": [
        {
          "text": "isas qajeelchee karaa hundaan ni eega mitii?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.5",
            "verseOrgIds": [
              "2SA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 23:5"
      },
      "items": [
        {
          "text": "Isatu fayyina koo fiixaan baasee",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.5",
            "verseOrgIds": [
              "2SA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:5"
      },
      "items": [
        {
          "text": "fedhii koo hundas naaf guuta mitii?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.5",
            "verseOrgIds": [
              "2SA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni hamoon hundinuu garuu",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.6",
            "verseOrgIds": [
              "2SA.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:6"
      },
      "items": [
        {
          "text": "akkuma qoraattii harkaan walitti hin qabamneetti gatamu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.6",
            "verseOrgIds": [
              "2SA.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni qoraattii tuqu kam iyyuu miʼa sibiilaa",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.7",
            "verseOrgIds": [
              "2SA.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:7"
      },
      "items": [
        {
          "text": "yookaan somaa eeboo qabata;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.7",
            "verseOrgIds": [
              "2SA.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:7"
      },
      "items": [
        {
          "text": "qoraattiin sunis lafuma jirutti gubama.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.7",
            "verseOrgIds": [
              "2SA.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Namoota Daawit Jajjaboo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2SA.23.8-2SA.23.39"
          },
          "items": [
            {
              "text": "23:8‑39",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwf –",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "xt"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "1CH.11.10-1CH.11.41"
