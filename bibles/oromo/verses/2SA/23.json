          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaayaa nama Phiraatoon",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.30",
            "verseOrgIds": [
              "2SA.23.30"
            ]
          }
