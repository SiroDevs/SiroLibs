          "text": "Azmaawet nama Barhuum,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.31",
            "verseOrgIds": [
              "2SA.23.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
