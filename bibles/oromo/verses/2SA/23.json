      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2SA 23:24"
      },
      "items": [
        {
          "text": "Asaaheel obboleessa Yooʼaab,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.24",
            "verseOrgIds": [
              "2SA.23.24"
            ]
          }
        }
      ]
