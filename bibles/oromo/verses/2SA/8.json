    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Daawit Filisxeemota moʼatee of jala isaan galfate; magaalaa Meeteeg Amaa jedhamtus harka Filisxeemotaatii baasee fudhate.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.1",
            "verseOrgIds": [
              "2SA.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawit Moʼaabotas ni moʼate. Lafa irra tarree ciibsees funyoon isaan safare. Kanneen tarree galan keessaas funyoo lama lama safaree ajjeese; kanneen funyoo tokko tokko safare immoo akka isaan jiraatan eeyyameef. Kanaafuu Moʼaabonni Daawit jalatti bulanii gibira fidaniif.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.2",
            "verseOrgIds": [
              "2SA.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irrattis Daawit yeroo Laga Efraaxiis bira yaadannoo ofii deebisee dhaabbachuu dhaqetti mooticha Zoobaa, Hadaadezer ilma Rehoob moʼate.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.3",
            "verseOrgIds": [
              "2SA.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawitis gaariiwwan waraanaa isaa kuma tokko, abbootii fardaa kuma torbaa fi loltoota lafoo kuma digdama isa irraa fudhate. Innis fardeen gaariiwwanii dhibba tokko qofa hambisee kanneen hafan hunda mogolee kukkute.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.4",
            "verseOrgIds": [
              "2SA.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo warri Sooriyaa kanneen Damaasqoo jiraatan Hadaadezer mooticha Zoobaa gargaaruuf dhufanittis Daawit isaan keessaa nama kuma digdamii lama fixe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.5",
            "verseOrgIds": [
              "2SA.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis kutaa bulchiinsa Damaasqoo kan biyya Sooriyaa keessa qubata loltootaa dhaabbate. Warri Sooriyaas isa jalatti bulanii gibira fidaniif.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.6",
            "verseOrgIds": [
              "2SA.8.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "2SA.8.6",
                "verseOrgIds": [
                  "2SA.8.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Daawitiif lafa inni dhaqe hundatti mooʼicha kenne.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.6",
            "verseOrgIds": [
              "2SA.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawitis gaachana warqee kan ajajjoonni loltoota Hadaadezer qabatan fudhatee gara Yerusaalem fide.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.7",
            "verseOrgIds": [
              "2SA.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawit Mootichi magaalaawwan Hadaadezer jechuunis Bexaatii fi Beerootaay keessaa sibiila naasii akka malee baayʼee fudhate.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.8",
            "verseOrgIds": [
              "2SA.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tooʼiin mootiin Hamaati yommuu akka Daawit guutummaa loltoota Hadaadezer moʼate dhagaʼetti,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.9",
            "verseOrgIds": [
              "2SA.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "akka inni sababii moʼannaa Daawit Mootichi Tooʼiin wal lolaa ture sun waraana keessatti Hadaadezer irratti argateetiif harka isa fuudhee dhaamsa gammachuu isaaf dabarsuuf ilma ofii isaa Yooraamin gara isaatti erge. Yooraamis kennaawwan meetii irraa, warqee fi naasii irraa hojjetaman fide.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.10",
            "verseOrgIds": [
              "2SA.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawit Mootichis akkuma meetii fi warqee saboota biraa kanneen of jala galfatu hunda irraa boojiʼee ture godhe sana miʼoota kanneen illee",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.11",
            "verseOrgIds": [
              "2SA.8.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "2SA.8.11",
                "verseOrgIds": [
                  "2SA.8.11"
                ]
              }
            }
          ]
        },
        {
          "text": "addaan baase.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.11",
            "verseOrgIds": [
              "2SA.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri inni of jala galfates Edoom, Moʼaab, Amoonota, Filisxeemotaa fi Amaaleq turan. Boojuu Hadaadezer ilma Rehoob mooticha Zoobaa irraa boojiʼes akkasuma addaan baase.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.12",
            "verseOrgIds": [
              "2SA.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawitis erga Sulula Soogiddaa keessatti Edoomota kuma kudha saddeet fixee deebiʼee booddee beekamaa taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.13",
            "verseOrgIds": [
              "2SA.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis guutummaa Edoom keessa qubata loltootaa dhaabbate; Edoomonni hundinuus Daawitiif ni garbooman.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.14",
            "verseOrgIds": [
              "2SA.8.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "2SA.8.14",
                "verseOrgIds": [
                  "2SA.8.14"
                ]
              }
            }
          ]
        },
        {
          "text": "lafa inni dhaqe hundatti Daawitiif moʼannaa ni kenne.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.14",
            "verseOrgIds": [
              "2SA.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Qondaaltota Daawit",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2SA.8.15-2SA.8.18"
          },
          "items": [
            {
              "text": "8:15‑18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwf –",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "xt"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "1CH.18.14-1CH.18.17"
              },
              "items": [
                {
                  "text": "1Sn 18:14‑17",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawit guutummaa Israaʼel irratti mootii taʼee saba isaa hundaaf murtii qajeelaa fi qajeelummaadhaan hojjete.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.15",
            "verseOrgIds": [
              "2SA.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yooʼaab ilmi Zeruuyaa hoogganaa loltootaa ture; Yehooshaafaax ilmi Ahiiluud immoo galmeessaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.16",
            "verseOrgIds": [
              "2SA.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasumas Zaadoq ilmi Ahiixuubii fi Abiimelek ilmi Abiyaataar luboota turan; Seraayaan immoo barreessaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.17",
            "verseOrgIds": [
              "2SA.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaayaa ilmi Yehooyaadaa hoogganaa Kereetotaa fi Pheletotaa ture; ilmaan Daawit immoo luboota turan.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.18",
            "verseOrgIds": [
              "2SA.8.18"
            ]
          }
        }
      ]
    }
  ],
