              "1JN.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Addunyaa Hin Jaallatinaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1JN 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Addunyaa yookaan waan addunyaa keessa jiru tokko illee hin jaallatinaa. Eenyu iyyuu yoo addunyaa jaallate, jaalalli Abbaa isa keessa hin jiru.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.15",
            "verseOrgIds": [
              "1JN.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1JN 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni addunyaa keessa jiru hundinuu jechuunis hawwiin foonii, hawwiin ijaa, akkasumas waan qabaniin kooruun kan addunyaati malee kan Abbaa miti.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.16",
            "verseOrgIds": [
              "1JN.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1JN 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Addunyaa fi hawwiin ishee ni badu; namni fedhii Waaqaa raawwatu garuu bara baraan jiraata.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.17",
            "verseOrgIds": [
              "1JN.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ilma Ganuu Irraa Of Eeggachuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1JN 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa ijoolle, saʼaatiin kun saʼaatii dhumaa ti; akka farri Kiristoos sun dhufu akkuma dhageessan sana ammuma iyyuu farroonni Kiristoos baayʼeen dhufaniiru. Kanaanis nu akka saʼaatiin kun saʼaatii dhumaa taʼe beekna.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.18",
            "verseOrgIds": [
              "1JN.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1JN 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan nu keessaa baʼan malee dhugumaan kan keenya hin turre. Utuu kan keenya taʼanii silaa nu biratti hafu turan; nu biraa deemuun isaanii garuu akka tokkoon isaanii iyyuu keenya hin taʼin mulʼise.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.19",
            "verseOrgIds": [
              "1JN.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1JN 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin garuu Isa Qulqulluu sanaan dibamtaniirtu; isin hundis dhugaa ni beektu.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.20",
            "verseOrgIds": [
              "1JN.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1JN 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababiin ani isinii barreessuuf waan isin dhugaa beektanii fi akka sobni tokko iyyuu dhugaa keessa hin jirres beektaniif malee waan isin dhugaa hin beekneef miti.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.21",
            "verseOrgIds": [
              "1JN.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1JN 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama Yesuus kun Kiristoos miti jedhee ganu malee sobduun eenyu ree? Namni akkasii farra Kiristoos; inni Abbaa fi Ilma ni gana.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.22",
            "verseOrgIds": [
              "1JN.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1JN 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni Ilma ganu kam iyyuu Abbaa illee hin qabu; namni waaʼee Ilmaa dhugaa baʼu hundinuu Abbaas qaba.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.23",
            "verseOrgIds": [
              "1JN.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1JN 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni isin jalqabaa kaaftanii dhageessan sun isin keessa haa jiraatu. Yoo wanni jalqabaa kaaftanii dhageessan isin keessa jiraate, isinis Ilmaa fi Abbaadhaan ni jiraattu.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.24",
            "verseOrgIds": [
              "1JN.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1JN 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni inni waadaa nuu gale kanaa dha; kunis jireenya bara baraa ti.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.25",
            "verseOrgIds": [
              "1JN.2.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1JN 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani waaʼee warra karaa irraa isin jalʼisuu yaalan sanaatiif waan kana isiniifin barreessa.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.26",
            "verseOrgIds": [
              "1JN.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1JN 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu dibanni isin isa irraa argattan sun waan isin keessa jiraatuuf namni tokko iyyuu isin barsiisuu hin barbaachisu; dibanni isaa sun garuu waan waaʼee hundumaa isin barsiisuuf, dibanni sun waan dhugaa malee soba hin taʼiniif akkuma inni isin barsiise sanatti isumaan jiraadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.27",
            "verseOrgIds": [
              "1JN.2.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ijoollee Waaqaatii fi Cubbuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1JN 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammas yaa ijoolle, akka yommuu inni mulʼatutti ija jabina qabaannuuf, akka nu guyyaa dhufaatii isaattis fuula isaa duratti hin qaanofneef isaan jiraadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.28",
            "verseOrgIds": [
              "1JN.2.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1JN 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin yoo akka inni qajeelaa taʼe beektan, akka namni waan qajeelaa hojjetu hundinuu isa irraa dhalate ni beektu.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.29",
            "verseOrgIds": [
              "1JN.2.29"
            ]
          }
        }
      ]
    }
  ],
