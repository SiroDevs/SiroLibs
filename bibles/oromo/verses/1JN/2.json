    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1JN 2:14"
      },
      "items": [
        {
          "text": "Yaa dargaggoota, isin waan jajjaboo taataniif,",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.14",
            "verseOrgIds": [
              "1JN.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1JN 2:14"
      },
      "items": [
        {
          "text": "waan dubbiin Waaqaa isin keessa jiraatuuf,",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.14",
            "verseOrgIds": [
              "1JN.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1JN 2:14"
      },
      "items": [
        {
