  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "RUT 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ruut Lafa qotiisaa Boʼeez Keessatti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "RUT 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naaʼomiin balbala Eliimelek keessaa fira dhirsa ishee namicha sooressa Boʼeez jedhamu tokko qabdi turte.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.1",
            "verseOrgIds": [
              "RUT.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "RUT 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruut Moʼaabittiinis Naaʼomiiniin, \"Ani nama fuula isaa duratti fudhatama argadhu duubaan qarmii funaannachuuf gara lafa qotiisaatti achi nan baʼa\" jette.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.2",
            "verseOrgIds": [
              "RUT.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "RUT 2:2"
      },
      "items": [
        {
          "text": "Naaʼomiinis, \"Yaa intala koo dhaqi\" jetteen.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.2",
            "verseOrgIds": [
              "RUT.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "RUT 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu isheen gara lafa qotiisaa dhaqxee warra midhaan haaman duubaan qarmii funaannachuu jalqabde. Isheen utuma qarmii funaannachaa jirtuu akka lafti qotiisaa isheen keessa jirtu sun kan Boʼeez taʼe hubatte; Boʼeez kunis sanyii Eliimelek ture.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.3",
            "verseOrgIds": [
              "RUT.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "RUT 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeruma sanatti Boʼeez Beetlihemii dhufee warra midhaan haamaniin, \"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.4",
            "verseOrgIds": [
              "RUT.2.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "RUT.2.4",
                "verseOrgIds": [
                  "RUT.2.4"
                ]
              }
            }
          ]
        },
        {
          "text": "isin wajjin haa taʼu!\" jedhee nagaa isaan gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.4",
            "verseOrgIds": [
              "RUT.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "RUT 2:4"
      },
      "items": [
        {
          "text": "Isaanis deebisanii, \"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.4",
            "verseOrgIds": [
              "RUT.2.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "RUT.2.4",
                "verseOrgIds": [
                  "RUT.2.4"
                ]
              }
            }
          ]
        },
        {
          "text": "si haa eebbisu!\" jedhaniin.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.4",
            "verseOrgIds": [
              "RUT.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "RUT 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boʼeezis dura buʼaa hojjettoota isaatiin, \"Intalli kun kan eenyuu ti?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.5",
            "verseOrgIds": [
              "RUT.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "RUT 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dura buʼaan sunis akkana jedhee deebise; \"Isheen nama Moʼaab; Naaʼomiin wajjin biyya Moʼaabii dhufte.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.6",
            "verseOrgIds": [
              "RUT.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "RUT 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheenis, 'Maaloo akka ani hojjettoota duubaan bissii gidduudhaan qarmii funaannadhu naa eeyyami' jette. Isheen yeroo xinnoof gaaddisa jala boqotte malee ganamaa jalqabdee hamma ammaatti jabaattee hojjechaa turte.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.7",
            "verseOrgIds": [
              "RUT.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "RUT 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti Boʼeez Ruutiin akkana jedhe; \"Yaa intala koo na dhagaʼi. Gara lafa qotiisaa biraa dhaqxee qarmii hin funaanin; iddoo kanaas hin deemin. Asuma hojjettoota koo dubarran wajjin turi.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.8",
            "verseOrgIds": [
              "RUT.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "RUT 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lafa qotiisaa warri dhiiraa keessaa haaman ilaaliitii dubarran duukaa buʼi. Akka isaan siʼi hin tuqne ani warra dhiiraatti himeera. Yeroo dheebottus qodaa bishaanii dhiironni guutan keessaa budduuqsii dhugi.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.9",
            "verseOrgIds": [
              "RUT.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "RUT 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irrattis isheen addaan lafatti gombifamtee, \"Ani utuu nama biyya ormaa taʼee jiruu fuula kee duratti surraa argadhee ati na arguun kee kun maaliifi?\" jettee isa gaafatte.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.10",
            "verseOrgIds": [
              "RUT.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "RUT 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boʼeez immoo akkana jedhee deebiseef; \"Waan ati erga dhirsi kee duʼee jalqabee haadha dhirsa keetiitiif goote hundumaa, akka ati itti abbaa kee, haadha keetii fi biyya kee dhiiftee saba kanaan dura hin beekin wajjin jiraachuudhaaf dhuftes dhagaʼeera.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.11",
            "verseOrgIds": [
              "RUT.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "RUT 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "RUT.2.12",
                "verseOrgIds": [
                  "RUT.2.12"
                ]
              }
            }
          ]
        },
        {
          "text": "waan ati goote hundaaf gatii kee siif haa deebisu.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.12",
            "verseOrgIds": [
              "RUT.2.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "RUT.2.12",
                "verseOrgIds": [
                  "RUT.2.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni Israaʼel kan ati qoochoo isaa jalatti baqachuudhaaf dhufte sun baayʼisee siif haa deebisu.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.12",
            "verseOrgIds": [
              "RUT.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "RUT 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheenis akkana jette; \"Yaa gooftaa ko, ani yoo akka hojjettoota kee dubarran keessaa akka ishee tokkootti madaalamuu baadhe illee sababii ati na jajjabeessitee gara laafinaan ana garbittii keetti dubbatteef ani fuula kee duratti surraa argadheera.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.13",
            "verseOrgIds": [
              "RUT.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "RUT 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boʼeezis yeroo laaqanaatti, \"As kottu. Buddeenas fudhadhuutii wayinii dhangaggaaʼaatti cuuphadhu\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.14",
            "verseOrgIds": [
              "RUT.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "RUT 2:14"
      },
      "items": [
        {
          "text": "Yeroo isheen hojjettoota wajjin teessettis asheetii waadame kenneef. Isheenis nyaattee quuftee xinnoon irraa hafeef.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.14",
            "verseOrgIds": [
              "RUT.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "RUT 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma isheen qarmii funaannachuuf ol kaateenis Boʼeez akkana jedhee hojjettoota isaa ajaje; \"Yoo isheen bissii gidduudhaa illee qarmii funaannatte ishee hin rifachiisinaa.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.15",
            "verseOrgIds": [
              "RUT.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "RUT 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qooda kanaa bissii keessaa tokko tokko luqqisaatii akka isheen funaannatuuf lafa bubuusaafii malee isheetti hin dheekkaminaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.16",
            "verseOrgIds": [
              "RUT.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "RUT 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Ruut hamma galgalaatti lafa qotiisaa keessaa funaannatte. Garbuu funaannatte sanas ni sukkuumatte; innis gara safartuu iifii",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.17",
            "verseOrgIds": [
              "RUT.2.17"
            ]
          }
        },
        {
          "text": "tokkoo taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.17",
            "verseOrgIds": [
              "RUT.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "RUT 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheenis garbuu sana baadhattee magaalaatti deebite; haati dhirsa ishees wanni isheen funaannatte hammam akka taʼe argite. Akkasumas Ruut waan guyyaa nyaattee quuftee ishee irraa hafe sana gad baaftee kenniteef.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.18",
            "verseOrgIds": [
              "RUT.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "RUT 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haati dhirsa ishees, \"Ati harʼa eessaa funaannatte? Eessa hojjechaa oolte? Namni xiyyeeffannoo kana siif kenne sun haa eebbifamu!\" jette.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.19",
            "verseOrgIds": [
              "RUT.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "RUT 2:19"
      },
      "items": [
        {
          "text": "Ergasiis Ruut waaʼee namicha lafa qotiisaa isaa keessaa funaannachaa oolte sanaa haadha dhirsa isheetti himte. Isheenis, \"Maqaan namicha ani harʼa bira hojjechaa oole sanaa Boʼeez jedhama\" jette.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.19",
            "verseOrgIds": [
              "RUT.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "RUT 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naaʼomiinis, \"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.20",
            "verseOrgIds": [
              "RUT.2.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "RUT.2.20",
                "verseOrgIds": [
                  "RUT.2.20"
                ]
              }
            }
          ]
        },
        {
          "text": "inni warra jiraniifis warra duʼaniifis gara laafina gochuu hin dhiifne sun isa haa eebbisu!\" jette. Itti dabaluudhaanis, \"Inni fira keenya kan dhiʼoo ti; warra nu dhaaluun irra jiru keessaas isa tokkoo dha\" isheedhaan jette.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.20",
            "verseOrgIds": [
              "RUT.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "RUT 2:21"
          },
          "items": [
