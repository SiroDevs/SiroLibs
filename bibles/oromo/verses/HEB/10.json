  "verseCount": 39,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "HEB 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kiristoos Aarsaa Taʼuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seerri gaaddidduu waan gaarii dhufuuf jiruu qofa malee bifa dhugaa miti. Kanaafuu seerichi aarsaa utuu wal irraa hin citin wagguma waggaan dhiʼeeffamu sanaan gonkumaa namoota waaqeffachuuf dhiʼaatan sana warra mudaa hin qabne gochuu hin dandaʼu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.1",
            "verseOrgIds": [
              "HEB.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuu isaan waan kana gochuu dandaʼanii silaa aarsaan dhiʼeeffamuun isaa ni hafa ture mitii? Waaqeffattoonnis siʼa tokko yeroo hundaaf ni qulqulleeffamu turaniitii; ergasii sababii cubbuu isaaniitiif yakki isaanitti hin dhagaʼamu ture.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.2",
            "verseOrgIds": [
              "HEB.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aarsaawwan kunneen garuu wagguma waggaan cubbuu nama yaadachiisu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.3",
            "verseOrgIds": [
              "HEB.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababiin isaas dhiigni korommiitii fi dhiigni reʼootaa gonkumaa cubbuu dhabamsiisuu hin dandaʼuutii.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.4",
            "verseOrgIds": [
              "HEB.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Kiristoos yommuu gara addunyaa dhufetti akkana jedhe:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.5",
            "verseOrgIds": [
              "HEB.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 10:5"
      },
      "items": [
        {
          "text": "\"Ati aarsaa fi kennaa hin feene;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.5",
            "verseOrgIds": [
              "HEB.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:5"
      },
      "items": [
        {
          "text": "garuu dhagna naa qopheessite;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.5",
            "verseOrgIds": [
              "HEB.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati aarsaa gubamuu fi",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.6",
            "verseOrgIds": [
              "HEB.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:6"
      },
      "items": [
        {
          "text": "kennaa sababii cubbuutiif",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.6",
            "verseOrgIds": [
              "HEB.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:6"
      },
      "items": [
        {
          "text": "dhiʼeeffamutti hin gammanne.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.6",
            "verseOrgIds": [
              "HEB.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo sana ani, 'Ani kunoo ti;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.7",
            "verseOrgIds": [
              "HEB.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:7"
      },
      "items": [
        {
          "text": "waaʼeen koo kitaaba maramaa keessatti barreeffameera;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.7",
            "verseOrgIds": [
              "HEB.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:7"
      },
      "items": [
        {
          "text": "yaa Waaqa ko, ani fedhii kee raawwachuuf dhufeera' nan jedhe.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.7",
            "verseOrgIds": [
              "HEB.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan akka seeraatti dhiʼeeffaman iyyuu inni jalqabatti, \"Ati qalmawwanii fi aarsaawwan, aarsaawwan gubamanii fi aarsaawwan cubbuuf dhiʼeeffaman hin feene yookaan itti hin gammanne\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.8",
            "verseOrgIds": [
              "HEB.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis inni, \"Ani kunoo fedhii kee raawwachuuf dhufeera\" jedhe. Innis isa lammaffaa dhaabuuf jedhee isa jalqabaa dhabamsiise.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.9",
            "verseOrgIds": [
              "HEB.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fedhii sanaanis nu aarsaa dhagna Yesuus Kiristoos isa siʼa tokko yeroo hundaaf dhiʼeeffameen qulqulleeffamneerra.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.10",
            "verseOrgIds": [
              "HEB.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubni hundinuu guyyuma guyyaan dhaabatee tajaajila isaa raawwata; aarsaa gonkumaa cubbuu dhabamsiisuu hin dandeenye sanas yeroo hunda dhiʼeessa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.11",
            "verseOrgIds": [
              "HEB.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubni kun garuu erga aarsaa tokkicha bara baraan cubbuudhaaf dhiʼeessee booddee gara mirga Waaqaa taaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.12",
            "verseOrgIds": [
              "HEB.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo sanaa jalqabees hamma diinonni isaa ejjeta miilla isaa taasifamanitti ni eeggata;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.13",
            "verseOrgIds": [
              "HEB.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "inni aarsaa tokkicha sanaan warra qulqulleeffamuutti jiran kanneen bara baraan mudaa hin qabne godheeraatii.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.14",
            "verseOrgIds": [
              "HEB.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hafuurri Qulqulluunis waaʼee kanaa dhugaa nuu baʼa. Innis jalqabatti akkana jedha:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.15",
            "verseOrgIds": [
              "HEB.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kakuun ani yeroo sana booddee isaan wajjin galu kanaa dha,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.16",
            "verseOrgIds": [
              "HEB.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:16"
      },
      "items": [
        {
          "text": "jedha Gooftaan.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.16",
            "verseOrgIds": [
              "HEB.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 10:16"
      },
      "items": [
        {
          "text": "Ani seera koo qalbii isaanii keessa nan kaaʼa;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.16",
            "verseOrgIds": [
              "HEB.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:16"
      },
      "items": [
        {
          "text": "garaa isaanii keessattis nan barreessa.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.16",
            "verseOrgIds": [
              "HEB.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammas,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.17",
            "verseOrgIds": [
              "HEB.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 10:17"
      },
      "items": [
        {
          "text": "\"Ani cubbuu fi yakka isaanii",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.17",
            "verseOrgIds": [
              "HEB.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:17"
      },
      "items": [
        {
          "text": "siʼachi hin yaadadhu\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.17",
            "verseOrgIds": [
              "HEB.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "HEB 10:17"
      },
      "items": [
        {
          "text": "jedha.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.17",
            "verseOrgIds": [
              "HEB.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iddoo isaan kunneen itti dhiifama argatanitti siʼachi sababii cubbuutiif aarsaa dhiʼeessuu hin barbaachisu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.18",
            "verseOrgIds": [
              "HEB.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amantiidhaan Cimanii Dhaabachuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu yaa obboloota, nu dhiiga Yesuusiin gara Iddoo Iddoo Hunda Caalaa Qulqulluu taʼeetti galuuf ija jabina waan qabnuuf",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.19",
            "verseOrgIds": [
              "HEB.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "karaa haaraa fi jiraataa golgaa keessaan jechuunis karaa foon isaatiin nuu baname sanaan",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.20",
            "verseOrgIds": [
              "HEB.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "waan luba guddaa mana Waaqaa irratti qabnuuf,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.21",
            "verseOrgIds": [
              "HEB.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kottaa akka qalbiin keenya yaada yakka qabaachuu irraa qulqulleeffamuuf garaa keenyatti nuu facaafamee, dhagna keenyas bishaan qulqulluun dhiqannee garaa qulqulluu amantii mirkanaaʼaa guutuu qabuun Waaqatti dhiʼaannaa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.22",
            "verseOrgIds": [
              "HEB.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni waadaa gale sun waan amanamaa taʼeef kottaa nu utuu hin raafamin abdii dhugaa baanu sana jabeessinee qabannaa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.23",
            "verseOrgIds": [
              "HEB.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kottaa jaalalaa fi hojii gaariif wal kakaasuuf itti yaadnaa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.24",
            "verseOrgIds": [
              "HEB.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "HEB 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka namoonni tokko tokko walitti qabamuu dhiisan sana kottaa nu walitti qabamuu hin dhiifnuu; qooda kanaa akka guyyaan sun dhiʼaate waan argitaniif ittuma caalchifnee wal haa jajjabeessinu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.25",
            "verseOrgIds": [
              "HEB.10.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "HEB 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu erga beekumsa dhugaa argannee booddee yoo beekaa ittuma fufnee cubbuu hojjenne, siʼachi aarsaan cubbuuf dhiʼeeffamu hin jiraatu;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.26",
            "verseOrgIds": [
              "HEB.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "HEB 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "garuu murtii fi ibidda hamaa diinota Waaqaa barbadeessu sodaan eeggachuu qofatu jiraata.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.27",
            "verseOrgIds": [
              "HEB.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "HEB 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni seera Musee tuffate kam iyyuu dhuga baatota lamaan yookaan sadiin gara laafina malee ajjeefama.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.28",
            "verseOrgIds": [
              "HEB.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "HEB 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama Ilma Waaqaa irra ejjete, nama dhiiga kakuu kan ittiin qulqulleeffame sana akka waan qulqulluu hin taʼiniitti hedee fi nama Hafuura ayyaanaa arrabse tokko adabbii hammam caalaa guddaatu isaaf mala seetu?",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.29",
            "verseOrgIds": [
              "HEB.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "HEB 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu isa, \"Haaloo baasuun kan koo ti; ani gatii nan deebisa\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.30",
            "verseOrgIds": [
              "HEB.10.30"
            ]
          }
        },
        {
          "text": "jedhe sana beeknaatii; akkasumas, \"Gooftaan saba isaatti ni mura\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.30",
            "verseOrgIds": [
              "HEB.10.30"
            ]
          }
        },
        {
          "text": "jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.30",
            "verseOrgIds": [
              "HEB.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "HEB 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harka Waaqa jiraataatti kufuun sodaachisaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.31",
            "verseOrgIds": [
              "HEB.10.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "HEB 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara duraa yeroo erga ifni isinii ifee booddee walʼaansoo dhiphinaa guddaa obsitanii keessa dhaabattan sana yaadadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.32",
            "verseOrgIds": [
              "HEB.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "HEB 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin yeroo tokko tokko fuula namootaa duratti arrabsoo fi ariʼatamaaf saaxilamtanii turtan; yeroo kaan immoo namoota rakkinni akkasii irra gaʼe wajjin hirmaachaa turtan.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.33",
            "verseOrgIds": [
              "HEB.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "HEB 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin mataan keessan akka qabeenya wayyu kan hin dabarre qabdan waan beektaniif warra hidhaman wajjin dhiphattaniirtu; yommuu qabeenyi keessan saamamus gammachuudhaan fudhattaniirtu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.34",
            "verseOrgIds": [
              "HEB.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "HEB 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu ija jabina keessan isa gatii guddaa qabu sana hin gatinaa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.35",
            "verseOrgIds": [
              "HEB.10.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "HEB 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu fedhii Waaqaa raawwattanittis akka waan inni waadaa gale sana argattaniif obsuu isin barbaachisaatii.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.36",
            "verseOrgIds": [
              "HEB.10.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "HEB 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yeroo xinnoo keessatti,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.37",
            "verseOrgIds": [
              "HEB.10.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:37"
      },
      "items": [
        {
          "text": "inni dhufuuf jiru ni dhufa;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.37",
            "verseOrgIds": [
              "HEB.10.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:37"
      },
      "items": [
        {
          "text": "hin turus.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.37",
            "verseOrgIds": [
              "HEB.10.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "HEB 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasumas,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.38",
            "verseOrgIds": [
              "HEB.10.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 10:38"
      },
      "items": [
        {
          "text": "\"Qajeelaan koo garuu amantiidhaan jiraata.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.38",
            "verseOrgIds": [
              "HEB.10.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:38"
      },
      "items": [
        {
          "text": "Kan duubatti harkifatu immoo",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.38",
            "verseOrgIds": [
              "HEB.10.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:38"
      },
      "items": [
        {
          "text": "ani itti hin gammadu.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.38",
            "verseOrgIds": [
              "HEB.10.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "HEB 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu garuu warra amananii lubbuu ofii oolfatan malee warra gara badiisaatti harkifatan miti.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.39",
            "verseOrgIds": [
              "HEB.10.39"
            ]
          }
        }
      ]
    }
  ],
