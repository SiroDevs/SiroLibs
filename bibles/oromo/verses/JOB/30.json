  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "JOB 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Amma garuu warri umuriidhaan naa gadii,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.1",
            "verseOrgIds": [
              "JOB.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:1"
      },
      "items": [
        {
          "text": "kanneen ani abbootii isaanii",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.1",
            "verseOrgIds": [
              "JOB.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 30:1"
      },
      "items": [
        {
          "text": "saroota hoolota koo tiksitu wajjin iyyuu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.1",
            "verseOrgIds": [
              "JOB.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:1"
      },
      "items": [
        {
          "text": "madaaluu tuffadhe, kunoo natti qoosu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.1",
            "verseOrgIds": [
              "JOB.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warra humna dhaban,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.2",
            "verseOrgIds": [
              "JOB.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:2"
      },
      "items": [
        {
          "text": "jabinni irree isaanii maal na fayyada?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.2",
            "verseOrgIds": [
              "JOB.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan rakkinaa fi beelaan laafan;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.3",
            "verseOrgIds": [
              "JOB.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:3"
      },
      "items": [
        {
          "text": "lafa gogaa keessa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.3",
            "verseOrgIds": [
              "JOB.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:3"
      },
      "items": [
        {
          "text": "gammoojjii namni keessa hin jiraanne keessa halkaniin jooran.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.3",
            "verseOrgIds": [
              "JOB.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daggala keessaa biqiltuu soogiddaa funaannatan;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.4",
            "verseOrgIds": [
              "JOB.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:4"
      },
      "items": [
        {
          "text": "nyaanni isaaniis hidda mukaa kan hin miʼoofne ture.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.4",
            "verseOrgIds": [
              "JOB.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan namoota gidduudhaa ariʼaman;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.5",
            "verseOrgIds": [
              "JOB.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:5"
      },
      "items": [
        {
          "text": "namoonnis akkuma waan hattuutti iyyaniitti itti iyyan.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.5",
            "verseOrgIds": [
              "JOB.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan akka laga gogaa keessa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.6",
            "verseOrgIds": [
              "JOB.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:6"
      },
      "items": [
        {
          "text": "kattaa gidduu fi boolla lafaa keessa jiraataniif dirqamaman.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.6",
            "verseOrgIds": [
              "JOB.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bosona keessatti ni halaaku;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.7",
            "verseOrgIds": [
              "JOB.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:7"
      },
      "items": [
        {
          "text": "daggala keessattis walitti tuutaʼu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.7",
            "verseOrgIds": [
              "JOB.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan gowwoota maqaa hin qabne,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.8",
            "verseOrgIds": [
              "JOB.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:8"
      },
      "items": [
        {
          "text": "kanneen biyyaa ariʼaman turan.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.8",
            "verseOrgIds": [
              "JOB.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Amma ilmaan isaanii sirba natti baafatan;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.9",
            "verseOrgIds": [
              "JOB.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:9"
      },
      "items": [
        {
          "text": "ani isaan gidduutti waan kolfaa taʼeera.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.9",
            "verseOrgIds": [
              "JOB.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan xireeffatanii narraa fagaatan;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.10",
            "verseOrgIds": [
              "JOB.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:10"
      },
      "items": [
        {
          "text": "fuula kootti tufuu irraas duubatti hin deebiʼan.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.10",
            "verseOrgIds": [
              "JOB.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii Waaqni iddaa koo laafisee gad na deebiseef,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.11",
            "verseOrgIds": [
              "JOB.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:11"
      },
      "items": [
        {
          "text": "isaan fuula koo duratti luugama baafatan.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.11",
            "verseOrgIds": [
              "JOB.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karaa mirga kootiin addaggeewwan kaʼaniiru;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.12",
            "verseOrgIds": [
              "JOB.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:12"
      },
      "items": [
        {
          "text": "miilla kootiif kiyyoo kaaʼaniiru;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.12",
            "verseOrgIds": [
              "JOB.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:12"
      },
      "items": [
        {
          "text": "biyyoos akka dallaa natti naannessan.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.12",
            "verseOrgIds": [
              "JOB.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan karaa koo natti cufu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.13",
            "verseOrgIds": [
              "JOB.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:13"
      },
      "items": [
        {
          "text": "na galaafachuufis ni milkaaʼu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.13",
            "verseOrgIds": [
              "JOB.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:13"
      },
      "items": [
        {
          "text": "namni isaan dhowwu tokko iyyuu hin jiru.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.13",
            "verseOrgIds": [
              "JOB.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma nama qaawwa balʼaan dhufuutti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.14",
            "verseOrgIds": [
              "JOB.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:14"
      },
      "items": [
        {
          "text": "ona diigamaa keessa gangalachaa natti dhufu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.14",
            "verseOrgIds": [
              "JOB.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodaan na liqimseera; ulfinni koo akkuma waan",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.15",
            "verseOrgIds": [
              "JOB.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:15"
      },
      "items": [
        {
          "text": "bubbeedhaan fudhatamuutti narraa fudhatameera;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.15",
            "verseOrgIds": [
              "JOB.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:15"
      },
      "items": [
        {
          "text": "badhaadhummaan koos akkuma duumessaa bada.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.15",
            "verseOrgIds": [
              "JOB.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Amma lubbuun koo na keessatti dhumteerti;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.16",
            "verseOrgIds": [
              "JOB.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:16"
      },
      "items": [
        {
          "text": "barri rakkinaas na qabateera.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.16",
            "verseOrgIds": [
              "JOB.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
