      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:30"
      },
      "items": [
        {
          "text": "mootii hin taanee fi akka isaan sabaaf kiyyoo hin keenyeefii dha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.30",
            "verseOrgIds": [
              "JOB.34.30"
            ]
          }
        }
      ]
    },
