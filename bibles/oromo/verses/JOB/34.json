            "number": "34",
            "style": "v",
            "sid": "JOB 34:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Namoonni hubannaa qaban ni dubbatu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.34",
            "verseOrgIds": [
              "JOB.34.34"
            ]
          }
        }
      ]
    },
