      "attrs": {
        "style": "q2",
        "vid": "JOB 34:23"
      },
      "items": [
        {
          "text": "Waaqni nama kam iyyuu hin beellamu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.23",
            "verseOrgIds": [
              "JOB.34.23"
            ]
          }
