          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iji isaa karaa namootaa irra jira;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.21",
            "verseOrgIds": [
              "JOB.34.21"
