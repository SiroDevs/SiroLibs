        "style": "q2",
        "vid": "JOB 34:21"
      },
      "items": [
        {
          "text": "inni tarkaanfii isaanii hunda ni arga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.21",
            "verseOrgIds": [
              "JOB.34.21"
            ]
          }
        }
