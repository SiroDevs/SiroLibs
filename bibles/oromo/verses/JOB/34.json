          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni gaaffii tokko malee namoota jajjaboo ni burkuteessa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.24",
            "verseOrgIds": [
              "JOB.34.24"
            ]
          }
        }
