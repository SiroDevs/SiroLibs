          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis akka namni Waaqaaf hin bulle",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.30",
            "verseOrgIds": [
              "JOB.34.30"
            ]
          }
        }
      ]
    },
