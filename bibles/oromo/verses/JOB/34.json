      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:28"
      },
      "items": [
        {
          "text": "akka iyyi hiyyeeyyii fuula isaa duratti dhagaʼamu godhaniiru.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.28",
            "verseOrgIds": [
              "JOB.34.28"
            ]
          }
        }
      ]
    },
