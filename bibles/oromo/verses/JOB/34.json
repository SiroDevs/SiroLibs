          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOB 34:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni sababii ati qalbii jijjiirrachuu didduuf",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.33",
            "verseOrgIds": [
              "JOB.34.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:33"
      },
      "items": [
        {
          "text": "akkuma yaada keetiitti gatii siif baasaa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.33",
            "verseOrgIds": [
              "JOB.34.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 34:33"
      },
      "items": [
        {
          "text": "Situ murteessuu qaba malee ana miti;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.33",
            "verseOrgIds": [
              "JOB.34.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:33"
      },
      "items": [
        {
          "text": "kanaafuu ati waan beektu natti himi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.33",
            "verseOrgIds": [
              "JOB.34.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
