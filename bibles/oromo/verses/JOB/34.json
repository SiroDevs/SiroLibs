      "attrs": {
        "style": "q2",
        "vid": "JOB 34:19"
      },
      "items": [
        {
          "text": "sooreyyii fi hiyyeeyyii wal hin caalchisu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.19",
            "verseOrgIds": [
              "JOB.34.19"
            ]
          }
        }
