          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan halkan walakkaa tasa duʼu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.20",
            "verseOrgIds": [
              "JOB.34.20"
            ]
