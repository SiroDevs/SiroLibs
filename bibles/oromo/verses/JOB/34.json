          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka inni murtiidhaaf fuula isaa duratti dhiʼaatuuf,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.23",
            "verseOrgIds": [
              "JOB.34.23"
            ]
