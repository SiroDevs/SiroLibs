      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 34:29"
      },
      "items": [
        {
          "text": "Taʼus inni namaa fi saba illee ni toʼata;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.29",
            "verseOrgIds": [
              "JOB.34.29"
            ]
          }
        }
