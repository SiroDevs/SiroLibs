      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 34:29"
      },
      "items": [
        {
          "text": "Yoo inni fuula isaa dhokfates eenyutu isa arguu dandaʼa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.29",
            "verseOrgIds": [
              "JOB.34.29"
            ]
          }
        }
      ]
    },
