          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo inni calʼise garuu, eenyutu isatti muruu dandaʼa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.29",
            "verseOrgIds": [
              "JOB.34.29"
            ]
          }
        }
      ]
    },
