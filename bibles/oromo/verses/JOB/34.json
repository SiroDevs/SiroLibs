      "attrs": {
        "style": "q2",
        "vid": "JOB 34:25"
      },
      "items": [
        {
          "text": "halkan keessa isaan garagalcha; isaanis ni barbadaaʼu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.25",
            "verseOrgIds": [
              "JOB.34.25"
            ]
          }
