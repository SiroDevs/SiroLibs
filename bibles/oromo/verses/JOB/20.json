  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "JOB 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zoofaari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zoofaari Naaʼimaatichi akkana jedhee deebise:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.1",
            "verseOrgIds": [
              "JOB.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Waan ani akka malee jeeqameef,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.2",
            "verseOrgIds": [
              "JOB.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:2"
      },
      "items": [
        {
          "text": "yaadni koo akka ani deebii kennu na kakaasa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.2",
            "verseOrgIds": [
              "JOB.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani dheekkamsa na qaanessu dhagaʼaan jira;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.3",
            "verseOrgIds": [
              "JOB.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:3"
      },
      "items": [
        {
          "text": "qalbiin koos akka ani deebii kennu na kakaasa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.3",
            "verseOrgIds": [
              "JOB.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ati erga namni lafa irra kaaʼamee bara duriitii jalqabee",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.4",
            "verseOrgIds": [
              "JOB.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:4"
      },
      "items": [
        {
          "text": "wanni kun akkam akka ture ni beekta mitii?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.4",
            "verseOrgIds": [
              "JOB.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Burraaquun jalʼootaa yeroo gabaabaaf tura;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.5",
            "verseOrgIds": [
              "JOB.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:5"
      },
      "items": [
        {
          "text": "gammachuun warra Waaqaaf hin bullees akkuma liphsuu ijaa ti.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.5",
            "verseOrgIds": [
              "JOB.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Of tuulummaan isaa samiiwwan gaʼee",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.6",
            "verseOrgIds": [
              "JOB.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:6"
      },
      "items": [
        {
          "text": "mataan isaa duumessawwan tuqus,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.6",
            "verseOrgIds": [
              "JOB.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "inni akkuma awwaaraa bara baraan bada;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.7",
            "verseOrgIds": [
              "JOB.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:7"
      },
      "items": [
        {
          "text": "warri duraan isa arganis, 'Inni eessa jira?' jedhu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.7",
            "verseOrgIds": [
              "JOB.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni akkuma abjuu fiigee bada; deebiʼees hin argamu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.8",
            "verseOrgIds": [
              "JOB.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:8"
      },
      "items": [
        {
          "text": "akkuma mulʼata halkaniis dafee dhabama.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.8",
            "verseOrgIds": [
              "JOB.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iji isaa argee ture deebiʼee isa hin argu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.9",
            "verseOrgIds": [
              "JOB.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:9"
      },
      "items": [
        {
          "text": "iddoon isaas siʼachi isa hin ilaalu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.9",
            "verseOrgIds": [
              "JOB.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijoolleen isaa hiyyeeyyiif beenyaa baasu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.10",
            "verseOrgIds": [
              "JOB.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:10"
      },
      "items": [
        {
          "text": "harki isaas qabeenya inni saame deebisee kennuu qaba.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.10",
            "verseOrgIds": [
              "JOB.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jabinni dargaggummaa kan lafee isaa keessa guute sun,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.11",
            "verseOrgIds": [
              "JOB.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:11"
      },
      "items": [
        {
          "text": "isa wajjin biyyoo keessa ciisa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.11",
            "verseOrgIds": [
              "JOB.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hamminni afaan isaa keessatti miʼaawee",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.12",
            "verseOrgIds": [
              "JOB.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:12"
      },
      "items": [
        {
          "text": "inni arraba isaa jala dhokfatu iyyuu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.12",
            "verseOrgIds": [
              "JOB.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "inni afaanii baafatee gatuu jibbee",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.13",
            "verseOrgIds": [
              "JOB.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:13"
      },
      "items": [
        {
          "text": "afaanuma ofii isaa keessa turfatu iyyuu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.13",
            "verseOrgIds": [
              "JOB.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyaanni isaa garaa isaa keessatti dhangaggaaʼa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.14",
            "verseOrgIds": [
              "JOB.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:14"
      },
      "items": [
        {
          "text": "isa keessattis hadhaa bofaa taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.14",
            "verseOrgIds": [
              "JOB.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni qabeenya liqimse sana ni tufa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.15",
            "verseOrgIds": [
              "JOB.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:15"
      },
      "items": [
        {
          "text": "Waaqnis akka garaan isaa waan sana diddigu ni godha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.15",
            "verseOrgIds": [
              "JOB.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni summii bofaa xuuxa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.16",
            "verseOrgIds": [
              "JOB.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:16"
      },
      "items": [
        {
          "text": "arrabni buutiis isa ajjeesa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.16",
            "verseOrgIds": [
              "JOB.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni laga yaaʼu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.17",
            "verseOrgIds": [
              "JOB.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:17"
      },
      "items": [
        {
          "text": "burqaa dammaatii fi dhadhaa hin argu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.17",
            "verseOrgIds": [
              "JOB.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni waan itti dadhabe utuu hin nyaatin deebisa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.18",
            "verseOrgIds": [
              "JOB.20.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:18"
      },
      "items": [
        {
          "text": "buʼaa daldala isaa irraa argatettis hin gammadu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.18",
            "verseOrgIds": [
              "JOB.20.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni hiyyeeyyii hacuucee harka duwwaa hambiseeraatii;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.19",
            "verseOrgIds": [
              "JOB.20.19"
            ]
          }
        }
