  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "JOB 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bildaad",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bildaad Shuhaahichi akkana jedhee deebise:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.1",
            "verseOrgIds": [
              "JOB.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Isin haasaa kana yoom fixxu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.2",
            "verseOrgIds": [
              "JOB.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:2"
      },
      "items": [
        {
          "text": "Mee qalbeeffadhaa; ergasii dubbachuu dandeenya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.2",
            "verseOrgIds": [
              "JOB.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu maaliif akka looniitti hedamna?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.3",
            "verseOrgIds": [
              "JOB.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:3"
      },
      "items": [
        {
          "text": "Maaliifis fuula kee duratti akka gowwaatti ilaalamna?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.3",
            "verseOrgIds": [
              "JOB.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati kan aariidhaan of ciccirtu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.4",
            "verseOrgIds": [
              "JOB.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:4"
      },
      "items": [
        {
          "text": "lafti sababii keetiif duwwaatti haftii?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.4",
            "verseOrgIds": [
              "JOB.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:4"
      },
      "items": [
        {
          "text": "Yookaan kattaan iddoo isaatii ni buqqifamaa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.4",
            "verseOrgIds": [
              "JOB.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ibsaan nama hamaa ni dhaama;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.5",
            "verseOrgIds": [
              "JOB.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:5"
      },
      "items": [
        {
          "text": "arrabni ibidda isaa ifa hin kennu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.5",
            "verseOrgIds": [
              "JOB.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifni dunkaana isaa keessaa ni dukkanaaʼa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.6",
            "verseOrgIds": [
              "JOB.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:6"
      },
      "items": [
        {
          "text": "ibsaan isa bira jirus ni dhaama.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.6",
            "verseOrgIds": [
              "JOB.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jabinni tarkaanfii isaa ni dadhaba;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.7",
            "verseOrgIds": [
              "JOB.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:7"
      },
      "items": [
        {
          "text": "malli isaas isuma kuffisa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.7",
            "verseOrgIds": [
              "JOB.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miilli isaa kiyyoo keessa isa buusa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.8",
            "verseOrgIds": [
              "JOB.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:8"
      },
      "items": [
        {
          "text": "inni boolla kiyyeeffame irra ni joora.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.8",
            "verseOrgIds": [
              "JOB.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiyyoon kottee isaa qaba;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.9",
            "verseOrgIds": [
              "JOB.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:9"
      },
      "items": [
        {
          "text": "futtaasaanis jabeessee isa qaba.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.9",
            "verseOrgIds": [
              "JOB.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lafa irra funyoon isaaf dhokfameera;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.10",
            "verseOrgIds": [
              "JOB.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:10"
      },
      "items": [
        {
          "text": "karaa isaa irras kiyyoon kaaʼameera.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.10",
            "verseOrgIds": [
              "JOB.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naasuun karaa hundaan isa sodaachisa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.11",
            "verseOrgIds": [
              "JOB.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:11"
      },
      "items": [
        {
          "text": "faana isaa buʼees isa ariʼa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.11",
            "verseOrgIds": [
              "JOB.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Badiisni afaan itti banateera;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.12",
            "verseOrgIds": [
              "JOB.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:12"
      },
      "items": [
        {
          "text": "balaanis qophaaʼee jiguu isaa eeggata.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.12",
            "verseOrgIds": [
              "JOB.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gogaan isaa dhukkubaan nyaatamee dhuma;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.13",
            "verseOrgIds": [
              "JOB.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:13"
      },
      "items": [
        {
          "text": "ilmi duʼaa hangaftichi harkaa fi miilla isaa nyaata.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.13",
            "verseOrgIds": [
              "JOB.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni dunkaana abdate keessaa buqqifamee",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.14",
            "verseOrgIds": [
              "JOB.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:14"
      },
      "items": [
        {
          "text": "gara mootii sodaatti geeffama.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.14",
            "verseOrgIds": [
              "JOB.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan kan isaa hin taʼinis dunkaana isaa keessa jiraata;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.15",
            "verseOrgIds": [
              "JOB.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:15"
      },
      "items": [
        {
          "text": "dinyiin bobaʼus iddoo inni jiraatu irra faffacaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.15",
            "verseOrgIds": [
              "JOB.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jalaan hiddi isaa ni goga;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.16",
            "verseOrgIds": [
              "JOB.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:16"
      },
      "items": [
        {
          "text": "irraan immoo dameen isaa ni coollaga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.16",
            "verseOrgIds": [
              "JOB.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaadannoon isaa lafa irraa ni bada;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.17",
            "verseOrgIds": [
              "JOB.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:17"
      },
      "items": [
        {
          "text": "maqaan isaas lafa irraa ni dhabama.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.17",
            "verseOrgIds": [
              "JOB.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni ifa keessaa gara dukkanaatti darbatama;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.18",
            "verseOrgIds": [
              "JOB.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:18"
      },
      "items": [
        {
          "text": "addunyaa irraas ni dhabama.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.18",
            "verseOrgIds": [
              "JOB.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni saba isaa gidduutti ijoollee yookaan sanyii,",
          "type": "text",
          "attrs": {
