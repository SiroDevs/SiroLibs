      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:5"
      },
      "items": [
        {
          "text": "lola isatti kaasuuf qophaaʼu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.5",
            "verseOrgIds": [
              "MIC.3.5"
            ]
          }
        }
      ]
