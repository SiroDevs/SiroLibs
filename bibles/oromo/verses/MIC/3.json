      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:6"
      },
      "items": [
        {
          "text": "guyyaanis isaanitti dukkanaaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.6",
            "verseOrgIds": [
              "MIC.3.6"
            ]
          }
        }
      ]
    },
    {
