            "sid": "MIC 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "warri foon saba koo nyaattan,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.3",
            "verseOrgIds": [
              "MIC.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:3"
      },
      "items": [
        {
          "text": "kanneen gogaa isaanii irraa qunciftanii",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.3",
            "verseOrgIds": [
              "MIC.3.3"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "lafee isaanii caccabsitan,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.3",
            "verseOrgIds": [
              "MIC.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:3"
      },
      "items": [
        {
          "text": "isin warri akka foon eeleetti waadamuutii fi",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.3",
            "verseOrgIds": [
              "MIC.3.3"
            ]
          }
        }
      ]
    },
