    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:4"
      },
      "items": [
        {
          "text": "isaan hojjetaniitiif fuula isaa isaan duraa ni dhokfata.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.4",
            "verseOrgIds": [
              "MIC.3.4"
            ]
          }
        }
