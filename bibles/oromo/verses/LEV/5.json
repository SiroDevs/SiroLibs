  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "LEV 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Namni tokko yoo waan nama kakachiisu dhagaʼee waaʼee waan arge yookaan beeku sanaa dhugaa baʼuu diduudhaan cubbuu hojjete inni itti gaafatama.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.1",
            "verseOrgIds": [
              "LEV.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Yookaan namni tokko yoo waan akka seeraatti xuraaʼaa taʼe jechuunis raqa bineensa xuraaʼaa yookaan horii xuraaʼaa yookaan uumamawwan xuraaʼoo kanneen lafa irra munyuuqanii utuu hin beekin tuqe inni xuraaʼeera; yakka qabeessas taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.2",
            "verseOrgIds": [
              "LEV.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yookaan inni yoo xuraaʼummaa namaa jechuunis waan isa xureessu kam iyyuu utuu hin beekin tuqe, yommuu waan sana beeketti yakka qabeessa taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.3",
            "verseOrgIds": [
              "LEV.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yookaan namni yoo utuu itti hin yaadin waan gaarii yookaan hamaa gochuuf kakate, waaʼee waan utuu itti hin yaadin kakate sanaa beekuu baatu illee maalumaafuu yommuu waan sana beeketti inni yakka qabeessa taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.4",
            "verseOrgIds": [
              "LEV.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni yoo karaa kanneen keessaa tokkoon iyyuu yakka qabeessa taʼe karaa kamiin akka hojjete haa himatu;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.5",
            "verseOrgIds": [
              "LEV.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "adaba cubbuu hojjete sanaatiifis akka aarsaa cubbuu isaaf taatuuf bushaayee keessaa hoolaa yookaan reʼee dhaltuu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.6",
            "verseOrgIds": [
              "LEV.5.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "LEV.5.6",
                "verseOrgIds": [
                  "LEV.5.6"
                ]
              }
            }
          ]
        },
        {
          "text": "haa fidu; lubnis cubbuu namichaatiif aarsaa araaraa haa dhiʼeessu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.6",
            "verseOrgIds": [
              "LEV.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Namichi sun cubbuu hojjeteef hoolaa dhiʼeessuutti harka qalleessa yoo taʼe adabbii cubbuu isaatiif gugee lama yookaan gugee sosookkee lama, tokko aarsaa cubbuutiif tokko immoo aarsaa gubamuuf",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.7",
            "verseOrgIds": [
              "LEV.5.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "LEV.5.7",
                "verseOrgIds": [
                  "LEV.5.7"
                ]
              }
            }
          ]
        },
        {
          "text": "haa fidu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.7",
            "verseOrgIds": [
              "LEV.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubattis isaan haa fidu; lubni immoo kan aarsaa cubbuutiif taatu duraan dursee haa dhiʼeessu. Innis mataa ishee micciiree morma ishee haa cabsu; garuu irraa hin kutin.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.8",
            "verseOrgIds": [
              "LEV.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhiiga aarsaa cubbuu sana irraa fuudhee cinaacha iddoo aarsaatti haa facaasu; dhiigni hafe immoo miilla iddoo aarsaa jalatti haa dhangalaafamu; kun aarsaa cubbuu ti.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.9",
            "verseOrgIds": [
              "LEV.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis lubichi akkuma ajajametti kan lammaffaa sana aarsaa gubamu godhee cubbuu namichi hojjeteef aarsaa araaraa haa dhiʼeessu; innis dhiifama argata.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.10",
            "verseOrgIds": [
              "LEV.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Namichi sun yoo gugee lama yookaan gugee sosookkee lama dhiʼeessuutti harka qalleessa taʼe inni cubbuu hojjete sanaaf daakuu bullaaʼaa iifii tokkoo keessaa harka kurnaffaa aarsaa cubbuutiif haa dhiʼeessu. Sababii wanni kun aarsaa cubbuu taʼeef namichi zayitii yookaan ixaana itti hin dabalin.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.11",
            "verseOrgIds": [
              "LEV.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis lubatti haa fidu; lubichi immoo konyee tokko irraa fuudhee akka kutaa yaadannoo tokkootti aarsaa ibiddaan",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.12",
            "verseOrgIds": [
              "LEV.5.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "LEV.5.12",
                "verseOrgIds": [
                  "LEV.5.12"
                ]
              }
            }
          ]
        },
        {
          "text": "dhiʼeeffame gubbaatti iddoo aarsaa irratti haa gubu; kun aarsaa cubbuu ti.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.12",
            "verseOrgIds": [
              "LEV.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubichis haala kanaan cubbuu namichi hojjeteef araara buusa; innis dhiifama argata. Aarsaan hafe immoo akkuma aarsaa midhaaniitti kan lubichaa taʼa.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.13",
            "verseOrgIds": [
              "LEV.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aarsaa Yakkaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.5.14",
                "verseOrgIds": [
                  "LEV.5.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Museedhaan akkana jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.14",
            "verseOrgIds": [
              "LEV.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Namni yoo seera cabsee utuu hin beekin waan",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.15",
            "verseOrgIds": [
              "LEV.5.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "LEV.5.15",
                "verseOrgIds": [
                  "LEV.5.15"
                ]
              }
            }
          ]
        },
        {
          "text": "qulqulleeffame kam iyyutti cubbuu hojjete inni adabbii cubbuu isaatiif bushaayee keessaa korbeessa hoolaa kan hirʼina hin qabne kan gatiin isaa akka saqilii iddoo qulqulluutti meetiidhaan tilmaamame tokko aarsaa yakkaa godhee",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.15",
            "verseOrgIds": [
              "LEV.5.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "LEV.5.15",
                "verseOrgIds": [
                  "LEV.5.15"
                ]
              }
            }
          ]
        },
        {
          "text": "haa fidu; kun aarsaa yakkaa ti.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.15",
            "verseOrgIds": [
              "LEV.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichi sunis waan wantoota qulqulluu irraa hirʼise sana iddoo haa buusu; gatii waan sanaa illee harka shan keessaa harka tokko itti dabalee hunda isaa lubatti haa kennu; lubni sunis korbeessa hoolaa aarsaa yakkaatiif dhiʼeeffame sanaan araara buusaaf; innis dhiifama argata.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.16",
            "verseOrgIds": [
              "LEV.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Namni yoo cubbuu hojjetee waan ajajawwan",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.17",
            "verseOrgIds": [
              "LEV.5.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.5.17",
                "verseOrgIds": [
                  "LEV.5.17"
                ]
              }
            }
          ]
        },
        {
          "text": "keessatti dhowwame hojjete, inni yoo beekuu baate illee yakka qabeessa taʼeera; itti gaafatamas.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.17",
            "verseOrgIds": [
              "LEV.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akka tilmaama keetiitti bushaayee keessaa korbeessa hoolaa hirʼina hin qabne tokko aarsaa yakkaa godhee lubatti haa fidu. Lubichis haaluma kanaan yakka namichi utuu hin beekin hojjeteef araara buusa; innis dhiifama argata.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.18",
            "verseOrgIds": [
              "LEV.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kun aarsaa yakkaa ti; namichi sun",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.19",
            "verseOrgIds": [
              "LEV.5.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyotti",
              "type": "text",
              "attrs": {
                "verseId": "LEV.5.19",
                "verseOrgIds": [
                  "LEV.5.19"
                ]
              }
            }
          ]
        },
        {
          "text": "yakka hojjeteera.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.19",
            "verseOrgIds": [
              "LEV.5.19"
            ]
          }
        }
      ]
    }
  ],
