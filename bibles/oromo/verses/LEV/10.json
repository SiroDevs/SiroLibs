                "verseOrgIds": [
                  "LEV.10.17"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti araara isaaniif buusuudhaan yakka sabaa balleessitaniif isiniif kenname.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.17",
            "verseOrgIds": [
              "LEV.10.17"
            ]
          }
        },
        {
