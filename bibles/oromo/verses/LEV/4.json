                "verseOrgIds": [
                  "LEV.4.27"
                ]
              }
            }
          ]
        },
        {
          "text": "keessatti dhowwame keessaa tokko illee cabsuudhaan cubbuu hojjete inni yakka qabeessa taʼa.",
          "type": "text",
          "attrs": {
