                "verseId": "LEV.4.22",
                "verseOrgIds": [
                  "LEV.4.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa isaa keessatti dhowwame hojjete inni yakka qabeessa taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.22",
            "verseOrgIds": [
              "LEV.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni yommuu cubbuu hojjete sana beeketti korma reʼee kan hirʼina hin qabne tokko aarsaa ofii isaatiif haa fidu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.23",
            "verseOrgIds": [
              "LEV.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mataa reʼee sanaa irra harka isaa kaaʼee iddoo aarsaan gubamu itti qalamutti fuula",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.24",
            "verseOrgIds": [
              "LEV.4.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.4.24",
                "verseOrgIds": [
                  "LEV.4.24"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti haa qalu; kunis aarsaa cubbuu ti.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.24",
            "verseOrgIds": [
              "LEV.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubni sunis ergasii dhiiga aarsaa cubbuutiif dhiʼeeffame irraa quba isaatiin fuudhee gaanfa iddoo aarsaa kan aarsaan gubamu irratti dhiʼeeffamutti haa naqu; dhiiga hafe immoo miilla iddoo aarsaa jalatti haa dhangalaasu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.25",
            "verseOrgIds": [
              "LEV.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akkuma cooma aarsaa nagaatiif dhiʼeeffame gube sana moora hunda iddoo aarsaa irratti haa gubu; lubichi haala kanaan namichaaf araara cubbuu buusa; innis dhiifama argata.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.26",
            "verseOrgIds": [
              "LEV.4.26"
            ]
          }
        }
      ]
