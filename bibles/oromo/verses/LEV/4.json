              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni yommuu akka cubbuu hojjete beeketti cubbuu hojjete sanaaf reʼee dhaltuu hirʼina hin qabne tokko aarsaa ofii isaatiif haa fidu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.28",
            "verseOrgIds": [
              "LEV.4.28"
            ]
          }
        },
