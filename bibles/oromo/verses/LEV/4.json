          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mataa reʼee aarsaa cubbuutiif dhiʼeeffamte sanaa irras harka isaa kaaʼee iddoo aarsaa gubamuutti haa qalu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.29",
            "verseOrgIds": [
              "LEV.4.29"
            ]
          }
        },
        {
          "name": "verse",
