                "verseOrgIds": [
                  "LEV.4.31"
                ]
              }
            }
          ]
        },
        {
          "text": "tolu godhee iddoo aarsaa irratti haa gubu. Akkasiinis lubni araara buusaaf; innis dhiifama argata.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.31",
            "verseOrgIds": [
              "LEV.4.31"
