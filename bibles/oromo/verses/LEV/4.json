          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma moorri itti aarsaa nagaa irraa baafamutti inni moora hunda haa baasu; lubni immoo aarsaa urgaan isaa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.31",
            "verseOrgIds": [
              "LEV.4.31"
            ]
