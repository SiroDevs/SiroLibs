    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.1",
                "verseOrgIds": [
                  "LEV.16.1"
                ]
              }
            }
          ]
        },
        {
          "text": "duʼa ilmaan Aroon kanneen yeroo fuula",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.1",
            "verseOrgIds": [
              "LEV.16.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.1",
                "verseOrgIds": [
                  "LEV.16.1"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti dhiʼaatanitti duʼan sana lamaanii booddee Museetti dubbate.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.1",
            "verseOrgIds": [
              "LEV.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.2",
                "verseOrgIds": [
                  "LEV.16.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Museedhaan akkana jedhe; \"Sababii ani teessoo araaraa gararraatti duumessaan mulʼadhuuf akka obboleessi kee Aroon yeruma fedhetti gara Iddoo Iddoo Hunda Caalaa Qulqulluu kan golgaa keessa fuula teessoo araaraa dura taabota irra jiru sanaa ol hin seenne itti himi; yoo kanaa achii inni ni duʼa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.2",
            "verseOrgIds": [
              "LEV.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Akki Aroon itti Iddoo Iddoo Hunda Caalaa qulqulluu sana seenu kanaa dha: Aarsaa cubbuutiif dibicha tokko, aarsaa gubamuuf immoo korbeessa hoolaa tokko haa fidu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.3",
            "verseOrgIds": [
              "LEV.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis kittaa quncee talbaa irraa hojjetame qulqulluu isaatii fi uffata dhagna isaatti aanu kan quncee talbaa irraa hojjetame haa kaaʼatu. Sabbata quncee talbaa irraa hojjetame hidhatee marata mataa kan quncee talbaa irraa hojjetames haa maratu; kunneen uffata qulqulluu dha. Kanaafuu inni utuu uffata sana hin uffatin dhagna isaa bishaaniin haa dhiqatu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.4",
            "verseOrgIds": [
              "LEV.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waldaa saba Israaʼel irraas aarsaa cubbuutiif korommii reʼee lama, aarsaa gubamuuf immoo korbeessa hoolaa tokko haa fuudhu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.5",
            "verseOrgIds": [
              "LEV.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Aroon aarsaa cubbuu ofii isaatiif dibicha sana dhiʼeessee ofii isaatii fi warra mana isaa jiraniif araara haa buusu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.6",
            "verseOrgIds": [
              "LEV.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis reʼoota lamaan sana fuudhee balbala dunkaana wal gaʼii irratti fuula",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.7",
            "verseOrgIds": [
              "LEV.16.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.7",
                "verseOrgIds": [
                  "LEV.16.7"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti haa dhiʼeessu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.7",
            "verseOrgIds": [
              "LEV.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroonis reʼoota sana lamaanitti ixaa haa buusu; ixaa tokko",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.8",
            "verseOrgIds": [
              "LEV.16.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.8",
                "verseOrgIds": [
                  "LEV.16.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", kaan immoo reʼee gad lakkifamuuf haa buusu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.8",
            "verseOrgIds": [
              "LEV.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroonis reʼee ixaan",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.9",
            "verseOrgIds": [
              "LEV.16.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.9",
                "verseOrgIds": [
                  "LEV.16.9"
                ]
              }
            }
          ]
        },
        {
          "text": "irra buʼe sana fidee aarsaa cubbuu godhee haa dhiʼeessu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.9",
            "verseOrgIds": [
              "LEV.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu reʼeen akka reʼee gad lakkifamu taʼuuf ixaadhaan filatame sun akka reʼee gad lakkifamu tokkootti gammoojjiitti gad ariʼamuudhaan akka araara buusuuf utuu lubbuudhaan jiruu fuula",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.10",
            "verseOrgIds": [
              "LEV.16.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.10",
                "verseOrgIds": [
                  "LEV.16.10"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti haa dhiʼeeffamu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.10",
            "verseOrgIds": [
              "LEV.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Aroonis aarsaa cubbuu ofii isaatiif dibicha sana dhiʼeessee ofii isaatii fi warra mana isaa jiraniif araara haa buusu; dibicha sanas cubbuu ofii isaatiif haa qalu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.11",
            "verseOrgIds": [
              "LEV.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis girgiraa barbadaa ibiddaa iddoo aarsaa kan fuula",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.12",
            "verseOrgIds": [
              "LEV.16.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.12",
                "verseOrgIds": [
                  "LEV.16.12"
                ]
              }
            }
          ]
        },
        {
          "text": "dura jiru irraa itti guutame tokko fuudhee ixaana urgaaʼaa daakamee bullaaʼes konyee lama fuudhee golgaa sana keessa haa seenu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.12",
            "verseOrgIds": [
              "LEV.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akka hin duuneef, akka aarri ixaana sanaa teessoo araaraa kan dhuga baʼumsaa gubbaa jiru sana haguuguuf ixaana sana ibidda fuula",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.13",
            "verseOrgIds": [
              "LEV.16.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.13",
                "verseOrgIds": [
                  "LEV.16.13"
                ]
              }
            }
          ]
        },
        {
          "text": "dura jirutti haa naqu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.13",
            "verseOrgIds": [
              "LEV.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhiiga dibicha sanaa irraa fuudhee karaa fuulduraatiin teessoo araaraatti quba isaatiin haa facaasu; ergasii immoo dhiiga isaa fuudhee fuula teessoo araaraa duratti yeroo torba quba isaatiin haa facaasu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.14",
            "verseOrgIds": [
              "LEV.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Reʼee sanas aarsaa cubbuu sabaa godhee haa qalu; dhiiga isaas fuudhee golgaa keessa seenuudhaan akkuma dhiiga dibicha sanaa godhe sana haa godhu; dhiiga sanas teessoo araaraa irrattii fi fuula teessoo araaraa duratti haa facaasu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.15",
            "verseOrgIds": [
              "LEV.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cubbuun isaanii waanuma fedhe taʼu illee inni sababii xuraaʼummaa fi fincila saba Israaʼeliif Iddoo Iddoo Hunda Caalaa Qulqulluu sana haala kanaan araara haa buusu; dunkaana wal gaʼii kan xuraaʼummaa isaanii keessa isaan gidduu jiruufis akkasuma haa godhu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.16",
            "verseOrgIds": [
              "LEV.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo Aroon Iddoo Iddoo Hunda Caalaa Qulqulluu sana keessatti araara buusuuf ol seenee jalqabee hamma inni ofii isaatiif, warra mana isaa jiranii fi waldaa Israaʼel hundaaf araara buusee gad baʼutti namni tokko iyyuu dunkaana wal gaʼii keessatti hin argamin.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.17",
            "verseOrgIds": [
              "LEV.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ergasiis iddoo aarsaa kan fuula",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.18",
            "verseOrgIds": [
              "LEV.16.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.18",
                "verseOrgIds": [
                  "LEV.16.18"
                ]
              }
            }
          ]
        },
        {
          "text": "dura jiru sanatti gad baʼee iddoo aarsaa sanaaf araara haa buusu. Innis dhiiga dibicha sanaa irraa fuudhee, dhiiga reʼee sanaa irraas fuudhee gaanfa iddoo aarsaa sanaa hunda irratti haa naqu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.18",
            "verseOrgIds": [
              "LEV.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis iddoo aarsaa sana xuraaʼummaa saba Israaʼel irraa qulqulleessee addaan baasuuf dhiiga sana irraa quba isaatiin yeroo torba iddoo aarsaa irratti haa facaasu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.19",
            "verseOrgIds": [
              "LEV.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Aroon erga Iddoo Iddoo Hunda Caalaa Qulqulluu sana, dunkaana wal gaʼiitii fi iddoo aarsaatiif araara buusee raawwatee booddee reʼee lubbuudhaan jiru sana gara fuulduraatti haa dhiʼeessu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.20",
            "verseOrgIds": [
              "LEV.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis harka isaa lamaanuu mataa reʼee lubbuudhaan jiru sanaa irra kaaʼee achi irratti hamminaa fi fincila saba Israaʼel jechuunis cubbuu isaanii hunda hima. Yakka hundas mataa reʼee sanaa irra kaaʼee reʼee sana nama hojii kanaaf filatame tokkotti kennee gara gammoojjiitti haa ariʼu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.21",
            "verseOrgIds": [
              "LEV.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reʼeen sunis cubbuu isaanii hunda of irratti baatee gara lafa namni hin dhaqneetti geessa; namichis gammoojjii keessatti isa gad dhiisa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.22",
            "verseOrgIds": [
              "LEV.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ergasiis Aroon dunkaana wal gaʼii seenee uffata quncee talbaa irraa hojjetame kan utuu Iddoo Iddoo Hunda Caalaa Qulqulluu sana hin seenin uffate sana baafatee achumatti haa dhiisu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.23",
            "verseOrgIds": [
              "LEV.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis lafa qulqulluu tokkotti dhagna isaa bishaaniin dhiqatee uffata isa haa uffatu; ergasii immoo gad baʼee ofii isaatii fi saba sanaaf araara buusuuf, ofii isaatiif aarsaa gubamu, saba sanaafis aarsaa gubamu haa dhiʼeessu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.24",
            "verseOrgIds": [
              "LEV.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cooma aarsaa cubbuu illee iddoo aarsaa irratti haa gubu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.25",
            "verseOrgIds": [
              "LEV.16.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Namichi reʼee sana akka reʼee gad lakkifamu tokkootti gad dhiisu sun wayyaa isaa miiccatee dhagna isaa bishaaniin haa dhiqatu; ergasii gara qubataatti ol galuu dandaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.26",
            "verseOrgIds": [
              "LEV.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dibichii fi reʼeen aarsaa cubbuutiif dhiʼeeffaman kanneen dhiigni isaanii araara buusuuf Iddoo Iddoo Hunda Caalaa Qulqulluutti fidame sun qubata keessaa haa baafaman; gogaan isaanii, foonii fi miʼi garaa isaanii haa gubamu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.27",
            "verseOrgIds": [
              "LEV.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichi wantoota kanneen gubus uffata isaa miiccatee dhagna isaa bishaaniin haa dhiqatu; ergasii gara qubataatti ol galuu dandaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.28",
            "verseOrgIds": [
              "LEV.16.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Seerri bara baraan isiniif kenname kanaa dha: Dhalataa biyyaas taʼu alagaan isin gidduu jiraatu guyyaa kurnaffaa jiʼa torbaffaatti gad of haa qabu; hojii tokko iyyuus hin hojjetin.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.29",
            "verseOrgIds": [
              "LEV.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababiin isaa isin qulqulleessuuf guyyaan kun guyyaa itti araarri buʼu dha; ergasiis isin fuula",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.30",
            "verseOrgIds": [
              "LEV.16.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.30",
                "verseOrgIds": [
                  "LEV.16.30"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti cubbuu keessan hunda irraa ni qulqullooftu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.30",
            "verseOrgIds": [
              "LEV.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kun waan sanbata boqonnaa taʼeef isin gad of deebisuu qabdu; innis seera bara baraa ti.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.31",
            "verseOrgIds": [
              "LEV.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubni iddoo abbaa isaa buʼee luba ol aanaa taʼuuf dibamee muudamu araara buusuu qaba; innis wayyaa qulqulluu kan quncee talbaa irraa hojjetame uffatee,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.32",
            "verseOrgIds": [
              "LEV.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iddoo Iddoo Hunda Caalaa Qulqulluuf, dunkaana wal gaʼiitiif, iddoo aarsaatiif, lubootaa fi miseensota waldaa hundaafis araara haa buusu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.33",
            "verseOrgIds": [
              "LEV.16.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Seerri bara baraan isiniif kenname kanaa dha: Kunis akka cubbuu Israaʼelootaa hundaaf waggaatti yeroo tokko araarri buufamuuf.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.34",
            "verseOrgIds": [
              "LEV.16.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LEV 16:34"
      },
      "items": [
        {
          "text": "Wanni sunis akkuma",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.34",
            "verseOrgIds": [
              "LEV.16.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.34",
                "verseOrgIds": [
                  "LEV.16.34"
                ]
              }
            }
          ]
        },
        {
          "text": "Musee ajajetti hojjetame.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.34",
            "verseOrgIds": [
              "LEV.16.34"
            ]
          }
        }
      ]
    }
  ],
