      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:30"
      },
      "items": [
        {
          "text": "Yimnaa, Yishwaa, Yishwii fi Beriiyaa. Obboleettiin isaanii immoo Seraa jedhamti.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.30",
            "verseOrgIds": [
              "1CH.7.30"
            ]
