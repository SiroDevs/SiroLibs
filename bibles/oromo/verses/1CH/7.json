              "type": "text"
            }
          ]
        },
        {
          "text": "ilma isaa Zaabaadii,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.21",
            "verseOrgIds": [
              "1CH.7.21"
            ]
          }
