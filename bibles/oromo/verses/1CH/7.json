          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hebeer immoo abbaa Yaafleexii, Shomeerii, Hootaamiitii fi obboleettii isaanii Shuuʼaa ti.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.32",
            "verseOrgIds": [
