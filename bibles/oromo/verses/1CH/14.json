    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo kanatti Huuraam mootiin Xiiroos akka isaan Daawitiif masaraa mootummaa ijaaraniif ergamoota wajjin muka birbirsaa, warra dhagaa soofanii fi warra ogummaa hojii mukaa qaban gara Daawititti erge.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.1",
            "verseOrgIds": [
              "1CH.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawitis akka",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.2",
            "verseOrgIds": [
              "1CH.14.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1CH.14.2",
                "verseOrgIds": [
                  "1CH.14.2"
                ]
              }
            }
          ]
        },
        {
          "text": "saba Israaʼel irratti mootii godhee jabeessee isa dhaabee fi akka mootummaan isaas sababii saba Israaʼeliif akka malee guddate ni beeke.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.2",
            "verseOrgIds": [
              "1CH.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawitis Yerusaalem keessatti niitota dabalee fuudhee ilmaanii fi intallan dabalataa dhalche.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.3",
            "verseOrgIds": [
              "1CH.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maqaan ijoollee isaa kanneen achitti isaaf dhalataniis: Shamuuʼaa, Shobaab, Naataan, Solomoon,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.4",
            "verseOrgIds": [
              "1CH.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yibehaar, Eliishuuwaa, Eliiphelexi,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.5",
            "verseOrgIds": [
              "1CH.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noogaa, Nefeg, Yaafiiyaa,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.6",
            "verseOrgIds": [
              "1CH.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliishaamaa, Beeliyaadaa fi Eliiphelexi jedhamu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.7",
            "verseOrgIds": [
              "1CH.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daawit Filisxeemota Moʼate",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "1CH.14.8-1CH.14.17"
          },
          "items": [
            {
              "text": "14:8‑17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwf –",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "xt"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "2SA.5.17-2SA.5.25"
              },
              "items": [
                {
                  "text": "2Sm 5:17‑25",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filisxeemonni yommuu akka Daawit dibamee guutummaa Israaʼel irratti mootii taʼe dhagaʼanitti humna guutuudhaan isa barbaacha ol baʼan; Daawit garuu waan kana dhagaʼee isaanitti baʼe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.8",
            "verseOrgIds": [
              "1CH.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo kanatti Filisxeemonni dhufanii Sulula Refaayim weeraran;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.9",
            "verseOrgIds": [
              "1CH.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kanaafuu Daawit, \"Ani baʼee Filisxeemota dhaʼuu? Ati dabarsitee harka kootti isaan kennitaa?\" jedhee Waaqa ni gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.10",
            "verseOrgIds": [
              "1CH.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 14:10"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "1CH.14.10",
                "verseOrgIds": [
                  "1CH.14.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", \"Baʼi; ani dhugumaan Filisxeemota dabarsee harka keetti nan kennaatii\" jedhee deebiseef.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.10",
            "verseOrgIds": [
              "1CH.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Daawitii fi namoonni isaa gara Baʼaal Pheraaziim ol baʼan; achittis isaan moʼate. Innis, \"Akkuma bishaan mana isaa cabsee yaaʼu sana Waaqni harka kootiin diinota koo cabsee baʼeera\" jedhe. Kanaafuu iddoon sun Baʼaal Pheraaziim jedhamee waamame.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.11",
            "verseOrgIds": [
              "1CH.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filisxeemonni waaqota isaanii tolfamoo achitti ni dhiisan; Daawit immoo akka waaqonni sun ibiddaan gubaman ni ajaje.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.12",
            "verseOrgIds": [
              "1CH.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filisxeemonni amma illee deebiʼanii sulula sana weeraran;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.13",
            "verseOrgIds": [
              "1CH.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kanaafuu Daawit ammas Waaqa gaafate; Waaqnis akkana jedhee deebiseef; \"Qajeelumatti itti ol hin baʼin; garuu isaan marsiitii muka qilxuu duratti isaan waraani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.14",
            "verseOrgIds": [
              "1CH.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma fiixee muka qilxuu irraan sagalee duulaa dhageesseen loluuf baʼi; Waaqni loltoota Filisxeem dhaʼuudhaaf si dura baʼeera jechuudhaatii.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.15",
            "verseOrgIds": [
              "1CH.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Daawit akkuma Waaqni isa ajaje sana ni godhe; isaanis Gibeʼoonii jalqabanii hamma Geeziritti loltoota Filisxeem ni dhaʼan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.16",
            "verseOrgIds": [
              "1CH.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasiin maqaan Daawit biyya hunda keessatti beekame;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.17",
            "verseOrgIds": [
              "1CH.14.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "1CH.14.17",
                "verseOrgIds": [
                  "1CH.14.17"
                ]
              }
            }
          ]
        },
        {
          "text": "akka saboonni hundinuu isa sodaatan godhe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.17",
            "verseOrgIds": [
              "1CH.14.17"
            ]
          }
        }
      ]
    }
  ],
