    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 4:26"
      },
      "items": [
        {
          "text": "Ilma isaa Hamuuʼeel, ilma isaa Zakuurii fi ilma isaa Shimeʼii.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.26",
            "verseOrgIds": [
              "1CH.4.26"
            ]
          }
        }
      ]
