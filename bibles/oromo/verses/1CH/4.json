              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaan Sheelaa ilma Yihuudaa:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.21",
            "verseOrgIds": [
              "1CH.4.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 4:21"
      },
      "items": [
        {
          "text": "Eer abbaa Leekaa, Laʼadaa abbaa Maareeshaatii fi balbalawwan Beet Ashibeeʼaatti warra wayyaa quncee talbaa haphii hojjetanii.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.21",
            "verseOrgIds": [
              "1CH.4.21"
            ]
          }
        }
