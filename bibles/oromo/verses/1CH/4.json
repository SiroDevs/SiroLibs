      },
      "items": [
        {
          "text": "Nemuuʼeel, Yaamiin, Yaariib, Zeraa fi Shaawul;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.24",
            "verseOrgIds": [
              "1CH.4.24"
            ]
          }
        }
