      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 4:20"
      },
      "items": [
        {
          "text": "Amnoon, Riinaa, Ben-Haanaanii fi Tiiloon.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.20",
            "verseOrgIds": [
              "1CH.4.20"
            ]
