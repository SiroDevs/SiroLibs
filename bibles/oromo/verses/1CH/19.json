        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis Naahaash mootiin Amoonotaa ni duʼe; ilmi isaa iddoo isaa buʼee mootii taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.1",
            "verseOrgIds": [
              "1CH.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawitis, \"Sababii abbaan isaa naa arjoomeef anis Haanuun ilma Naahaashiif nan arjooma\" jedhee yaade. Kanaafuu Daawit gadda waaʼee abbaa isaatiif itti dhagaʼame isaa ibsuuf Haanuunitti ergamoota ni erge.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.2",
            "verseOrgIds": [
              "1CH.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 19:2"
      },
      "items": [
        {
          "text": "Yommuu namoonni Daawit dhaamsa gaddaa itti himuuf Haanuun bira biyya Amoonotaa dhaqanitti,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.2",
            "verseOrgIds": [
              "1CH.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "qondaaltonni Amoonotaa Haanuuniin, \"Ati sababii Daawit akka isaan dhaamsa gaddaa sitti himaniif namoota sitti ergeef inni waan abbaa keetiif ulfina kenne seetaa? Ergamoonni isaa biyyattii qorachuu, basaasanii qabachuuf gara kee dhufan mitii?\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.3",
            "verseOrgIds": [
              "1CH.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Haanuun namoota Daawit sana qaqqabee rifeensa irraa haadee wayyaa isaanii illee teessuma irratti cicciree of irraa isaan erge.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.4",
            "verseOrgIds": [
              "1CH.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawit yommuu namni tokko dhufee waaʼee namoota sanaa isatti himetti, sababii isaan akka malee qaanaʼaniif ergamoota gara isaaniitti erge. Mootichis \"Isin hamma areedni keessan isinii guddatutti Yerikoo turaatii ergasii deebiʼaa kottaa\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.5",
            "verseOrgIds": [
              "1CH.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amoononni yommuu akka Daawit isaan xireeffate hubatanitti Haanuunii fi Amoononni Phaadaan Arraamii, Araamaʼaakaa fi Zoobaadhaa gaariiwwan kireeffachuuf meetii taalaantii",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.6",
            "verseOrgIds": [
              "1CH.19.6"
            ]
          }
        },
        {
          "text": "kuma tokko ni ergan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.6",
            "verseOrgIds": [
              "1CH.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis gaariiwwan kuma soddomii lamaa fi ooftota gaariiwwanii, akkasumas mootii Maʼakaatii fi loltoota isaa kanneen dhufanii Meedebaa bira qubatan sana kireeffatan; Amoononni immoo magaalaawwan isaaniitii walitti qabamanii waraanatti ni qajeelan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.7",
            "verseOrgIds": [
              "1CH.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawit yommuu waan kana dhagaʼetti Yooʼaabii fi guutummaa loltootaa ni erge.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.8",
            "verseOrgIds": [
              "1CH.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amoononni immoo baʼanii karra magaalaa isaanii irratti waraanaaf hiriiran; mootonni dhufan sun immoo kophaa isaanii dirree irra turan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.9",
            "verseOrgIds": [
              "1CH.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yooʼaabis akka fuula isaa duraa fi dugda isaa duubaan waraanni jiru ni arge; kanaafuu loltoota Israaʼel keessaa namoota bebeekamoo filatee adda loltoonni Sooriyaa jiranitti bobbaase.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.10",
            "verseOrgIds": [
              "1CH.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoota hafan immoo ajaja obboleessa isaa Abiishaayi jalatti ni hiriirse; isaanis Amoonotatti duulan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.11",
            "verseOrgIds": [
              "1CH.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yooʼaabis akkana jedhe; \"Yoo warri Sooriyaa natti jabaatan ati na gargaarta; yoo Amoononni sitti jabaatan immoo ani sin gargaara.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.12",
            "verseOrgIds": [
              "1CH.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jabaadhaa saba keenyaa fi magaalaawwan Waaqa keenyaatiif garaa kutannaadhaan haa lollu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.13",
            "verseOrgIds": [
              "1CH.19.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "1CH.19.13",
                "verseOrgIds": [
                  "1CH.19.13"
                ]
              }
            }
          ]
        },
        {
          "text": "waan fuula isaa duratti gaarii taʼe ni godha.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.13",
            "verseOrgIds": [
              "1CH.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Yooʼaabii fi loltoonni isa wajjin turan warra Sooriyaa waraanuuf fuul duratti ni qajeelan; jarris fuula isaa duraa baqatan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.14",
            "verseOrgIds": [
              "1CH.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amoononni yommuu akka namoonni Sooriyaa baqatan arganitti isaanis fuula obboleessa isaa Abiishaayi duraa baqatanii magaalaa seenan. Akkasiin Yooʼaab Yerusaalemitti deebiʼe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.15",
            "verseOrgIds": [
              "1CH.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni Sooriyaa yommuu akka Israaʼeloonni isaan moʼatan arganitti ergamoota erganii namoota Sooriyaa kanneen Laga Efraaxiisiitiin gamaa fichisiisan; Shoofaki ajajaan loltoota Hadaadezer sun isaan hoogganaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.16",
            "verseOrgIds": [
              "1CH.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawitis yommuu wanni kun isatti himametti, Israaʼeloota hunda walitti qabee Yordaanos ceʼe; innis dursee dhaqee fuula isaanii duraan toora lolaa ni qabate. Daawitis warra Sooriyaa waraanuuf loltoota isaa hiriirse; namoonni Sooriyaas ni lolaniin.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.17",
            "verseOrgIds": [
              "1CH.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan garuu Israaʼeloota duraa baqatan; Daawitis namoota gaarii waraanaa oofan kuma torbaa fi loltoota lafoo kuma afurtama fixe. Ajajaa loltoota isaanii Shoofaki illee ni ajjeese.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.18",
            "verseOrgIds": [
              "1CH.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tajaajiltoonni Hadaadezeriis yommuu akka Israaʼelootaan moʼataman arganitti Daawit wajjin nagaa uumanii isa jalatti bulan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.19",
            "verseOrgIds": [
              "1CH.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 19:19"
      },
      "items": [
        {
          "text": "Kanaafuu namoonni Sooriyaa ergasii Amoonota gargaaruu hin feene.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.19",
            "verseOrgIds": [
              "1CH.19.19"
            ]
          }
        }
      ]
    }
  ],
