          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawitis taabota",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.3",
            "verseOrgIds": [
              "1CH.15.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1CH.15.3",
                "verseOrgIds": [
                  "1CH.15.3"
                ]
              }
            }
          ]
        },
        {
          "text": "iddoo qopheesseef sanatti fiduuf Israaʼeloota hunda Yerusaalemitti walitti qabe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.3",
            "verseOrgIds": [
              "1CH.15.3"
            ]
          }
        }
      ]
    },
