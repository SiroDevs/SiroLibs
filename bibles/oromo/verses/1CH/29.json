          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis guyyaa itti aanutti",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.21",
            "verseOrgIds": [
              "1CH.29.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "1CH.29.21",
                "verseOrgIds": [
                  "1CH.29.21"
                ]
              }
            }
          ]
        },
        {
          "text": "qalma qalanii aarsaa gubamu dhiʼeessan; aarsaan maqaa Israaʼelootaatiin dhiʼaates: korommii loonii kuma tokko, korbeeyyii hoolaa kuma tokko, korbeeyyii hoolaa xixinnaa kuma tokko, dhibaayyuu fi aarsaawwan biraa baayʼee dha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.21",
            "verseOrgIds": [
              "1CH.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis gaafa sana fuula",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.22",
            "verseOrgIds": [
              "1CH.29.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1CH.29.22",
                "verseOrgIds": [
                  "1CH.29.22"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti gammachuu guddaadhaan nyaatanii dhugan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.22",
            "verseOrgIds": [
              "1CH.29.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 29:22"
      },
      "items": [
        {
          "text": "Ergasii immoo Solomoon ilma Daawit mootii godhanii akka inni bulchaa taʼuuf fuula",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.22",
            "verseOrgIds": [
              "1CH.29.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1CH.29.22",
                "verseOrgIds": [
                  "1CH.29.22"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti yeroo lammaffaa diban; Zaadoqiin immoo luba godhan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.22",
            "verseOrgIds": [
              "1CH.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Solomoon iddoo abbaa isaa Daawit mootii taʼee teessoo",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.23",
            "verseOrgIds": [
              "1CH.29.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1CH.29.23",
                "verseOrgIds": [
                  "1CH.29.23"
                ]
              }
            }
          ]
        },
        {
          "text": "irra taaʼe. Ni milkaaʼes; Israaʼeloonni hundis isaaf ajajaman.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.23",
            "verseOrgIds": [
              "1CH.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajajjoonni waraanaatii fi namoonni jajjaboon hundi akkasumas ilmaan Daawit mootichaa hundi amanamummaa isaanii Solomoon Mootichaaf mirkaneessan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.24",
            "verseOrgIds": [
              "1CH.29.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "1CH.29.25",
                "verseOrgIds": [
                  "1CH.29.25"
                ]
              }
            }
          ]
        },
        {
          "text": "Israaʼeloota duratti Solomoonin ol ol kaase; ulfina mootummaa kan mootonni isa dura turan tokko iyyuu Israaʼel keessatti hin qabaatin ni kenneef.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.25",
            "verseOrgIds": [
              "1CH.29.25"
            ]
          }
        }
      ]
    },
