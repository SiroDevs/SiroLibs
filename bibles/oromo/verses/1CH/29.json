          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sana booddees Daawit yaaʼii guutuudhaan, \"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.20",
            "verseOrgIds": [
              "1CH.29.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1CH.29.20",
                "verseOrgIds": [
                  "1CH.29.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keessan galateeffadhaa\" jedhe. Kanaafuu hundi isaanii",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.20",
            "verseOrgIds": [
              "1CH.29.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1CH.29.20",
                "verseOrgIds": [
                  "1CH.29.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa abbootii isaanii ni galateeffatan; fuula",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.20",
            "verseOrgIds": [
              "1CH.29.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootii",
              "type": "text",
              "attrs": {
                "verseId": "1CH.29.20",
                "verseOrgIds": [
                  "1CH.29.20"
                ]
              }
            }
          ]
        },
        {
          "text": "fi fuula mootichaa duratti addaan gombifamanii ni sagadan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.20",
            "verseOrgIds": [
              "1CH.29.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Solomoon Mootii Taʼuun Isaa Beekame",
          "type": "text"
        }
      ]
    },
