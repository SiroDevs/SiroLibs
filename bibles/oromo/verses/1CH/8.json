          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaan Miikaa:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.35",
            "verseOrgIds": [
              "1CH.8.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 8:35"
      },
      "items": [
        {
          "text": "Phiitoon, Meleek, Taareʼaa fi Aahaaz.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.35",
            "verseOrgIds": [
              "1CH.8.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
