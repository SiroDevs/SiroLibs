      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 8:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaan obboleessa isaa Eseeqii:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.39",
            "verseOrgIds": [
              "1CH.8.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 8:39"
      },
      "items": [
        {
          "text": "Ilmi isaa hangafni Uulaam, ilmi isaa lammaffaan Yeʼuushi, ilmi isaa sadaffaan Eliiphelexi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.39",
            "verseOrgIds": [
              "1CH.8.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 8:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaan Uulaam loltoota jajjaboo xiyyaan loluu dandaʼan turan. Isaanis ilmaanii fi ilmaan ilmaanii hedduu walumatti nama 150 qabu turan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.40",
            "verseOrgIds": [
              "1CH.8.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 8:40"
      },
      "items": [
        {
          "text": "Isaan kunneen hundi ilmaan Beniyaam turan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.40",
            "verseOrgIds": [
              "1CH.8.40"
            ]
          }
        }
