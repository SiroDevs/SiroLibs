        {
          "text": "kwf –",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "xt"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "2SA.8.15-2SA.8.18"
