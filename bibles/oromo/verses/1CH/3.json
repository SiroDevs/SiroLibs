          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaan Yosiyaas:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.15",
            "verseOrgIds": [
              "1CH.3.15"
            ]
          }
        }
