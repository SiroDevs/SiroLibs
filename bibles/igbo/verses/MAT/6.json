  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "MAT 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ozizi banyere inye onyinye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kpacharanụ anya ka unu ghara ime ezi omume unu naanị ka ndị mmadụ hụ unu. Nʼihi na unu mee nke a, unu agaghị enweta ụgwọ ọrụ ọbụla site nʼaka Nna unu bi nʼeluigwe.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.1",
                "verseOrgIds": [
                  "MAT.6.1"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Unu afụla opi mgbe unu na-enye ndị nọ na mkpa onyinye, nʼihi na otu a ka ndị ihu abụọ na-eme nʼụlọ nzukọ na nʼokporoụzọ, ka ndị mmadụ too ha. Nʼezie, ana m agwa unu, ha anatala ụgwọ ọrụ ha nʼizuoke.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.2",
                "verseOrgIds": [
                  "MAT.6.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.2",
            "verseOrgIds": [
              "MAT.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mgbe unu chọrọ ịrụ ọrụ ebere, meenụ ya na nzuzo. Ekwela ka aka ekpe gị mata ihe aka nri gị na-achọ ime.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.3",
                "verseOrgIds": [
                  "MAT.6.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.3",
            "verseOrgIds": [
              "MAT.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ka onyinye gị bụrụ na nzuzo. Mgbe ahụ, Nna gị, onye na-ahụ ihe dị na nzuzo ga-akwụghachi gị.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.4",
                "verseOrgIds": [
                  "MAT.6.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ozizi banyere ekpere",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mgbe ọbụla unu chọrọ ikpe ekpere, unu emela dị ka ndị ihu abụọ, nʼihi na ha hụrụ iguzo nʼime ụlọ ekpere, nakwa nʼakụkụ ụzọ nʼanya na-ekpe ekpere, ebe ndị mmadụ ga-ahụ ha. Nʼezie, agwa m unu, ha anatala ụgwọ ọrụ ha nʼebe o zuruoke.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.5",
                "verseOrgIds": [
                  "MAT.6.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.5",
            "verseOrgIds": [
              "MAT.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kama, mgbe unu chọrọ ikpe ekpere, baanụ nʼime ime ụlọ unu. Mechiekwanụ ụzọ unu, kpọkuonụ Nna unu nʼekpere na nzuzo. Mgbe ahụ Nna unu, onye na-ahụ ihe e mere na nzuzo, ga-enye unu ụgwọ ọrụ unu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.6",
                "verseOrgIds": [
                  "MAT.6.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.6",
            "verseOrgIds": [
              "MAT.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mgbe unu na-ekpe ekpere, unu ekwula okwu nkwukwasị efu dị ka ndị na-amaghị Chineke na-eme. Ha chere na a ga-anụ ekpere ha nʼihi ọtụtụ okwu ha na-ekwu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.7",
                "verseOrgIds": [
                  "MAT.6.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.7",
            "verseOrgIds": [
              "MAT.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Unu adịla ka ha. Chetanụ na tupu unu arịọ arịrịọ ọbụla, Nna unu bi nʼeluigwe maara ihe na-akpa unu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.8",
                "verseOrgIds": [
                  "MAT.6.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Sinụ otu a na-ekpe ekpere:",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.9",
                "verseOrgIds": [
                  "MAT.6.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 6:9"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\" 'Nna anyị nke bi nʼeluigwe,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.9",
                "verseOrgIds": [
                  "MAT.6.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 6:9"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ka e doo aha gị nsọ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.9",
                "verseOrgIds": [
                  "MAT.6.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ka alaeze gị bịa,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.10",
                "verseOrgIds": [
                  "MAT.6.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 6:10"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ka e mee uche gị nʼụwa,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.10",
                "verseOrgIds": [
                  "MAT.6.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 6:10"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "dịka e si eme ya nʼeluigwe.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.10",
                "verseOrgIds": [
                  "MAT.6.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nye anyị nri nke ụbọchị taa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.11",
                "verseOrgIds": [
                  "MAT.6.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gbaghara anyị mmehie anyị,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.12",
                "verseOrgIds": [
                  "MAT.6.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 6:12"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "dịka anyị si agbaghara ndị na-emehie megide anyị.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.12",
                "verseOrgIds": [
                  "MAT.6.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ekwela ka anyị daba nʼime ọnwụnwa,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.13",
                "verseOrgIds": [
                  "MAT.6.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 6:13"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "kama, zọpụta anyị nʼaka ajọ onye ahụ.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.13",
                "verseOrgIds": [
                  "MAT.6.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ bụrụ na unu agbaghara ndị mmadụ mgbe ha mehiere megide unu, Nna unu nke bi nʼeluigwe ga-agbagharakwa unu mmehie unu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.14",
                "verseOrgIds": [
                  "MAT.6.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.14",
            "verseOrgIds": [
              "MAT.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ bụrụkwanụ na unu agbagharaghị ndị ọzọ mmehie niile ha, Nna unu nke bi nʼeluigwe agaghị agbaghara unu mmehie unu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.15",
                "verseOrgIds": [
                  "MAT.6.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ibu ọnụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọzọ, mgbe ọbụla unu na-ebu ọnụ, unu agbarụla ihu unu dịka ndị ihu abụọ na-eme. Nʼihi na ha na-agbarụ ihu ha ka ndị ọzọ hụ na ha na-ebu ọnụ. Nʼezie agwa m unu, ha anatala ụgwọ ọrụ ha.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.16",
                "verseOrgIds": [
                  "MAT.6.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.16",
            "verseOrgIds": [
              "MAT.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mgbe ị na-ebu ọnụ, tee isi gị mmanụ, ma saakwa ihu gị mmiri,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.17",
                "verseOrgIds": [
                  "MAT.6.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.17",
            "verseOrgIds": [
              "MAT.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ka ndị ọzọ ghara ịhụta na ị na-ebu ọnụ kama ka ọ bụrụ naanị nye Nna gị, onye anya na-adịghị ahụ. Nna gị, onye na-ahụ ihe niile na-eme na nzuzo, ga-akwụ gị ụgwọ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.18",
                "verseOrgIds": [
                  "MAT.6.18"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ịkpado akụ nʼeluigwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Unu akpadola akụ nʼụwa nye onwe unu, ebe ọ ga-agba nchara, akịka atakwa ya, ebe ndị ohi ga-etiwa ma zukwaa ha.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.19",
                "verseOrgIds": [
                  "MAT.6.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.19",
            "verseOrgIds": [
              "MAT.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kama kwadoonụ akụ nʼeluigwe nye onwe unu, ebe ha na-agaghị agba nchara, ebe akịka na-agaghị eri ha, ebe ndị ohi na-adịghị etiwa maọbụ zuo ihe.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.20",
                "verseOrgIds": [
                  "MAT.6.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.20",
            "verseOrgIds": [
              "MAT.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼihi na ebe ọbụla akụ unu dị ka obi unu ga-adịkwa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.21",
                "verseOrgIds": [
                  "MAT.6.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Anya bụ oriọna nke anụ ahụ. Ọ bụrụkwa na anya gị adịrị ọcha, ahụ gị niile ga-ejupụta nʼìhè.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.22",
                "verseOrgIds": [
                  "MAT.6.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.22",
            "verseOrgIds": [
              "MAT.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ bụrụ na anya gị ajọọ njọ, akụkụ ahụ gị niile ga-ejupụta nʼọchịchịrị. Ọ bụrụkwa na ìhè ahụ dị nʼime gị aghọọ ọchịchịrị, ọchịchịrị ahụ ga-adị ukwuu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.23",
                "verseOrgIds": [
                  "MAT.6.23"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ dịghị onye ọbụla pụrụ ife nna ukwu abụọ, nʼihi na ọ ga-achọ ịhụ otu nʼime ha nʼanya, kpọkwa nke ọzọ asị, maọbụ sọpụrụ otu ma lelịa nke ọzọ anya. Otu a kwa i nweghị ike ife Chineke na akụ otu mgbe ahụ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.24",
                "verseOrgIds": [
                  "MAT.6.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Echegbula onwe unu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nʼihi nke a ka m ji na-asị unu, unu echegbula onwe unu banyere ndụ unu, ihe unu ga-eri, maọbụ ihe unu ga-aṅụ, maọbụ banyere ahụ unu, ihe unu ga-eyi nʼahụ. Ọ bụ ndụ akarịghị nri eji azụ ya, ka ọ bụ ahụ akarịghị ihe e ji ekpuchi ya?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.25",
                "verseOrgIds": [
                  "MAT.6.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.25",
            "verseOrgIds": [
              "MAT.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Werenụ ụmụ nnụnụ dị ka ihe ịmaatụ. Ha adịghị akụ mkpụrụ nʼubi maọbụ ewe ihe ubi. Ha adịghị achịkọtakwa ihe debe nʼọba. Ma Nna unu nke bi nʼeluigwe na-azụ ha. Ọ bụ na unu adịghị oke ọnụahịa karịa ha?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.26",
                "verseOrgIds": [
                  "MAT.6.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.26",
            "verseOrgIds": [
              "MAT.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Onye nʼetiti unu pụrụ itinye otu nkeji nʼogologo ụbọchị nke ndụ",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.27",
                "verseOrgIds": [
                  "MAT.6.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.27",
            "verseOrgIds": [
              "MAT.6.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ya site nʼichegbu onwe ya?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.27",
                "verseOrgIds": [
                  "MAT.6.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Gịnị mekwaranụ unu ji na-anọ nʼechiche oge niile maka uwe? Leenụ okoko osisi nke ọhịa. Ha adịghị arụ ọrụ maọbụ dọgbuo onwe ha nʼọrụ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.28",
                "verseOrgIds": [
                  "MAT.6.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.28",
            "verseOrgIds": [
              "MAT.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma asị m unu, ọ bụladị Solomọn nʼebube nke ịbụ eze ya niile, eyighị uwe ọbụla mara mma dị ka otu nʼime okoko osisi nke ọhịa ndị a.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.29",
                "verseOrgIds": [
                  "MAT.6.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.29",
            "verseOrgIds": [
              "MAT.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma ọ bụrụ na Chineke si otu a chọọ ahịhịa efu nke ubi mma, nke pụrụ ịdị ndụ taa ma echi atụba ha nʼite ọkụ, ọ bụ na ọ gaghị a chọọ unu mma karịa. Unu ndị okwukwe nta?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.30",
                "verseOrgIds": [
                  "MAT.6.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.30",
            "verseOrgIds": [
              "MAT.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼihi nke a, unu echegbukwala onwe unu na-asị, 'Gịnị ka anyị ga-eri?' maọbụ, 'Gịnị ka anyị ga-aṅụ?' maọbụ, 'Gịnịkwa ka anyị ga-eyi?'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.31",
                "verseOrgIds": [
                  "MAT.6.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.31",
            "verseOrgIds": [
              "MAT.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ bụ ihe ndị a ka ndị na-amaghị Chineke na-achọsi ike. Ma Nna unu bi nʼeluigwe maara na ọ dị unu mkpa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.32",
                "verseOrgIds": [
                  "MAT.6.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.32",
            "verseOrgIds": [
              "MAT.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma burunu ụzọ chọọ alaeze ya na ezi omume ya, a ga-atụkwasịkwara unu ihe ndị a niile.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.33",
                "verseOrgIds": [
                  "MAT.6.33"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.33",
            "verseOrgIds": [
              "MAT.6.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ya mere, unu echegbula onwe unu banyere echi, nʼihi na echi ga-echere onwe ya. Nsogbu nke ụbọchị taa ezuorola ụbọchị taa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.34",
                "verseOrgIds": [
                  "MAT.6.34"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
