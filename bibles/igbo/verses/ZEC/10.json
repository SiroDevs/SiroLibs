  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "ZEC 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text"
            }
          ]
        },
        {
          "text": "ga-elekọta Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rịọọnụ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.1",
            "verseOrgIds": [
              "ZEC.10.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.10.1",
                "verseOrgIds": [
                  "ZEC.10.1"
                ]
              }
            }
          ]
        },
        {
          "text": "mmiri ozuzo nʼoge mmiri ozuzo nke ikpeazụ,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.1",
            "verseOrgIds": [
              "ZEC.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:1"
      },
      "items": [
        {
          "text": "nʼihi na ọ bụ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.1",
            "verseOrgIds": [
              "ZEC.10.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.10.1",
                "verseOrgIds": [
                  "ZEC.10.1"
                ]
              }
            }
          ]
        },
        {
          "text": "na-ezite oke amụma mmiri.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.1",
            "verseOrgIds": [
              "ZEC.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:1"
      },
      "items": [
        {
          "text": "Ọ bụ ya na-enye ụmụ mmadụ mmiri ozuzo,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.1",
            "verseOrgIds": [
              "ZEC.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:1"
      },
      "items": [
        {
          "text": "na-enyekwa mmadụ niile ihe ọkụkụ nke ubi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.1",
            "verseOrgIds": [
              "ZEC.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arụsị niile na-ekwu okwu aghụghọ,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.2",
            "verseOrgIds": [
              "ZEC.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:2"
      },
      "items": [
        {
          "text": "ndị na-agba aja nʼahụ ọhụ bụ ụgha,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.2",
            "verseOrgIds": [
              "ZEC.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:2"
      },
      "items": [
        {
          "text": "ndị ha na-arọ nrọ, na-akọwakwa nrọ ụgha,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.2",
            "verseOrgIds": [
              "ZEC.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:2"
      },
      "items": [
        {
          "text": "okwu nkasiobi nke ihe na-adịghị nʼime ya ka ha na-enye.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.2",
            "verseOrgIds": [
              "ZEC.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:2"
      },
      "items": [
        {
          "text": "Ya mere, ndị mmadụ na-akpagharị dịka atụrụ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.2",
            "verseOrgIds": [
              "ZEC.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:2"
      },
      "items": [
        {
          "text": "a na-akpagbu ha nʼihi enweghị onye ọzụzụ atụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.2",
            "verseOrgIds": [
              "ZEC.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iwe m na-ere ọkụ megide ndị ọzụzụ atụrụ,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.3",
            "verseOrgIds": [
              "ZEC.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:3"
      },
      "items": [
        {
          "text": "aga m atakwa ndị ndu",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.3",
            "verseOrgIds": [
              "ZEC.10.3"
            ]
          }
        },
        {
          "text": "niile ahụhụ;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.3",
            "verseOrgIds": [
              "ZEC.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:3"
      },
      "items": [
        {
          "text": "nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.3",
            "verseOrgIds": [
              "ZEC.10.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.10.3",
                "verseOrgIds": [
                  "ZEC.10.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.3",
            "verseOrgIds": [
              "ZEC.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:3"
      },
      "items": [
        {
          "text": "ga-elekọta igwe anụ ụlọ ya, ya bụ ndị Juda,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.3",
            "verseOrgIds": [
              "ZEC.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:3"
      },
      "items": [
        {
          "text": "ọ ga-eme ka ha dịrị ka ịnyịnya dị ebube nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.3",
            "verseOrgIds": [
              "ZEC.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-esi na Juda nweta nkume bụ ide ji ụlọ,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.4",
            "verseOrgIds": [
              "ZEC.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:4"
      },
      "items": [
        {
          "text": "a ga-esi na ha nweta ǹtu ụlọ ikwu,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.4",
            "verseOrgIds": [
              "ZEC.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:4"
      },
      "items": [
        {
          "text": "a ga-esi na ha nweta ụta a kwadoro maka agha,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.4",
            "verseOrgIds": [
              "ZEC.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:4"
      },
      "items": [
        {
          "text": "sitekwa na ha nweta ndị ndu dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.4",
            "verseOrgIds": [
              "ZEC.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha niile ga-ejikọta onwe ha ọnụ, dịka ndị bụ dike nʼagha,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.5",
            "verseOrgIds": [
              "ZEC.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:5"
      },
      "items": [
        {
          "text": "ha ga-azọda ndị iro ha nʼapịtị nke okporoụzọ niile.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.5",
            "verseOrgIds": [
              "ZEC.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:5"
      },
      "items": [
        {
          "text": "Nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.5",
            "verseOrgIds": [
              "ZEC.10.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.10.5",
                "verseOrgIds": [
                  "ZEC.10.5"
                ]
              }
            }
          ]
        },
        {
          "text": "nọnyeere ha,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.5",
            "verseOrgIds": [
              "ZEC.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:5"
      },
      "items": [
        {
          "text": "ha ga-alụgbukwa ndị iro niile na-agba ịnyịnya.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.5",
            "verseOrgIds": [
              "ZEC.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Aga m eme ka ụlọ Juda dị ike,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:6"
      },
      "items": [
        {
          "text": "zọpụtakwa ụlọ Josef.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:6"
      },
      "items": [
        {
          "text": "Aga m eme ka ha lọghachita,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:6"
      },
      "items": [
        {
          "text": "nʼihi na aga m egosi ha obi ebere.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:6"
      },
      "items": [
        {
          "text": "Ha ga-adị",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:6"
      },
      "items": [
        {
          "text": "ka ndị m na-ajụghị mgbe ọbụla,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:6"
      },
      "items": [
        {
          "text": "nʼihi na mụ onwe m bụ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.10.6",
                "verseOrgIds": [
                  "ZEC.10.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke ha,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:6"
      },
      "items": [
        {
          "text": "aga m azakwa arịrịọ ha.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Ifrem ga-aghọ ndị dị ike nʼagha,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.7",
            "verseOrgIds": [
              "ZEC.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:7"
      },
      "items": [
        {
          "text": "ha ga-enwe ọṅụ dịka ndị na-aṅụ mmanya.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.7",
            "verseOrgIds": [
              "ZEC.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 10:7"
      },
      "items": [
        {
          "text": "Ụmụ ha ga-ahụ ya ṅụrịakwa ọṅụ,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.7",
            "verseOrgIds": [
              "ZEC.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 10:7"
      },
      "items": [
        {
          "text": "ha ga-ejikwa obi ha niile ṅụrịa ọṅụ nʼime",
