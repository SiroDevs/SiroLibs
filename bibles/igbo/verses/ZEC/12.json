  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "ZEC 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mbibi dịrị ndị iro Jerusalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ okwu nke",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.1",
            "verseOrgIds": [
              "ZEC.12.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.12.1",
                "verseOrgIds": [
                  "ZEC.12.1"
                ]
              }
            }
          ]
        },
        {
          "text": "banyere Izrel. Ọ bụ amụma.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.1",
            "verseOrgIds": [
              "ZEC.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ZEC 12:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 12:1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.12.1",
                "verseOrgIds": [
                  "ZEC.12.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", onye gbasapụrụ eluigwe niile, onye tọrọ ntọala ụwa, na onye kpụrụ mmụọ nke dị nʼime mmadụ, ekwupụtala, sị,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.1",
            "verseOrgIds": [
              "ZEC.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Agaje m ime Jerusalem ka ọ bụrụ iko mmanya nke ga-aṅagharị ndị niile gbara ya gburugburu. Ha ga-agba Juda na Jerusalem gburugburu, nọbichie ụzọ ya niile.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.2",
            "verseOrgIds": [
              "ZEC.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị ahụ, mgbe mba niile nke ụwa chịkọtara onwe ha ọnụ imegide ya, aga m eme Jerusalem ka ọ ghọọrọ mba ndị ahụ niile nkume dị ukwuu nke a na-apụghị inugharị enugharị. Ndị niile ga-agbalị inugharị ya ga-emerụ onwe ha ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.3",
            "verseOrgIds": [
              "ZEC.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị ahụ, aga m etinye ụjọ nʼobi ịnyịnya niile, mee ka ndị na-agba ha ghọọ ndị ara,\" otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.4",
            "verseOrgIds": [
              "ZEC.12.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.12.4",
                "verseOrgIds": [
                  "ZEC.12.4"
                ]
              }
            }
          ]
        },
        {
          "text": "kwubiri. \"Aga m asaghe anya m lekwasị ụlọ Juda nke ọma, ma aga m eme ka ịnyịnya niile nke mba niile kpuo ìsì.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.4",
            "verseOrgIds": [
              "ZEC.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ndị ndu Juda ga-ekwu nʼobi ha sị, 'Ndị Jerusalem achọtala ike nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.5",
            "verseOrgIds": [
              "ZEC.12.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.12.5",
                "verseOrgIds": [
                  "ZEC.12.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile, bụ Chineke ha.'",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.5",
            "verseOrgIds": [
              "ZEC.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼụbọchị ahụ, aga m eme ka ndị ndu Juda niile dịrị ka ite ọkụ, nke a dọnyere nʼebe a chịkọtara nkụ. Ha ga-adịkwa ka ọkụ na-enwu enwu, nke dị nʼetiti ukwu ọka. Ha ga-ere ọkụ nʼaka nri na nʼaka ekpe, rechapụ ndị niile bi gburugburu ha. Ma mmadụ ga-ejupụtakwa nʼime Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.6",
            "verseOrgIds": [
              "ZEC.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.7",
            "verseOrgIds": [
              "ZEC.12.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.12.7",
                "verseOrgIds": [
                  "ZEC.12.7"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-ebu ụzọ zọpụta ebe obibi niile nke Juda, ime ka ugwu na nsọpụrụ nke ụlọ Devid, na nke ndị niile bi na Jerusalem ghara ịdị ukwuu karịa nke Juda.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.7",
            "verseOrgIds": [
              "ZEC.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.8",
            "verseOrgIds": [
              "ZEC.12.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.12.8",
                "verseOrgIds": [
                  "ZEC.12.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-echebe ndị bi na Jerusalem, mee ka ọ bụladị ndị na-asọ ngọngọ nʼetiti ha dịrị ike dịka Devid. Ụlọ Devid ga-adịkwa ka Chineke, dịka Mmụọ ozi",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.8",
            "verseOrgIds": [
              "ZEC.12.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.12.8",
                "verseOrgIds": [
                  "ZEC.12.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", onye na-eje nʼihu ha.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.8",
            "verseOrgIds": [
              "ZEC.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị ahụ, aga m ebido ibibi mba ndị ahụ niile na-ebuso Jerusalem agha.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.9",
            "verseOrgIds": [
              "ZEC.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iru ụjụ banyere onye ahụ a mapuru ahụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe ahụ, aga m awụkwasị nʼụlọ Devid na ndị niile bi na Jerusalem, mmụọ nke amara na nke arịrịọ amara. Ha ga-elegidekwa m anya, bụ onye ahụ ha mapuru ahụ. Ha ga-eru ụjụ nʼihi ya, dịka mmadụ si eru ụjụ nʼihi ọnwụ nke nwa a mụrụ naanị ya. Ha ga-ebekwa akwa ilu nke ukwuu dịka mmadụ sị ebe akwa maka nwa mbụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.10",
            "verseOrgIds": [
              "ZEC.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị ahụ, akwa a ga-akwa na Jerusalem ga-adị ukwuu, dịka akwa nke Hadad Rimọn nʼobosara ala Megido.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.11",
            "verseOrgIds": [
              "ZEC.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ala ahụ niile ga-eru ụjụ. Ikwu ọbụla ga-eru ụjụ nke ha, ha na ndị nwunye ha. Ikwu Devid na ndị nwunye ha, na ikwu Netan na ndị nwunye ha,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.12",
            "verseOrgIds": [
              "ZEC.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ikwu Livayị, na ndị nwunye ha, na ikwu Shimei na ndị nwunye ha,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.13",
            "verseOrgIds": [
              "ZEC.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ikwu ndị ọzọ niile na ndị nwunye ha.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.14",
            "verseOrgIds": [
              "ZEC.12.14"
            ]
          }
        }
      ]
    }
  ],
